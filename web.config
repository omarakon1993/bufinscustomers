<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo para IIS (hosting compartido, ASP.NET Core Module en proceso). `dotnet publish` completa los atributos de <aspNetCore>
  segun el tipo de publicacion (dependiente del framework o self-contained). Las cabeceras de seguridad, la compresion, la cache de
  estaticos, el idioma y las paginas de error las resuelve la propia aplicacion (Program.cs); aqui solo lo que es de IIS.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\bufinscustomers.dll" stdoutLogEnabled="false" stdoutLogFile=".\App_Data\logs\stdout" hostingModel="inprocess" />
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
          <remove name="X-Powered-By-Plesk" />
        </customHeaders>
      </httpProtocol>
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- Limite de subida: 100 MB (por defecto IIS admite solo ~30 MB). Debe coincidir con IISServerOptions/Kestrel en Program.cs -->
          <requestLimits maxAllowedContentLength="104857600" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
