@model string
@*
    Loader 2 · Barrido de luz — para botones o barras de progreso indeterminadas.
    Uso: @Html.Partial("_LoaderSweep", "aqua")  -> fondo oscuro (default)
         @Html.Partial("_LoaderSweep", "dark")  -> fondo claro/blanco
*@
@{
    var variant = Model == "dark" ? "dark" : "aqua";
    var wordmark = variant == "dark" ? "~/Assets/img/Bufins_Wordmark_Dark.png" : "~/Assets/img/Bufins_Wordmark_Aqua.png";
}
<div class="l2-wrap">
    <img class="l2-base" src="@Url.Content(wordmark)" alt="">
    <img class="l2-mask" src="@Url.Content(wordmark)" alt="Bufins">
</div>
