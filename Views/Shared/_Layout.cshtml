@{
    var _isEnglish = System.Threading.Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName == "en";
    var _esActiveClass = !_isEnglish ? "active" : "";
    var _enActiveClass = _isEnglish ? "active" : "";
}
<!DOCTYPE html>
<html lang="@(_isEnglish ? "en" : "es")">
<head>
    @using bufinscustomers.Helpers
    @using System.Web.Optimization

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>BUFINS - Principal</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico">

    <!-- FOUC prevention: inline style + script BEFORE any external CSS so rules fire on first paint without a network round-trip -->
    <style>
        html.sidebar-init-collapsed .modern-sidebar{width:70px!important;transition:none!important}
        html.sidebar-init-collapsed .main-content{margin-left:70px!important;transition:none!important}
        html.page-loading body{visibility:hidden!important}
        @@keyframes _sbReveal{to{visibility:visible}}
        html.page-loading body{animation:_sbReveal 0s 1.5s forwards}
    </style>
    <script>(function(){try{var s=JSON.parse(localStorage.getItem('bufins_sidebar_state')||'{}');if(s.collapsed&&window.innerWidth>=992)document.documentElement.classList.add('sidebar-init-collapsed');}catch(e){}document.documentElement.classList.add('page-loading');}());</script>

    <link href="~/Assets/Bootstrap/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="~/Assets/GoogleApis/Family.css" rel="stylesheet">
    <link href="~/Assets/css/sb-admin-2.min.css" rel="stylesheet">
    @Styles.Render("~/bundles/css-custom")
</head>

<body id="page-top">
    <!-- Bot\u00f3n Hamburguesa M\u00f3vil -->
    <button class="sidebar-hamburger" aria-label="Abrir men\u00fa">
        <i class="fas fa-bars"></i>
    </button>

    <!-- Backdrop para M\u00f3vil/Tablet -->
    <div class="sidebar-backdrop"></div>

    <!-- Sidebar Moderno -->
    <aside class="modern-sidebar">
        <!-- Header del Sidebar -->
        <div class="sidebar-header">
            <a href="@Url.Action("Index", "Home")" class="sidebar-logo-wrapper">
                <div class="sidebar-brand-icon">B</div>
                <span class="sidebar-logo-text">bufins</span>
            </a>
            <button class="sidebar-toggle-btn" aria-label="Colapsar">
                <i class="fas fa-angle-double-left"></i>
            </button>
        </div>

        <!-- Búsqueda en el Menú -->
        <div class="sidebar-search">
            <div class="sidebar-search-wrapper">
                <i class="fas fa-search sidebar-search-icon"></i>
                <input type="text" class="sidebar-search-input" placeholder="@Resources.Strings.Layout_SearchPlaceholder" autocomplete="off">
            </div>
        </div>

        <!-- Variables de usuario para uso en topbar -->
        @{
            var usuario = UsuarioSesionHelper.UsuarioActual;
            var esAdmin2 = UsuarioSesionHelper.EsSuperAdmin();
            var idEmpresa = usuario?.IdEmpresa ?? 0;
        }

        <!-- Menú Principal (dinámico desde MenuOpciones) -->
        <nav class="sidebar-menu">
            @{
                var _ctrl = ViewContext.RouteData.Values["controller"] != null ? ViewContext.RouteData.Values["controller"].ToString() : "";
                var _action = ViewContext.RouteData.Values["action"] != null ? ViewContext.RouteData.Values["action"].ToString() : "";
                var _isHome = _ctrl == "Home" && _action == "Index";
            }
            <!-- Sección General (siempre visible) -->
            <div class="sidebar-category">
                <div class="sidebar-category-header">
                    <i class="fas fa-circle sidebar-category-icon sidebar-cat-dot"></i>
                    <span class="sidebar-category-title">@Resources.Strings.Layout_General</span>
                </div>
                <div class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(_isHome ? "active" : "")" href="@Url.Action("Index", "Home")">
                        <i class="fas fa-home sidebar-nav-icon"></i>
                        <span class="sidebar-nav-text">@Resources.Strings.Layout_Home</span>
                    </a>
                </div>
            </div>

            @{ Html.RenderPartial("_SidebarMenu", UsuarioSesionHelper.ObtenerMenuSidebar()); }
        </nav>
        <!-- Scroll restoration: runs synchronously during HTML parsing, before first paint -->
        <script>(function(){try{var s=sessionStorage.getItem('bufins_sidebar_scroll');var m=document.querySelector('.sidebar-menu');if(s&&m)m.scrollTop=parseInt(s)||0;}catch(e){}}());</script>

        <!-- Footer del Sidebar -->
        <div class="sidebar-footer">
            <span class="sidebar-footer-text">&copy; Bufins @DateTime.Now.Year</span>
        </div>
    </aside>

    <!-- Contenido Principal -->
    <div id="content-wrapper" class="d-flex flex-column main-content">
            <div id="content">
                <nav class="navbar navbar-expand navbar-light topbar mb-4 static-top shadow">
                    <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                        <i class="fa fa-bars"></i>
                    </button>

                    @{
                        string _bcGroup = null;
                        string _bcItem  = null;
                        if (!_isHome)
                        {
                            var _menuBc = UsuarioSesionHelper.ObtenerMenuSidebar();
                            if (_menuBc != null)
                            {
                                bool _bcFound = false;
                                foreach (var _bcCat in _menuBc)
                                {
                                    if (_bcFound || _bcCat.Grupos == null) { break; }
                                    foreach (var _bcGrp in _bcCat.Grupos)
                                    {
                                        if (_bcFound || _bcGrp.Items == null) { break; }
                                        foreach (var _bcItm in _bcGrp.Items)
                                        {
                                            if (_bcItm.Controller == _ctrl && _bcItm.Action == _action)
                                            {
                                                _bcItem  = _bcItm.Nombre;
                                                if (_bcGrp.Items.Count > 1) { _bcGroup = _bcGrp.Nombre; }
                                                _bcFound = true;
                                                break;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    <div class="topbar-breadcrumb d-none d-sm-flex">
                        <span class="bc-item"><a href="@Url.Action("Index", "Home")">@Resources.Strings.Layout_Home</a></span>
                        @if (_bcGroup != null)
                        {
                            <i class="fas fa-chevron-right bc-sep"></i>
                            <span class="bc-item">@_bcGroup</span>
                        }
                        @if (_bcItem != null)
                        {
                            <i class="fas fa-chevron-right bc-sep"></i>
                            <span class="bc-current">@_bcItem</span>
                        }
                    </div>

                    <div class="topbar-divider d-none d-sm-block"></div>
                    <ul class="navbar-nav ml-auto">
                        <!-- Language pill -->
                        <li class="lang-pill-nav">
                            <div class="lang-switcher-wrapper">
                                <i class="fas fa-globe lang-switcher-icon"></i>
                                <div class="lang-switcher">
                                    <a href="@Url.Action("SetLanguage", "Acceso", new { lang = "es-CO", returnUrl = Request.Url.PathAndQuery })" class="lang-btn @_esActiveClass">Español</a>
                                    <span class="lang-sep"></span>
                                    <a href="@Url.Action("SetLanguage", "Acceso", new { lang = "en-US", returnUrl = Request.Url.PathAndQuery })" class="lang-btn @_enActiveClass">English</a>
                                </div>
                            </div>
                        </li>
                        <!-- Campanita de notificaciones -->
                        <li class="nav-item dropdown no-arrow" id="notifBellItem" style="display:none;">
                            <a class="nav-link position-relative" href="#" id="notifDropdown" role="button"
                               data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"
                               title="@Resources.Strings.Notif_Titulo"
                               style="padding:0.45rem 0.8rem; border-radius:8px; transition:background .15s;"
                               onmouseover="this.style.background='rgba(255,255,255,0.1)'"
                               onmouseout="this.style.background='transparent'">
                                <i class="fas fa-bell" style="color:rgba(255,255,255,0.9); font-size:1.05rem;"></i>
                                <span id="notifBadge"
                                      style="display:none; position:absolute; top:3px; right:3px; background:#ef4444; color:white; font-size:0.58rem; font-weight:700; min-width:17px; height:17px; border-radius:9px; line-height:17px; padding:0 4px; text-align:center; border:2px solid transparent; box-shadow:0 1px 4px rgba(239,68,68,0.5);">0</span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-right animated--grow-in"
                                 id="notifPanel"
                                 style="width:380px; max-height:500px; overflow:hidden; padding:0; border:1px solid rgba(30,27,75,0.1); border-radius:14px; box-shadow:0 20px 60px rgba(30,27,75,0.18), 0 4px 16px rgba(0,0,0,0.07);">
                                <!-- Cabecera morado oscuro corporativo -->
                                <div style="background:#1E1B4B; padding:14px 18px; color:white; display:flex; justify-content:space-between; align-items:center; border-radius:14px 14px 0 0;">
                                    <div style="display:flex; align-items:center; gap:9px;">
                                        <div style="width:30px; height:30px; border-radius:8px; background:rgba(255,255,255,0.12); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                            <i class="fas fa-bell" style="font-size:0.78rem;"></i>
                                        </div>
                                        <span style="font-weight:700; font-size:0.9rem; letter-spacing:0.01em;">@Resources.Strings.Notif_Titulo</span>
                                    </div>
                                    <div style="display:flex;gap:6px;">
                                        <button onclick="notifMarcarTodas(event)" title="@Resources.Strings.Notif_MarcarLeidas"
                                                style="color:rgba(255,255,255,0.78);background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.18);width:30px;height:30px;border-radius:8px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .15s;flex-shrink:0;"
                                                onmouseover="this.style.background='rgba(255,255,255,0.2)'"
                                                onmouseout="this.style.background='rgba(255,255,255,0.1)'">
                                            <i class="fas fa-check-double" style="font-size:0.72rem;"></i>
                                        </button>
                                        <button onclick="notifLimpiarTodas(event)" title="@Resources.Strings.Notif_Limpiar"
                                                style="color:rgba(255,255,255,0.78);background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.18);width:30px;height:30px;border-radius:8px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .15s;flex-shrink:0;"
                                                onmouseover="this.style.background='rgba(239,68,68,0.35)';this.style.borderColor='rgba(239,68,68,0.5)'"
                                                onmouseout="this.style.background='rgba(255,255,255,0.1)';this.style.borderColor='rgba(255,255,255,0.18)'">
                                            <i class="fas fa-trash-alt" style="font-size:0.68rem;"></i>
                                        </button>
                                    </div>
                                </div>
                                <!-- Lista -->
                                <div id="notifList" style="max-height:400px; overflow-y:auto; scrollbar-width:thin; scrollbar-color:#e0d9ff transparent;"></div>
                                <!-- Estado vacío -->
                                <div id="notifVacio" style="text-align:center; padding:44px 20px; display:none;">
                                    <div style="width:54px; height:54px; border-radius:16px; background:#f0eeff; display:flex; align-items:center; justify-content:center; margin:0 auto 14px;">
                                        <i class="fas fa-bell-slash" style="font-size:1.35rem; color:#a5b4fc;"></i>
                                    </div>
                                    <div style="font-size:0.84rem; font-weight:600; color:#4b5563; margin-bottom:4px;">@Resources.Strings.Notif_Vacio</div>
                                </div>
                            </div>
                        </li>
                        <li class="nav-item dropdown no-arrow">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button"
                               data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <div class="d-none d-lg-inline mr-2 text-left">
                                    <div class="text-gray-600 small" style="color: white !important; font-weight: 600;">
                                        @(UsuarioSesionHelper.UsuarioActual != null ? UsuarioSesionHelper.UsuarioActual.Nombre + " " + UsuarioSesionHelper.UsuarioActual.Apellidos : Resources.Strings.Layout_Guest)
                                    </div>
                                    @{
                                        var empresasTopbar = ViewBag.Empresas as List<bufinscustomers.Models.Empresas>;
                                        var empresaUsuarioTopbar = empresasTopbar?.FirstOrDefault(e => e.Id == idEmpresa);
                                        var adminLevel = UsuarioSesionHelper.UsuarioActual?.Admin;
                                        string rolTexto;
                                        string rolIcono;
                                        string rolColor;
                                        if (adminLevel == 2)
                                        {
                                            rolTexto = Resources.Strings.Layout_RoleSuperAdmin;
                                            rolIcono = "fas fa-crown";
                                            rolColor = "#FFD700";
                                        }
                                        else if (adminLevel == 1)
                                        {
                                            rolTexto = Resources.Strings.Layout_RoleAdmin + (empresaUsuarioTopbar != null ? " - " + empresaUsuarioTopbar.Nombre : "");
                                            rolIcono = "fas fa-user-shield";
                                            rolColor = "#01E1D7";
                                        }
                                        else
                                        {
                                            rolTexto = Resources.Strings.Layout_RoleUser + (empresaUsuarioTopbar != null ? " - " + empresaUsuarioTopbar.Nombre : "");
                                            rolIcono = "fas fa-user";
                                            rolColor = "rgba(255, 255, 255, 0.7)";
                                        }
                                    }
                                    <div class="text-gray-400" style="font-size: 0.75rem; color: rgba(255, 255, 255, 0.7) !important;">
                                        <i class="@rolIcono" style="font-size: 0.7rem; margin-right: 4px; color: @rolColor !important;"></i>@rolTexto
                                    </div>
                                </div>
                                @if (usuario?.Imagen != null)
                                {
                                    <img src="@Url.Action("Imagen", "Usuario", new { id = usuario.Id })"
                                         alt="Imagen de usuario"
                                         class="imgPerfil img-profile rounded-circle"
                                         style="max-width:150px; max-height:150px;" />
                                }
                                else
                                {
                                    <img src="~/Assets/img/avatar.png"
                                         alt="Imagen por defecto"
                                         class="imgPerfil img-profile rounded-circle"
                                         style="max-width:150px; max-height:150px;" />
                                }
                            </a>
                            <div class="dropdown-menu dropdown-menu-right animated--grow-in user-dropdown-menu"
                                 aria-labelledby="userDropdown">
                                <a class="dropdown-item" href="#" data-toggle="modal" data-target="#modalPerfilUsuario">
                                    <i class="fas fa-user fa-sm fa-fw"></i>
                                    @Resources.Strings.Layout_Profile
                                </a>
                                <div class="dropdown-divider"></div>
                                <div class="user-dd-lang-row">
                                    <span class="user-dd-lang-label">
                                        <i class="fas fa-globe"></i>@Resources.Strings.Layout_LangSwitcher
                                    </span>
                                    <div class="lang-switcher">
                                        <a href="@Url.Action("SetLanguage", "Acceso", new { lang = "es-CO", returnUrl = Request.Url.PathAndQuery })" class="lang-btn @_esActiveClass">Español</a>
                                        <span class="lang-sep"></span>
                                        <a href="@Url.Action("SetLanguage", "Acceso", new { lang = "en-US", returnUrl = Request.Url.PathAndQuery })" class="lang-btn @_enActiveClass">English</a>
                                    </div>
                                </div>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item user-dd-logout" href="@Url.Action("Login", "Acceso")">
                                    <i class="fas fa-sign-out-alt fa-sm fa-fw"></i>
                                    @Resources.Strings.Layout_Logout
                                </a>
                            </div>
                        </li>
                    </ul>
                </nav>
                <div class="container-fluid">
                    <div class="container body-content">
                        @RenderBody()
                        <hr />
                    </div>
                </div>
            </div>
            <!-- Modal de información de usuario - Mejorado -->
            <div class="modal fade" id="modalPerfilUsuario" tabindex="-1" role="dialog" aria-labelledby="modalPerfilUsuarioLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
                    <div class="modal-content modal-perfil-moderno">
                        <div class="modal-header modal-header-gradient">
                            <h5 class="modal-title" id="modalPerfilUsuarioLabel">
                                <i class="fas fa-user-circle mr-2"></i>@Resources.Strings.Layout_ProfileModalTitle
                            </h5>
                            <button type="button" class="close text-white" data-dismiss="modal" aria-label="@Resources.Strings.Layout_Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body modal-body-perfil">
                            <div class="container-fluid">
                                <!-- Foto de perfil centrada arriba -->
                                <div class="row mb-4">
                                    <div class="col-12 text-center">
                                        @if (usuario?.Imagen != null)
                                        {
                                            <img src="@Url.Action("Imagen", "Usuario", new { id = usuario.Id })"
                                                 alt="Imagen de usuario"
                                                 class="imgPerfil-moderno img-profile rounded-circle shadow-lg" />
                                        }
                                        else
                                        {
                                            <img src="~/Assets/img/avatar.png"
                                                 alt="Imagen por defecto"
                                                 class="imgPerfil-moderno img-profile rounded-circle shadow-lg" />
                                        }
                                    </div>
                                </div>
                                <!-- Información del usuario con iconos en 3 columnas -->
                                <div class="row">
                                    <!-- Columna 1 -->
                                    <div class="col-lg-4 col-md-6">
                                        <div class="info-item">
                                            <i class="fas fa-user info-icon"></i>
                                            <div class="info-content">
                                                <span class="info-label">@Resources.Strings.Layout_LabelName</span>
                                                <span class="info-value">@(UsuarioSesionHelper.UsuarioActual?.Nombre ?? Resources.Strings.Layout_Guest)</span>
                                            </div>
                                        </div>
                                        <div class="info-item">
                                            <i class="fas fa-id-card info-icon"></i>
                                            <div class="info-content">
                                                <span class="info-label">@Resources.Strings.Layout_LabelLastName</span>
                                                <span class="info-value">@(UsuarioSesionHelper.UsuarioActual?.Apellidos ?? "-")</span>
                                            </div>
                                        </div>
                                        <div class="info-item">
                                            <i class="fas fa-envelope info-icon"></i>
                                            <div class="info-content">
                                                <span class="info-label">@Resources.Strings.Layout_LabelEmail</span>
                                                <span class="info-value">@(UsuarioSesionHelper.UsuarioActual?.Correo ?? "-")</span>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Columna 2 -->
                                    <div class="col-lg-4 col-md-6">
                                        <div class="info-item">
                                            <i class="fas fa-phone info-icon"></i>
                                            <div class="info-content">
                                                <span class="info-label">@Resources.Strings.Layout_LabelPhone</span>
                                                <span class="info-value">@(UsuarioSesionHelper.UsuarioActual?.Telefono ?? "-")</span>
                                            </div>
                                        </div>
                                        <div class="info-item">
                                            <i class="fas fa-user-tag info-icon"></i>
                                            <div class="info-content">
                                                <span class="info-label">@Resources.Strings.Layout_LabelUsername</span>
                                                <span class="info-value">@(UsuarioSesionHelper.UsuarioActual?.Usuario ?? "-")</span>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Columna 3 -->
                                    <div class="col-lg-4 col-md-12">
                                        <div class="info-item">
                                            <i class="fas fa-shield-alt info-icon"></i>
                                            <div class="info-content">
                                                <span class="info-label">@Resources.Strings.Layout_LabelRole</span>
                                                <span class="info-value">@(UsuarioSesionHelper.UsuarioActual?.Admin == 1 ? Resources.Strings.Layout_RoleAdmin : Resources.Strings.Layout_RoleUser)</span>
                                            </div>
                                        </div>
                                        @{
                                            var empresas = ViewBag.Empresas as List<bufinscustomers.Models.Empresas>;
                                            var empresaActual = empresas?.FirstOrDefault(e => e.Id == idEmpresa);
                                        }
                                        <div class="info-item">
                                            <i class="fas fa-building info-icon"></i>
                                            <div class="info-content">
                                                <span class="info-label">@Resources.Strings.Layout_LabelCompany</span>
                                                <span class="info-value">@(empresaActual != null ? empresaActual.Nombre : Resources.Strings.Layout_NoCompany)</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer modal-footer-perfil">
                            <button type="button" class="btn btn-gradient-modern" data-toggle="modal" data-target="#modalCargarImagen" data-dismiss="modal">
                                <i class="fas fa-camera mr-2"></i>@Resources.Strings.Layout_ChangeImage
                            </button>
                            <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">
                                <i class="fas fa-times mr-2"></i>@Resources.Strings.Layout_Close
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal fade" id="modalCargarImagen" tabindex="-1" role="dialog" aria-labelledby="modalCargarImagenLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <form id="formCargarImagen" enctype="multipart/form-data" method="post" action="@Url.Action("CargarImagenUsuario", "Usuario")">
                        <div class="modal-content modal-cargar-imagen-moderno">
                            <div class="modal-header modal-header-gradient">
                                <h5 class="modal-title" id="modalCargarImagenLabel">
                                    <i class="fas fa-camera mr-2"></i>@Resources.Strings.Layout_UploadImageTitle
                                </h5>
                                <button type="button" class="close text-white" data-dismiss="modal" aria-label="@Resources.Strings.Layout_Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body modal-body-cargar-imagen">
                                <div class="upload-area">
                                    <div class="upload-icon">
                                        <i class="fas fa-cloud-upload-alt"></i>
                                    </div>
                                    <h6 class="upload-title mb-1">@Resources.Strings.Layout_SelectImage</h6>
                                    <p class="upload-info mb-2">
                                        <i class="fas fa-info-circle mr-1"></i>
                                        @Resources.Strings.Layout_ImageConstraints
                                    </p>
                                    <label for="ImagenUsuario" class="btn btn-gradient-modern btn-select-file mb-2">
                                        <i class="fas fa-folder-open mr-2"></i>@Resources.Strings.Layout_SelectFile
                                    </label>
                                    <input type="file" id="ImagenUsuario" name="ImagenUsuario" accept="image/png, image/jpeg" class="file-input-hidden" required />
                                    <p class="file-name mb-0" id="fileName">@Resources.Strings.Layout_NoFileSelected</p>
                                </div>
                                <div class="preview-area text-center">
                                    <img id="previewImagen" src="#" alt="Vista previa" class="preview-image" />
                                </div>
                                <div id="mensajeImagen" class="mt-2"></div>
                            </div>
                            <div class="modal-footer modal-footer-perfil">
                                <button type="submit" class="btn btn-gradient-modern">
                                    <i class="fas fa-save mr-2"></i>@Resources.Strings.Layout_Save
                                </button>
                                <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">
                                    <i class="fas fa-times mr-2"></i>@Resources.Strings.Layout_Cancel
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <a class="scroll-to-top rounded" href="#">
        <i class="fas fa-angle-up"></i>
    </a>

    <script src="~/Assets/js/sweetalert2.all.min.js" defer></script>
    @Scripts.Render("~/bundles/js-global")

    @RenderSection("scripts", required: false)

    <script>
        // ========== COMPORTAMIENTO RESPONSIVE CORREGIDO ========== 
        $(document).ready(function() {
            // Función para verificar si estamos en móvil
            function isMobile() {
                return $(window).width() < 768;
            }

            // Toggle para móvil - corregido
            $('#sidebarToggleTop').on('click', function(e) {
                e.preventDefault();
                if (isMobile()) {
                    $('#accordionSidebar').toggleClass('show');
                    $('body').toggleClass('sidebar-open');
                }
            });
            
            // Cerrar sidebar al hacer click en overlay (móvil) - corregido
            $(document).on('click', function(e) {
                if (isMobile() && 
                    !$(e.target).closest('#accordionSidebar').length && 
                    !$(e.target).closest('#sidebarToggleTop').length &&
                    $('#accordionSidebar').hasClass('show')) {
                    $('#accordionSidebar').removeClass('show');
                    $('body').removeClass('sidebar-open');
                }
            });

            // CORREGIDO: Solo cerrar sidebar en enlaces finales (.collapse-item), NO en nav-links
            $('#accordionSidebar .collapse-item').on('click', function(e) {
                if (isMobile() && $(this).attr('href') && $(this).attr('href') !== '#') {
                    setTimeout(function() {
                        $('#accordionSidebar').removeClass('show');
                        $('body').removeClass('sidebar-open');
                    }, 100);
                }
            });

            // NO cerrar el sidebar al hacer click en nav-links (elementos de menú principal)
            // Esto permite que se abran los submenús
            
            // Responsive behavior en resize
            $(window).on('resize', function() {
                if (!isMobile()) {
                    $('#accordionSidebar').removeClass('show');
                    $('body').removeClass('sidebar-open');
                }
            });

            // Mejorar el comportamiento del sidebar toggle en desktop
            $('#sidebarToggle').on('click', function() {
                if (!isMobile()) {
                    $('body').toggleClass('sidebar-toggled');
                }
            });

            // Asegurar que Bootstrap collapse funcione correctamente
            if (isMobile()) {
                // En móvil, asegurar que los collapses funcionen con eventos touch
                $('#accordionSidebar .nav-link[data-toggle="collapse"]').on('touchstart', function(e) {
                    // Prevenir comportamientos extraños en dispositivos táctiles
                    e.stopPropagation();
                });
            }
        });

        // ========== FUNCIONALIDADES DE IMAGEN DE USUARIO ==========
        // Funcionalidad de imagen de usuario mejorada
        $('#ImagenUsuario').on('change', function () {
            var input = this;
            var preview = document.getElementById('previewImagen');
            var fileName = document.getElementById('fileName');
            var mensajeDiv = $('#mensajeImagen');

            mensajeDiv.html('');
            preview.classList.remove('show');

            if (input.files && input.files[0]) {
                var file = input.files[0];

                // Mostrar nombre del archivo
                fileName.textContent = file.name;
                fileName.classList.add('selected');

                if (file.size > 204800) {
                    mensajeDiv.html('<div class="alert alert-danger"><i class="fas fa-exclamation-triangle"></i>La imagen debe pesar menos de 200 KB.</div>');
                    fileName.textContent = 'Ningún archivo seleccionado';
                    fileName.classList.remove('selected');
                    return;
                }

                var reader = new FileReader();
                reader.onload = function (e) {
                    var img = new Image();
                    img.onload = function () {
                        if (img.width > 400 || img.height > 400) {
                            mensajeDiv.html('<div class="alert alert-danger"><i class="fas fa-exclamation-triangle"></i>La imagen debe tener máximo 400x400 píxeles.</div>');
                            preview.classList.remove('show');
                            fileName.textContent = 'Ningún archivo seleccionado';
                            fileName.classList.remove('selected');
                        } else {
                            preview.src = e.target.result;
                            preview.classList.add('show');
                        }
                    };
                    img.onerror = function () {
                        mensajeDiv.html('<div class="alert alert-danger"><i class="fas fa-exclamation-triangle"></i>Archivo de imagen no válido.</div>');
                        preview.classList.remove('show');
                        fileName.textContent = 'Ningún archivo seleccionado';
                        fileName.classList.remove('selected');
                    };
                    img.src = e.target.result;
                };
                reader.readAsDataURL(file);
            } else {
                fileName.textContent = 'Ningún archivo seleccionado';
                fileName.classList.remove('selected');
            }
        });

