        // ========== GESTIÓN AVANZADA DE SESIONES ==========
        
        // Variables de configuración de sesión
        var sessionTimeoutMinutes = 20; // Configurado en Web.config
        var sessionWarningMinutes = 5;  // Advertir 5 minutos antes
        var sessionCheckInterval = 60000; // Verificar cada minuto
        
        var sessionTimeoutMs = sessionTimeoutMinutes * 60 * 1000;
        var warningTimeMs = sessionTimeoutMs - (sessionWarningMinutes * 60 * 1000);
        
        var warningShown = false;
        var sessionWarningTimer = null;
        var sessionTimeoutTimer = null;
        var activityCheckTimer = null;

        // Inicializar manejo de sesión
        function inicializarManejoSesion() {
            // Timer para mostrar advertencia
            sessionWarningTimer = setTimeout(function() {
                mostrarAdvertenciaSesion();
            }, warningTimeMs);
            
            // Timer para logout automático
            sessionTimeoutTimer = setTimeout(function() {
                cerrarSesionAutomatica();
            }, sessionTimeoutMs);
            
            // Verificar estado de sesión periódicamente
            activityCheckTimer = setInterval(function() {
                verificarEstadoSesion();
            }, sessionCheckInterval);
        }

        // Mostrar advertencia de sesión próxima a expirar
        function mostrarAdvertenciaSesion() {
            if (warningShown) return;
            warningShown = true;
            if (typeof notifPushLocal === 'function')
                notifPushLocal('warning', _notifStr.sesionTitulo, _notifStr.sesionMsg);
            
            Swal.fire({
                title: '⏰ Sesión por expirar',
                html: `
                    <div style="text-align: center;">
                        <p>Su sesión expirará en <strong>${sessionWarningMinutes} minutos</strong>.</p>
                        <p>¿Desea extender su sesión?</p>
                        <div style="margin-top: 15px;">
                            <i class="fas fa-clock" style="font-size: 2em; color: #f39c12;"></i>
                        </div>
                    </div>
                `,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: '<i class="fas fa-clock"></i> Extender sesión',
                cancelButtonText: '<i class="fas fa-sign-out-alt"></i> Cerrar sesión',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-secondary'
                },
                timer: sessionWarningMinutes * 60 * 1000, // Auto-close al expirar
                timerProgressBar: true,
                didOpen: () => {
                    const confirmButton = Swal.getConfirmButton();
                    const cancelButton = Swal.getCancelButton();
                    confirmButton.style.marginRight = '10px';
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    extenderSesion();
                } else if (result.isDismissed && result.dismiss === Swal.DismissReason.timer) {
                    // Timer expiró - cerrar sesión automáticamente
                    cerrarSesionAutomatica();
                } else {
                    // Usuario eligió cerrar sesión
                    cerrarSesionManual();
                }
            });
        }

        // Extender sesión vía AJAX
        function extenderSesion() {
            // Mostrar loading
            Swal.fire({
                title: 'Extendiendo sesión...',
                text: 'Por favor espere',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            $.ajax({
                url: '@Url.Action("ExtenderSesion", "Acceso")',
                type: 'POST',
                timeout: 10000,
                success: function(response) {
                    if (response.success) {
                        // Mostrar mensaje de éxito
                        const isMobile = window.innerWidth <= 768;
                        Swal.fire({
                            icon: 'success',
                            title: '✅ Sesión extendida',
                            text: 'Su sesión ha sido extendida por ' + sessionTimeoutMinutes + ' minutos más.',
                            timer: 3000,
                            showConfirmButton: false,
                            toast: true,
                            position: isMobile ? 'top' : 'top-end',
                            timerProgressBar: true
                        });
                        
                        // Reiniciar timers
                        reiniciarTimersSesion();
                    } else {
                        // Error al extender sesión
                        Swal.fire({
                            icon: 'error',
                            title: 'Error al extender sesión',
                            text: response.message || 'No se pudo extender la sesión. Será redirigido al login.',
                            showConfirmButton: true,
                            confirmButtonText: 'Ir al Login'
                        }).then(() => {
                            window.location.href = response.redirectUrl || '@Url.Action("Login", "Acceso")';
                        });
                    }
                },
                error: function(xhr, status, error) {
                    let errorMessage = 'Error de conexión con el servidor.';
                    
                    if (status === 'timeout') {
                        errorMessage = 'Tiempo de espera agotado. Verifique su conexión.';
                    } else if (xhr.status === 401) {
                        errorMessage = 'Su sesión ha expirado.';
                    }
                    
                    Swal.fire({
                        icon: 'error',
                        title: 'Error de conexión',
                        text: errorMessage,
                        showConfirmButton: true,
                        confirmButtonText: 'Ir al Login'
                    }).then(() => {
                        window.location.href = '@Url.Action("Login", "Acceso")?expired=true';
                    });
                }
            });
        }

        // Cerrar sesión automática por timeout
        function cerrarSesionAutomatica() {
            Swal.fire({
                icon: 'info',
                title: '⏰ Sesión expirada',
                html: `
                    <div style="text-align: center;">
                        <p>Su sesión ha expirado por inactividad.</p>
                        <p>Será redirigido al login en <span id="countdown">5</span> segundos...</p>
                        <div style="margin-top: 15px;">
                            <i class="fas fa-hourglass-end" style="font-size: 2em; color: #e74c3c;"></i>
                        </div>
                    </div>
                `,
                timer: 5000,
                timerProgressBar: true,
                showConfirmButton: false,
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => {
                    const countdownElement = document.getElementById('countdown');
                    let countdown = 5;
                    
                    const countdownTimer = setInterval(() => {
                        countdown--;
                        if (countdownElement) {
                            countdownElement.textContent = countdown;
                        }
                        
                        if (countdown <= 0) {
                            clearInterval(countdownTimer);
                        }
                    }, 1000);
                }
            }).then(() => {
                window.location.href = '@Url.Action("Login", "Acceso")?expired=true';
            });
        }

        // Cerrar sesión manual
        function cerrarSesionManual() {
            Swal.fire({
                title: 'Cerrando sesión...',
                text: 'Por favor espere',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });
            
            setTimeout(() => {
                window.location.href = '@Url.Action("CerrarSesion", "Acceso")';
            }, 1000);
        }

        // Verificar estado de sesión con el servidor
        function verificarEstadoSesion() {
            $.ajax({
                url: '@Url.Action("InfoSesion", "Acceso")',
                type: 'GET',
                timeout: 5000,
                success: function(response) {
                    if (!response.success || !response.estaAutenticado) {
                        // Sesión no válida en servidor
                        limpiarTimersSesion();
                        cerrarSesionAutomatica();
                    } else if (response.sessionInfo && response.sessionInfo.EstaPorExpirar && !warningShown) {
                        // Sesión próxima a expirar
                        limpiarTimersSesion();
                        mostrarAdvertenciaSesion();
                    }
                },
                error: function(xhr, status, error) {
                    // Solo actuar si es un error 401 (no autorizado)
                    if (xhr.status === 401) {
                        limpiarTimersSesion();
                        cerrarSesionAutomatica();
                    }
                    // Otros errores los ignoramos (podrían ser problemas de red temporales)
                }
            });
        }

        // Reiniciar todos los timers de sesión
        function reiniciarTimersSesion() {
            limpiarTimersSesion();
            warningShown = false;
            inicializarManejoSesion();
        }

        // Limpiar todos los timers de sesión
        function limpiarTimersSesion() {
            if (sessionWarningTimer) {
                clearTimeout(sessionWarningTimer);
                sessionWarningTimer = null;
            }
            if (sessionTimeoutTimer) {
                clearTimeout(sessionTimeoutTimer);
                sessionTimeoutTimer = null;
            }
            if (activityCheckTimer) {
                clearInterval(activityCheckTimer);
                activityCheckTimer = null;
            }
        }

        // Detectar actividad del usuario para reiniciar timers
        var activityEvents = ['click', 'keypress', 'scroll', 'mousemove', 'touchstart'];
        var lastActivityTime = Date.now();
        var activityThreshold = 30000; // 30 segundos

        // Agregar listeners de actividad
        activityEvents.forEach(function(event) {
            document.addEventListener(event, function() {
                var now = Date.now();
                if (now - lastActivityTime > activityThreshold) {
                    lastActivityTime = now;
                    // Solo reiniciar si no se ha mostrado la advertencia
                    if (!warningShown) {
                        reiniciarTimersSesion();
                    }
                }
            }, true);
        });

        // Manejar respuestas AJAX que indican sesión expirada
        $(document).ajaxSuccess(function(event, xhr, settings) {
            var sessionExpired = xhr.getResponseHeader('X-Session-Expired');
            if (sessionExpired === 'true') {
                limpiarTimersSesion();
                cerrarSesionAutomatica();
            }
        });

        // Manejar errores de sesión en peticiones AJAX globalmente
        $(document).ajaxError(function(event, xhr, settings) {
            if (xhr.status === 401) {
                limpiarTimersSesion();
                cerrarSesionAutomatica();
            }
        });

        // Agregar funcionalidad al enlace "Cerrar sesión" del dropdown
        $('a[href*="Login"][href*="Acceso"]:contains("Cerrar sesión")').on('click', function(e) {
            e.preventDefault();
            
            Swal.fire({
                title: '¿Cerrar sesión?',
                text: '¿Está seguro que desea cerrar su sesión?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: '<i class="fas fa-sign-out-alt"></i> Sí, cerrar sesión',
                cancelButtonText: '<i class="fas fa-times"></i> Cancelar',
                customClass: {
                    confirmButton: 'btn btn-danger',
                    cancelButton: 'btn btn-secondary'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    limpiarTimersSesion();
                    cerrarSesionManual();
                }
            });
        });

        // Inicializar cuando el documento esté listo
        $(document).ready(function() {
            // Solo inicializar si no estamos en la página de login
            if (!window.location.pathname.toLowerCase().includes('/acceso/login')) {
                inicializarManejoSesion();
            }
        });

        // Limpiar timers al salir de la página
        $(window).on('beforeunload', function() {
            limpiarTimersSesion();
        });

        // ═══════════════════════════════════════
        // Centro de notificaciones
        // ═══════════════════════════════════════
        var _notifStr = {
            ahoraMismo:       '@Resources.Strings.Notif_AhoraMismo',
            min:              '@Resources.Strings.Notif_Minutos',
            h:                '@Resources.Strings.Notif_Horas',
            d:                '@Resources.Strings.Notif_Dias',
            sesionTitulo:     '@Resources.Strings.Notif_SesionExpiraTitulo',
            sesionMsg:        '@Resources.Strings.Notif_SesionExpiraMsg'
        };
        var _notifUrl         = '@Url.Action("Recientes",        "Notificaciones")';
        var _notifLeidaUrl    = '@Url.Action("MarcarLeida",      "Notificaciones")';
        var _notifTodasUrl    = '@Url.Action("MarcarTodasLeidas","Notificaciones")';
        var _notifLimpiarUrl  = '@Url.Action("LimpiarTodas",    "Notificaciones")';
        var _notifElimUrl     = '@Url.Action("Eliminar",         "Notificaciones")';
        var _notifTimer      = null;

        function notifTiempoRelativo(fechaStr) {
            var ms;
            var m = /\/Date\((\d+)/.exec(fechaStr);
            if (m) { ms = parseInt(m[1]); }
            else   { ms = new Date(fechaStr).getTime(); }
            var diff = Date.now() - ms;
            if (diff <     60000) return _notifStr.ahoraMismo;
            if (diff <   3600000) return Math.floor(diff / 60000) + ' ' + _notifStr.min;
            if (diff <  86400000) return Math.floor(diff / 3600000) + _notifStr.h;
            return Math.floor(diff / 86400000) + _notifStr.d;
        }

        function notifRenderItem(n) {
            var iconMap  = { success:'fa-check-circle', info:'fa-info-circle', warning:'fa-exclamation-triangle', error:'fa-times-circle' };
            var colorMap = { success:'#16a34a', info:'#4F46E5', warning:'#d97706', error:'#dc2626' };
            var bgMap    = { success:'#f0fdf4', info:'#ede9fe', warning:'#fffbeb', error:'#fef2f2' };
            var icon  = iconMap[n.Tipo]  || 'fa-bell';
            var color = colorMap[n.Tipo] || '#4F46E5';
            var iconBg = bgMap[n.Tipo]   || '#ede9fe';
            var unread = !n.Leida;
            var bg     = unread ? '#faf9ff' : '#ffffff';
            var border = unread ? 'border-left:3px solid #4F46E5;' : 'border-left:3px solid transparent;';
            var fw     = unread ? '600' : '400';
            var titleColor = unread ? '#1E1B4B' : '#374151';
            var msg    = n.Mensaje
                ? '<div style="font-size:0.76rem;color:#6b7280;margin-top:2px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">' + n.Mensaje + '</div>'
                : '';
            var idAttr = n.Id;
            return '<div class="notif-item" data-id="' + idAttr + '" onclick="notifMarcarLeida(this)"' +
                   ' onmouseover="if(this.dataset.leida!==\'1\')this.style.background=\'#f3f0ff\';else this.style.background=\'#f9fafb\';"' +
                   ' onmouseout="this.style.background=\'' + bg + '\';"' +
                   ' style="display:flex;align-items:flex-start;padding:12px 16px 12px 13px;border-bottom:1px solid #f3f4f6;background:' + bg + ';cursor:pointer;gap:12px;transition:background .15s;' + border + '"' +
                   ' data-leida="' + (n.Leida ? '1' : '0') + '">' +
                   '<div style="flex-shrink:0;width:34px;height:34px;border-radius:10px;background:' + iconBg + ';display:flex;align-items:center;justify-content:center;margin-top:1px;">' +
                   '<i class="fas ' + icon + '" style="color:' + color + ';font-size:0.82rem;"></i></div>' +
                   '<div style="flex:1;min-width:0;">' +
                   '<div style="font-weight:' + fw + ';font-size:0.83rem;color:' + titleColor + ';line-height:1.3;">' + n.Titulo + '</div>' +
                   msg +
                   '<div style="font-size:0.69rem;color:#9ca3af;margin-top:4px;display:flex;align-items:center;gap:5px;">' +
                   (unread ? '<span style="width:5px;height:5px;border-radius:50%;background:#4F46E5;display:inline-block;flex-shrink:0;"></span>' : '') +
                   notifTiempoRelativo(n.FechaCreacion) + '</div>' +
                   '</div></div>';
        }

        function notifRefrescar(data) {
            var badge  = document.getElementById('notifBadge');
            var list   = document.getElementById('notifList');
            var vacio  = document.getElementById('notifVacio');
            var bell   = document.getElementById('notifBellItem');

            if (!badge || !list || !vacio) return;
            if (bell) bell.style.display = '';   // mostrar campanita tras primer fetch

            if (data.noLeidas > 0) {
                badge.textContent = data.noLeidas > 9 ? '9+' : data.noLeidas;
                badge.style.display = '';
            } else {
                badge.style.display = 'none';
            }

            if (!data.items || data.items.length === 0) {
                list.innerHTML = '';
                vacio.style.display = '';
            } else {
                vacio.style.display = 'none';
                list.innerHTML = data.items.map(notifRenderItem).join('');
            }
        }

        function notifCargar() {
            $.getJSON(_notifUrl, function(data) { notifRefrescar(data); });
        }

        function notifMarcarLeida(el) {
            if ($(el).data('leida') === '1') return;
            var id = $(el).data('id');
            var actualizarUI = function() {
                $(el).css({ 'background': '#ffffff', 'border-left': '3px solid transparent' });
                $(el).attr('data-leida', '1');
                $(el).find('[style*="font-weight:600"]').css('font-weight', '400');
                $(el).find('[style*="font-weight:600"]').css('color', '#374151');
                $(el).find('[style*="background:#4F46E5"]').remove(); // quita el punto
                _notifActualizarBadge(-1);
            };
            if (typeof id === 'string' && id.indexOf('local_') === 0) {
                actualizarUI(); return;
            }
            $.post(_notifLeidaUrl, { id: id }, function(r) { if (r.success) actualizarUI(); });
        }

        function notifMarcarTodas(ev) {
            if (ev) ev.stopPropagation();
            $.post(_notifTodasUrl, function(r) { if (r.success) notifCargar(); });
        }

        function notifLimpiarTodas(ev) {
            if (ev) ev.stopPropagation();
            Swal.fire({
                title: '@Html.Raw(Resources.Strings.Notif_LimpiarConfirmTitulo)',
                text:  '@Html.Raw(Resources.Strings.Notif_LimpiarConfirmMsg)',
                icon:  'warning',
                showCancelButton: true,
                confirmButtonText: '<i class="fas fa-trash-alt mr-1"></i> @Html.Raw(Resources.Strings.Notif_LimpiarConfirmBtn)',
                cancelButtonText:  '<i class="fas fa-times mr-1"></i> @Html.Raw(Resources.Strings.Layout_Close)',
                confirmButtonColor: '#dc2626',
                customClass: { confirmButton: 'btn btn-danger btn-sm', cancelButton: 'btn btn-secondary btn-sm' },
                buttonsStyling: false
            }).then(function(result) {
                if (!result.isConfirmed) return;
                $.post(_notifLimpiarUrl, function(r) {
                    if (r.success) {
                        document.getElementById('notifList').innerHTML = '';
                        document.getElementById('notifVacio').style.display = '';
                        document.getElementById('notifBadge').style.display = 'none';
                    }
                });
            });
        }

        function _notifActualizarBadge(delta) {
            var badge = document.getElementById('notifBadge');
            if (!badge) return;
            var cur = parseInt(badge.textContent) || 0;
            var nuevo = Math.max(0, cur + delta);
            if (nuevo > 0) { badge.textContent = nuevo > 9 ? '9+' : nuevo; }
            else           { badge.style.display = 'none'; }
        }

        // Empujar notificación solo en cliente (sesión por expirar)
        window.notifPushLocal = function(tipo, titulo, mensaje) {
            var n = { Id: 'local_' + Date.now(), Tipo: tipo, Titulo: titulo,
                      Mensaje: mensaje || null, Leida: false, FechaCreacion: '/Date(' + Date.now() + ')/' };
            var list  = document.getElementById('notifList');
            var vacio = document.getElementById('notifVacio');
            if (!list || !vacio) return;
            vacio.style.display = 'none';
            list.insertAdjacentHTML('afterbegin', notifRenderItem(n));
            _notifActualizarBadge(+1);
        };

        $(document).ready(function() {
            if (!window.location.pathname.toLowerCase().includes('/acceso/login')) {
                notifCargar();
                _notifTimer = setInterval(notifCargar, 30000);
            }
        });

        // Debug: Función global para obtener info de sesión (solo en desarrollo)
        window.obtenerInfoSesion = function() {
            $.get('@Url.Action("InfoSesion", "Acceso")', function(data) {
                console.log('Estado de sesión:', data);
            });
        };
    </script>

    <!-- Floating language pill — shown dynamically when topbar lang switcher is off-screen -->
    <div class="lang-float-pill">
        <i class="fas fa-globe lang-switcher-icon"></i>
        <div class="lang-switcher">
            <a href="@Url.Action("SetLanguage", "Acceso", new { lang = "es-CO", returnUrl = Request.Url.PathAndQuery })" class="lang-btn @_esActiveClass">Español</a>
            <span class="lang-sep"></span>
            <a href="@Url.Action("SetLanguage", "Acceso", new { lang = "en-US", returnUrl = Request.Url.PathAndQuery })" class="lang-btn @_enActiveClass">English</a>
        </div>
    </div>
    <script>
    (function () {
        var pill = document.querySelector('.lang-float-pill');
        var ref  = document.querySelector('.lang-pill-nav');
        if (!pill || !ref) return;
        new IntersectionObserver(function (entries) {
            pill.classList.toggle('lang-float-visible', !entries[0].isIntersecting);
        }, { threshold: 0.5 }).observe(ref);
    }());
    </script>
</body>
</html>