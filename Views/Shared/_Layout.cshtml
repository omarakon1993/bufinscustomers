<!DOCTYPE html>
<html>
<head>
    @using bufinscustomers.Helpers
    @using System.Web.Optimization

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>BUFINS - Principal</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico">

    <!-- FOUC prevention: inline style + script BEFORE any external CSS so rules fire on first paint without a network round-trip -->
    <style>
        html.sidebar-init-collapsed .modern-sidebar{width:70px!important;transition:none!important}
        html.sidebar-init-collapsed .main-content{margin-left:70px!important;transition:none!important}
        html.page-loading body{visibility:hidden!important}
        @@keyframes _sbReveal{to{visibility:visible}}
        html.page-loading body{animation:_sbReveal 0s 1.5s forwards}
    </style>
    <script>(function(){try{var s=JSON.parse(localStorage.getItem('bufins_sidebar_state')||'{}');if(s.collapsed&&window.innerWidth>=992)document.documentElement.classList.add('sidebar-init-collapsed');}catch(e){}document.documentElement.classList.add('page-loading');}());</script>

    <link href="~/Assets/Bootstrap/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="~/Assets/GoogleApis/Family.css" rel="stylesheet">
    <link href="~/Assets/css/sb-admin-2.min.css" rel="stylesheet">
    @Styles.Render("~/bundles/css-custom")
</head>

<body id="page-top">
    <!-- Bot\u00f3n Hamburguesa M\u00f3vil -->
    <button class="sidebar-hamburger" aria-label="Abrir men\u00fa">
        <i class="fas fa-bars"></i>
    </button>

    <!-- Backdrop para M\u00f3vil/Tablet -->
    <div class="sidebar-backdrop"></div>

    <!-- Sidebar Moderno -->
    <aside class="modern-sidebar">
        <!-- Header del Sidebar -->
        <div class="sidebar-header">
            <a href="@Url.Action("Index", "Home")" class="sidebar-logo-wrapper">
                <div class="sidebar-brand-icon">B</div>
                <span class="sidebar-logo-text">bufins</span>
            </a>
            <button class="sidebar-toggle-btn" aria-label="Colapsar">
                <i class="fas fa-angle-double-left"></i>
            </button>
        </div>

        <!-- Búsqueda en el Menú -->
        <div class="sidebar-search">
            <div class="sidebar-search-wrapper">
                <i class="fas fa-search sidebar-search-icon"></i>
                <input type="text" class="sidebar-search-input" placeholder="Buscar..." autocomplete="off">
            </div>
        </div>

        <!-- Variables de usuario para uso en topbar -->
        @{
            var usuario = UsuarioSesionHelper.UsuarioActual;
            var esAdmin2 = UsuarioSesionHelper.EsSuperAdmin();
            var idEmpresa = usuario?.IdEmpresa ?? 0;
        }

        <!-- Menú Principal (dinámico desde MenuOpciones) -->
        <nav class="sidebar-menu">
            @{
                var _ctrl = ViewContext.RouteData.Values["controller"] != null ? ViewContext.RouteData.Values["controller"].ToString() : "";
                var _action = ViewContext.RouteData.Values["action"] != null ? ViewContext.RouteData.Values["action"].ToString() : "";
                var _isHome = _ctrl == "Home" && _action == "Index";
            }
            <!-- Sección General (siempre visible) -->
            <div class="sidebar-category">
                <div class="sidebar-category-header">
                    <i class="fas fa-circle sidebar-category-icon sidebar-cat-dot"></i>
                    <span class="sidebar-category-title">General</span>
                </div>
                <div class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(_isHome ? "active" : "")" href="@Url.Action("Index", "Home")">
                        <i class="fas fa-home sidebar-nav-icon"></i>
                        <span class="sidebar-nav-text">Inicio</span>
                    </a>
                </div>
            </div>

            @{ Html.RenderPartial("_SidebarMenu", UsuarioSesionHelper.ObtenerMenuSidebar()); }
        </nav>
        <!-- Scroll restoration: runs synchronously during HTML parsing, before first paint -->
        <script>(function(){try{var s=sessionStorage.getItem('bufins_sidebar_scroll');var m=document.querySelector('.sidebar-menu');if(s&&m)m.scrollTop=parseInt(s)||0;}catch(e){}}());</script>

        <!-- Footer del Sidebar -->
        <div class="sidebar-footer">
            <span class="sidebar-footer-text">&copy; Bufins @DateTime.Now.Year</span>
        </div>
    </aside>

    <!-- Contenido Principal -->
    <div id="content-wrapper" class="d-flex flex-column main-content">
            <div id="content">
                <nav class="navbar navbar-expand navbar-light topbar mb-4 static-top shadow">
                    <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                        <i class="fa fa-bars"></i>
                    </button>

                    @{
                        string _bcGroup = null;
                        string _bcItem  = null;
                        if (!_isHome)
                        {
                            var _menuBc = UsuarioSesionHelper.ObtenerMenuSidebar();
                            if (_menuBc != null)
                            {
                                bool _bcFound = false;
                                foreach (var _bcCat in _menuBc)
                                {
                                    if (_bcFound || _bcCat.Grupos == null) { break; }
                                    foreach (var _bcGrp in _bcCat.Grupos)
                                    {
                                        if (_bcFound || _bcGrp.Items == null) { break; }
                                        foreach (var _bcItm in _bcGrp.Items)
                                        {
                                            if (_bcItm.Controller == _ctrl && _bcItm.Action == _action)
                                            {
                                                _bcItem  = _bcItm.Nombre;
                                                if (_bcGrp.Items.Count > 1) { _bcGroup = _bcGrp.Nombre; }
                                                _bcFound = true;
                                                break;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    <div class="topbar-breadcrumb d-none d-sm-flex">
                        <span class="bc-item"><a href="@Url.Action("Index", "Home")">Inicio</a></span>
                        @if (_bcGroup != null)
                        {
                            <i class="fas fa-chevron-right bc-sep"></i>
                            <span class="bc-item">@_bcGroup</span>
                        }
                        @if (_bcItem != null)
                        {
                            <i class="fas fa-chevron-right bc-sep"></i>
                            <span class="bc-current">@_bcItem</span>
                        }
                    </div>

                    <div class="topbar-divider d-none d-sm-block"></div>
                    <ul class="navbar-nav ml-auto">
                        <li class="nav-item dropdown no-arrow">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button"
                               data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <div class="d-none d-lg-inline mr-2 text-left">
                                    <div class="text-gray-600 small" style="color: white !important; font-weight: 600;">
                                        @(UsuarioSesionHelper.UsuarioActual != null ? UsuarioSesionHelper.UsuarioActual.Nombre + " " + UsuarioSesionHelper.UsuarioActual.Apellidos : "Invitado")
                                    </div>
                                    @{
                                        var empresasTopbar = ViewBag.Empresas as List<bufinscustomers.Models.Empresas>;
                                        var empresaUsuarioTopbar = empresasTopbar?.FirstOrDefault(e => e.Id == idEmpresa);
                                        var adminLevel = UsuarioSesionHelper.UsuarioActual?.Admin;
                                        string rolTexto;
                                        string rolIcono;
                                        string rolColor;
                                        if (adminLevel == 2)
                                        {
                                            rolTexto = "Super Administrador";
                                            rolIcono = "fas fa-crown";
                                            rolColor = "#FFD700";
                                        }
                                        else if (adminLevel == 1)
                                        {
                                            rolTexto = "Administrador" + (empresaUsuarioTopbar != null ? " - " + empresaUsuarioTopbar.Nombre : "");
                                            rolIcono = "fas fa-user-shield";
                                            rolColor = "#01E1D7";
                                        }
                                        else
                                        {
                                            rolTexto = "Usuario" + (empresaUsuarioTopbar != null ? " - " + empresaUsuarioTopbar.Nombre : "");
                                            rolIcono = "fas fa-user";
                                            rolColor = "rgba(255, 255, 255, 0.7)";
                                        }
                                    }
                                    <div class="text-gray-400" style="font-size: 0.75rem; color: rgba(255, 255, 255, 0.7) !important;">
                                        <i class="@rolIcono" style="font-size: 0.7rem; margin-right: 4px; color: @rolColor !important;"></i>@rolTexto
                                    </div>
                                </div>
                                @if (usuario?.Imagen != null && !string.IsNullOrEmpty(usuario.Imagen.ImagenBase64))
                                {
                                    <img src="data:@usuario.Imagen.TipoImagen;base64,@usuario.Imagen.ImagenBase64"
                                         alt="Imagen de usuario"
                                         class="imgPerfil img-profile rounded-circle"
                                         style="max-width:150px; max-height:150px;" />
                                }
                                else
                                {
                                    <img src="~/Assets/img/avatar.png"
                                         alt="Imagen por defecto"
                                         class="imgPerfil img-profile rounded-circle"
                                         style="max-width:150px; max-height:150px;" />
                                }
                            </a>
                            <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in"
                                 aria-labelledby="userDropdown">
                                <a class="dropdown-item" href="#" data-toggle="modal" data-target="#modalPerfilUsuario">
                                    <i class="fas fa-user fa-sm fa-fw mr-2" style="color: #160933!important;"></i>
                                    Perfil
                                </a>
                                @*<a class="dropdown-item" href="#">
                                        <i class="fas fa-cogs fa-sm fa-fw mr-2 text-gray-400"></i>
                                        Settings
                                    </a>
                                    <a class="dropdown-item" href="#">
                                        <i class="fas fa-list fa-sm fa-fw mr-2 text-gray-400"></i>
                                        Activity Log
                                    </a>*@
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" href="@Url.Action("Login", "Acceso")">
                                    <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2" style="color:#160933 !important;"></i>
                                    Cerrar sesión
                                </a>
                            </div>
                        </li>
                    </ul>
                </nav>
                <div class="container-fluid">
                    <div class="container body-content">
                        @RenderBody()
                        <hr />
                    </div>
                </div>
            </div>
            <!-- Modal de información de usuario - Mejorado -->
            <div class="modal fade" id="modalPerfilUsuario" tabindex="-1" role="dialog" aria-labelledby="modalPerfilUsuarioLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
                    <div class="modal-content modal-perfil-moderno">
                        <div class="modal-header modal-header-gradient">
                            <h5 class="modal-title" id="modalPerfilUsuarioLabel">
                                <i class="fas fa-user-circle mr-2"></i>Perfil de usuario
                            </h5>
                            <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body modal-body-perfil">
                            <div class="container-fluid">
                                <!-- Foto de perfil centrada arriba -->
                                <div class="row mb-4">
                                    <div class="col-12 text-center">
                                        @if (usuario?.Imagen != null && !string.IsNullOrEmpty(usuario.Imagen.ImagenBase64))
                                        {
                                            <img src="data:@usuario.Imagen.TipoImagen;base64,@usuario.Imagen.ImagenBase64"
                                                 alt="Imagen de usuario"
                                                 class="imgPerfil-moderno img-profile rounded-circle shadow-lg" />
                                        }
                                        else
                                        {
                                            <img src="~/Assets/img/avatar.png"
                                                 alt="Imagen por defecto"
                                                 class="imgPerfil-moderno img-profile rounded-circle shadow-lg" />
                                        }
                                    </div>
                                </div>
                                <!-- Información del usuario con iconos en 3 columnas -->
                                <div class="row">
                                    <!-- Columna 1 -->
                                    <div class="col-lg-4 col-md-6">
                                        <div class="info-item">
                                            <i class="fas fa-user info-icon"></i>
                                            <div class="info-content">
                                                <span class="info-label">Nombre:</span>
                                                <span class="info-value">@(UsuarioSesionHelper.UsuarioActual?.Nombre ?? "Invitado")</span>
                                            </div>
                                        </div>
                                        <div class="info-item">
                                            <i class="fas fa-id-card info-icon"></i>
                                            <div class="info-content">
                                                <span class="info-label">Apellidos:</span>
                                                <span class="info-value">@(UsuarioSesionHelper.UsuarioActual?.Apellidos ?? "-")</span>
                                            </div>
                                        </div>
                                        <div class="info-item">
                                            <i class="fas fa-envelope info-icon"></i>
                                            <div class="info-content">
                                                <span class="info-label">Email:</span>
                                                <span class="info-value">@(UsuarioSesionHelper.UsuarioActual?.Correo ?? "-")</span>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Columna 2 -->
                                    <div class="col-lg-4 col-md-6">
                                        <div class="info-item">
                                            <i class="fas fa-phone info-icon"></i>
                                            <div class="info-content">
                                                <span class="info-label">Teléfono:</span>
                                                <span class="info-value">@(UsuarioSesionHelper.UsuarioActual?.Telefono ?? "-")</span>
                                            </div>
                                        </div>
                                        <div class="info-item">
                                            <i class="fas fa-user-tag info-icon"></i>
                                            <div class="info-content">
                                                <span class="info-label">Usuario:</span>
                                                <span class="info-value">@(UsuarioSesionHelper.UsuarioActual?.Usuario ?? "-")</span>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Columna 3 -->
                                    <div class="col-lg-4 col-md-12">
                                        <div class="info-item">
                                            <i class="fas fa-shield-alt info-icon"></i>
                                            <div class="info-content">
                                                <span class="info-label">Rol:</span>
                                                <span class="info-value">@(UsuarioSesionHelper.UsuarioActual?.Admin == 1 ? "Administrador" : "Usuario")</span>
                                            </div>
                                        </div>
                                        @{
                                            var empresas = ViewBag.Empresas as List<bufinscustomers.Models.Empresas>;
                                            var empresaActual = empresas?.FirstOrDefault(e => e.Id == idEmpresa);
                                        }
                                        <div class="info-item">
                                            <i class="fas fa-building info-icon"></i>
                                            <div class="info-content">
                                                <span class="info-label">Empresa:</span>
                                                <span class="info-value">@(empresaActual != null ? empresaActual.Nombre : "Sin empresa")</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer modal-footer-perfil">
                            <button type="button" class="btn btn-gradient-modern" data-toggle="modal" data-target="#modalCargarImagen" data-dismiss="modal">
                                <i class="fas fa-camera mr-2"></i>Cambiar imagen
                            </button>
                            <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">
                                <i class="fas fa-times mr-2"></i>Cerrar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal fade" id="modalCargarImagen" tabindex="-1" role="dialog" aria-labelledby="modalCargarImagenLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <form id="formCargarImagen" enctype="multipart/form-data" method="post" action="@Url.Action("CargarImagenUsuario", "Usuario")">
                        <div class="modal-content modal-cargar-imagen-moderno">
                            <div class="modal-header modal-header-gradient">
                                <h5 class="modal-title" id="modalCargarImagenLabel">
                                    <i class="fas fa-camera mr-2"></i>Cargar imagen de usuario
                                </h5>
                                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body modal-body-cargar-imagen">
                                <div class="upload-area">
                                    <div class="upload-icon">
                                        <i class="fas fa-cloud-upload-alt"></i>
                                    </div>
                                    <h6 class="upload-title mb-1">Selecciona una imagen</h6>
                                    <p class="upload-info mb-2">
                                        <i class="fas fa-info-circle mr-1"></i>
                                        PNG o JPEG - Máx. 200 KB - Máx. 400x400 px
                                    </p>
                                    <label for="ImagenUsuario" class="btn btn-gradient-modern btn-select-file mb-2">
                                        <i class="fas fa-folder-open mr-2"></i>Seleccionar archivo
                                    </label>
                                    <input type="file" id="ImagenUsuario" name="ImagenUsuario" accept="image/png, image/jpeg" class="file-input-hidden" required />
                                    <p class="file-name mb-0" id="fileName">Ningún archivo seleccionado</p>
                                </div>
                                <div class="preview-area text-center">
                                    <img id="previewImagen" src="#" alt="Vista previa" class="preview-image" />
                                </div>
                                <div id="mensajeImagen" class="mt-2"></div>
                            </div>
                            <div class="modal-footer modal-footer-perfil">
                                <button type="submit" class="btn btn-gradient-modern">
                                    <i class="fas fa-save mr-2"></i>Guardar
                                </button>
                                <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">
                                    <i class="fas fa-times mr-2"></i>Cancelar
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <a class="scroll-to-top rounded" href="#">
        <i class="fas fa-angle-up"></i>
    </a>

    <script src="~/Assets/js/sweetalert2.all.min.js" defer></script>
    @Scripts.Render("~/bundles/js-global")

    @RenderSection("scripts", required: false)

    <script>
        // ========== COMPORTAMIENTO RESPONSIVE CORREGIDO ========== 
        $(document).ready(function() {
            // Función para verificar si estamos en móvil
            function isMobile() {
                return $(window).width() < 768;
            }

            // Toggle para móvil - corregido
            $('#sidebarToggleTop').on('click', function(e) {
                e.preventDefault();
                if (isMobile()) {
                    $('#accordionSidebar').toggleClass('show');
                    $('body').toggleClass('sidebar-open');
                }
            });
            
            // Cerrar sidebar al hacer click en overlay (móvil) - corregido
            $(document).on('click', function(e) {
                if (isMobile() && 
                    !$(e.target).closest('#accordionSidebar').length && 
                    !$(e.target).closest('#sidebarToggleTop').length &&
                    $('#accordionSidebar').hasClass('show')) {
                    $('#accordionSidebar').removeClass('show');
                    $('body').removeClass('sidebar-open');
                }
            });

            // CORREGIDO: Solo cerrar sidebar en enlaces finales (.collapse-item), NO en nav-links
            $('#accordionSidebar .collapse-item').on('click', function(e) {
                if (isMobile() && $(this).attr('href') && $(this).attr('href') !== '#') {
                    setTimeout(function() {
                        $('#accordionSidebar').removeClass('show');
                        $('body').removeClass('sidebar-open');
                    }, 100);
                }
            });

            // NO cerrar el sidebar al hacer click en nav-links (elementos de menú principal)
            // Esto permite que se abran los submenús
            
            // Responsive behavior en resize
            $(window).on('resize', function() {
                if (!isMobile()) {
                    $('#accordionSidebar').removeClass('show');
                    $('body').removeClass('sidebar-open');
                }
            });

            // Mejorar el comportamiento del sidebar toggle en desktop
            $('#sidebarToggle').on('click', function() {
                if (!isMobile()) {
                    $('body').toggleClass('sidebar-toggled');
                }
            });

            // Asegurar que Bootstrap collapse funcione correctamente
            if (isMobile()) {
                // En móvil, asegurar que los collapses funcionen con eventos touch
                $('#accordionSidebar .nav-link[data-toggle="collapse"]').on('touchstart', function(e) {
                    // Prevenir comportamientos extraños en dispositivos táctiles
                    e.stopPropagation();
                });
            }
        });

        // ========== FUNCIONALIDADES DE IMAGEN DE USUARIO ==========
        // Funcionalidad de imagen de usuario mejorada
        $('#ImagenUsuario').on('change', function () {
            var input = this;
            var preview = document.getElementById('previewImagen');
            var fileName = document.getElementById('fileName');
            var mensajeDiv = $('#mensajeImagen');

            mensajeDiv.html('');
            preview.classList.remove('show');

            if (input.files && input.files[0]) {
                var file = input.files[0];

                // Mostrar nombre del archivo
                fileName.textContent = file.name;
                fileName.classList.add('selected');

                if (file.size > 204800) {
                    mensajeDiv.html('<div class="alert alert-danger"><i class="fas fa-exclamation-triangle"></i>La imagen debe pesar menos de 200 KB.</div>');
                    fileName.textContent = 'Ningún archivo seleccionado';
                    fileName.classList.remove('selected');
                    return;
                }

                var reader = new FileReader();
                reader.onload = function (e) {
                    var img = new Image();
                    img.onload = function () {
                        if (img.width > 400 || img.height > 400) {
                            mensajeDiv.html('<div class="alert alert-danger"><i class="fas fa-exclamation-triangle"></i>La imagen debe tener máximo 400x400 píxeles.</div>');
                            preview.classList.remove('show');
                            fileName.textContent = 'Ningún archivo seleccionado';
                            fileName.classList.remove('selected');
                        } else {
                            preview.src = e.target.result;
                            preview.classList.add('show');
                        }
                    };
                    img.onerror = function () {
                        mensajeDiv.html('<div class="alert alert-danger"><i class="fas fa-exclamation-triangle"></i>Archivo de imagen no válido.</div>');
                        preview.classList.remove('show');
                        fileName.textContent = 'Ningún archivo seleccionado';
                        fileName.classList.remove('selected');
                    };
                    img.src = e.target.result;
                };
                reader.readAsDataURL(file);
            } else {
                fileName.textContent = 'Ningún archivo seleccionado';
                fileName.classList.remove('selected');
            }
        });

        $('#formCargarImagen').on('submit', function (e) {
            e.preventDefault();
            var input = document.getElementById('ImagenUsuario');
            var mensajeDiv = $('#mensajeImagen');
            var preview = document.getElementById('previewImagen');

            if (input.files.length === 0) {
                mensajeDiv.html('<div class="alert alert-danger"><i class="fas fa-exclamation-triangle"></i>Selecciona una imagen.</div>');
                return;
            }

            if (!preview.classList.contains('show')) {
                mensajeDiv.html('<div class="alert alert-danger"><i class="fas fa-exclamation-triangle"></i>La imagen seleccionada no es válida.</div>');
                return;
            }

            var formData = new FormData($('#formCargarImagen')[0]);
            $.ajax({
                url: $('#formCargarImagen').attr('action'),
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.success) {
                        $('.imgPerfil, .imgPerfil-moderno').attr('src', 'data:' + response.tipoImagen + ';base64,' + response.imagenBase64);
                        mensajeDiv.html('<div class="alert alert-success"><i class="fas fa-check-circle"></i>' + response.message + '</div>');

                        // Cerrar modal después de 1.5 segundos
                        setTimeout(function() {
                            $('#modalCargarImagen').modal('hide');
                        }, 1500);
                    } else {
                        mensajeDiv.html('<div class="alert alert-danger"><i class="fas fa-exclamation-triangle"></i>' + response.message + '</div>');
                    }
                },
                error: function () {
                    mensajeDiv.html('<div class="alert alert-danger"><i class="fas fa-exclamation-triangle"></i>Error al subir la imagen.</div>');
                }
            });
        });

        $(document).on('shown.bs.modal', '#modalCargarImagen', function () {
            $('#mensajeImagen').html('');
            $('#previewImagen').attr('src', '#').removeClass('show');
            $('#ImagenUsuario').val('');
            $('#fileName').text('Ningún archivo seleccionado').removeClass('selected');
        });

        $(document).on('hidden.bs.modal', '#modalCargarImagen', function () {
            $('#mensajeImagen').html('');
            $('#previewImagen').attr('src', '#').removeClass('show');
            $('#ImagenUsuario').val('');
            $('#fileName').text('Ningún archivo seleccionado').removeClass('selected');
        });

        // ========== GESTIÓN AVANZADA DE SESIONES ==========
        
        // Variables de configuración de sesión
        var sessionTimeoutMinutes = 20; // Configurado en Web.config
        var sessionWarningMinutes = 5;  // Advertir 5 minutos antes
        var sessionCheckInterval = 60000; // Verificar cada minuto
        
        var sessionTimeoutMs = sessionTimeoutMinutes * 60 * 1000;
        var warningTimeMs = sessionTimeoutMs - (sessionWarningMinutes * 60 * 1000);
        
        var warningShown = false;
        var sessionWarningTimer = null;
        var sessionTimeoutTimer = null;
        var activityCheckTimer = null;

        // Inicializar manejo de sesión
        function inicializarManejoSesion() {
            // Timer para mostrar advertencia
            sessionWarningTimer = setTimeout(function() {
                mostrarAdvertenciaSesion();
            }, warningTimeMs);
            
            // Timer para logout automático
            sessionTimeoutTimer = setTimeout(function() {
                cerrarSesionAutomatica();
            }, sessionTimeoutMs);
            
            // Verificar estado de sesión periódicamente
            activityCheckTimer = setInterval(function() {
                verificarEstadoSesion();
            }, sessionCheckInterval);
        }

        // Mostrar advertencia de sesión próxima a expirar
        function mostrarAdvertenciaSesion() {
            if (warningShown) return;
            warningShown = true;
            
            Swal.fire({
                title: '⏰ Sesión por expirar',
                html: `
                    <div style="text-align: center;">
                        <p>Su sesión expirará en <strong>${sessionWarningMinutes} minutos</strong>.</p>
                        <p>¿Desea extender su sesión?</p>
                        <div style="margin-top: 15px;">
                            <i class="fas fa-clock" style="font-size: 2em; color: #f39c12;"></i>
                        </div>
                    </div>
                `,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: '<i class="fas fa-clock"></i> Extender sesión',
                cancelButtonText: '<i class="fas fa-sign-out-alt"></i> Cerrar sesión',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-secondary'
                },
                timer: sessionWarningMinutes * 60 * 1000, // Auto-close al expirar
                timerProgressBar: true,
                didOpen: () => {
                    const confirmButton = Swal.getConfirmButton();
                    const cancelButton = Swal.getCancelButton();
                    confirmButton.style.marginRight = '10px';
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    extenderSesion();
                } else if (result.isDismissed && result.dismiss === Swal.DismissReason.timer) {
                    // Timer expiró - cerrar sesión automáticamente
                    cerrarSesionAutomatica();
                } else {
                    // Usuario eligió cerrar sesión
                    cerrarSesionManual();
                }
            });
        }

        // Extender sesión vía AJAX
        function extenderSesion() {
            // Mostrar loading
            Swal.fire({
                title: 'Extendiendo sesión...',
                text: 'Por favor espere',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            $.ajax({
                url: '@Url.Action("ExtenderSesion", "Acceso")',
                type: 'POST',
                timeout: 10000,
                success: function(response) {
                    if (response.success) {
                        // Mostrar mensaje de éxito
                        const isMobile = window.innerWidth <= 768;
                        Swal.fire({
                            icon: 'success',
                            title: '✅ Sesión extendida',
                            text: 'Su sesión ha sido extendida por ' + sessionTimeoutMinutes + ' minutos más.',
                            timer: 3000,
                            showConfirmButton: false,
                            toast: true,
                            position: isMobile ? 'top' : 'top-end',
                            timerProgressBar: true
                        });
                        
                        // Reiniciar timers
                        reiniciarTimersSesion();
                    } else {
                        // Error al extender sesión
                        Swal.fire({
                            icon: 'error',
                            title: 'Error al extender sesión',
                            text: response.message || 'No se pudo extender la sesión. Será redirigido al login.',
                            showConfirmButton: true,
                            confirmButtonText: 'Ir al Login'
                        }).then(() => {
                            window.location.href = response.redirectUrl || '@Url.Action("Login", "Acceso")';
                        });
                    }
                },
                error: function(xhr, status, error) {
                    let errorMessage = 'Error de conexión con el servidor.';
                    
                    if (status === 'timeout') {
                        errorMessage = 'Tiempo de espera agotado. Verifique su conexión.';
                    } else if (xhr.status === 401) {
                        errorMessage = 'Su sesión ha expirado.';
                    }
                    
                    Swal.fire({
                        icon: 'error',
                        title: 'Error de conexión',
                        text: errorMessage,
                        showConfirmButton: true,
                        confirmButtonText: 'Ir al Login'
                    }).then(() => {
                        window.location.href = '@Url.Action("Login", "Acceso")?expired=true';
                    });
                }
            });
        }

        // Cerrar sesión automática por timeout
        function cerrarSesionAutomatica() {
            Swal.fire({
                icon: 'info',
                title: '⏰ Sesión expirada',
                html: `
                    <div style="text-align: center;">
                        <p>Su sesión ha expirado por inactividad.</p>
                        <p>Será redirigido al login en <span id="countdown">5</span> segundos...</p>
                        <div style="margin-top: 15px;">
                            <i class="fas fa-hourglass-end" style="font-size: 2em; color: #e74c3c;"></i>
                        </div>
                    </div>
                `,
                timer: 5000,
                timerProgressBar: true,
                showConfirmButton: false,
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => {
                    const countdownElement = document.getElementById('countdown');
                    let countdown = 5;
                    
                    const countdownTimer = setInterval(() => {
                        countdown--;
                        if (countdownElement) {
                            countdownElement.textContent = countdown;
                        }
                        
                        if (countdown <= 0) {
                            clearInterval(countdownTimer);
                        }
                    }, 1000);
                }
            }).then(() => {
                window.location.href = '@Url.Action("Login", "Acceso")?expired=true';
            });
        }

        // Cerrar sesión manual
        function cerrarSesionManual() {
            Swal.fire({
                title: 'Cerrando sesión...',
                text: 'Por favor espere',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });
            
            setTimeout(() => {
                window.location.href = '@Url.Action("CerrarSesion", "Acceso")';
            }, 1000);
        }

        // Verificar estado de sesión con el servidor
        function verificarEstadoSesion() {
            $.ajax({
                url: '@Url.Action("InfoSesion", "Acceso")',
                type: 'GET',
                timeout: 5000,
                success: function(response) {
                    if (!response.success || !response.estaAutenticado) {
                        // Sesión no válida en servidor
                        limpiarTimersSesion();
                        cerrarSesionAutomatica();
                    } else if (response.sessionInfo && response.sessionInfo.EstaPorExpirar && !warningShown) {
                        // Sesión próxima a expirar
                        limpiarTimersSesion();
                        mostrarAdvertenciaSesion();
                    }
                },
                error: function(xhr, status, error) {
                    // Solo actuar si es un error 401 (no autorizado)
                    if (xhr.status === 401) {
                        limpiarTimersSesion();
                        cerrarSesionAutomatica();
                    }
                    // Otros errores los ignoramos (podrían ser problemas de red temporales)
                }
            });
        }

        // Reiniciar todos los timers de sesión
        function reiniciarTimersSesion() {
            limpiarTimersSesion();
            warningShown = false;
            inicializarManejoSesion();
        }

        // Limpiar todos los timers de sesión
        function limpiarTimersSesion() {
            if (sessionWarningTimer) {
                clearTimeout(sessionWarningTimer);
                sessionWarningTimer = null;
            }
            if (sessionTimeoutTimer) {
                clearTimeout(sessionTimeoutTimer);
                sessionTimeoutTimer = null;
            }
            if (activityCheckTimer) {
                clearInterval(activityCheckTimer);
                activityCheckTimer = null;
            }
        }

        // Detectar actividad del usuario para reiniciar timers
        var activityEvents = ['click', 'keypress', 'scroll', 'mousemove', 'touchstart'];
        var lastActivityTime = Date.now();
        var activityThreshold = 30000; // 30 segundos

        // Agregar listeners de actividad
        activityEvents.forEach(function(event) {
            document.addEventListener(event, function() {
                var now = Date.now();
                if (now - lastActivityTime > activityThreshold) {
                    lastActivityTime = now;
                    // Solo reiniciar si no se ha mostrado la advertencia
                    if (!warningShown) {
                        reiniciarTimersSesion();
                    }
                }
            }, true);
        });

        // Manejar respuestas AJAX que indican sesión expirada
        $(document).ajaxSuccess(function(event, xhr, settings) {
            var sessionExpired = xhr.getResponseHeader('X-Session-Expired');
            if (sessionExpired === 'true') {
                limpiarTimersSesion();
                cerrarSesionAutomatica();
            }
        });

        // Manejar errores de sesión en peticiones AJAX globalmente
        $(document).ajaxError(function(event, xhr, settings) {
            if (xhr.status === 401) {
                limpiarTimersSesion();
                cerrarSesionAutomatica();
            }
        });

        // Agregar funcionalidad al enlace "Cerrar sesión" del dropdown
        $('a[href*="Login"][href*="Acceso"]:contains("Cerrar sesión")').on('click', function(e) {
            e.preventDefault();
            
            Swal.fire({
                title: '¿Cerrar sesión?',
                text: '¿Está seguro que desea cerrar su sesión?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: '<i class="fas fa-sign-out-alt"></i> Sí, cerrar sesión',
                cancelButtonText: '<i class="fas fa-times"></i> Cancelar',
                customClass: {
                    confirmButton: 'btn btn-danger',
                    cancelButton: 'btn btn-secondary'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    limpiarTimersSesion();
                    cerrarSesionManual();
                }
            });
        });

        // Inicializar cuando el documento esté listo
        $(document).ready(function() {
            // Solo inicializar si no estamos en la página de login
            if (!window.location.pathname.toLowerCase().includes('/acceso/login')) {
                inicializarManejoSesion();
            }
        });

        // Limpiar timers al salir de la página
        $(window).on('beforeunload', function() {
            limpiarTimersSesion();
        });

        // Debug: Función global para obtener info de sesión (solo en desarrollo)
        window.obtenerInfoSesion = function() {
            $.get('@Url.Action("InfoSesion", "Acceso")', function(data) {
                console.log('Estado de sesión:', data);
            });
        };
    </script>
</body>
</html>