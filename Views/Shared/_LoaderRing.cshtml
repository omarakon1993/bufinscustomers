@model string
@*
    Loader 1 · Anillo orbital — para pantallas de carga completas.
    Uso: @Html.Partial("_LoaderRing", "aqua")  -> fondo oscuro (default)
         @Html.Partial("_LoaderRing", "dark")  -> fondo claro/blanco
*@
@{
    var variant = Model == "dark" ? "dark" : "aqua";
    var wordmark = variant == "dark" ? "~/Assets/img/Bufins_Wordmark_Dark.png" : "~/Assets/img/Bufins_Wordmark_Aqua.png";
    var ring2Class = variant == "dark" ? "l1-ring2 dark" : "l1-ring2";
}
<div class="l1-wrap">
    <div class="l1-ring"></div>
    <div class="@ring2Class"></div>
    <img class="l1-logo" src="@Url.Content(wordmark)" alt="Bufins">
</div>
