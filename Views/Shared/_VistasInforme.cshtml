@model bufinscustomers.Models.VistasInformeVM
@{
    // Vistas de cada familia de informes: (clave, texto, controlador). Las vistas «una hoja», «vista simple» y «versión para comité» son
    // modos de PYG, Flujo de caja y Gerencia mensual (comparten empresa, escenario, tema, logo y exportaciones).
    var items = new List<(string clave, string texto, string controlador, string icono)>();
    switch (Model.Familia)
    {
        case "pyg":
            items.Add(("analisis", Resources.Strings.Vistas_PygAnalisis, "InformePYG", "fa-chart-line"));
            items.Add(("hoja", Resources.Strings.Vistas_PygHoja, "InformePygHoja", "fa-table-cells"));
            break;
        case "caja":
            items.Add(("flujo", Resources.Strings.Vistas_CajaFlujo, "InformeFlujoCaja", "fa-money-bill-wave"));
            items.Add(("simple", Resources.Strings.Vistas_CajaSimple, "InformeCajaDisponible", "fa-wallet"));
            break;
        case "gerencia":
            items.Add(("resumen", Resources.Strings.Vistas_GerResumen, "InformeGerenciaMensual", "fa-file-lines"));
            items.Add(("comite", Resources.Strings.Vistas_GerComite, "InformeComite", "fa-file-signature"));
            break;
    }
}
<div class="vistas-informe" data-emp="@Model.EmpresaSel" data-esc="@Model.EscenarioSel" role="tablist" aria-label="@Resources.Strings.Vistas_Etiqueta (@Resources.Strings.Vistas_TipoInforme)">
    <span class="vistas-informe-et"><i class="fas fa-layer-group"></i><b>@Resources.Strings.Vistas_Etiqueta</b><small>(@Resources.Strings.Vistas_TipoInforme)</small></span>
    @foreach (var it in items)
    {
        <a href="@Url.Action("Index", it.controlador)" class="vistas-informe-btn@(it.clave == Model.Actual ? " on" : "")" role="tab" aria-selected="@(it.clave == Model.Actual ? "true" : "false")"><i class="fas @it.icono"></i>@it.texto</a>
    }
</div>
<link href="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/css/vistas-informe.css")" rel="stylesheet" />
<script src="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/js/vistas-informe.js")"></script>
