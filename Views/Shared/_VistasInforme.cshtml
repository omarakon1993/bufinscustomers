@model bufinscustomers.Models.VistasInformeVM
@{
    // Vistas de cada familia de informes: (clave, texto, controlador). Las vistas «una hoja», «vista simple» y «versión para comité» son
    // modos de PYG, Flujo de caja y Gerencia mensual (comparten empresa, escenario, tema, logo y exportaciones).
    var items = new List<(string clave, string texto, string controlador)>();
    switch (Model.Familia)
    {
        case "pyg":
            items.Add(("analisis", Resources.Strings.Vistas_PygAnalisis, "InformePYG"));
            items.Add(("hoja", Resources.Strings.Vistas_PygHoja, "InformePygHoja"));
            break;
        case "caja":
            items.Add(("flujo", Resources.Strings.Vistas_CajaFlujo, "InformeFlujoCaja"));
            items.Add(("simple", Resources.Strings.Vistas_CajaSimple, "InformeCajaDisponible"));
            break;
        case "gerencia":
            items.Add(("resumen", Resources.Strings.Vistas_GerResumen, "InformeGerenciaMensual"));
            items.Add(("comite", Resources.Strings.Vistas_GerComite, "InformeComite"));
            break;
    }
}
<div class="vistas-informe" data-emp="@Model.EmpresaSel" data-esc="@Model.EscenarioSel" role="tablist" aria-label="@Resources.Strings.Vistas_Etiqueta">
    <span class="vistas-informe-et"><i class="fas fa-layer-group"></i>@Resources.Strings.Vistas_Etiqueta</span>
    @foreach (var it in items)
    {
        <a href="@Url.Action("Index", it.controlador)" class="vistas-informe-btn@(it.clave == Model.Actual ? " on" : "")" role="tab" aria-selected="@(it.clave == Model.Actual ? "true" : "false")">@it.texto</a>
    }
</div>
<link href="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/css/vistas-informe.css")" rel="stylesheet" />
<script src="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/js/vistas-informe.js")"></script>
