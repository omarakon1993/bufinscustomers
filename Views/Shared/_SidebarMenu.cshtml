@using bufinscustomers.Models
@using bufinscustomers.Helpers
@model List<SidebarCategoriaViewModel>

@{
    var usuario = UsuarioSesionHelper.UsuarioActual;
    var esAdmin2 = UsuarioSesionHelper.EsSuperAdmin();
    var idEmpresa = usuario != null ? usuario.IdEmpresa ?? 0 : 0;
    bool iaVisible = IAModuloHelper.Visible(); // oculta Análisis IA si la empresa tiene la IA apagada
    string nombreEmpresa = null;
    if (!esAdmin2)
    {
        nombreEmpresa = bufinscustomers.Controllers.ReportesController.ObtenerNombreEmpresaPorId(idEmpresa);
    }

    // Estado activo resuelto en servidor → primer paint ya tiene las clases correctas
    var curCtrl   = ViewContext.RouteData.Values["controller"] != null ? ViewContext.RouteData.Values["controller"].ToString() : "";
    var curAction = ViewContext.RouteData.Values["action"]     != null ? ViewContext.RouteData.Values["action"].ToString()     : "";
}

@if (Model != null && Model.Count > 0)
{
    foreach (var categoria in Model)
    {
        if (categoria.Grupos == null || !categoria.Grupos.Any()) { continue; }

        <div class="sidebar-category">
            <div class="sidebar-category-header">
                <i class="@categoria.Icono sidebar-category-icon sidebar-cat-dot"></i>
                <span class="sidebar-category-title">@categoria.Nombre</span>
            </div>

            @foreach (var grupo in categoria.Grupos)
            {
                if (grupo.Items == null || !grupo.Items.Any()) { continue; }

                if (grupo.EsGrupoImplicito)
                {
                    foreach (var itemDir in grupo.Items)
                    {
                        if (!iaVisible && itemDir.Controller == "AnalisisIA") { continue; }
                        bool dirActivo = itemDir.Controller == curCtrl && itemDir.Action == curAction;
                        <div class="sidebar-nav-item">
                            <a class="sidebar-nav-link @(dirActivo ? "active" : "") @(itemDir.EsDestacado ? "destacado" : "")" href="@Url.Action(itemDir.Action, itemDir.Controller)">
                                <i class="@itemDir.Icono sidebar-nav-icon"></i>
                                <span class="sidebar-nav-text">@itemDir.Nombre</span>
                            </a>
                        </div>
                    }
                }
                else if (grupo.Items.Count == 1)
                {
                    var soloItem = grupo.Items[0];
                    if (!iaVisible && soloItem.Controller == "AnalisisIA") { continue; }
                    string linkText = soloItem.Nombre;
                    if (soloItem.Codigo == "INFORMES_REPORTES_PBI" && !esAdmin2 && nombreEmpresa != null)
                    {
                        linkText = soloItem.Nombre + " " + nombreEmpresa;
                    }
                    bool soloActivo = soloItem.Controller == curCtrl && soloItem.Action == curAction;
                    <div class="sidebar-nav-item">
                        <a class="sidebar-nav-link @(soloActivo ? "active" : "") @(soloItem.EsDestacado ? "destacado" : "")" href="@Url.Action(soloItem.Action, soloItem.Controller)">
                            <i class="@grupo.Icono sidebar-nav-icon"></i>
                            <span class="sidebar-nav-text">@linkText</span>
                        </a>
                    </div>
                }
                else
                {
                    bool grupoActivo = grupo.Items.Any(it => it.Controller == curCtrl && it.Action == curAction);
                    <div class="sidebar-nav-item">
                        <a class="sidebar-nav-link @(grupoActivo ? "expanded" : "")" href="#" data-has-submenu="true">
                            <i class="@grupo.Icono sidebar-nav-icon"></i>
                            <span class="sidebar-nav-text">@grupo.Nombre</span>
                            <i class="fas fa-chevron-right sidebar-nav-arrow"></i>
                            <span class="sidebar-tooltip">@grupo.Nombre</span>
                        </a>
                        <div class="sidebar-submenu @(grupoActivo ? "expanded" : "")">
                            @foreach (var item in grupo.Items)
                            {
                                if (!iaVisible && item.Controller == "AnalisisIA") { continue; }
                                bool itemActivo = item.Controller == curCtrl && item.Action == curAction;
                                <div class="sidebar-submenu-item">
                                    <a class="sidebar-submenu-link @(itemActivo ? "active" : "")" href="@Url.Action(item.Action, item.Controller)">
                                        @item.Nombre
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }
}
