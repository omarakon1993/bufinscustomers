            // ── Validación intuitiva de contraseña (checklist en vivo + coincidencia) ──
            var _pwdMsg = {
                coincide: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Usr_PwdMatch))',
                noCoincide: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Usr_PwdNoMatch))',
                incompleta: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Usr_PwdIncompleta))'
            };

            function evaluarRequisitosClave(clave) {
                return {
                    len: clave.length >= 10,
                    upper: /[A-Z]/.test(clave),
                    lower: /[a-z]/.test(clave),
                    num: /[0-9]/.test(clave),
                    special: /[^A-Za-z0-9]/.test(clave),
                    noRepeat: clave.length > 0 && !/(.)\1\1/.test(clave)
                };
            }

            function actualizarChecklistClave(inputId, checklistId) {
                var campo = document.getElementById(inputId);
                var clave = campo.value;
                var resultado = evaluarRequisitosClave(clave);
                var checklist = document.getElementById(checklistId);

                if (checklist) {
                    Object.keys(resultado).forEach(function (key) {
                        var item = checklist.querySelector('[data-check="' + key + '"]');
                        if (!item) return;
                        var icono = item.querySelector('i');
                        if (resultado[key]) {
                            item.classList.add('ok');
                            icono.className = 'fas fa-check-circle';
                        } else {
                            item.classList.remove('ok');
                            icono.className = 'fas fa-circle';
                        }
                    });
                }

                var todoOk = Object.keys(resultado).every(function (key) { return resultado[key]; });
                campo.setCustomValidity((clave.length > 0 && !todoOk) ? _pwdMsg.incompleta : '');
            }

            function actualizarCoincidenciaClave(claveId, confirmarId, feedbackId) {
                var clave = document.getElementById(claveId).value;
                var campoConfirmar = document.getElementById(confirmarId);
                var confirmar = campoConfirmar.value;
                var feedback = document.getElementById(feedbackId);

                if (!confirmar) {
                    campoConfirmar.setCustomValidity('');
                    if (feedback) { feedback.textContent = ''; feedback.className = 'form-text'; }
                    return;
                }
                if (clave === confirmar) {
                    campoConfirmar.setCustomValidity('');
                    if (feedback) { feedback.textContent = '✓ ' + _pwdMsg.coincide; feedback.className = 'form-text text-success'; }
                } else {
                    campoConfirmar.setCustomValidity(_pwdMsg.noCoincide);
                    if (feedback) { feedback.textContent = '✗ ' + _pwdMsg.noCoincide; feedback.className = 'form-text text-danger'; }
                }
            }

