@using bufinscustomers.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>

<html>
<head>
    <title>Maestro de usuarios</title>

    <script src="~/Assets/js/sweetalert2.all.min.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1">


    <script src="~/Assets/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Assets/Scripts/bootstrap.bundle.min.js"></script> <!-- estos scripts funcionan-->

</head>
<body>

    <style>
        .table-wrapper {
            max-height: 280px;
            overflow-y: auto;
            overflow-x: auto;
        }

        .readonly-checkbox {
            pointer-events: none; /* Evita la interacción del usuario */
            opacity: 1; /* Asegura que no se vea deshabilitado */
        }

        /* === COLORES === */
        :root {
            --color-primario: #583AFF;
            --color-secundario: #01E1D7;
        }

        /* === ENCABEZADO CARD === */
        .card-header {
            background: linear-gradient(90deg, var(--color-primario), var(--color-secundario));
            color: white;
            padding: 1.2rem 1.5rem;
            font-weight: 600;
            font-size: 1.2rem;
        }

        .card-header i {
            margin-right: 8px;
        }

        /* === MEJORAS RESPONSIVE PARA TABLAS === */

        /* Para laptops de 14 pulgadas y tablets */
        @@media (min-width: 768px) and (max-width: 1600px) {
            .table-wrapper {
                max-height: 400px; /* Más espacio vertical */
            }

            .table {
                font-size: 0.85rem;
            }

            .table th,
            .table td {
                padding: 0.5rem;
                white-space: nowrap;
            }

            .btn-group .btn {
                padding: 0.375rem 0.75rem;
                font-size: 0.85rem;
            }

            .card-header {
                padding: 1rem 1.25rem;
                font-size: 1.1rem;
            }
        }

        /* Para tablets */
        @@media (min-width: 768px) and (max-width: 991px) {
            .table {
                font-size: 0.8rem;
            }

            .table th,
            .table td {
                padding: 0.4rem;
            }

            .btn-group {
                display: flex;
                flex-direction: column;
            }

            .btn-group .btn {
                margin-bottom: 0.25rem;
                font-size: 0.8rem;
            }
        }

        /* Para móviles */
        @@media (max-width: 767px) {
            .table-wrapper {
                max-height: none;
            }

            .table {
                font-size: 0.75rem;
                display: block;
                overflow-x: auto;
            }

            .table thead {
                display: none;
            }

            .table tbody {
                display: block;
            }

            .table tr {
                display: block;
                margin-bottom: 1rem;
                border: 1px solid #ddd;
                border-radius: 0.5rem;
                padding: 0.75rem;
                background: #fff;
            }

            .table td {
                display: flex;
                justify-content: space-between;
                padding: 0.5rem 0;
                border: none;
                border-bottom: 1px solid #f0f0f0;
            }

            .table td:last-child {
                border-bottom: none;
            }

            .table td::before {
                content: attr(data-label);
                font-weight: 600;
                margin-right: 1rem;
                color: #583AFF;
            }

            .btn-group {
                display: flex;
                flex-direction: column;
                width: 100%;
            }

            .btn-group .btn {
                width: 100%;
                margin-bottom: 0.25rem;
                font-size: 0.85rem;
            }

            .card-header {
                padding: 0.875rem 1rem;
                font-size: 1rem;
            }
        }

        /* Scrollbar personalizada para la tabla */
        .table-wrapper::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        .table-wrapper::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }

        .table-wrapper::-webkit-scrollbar-thumb {
            background: #888;
            border-radius: 4px;
        }

        .table-wrapper::-webkit-scrollbar-thumb:hover {
            background: #555;
        }
    </style>

    <div class="card shadow mb-4 mt-4">
        <div class="card-header">
            <i class="bi bi-people-fill"></i> Maestro usuarios
        </div>
        <div class="card-body">
            <div class="table-responsive table-wrapper">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Nombre</th>
                            <th>Apellidos</th>
                            <th>Teléfono</th>
                            <th>Correo</th>
                            <th>Admin</th>
                            <th>Empresa</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var usuario in Model)
                        {

                            Func<Empresas, bool> empresaPredicate = e => e.Id == usuario.IdEmpresa;
                            var empresasList = ViewBag.Empresas as List<bufinscustomers.Models.Empresas>;
                            var empresa = empresasList?.FirstOrDefault(empresaPredicate);

                            <tr>
                                <td>@usuario.Id</td>
                                <td>@usuario.Nombre</td>
                                <td>@usuario.Apellidos</td>
                                <td>@usuario.Telefono</td>
                                <td>@usuario.Correo</td>
                                <td align="center">
                                    @if (usuario.Admin == 1)
                                    {
                                        <i class="fas fa-fw fa-check text-success"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-fw fa-times text-danger"></i>
                                    }
                                </td>
                                <td>@(empresa != null ? empresa.Nombre : string.Empty)</td>
                                <td>
                                    <div class="btn-group" role="group" aria-label="User Actions">
                                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#editUserModal"
                                                onclick="setEditUser(@usuario.Id, '@usuario.Nombre', '@usuario.Apellidos', '@usuario.Telefono', '@usuario.Correo', '@usuario.Admin', '@usuario.IdEmpresa', '@usuario.Usuario', '@usuario.Clave')">
                                            Editar
                                        </button>
                                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal" onclick="setIdUsuario(@usuario.Id)">
                                            Eliminar
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>

            </div>
        </div>
        <div class="card-footer">
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#crearUsuarioModal">
                Crear Usuario
            </button>
        </div>
    </div>

    <!-- Modal de confirmación -->
    <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="confirmDeleteModalLabel">
                        <i class="fas fa-exclamation-triangle"></i>Confirmar eliminación
                    </h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Cerrar">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p class="mb-0"><i class="fas fa-question-circle text-warning mr-2"></i>¿Estás seguro de que deseas eliminar este usuario?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times mr-2"></i>Cancelar
                    </button>
                    <form id="deleteForm" method="post" action="/Usuario/EliminarUsuario" style="display: inline;">
                        <input type="hidden" id="idUsuario" name="idUsuario" />
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash-alt mr-2"></i>Eliminar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de edición -->
    <div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editUserModalLabel">
                        <i class="fas fa-user-edit"></i>Editar Usuario
                    </h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <form id="editUserForm" method="post" action="/Usuario/EditarUsuario">
                    <input type="hidden" id="editIdUsuario" name="Id" />
                    <div class="modal-body">
                        <!-- Pestañas de navegación -->
                        <ul class="nav nav-tabs" id="editUserTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="edit-auth-tab" data-bs-toggle="tab" data-bs-target="#edit-auth" type="button" role="tab" aria-controls="edit-auth" aria-selected="true">
                                    Autenticación
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="edit-user-data-tab" data-bs-toggle="tab" data-bs-target="#edit-user-data" type="button" role="tab" aria-controls="edit-user-data" aria-selected="false">
                                    Datos del Usuario
                                </button>
                            </li>
                        </ul>

                        <!-- Contenido de las pestañas -->
                        <div class="tab-content" id="editUserTabsContent">
                            <!-- Pestaña de Autenticación  -->
                            <div class="tab-pane fade show active" id="edit-auth" role="tabpanel" aria-labelledby="edit-auth-tab">
                                <div class="mb-3 mt-3">
                                    <label for="editUsuario" class="form-label">
                                        <i class="fas fa-user-tag mr-2" style="color: #583AFF;"></i>Usuario
                                    </label>
                                    <input type="text" class="form-control" id="editUsuario" name="Usuario" required />
                                </div>

                                <!-- Botón para cambio de clave -->
                                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#cambiarClaveModal"
                                        onclick="setCambioClaveData()">
                                    <i class="fas fa-key mr-2"></i>Cambiar Clave
                                </button>
                            </div>

                            <!-- Pestaña de Datos del Usuario -->
                            <div class="tab-pane fade" id="edit-user-data" role="tabpanel" aria-labelledby="edit-user-data-tab">
                                <div class="mb-3 mt-3">
                                    <label for="editNombre" class="form-label">
                                        <i class="fas fa-user mr-2" style="color: #583AFF;"></i>Nombre
                                    </label>
                                    <input type="text" class="form-control" id="editNombre" name="Nombre" required />
                                </div>
                                <div class="mb-3">
                                    <label for="editApellidos" class="form-label">
                                        <i class="fas fa-id-card mr-2" style="color: #583AFF;"></i>Apellidos
                                    </label>
                                    <input type="text" class="form-control" id="editApellidos" name="Apellidos" required />
                                </div>
                                <div class="mb-3">
                                    <label for="editTelefono" class="form-label">
                                        <i class="fas fa-phone mr-2" style="color: #583AFF;"></i>Teléfono
                                    </label>
                                    <input type="text" class="form-control" id="editTelefono" name="Telefono" pattern="\d{7,15}" maxlength="15" title="Solo números, sin espacios ni guiones" oninput="this.value = this.value.replace(/[^0-9]/g, '');" />
                                </div>
                                <div class="mb-3 mt-3">
                                    <label for="editCorreo" class="form-label">
                                        <i class="fas fa-envelope mr-2" style="color: #583AFF;"></i>Correo
                                    </label>
                                    <input type="email" class="form-control" id="editCorreo" name="Correo" required />
                                </div>
                                <div class="mb-3">
                                    <label for="editIdEmpresa" class="form-label">
                                        <i class="fas fa-building mr-2" style="color: #583AFF;"></i>Empresa
                                    </label>
                                    <select class="custom-select" id="editIdEmpresa" name="IdEmpresa" required>
                                        <option value="" selected disabled>Seleccione una empresa</option>
                                        @foreach (var empresa in ViewBag.Empresas)
                                        {
                                            <option value="@empresa.Id">@empresa.Nombre</option>
                                        }
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="editAdmin" class="form-label">
                                        <i class="fas fa-shield-alt mr-2" style="color: #583AFF;"></i>Admin
                                    </label>
                                    <input type="checkbox" id="editAdmin" name="Admin" value="1" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fas fa-times mr-2"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary" id="btnEditarUsuario">
                            <i class="fas fa-save mr-2"></i>Guardar cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal de Creación -->
    <div class="modal fade" id="crearUsuarioModal" tabindex="-1" aria-labelledby="crearUsuarioModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="crearUsuarioModalLabel">
                        <i class="fas fa-user-plus"></i>Crear usuario
                    </h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <form id="crearUsuarioForm" method="post" action="/Usuario/Registrar">
                    <div class="modal-body">
                        <!-- Pestañas de navegación -->
                        <ul class="nav nav-tabs" id="crearUsuarioTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="auth-tab" data-bs-toggle="tab" data-bs-target="#auth" type="button" role="tab" aria-controls="auth" aria-selected="true">
                                    Autenticación
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="user-data-tab" data-bs-toggle="tab" data-bs-target="#user-data" type="button" role="tab" aria-controls="user-data" aria-selected="false">
                                    Datos del Usuario
                                </button>
                            </li>
                        </ul>

                        <!-- Contenido de las pestañas -->
                        <div class="tab-content" id="crearUsuarioTabsContent">
                            <!-- Pestaña de Autenticación -->
                            <div class="tab-pane fade show active" id="auth" role="tabpanel" aria-labelledby="auth-tab">
                                <div class="mb-3 mt-3">
                                    <label for="crearUsuario" class="form-label">
                                        <i class="fas fa-user-tag mr-2" style="color: #583AFF;"></i>Usuario
                                    </label>
                                    <input type="text" class="form-control" id="crearUsuario" name="Usuario" required />
                                </div>
                                <div class="mb-3 mt-3">
                                    <label for="crearClave" class="form-label">
                                        <i class="fas fa-lock mr-2" style="color: #583AFF;"></i>Clave
                                    </label>
                                    <input type="password" class="form-control" id="crearClave" name="Clave" required />
                                </div>
                                <div class="mb-3 mt-3">
                                    <label for="crearConfirmarClave" class="form-label">
                                        <i class="fas fa-lock-open mr-2" style="color: #583AFF;"></i>Confirmar Clave
                                    </label>
                                    <input type="password" class="form-control" id="crearConfirmarClave" name="ConfirmarClave" required />
                                </div>
                            </div>

                            <!-- Pestaña de Datos del Usuario -->
                            <div class="tab-pane fade" id="user-data" role="tabpanel" aria-labelledby="user-data-tab">
                                <div class="mb-3 mt-3">
                                    <label for="crearNombre" class="form-label">
                                        <i class="fas fa-user mr-2" style="color: #583AFF;"></i>Nombre
                                    </label>
                                    <input type="text" class="form-control" id="crearNombre" name="Nombre" required />
                                </div>
                                <div class="mb-3">
                                    <label for="crearApellidos" class="form-label">
                                        <i class="fas fa-id-card mr-2" style="color: #583AFF;"></i>Apellidos
                                    </label>
                                    <input type="text" class="form-control" id="crearApellidos" name="Apellidos" required />
                                </div>
                                <div class="mb-3">
                                    <label for="crearTelefono" class="form-label">
                                        <i class="fas fa-phone mr-2" style="color: #583AFF;"></i>Teléfono
                                    </label>
                                    <input type="text" class="form-control" id="crearTelefono" name="Telefono" pattern="\d{7,15}" maxlength="15" title="Solo números, sin espacios ni guiones" oninput="this.value = this.value.replace(/[^0-9]/g, '');" />

                                </div>
                                <div class="mb-3 mt-3">
                                    <label for="crearCorreo" class="form-label">
                                        <i class="fas fa-envelope mr-2" style="color: #583AFF;"></i>Correo
                                    </label>
                                    <input type="email" class="form-control" id="crearCorreo" name="Correo" required />
                                </div>
                                <div class="mb-3">
                                    <label for="crearIdEmpresa" class="form-label">
                                        <i class="fas fa-building mr-2" style="color: #583AFF;"></i>Empresa
                                    </label>

                                    <select class="custom-select" id="crearIdEmpresa" name="IdEmpresa" required>
                                        <option value="" selected disabled>Seleccione una empresa</option>
                                        @foreach (var empresa in ViewBag.Empresas)
                                        {
                                            <option value="@empresa.Id">@empresa.Nombre</option>
                                        }
                                        <!-- Agrega más opciones según sea necesario -->
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="crearAdmin" class="form-label">
                                        <i class="fas fa-shield-alt mr-2" style="color: #583AFF;"></i>Admin
                                    </label>
                                    <input type="checkbox" id="crearAdmin" name="Admin" value="1" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fas fa-times mr-2"></i>Cancelar
                        </button>
                        <button type="button" class="btn btn-primary" id="btnCrearUsuario">
                            <i class="fas fa-plus-circle mr-2"></i>Crear
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal para cambio de clave -->
    <div class="modal fade" id="cambiarClaveModal" tabindex="-1" aria-labelledby="cambiarClaveModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="cambiarClaveModalLabel">
                        <i class="fas fa-key"></i>Cambiar Clave
                    </h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <form id="cambiarClaveForm" method="post" action="/Usuario/CambiarClave">
                    <input type="hidden" id="cambioClaveIdUsuario" name="idUsuario" />
                    <div class="modal-body">
                        <div class="mb-3 mt-3">
                            <label for="nuevaClave" class="form-label"><i class="fas fa-lock mr-2"></i>Nueva Clave</label>
                            <input type="password" class="form-control" id="nuevaClave" name="nuevaClave" required />
                        </div>
                        <div class="mb-3 mt-3">
                            <label for="confirmarNuevaClave" class="form-label"><i class="fas fa-lock-open mr-2"></i>Confirmar Nueva Clave</label>
                            <input type="password" class="form-control" id="confirmarNuevaClave" name="confirmarNuevaClave" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fas fa-times mr-2"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save mr-2"></i>Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <script>
           const isMobile = window.innerWidth <= 768;

           Swal.fire({
               toast: true,
               position: isMobile ? 'top' : 'top-end',
               icon: 'error',
               title: '@TempData["ErrorMessage"]',
               showConfirmButton: false,
               timer: 3000,
               timerProgressBar: true,
               didOpen: (toast) => {
                   toast.addEventListener('mouseenter', Swal.stopTimer);
                   toast.addEventListener('mouseleave', Swal.resumeTimer);
               }
           });
        </script>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            const isMobile = window.innerWidth <= 768;

            Swal.fire({
                toast: true,
                position: isMobile ? 'top' : 'top-end',
                icon: 'success',
                title: '@TempData["SuccessMessage"]',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer);
                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                }
            });
        </script>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <script>
        const isMobile = window.innerWidth <= 768;

        Swal.fire({
            toast: true,
            position: isMobile ? 'top' : 'top-end',
            icon: 'info',
            title: '@TempData["InfoMessage"]',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer);
                toast.addEventListener('mouseleave', Swal.resumeTimer);
            }
        });
        </script>
    }


    @section scripts {
        <script src="~/Assets/Scripts/jquery-3.7.1.min.js"></script>
        <script src="~/Assets/Scripts/bootstrap.bundle.min.js"></script>
        <script>

            function setIdUsuario(id) {
                document.getElementById("idUsuario").value = id;
            }

            function setEditUser(id, nombre, apellidos, telefono, Correo, admin, idEmpresa, usuario, clave) {

                document.getElementById("editIdUsuario").value = id;
                document.getElementById("editNombre").value = nombre;
                document.getElementById("editApellidos").value = apellidos;
                document.getElementById("editCorreo").value = Correo;
                document.getElementById("editTelefono").value = telefono;
                document.getElementById("editAdmin").checked = (admin == 1 || admin === '1');
                document.getElementById("editIdEmpresa").value = idEmpresa;
                document.getElementById("editUsuario").value = usuario;
            }


            function setCambioClaveData() {
                const idUsuario = document.getElementById("editIdUsuario").value;
                const usuario = document.getElementById("editUsuario").value;

                document.getElementById("cambioClaveIdUsuario").value = idUsuario;
                document.getElementById("cambiarClaveModalLabel").textContent = `Cambiar clave para: ${usuario}`;

                var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('editUserModal'));
                modal.hide();
            }

            function validarFormularioConAlerta(formId, buttonId) {
                document.getElementById(buttonId).addEventListener('click', function () {
                    var form = document.getElementById(formId);
                    if (!form.checkValidity()) {
                        var firstInvalid = form.querySelector(':invalid');
                        if (firstInvalid) {
                            var tabPane = firstInvalid.closest('.tab-pane');
                            if (tabPane && !tabPane.classList.contains('active')) {
                                var tabId = tabPane.id;
                                var tabTrigger = document.querySelector('[data-bs-target="#' + tabId + '"]');
                                if (tabTrigger) {
                                    var tab = new bootstrap.Tab(tabTrigger);
                                    tab.show();
                                }
                            }
                            firstInvalid.focus();
                        }
                        const isMobile = window.innerWidth <= 768;
                        form.classList.add('was-validated');
                        Swal.fire({
                            icon: 'error',
                            title: 'Por favor, completa todos los campos requeridos.',
                            toast: true,
                            position: isMobile ? 'top' : 'top-end',
                            showConfirmButton: false,
                            timer: 3000,
                            timerProgressBar: true,
                            didOpen: (toast) => {
                                toast.addEventListener('mouseenter', Swal.stopTimer);
                                toast.addEventListener('mouseleave', Swal.resumeTimer);
                            }
                        });
                        return;
                    }
                    form.submit();
                });
            }


            // Llama la función para cada formulario/modal
            validarFormularioConAlerta('crearUsuarioForm', 'btnCrearUsuario');
            validarFormularioConAlerta('editUserForm', 'btnEditarUsuario');
      
        </script>
    }


</body>
</html>
