            // ── Generación automática (no editable) del nombre de usuario ──
            // Estándar: inicial del nombre + primer apellido. Si ya existe, se van agregando
            // letras del nombre (jgomez -> jugomez -> juagomez ...) hasta encontrar uno libre.
            var _editUsuarioOriginal = '';
            var _editAdminOriginal = '';

            function quitarAcentos(texto) {
                return texto.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
            }

            function normalizarParaUsuario(texto) {
                return quitarAcentos(texto.toLowerCase()).replace(/[^a-z]/g, '');
            }

            function calcularUsuarioSugerido(nombre, apellidos, excluir) {
                var primerNombre = normalizarParaUsuario((nombre || '').split(/\s+/)[0] || '');
                var primerApellido = normalizarParaUsuario((apellidos || '').split(/\s+/)[0] || '');

                if (!primerNombre || !primerApellido) return '';

                var existentes = _usuariosExistentes.filter(function (u) { return u !== excluir; });

                // Probar agregando progresivamente más letras del nombre hasta encontrar uno libre
                var candidato = primerNombre.charAt(0) + primerApellido;
                for (var i = 1; i <= primerNombre.length; i++) {
                    var intento = primerNombre.substring(0, i) + primerApellido;
                    candidato = intento;
                    if (existentes.indexOf(intento) === -1) {
                        break;
                    }
                }

                // Último recurso: si incluso el nombre completo + apellido ya existe, numerar
                if (existentes.indexOf(candidato) !== -1) {
                    var base = candidato;
                    var contador = 2;
                    while (existentes.indexOf(candidato) !== -1) {
                        candidato = base + contador;
                        contador++;
                    }
                }

                return candidato;
            }

            function generarUsuarioSugeridoCrear() {
                var nombre = document.getElementById('crearNombre').value.trim();
                var apellidos = document.getElementById('crearApellidos').value.trim();
                document.getElementById('crearUsuario').value = calcularUsuarioSugerido(nombre, apellidos, null);
            }

            function generarUsuarioSugeridoEditar() {
