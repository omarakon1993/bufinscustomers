@using bufinscustomers.Models

<!DOCTYPE html>

<html>
<head>
    <title>Maestro de usuarios</title>

    <script src="~/Assets/js/sweetalert2.all.min.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1">


    <script src="~/Assets/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Assets/Scripts/bootstrap.bundle.min.js"></script> <!-- estos scripts funcionan-->
    @*<link href="~/Assets/Content/bootstrap.min.css" rel="stylesheet" />
        <link href="~/Assets/Content/Site.css" rel="stylesheet" />*@



    <!--<script src="~/Assets/Bootstrap/jquery/jquery.min.js"></script>--> <!-- Incluye jQuery aquí -->
    <!--<script src="~/Assets/Bootstrap/bootstrap/js/bootstrap.bundle.min.js"></script>--> <!-- Luego carga Bootstrap -->


</head>
<body>

    <style>
        .table-wrapper {
            max-height: 280px;
            overflow-y: auto;
        }

        .readonly-checkbox {
            pointer-events: none; /* Evita la interacción del usuario */
            opacity: 1; /* Asegura que no se vea deshabilitado */
        }
    </style>

    <h2>Maestro de usuarios</h2>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            @*<h6 class="m-0 font-weight-bold text-primary">Usuarios</h6>*@
        </div>
        <div class="card-body">
            <div class="table-responsive table-wrapper">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Nombre</th>
                            <th>Apellidos</th>
                            <th>Teléfono</th>
                            <th>Correo</th>
                            <th>Admin</th>
                            <th>Empresa</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var usuario in Model)
                        {

                            Func<Empresas, bool> empresaPredicate = e => e.Id == usuario.IdEmpresa;
                            var empresasList = ViewBag.Empresas as List<bufinscustomers.Models.Empresas>;
                            var empresa = empresasList?.FirstOrDefault(empresaPredicate);

                            <tr>
                                <td>@usuario.Id</td>
                                <td>@usuario.Nombre</td>
                                <td>@usuario.Apellidos</td>
                                <td>@usuario.Telefono</td>
                                <td>@usuario.Correo</td>
                                <td align="center">
                                    @if (usuario.Admin == 1)
                                    {
                                        <i class="fas fa-fw fa-check text-success"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-fw fa-times text-danger"></i>
                                    }
                                </td>
                                <td>@(empresa != null ? empresa.Nombre : string.Empty)</td>
                                <td>
                                    <!-- Aquí puedes agregar botones para editar o eliminar -->
                                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#editUserModal"
                                            onclick="setEditUser(@usuario.Id, '@usuario.Nombre', '@usuario.Apellidos', '@usuario.Telefono', '@usuario.Correo', '@usuario.Admin', '@usuario.IdEmpresa', '@usuario.Usuario', '@usuario.Clave')">
                                        Editar
                                    </button>
                                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal" onclick="setIdUsuario(@usuario.Id)">
                                        Eliminar
                                    </button>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>

            </div>
        </div>
        <div class="card-footer">
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#crearUsuarioModal">
                Crear Usuario
            </button>
        </div>
    </div>

    <!-- Modal de confirmación -->
    <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmDeleteModalLabel">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    ¿Estás seguro de que deseas eliminar este usuario?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <form id="deleteForm" method="post" action="/Usuario/EliminarUsuario">
                        <input type="hidden" id="idUsuario" name="idUsuario" />
                        <button type="submit" class="btn btn-danger">Eliminar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de edición -->
    <div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editUserModalLabel">Editar Usuario</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="editUserForm" method="post" action="/Usuario/EditarUsuario">
                    <input type="hidden" id="editIdUsuario" name="Id" />
                    <div class="modal-body">
                        <!-- Pestañas de navegación -->
                        <ul class="nav nav-tabs" id="editUserTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="edit-auth-tab" data-bs-toggle="tab" data-bs-target="#edit-auth" type="button" role="tab" aria-controls="edit-auth" aria-selected="true">
                                    Autenticación
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="edit-user-data-tab" data-bs-toggle="tab" data-bs-target="#edit-user-data" type="button" role="tab" aria-controls="edit-user-data" aria-selected="false">
                                    Datos del Usuario
                                </button>
                            </li>
                        </ul>

                        <!-- Contenido de las pestañas -->
                        <div class="tab-content" id="editUserTabsContent">
                            <!-- Pestaña de Autenticación  -->
                            <div class="tab-pane fade show active" id="edit-auth" role="tabpanel" aria-labelledby="edit-auth-tab">
                                <div class="mb-3 mt-3">
                                    <label for="editUsuario" class="form-label">Usuario</label>
                                    <input type="text" class="form-control" id="editUsuario" name="Usuario" required />
                                </div>

                                <!-- Botón para cambio de clave -->
                                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#cambiarClaveModal"
                                        onclick="setCambioClaveData()">
                                    Cambiar Clave
                                </button>
                            </div>

                            <!-- Pestaña de Datos del Usuario -->
                            <div class="tab-pane fade" id="edit-user-data" role="tabpanel" aria-labelledby="edit-user-data-tab">
                                <div class="mb-3 mt-3">
                                    <label for="editNombre" class="form-label">Nombre</label>
                                    <input type="text" class="form-control" id="editNombre" name="Nombre" required />
                                </div>
                                <div class="mb-3">
                                    <label for="editApellidos" class="form-label">Apellidos</label>
                                    <input type="text" class="form-control" id="editApellidos" name="Apellidos" required />
                                </div>
                                <div class="mb-3">
                                    <label for="editTelefono" class="form-label">Teléfono</label>
                                    <input type="number" class="form-control" id="editTelefono" name="Telefono" />
                                </div>
                                <div class="mb-3 mt-3">
                                    <label for="editCorreo" class="form-label">Correo</label>
                                    <input type="email" class="form-control" id="editCorreo" name="Correo" required />
                                </div>
                                <div class="mb-3">
                                    <label for="editIdEmpresa" class="form-label">Empresa</label>
                                    <select class="form-select" id="editIdEmpresa" name="IdEmpresa" required>
                                        <option value="" selected disabled>Seleccione una empresa</option>
                                        @foreach (var empresa in ViewBag.Empresas)
                                        {
                                            <option value="@empresa.Id">@empresa.Nombre</option>
                                        }
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="editAdmin" class="form-label">Admin</label>
                                    <input type="checkbox" id="editAdmin" name="Admin" value="1" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal de Creación -->
    <div class="modal fade" id="crearUsuarioModal" tabindex="-1" aria-labelledby="crearUsuarioModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="crearUsuarioModalLabel">Crear usuario</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="crearUsuarioForm" method="post" action="/Usuario/Registrar">
                    <div class="modal-body">
                        <!-- Pestañas de navegación -->
                        <ul class="nav nav-tabs" id="crearUsuarioTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="auth-tab" data-bs-toggle="tab" data-bs-target="#auth" type="button" role="tab" aria-controls="auth" aria-selected="true">
                                    Autenticación
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="user-data-tab" data-bs-toggle="tab" data-bs-target="#user-data" type="button" role="tab" aria-controls="user-data" aria-selected="false">
                                    Datos del Usuario
                                </button>
                            </li>
                        </ul>

                        <!-- Contenido de las pestañas -->
                        <div class="tab-content" id="crearUsuarioTabsContent">
                            <!-- Pestaña de Autenticación -->
                            <div class="tab-pane fade show active" id="auth" role="tabpanel" aria-labelledby="auth-tab">
                                <div class="mb-3 mt-3">
                                    <label for="crearUsuario" class="form-label">Usuario</label>
                                    <input type="text" class="form-control" id="crearUsuario" name="Usuario" required />
                                </div>
                                <div class="mb-3 mt-3">
                                    <label for="crearClave" class="form-label">Clave</label>
                                    <input type="text" class="form-control" id="crearClave" name="Clave" required />
                                </div>
                                <div class="mb-3 mt-3">
                                    <label for="crearConfirmarClave" class="form-label">Confirmar Clave</label>
                                    <input type="text" class="form-control" id="crearConfirmarClave" name="ConfirmarClave" required />
                                </div>
                            </div>

                            <!-- Pestaña de Datos del Usuario -->
                            <div class="tab-pane fade" id="user-data" role="tabpanel" aria-labelledby="user-data-tab">
                                <div class="mb-3 mt-3">
                                    <label for="crearNombre" class="form-label">Nombre</label>
                                    <input type="text" class="form-control" id="crearNombre" name="Nombre" required />
                                </div>
                                <div class="mb-3">
                                    <label for="crearApellidos" class="form-label">Apellidos</label>
                                    <input type="text" class="form-control" id="crearApellidos" name="Apellidos" required />
                                </div>
                                <div class="mb-3">
                                    <label for="crearTelefono" class="form-label">Teléfono</label>
                                    <input type="number" class="form-control" id="crearTelefono" name="Telefono" />
                                </div>
                                <div class="mb-3 mt-3">
                                    <label for="crearCorreo" class="form-label">Correo</label>
                                    <input type="email" class="form-control" id="crearCorreo" name="Correo" required />
                                </div>
                                <div class="mb-3">
                                    <label for="crearIdEmpresa" class="form-label">Empresa</label>
                                    <select class="form-select" id="crearIdEmpresa" name="IdEmpresa" required>
                                        <option value="" selected disabled>Seleccione una empresa</option>
                                        @foreach (var empresa in ViewBag.Empresas)
                                        {
                                            <option value="@empresa.Id">@empresa.Nombre</option>
                                        }
                                        <!-- Agrega más opciones según sea necesario -->
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="crearAdmin" class="form-label">Admin</label>
                                    <input type="checkbox" id="crearAdmin" name="Admin" value="1" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Crear</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal para cambio de clave -->
    <div class="modal fade" id="cambiarClaveModal" tabindex="-1" aria-labelledby="cambiarClaveModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="cambiarClaveModalLabel">Cambiar Clave</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="cambiarClaveForm" method="post" action="/Usuario/CambiarClave">
                    <input type="hidden" id="cambioClaveIdUsuario" name="idUsuario" />
                    <div class="modal-body">
                        <div class="mb-3 mt-3">
                            <label for="nuevaClave" class="form-label">Nueva Clave</label>
                            <input type="password" class="form-control" id="nuevaClave" name="nuevaClave" required />
                        </div>
                        <div class="mb-3 mt-3">
                            <label for="confirmarNuevaClave" class="form-label">Confirmar Nueva Clave</label>
                            <input type="password" class="form-control" id="confirmarNuevaClave" name="confirmarNuevaClave" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <script>
           const isMobile = window.innerWidth <= 768;

           Swal.fire({
               toast: true,
               position: isMobile ? 'top' : 'top-end',
               icon: 'error',
               title: '@TempData["ErrorMessage"]',
               showConfirmButton: false,
               timer: 3000,
               timerProgressBar: true,
               didOpen: (toast) => {
                   toast.addEventListener('mouseenter', Swal.stopTimer);
                   toast.addEventListener('mouseleave', Swal.resumeTimer);
               }
           });
        </script>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            const isMobile = window.innerWidth <= 768;

            Swal.fire({
                toast: true,
                position: isMobile ? 'top' : 'top-end',
                icon: 'success',
                title: '@TempData["SuccessMessage"]',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer);
                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                }
            });
        </script>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <script>
        const isMobile = window.innerWidth <= 768;

        Swal.fire({
            toast: true,
            position: isMobile ? 'top' : 'top-end',
            icon: 'info',
            title: '@TempData["InfoMessage"]',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer);
                toast.addEventListener('mouseleave', Swal.resumeTimer);
            }
        });
        </script>
    }


    <script>
        function setIdUsuario(id) {
            document.getElementById("idUsuario").value = id;
        }

        function setEditUser(id, nombre, apellidos, telefono, Correo, admin, idEmpresa, usuario, clave) {

            document.getElementById("editIdUsuario").value = id;
            document.getElementById("editNombre").value = nombre;
            document.getElementById("editApellidos").value = apellidos;
            document.getElementById("editCorreo").value = Correo;
            document.getElementById("editTelefono").value = telefono;
            document.getElementById("editAdmin").checked = (admin == 1 || admin === '1');
            document.getElementById("editIdEmpresa").value = idEmpresa;
            document.getElementById("editUsuario").value = usuario;  
        }

        document.getElementById("chckAdmin").addEventListener("click", function (e) {
            e.preventDefault(); // Evita que el checkbox cambie de estado
        });

        function setCambioClaveData() {
            const idUsuario = document.getElementById("editIdUsuario").value;
            const usuario = document.getElementById("editUsuario").value;

            document.getElementById("cambioClaveIdUsuario").value = idUsuario;  
            document.getElementById("cambiarClaveModalLabel").textContent = `Cambiar clave para: ${usuario}`;  
        }


    </script>


</body>
</html>
