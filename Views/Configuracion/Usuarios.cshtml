    </div>

    <!-- Modal para visualizar imagen completa -->
    <div class="modal fade" id="imageViewModal" tabindex="-1" aria-labelledby="imageViewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="imageViewModalLabel">
                        <i class="fas fa-image"></i> Imagen de Usuario
                    </h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body text-center">
                    <img id="modalImageView" src="" alt="Imagen usuario" style="max-width: 100%; max-height: 70vh; border-radius: 8px;" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times mr-2"></i>Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <script>
           const isMobile = window.innerWidth <= 768;

           Swal.fire({
               toast: true,
               position: isMobile ? 'top' : 'top-end',
               icon: 'error',
               title: '@TempData["ErrorMessage"]',
               showConfirmButton: false,
               timer: 3000,
               timerProgressBar: true,
               didOpen: (toast) => {
                   toast.addEventListener('mouseenter', Swal.stopTimer);
                   toast.addEventListener('mouseleave', Swal.resumeTimer);
               }
           });
        </script>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            const isMobile = window.innerWidth <= 768;

            Swal.fire({
                toast: true,
                position: isMobile ? 'top' : 'top-end',
                icon: 'success',
                title: '@TempData["SuccessMessage"]',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer);
                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                }
            });
        </script>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <script>
        const isMobile = window.innerWidth <= 768;

        Swal.fire({
            toast: true,
            position: isMobile ? 'top' : 'top-end',
            icon: 'info',
            title: '@TempData["InfoMessage"]',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer);
                toast.addEventListener('mouseleave', Swal.resumeTimer);
            }
        });
        </script>
    }


    @section scripts {
        <script src="~/Assets/Scripts/jquery-3.7.1.min.js"></script>
        <script src="~/Assets/Scripts/bootstrap.bundle.min.js"></script>
        <script>

            function setIdUsuario(id) {
                document.getElementById("idUsuario").value = id;
            }

            function setEditUser(id, nombre, apellidos, telefono, Correo, admin, idEmpresa, usuario, clave, imagenUrl) {

                document.getElementById("editIdUsuario").value = id;
                document.getElementById("editNombre").value = nombre;
                document.getElementById("editApellidos").value = apellidos;
                document.getElementById("editCorreo").value = Correo;
                document.getElementById("editTelefono").value = telefono;

                // Establecer el valor del selector de rol (Admin puede ser 0, 1 o 2)
                var adminValue = admin || 0; // Si es null, establecer en 0
                document.getElementById("editAdmin").value = adminValue.toString();

                document.getElementById("editIdEmpresa").value = idEmpresa;
                document.getElementById("editUsuario").value = usuario;

                // Manejar imagen existente
                var editPreviewImg = document.getElementById("editPreviewImg");
                var editNoImagenText = document.getElementById("editNoImagenText");
                var editImagenActions = document.getElementById("editImagenActions");

                if (imagenUrl && imagenUrl !== '') {
                    editPreviewImg.src = imagenUrl;
                    editPreviewImg.style.display = 'block';
                    editImagenActions.style.display = 'block';
                    editNoImagenText.style.display = 'none';
                } else {
                    editPreviewImg.style.display = 'none';
                    editImagenActions.style.display = 'none';
                    editNoImagenText.style.display = 'block';
                }

                // Limpiar input de archivo
                document.getElementById("editImagenUsuario").value = '';
            }


            function setCambioClaveData() {
                const idUsuario = document.getElementById("editIdUsuario").value;
                const usuario = document.getElementById("editUsuario").value;

                document.getElementById("cambioClaveIdUsuario").value = idUsuario;
                document.getElementById("cambiarClaveModalLabel").textContent = `Cambiar clave para: ${usuario}`;

                var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('editUserModal'));
                modal.hide();
            }

            function validarFormularioConAlerta(formId, buttonId) {
                document.getElementById(buttonId).addEventListener('click', function () {
                    var form = document.getElementById(formId);
                    if (!form.checkValidity()) {
                        var firstInvalid = form.querySelector(':invalid');
                        if (firstInvalid) {
                            var tabPane = firstInvalid.closest('.tab-pane');
                            if (tabPane && !tabPane.classList.contains('active')) {
                                var tabId = tabPane.id;
                                var tabTrigger = document.querySelector('[data-bs-target="#' + tabId + '"]');
                                if (tabTrigger) {
                                    var tab = new bootstrap.Tab(tabTrigger);
                                    tab.show();
                                }
                            }
                            firstInvalid.focus();
                        }
                        const isMobile = window.innerWidth <= 768;
                        form.classList.add('was-validated');
                        Swal.fire({
                            icon: 'error',
                            title: 'Por favor, completa todos los campos requeridos.',
                            toast: true,
                            position: isMobile ? 'top' : 'top-end',
                            showConfirmButton: false,
                            timer: 3000,
                            timerProgressBar: true,
                            didOpen: (toast) => {
                                toast.addEventListener('mouseenter', Swal.stopTimer);
                                toast.addEventListener('mouseleave', Swal.resumeTimer);
                            }
                        });
                        return;
                    }
                    form.submit();
                });
            }


            // Llama la función para cada formulario/modal
            validarFormularioConAlerta('crearUsuarioForm', 'btnCrearUsuario');
            validarFormularioConAlerta('editUserForm', 'btnEditarUsuario');

            // Función para comprimir imagen usando canvas
            function compressImage(file, maxWidth, maxHeight, quality) {
                return new Promise((resolve, reject) => {
                    const reader = new FileReader();
                    reader.readAsDataURL(file);
                    reader.onload = function (e) {
                        const img = new Image();
                        img.src = e.target.result;
                        img.onload = function () {
                            const canvas = document.createElement('canvas');
                            let width = img.width;
                            let height = img.height;

                            // Calcular nuevas dimensiones manteniendo aspecto
                            if (width > height) {
                                if (width > maxWidth) {
                                    height *= maxWidth / width;
                                    width = maxWidth;
                                }
                            } else {
                                if (height > maxHeight) {
                                    width *= maxHeight / height;
                                    height = maxHeight;
                                }
                            }

                            canvas.width = width;
                            canvas.height = height;
                            const ctx = canvas.getContext('2d');
                            ctx.drawImage(img, 0, 0, width, height);

                            // Convertir a blob con calidad especificada
                            canvas.toBlob(
                                (blob) => {
                                    if (blob) {
                                        resolve(blob);
                                    } else {
                                        reject(new Error('Error al comprimir imagen'));
                                    }
                                },
                                file.type || 'image/jpeg',
                                quality
                            );
                        };
                        img.onerror = reject;
                    };
                    reader.onerror = reject;
                });
            }

            // Funciones para preview de imagen en crear usuario
            function previewImageCreate(input) {
                if (input.files && input.files[0]) {
                    const file = input.files[0];

                    // Validar tamaño inicial (10MB máximo antes de comprimir)
                    if (file.size > 10485760) {
                        const isMobile = window.innerWidth <= 768;
                        Swal.fire({
                            icon: 'error',
                            title: 'El archivo es demasiado grande. Máximo 10MB.',
                            toast: true,
                            position: isMobile ? 'top' : 'top-end',
                            showConfirmButton: false,
                            timer: 3000,
                            timerProgressBar: true
                        });
                        input.value = '';
                        return;
                    }

                    // Comprimir imagen
                    compressImage(file, 1024, 1024, 0.8).then(compressedBlob => {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            document.getElementById('crearPreviewImg').src = e.target.result;
                            document.getElementById('crearImagenPreview').style.display = 'block';

                            // Crear un nuevo File del blob comprimido
                            const compressedFile = new File([compressedBlob], file.name, { type: file.type });

                            // Reemplazar el archivo en el input con el comprimido
                            const dataTransfer = new DataTransfer();
                            dataTransfer.items.add(compressedFile);
                            input.files = dataTransfer.files;

                            // Mostrar info de compresión
                            const originalSize = (file.size / 1024).toFixed(2);
                            const compressedSize = (compressedBlob.size / 1024).toFixed(2);
                            const reduction = ((1 - compressedBlob.size / file.size) * 100).toFixed(0);
                            console.log(`Imagen comprimida: ${originalSize}KB -> ${compressedSize}KB (${reduction}% reducción)`);
                        };
                        reader.readAsDataURL(compressedBlob);
                    }).catch(error => {
                        console.error('Error al comprimir imagen:', error);
                        // Si falla la compresión, mostrar imagen original
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            document.getElementById('crearPreviewImg').src = e.target.result;
                            document.getElementById('crearImagenPreview').style.display = 'block';
                        };
                        reader.readAsDataURL(file);
                    });
                }
            }

            function removeImageCreate() {
                document.getElementById('crearImagenUsuario').value = '';
                document.getElementById('crearImagenPreview').style.display = 'none';
                document.getElementById('crearPreviewImg').src = '';
            }

            // Funciones para preview de imagen en editar usuario
            function previewImageEdit(input) {
                if (input.files && input.files[0]) {
                    const file = input.files[0];

                    // Validar tamaño inicial (10MB máximo antes de comprimir)
                    if (file.size > 10485760) {
                        const isMobile = window.innerWidth <= 768;
                        Swal.fire({
                            icon: 'error',
                            title: 'El archivo es demasiado grande. Máximo 10MB.',
                            toast: true,
                            position: isMobile ? 'top' : 'top-end',
                            showConfirmButton: false,
                            timer: 3000,
                            timerProgressBar: true
                        });
                        input.value = '';
                        return;
                    }

                    // Comprimir imagen
                    compressImage(file, 1024, 1024, 0.8).then(compressedBlob => {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            var editPreviewImg = document.getElementById('editPreviewImg');
                            var editNoImagenText = document.getElementById('editNoImagenText');
                            var editImagenActions = document.getElementById('editImagenActions');

                            editPreviewImg.src = e.target.result;
                            editPreviewImg.style.display = 'block';
                            editImagenActions.style.display = 'block';
                            editNoImagenText.style.display = 'none';

                            // Crear un nuevo File del blob comprimido
                            const compressedFile = new File([compressedBlob], file.name, { type: file.type });

                            // Reemplazar el archivo en el input con el comprimido
                            const dataTransfer = new DataTransfer();
                            dataTransfer.items.add(compressedFile);
                            input.files = dataTransfer.files;

                            // Mostrar info de compresión
                            const originalSize = (file.size / 1024).toFixed(2);
                            const compressedSize = (compressedBlob.size / 1024).toFixed(2);
                            const reduction = ((1 - compressedBlob.size / file.size) * 100).toFixed(0);
                            console.log(`Imagen comprimida: ${originalSize}KB -> ${compressedSize}KB (${reduction}% reducción)`);
                        };
                        reader.readAsDataURL(compressedBlob);
                    }).catch(error => {
                        console.error('Error al comprimir imagen:', error);
                        // Si falla la compresión, mostrar imagen original
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            var editPreviewImg = document.getElementById('editPreviewImg');
                            var editNoImagenText = document.getElementById('editNoImagenText');
                            var editImagenActions = document.getElementById('editImagenActions');

                            editPreviewImg.src = e.target.result;
                            editPreviewImg.style.display = 'block';
                            editImagenActions.style.display = 'block';
                            editNoImagenText.style.display = 'none';
                        };
                        reader.readAsDataURL(file);
                    });
                }
            }

            function removeImageEdit() {
                document.getElementById('editImagenUsuario').value = '';
                document.getElementById('editPreviewImg').style.display = 'none';
                document.getElementById('editImagenActions').style.display = 'none';
                document.getElementById('editNoImagenText').style.display = 'block';
            }

            // Función para mostrar modal de imagen completa
            function showImageModal(imageSrc, userName) {
                document.getElementById('modalImageView').src = imageSrc;
                document.getElementById('imageViewModalLabel').innerHTML = '<i class="fas fa-image"></i> Imagen de ' + userName;
                var modal = new bootstrap.Modal(document.getElementById('imageViewModal'));
                modal.show();
            }

            // Limpiar formularios al cerrar modales
            $('#crearUsuarioModal').on('hidden.bs.modal', function () {
                document.getElementById('crearUsuarioForm').reset();
                removeImageCreate();
            });

            $('#editUserModal').on('hidden.bs.modal', function () {
                // No resetear completamente, solo limpiar la imagen nueva si no se guardó
                // El formulario se llena con setEditUser
            });

        </script>
    }


</body>
</html>
