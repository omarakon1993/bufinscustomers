            // Función para comprimir imagen usando canvas
            function compressImage(file, maxWidth, maxHeight, quality) {
                return new Promise((resolve, reject) => {
                    const reader = new FileReader();
                    reader.readAsDataURL(file);
                    reader.onload = function (e) {
                        const img = new Image();
                        img.src = e.target.result;
                        img.onload = function () {
                            const canvas = document.createElement('canvas');
                            let width = img.width;
                            let height = img.height;

                            // Calcular nuevas dimensiones manteniendo aspecto
                            if (width > height) {
                                if (width > maxWidth) {
                                    height *= maxWidth / width;
                                    width = maxWidth;
                                }
                            } else {
                                if (height > maxHeight) {
                                    width *= maxHeight / height;
                                    height = maxHeight;
                                }
                            }

                            canvas.width = width;
                            canvas.height = height;
                            const ctx = canvas.getContext('2d');
                            ctx.drawImage(img, 0, 0, width, height);

                            // Convertir a blob con calidad especificada
                            canvas.toBlob(
                                (blob) => {
                                    if (blob) {
                                        resolve(blob);
                                    } else {
                                        reject(new Error('Error al comprimir imagen'));
                                    }
                                },
                                file.type || 'image/jpeg',
                                quality
                            );
                        };
                        img.onerror = reject;
                    };
                    reader.onerror = reject;
                });
            }

            // Funciones para preview de imagen en crear usuario
            function previewImageCreate(input) {
                if (input.files && input.files[0]) {
                    const file = input.files[0];

                    // Validar tamaño inicial (10MB máximo antes de comprimir)
                    if (file.size > 10485760) {
                        const isMobile = window.innerWidth <= 768;
                        Swal.fire({
                            icon: 'error',
                            title: _usrMsg.archivoGrande,
                            toast: true,
                            position: isMobile ? 'top' : 'top-end',
                            showConfirmButton: false,
                            timer: 3000,
                            timerProgressBar: true
                        });
                        input.value = '';
                        return;
                    }

                    // Comprimir imagen
                    compressImage(file, 1024, 1024, 0.8).then(compressedBlob => {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            document.getElementById('crearPreviewImg').src = e.target.result;
                            document.getElementById('crearImagenPreview').style.display = 'block';

                            // Crear un nuevo File del blob comprimido
                            const compressedFile = new File([compressedBlob], file.name, { type: file.type });

                            // Reemplazar el archivo en el input con el comprimido
                            const dataTransfer = new DataTransfer();
                            dataTransfer.items.add(compressedFile);
                            input.files = dataTransfer.files;

                            // Mostrar info de compresión
                            const originalSize = (file.size / 1024).toFixed(2);
                            const compressedSize = (compressedBlob.size / 1024).toFixed(2);
                            const reduction = ((1 - compressedBlob.size / file.size) * 100).toFixed(0);
                            console.log(`Imagen comprimida: ${originalSize}KB -> ${compressedSize}KB (${reduction}% reducción)`);
                        };
                        reader.readAsDataURL(compressedBlob);
                    }).catch(error => {
                        console.error('Error al comprimir imagen:', error);
                        // Si falla la compresión, mostrar imagen original
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            document.getElementById('crearPreviewImg').src = e.target.result;
                            document.getElementById('crearImagenPreview').style.display = 'block';
                        };
                        reader.readAsDataURL(file);
                    });
                }
            }

