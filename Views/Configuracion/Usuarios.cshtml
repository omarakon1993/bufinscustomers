            position: isMobile ? 'top' : 'top-end',
            icon: 'info',
            title: '@TempData["InfoMessage"]',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer);
                toast.addEventListener('mouseleave', Swal.resumeTimer);
            }
        });
        </script>
    }


    @section scripts {
        <script>
            var _usrMsg = {
                camposReq: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Usr_JS_CamposReq))',
                archivoGrande: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Usr_JS_CamposReq))',
                pwdMostrar: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Usr_PwdMostrar))',
                pwdOcultar: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Usr_PwdOcultar))',
                rolCambioTitulo: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Usr_JS_RolCambioTitulo))',
                rolCambioTexto: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Usr_JS_RolCambioTexto))',
                rolCambioConfirmar: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Usr_JS_RolCambioConfirmar))',
                rolCambioCancelar: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Usr_JS_RolCambioCancelar))'
            };

            // Aviso inline al cambiar el rol en el modal de edición
            var _editAdminSelect = document.getElementById("editAdmin");
            if (_editAdminSelect) {
                _editAdminSelect.addEventListener('change', function () {
                    var warningEl = document.getElementById("editAdminRolWarning");
                    warningEl.style.display = (this.value !== _editAdminOriginal) ? 'block' : 'none';
                });
            }

            // Confirmación adicional al guardar la edición si el rol fue modificado
            function confirmarCambioRolUsuario() {
                var adminActual = document.getElementById("editAdmin").value;
                if (adminActual === _editAdminOriginal) {
                    return true;
                }
                return Swal.fire({
                    icon: 'warning',
                    title: _usrMsg.rolCambioTitulo,
                    text: _usrMsg.rolCambioTexto,
