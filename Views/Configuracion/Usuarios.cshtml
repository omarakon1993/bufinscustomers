            function validarFormularioConAlerta(formId, buttonId, confirmacionExtra) {
                document.getElementById(buttonId).addEventListener('click', function () {
                    var form = document.getElementById(formId);
                    if (!form.checkValidity()) {
                        var firstInvalid = form.querySelector(':invalid');
                        if (firstInvalid) {
                            var tabPane = firstInvalid.closest('.tab-pane');
                            if (tabPane && !tabPane.classList.contains('active')) {
                                var tabId = tabPane.id;
                                var tabTrigger = document.querySelector('[data-target="#' + tabId + '"]');
                                if (tabTrigger) {
                                    $(tabTrigger).tab('show');
                                }
                            }
                            firstInvalid.focus();
                        }
                        const isMobile = window.innerWidth <= 768;
                        form.classList.add('was-validated');
                        Swal.fire({
                            icon: 'error',
                            title: _usrMsg.camposReq,
                            toast: true,
                            position: isMobile ? 'top' : 'top-end',
                            showConfirmButton: false,
                            timer: 3000,
                            timerProgressBar: true,
                            didOpen: (toast) => {
                                toast.addEventListener('mouseenter', Swal.stopTimer);
                                toast.addEventListener('mouseleave', Swal.resumeTimer);
                            }
                        });
                        return;
                    }

                    if (typeof confirmacionExtra === 'function') {
                        var resultado = confirmacionExtra();
                        if (resultado && typeof resultado.then === 'function') {
                            resultado.then(function (continuar) {
                                if (continuar) form.submit();
                            });
                            return;
                        }
                        if (!resultado) return;
                    }

                    form.submit();
                });
            }


