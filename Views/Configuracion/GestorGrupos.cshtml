@model IEnumerable<bufinscustomers.Models.GrupoMenu>
@using bufinscustomers.Helpers
@using System.Web.Script.Serialization

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>@Resources.Strings.Grp_PageTitle</title>
    <script src="~/Assets/js/sweetalert2.all.min.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="~/Assets/css/configuracion-admin.css" rel="stylesheet" />
</head>
<body>

@{
    var successMsg = TempData["SuccessMessage"] as string;
    var errorMsg   = TempData["ErrorMessage"]   as string;
    var categorias = ViewBag.Categorias as List<bufinscustomers.Models.CategoriaMenu> ?? new List<bufinscustomers.Models.CategoriaMenu>();
    var jss        = new JavaScriptSerializer();
    var jsonData   = jss.Serialize(Model.Select(g => new { g.Id, g.Nombre, g.NombreEN, g.Icono, g.IdCategoria, g.NombreCategoria, g.Orden }));
}

@if (!string.IsNullOrEmpty(successMsg))
{
    <script>
        Swal.fire({ toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end', icon: 'success', title: '@Html.Raw(successMsg.Replace("'", "\\'"))', showConfirmButton: false, timer: 3000, timerProgressBar: true });
    </script>
}
@if (!string.IsNullOrEmpty(errorMsg))
{
    <script>
        Swal.fire({ toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end', icon: 'error', title: '@Html.Raw(errorMsg.Replace("'", "\\'"))', showConfirmButton: false, timer: 3000, timerProgressBar: true });
    </script>
}

<div class="card shadow mb-4 mt-4">
    <div class="card-header">
        <i class="fas fa-layer-group"></i> @Resources.Strings.Grp_PageTitle
    </div>
    <div class="card-body p-0">
        <div class="table-responsive table-wrapper">
            <table class="table table-bordered table-hover table-compact">
                <thead>
                    <tr>
                        <th style="width:50px">#</th>
                        <th>@Resources.Strings.Rep_LabelNombre</th>
                        <th>@Resources.Strings.Menu_ThNombreEN</th>
                        <th style="width:80px;text-align:center">@Resources.Strings.Menu_LabelIcono</th>
                        <th style="width:150px">@Resources.Strings.Grp_ThCategoria</th>
                        <th style="width:70px;text-align:center">@Resources.Strings.Menu_ThOrden</th>
                        <th style="width:110px;text-align:center">@Resources.Strings.Common_ThAcciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-3">@Resources.Strings.Grp_NoGrupos</td></tr>
                    }
                    @foreach (var g in Model)
                    {
                        <tr>
                            <td>@g.Id</td>
                            <td><strong>@g.Nombre</strong></td>
                            <td><span class="text-muted">@g.NombreEN</span></td>
                            <td style="text-align:center">
                                @if (!string.IsNullOrEmpty(g.Icono))
                                {
                                    <i class="@g.Icono" style="font-size:1.1rem;color:#583AFF"></i>
                                    <br /><small class="text-muted" style="font-size:.65rem">@g.Icono</small>
                                }
                            </td>
                            <td>
                                <span style="font-size:.8rem">@g.NombreCategoria</span>
                            </td>
                            <td style="text-align:center">@g.Orden</td>
                            <td style="text-align:center">
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-primary" title="@Resources.Strings.Rep_BtnEditar"
                                            data-toggle="modal" data-target="#editModal"
                                            onclick="setEditar(@g.Id, '@Html.Raw(g.Nombre?.Replace("'","\\'")??"")', '@Html.Raw(g.NombreEN?.Replace("'","\\'")??"")', '@Html.Raw(g.Icono?.Replace("'","\\'")??"")', @g.IdCategoria, @g.Orden)">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-danger" title="@Resources.Strings.Common_BtnEliminar"
                                            onclick="confirmarEliminar(@g.Id, '@Html.Raw(g.Nombre?.Replace("'","\\'")??"")')">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer">
        <button type="button" class="btn btn-success btn-sm" data-toggle="modal" data-target="#crearModal">
            <i class="fas fa-plus-circle mr-1"></i> @Resources.Strings.Grp_BtnNuevo
        </button>
    </div>
</div>

<!-- Modal Crear -->
<div class="modal fade" id="crearModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-plus-circle"></i> @Resources.Strings.Grp_ModalCreateTitle</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <form method="post" action="/GestorGrupos/Crear">
    @Html.AntiForgeryToken()
                <div class="modal-body">
                    <!-- Fila 1: Nombre ES / Nombre EN -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label><i class="fas fa-tag mr-1" style="color:#583AFF"></i>@Resources.Strings.Rep_LabelNombre <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" name="Nombre" required maxlength="100" placeholder="Ej: Plantillas de cargue" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label><i class="fas fa-globe mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_LabelNombreEN</label>
                            <input type="text" class="form-control form-control-sm" name="NombreEN" maxlength="100" placeholder="Ej: Upload Templates" />
                        </div>
                    </div>
                    <!-- Fila 2: Icono / Orden -->
                    <div class="row">
                        <div class="col-md-9 mb-3">
                            <label><i class="fas fa-icons mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_LabelIcono <small class="text-muted">(FontAwesome)</small></label>
                            <input type="text" class="form-control form-control-sm" name="Icono" placeholder="fas fa-layer-group" maxlength="100" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label><i class="fas fa-sort-numeric-up mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_ThOrden</label>
                            <input type="number" class="form-control form-control-sm" name="Orden" value="0" min="0" />
                        </div>
                    </div>
                    <!-- Fila 3: Categoría -->
                    <div class="mb-3">
                        <label><i class="fas fa-folder mr-1" style="color:#583AFF"></i>@Resources.Strings.Grp_LabelCategoria <span class="text-danger">*</span></label>
                        <select class="form-control form-control-sm" name="IdCategoria" required>
                            <option value="">@Resources.Strings.Grp_SelCategoria</option>
                            @foreach (var cat in categorias)
                            {
                                <option value="@cat.Id">@cat.Nombre</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i>@Resources.Strings.Layout_Cancel
                    </button>
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus-circle mr-1"></i>@Resources.Strings.Common_BtnCrear
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Editar -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-edit"></i> @Resources.Strings.Grp_ModalEditTitle</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <form method="post" action="/GestorGrupos/Editar">
    @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editId" />
                <div class="modal-body">
                    <!-- Fila 1: Nombre ES / Nombre EN -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label><i class="fas fa-tag mr-1" style="color:#583AFF"></i>@Resources.Strings.Rep_LabelNombre <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" name="Nombre" id="editNombre" required maxlength="100" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label><i class="fas fa-globe mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_LabelNombreEN</label>
                            <input type="text" class="form-control form-control-sm" name="NombreEN" id="editNombreEN" maxlength="100" />
                        </div>
                    </div>
                    <!-- Fila 2: Icono / Orden -->
                    <div class="row">
                        <div class="col-md-9 mb-3">
                            <label><i class="fas fa-icons mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_LabelIcono <small class="text-muted">(FontAwesome)</small></label>
                            <input type="text" class="form-control form-control-sm" name="Icono" id="editIcono" maxlength="100" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label><i class="fas fa-sort-numeric-up mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_ThOrden</label>
                            <input type="number" class="form-control form-control-sm" name="Orden" id="editOrden" min="0" />
                        </div>
                    </div>
                    <!-- Fila 3: Categoría -->
                    <div class="mb-3">
                        <label><i class="fas fa-folder mr-1" style="color:#583AFF"></i>@Resources.Strings.Grp_LabelCategoria <span class="text-danger">*</span></label>
                        <select class="form-control form-control-sm" name="IdCategoria" id="editIdCategoria" required>
                            <option value="">@Resources.Strings.Grp_SelCategoria</option>
                            @foreach (var cat in categorias)
                            {
                                <option value="@cat.Id">@cat.Nombre</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i>@Resources.Strings.Layout_Cancel
                    </button>
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="fas fa-save mr-1"></i>@Resources.Strings.Common_GuardarCambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Form eliminar oculto -->
<form id="frmElim" method="post" action="/GestorGrupos/Eliminar" style="display:none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="elimId" />
</form>

<script>
    function setEditar(id, nombre, nombreEN, icono, idCategoria, orden) {
        document.getElementById('editId').value       = id;
        document.getElementById('editNombre').value   = nombre;
        document.getElementById('editNombreEN').value = nombreEN;
        document.getElementById('editIcono').value    = icono;
        document.getElementById('editOrden').value    = orden;
        var sel = document.getElementById('editIdCategoria');
        for (var i = 0; i < sel.options.length; i++) {
            if (parseInt(sel.options[i].value) === idCategoria) { sel.selectedIndex = i; break; }
        }
    }

    function confirmarEliminar(id, nombre) {
        Swal.fire({
            title: '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Grp_JS_ElimTitle)',
            text: '"' + nombre + '" @HttpUtility.JavaScriptStringEncode(Resources.Strings.Grp_JS_ElimSuffix)',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#e74a3b',
            cancelButtonText: '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Layout_Cancel)',
            confirmButtonText: '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_BtnEliminar)'
        }).then(function(r) {
            if (r.isConfirmed) {
                document.getElementById('elimId').value = id;
                document.getElementById('frmElim').submit();
            }
        });
    }
</script>
</body>
</html>
