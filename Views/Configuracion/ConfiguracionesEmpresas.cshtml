﻿@using bufinscustomers.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <title>@Resources.Strings.CfgEmp_PageTitle</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="stylesheet" href="~/Assets/css/bootstrap-icons.min.css">
    <!-- ✅ jQuery UI CSS - Cargar primero -->
    <link rel="stylesheet" href="~/Assets/css/jquery-ui.min.css">

    <style>
        .card-tab {
            cursor: pointer;
            transition: all 0.3s ease;
            border: 2px solid #e3e6f0;
        }

            .card-tab:hover {
                transform: translateY(-5px);
                box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
            }

            .card-tab.active {
                border-color: #583AFF;
                background-color: #f8f9fc;
            }

        .list-item {
            padding: 10px;
            margin: 5px 0;
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 5px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: move;
        }

            .list-item:hover {
                background: #e9ecef;
            }

        .drag-handle {
            cursor: grab;
            color: #6c757d;
        }

            .drag-handle:active {
                cursor: grabbing;
            }

        .config-section {
            display: none;
        }

            .config-section.active {
                display: block;
            }

        .badge-custom {
            font-size: 0.7rem;
            padding: 2px 6px;
        }

        /* Tarjetas de pestaña compactas */
        .card-tab .card-body {
            padding: 0.55rem 0.3rem;
        }

        .card-tab .tab-icon {
            font-size: 1.25rem;
            display: block;
            margin-bottom: 0.25rem;
        }

        .card-tab .tab-label {
            font-size: 0.75rem;
            font-weight: 500;
            line-height: 1.2;
            display: block;
            margin-bottom: 0.2rem;
            word-break: break-word;
            hyphens: auto;
        }

        .btn-group-sm > .btn {
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
        }

        .empty-state {
            text-align: center;
            padding: 30px;
            color: #6c757d;
        }

            .empty-state i {
                font-size: 3rem;
                margin-bottom: 15px;
            }

        .sortable-list {
            min-height: 50px;
        }

        .sortable-placeholder {
            background: linear-gradient(45deg, #f0edff, #ded4ff);
            border: 2px dashed #583AFF;
            height: 50px;
            margin: 5px 0;
            border-radius: 5px;
            opacity: 0.7;
        }

        /* Estilos para modal de instructivo */
        .custom-header {
            background: var(--content-gradient);
            color: white;
            padding: 20px;
            border-radius: 0.3rem 0.3rem 0 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .logo-bufins {
            width: 60px;
            height: auto;
            margin-right: 15px;
        }

        .instructivo-title {
            font-size: 1.5rem;
            font-weight: bold;
            margin: 0;
        }

        /* === COLORES === */
        :root {
            --color-primario: #583AFF;
            --color-secundario: #01E1D7;
        }

        /* === ENCABEZADO CARD === */
        .card-header {
            background: var(--content-gradient);
            color: white;
            padding: 1.2rem 1.5rem;
            font-weight: 600;
            font-size: 1.2rem;
        }

        .card-header i {
            margin-right: 8px;
        }

        .panel-cierre-anio {
            background: #fff8e1;
            border: 1px solid #ffc107;
            border-left: 5px solid #f59e0b;
            border-radius: 6px;
            padding: 1rem 1.25rem;
        }

        .panel-cierre-anio h6 {
            color: #92400e;
            font-size: 0.95rem;
        }

        .panel-cierre-anio p {
            font-size: 0.85rem;
            color: #6c757d;
            margin-bottom: 0.75rem;
        }

        .modal-header-rojo {
            background: linear-gradient(135deg, #c0392b 0%, #922b21 100%);
            color: white;
            padding: 1.1rem 1.5rem;
            border-radius: 0.3rem 0.3rem 0 0;
        }

        .lista-efectos li {
            padding: 3px 0;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <div class="powerbi-header" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
        <div class="powerbi-header-content">
            <i class="bi bi-building-gear powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@Resources.Strings.CfgEmp_PageTitle</h1>
        </div>
        <button type="button" class="btn-modern-secondary" data-toggle="modal" data-target="#modalInstructivo">
            <i class="fas fa-book"></i> @Resources.Strings.CfgEmp_BtnInstructivo
        </button>
    </div>

    <!-- Selector de Empresa -->
    <div class="card shadow mb-4 mt-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <label for="selectEmpresa" class="form-label">@Resources.Strings.CfgEmp_LabelEmpresa</label>
                    <select class="form-control" id="selectEmpresa">
                        <option value="">@Resources.Strings.CfgEmp_SelEmpresa</option>
                        @if (ViewBag.Empresas != null)
                        {
                            foreach (var empresa in ViewBag.Empresas)
                            {
                                <option value="@empresa.Id">@empresa.Nombre</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <button type="button" class="btn-modern-gradient" id="btnCargarConfig">
                        <i class="fas fa-search"></i> @Resources.Strings.CfgEmp_BtnCargar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Panel de Configuración -->
    <div id="panelConfiguracion" style="display: none;">

        <!-- Configuración Básica -->
        <div class="card shadow mb-4 mt-4">
            <div class="card-header">
                <i class="bi bi-gear-fill"></i> @Resources.Strings.CfgEmp_TitleBasica
            </div>
            <div class="card-body">
                <form id="formConfigBasica">
                    <input type="hidden" id="idConfiguracion" />
                    <input type="hidden" id="idEmpresaConfig" />

                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>@Resources.Strings.CfgEmp_LabelAnio</label>
                                <input type="number" class="form-control" id="anioEjecucion" min="2000" max="2100" required readonly />
                                <small class="text-muted">@Resources.Strings.CfgEmp_AnioReadonlyNote <em>@Resources.Strings.CfgEmp_Cierre_Btn</em>.</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>@Resources.Strings.CfgEmp_LabelSigno</label>
                                <select class="form-control" id="signoCreditos">
                                    <option value="">@Resources.Strings.CfgEmp_SignoSinSigno</option>
                                    <option value="+">@Resources.Strings.CfgEmp_SignoPositivo</option>
                                    <option value="-">@Resources.Strings.CfgEmp_SignoNegativo</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>@Resources.Strings.CfgEmp_LabelMoneda</label>
                                <select class="form-control" id="moneda" required>
                                    <option value="CO$">@Resources.Strings.CfgEmp_MonedaCOP</option>
                                    <option value="USD">@Resources.Strings.CfgEmp_MonedaUSD</option>
                                    <option value="EUR">@Resources.Strings.CfgEmp_MonedaEUR</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>@Resources.Strings.CfgEmp_LabelUnidad</label>
                                <select class="form-control" id="unidad" required>
                                    <option value="MILES">MILES</option>
                                    <option value="MILLONES">MILLONES</option>
                                    <option value="UNIDADES">UNIDADES</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-12">
                            <button type="submit" class="btn-modern-gradient">
                                <i class="fas fa-save"></i> @Resources.Strings.CfgEmp_BtnGuardarBasica
                            </button>
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="panel-cierre-anio">
                        <div class="d-flex align-items-start">
                            <i class="fas fa-exclamation-triangle fa-2x text-warning mr-3 mt-1 flex-shrink-0"></i>
                            <div class="w-100">
                                <h6 class="font-weight-bold mb-1">
                                    <i class="fas fa-calendar-times mr-1"></i> @Resources.Strings.CfgEmp_Cierre_Title
                                </h6>
                                <p>@Resources.Strings.CfgEmp_Cierre_Desc</p>
                                <button type="button" class="btn btn-warning btn-sm" id="btnCerrarAnio"
                                        onclick="abrirModalCerrarAnio()" disabled>
                                    <i class="fas fa-exchange-alt mr-1"></i>
                                    @Resources.Strings.CfgEmp_Cierre_Btn <strong id="labelAnioActualBtn">—</strong>
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Pestañas de Configuración Detallada -->
        <div class="card shadow mb-4 mt-4">
            <div class="card-header">
                <i class="bi bi-list-ul"></i> @Resources.Strings.CfgEmp_TitleListas
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-6 col-md-3 col-xl mb-2">
                        <div class="card card-tab" data-section="empresas">
                            <div class="card-body text-center">
                                <i class="fas fa-building tab-icon text-primary"></i>
                                <span class="tab-label">@Resources.Strings.CfgEmp_TabEmpresas</span>
                                <span class="badge badge-primary badge-custom" id="countEmpresas">0</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 col-xl mb-2">
                        <div class="card card-tab" data-section="paises">
                            <div class="card-body text-center">
                                <i class="fas fa-globe tab-icon text-info"></i>
                                <span class="tab-label">@Resources.Strings.CfgEmp_TabPaises</span>
                                <span class="badge badge-info badge-custom" id="countPaises">0</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 col-xl mb-2">
                        <div class="card card-tab" data-section="categorias">
                            <div class="card-body text-center">
                                <i class="fas fa-tags tab-icon text-success"></i>
                                <span class="tab-label">@Resources.Strings.CfgEmp_TabCategorias</span>
                                <span class="badge badge-success badge-custom" id="countCategorias">0</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 col-xl mb-2">
                        <div class="card card-tab" data-section="tipos">
                            <div class="card-body text-center">
                                <i class="fas fa-cube tab-icon text-warning"></i>
                                <span class="tab-label">@Resources.Strings.CfgEmp_TabTipos</span>
                                <span class="badge badge-warning badge-custom" id="countTipos">0</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 col-xl mb-2">
                        <div class="card card-tab" data-section="lineas">
                            <div class="card-body text-center">
                                <i class="fas fa-chart-line tab-icon text-danger"></i>
                                <span class="tab-label">@Resources.Strings.CfgEmp_TabLineas</span>
                                <span class="badge badge-danger badge-custom" id="countLineas">0</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 col-xl mb-2">
                        <div class="card card-tab" data-section="ajuste1">
                            <div class="card-body text-center">
                                <i class="fas fa-sliders tab-icon text-secondary"></i>
                                <span class="tab-label">@Resources.Strings.CfgEmp_TabAjuste1</span>
                                <span class="badge badge-secondary badge-custom" id="countAjuste1">0</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 col-xl mb-2">
                        <div class="card card-tab" data-section="ajuste2">
                            <div class="card-body text-center">
                                <i class="fas fa-sliders tab-icon text-dark"></i>
                                <span class="tab-label">@Resources.Strings.CfgEmp_TabAjuste2</span>
                                <span class="badge badge-dark badge-custom" id="countAjuste2">0</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 col-xl mb-2">
                        <div class="card card-tab" data-section="anoshistoricos">
                            <div class="card-body text-center">
                                <i class="fas fa-calendar-alt tab-icon text-primary"></i>
                                <span class="tab-label">@Resources.Strings.CfgEmp_TabAnosHistoricos</span>
                                <span class="badge badge-primary badge-custom" id="countAnosHistoricos">0</span>
                            </div>
                        </div>
                    </div>
                    @if ((bool)ViewBag.EsAdmin)
                    {
                        <div class="col-6 col-md-3 col-xl mb-2">
                            <div class="card card-tab" data-section="resumenia">
                                <div class="card-body text-center">
                                    <i class="fas fa-robot tab-icon text-info"></i>
                                    <span class="tab-label">@Resources.Strings.CfgResumenIA_TabLabel</span>
                                    <span class="badge badge-info badge-custom" id="countResumenIA">0</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Sección de Empresas -->
                <div id="section-empresas" class="config-section">
                    <h5><i class="fas fa-building"></i> @Resources.Strings.CfgEmp_SecEmpresas</h5>
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <input type="text" class="form-control" id="inputEmpresa" placeholder="@Resources.Strings.CfgEmp_PlaceholderEmpresa" />
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-primary btn-block" onclick="agregarItem('Empresa')">
                                <i class="fas fa-plus"></i> @Resources.Strings.CfgEmp_BtnAgregarEmpresa
                            </button>
                        </div>
                    </div>
                    <div id="listaEmpresas" class="sortable-list"></div>
                </div>

                <!-- Sección de Países -->
                <div id="section-paises" class="config-section">
                    <h5><i class="fas fa-globe"></i> @Resources.Strings.CfgEmp_SecPaises</h5>
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <input type="text" class="form-control" id="inputPais" placeholder="@Resources.Strings.CfgEmp_PlaceholderPais" />
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-primary btn-block" onclick="agregarItem('Pais')">
                                <i class="fas fa-plus"></i> @Resources.Strings.CfgEmp_BtnAgregarPais
                            </button>
                        </div>
                    </div>
                    <div id="listaPaises" class="sortable-list"></div>
                </div>

                <!-- Sección de Categorías -->
                <div id="section-categorias" class="config-section">
                    <h5><i class="fas fa-tags"></i> @Resources.Strings.CfgEmp_SecCategorias</h5>
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <input type="text" class="form-control" id="inputCategoria" placeholder="@Resources.Strings.CfgEmp_PlaceholderCategoria" />
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-primary btn-block" onclick="agregarItem('Categoria')">
                                <i class="fas fa-plus"></i> @Resources.Strings.CfgEmp_BtnAgregarCategoria
                            </button>
                        </div>
                    </div>
                    <div id="listaCategorias" class="sortable-list"></div>
                </div>

                <!-- Sección de Tipos -->
                <div id="section-tipos" class="config-section">
                    <h5><i class="fas fa-cube"></i> @Resources.Strings.CfgEmp_SecTipos</h5>
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <input type="text" class="form-control" id="inputTipo" placeholder="@Resources.Strings.CfgEmp_PlaceholderTipo" />
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-primary btn-block" onclick="agregarItem('Tipo')">
                                <i class="fas fa-plus"></i> @Resources.Strings.CfgEmp_BtnAgregarTipo
                            </button>
                        </div>
                    </div>
                    <div id="listaTipos" class="sortable-list"></div>
                </div>

                <!-- Sección de Líneas de Negocio -->
                <div id="section-lineas" class="config-section">
                    <h5><i class="fas fa-chart-line"></i> @Resources.Strings.CfgEmp_SecLineas</h5>
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <input type="text" class="form-control" id="inputLinea" placeholder="@Resources.Strings.CfgEmp_PlaceholderLinea" />
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-primary btn-block" onclick="agregarItem('LineaNegocio')">
                                <i class="fas fa-plus"></i> @Resources.Strings.CfgEmp_BtnAgregarLinea
                            </button>
                        </div>
                    </div>
                    <div id="listaLineas" class="sortable-list"></div>
                </div>

                <!-- Sección de Ajuste 1 -->
                <div id="section-ajuste1" class="config-section">
                    <h5><i class="fas fa-sliders"></i> @Resources.Strings.CfgEmp_TabAjuste1</h5>
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <input type="text" class="form-control" id="inputAjuste1" placeholder="@Resources.Strings.CfgEmp_PlaceholderAjuste1" />
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-primary btn-block" onclick="agregarItem('Ajuste1')">
                                <i class="fas fa-plus"></i> @Resources.Strings.CfgEmp_BtnAgregarAjuste1
                            </button>
                        </div>
                    </div>
                    <div id="listaAjuste1" class="sortable-list"></div>
                </div>

                <!-- Sección de Ajuste 2 -->
                <div id="section-ajuste2" class="config-section">
                    <h5><i class="fas fa-sliders"></i> @Resources.Strings.CfgEmp_TabAjuste2</h5>
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <input type="text" class="form-control" id="inputAjuste2" placeholder="@Resources.Strings.CfgEmp_PlaceholderAjuste2" />
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-primary btn-block" onclick="agregarItem('Ajuste2')">
                                <i class="fas fa-plus"></i> @Resources.Strings.CfgEmp_BtnAgregarAjuste2
                            </button>
                        </div>
                    </div>
                    <div id="listaAjuste2" class="sortable-list"></div>
                </div>

                <!-- Sección de Años Históricos -->
                <div id="section-anoshistoricos" class="config-section">
                    <h5><i class="fas fa-calendar-alt"></i> @Resources.Strings.CfgEmp_SecAnosHistoricos</h5>
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <input type="text" class="form-control" id="inputAnoHistorico" placeholder="@Resources.Strings.CfgEmp_PlaceholderAnoHistorico" />
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-primary btn-block" onclick="agregarItem('AnoHistorico')">
                                <i class="fas fa-plus"></i> @Resources.Strings.CfgEmp_BtnAgregarAnoHistorico
                            </button>
                        </div>
                    </div>
                    <div id="listaAnosHistoricos" class="sortable-list"></div>
                </div>

                @if ((bool)ViewBag.EsAdmin)
                {
                    <!-- Sección de Resumen Ejecutivo IA -->
                    <div id="section-resumenia" class="config-section">
                        <h5><i class="fas fa-robot"></i> @Resources.Strings.CfgResumenIA_TablasTitle</h5>
                        <p class="text-muted small">@Resources.Strings.CfgResumenIA_SeleccioneEmpresaTexto</p>
                        <div class="mb-3">
                            <button type="button" class="btn btn-outline-primary btn-sm" id="btnSelTodoResumenIA">
                                <i class="fas fa-check-double"></i> @Resources.Strings.Perm_BtnSelTodo
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnDeselTodoResumenIA">
                                <i class="fas fa-times"></i> @Resources.Strings.Perm_BtnDeselTodo
                            </button>
                        </div>
                        <div id="listaTablasResumenIA">
                            @if (ViewBag.TablasDisponibles != null)
                            {
                                foreach (var t in (List<TablaDatos>)ViewBag.TablasDisponibles)
                                {
                                    <div class="list-item" style="cursor:default;">
                                        <div>
                                            <i class="fas fa-table mr-2 text-info"></i>
                                            <span>@t.NombreAmigable</span>
                                        </div>
                                        <div class="custom-control custom-switch">
                                            <input type="checkbox" class="custom-control-input tabla-resumenia-checkbox"
                                                   id="tablaIA_@t.NombreTabla" value="@t.NombreTabla">
                                            <label class="custom-control-label" for="tablaIA_@t.NombreTabla"></label>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                        <div class="mt-3">
                            <button type="button" class="btn-modern-gradient" id="btnGuardarTablasResumenIA">
                                <i class="fas fa-save"></i> @Resources.Strings.Common_GuardarCambios
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Modal Transición Año de Ejecución -->
    <div class="modal fade" id="modalCierreAnio" tabindex="-1" role="dialog"
         aria-hidden="true" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">

                <div class="modal-header-rojo d-flex align-items-center">
                    <i class="fas fa-exclamation-triangle fa-2x mr-3"></i>
                    <div>
                        <h5 class="mb-0 font-weight-bold">@Resources.Strings.CfgEmp_Cierre_ModalTitle</h5>
                        <small style="opacity:.85;">@Resources.Strings.CfgEmp_Cierre_ModalSubtitle</small>
                    </div>
                </div>

                <div class="modal-body">
                    <div class="alert alert-warning">
                        <strong><i class="fas fa-info-circle mr-1"></i> @Resources.Strings.CfgEmp_Cierre_QueHace</strong>
                        <ul class="mt-2 mb-0 lista-efectos">
                            <li>@Html.Raw(Resources.Strings.CfgEmp_Cierre_Li1)</li>
                            <li>@Html.Raw(Resources.Strings.CfgEmp_Cierre_Li2)</li>
                            <li>@Html.Raw(Resources.Strings.CfgEmp_Cierre_Li3)</li>
                        </ul>
                    </div>

                    <div class="alert alert-danger py-2">
                        <i class="fas fa-exclamation-circle mr-1"></i>
                        @Html.Raw(Resources.Strings.CfgEmp_Cierre_AlertDanger)
                    </div>

                    <div class="form-group mt-3 mb-1">
                        <label class="font-weight-bold">
                            <i class="fas fa-calendar-plus mr-1 text-success"></i>
                            @Resources.Strings.CfgEmp_Cierre_NuevoAnioLabel
                        </label>
                        <input type="number" class="form-control" id="inputNuevoAnio"
                               min="2000" max="2100" placeholder="@Resources.Strings.CfgEmp_Cierre_PlaceholderAnio" style="max-width:200px;" />
                        <small class="form-text text-muted">
                            @Resources.Strings.CfgEmp_Cierre_NuevoAnioHelp
                        </small>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i> @Resources.Strings.Layout_Cancel
                    </button>
                    <button type="button" class="btn btn-danger" onclick="confirmarCierreAnio()">
                        <i class="fas fa-exchange-alt mr-1"></i> @Resources.Strings.CfgEmp_Cierre_BtnConfirmar
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- Modal Instructivo -->
    <div class="modal fade" id="modalInstructivo" tabindex="-1" role="dialog" aria-labelledby="modalInstructivoLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="custom-header">
                    <img src="~/Assets/img/logoBufinsInst.png" alt="Bufins" class="logo-bufins">
                    <h5 class="instructivo-title" id="modalInstructivoLabel">@Resources.Strings.CfgEmp_InstructivoTitle</h5>
                </div>
                <div class="modal-body" style="max-height: 600px; overflow-y: auto;">
                    <p><strong>@Resources.Strings.CfgEmp_InstrIntro</strong></p>
                    <p>@Resources.Strings.CfgEmp_InstrEmpresas</p>
                    <p>@Resources.Strings.CfgEmp_InstrPaises</p>
                    <p>@Resources.Strings.CfgEmp_InstrSigno</p>
                    <p>@Resources.Strings.CfgEmp_InstrCategorias</p>
                    <ul>
                        <li>ACTIVO CORRIENTE</li>
                        <li>ACTIVO NO CORRIENTE</li>
                        <li>PASIVO NO CORRIENTE</li>
                        <li>PASIVO CORRIENTE</li>
                    </ul>
                    <p>@Resources.Strings.CfgEmp_InstrTipo</p>
                    <p>@Resources.Strings.CfgEmp_InstrLinea</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">@Resources.Strings.Layout_Cancel</button>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

@section scripts {
    <!-- ✅ jQuery UI JS - Carga DESPUÉS de que el Layout cargue jQuery -->
    <script src="~/Assets/Scripts/jquery-ui.min.js"></script>

    @* Scripts de TempData - Ahora dentro de la sección scripts *@
    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            $(document).ready(function() {
                const isMobile = window.innerWidth <= 768;
                Swal.fire({
                    toast: true,
                    position: isMobile ? 'top' : 'top-end',
                    icon: 'error',
                    title: '@TempData["ErrorMessage"]',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
            });
        </script>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            $(document).ready(function() {
                const isMobile = window.innerWidth <= 768;
                Swal.fire({
                    toast: true,
                    position: isMobile ? 'top' : 'top-end',
                    icon: 'success',
                    title: '@TempData["SuccessMessage"]',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
            });
        </script>
    }

    <script>
        let configuracionActual = null;

        // Mapeo de nombres de lista a tipos de servidor
        function mapearTipoParaServidor(tipoLista) {
            const mapeo = {
                'Empresas': 'Empresa',
                'Paises': 'Pais',
                'Categorias': 'Categoria',
                'Tipos': 'Tipo',
                'Lineas': 'LineaNegocio',
                'Ajuste1': 'Ajuste1',
                'Ajuste2': 'Ajuste2',
                'AnosHistoricos': 'AnoHistorico'
            };
            return mapeo[tipoLista] || tipoLista;
        }

        $(document).ready(function () {
            // ✅ Verificar que jQuery UI está disponible
            console.log('jQuery version:', $.fn.jquery);
            console.log('jQuery UI Sortable disponible:', typeof $.fn.sortable !== 'undefined');

            // Event handler para cargar configuración
            $('#btnCargarConfig').click(cargarConfiguracion);

            // Event handler para guardar configuración básica
            $('#formConfigBasica').submit(function (e) {
                e.preventDefault();
                guardarConfiguracionBasica();
            });

            // Event handler para tabs
            $('.card-tab').click(function () {
                $('.card-tab').removeClass('active');
                $(this).addClass('active');

                const section = $(this).data('section');
                $('.config-section').removeClass('active');
                $(`#section-${section}`).addClass('active');
            });

            // Activar primera pestaña por defecto
            $('.card-tab').first().click();

            // Permitir Enter en los inputs para agregar items
            $('#inputEmpresa').keypress(function (e) {
                if (e.which == 13) { e.preventDefault(); agregarItem('Empresa'); return false; }
            });
            $('#inputPais').keypress(function (e) {
                if (e.which == 13) { e.preventDefault(); agregarItem('Pais'); return false; }
            });
            $('#inputCategoria').keypress(function (e) {
                if (e.which == 13) { e.preventDefault(); agregarItem('Categoria'); return false; }
            });
            $('#inputTipo').keypress(function (e) {
                if (e.which == 13) { e.preventDefault(); agregarItem('Tipo'); return false; }
            });
            $('#inputLinea').keypress(function (e) {
                if (e.which == 13) { e.preventDefault(); agregarItem('LineaNegocio'); return false; }
            });
            $('#inputAjuste1').keypress(function (e) {
                if (e.which == 13) { e.preventDefault(); agregarItem('Ajuste1'); return false; }
            });
            $('#inputAjuste2').keypress(function (e) {
                if (e.which == 13) { e.preventDefault(); agregarItem('Ajuste2'); return false; }
            });
            $('#inputAnoHistorico').keypress(function (e) {
                if (e.which == 13) { e.preventDefault(); agregarItem('AnoHistorico'); return false; }
            });

            // Resumen Ejecutivo IA — selección de tablas por empresa
            $(document).on('change', '.tabla-resumenia-checkbox', actualizarContadorResumenIA);

            $('#btnSelTodoResumenIA').click(function () {
                $('.tabla-resumenia-checkbox').prop('checked', true);
                actualizarContadorResumenIA();
            });
            $('#btnDeselTodoResumenIA').click(function () {
                $('.tabla-resumenia-checkbox').prop('checked', false);
                actualizarContadorResumenIA();
            });

            $('#btnGuardarTablasResumenIA').click(function () {
                const idEmpresa = $('#idEmpresaConfig').val();
                if (!idEmpresa) return;

                const tablas = [];
                $('.tabla-resumenia-checkbox:checked').each(function () { tablas.push($(this).val()); });

                $.ajax({
                    url: '/ConfiguracionEmpresa/GuardarTablasResumenIA',
                    type: 'POST',
                    data: { idEmpresa: idEmpresa, tablas: tablas },
                    traditional: true,
                    success: function (response) {
                        mostrarAlerta(response.success ? 'success' : 'error', response.message);
                    },
                    error: function () {
                        mostrarAlerta('error', '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgResumenIA_ErrorGuardar))');
                    }
                });
            });
        });

        function cargarConfiguracion() {
            const idEmpresa = $('#selectEmpresa').val();

            if (!idEmpresa) {
                mostrarAlerta('warning', '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgEmp_JS_SelEmpresa))');
                return;
            }

            $.ajax({
                url: '/ConfiguracionEmpresa/ObtenerConfiguracion',
                type: 'GET',
                data: { idEmpresa: idEmpresa },
                success: function (response) {
                    if (response.success) {
                        configuracionActual = response.configuracion;
                        cargarDatosEnFormulario(response.configuracion);
                        $('#panelConfiguracion').slideDown();
                        mostrarAlerta('success', 'Configuración cargada correctamente');
                    } else {
                        mostrarAlerta('error', response.message);
                    }
                },
                error: function () {
                    mostrarAlerta('error', 'Error al cargar la configuración');
                }
            });
        }

        function cargarDatosEnFormulario(config) {
            // Configuración básica
            $('#idConfiguracion').val(config.Id || 0);
            $('#idEmpresaConfig').val(config.IdEmpresa);
            $('#anioEjecucion').val(config.AnioEjecucion);
            $('#signoCreditos').val(config.SignoCreditos || '');
            $('#moneda').val(config.Moneda);
            $('#unidad').val(config.Unidad);

            // Cargar listas con validación
            cargarLista('Empresas', config.EmpresasConsolidar || [], 'NombreEmpresa');
            cargarLista('Paises', config.Paises || [], 'NombrePais');
            cargarLista('Categorias', config.Categorias || [], 'NombreCategoria');
            cargarLista('Tipos', config.Tipos || [], 'NombreTipo');
            cargarLista('Lineas', config.LineasNegocio || [], 'NombreLinea');
            cargarLista('Ajuste1', config.Ajuste1 || [], 'NombreAjuste');
            cargarLista('Ajuste2', config.Ajuste2 || [], 'NombreAjuste');
            cargarLista('AnosHistoricos', config.AnosHistoricos || [], 'NombreAno');
            cargarTablasResumenIA(config.TablasResumenIA || []);

            actualizarContadores();

            // Habilitar botón de transición y mostrar el año actual en el panel
            const anio = config.AnioEjecucion;
            $('#labelAnioActualBtn').text(anio);
            $('.lbl-anio-actual').text(anio);
            $('#btnCerrarAnio').prop('disabled', false);
        }

        function cargarLista(tipo, items, propiedad) {
            const contenedor = $(`#lista${tipo}`);
            contenedor.empty();

            if (!items || items.length === 0) {
                contenedor.html(`
                            <div class="empty-state">
                                <i class="fas fa-inbox"></i>
                                <p>@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgEmp_NoElementos))</p>
                            </div>
                        `);
                return;
            }

            items.forEach(item => {
                const html = `
                            <div class="list-item" data-id="${item.Id}">
                                <div>
                                    <i class="fas fa-grip-vertical drag-handle"></i>
                                    <span class="ml-2">${item[propiedad]}</span>
                                </div>
                                <button class="btn btn-danger btn-sm" onclick="eliminarItem('${tipo}', ${item.Id})">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        `;
                contenedor.append(html);
            });

            // Hacer la lista ordenable (drag & drop)
            habilitarOrdenamiento(contenedor, tipo);
        }

        function cargarTablasResumenIA(tablas) {
            $('.tabla-resumenia-checkbox').prop('checked', false);
            (tablas || []).forEach(function (nombreTabla) {
                $('#tablaIA_' + nombreTabla).prop('checked', true);
            });
            actualizarContadorResumenIA();
        }

        function actualizarContadorResumenIA() {
            $('#countResumenIA').text($('.tabla-resumenia-checkbox:checked').length);
        }

        function habilitarOrdenamiento(contenedor, tipo) {
            // ✅ Verificar que sortable está disponible
            if (typeof $.fn.sortable !== 'function') {
                console.error('jQuery UI Sortable no está disponible');
                return;
            }

            // Destruir sortable existente si lo hay
            if (contenedor.hasClass('ui-sortable')) {
                try {
                    contenedor.sortable('destroy');
                } catch (e) {
                    console.warn('Error al destruir sortable:', e);
                }
            }

            try {
                contenedor.sortable({
                    handle: '.drag-handle',
                    cursor: 'move',
                    opacity: 0.8,
                    placeholder: 'sortable-placeholder',
                    update: function () {
                        const ids = [];
                        contenedor.find('.list-item').each(function () {
                            ids.push($(this).data('id'));
                        });
                        actualizarOrden(tipo, ids.join(','));
                    }
                });
                console.log('✅ Sortable habilitado para:', tipo);
            } catch (error) {
                console.error('Error al habilitar sortable:', error);
            }
        }

        function guardarConfiguracionBasica() {
            const datos = {
                IdEmpresa: $('#idEmpresaConfig').val(),
                AnioEjecucion: $('#anioEjecucion').val(),
                SignoCreditos: $('#signoCreditos').val(),
                Moneda: $('#moneda').val(),
                Unidad: $('#unidad').val()
            };

            $.ajax({
                url: '/ConfiguracionEmpresa/GuardarConfiguracionBasica',
                type: 'POST',
                data: datos,
                success: function (response) {
                    if (response.success) {
                        mostrarAlerta('success', response.message);
                        cargarConfiguracion();
                    } else {
                        mostrarAlerta('error', response.message);
                    }
                },
                error: function () {
                    mostrarAlerta('error', 'Error al guardar la configuración');
                }
            });
        }

        function agregarItem(tipo) {
            const inputMap = {
                'Empresa': '#inputEmpresa',
                'Pais': '#inputPais',
                'Categoria': '#inputCategoria',
                'Tipo': '#inputTipo',
                'LineaNegocio': '#inputLinea',
                'Ajuste1': '#inputAjuste1',
                'Ajuste2': '#inputAjuste2',
                'AnoHistorico': '#inputAnoHistorico'
            };

            const input = $(inputMap[tipo]);
            const valor = input.val().trim();

            if (!valor) {
                mostrarAlerta('warning', '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgEmp_JS_IngresarValor))');
                return;
            }

            if (tipo === 'AnoHistorico') {
                const anioEjecucion = $('#anioEjecucion').val();
                if (valor === anioEjecucion) {
                    mostrarAlerta('warning', 'El año histórico no puede ser igual al año de ejecución (' + anioEjecucion + ')');
                    return;
                }
            }

            const idConfig = $('#idConfiguracion').val();
            if (!idConfig || idConfig == '0') {
                mostrarAlerta('warning', '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgEmp_JS_NecesitaConfig))');
                return;
            }

            $.ajax({
                url: '/ConfiguracionEmpresa/AgregarItem',
                type: 'POST',
                data: {
                    tipo: tipo,
                    idConfiguracion: idConfig,
                    valor: valor
                },
                success: function (response) {
                    if (response.success) {
                        mostrarAlerta('success', response.message);
                        input.val('');
                        cargarConfiguracion();
                    } else {
                        mostrarAlerta('error', response.message);
                    }
                },
                error: function () {
                    mostrarAlerta('error', 'Error al agregar el elemento');
                }
            });
        }

        function eliminarItem(tipo, id) {
            Swal.fire({
                title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgEmp_JS_EliminarTitle))',
                text: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgEmp_JS_EliminarText))',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgEmp_JS_Eliminar))',
                cancelButtonText: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Layout_Cancel))'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/ConfiguracionEmpresa/EliminarItem',
                        type: 'POST',
                        data: { tipo: mapearTipoParaServidor(tipo), id: id },
                        success: function (response) {
                            if (response.success) {
                                mostrarAlerta('success', response.message);
                                cargarConfiguracion();
                            } else {
                                mostrarAlerta('error', response.message);
                            }
                        },
                        error: function () {
                            mostrarAlerta('error', 'Error al eliminar el elemento');
                        }
                    });
                }
            });
        }

        function actualizarOrden(tipo, ids) {
            $.ajax({
                url: '/ConfiguracionEmpresa/ActualizarOrden',
                type: 'POST',
                data: { tipo: mapearTipoParaServidor(tipo), ids: ids },
                success: function (response) {
                    if (response.success) {
                        mostrarAlerta('success', '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgEmp_JS_OrdenActualizado))', 2000);
                    }
                },
                error: function () {
                    mostrarAlerta('error', 'Error al actualizar el orden');
                }
            });
        }

        function actualizarContadores() {
            if (!configuracionActual) return;

            $('#countEmpresas').text((configuracionActual.EmpresasConsolidar || []).length);
            $('#countPaises').text((configuracionActual.Paises || []).length);
            $('#countCategorias').text((configuracionActual.Categorias || []).length);
            $('#countTipos').text((configuracionActual.Tipos || []).length);
            $('#countLineas').text((configuracionActual.LineasNegocio || []).length);
            $('#countAjuste1').text((configuracionActual.Ajuste1 || []).length);
            $('#countAjuste2').text((configuracionActual.Ajuste2 || []).length);
            $('#countAnosHistoricos').text((configuracionActual.AnosHistoricos || []).length);
        }

        function mostrarAlerta(tipo, mensaje, timer) {
            const iconos = {
                'success': 'success',
                'error': 'error',
                'warning': 'warning',
                'info': 'info'
            };

            const isMobile = window.innerWidth <= 768;
            Swal.fire({
                toast: true,
                position: isMobile ? 'top' : 'top-end',
                icon: iconos[tipo],
                title: mensaje,
                showConfirmButton: false,
                timer: timer || 3000,
                timerProgressBar: true
            });
        }

        // ── Transición de año de ejecución ──────────────────────────────────────

        function abrirModalCerrarAnio() {
            const anioActual = $('#anioEjecucion').val();
            if (!anioActual) {
                mostrarAlerta('warning', '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgEmp_Cierre_JS_NecesitaConfig))');
                return;
            }
            $('.lbl-anio-actual').text(anioActual);
            $('#inputNuevoAnio').val(parseInt(anioActual) + 1);
            $('#modalCierreAnio').modal('show');
        }

        function confirmarCierreAnio() {
            const anioActual = parseInt($('#anioEjecucion').val());
            const nuevoAnio  = parseInt($('#inputNuevoAnio').val());

            if (!nuevoAnio || nuevoAnio < 2000 || nuevoAnio > 2100) {
                mostrarAlerta('warning', '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgEmp_Cierre_JS_AnioInvalido))');
                return;
            }
            if (nuevoAnio === anioActual) {
                mostrarAlerta('warning', '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgEmp_Cierre_JS_AnioIgual))');
                return;
            }

            $('#modalCierreAnio').modal('hide');

            Swal.fire({
                title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgEmp_Cierre_JS_ConfirmTitle))',
                html: `@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgEmp_Cierre_JS_ConfirmHtmlPart1)) <strong>${anioActual}</strong> @Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgEmp_Cierre_JS_ConfirmHtmlPart2)) <strong>${nuevoAnio}</strong>.<br><br>` +
                      `<span class="text-danger"><strong>@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgEmp_Cierre_JS_ConfirmHtmlPart3))</strong></span>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#c0392b',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fas fa-exchange-alt mr-1"></i> @Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgEmp_Cierre_JS_ConfirmBtn))',
                cancelButtonText: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Layout_Cancel))'
            }).then(function (result) {
                if (result.isConfirmed) {
                    ejecutarCierreAnio($('#idEmpresaConfig').val(), nuevoAnio);
                }
            });
        }

        function ejecutarCierreAnio(idEmpresa, nuevoAnio) {
            Swal.fire({
                title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgEmp_Cierre_JS_ProcTitle))',
                text: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgEmp_Cierre_JS_ProcText))',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: function () { Swal.showLoading(); }
            });

            $.ajax({
                url: '/ConfiguracionEmpresa/CerrarAnioEjecucion',
                type: 'POST',
                data: { idEmpresa: idEmpresa, nuevoAnio: nuevoAnio },
                success: function (response) {
                    Swal.close();
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgEmp_Cierre_JS_OkTitle))',
                            text: response.message,
                            confirmButtonText: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgEmp_Cierre_JS_OkBtn))'
                        }).then(function () {
                            cargarConfiguracion();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgEmp_Cierre_JS_ErrTitle))',
                            text: response.message
                        });
                    }
                },
                error: function () {
                    Swal.close();
                    Swal.fire({
                        icon: 'error',
                        title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgEmp_Cierre_JS_ConnErrTitle))',
                        text: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgEmp_Cierre_JS_ConnErrText))'
                    });
                }
            });
        }
    </script>
}