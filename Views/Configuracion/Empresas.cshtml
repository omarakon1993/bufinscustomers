@model IEnumerable<bufinscustomers.Models.Empresas>
@using bufinscustomers.Helpers

<!DOCTYPE html>
<html>
<head>
    <title>@Resources.Strings.Emp_PageTitle</title>
    <script src="~/Assets/js/sweetalert2.all.min.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script src="~/Assets/Scripts/jquery-3.7.1.min.js"></script>
    <link href="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/css/empresa-logo.css")" rel="stylesheet" />
    <link href="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/css/tema-informe.css")" rel="stylesheet" />
</head>
<body>
    <style>
        :root {
            --color-primario: #583AFF;
            --color-secundario: #01E1D7;
        }

        .bg-primary {
            background-color: #583AFF !important;
        }

        /* === TABLA COMPACTA === */
        .table-wrapper {
            max-height: 400px;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .table-compact {
            table-layout: fixed;
            width: 100%;
            margin-bottom: 0;
        }

        .table-compact thead th {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            color: #fff;
            padding: 0.5rem 0.4rem;
            white-space: nowrap;
            border-bottom: 2px solid #dee2e6;
            background: var(--content-gradient);
            position: sticky;
            top: 0;
            z-index: 1;
        }

        .table-compact tbody td {
            font-size: 0.8rem;
            padding: 0.35rem 0.4rem;
            vertical-align: middle;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .table-compact tbody tr:hover {
            background-color: #f0edff;
        }

        /* Anchos de columna */
        .table-compact .col-id { width: 4%; text-align: center; }
        .table-compact .col-abreviatura { width: 7%; text-align: center; }
        .table-compact .col-logo { width: 8%; text-align: center; overflow: visible; }
        .table-compact .col-nombre { width: 12%; }
        .table-compact .col-nit { width: 8%; }
        .table-compact .col-direccion { width: 10%; }
        .table-compact .col-telefono { width: 8%; }
        .table-compact .col-correo { width: 11%; }
        .table-compact .col-web { width: 11%; }
        .table-compact .col-web a { color: #583AFF; text-decoration: none; }
        .table-compact .col-web a:hover { text-decoration: underline; }
        .table-compact .col-grupo {
            width: 10%;
            text-align: center;
            white-space: normal;
            overflow: visible;
            text-overflow: clip;
        }
        .table-compact .col-acciones { width: 14%; text-align: center; white-space: nowrap; }

        /* === BOTONES DE ACCIONES === */
        .btn-group {
            gap: 0.25rem;
        }

        .btn-group .btn {
            padding: 0.2rem 0.45rem;
            font-size: 0.75rem;
            border-radius: 0.25rem;
        }

        .btn-group .btn i {
            margin-right: 0;
        }

        /* === BUSCADOR === */
        .gestor-search-bar { padding: .55rem 1rem; background: #f8f9fa; border-bottom: 1px solid #e9ecef; }
        .gestor-search-wrapper { position: relative; max-width: 300px; }
        .gestor-search-icon { position: absolute; left: .65rem; top: 50%; transform: translateY(-50%); color: #9ca3af; font-size: .72rem; pointer-events: none; }
        .gestor-search-input { width: 100%; padding: .36rem .75rem .36rem 2rem; font-size: .8rem; border: 1px solid #dee2e6; border-radius: 6px; outline: none; transition: border-color .15s, box-shadow .15s; background: #fff; color: #374151; }
        .gestor-search-input:focus { border-color: #583AFF; box-shadow: 0 0 0 3px rgba(88,58,255,.12); }
        .gestor-search-input::placeholder { color: #b0b7c3; }

        /* === PAGINACIÓN === */
        .gestor-pagination { padding: .45rem 1rem; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #e9ecef; background: #fafafa; }
        .gestor-pag-info { font-size: .74rem; color: #6b7280; font-weight: 500; }
        .gestor-pag-controls { display: flex; align-items: center; gap: .3rem; }
        .gestor-pag-btn { width: 28px; height: 28px; border-radius: 6px; border: 1px solid #dee2e6; background: #fff; color: #583AFF; font-size: .7rem; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all .15s; padding: 0; }
        .gestor-pag-btn:hover:not(:disabled) { background: linear-gradient(90deg,#583AFF,#01E1D7); border-color: transparent; color: #fff; transform: scale(1.08); }
        .gestor-pag-btn:disabled { opacity: .35; cursor: not-allowed; color: #9ca3af; }
        .gestor-pag-num { font-size: .74rem; font-weight: 600; color: #374151; min-width: 62px; text-align: center; }
    </style>

    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas fa-building powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@Resources.Strings.Emp_PageTitle</h1>
        </div>
    </div>

    <div class="card shadow mb-4 mt-4">
        <div class="card-body p-0">
            <div class="gestor-search-bar">
                <div class="gestor-search-wrapper">
                    <i class="fas fa-search gestor-search-icon"></i>
                    <input type="text" id="buscarEmpresa" class="gestor-search-input"
                           placeholder="@Resources.Strings.Layout_SearchPlaceholder">
                </div>
            </div>
            <div class="table-responsive table-wrapper">
                <table id="tablaEmpresas" class="table table-bordered table-hover table-compact">
                    <thead>
                        <tr>
                            <th class="col-id">Id</th>
                            <th class="col-abreviatura">@Resources.Strings.Emp_ThAbreviatura</th>
                            <th class="col-logo">@Resources.Strings.EmpLogo_ThLogo</th>
                            <th class="col-nombre">@Resources.Strings.Emp_ThNombre</th>
                            <th class="col-nit">@Resources.Strings.Emp_ThNit</th>
                            <th class="col-direccion">@Resources.Strings.Emp_ThDireccion</th>
                            <th class="col-telefono">@Resources.Strings.Emp_ThTelefono</th>
                            <th class="col-correo">@Resources.Strings.Emp_ThCorreo</th>
                            <th class="col-web">@Resources.Strings.Emp_ThPaginaWeb</th>
                            <th class="col-grupo">@Resources.Strings.Emp_ThGrupo</th>
                            <th class="col-acciones">@Resources.Strings.Common_ThAcciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var empresa in Model)
                        {
                            <tr>
                                <td class="col-id">@empresa.Id</td>
                                <td class="col-abreviatura">
                                    @if (!string.IsNullOrEmpty(empresa.Abreviatura))
                                    {
                                        <span style="background:var(--app-btn-gradient);color:white;padding:0.15rem 0.55rem;border-radius:9999px;font-size:0.75rem;font-weight:600;letter-spacing:0.5px;">@empresa.Abreviatura</span>
                                    }
                                </td>
                                <td class="col-logo emp-logo-cell" data-logo-empresa="@empresa.Id">
                                    @if (!string.IsNullOrEmpty(empresa.LogoVersion))
                                    {
                                        <span class="emp-logo-plate"><img src="@Url.Action("Ver", "EmpresaLogo", new { id = empresa.Id, v = empresa.LogoVersion })" alt="@Resources.Strings.Common_LogoEmpresaAlt"></span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">&mdash;</span>
                                    }
                                </td>
                                <td class="col-nombre" title="@empresa.Nombre">@empresa.Nombre</td>
                                <td class="col-nit">@empresa.Nit</td>
                                <td class="col-direccion" title="@empresa.Direccion">@empresa.Direccion</td>
                                <td class="col-telefono">@empresa.Telefono</td>
                                <td class="col-correo" title="@empresa.Correo">@empresa.Correo</td>
                                <td class="col-web" title="@empresa.PaginaWeb">
                                    @* Solo se enlaza si es http/https (el dato pudo editarse a mano en la BD) *@
                                    @if (!string.IsNullOrEmpty(empresa.PaginaWeb) && (empresa.PaginaWeb.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || empresa.PaginaWeb.StartsWith("https://", StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <a href="@empresa.PaginaWeb" target="_blank" rel="noopener noreferrer">@(empresa.PaginaWeb.Replace("https://", "").Replace("http://", "").TrimEnd('/'))</a>
                                    }
                                </td>
                                <td class="col-grupo">
                                    @if (!string.IsNullOrEmpty(empresa.NombreGrupoEmpresarial))
                                    {
                                        <span style="background:#f0edff;color:#583AFF;padding:0.15rem 0.55rem;border-radius:9999px;font-size:0.72rem;font-weight:600;" title="@empresa.NombreGrupoEmpresarial">
                                            <i class="fas fa-sitemap mr-1"></i>@empresa.NombreGrupoEmpresarial
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="col-acciones">
                                    <div class="btn-group" role="group" aria-label="@Resources.Strings.Common_ThAcciones">
                                        <button type="button" class="btn btn-sm btn-primary" title="@Resources.Strings.Emp_TitleEditar" data-toggle="modal" data-target="#editEmpresaModal"
                                                onclick="setEditEmpresa(@empresa.Id, '@empresa.Nombre', '@empresa.Nit', '@empresa.Direccion', '@empresa.Telefono', '@empresa.Correo', '@empresa.Abreviatura', '@empresa.PaginaWeb', '@empresa.LogoVersion')">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-paleta" title="@Resources.Strings.PaletaCorp_BtnColores" aria-label="@Resources.Strings.PaletaCorp_BtnColores"
                                                data-nombre="@empresa.Nombre" onclick="ColoresCorp.abrir(@empresa.Id, this.getAttribute('data-nombre'))">
                                            <i class="fas fa-palette"></i>
                                        </button>
                                        @if (UsuarioSesionHelper.EsSuperAdmin())
                                        {
                                            <button type="button" class="btn btn-sm btn-danger" title="@Resources.Strings.Emp_TitleEliminar" data-toggle="modal" data-target="#confirmDeleteModal" onclick="setIdEmpresa(@empresa.Id)">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="gestor-pagination">
                <span class="gestor-pag-info" id="emp-info"></span>
                <div class="gestor-pag-controls">
                    <button class="gestor-pag-btn" id="emp-prev" onclick="empCambiarPagina(-1)">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <span class="gestor-pag-num" id="emp-pagnum"></span>
                    <button class="gestor-pag-btn" id="emp-next" onclick="empCambiarPagina(1)">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
            </div>
        </div>
        <script>
        (function () {
            var POR_PAGINA = 15;
            var paginaActual = 1;
            var filasFiltradas = [];

            function todasLasFilas() {
                return Array.from(document.querySelectorAll('#tablaEmpresas tbody tr'));
            }

            function aplicarFiltro() {
                var q = (document.getElementById('buscarEmpresa').value || '').toLowerCase().trim();
                filasFiltradas = todasLasFilas().filter(function (r) {
                    return !q || r.textContent.toLowerCase().indexOf(q) !== -1;
                });
                paginaActual = 1;
                renderizar();
            }

            function renderizar() {
                var inicio = (paginaActual - 1) * POR_PAGINA;
                var fin = inicio + POR_PAGINA;
                var totalPaginas = Math.max(1, Math.ceil(filasFiltradas.length / POR_PAGINA));

                todasLasFilas().forEach(function (r) { r.style.display = 'none'; });
                filasFiltradas.slice(inicio, fin).forEach(function (r) { r.style.display = ''; });

                document.getElementById('emp-info').textContent =
                    filasFiltradas.length + ' @Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_RegistrosPag)) ' + paginaActual + ' / ' + totalPaginas;
                document.getElementById('emp-prev').disabled = paginaActual <= 1;
                document.getElementById('emp-next').disabled = paginaActual >= totalPaginas;
            }

            window.empCambiarPagina = function (dir) {
                var totalPaginas = Math.max(1, Math.ceil(filasFiltradas.length / POR_PAGINA));
                paginaActual = Math.min(totalPaginas, Math.max(1, paginaActual + dir));
                renderizar();
            };

            document.getElementById('buscarEmpresa').addEventListener('input', aplicarFiltro);
            aplicarFiltro();
        })();
        </script>
        @if (UsuarioSesionHelper.EsSuperAdmin())
        {
        <div class="card-footer">
            <button type="button" class="btn-modern-success" data-toggle="modal" data-target="#crearEmpresaModal">
                <i class="fas fa-plus-circle mr-1"></i> @Resources.Strings.Emp_BtnCrear
            </button>
        </div>
        }
        </div>
    </div>

    <!-- Modal de confirmacion -->
    <div class="modal fade modal-confirm" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="confirmDeleteModalLabel">
                        <i class="fas fa-exclamation-triangle"></i> @Resources.Strings.Emp_ModalDeleteTitle
                    </h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0"><i class="fas fa-question-circle text-warning mr-2"></i>@Resources.Strings.Emp_ModalDeleteBody</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i>@Resources.Strings.Layout_Cancel
                    </button>
                    <form id="deleteForm" method="post" action="/Empresa/EliminarEmpresa" style="display: inline;">
    @Html.AntiForgeryToken()
                        <input type="hidden" id="idEmpresa" name="idEmpresa" />
                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="fas fa-trash-alt mr-1"></i>@Resources.Strings.Common_BtnEliminar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @Html.Partial("_ColoresCorporativosModal")
    <script src="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/js/colores-corporativos.js")"></script>

    <!-- Modal de edicion (estilo estándar de modales: ver Assets/css/bufins-modal.css) -->
    <div class="modal fade" id="editEmpresaModal" tabindex="-1" aria-labelledby="editEmpresaModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered bf-modal-wide">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editEmpresaModalLabel">
                        <i class="fas fa-building"></i>
                        <span class="bf-modal-titles">
                            <span>@Resources.Strings.Emp_ModalEditTitle</span>
                        <span class="bf-modal-sub" id="editEmpresaSub"></span>
                        </span>
                    </h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <form id="editEmpresaForm" method="post" action="/Empresa/EditarEmpresa">
    @Html.AntiForgeryToken()
                    <input type="hidden" id="editIdEmpresa" name="Id" />
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-8">
                        <div class="bf-section">@Resources.Strings.Emp_SecIdentificacion</div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="editNombre">@Resources.Strings.Emp_LabelNombre <span class="required">*</span></label>
                                <div class="bf-input"><i class="fas fa-building"></i>
                                    <input type="text" required placeholder="@Resources.Strings.Emp_PlaceholderNombre" class="form-control" id="editNombre" name="Nombre" />
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="editAbreviatura">@Resources.Strings.Emp_LabelAbreviatura <span class="required">*</span></label>
                                <div class="bf-input"><i class="fas fa-tag"></i>
                                    <input type="text" maxlength="12" pattern="[A-Za-z]{1,12}" required placeholder="@Resources.Strings.Emp_PlaceholderAbreviatura" oninput="this.value = this.value.replace(/[^A-Za-z]/g, '');" class="form-control" id="editAbreviatura" name="Abreviatura" />
                                </div>
                                    <small class="form-text">@Resources.Strings.Emp_HintAbreviatura</small>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="editNit">@Resources.Strings.Emp_LabelNit <span class="required">*</span></label>
                                <div class="bf-input"><i class="fas fa-id-card"></i>
                                    <input type="text" required placeholder="@Resources.Strings.Emp_PlaceholderNit" class="form-control" id="editNit" name="Nit" />
                                </div>
                            </div>
                        </div>

                        <div class="bf-section">@Resources.Strings.Emp_SecContacto</div>
                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label for="editDireccion">@Resources.Strings.Emp_LabelDireccion <span class="required">*</span></label>
                                <div class="bf-input"><i class="fas fa-map-marker-alt"></i>
                                    <input type="text" required placeholder="@Resources.Strings.Emp_PlaceholderDireccion" class="form-control" id="editDireccion" name="Direccion" />
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="editTelefono">@Resources.Strings.Emp_LabelTelefono</label>
                                <div class="bf-input"><i class="fas fa-phone"></i>
                                    <input type="text" pattern="\d{7,15}" maxlength="15" title="Solo numeros, sin espacios ni guiones" placeholder="@Resources.Strings.Emp_PlaceholderTelefono" oninput="this.value = this.value.replace(/[^0-9]/g, '');" class="form-control" id="editTelefono" name="Telefono" />
                                </div>
                            </div>
                            <div class="col-md-6 mb-1">
                                <label for="editCorreo">@Resources.Strings.Emp_LabelCorreo</label>
                                <div class="bf-input"><i class="fas fa-envelope"></i>
                                    <input type="email" maxlength="150" placeholder="@Resources.Strings.Emp_PlaceholderCorreo" class="form-control" id="editCorreo" name="Correo" />
                                </div>
                            </div>
                            <div class="col-md-6 mb-1">
                                <label for="editPaginaWeb">@Resources.Strings.Emp_LabelPaginaWeb</label>
                                <div class="bf-input"><i class="fas fa-globe"></i>
                                    <input type="text" inputmode="url" autocomplete="url" maxlength="300" data-url-web="1" placeholder="@Resources.Strings.Emp_PlaceholderPaginaWeb" class="form-control" id="editPaginaWeb" name="PaginaWeb" />
                                </div>
                            </div>
                        </div>
                            </div>
                            <div class="col-lg-4">
                        <div class="bf-section">@Resources.Strings.EmpLogo_ThLogo</div>
                        <div class="bf-logo-box" id="empLogoDrop" tabindex="0" role="button" aria-label="@Resources.Strings.EmpLogo_Elegir">
                            <span class="emp-logo-plate" id="empLogoPlate" hidden><img id="empLogoImg" alt="@Resources.Strings.Common_LogoEmpresaAlt"></span>
                            <span class="bf-logo-vacio" id="empLogoVacio"><i class="fas fa-cloud-upload-alt"></i>@Resources.Strings.EmpLogo_Elegir</span>
                        </div>
                        <div class="bf-logo-actions">
                            <button type="button" class="bf-btn-outline" id="empLogoBtnSubir"><i class="fas fa-upload"></i><span id="empLogoBtnTxt">@Resources.Strings.EmpLogo_BtnSubir</span></button>
                            <button type="button" class="bf-btn-icon-danger" id="empLogoBtnQuitar" style="display:none;" title="@Resources.Strings.EmpLogo_BtnQuitar" aria-label="@Resources.Strings.EmpLogo_BtnQuitar"><i class="fas fa-trash-alt"></i></button>
                        </div>
                        <div class="bf-logo-msg" id="empLogoMsg" role="status" aria-live="polite"></div>
                        <details class="emp-logo-reqs">
                            <summary>@Resources.Strings.EmpLogo_ReqTitulo</summary>
                            <div class="emp-logo-reqs-panel">
                                <p class="emp-logo-box-intro">@Resources.Strings.EmpLogo_Intro</p>
                                <ul>
                                    <li>@Resources.Strings.EmpLogo_Req_Formato</li>
                                    <li>@Resources.Strings.EmpLogo_Req_Peso</li>
                                    <li>@Resources.Strings.EmpLogo_Req_Tamano</li>
                                    <li>@Resources.Strings.EmpLogo_Req_Proporcion</li>
                                    <li>@Resources.Strings.EmpLogo_Req_Contenido</li>
                                    <li>@Resources.Strings.EmpLogo_Req_Guardado</li>
                                </ul>
                            </div>
                        </details>
                        <input type="file" id="empLogoFile" accept="image/png,image/jpeg" style="display:none;" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <span class="bf-footer-note"><b>*</b> @Resources.Strings.Common_CamposObligatorios</span>
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">@Resources.Strings.Layout_Cancel</button>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> @Resources.Strings.Common_GuardarCambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal de Creacion -->
    <div class="modal fade" id="crearEmpresaModal" tabindex="-1" aria-labelledby="crearEmpresaModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered bf-modal-wide">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="crearEmpresaModalLabel">
                        <i class="fas fa-plus-circle"></i>
                        <span class="bf-modal-titles">
                            <span>@Resources.Strings.Emp_ModalCreateTitle</span>
                        </span>
                    </h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <form id="crearEmpresaForm" method="post" action="/Empresa/CrearEmpresa" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-8">
                        <div class="bf-section">@Resources.Strings.Emp_SecIdentificacion</div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="crearNombre">@Resources.Strings.Emp_LabelNombre <span class="required">*</span></label>
                                <div class="bf-input"><i class="fas fa-building"></i>
                                    <input type="text" required placeholder="@Resources.Strings.Emp_PlaceholderNombre" class="form-control" id="crearNombre" name="Nombre" />
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="crearAbreviatura">@Resources.Strings.Emp_LabelAbreviatura <span class="required">*</span></label>
                                <div class="bf-input"><i class="fas fa-tag"></i>
                                    <input type="text" maxlength="12" pattern="[A-Za-z]{1,12}" required placeholder="@Resources.Strings.Emp_PlaceholderAbreviatura" oninput="this.value = this.value.replace(/[^A-Za-z]/g, '');" class="form-control" id="crearAbreviatura" name="Abreviatura" />
                                </div>
                                    <small class="form-text">@Resources.Strings.Emp_HintAbreviatura</small>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="crearNit">@Resources.Strings.Emp_LabelNit <span class="required">*</span></label>
                                <div class="bf-input"><i class="fas fa-id-card"></i>
                                    <input type="text" required placeholder="@Resources.Strings.Emp_PlaceholderNit" class="form-control" id="crearNit" name="Nit" />
                                </div>
                            </div>
                        </div>

                        <div class="bf-section">@Resources.Strings.Emp_SecContacto</div>
                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label for="crearDireccion">@Resources.Strings.Emp_LabelDireccion <span class="required">*</span></label>
                                <div class="bf-input"><i class="fas fa-map-marker-alt"></i>
                                    <input type="text" required placeholder="@Resources.Strings.Emp_PlaceholderDireccion" class="form-control" id="crearDireccion" name="Direccion" />
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="crearTelefono">@Resources.Strings.Emp_LabelTelefono</label>
                                <div class="bf-input"><i class="fas fa-phone"></i>
                                    <input type="text" pattern="\d{7,15}" maxlength="15" title="Solo numeros, sin espacios ni guiones" placeholder="@Resources.Strings.Emp_PlaceholderTelefono" oninput="this.value = this.value.replace(/[^0-9]/g, '');" class="form-control" id="crearTelefono" name="Telefono" />
                                </div>
                            </div>
                            <div class="col-md-6 mb-1">
                                <label for="crearCorreo">@Resources.Strings.Emp_LabelCorreo</label>
                                <div class="bf-input"><i class="fas fa-envelope"></i>
                                    <input type="email" maxlength="150" placeholder="@Resources.Strings.Emp_PlaceholderCorreo" class="form-control" id="crearCorreo" name="Correo" />
                                </div>
                            </div>
                            <div class="col-md-6 mb-1">
                                <label for="crearPaginaWeb">@Resources.Strings.Emp_LabelPaginaWeb</label>
                                <div class="bf-input"><i class="fas fa-globe"></i>
                                    <input type="text" inputmode="url" autocomplete="url" maxlength="300" data-url-web="1" placeholder="@Resources.Strings.Emp_PlaceholderPaginaWeb" class="form-control" id="crearPaginaWeb" name="PaginaWeb" />
                                </div>
                            </div>
                        </div>
                            </div>
                            <div class="col-lg-4">
                        <div class="bf-section">@Resources.Strings.EmpLogo_ThLogo</div>
                        <div class="bf-logo-box" id="crearLogoDrop" tabindex="0" role="button" aria-label="@Resources.Strings.EmpLogo_Elegir">
                            <span class="emp-logo-plate" id="crearLogoPlate" hidden><img id="crearLogoImg" alt="@Resources.Strings.Common_LogoEmpresaAlt"></span>
                            <span class="bf-logo-vacio" id="crearLogoVacio"><i class="fas fa-cloud-upload-alt"></i>@Resources.Strings.EmpLogo_Elegir</span>
                        </div>
                        <div class="bf-logo-actions">
                            <button type="button" class="bf-btn-outline" id="crearLogoBtnSubir"><i class="fas fa-upload"></i><span id="crearLogoBtnTxt">@Resources.Strings.EmpLogo_BtnSubir</span></button>
                            <button type="button" class="bf-btn-icon-danger" id="crearLogoBtnQuitar" style="display:none;" title="@Resources.Strings.EmpLogo_BtnQuitar" aria-label="@Resources.Strings.EmpLogo_BtnQuitar"><i class="fas fa-trash-alt"></i></button>
                        </div>
                        <div class="bf-logo-msg" id="crearLogoMsg" role="status" aria-live="polite"></div>
                        <details class="emp-logo-reqs">
                            <summary>@Resources.Strings.EmpLogo_ReqTitulo</summary>
                            <div class="emp-logo-reqs-panel">
                                <p class="emp-logo-box-intro">@Resources.Strings.EmpLogo_Intro</p>
                                <ul>
                                    <li>@Resources.Strings.EmpLogo_Req_Formato</li>
                                    <li>@Resources.Strings.EmpLogo_Req_Peso</li>
                                    <li>@Resources.Strings.EmpLogo_Req_Tamano</li>
                                    <li>@Resources.Strings.EmpLogo_Req_Proporcion</li>
                                    <li>@Resources.Strings.EmpLogo_Req_Contenido</li>
                                    <li>@Resources.Strings.EmpLogo_Req_Guardado</li>
                                </ul>
                            </div>
                        </details>
                        <input type="file" id="crearLogoFile" name="logo" accept="image/png,image/jpeg" style="display:none;" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <span class="bf-footer-note"><b>*</b> @Resources.Strings.Common_CamposObligatorios</span>
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">@Resources.Strings.Layout_Cancel</button>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-plus-circle"></i> @Resources.Strings.Common_BtnCrear</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <script>
           const isMobile1 = window.innerWidth <= 768;
           Swal.fire({
               toast: true,
               position: isMobile1 ? 'top' : 'top-end',
               icon: 'error',
               title: '@TempData["ErrorMessage"]',
               showConfirmButton: false,
               timer: 3000,
               timerProgressBar: true,
               didOpen: (toast) => {
                   toast.addEventListener('mouseenter', Swal.stopTimer);
                   toast.addEventListener('mouseleave', Swal.resumeTimer);
               }
           });
        </script>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            const isMobile2 = window.innerWidth <= 768;
            Swal.fire({
                toast: true,
                position: isMobile2 ? 'top' : 'top-end',
                icon: 'success',
                title: '@TempData["SuccessMessage"]',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer);
                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                }
            });
        </script>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <script>
            const isMobile3 = window.innerWidth <= 768;
            Swal.fire({
                toast: true,
                position: isMobile3 ? 'top' : 'top-end',
                icon: 'info',
                title: '@TempData["InfoMessage"]',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer);
                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                }
            });
        </script>
    }

    <script>
        function setIdEmpresa(id) {
            document.getElementById("idEmpresa").value = id;
        }

        function setEditEmpresa(id, nombre, nit, direccion, telefono, correo, abreviatura, paginaWeb, logoVersion) {
            empLogoEstablecer(id, logoVersion);
            var sub = document.getElementById("editEmpresaSub");
            if (sub) sub.textContent = (nombre || '') + (nit ? ' \u2022 NIT ' + nit : '');
            document.getElementById("editIdEmpresa").value = id;
            document.getElementById("editNombre").value = nombre;
            document.getElementById("editNit").value = nit;
            document.getElementById("editDireccion").value = direccion;
            document.getElementById("editTelefono").value = telefono;
            document.getElementById("editCorreo").value = correo;
            document.getElementById("editAbreviatura").value = abreviatura || '';
            var web = document.getElementById("editPaginaWeb");
            web.value = paginaWeb || '';
            web.setCustomValidity('');
        }


        // ===== Logo de la empresa: subir / cambiar / quitar (AJAX; el servidor vuelve a validar y normaliza) =====
        var EMP_LOGO = {
            urlSubir: '@Url.Action("Subir", "EmpresaLogo")',
            urlQuitar: '@Url.Action("Eliminar", "EmpresaLogo")',
            urlVer: '@Url.Action("Ver", "EmpresaLogo")',
            maxBytes: @bufinscustomers.Helpers.EmpresaLogoHelper.MaxBytesArchivo,
            minAncho: @bufinscustomers.Helpers.EmpresaLogoHelper.MinAncho, minAlto: @bufinscustomers.Helpers.EmpresaLogoHelper.MinAlto,
            maxLado: @bufinscustomers.Helpers.EmpresaLogoHelper.MaxLado,
            ratioMin: @bufinscustomers.Helpers.EmpresaLogoHelper.RatioMin.ToString(System.Globalization.CultureInfo.InvariantCulture),
            ratioMax: @bufinscustomers.Helpers.EmpresaLogoHelper.RatioMax.ToString(System.Globalization.CultureInfo.InvariantCulture),
            t: {
                peso: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.EmpLogo_Err_Peso))',
                formato: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.EmpLogo_Err_Formato))',
                invalido: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.EmpLogo_Err_Invalido))',
                grande: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.EmpLogo_Err_Grande))',
                pequeno: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.EmpLogo_Err_Pequeno))',
                proporcion: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.EmpLogo_Err_Proporcion))',
                subiendo: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.EmpLogo_Subiendo))',
                subir: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.EmpLogo_BtnSubir))',
                cambiar: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.EmpLogo_BtnCambiar))',
                quitarTitulo: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.EmpLogo_ConfirmarQuitarTitulo))',
                quitarTexto: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.EmpLogo_ConfirmarQuitar))',
                quitarBtn: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.EmpLogo_BtnQuitar))',
                cancelar: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Layout_Cancel))',
                alt: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_LogoEmpresaAlt))'
            },
            idEmpresa: 0
        };

        function empLogoFmt(t) {
            var a = Array.prototype.slice.call(arguments, 1);
            return t.replace(/\{(\d+)\}/g, function (m, i) { return a[i] !== undefined ? a[i] : m; });
        }

        function empLogoMsg(texto, tipo) {
            var m = document.getElementById('empLogoMsg');
            m.textContent = texto || '';
            m.className = 'bf-logo-msg' + (tipo ? ' ' + tipo : '');
        }

        // Pinta el estado (con o sin logo) en la zona de carga del modal y en la miniatura de la tabla.
        function empLogoPintar(version) {
            var tiene = !!version;
            var plate = document.getElementById('empLogoPlate'), img = document.getElementById('empLogoImg');
            if (tiene) img.src = EMP_LOGO.urlVer + '?id=' + EMP_LOGO.idEmpresa + '&v=' + encodeURIComponent(version);
            else img.removeAttribute('src');
            plate.hidden = !tiene;
            document.getElementById('empLogoVacio').style.display = tiene ? 'none' : '';
            document.getElementById('empLogoBtnQuitar').style.display = tiene ? '' : 'none';
            document.getElementById('empLogoBtnTxt').textContent = tiene ? EMP_LOGO.t.cambiar : EMP_LOGO.t.subir;

            var celda = document.querySelector('[data-logo-empresa="' + EMP_LOGO.idEmpresa + '"]');
            if (celda) {
                celda.innerHTML = '';
                if (tiene) {
                    var sp = document.createElement('span'); sp.className = 'emp-logo-plate';
                    var im = document.createElement('img'); im.alt = EMP_LOGO.t.alt;
                    im.src = EMP_LOGO.urlVer + '?id=' + EMP_LOGO.idEmpresa + '&v=' + encodeURIComponent(version);
                    sp.appendChild(im); celda.appendChild(sp);
                } else {
                    var d = document.createElement('span'); d.className = 'text-muted'; d.textContent = '—'; celda.appendChild(d);
                }
            }
            // el botón "editar" de esa fila conserva el estado actual para cuando se vuelva a abrir el modal
            var fila = celda && celda.parentNode;
            var btn = fila && fila.querySelector('button[onclick^="setEditEmpresa"]');
            if (btn) {
                var oc = btn.getAttribute('onclick');
                btn.setAttribute('onclick', oc.replace(/, '[^']*'\)$/, ", '" + (version || '') + "')"));
            }
        }

        function empLogoEstablecer(idEmpresa, version) {
            EMP_LOGO.idEmpresa = idEmpresa;
            empLogoMsg('');
            document.getElementById('empLogoFile').value = '';
            empLogoPintar(version);
        }

        // Misma regla que EmpresaLogoHelper (el servidor sigue siendo la autoridad): avisa antes de subir.
        function empLogoValidar(archivo) {
            return new Promise(function (resolve) {
                var tipoOk = /^image\/(png|jpeg)$/.test(archivo.type) && /\.(png|jpe?g)$/i.test(archivo.name);
                if (!tipoOk) return resolve(EMP_LOGO.t.formato);
                if (archivo.size > EMP_LOGO.maxBytes) return resolve(empLogoFmt(EMP_LOGO.t.peso, Math.round(EMP_LOGO.maxBytes / 1048576)));
                var url = URL.createObjectURL(archivo), im = new Image();
                im.onload = function () {
                    URL.revokeObjectURL(url);
                    var w = im.naturalWidth, h = im.naturalHeight, r = w / h;
                    if (w > EMP_LOGO.maxLado || h > EMP_LOGO.maxLado) return resolve(empLogoFmt(EMP_LOGO.t.grande, EMP_LOGO.maxLado));
                    if (w < EMP_LOGO.minAncho || h < EMP_LOGO.minAlto) return resolve(empLogoFmt(EMP_LOGO.t.pequeno, EMP_LOGO.minAncho, EMP_LOGO.minAlto, w, h));
                    if (r < EMP_LOGO.ratioMin || r > EMP_LOGO.ratioMax) return resolve(empLogoFmt(EMP_LOGO.t.proporcion, w, h));
                    resolve(null);
                };
                im.onerror = function () { URL.revokeObjectURL(url); resolve(EMP_LOGO.t.invalido); };
                im.src = url;
            });
        }

        function empLogoToken() {
            var f = document.getElementById('editEmpresaForm');
            var t = f && f.querySelector('input[name="__RequestVerificationToken"]');
            return t ? t.value : '';
        }

        function empLogoSubir(archivo) {
            empLogoMsg(EMP_LOGO.t.subiendo);
            empLogoValidar(archivo).then(function (error) {
                if (error) { empLogoMsg(error, 'err'); return; }
                var fd = new FormData();
                fd.append('__RequestVerificationToken', empLogoToken());
                fd.append('idEmpresa', EMP_LOGO.idEmpresa);
                fd.append('archivo', archivo);
                fetch(EMP_LOGO.urlSubir, { method: 'POST', body: fd, credentials: 'same-origin' })
                    .then(function (r) { return r.json(); })
                    .then(function (j) {
                        if (!j.exito) { empLogoMsg(j.mensaje, 'err'); return; }
                        empLogoPintar(j.version);
                        empLogoMsg(j.aviso || j.mensaje, j.aviso ? 'aviso' : 'ok');
                    })
                    .catch(function () { empLogoMsg(EMP_LOGO.t.invalido, 'err'); });
            });
        }

        (function () {
            var file = document.getElementById('empLogoFile'), drop = document.getElementById('empLogoDrop');
            function elegir() { file.click(); }
            document.getElementById('empLogoBtnSubir').addEventListener('click', elegir);
            drop.addEventListener('click', elegir);
            drop.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); elegir(); } });
            file.addEventListener('change', function () { if (file.files && file.files[0]) empLogoSubir(file.files[0]); file.value = ''; });
            ['dragenter', 'dragover'].forEach(function (ev) { drop.addEventListener(ev, function (e) { e.preventDefault(); drop.classList.add('arrastrando'); }); });
            ['dragleave', 'drop'].forEach(function (ev) { drop.addEventListener(ev, function (e) { e.preventDefault(); drop.classList.remove('arrastrando'); }); });
            drop.addEventListener('drop', function (e) { var f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]; if (f) empLogoSubir(f); });

            document.getElementById('empLogoBtnQuitar').addEventListener('click', function () {
                Swal.fire({
                    icon: 'warning', title: EMP_LOGO.t.quitarTitulo, text: EMP_LOGO.t.quitarTexto,
                    showCancelButton: true, confirmButtonText: EMP_LOGO.t.quitarBtn, cancelButtonText: EMP_LOGO.t.cancelar
                }).then(function (r) {
                    if (!r.isConfirmed) return;
                    var fd = new FormData();
                    fd.append('__RequestVerificationToken', empLogoToken());
                    fd.append('idEmpresa', EMP_LOGO.idEmpresa);
                    fetch(EMP_LOGO.urlQuitar, { method: 'POST', body: fd, credentials: 'same-origin' })
                        .then(function (r2) { return r2.json(); })
                        .then(function (j) {
                            if (!j.exito) { empLogoMsg(j.mensaje, 'err'); return; }
                            empLogoPintar(null);
                            empLogoMsg(j.mensaje, 'ok');
                        });
                });
            });
        })();

        // Logo al CREAR la empresa: se elige y se previsualiza aquí; viaja en el mismo envío del formulario (el servidor lo valida antes de crear).
        (function () {
            var f = document.getElementById('crearLogoFile'), drop = document.getElementById('crearLogoDrop');
            var plate = document.getElementById('crearLogoPlate'), img = document.getElementById('crearLogoImg');
            var vacio = document.getElementById('crearLogoVacio'), quitar = document.getElementById('crearLogoBtnQuitar');
            var msg = document.getElementById('crearLogoMsg'), txt = document.getElementById('crearLogoBtnTxt');
            var urlActual = null;

            function mensaje(t, tipo) { msg.textContent = t || ''; msg.className = 'bf-logo-msg' + (tipo ? ' ' + tipo : ''); }
            function limpiar() {
                f.value = '';
                if (urlActual) { URL.revokeObjectURL(urlActual); urlActual = null; }
                img.removeAttribute('src'); plate.hidden = true; vacio.style.display = '';
                quitar.style.display = 'none'; txt.textContent = EMP_LOGO.t.subir; mensaje('');
            }
            function elegido() {
                var a = f.files && f.files[0];
                if (!a) return;
                empLogoValidar(a).then(function (error) {
                    if (error) { limpiar(); mensaje(error, 'err'); return; }
                    if (urlActual) URL.revokeObjectURL(urlActual);
                    urlActual = URL.createObjectURL(a);
                    img.src = urlActual; plate.hidden = false; vacio.style.display = 'none';
                    quitar.style.display = ''; txt.textContent = EMP_LOGO.t.cambiar; mensaje('');
                });
            }
            function abrir() { f.click(); }
            document.getElementById('crearLogoBtnSubir').addEventListener('click', abrir);
            drop.addEventListener('click', abrir);
            drop.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); abrir(); } });
            f.addEventListener('change', elegido);
            quitar.addEventListener('click', limpiar);
            ['dragenter', 'dragover'].forEach(function (ev) { drop.addEventListener(ev, function (e) { e.preventDefault(); drop.classList.add('arrastrando'); }); });
            ['dragleave', 'drop'].forEach(function (ev) { drop.addEventListener(ev, function (e) { e.preventDefault(); drop.classList.remove('arrastrando'); }); });
            drop.addEventListener('drop', function (e) {
                var a = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
                if (!a) return;
                try { var dt = new DataTransfer(); dt.items.add(a); f.files = dt.files; elegido(); } catch (x) { mensaje(EMP_LOGO.t.formato, 'err'); }
            });
            if (window.jQuery) jQuery('#crearEmpresaModal').on('hidden.bs.modal', function () { limpiar(); });
        })();

        // Página web: opcional, pero si se escribe debe ser una URL http/https válida (misma regla que UrlWebHelper en el servidor).
        (function () {
            var MSG = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Emp_ErrorPaginaWeb))';

            function normalizar(v) {
                var t = (v || '').trim();
                if (!t) return '';
                if (t.indexOf('://') < 0) t = 'https://' + t;
                return t;
            }
            function valida(v) {
                var t = normalizar(v);
                if (!t) return true;
                if (t.length > 300 || /[\s'"<>\\]/.test(t)) return false;
                var u;
                try { u = new URL(t); } catch (e) { return false; }
                if (u.protocol !== 'http:' && u.protocol !== 'https:') return false;
                if (u.username || u.password) return false;
                var h = u.hostname;
                var esIp = /^\d{1,3}(\.\d{1,3}){3}$/.test(h) || h.indexOf(':') >= 0;
                if (!esIp) {
                    var p = h.split('.');
                    if (p.length < 2) return false;
                    for (var i = 0; i < p.length; i++) {
                        if (!p[i] || p[i].charAt(0) === '-' || p[i].charAt(p[i].length - 1) === '-') return false;
                    }
                    if (p[p.length - 1].length < 2) return false;
                }
                return true;
            }

            document.querySelectorAll('input[data-url-web]').forEach(function (inp) {
                function revisar() { inp.setCustomValidity(valida(inp.value) ? '' : MSG); }
                inp.addEventListener('input', revisar);
                inp.addEventListener('blur', function () {
                    revisar();
                    // Si es válida y no trae esquema, se muestra ya con https:// (así se guarda).
                    if (inp.value.trim() && inp.validity.valid) inp.value = normalizar(inp.value);
                });
            });
        })();
    </script>
</body>
</html>
