@model IEnumerable<bufinscustomers.Models.Empresas>
@using bufinscustomers.Helpers

<!DOCTYPE html>
<html>
<head>
    <title>@Resources.Strings.Emp_PageTitle</title>
    <script src="~/Assets/js/sweetalert2.all.min.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script src="~/Assets/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Assets/Scripts/bootstrap.bundle.min.js"></script>
</head>
<body>
    <style>
        :root {
            --color-primario: #583AFF;
            --color-secundario: #01E1D7;
        }

        .bg-primary {
            background-color: #583AFF !important;
        }

        /* === TABLA COMPACTA === */
        .table-wrapper {
            max-height: 400px;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .table-compact {
            table-layout: fixed;
            width: 100%;
            margin-bottom: 0;
        }

        .table-compact thead th {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            color: #555;
            padding: 0.5rem 0.4rem;
            white-space: nowrap;
            border-bottom: 2px solid #dee2e6;
            background-color: #f8f9fa;
            position: sticky;
            top: 0;
            z-index: 1;
        }

        .table-compact tbody td {
            font-size: 0.8rem;
            padding: 0.35rem 0.4rem;
            vertical-align: middle;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .table-compact tbody tr:hover {
            background-color: #f0edff;
        }

        /* Anchos de columna */
        .table-compact .col-id { width: 5%; text-align: center; }
        .table-compact .col-abreviatura { width: 10%; text-align: center; }
        .table-compact .col-nombre { width: 17%; }
        .table-compact .col-nit { width: 12%; }
        .table-compact .col-direccion { width: 15%; }
        .table-compact .col-telefono { width: 10%; }
        .table-compact .col-correo { width: 19%; }
        .table-compact .col-acciones { width: 12%; text-align: center; white-space: nowrap; }

        /* === BOTONES DE ACCIONES === */
        .btn-group {
            gap: 0.25rem;
        }

        .btn-group .btn {
            padding: 0.2rem 0.45rem;
            font-size: 0.75rem;
            border-radius: 0.25rem;
        }

        .btn-group .btn i {
            margin-right: 0;
        }

        /* === BUSCADOR === */
        .gestor-search-bar { padding: .55rem 1rem; background: #f8f9fa; border-bottom: 1px solid #e9ecef; }
        .gestor-search-wrapper { position: relative; max-width: 300px; }
        .gestor-search-icon { position: absolute; left: .65rem; top: 50%; transform: translateY(-50%); color: #9ca3af; font-size: .72rem; pointer-events: none; }
        .gestor-search-input { width: 100%; padding: .36rem .75rem .36rem 2rem; font-size: .8rem; border: 1px solid #dee2e6; border-radius: 6px; outline: none; transition: border-color .15s, box-shadow .15s; background: #fff; color: #374151; }
        .gestor-search-input:focus { border-color: #583AFF; box-shadow: 0 0 0 3px rgba(88,58,255,.12); }
        .gestor-search-input::placeholder { color: #b0b7c3; }

        /* === PAGINACIÓN === */
        .gestor-pagination { padding: .45rem 1rem; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #e9ecef; background: #fafafa; }
        .gestor-pag-info { font-size: .74rem; color: #6b7280; font-weight: 500; }
        .gestor-pag-controls { display: flex; align-items: center; gap: .3rem; }
        .gestor-pag-btn { width: 28px; height: 28px; border-radius: 6px; border: 1px solid #dee2e6; background: #fff; color: #583AFF; font-size: .7rem; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all .15s; padding: 0; }
        .gestor-pag-btn:hover:not(:disabled) { background: linear-gradient(90deg,#583AFF,#01E1D7); border-color: transparent; color: #fff; transform: scale(1.08); }
        .gestor-pag-btn:disabled { opacity: .35; cursor: not-allowed; color: #9ca3af; }
        .gestor-pag-num { font-size: .74rem; font-weight: 600; color: #374151; min-width: 62px; text-align: center; }
    </style>

    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas fa-building powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@Resources.Strings.Emp_PageTitle</h1>
        </div>
    </div>

    <div class="card shadow mb-4 mt-4">
        <div class="card-body p-0">
            <div class="gestor-search-bar">
                <div class="gestor-search-wrapper">
                    <i class="fas fa-search gestor-search-icon"></i>
                    <input type="text" id="buscarEmpresa" class="gestor-search-input"
                           placeholder="@Resources.Strings.Layout_SearchPlaceholder">
                </div>
            </div>
            <div class="table-responsive table-wrapper">
                <table id="tablaEmpresas" class="table table-bordered table-hover table-compact">
                    <thead>
                        <tr>
                            <th class="col-id">Id</th>
                            <th class="col-abreviatura">@Resources.Strings.Emp_ThAbreviatura</th>
                            <th class="col-nombre">@Resources.Strings.Emp_ThNombre</th>
                            <th class="col-nit">@Resources.Strings.Emp_ThNit</th>
                            <th class="col-direccion">@Resources.Strings.Emp_ThDireccion</th>
                            <th class="col-telefono">@Resources.Strings.Emp_ThTelefono</th>
                            <th class="col-correo">@Resources.Strings.Emp_ThCorreo</th>
                            <th class="col-acciones">@Resources.Strings.Common_ThAcciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var empresa in Model)
                        {
                            <tr>
                                <td class="col-id">@empresa.Id</td>
                                <td class="col-abreviatura">
                                    @if (!string.IsNullOrEmpty(empresa.Abreviatura))
                                    {
                                        <span style="background:var(--app-btn-gradient);color:white;padding:0.15rem 0.55rem;border-radius:9999px;font-size:0.75rem;font-weight:600;letter-spacing:0.5px;">@empresa.Abreviatura</span>
                                    }
                                </td>
                                <td class="col-nombre" title="@empresa.Nombre">@empresa.Nombre</td>
                                <td class="col-nit">@empresa.Nit</td>
                                <td class="col-direccion" title="@empresa.Direccion">@empresa.Direccion</td>
                                <td class="col-telefono">@empresa.Telefono</td>
                                <td class="col-correo" title="@empresa.Correo">@empresa.Correo</td>
                                <td class="col-acciones">
                                    <div class="btn-group" role="group" aria-label="@Resources.Strings.Common_ThAcciones">
                                        <button type="button" class="btn btn-sm btn-primary" title="@Resources.Strings.Emp_TitleEditar" data-toggle="modal" data-target="#editEmpresaModal"
                                                onclick="setEditEmpresa(@empresa.Id, '@empresa.Nombre', '@empresa.Nit', '@empresa.Direccion', '@empresa.Telefono', '@empresa.Correo', '@empresa.Abreviatura')">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        @if (UsuarioSesionHelper.EsSuperAdmin())
                                        {
                                            <button type="button" class="btn btn-sm btn-danger" title="@Resources.Strings.Emp_TitleEliminar" data-toggle="modal" data-target="#confirmDeleteModal" onclick="setIdEmpresa(@empresa.Id)">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="gestor-pagination">
                <span class="gestor-pag-info" id="emp-info"></span>
                <div class="gestor-pag-controls">
                    <button class="gestor-pag-btn" id="emp-prev" onclick="empCambiarPagina(-1)">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <span class="gestor-pag-num" id="emp-pagnum"></span>
                    <button class="gestor-pag-btn" id="emp-next" onclick="empCambiarPagina(1)">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
            </div>
        </div>
        <script>
        (function () {
            var POR_PAGINA = 15;
            var paginaActual = 1;
            var filasFiltradas = [];

            function todasLasFilas() {
                return Array.from(document.querySelectorAll('#tablaEmpresas tbody tr'));
            }

            function aplicarFiltro() {
                var q = (document.getElementById('buscarEmpresa').value || '').toLowerCase().trim();
                filasFiltradas = todasLasFilas().filter(function (r) {
                    return !q || r.textContent.toLowerCase().indexOf(q) !== -1;
                });
                paginaActual = 1;
                renderizar();
            }

            function renderizar() {
                var inicio = (paginaActual - 1) * POR_PAGINA;
                var fin = inicio + POR_PAGINA;
                var totalPaginas = Math.max(1, Math.ceil(filasFiltradas.length / POR_PAGINA));

                todasLasFilas().forEach(function (r) { r.style.display = 'none'; });
                filasFiltradas.slice(inicio, fin).forEach(function (r) { r.style.display = ''; });

                document.getElementById('emp-info').textContent =
                    filasFiltradas.length + ' @Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_RegistrosPag)) ' + paginaActual + ' / ' + totalPaginas;
                document.getElementById('emp-prev').disabled = paginaActual <= 1;
                document.getElementById('emp-next').disabled = paginaActual >= totalPaginas;
            }

            window.empCambiarPagina = function (dir) {
                var totalPaginas = Math.max(1, Math.ceil(filasFiltradas.length / POR_PAGINA));
                paginaActual = Math.min(totalPaginas, Math.max(1, paginaActual + dir));
                renderizar();
            };

            document.getElementById('buscarEmpresa').addEventListener('input', aplicarFiltro);
            aplicarFiltro();
        })();
        </script>
        @if (UsuarioSesionHelper.EsSuperAdmin())
        {
        <div class="card-footer">
            <button type="button" class="btn-modern-success" data-toggle="modal" data-target="#crearEmpresaModal">
                <i class="fas fa-plus-circle mr-1"></i> @Resources.Strings.Emp_BtnCrear
            </button>
        </div>
        }
        </div>
    </div>

    <!-- Modal de confirmacion -->
    <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="confirmDeleteModalLabel">
                        <i class="fas fa-exclamation-triangle"></i> @Resources.Strings.Emp_ModalDeleteTitle
                    </h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0"><i class="fas fa-question-circle text-warning mr-2"></i>@Resources.Strings.Emp_ModalDeleteBody</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i>@Resources.Strings.Layout_Cancel
                    </button>
                    <form id="deleteForm" method="post" action="/Empresa/EliminarEmpresa" style="display: inline;">
    @Html.AntiForgeryToken()
                        <input type="hidden" id="idEmpresa" name="idEmpresa" />
                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="fas fa-trash-alt mr-1"></i>@Resources.Strings.Common_BtnEliminar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de edicion -->
    <div class="modal fade" id="editEmpresaModal" tabindex="-1" aria-labelledby="editEmpresaModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editEmpresaModalLabel">
                        <i class="fas fa-building"></i> @Resources.Strings.Emp_ModalEditTitle
                    </h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <form id="editEmpresaForm" method="post" action="/Empresa/EditarEmpresa">
    @Html.AntiForgeryToken()
                    <input type="hidden" id="editIdEmpresa" name="Id" />
                    <div class="modal-body">
                        <div class="mb-3 mt-3">
                            <label for="editNombre" class="form-label">
                                <i class="fas fa-building mr-2" style="color: #583AFF;"></i>@Resources.Strings.Emp_LabelNombre
                            </label>
                            <input type="text" class="form-control form-control-sm" id="editNombre" name="Nombre" required />
                        </div>
                        <div class="mb-3">
                            <label for="editNit" class="form-label">
                                <i class="fas fa-id-card mr-2" style="color: #583AFF;"></i>@Resources.Strings.Emp_LabelNit
                            </label>
                            <input type="text" class="form-control form-control-sm" id="editNit" name="Nit" required />
                        </div>
                        <div class="mb-3">
                            <label for="editDireccion" class="form-label">
                                <i class="fas fa-map-marker-alt mr-2" style="color: #583AFF;"></i>@Resources.Strings.Emp_LabelDireccion
                            </label>
                            <input type="text" class="form-control form-control-sm" id="editDireccion" name="Direccion" required />
                        </div>
                        <div class="mb-3">
                            <label for="editTelefono" class="form-label">
                                <i class="fas fa-phone mr-2" style="color: #583AFF;"></i>@Resources.Strings.Emp_LabelTelefono
                            </label>
                            <input type="text" class="form-control form-control-sm" id="editTelefono" name="Telefono" pattern="\d{7,15}" maxlength="15" title="Solo numeros, sin espacios ni guiones" oninput="this.value = this.value.replace(/[^0-9]/g, '');" />
                        </div>
                        <div class="mb-3">
                            <label for="editCorreo" class="form-label">
                                <i class="fas fa-envelope mr-2" style="color: #583AFF;"></i>@Resources.Strings.Emp_LabelCorreo
                            </label>
                            <input type="email" class="form-control form-control-sm" id="editCorreo" name="Correo" maxlength="150" />
                        </div>
                        <div class="mb-3">
                            <label for="editAbreviatura" class="form-label">
                                <i class="fas fa-tag mr-2" style="color: #583AFF;"></i>@Resources.Strings.Emp_LabelAbreviatura
                            </label>
                            <input type="text" class="form-control form-control-sm" id="editAbreviatura" name="Abreviatura"
                                   maxlength="12" pattern="[A-Za-z]{1,12}" required
                                   placeholder="@Resources.Strings.Emp_HintAbreviatura"
                                   oninput="this.value = this.value.replace(/[^A-Za-z]/g, '');" />
                            <small class="form-text text-muted">@Resources.Strings.Emp_HintAbreviatura</small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                            <i class="fas fa-times mr-1"></i>@Resources.Strings.Layout_Cancel
                        </button>
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fas fa-save mr-1"></i>@Resources.Strings.Common_GuardarCambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal de Creacion -->
    <div class="modal fade" id="crearEmpresaModal" tabindex="-1" aria-labelledby="crearEmpresaModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="crearEmpresaModalLabel">
                        <i class="fas fa-plus-circle"></i> @Resources.Strings.Emp_ModalCreateTitle
                    </h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <form id="crearEmpresaForm" method="post" action="/Empresa/CrearEmpresa">
    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="mb-3 mt-3">
                            <label for="crearNombre" class="form-label">
                                <i class="fas fa-building mr-2" style="color: #583AFF;"></i>@Resources.Strings.Emp_LabelNombre
                            </label>
                            <input type="text" class="form-control form-control-sm" id="crearNombre" name="Nombre" required />
                        </div>
                        <div class="mb-3">
                            <label for="crearNit" class="form-label">
                                <i class="fas fa-id-card mr-2" style="color: #583AFF;"></i>@Resources.Strings.Emp_LabelNit
                            </label>
                            <input type="text" class="form-control form-control-sm" id="crearNit" name="Nit" required />
                        </div>
                        <div class="mb-3">
                            <label for="crearDireccion" class="form-label">
                                <i class="fas fa-map-marker-alt mr-2" style="color: #583AFF;"></i>@Resources.Strings.Emp_LabelDireccion
                            </label>
                            <input type="text" class="form-control form-control-sm" id="crearDireccion" name="Direccion" required />
                        </div>
                        <div class="mb-3">
                            <label for="crearTelefono" class="form-label">
                                <i class="fas fa-phone mr-2" style="color: #583AFF;"></i>@Resources.Strings.Emp_LabelTelefono
                            </label>
                            <input type="text" class="form-control form-control-sm" id="crearTelefono" name="Telefono" pattern="\d{7,15}" maxlength="15" title="Solo numeros, sin espacios ni guiones" oninput="this.value = this.value.replace(/[^0-9]/g, '');" />
                        </div>
                        <div class="mb-3">
                            <label for="crearCorreo" class="form-label">
                                <i class="fas fa-envelope mr-2" style="color: #583AFF;"></i>@Resources.Strings.Emp_LabelCorreo
                            </label>
                            <input type="email" class="form-control form-control-sm" id="crearCorreo" name="Correo" maxlength="150" />
                        </div>
                        <div class="mb-3">
                            <label for="crearAbreviatura" class="form-label">
                                <i class="fas fa-tag mr-2" style="color: #583AFF;"></i>@Resources.Strings.Emp_LabelAbreviatura
                            </label>
                            <input type="text" class="form-control form-control-sm" id="crearAbreviatura" name="Abreviatura"
                                   maxlength="12" pattern="[A-Za-z]{1,12}" required
                                   placeholder="@Resources.Strings.Emp_HintAbreviatura"
                                   oninput="this.value = this.value.replace(/[^A-Za-z]/g, '');" />
                            <small class="form-text text-muted">@Resources.Strings.Emp_HintAbreviatura</small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                            <i class="fas fa-times mr-1"></i>@Resources.Strings.Layout_Cancel
                        </button>
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fas fa-plus-circle mr-1"></i>@Resources.Strings.Common_BtnCrear
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <script>
           const isMobile1 = window.innerWidth <= 768;
           Swal.fire({
               toast: true,
               position: isMobile1 ? 'top' : 'top-end',
               icon: 'error',
               title: '@TempData["ErrorMessage"]',
               showConfirmButton: false,
               timer: 3000,
               timerProgressBar: true,
               didOpen: (toast) => {
                   toast.addEventListener('mouseenter', Swal.stopTimer);
                   toast.addEventListener('mouseleave', Swal.resumeTimer);
               }
           });
        </script>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            const isMobile2 = window.innerWidth <= 768;
            Swal.fire({
                toast: true,
                position: isMobile2 ? 'top' : 'top-end',
                icon: 'success',
                title: '@TempData["SuccessMessage"]',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer);
                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                }
            });
        </script>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <script>
            const isMobile3 = window.innerWidth <= 768;
            Swal.fire({
                toast: true,
                position: isMobile3 ? 'top' : 'top-end',
                icon: 'info',
                title: '@TempData["InfoMessage"]',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer);
                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                }
            });
        </script>
    }

    <script>
        function setIdEmpresa(id) {
            document.getElementById("idEmpresa").value = id;
        }

        function setEditEmpresa(id, nombre, nit, direccion, telefono, correo, abreviatura) {
            document.getElementById("editIdEmpresa").value = id;
            document.getElementById("editNombre").value = nombre;
            document.getElementById("editNit").value = nit;
            document.getElementById("editDireccion").value = direccion;
            document.getElementById("editTelefono").value = telefono;
            document.getElementById("editCorreo").value = correo;
            document.getElementById("editAbreviatura").value = abreviatura || '';
        }
    </script>
</body>
</html>
