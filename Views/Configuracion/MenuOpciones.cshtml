﻿@model IEnumerable<bufinscustomers.Models.MenuOpciones>
@using bufinscustomers.Helpers
@using System.Web.Script.Serialization

<!DOCTYPE html>
<html>
<head>
    <title>@Resources.Strings.Menu_PageTitle</title>
    <script src="~/Assets/js/sweetalert2.all.min.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body>

@{
    var successMsg = TempData["SuccessMessage"] as string;
    var errorMsg   = TempData["ErrorMessage"]   as string;
    var infoMsg    = TempData["InfoMessage"]     as string;

    var jss = new JavaScriptSerializer();

    var opcionesJson = jss.Serialize(Model.Select(o => new {
        o.Id, o.Codigo, o.Nombre, o.NombreEN, o.Descripcion, o.Icono, o.Orden,
        o.Controller, o.Action, o.IdGrupo, o.IdCategoria, o.NombreGrupo, o.Categoria,
        o.SoloSuperAdmin, o.SoloAdminEmpresa, o.EsDestacado
    }));

    var grupos     = ViewBag.Grupos     as List<bufinscustomers.Models.GrupoMenu>     ?? new List<bufinscustomers.Models.GrupoMenu>();
    var categorias = ViewBag.Categorias as List<bufinscustomers.Models.CategoriaMenu> ?? new List<bufinscustomers.Models.CategoriaMenu>();

    var gruposJson     = jss.Serialize(grupos.Select(g     => new { g.Id, g.Nombre, g.Icono, g.IdCategoria, g.NombreCategoria }));
    var categoriasJson = jss.Serialize(categorias.Select(c => new { c.Id, c.Nombre }));

    // Paleta de colores por categoría — ayuda a identificar visualmente a qué categoría/grupo
    // pertenece cada fila y dónde son válidos los arrastres para reordenar.
    var paletaColores = new[] { "#583AFF", "#01E1D7", "#F59E0B", "#EC4899", "#10B981", "#3B82F6", "#8B5CF6", "#EF4444", "#14B8A6", "#F97316" };
    var categoriasOrdenadas = categorias.OrderBy(c => c.Orden).ToList();
    var catColores = new Dictionary<int, string>();
    for (int i = 0; i < categoriasOrdenadas.Count; i++)
    {
        catColores[categoriasOrdenadas[i].Id] = paletaColores[i % paletaColores.Length];
    }

    Func<int?, string> ColorCategoria = idCat => (idCat.HasValue && catColores.ContainsKey(idCat.Value)) ? catColores[idCat.Value] : "#9ca3af";
}

@if (!string.IsNullOrEmpty(successMsg))
{
    <script>
        Swal.fire({ toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end', icon: 'success', title: '@Html.Raw(successMsg.Replace("'", "\\'"))', showConfirmButton: false, timer: 3000, timerProgressBar: true });
    </script>
}
@if (!string.IsNullOrEmpty(errorMsg))
{
    <script>
        Swal.fire({ toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end', icon: 'error', title: '@Html.Raw(errorMsg.Replace("'", "\\'"))', showConfirmButton: false, timer: 3000, timerProgressBar: true });
    </script>
}
@if (!string.IsNullOrEmpty(infoMsg))
{
    <script>
        Swal.fire({ toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end', icon: 'info', title: '@Html.Raw(infoMsg.Replace("'", "\\'"))', showConfirmButton: false, timer: 3000, timerProgressBar: true });
    </script>
}

<style>
    :root { --color-primario: #583AFF; --color-secundario: #01E1D7; }
    .table-wrapper { max-height: 500px; overflow-y: auto; overflow-x: hidden; }
    .table-compact { table-layout: fixed; width: 100%; margin-bottom: 0; }
    .table-compact thead th { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.3px; color: #fff; padding: 0.5rem 0.4rem; white-space: nowrap; border-bottom: 2px solid #dee2e6; background: var(--content-gradient); position: sticky; top: 0; z-index: 1; }
    .table-compact tbody td { font-size: 0.8rem; padding: 0.35rem 0.4rem; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .table-compact tbody tr:hover { background-color: #f0edff; }
    .table-compact .col-handle    { width: 3%;  text-align: center; cursor: grab; color: #9ca3af; }
    .table-compact .col-codigo    { width: 12%; }
    .table-compact .col-nombre    { width: 11%; }
    .table-compact .col-nombre-en { width: 11%; }
    .table-compact .col-categoria { width: 10%; }
    .table-compact .col-grupo     { width: 10%; }
    .table-compact .col-ruta      { width: 12%; }
    .table-compact .col-orden     { width: 4%;  text-align: center; }
    .table-compact .col-acceso    { width: 9%;  text-align: center; }
    .table-compact .col-destacado { width: 6%;  text-align: center; }
    .table-compact .col-acciones  { width: 12%; text-align: center; white-space: nowrap; }
    .badge-super      { background-color: #583AFF; color: white; padding: 2px 6px; border-radius: 4px; font-size: 0.7rem; font-weight: 500; }
    .badge-normal     { background-color: #6c757d; color: white; padding: 2px 6px; border-radius: 4px; font-size: 0.7rem; font-weight: 500; }
    .badge-admin-emp  { background-color: #f59e0b; color: white; padding: 2px 6px; border-radius: 4px; font-size: 0.7rem; font-weight: 500; }
    .badge-destacado  { background: linear-gradient(135deg,#583AFF,#01E1D7); color: white; padding: 2px 7px; border-radius: 4px; font-size: 0.7rem; font-weight: 600; }
    .check-dest-label { display:flex;align-items:center;gap:.4rem;padding:.55rem .85rem;border-radius:8px;border:1px solid rgba(88,58,255,.25);background:linear-gradient(90deg,rgba(88,58,255,.06),rgba(1,225,215,.04));cursor:pointer;transition:border-color .15s,background .15s }
    .check-dest-label:hover { border-color:rgba(1,225,215,.5);background:linear-gradient(90deg,rgba(88,58,255,.1),rgba(1,225,215,.07)) }
    .check-dest-icon { font-size:1rem;background:linear-gradient(135deg,#583AFF,#01E1D7);-webkit-background-clip:text;-webkit-text-fill-color:transparent }
    .btn-group { gap: 0.25rem; }
    .btn-group .btn { padding: 0.2rem 0.45rem; font-size: 0.75rem; border-radius: 0.25rem; }
    #tablaMenuOpciones tbody tr[draggable="true"] { transition: background-color .15s, opacity .15s; }
    #tablaMenuOpciones tbody tr.dragging-row { opacity: 0.4; }
    #tablaMenuOpciones tbody tr.drag-over-row { background-color: #ede9ff; }
    .cat-legend { display: flex; flex-wrap: wrap; gap: 4px 16px; margin: 0 0 .6rem; }
    .cat-legend-item { display: inline-flex; align-items: center; gap: 6px; font-size: 0.78rem; color: #4b5563; font-weight: 500; }
    .cat-legend-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; flex-shrink: 0; }
    .cat-badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: 600; color: #fff; white-space: nowrap; }
    .grupo-badge { display: inline-block; padding: 1px 7px; border-radius: 4px; font-size: 0.7rem; font-weight: 600; background: #fff; white-space: nowrap; }
</style>

<div class="powerbi-header">
    <div class="powerbi-header-content">
        <i class="fas fa-bars powerbi-header-icon"></i>
        <h1 class="powerbi-header-title">@Resources.Strings.Menu_PageTitle</h1>
    </div>
</div>

<p class="text-muted small mb-2"><i class="fas fa-arrows-alt mr-1"></i>@Resources.Strings.Menu_HintArrastrar</p>

<div class="cat-legend">
    @foreach (var cat in categoriasOrdenadas)
    {
        <span class="cat-legend-item"><span class="cat-legend-dot" style="background:@catColores[cat.Id];"></span>@cat.Nombre</span>
    }
</div>

<div class="card shadow mb-4 mt-4">
    <div class="card-body p-0">
        <div class="table-responsive table-wrapper">
            <table id="tablaMenuOpciones" class="table table-bordered table-hover table-compact">
                <thead>
                    <tr>
                        <th class="col-handle"></th>
                        <th class="col-codigo">@Resources.Strings.Menu_ThCodigo</th>
                        <th class="col-nombre">@Resources.Strings.Menu_ThNombre</th>
                        <th class="col-nombre-en">@Resources.Strings.Menu_ThNombreEN</th>
                        <th class="col-categoria">@Resources.Strings.Menu_ThCategoria</th>
                        <th class="col-grupo">@Resources.Strings.Menu_ThGrupo</th>
                        <th class="col-ruta">@Resources.Strings.Menu_ThRuta</th>
                        <th class="col-orden">@Resources.Strings.Menu_ThOrden</th>
                        <th class="col-acceso">@Resources.Strings.Menu_ThAcceso</th>
                        <th class="col-destacado">@Resources.Strings.Menu_ThDestacado</th>
                        <th class="col-acciones">@Resources.Strings.Common_ThAcciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="11" class="text-center text-muted py-3">@Resources.Strings.Menu_NoOpciones</td></tr>
                    }
                    @foreach (var opcion in Model)
                    {
                        var colorCat = ColorCategoria(opcion.IdCategoria);
                        <tr draggable="true" data-id="@opcion.Id">
                            <td class="col-handle" style="border-left:4px solid @colorCat;"><i class="fas fa-grip-vertical"></i></td>
                            <td class="col-codigo" title="@opcion.Codigo"><code style="font-size:0.75rem;">@opcion.Codigo</code></td>
                            <td class="col-nombre" title="@opcion.Nombre">@opcion.Nombre</td>
                            <td class="col-nombre-en" title="@opcion.NombreEN">@opcion.NombreEN</td>
                            <td class="col-categoria">
                                @if (!string.IsNullOrEmpty(opcion.Categoria))
                                {
                                    <span class="cat-badge" style="background:@colorCat;">@opcion.Categoria</span>
                                }
                            </td>
                            <td class="col-grupo" title="@opcion.NombreGrupo">
                                @if (!string.IsNullOrEmpty(opcion.NombreGrupo))
                                {
                                    <span class="grupo-badge" style="border:1px solid @colorCat;color:@colorCat;">@opcion.NombreGrupo</span>
                                }
                            </td>
                            <td class="col-ruta" title="@opcion.Controller / @opcion.Action">@opcion.Controller / @opcion.Action</td>
                            <td class="col-orden">@opcion.Orden</td>
                            <td class="col-acceso">
                                @if (opcion.SoloSuperAdmin)
                                {
                                    <span class="badge-super">@Resources.Strings.Menu_BadgeSuperAdmin</span>
                                }
                                else if (opcion.SoloAdminEmpresa)
                                {
                                    <span class="badge-admin-emp">@Resources.Strings.Menu_BadgeAdminEmp</span>
                                }
                                else
                                {
                                    <span class="badge-normal">@Resources.Strings.Menu_BadgeTodos</span>
                                }
                            </td>
                            <td class="col-destacado">
                                @if (opcion.EsDestacado)
                                {
                                    <span class="badge-destacado" title="@Resources.Strings.Menu_BadgeDestacado">&#9733;</span>
                                }
                            </td>
                            <td class="col-acciones">
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-sm btn-primary" title="@Resources.Strings.Menu_TitleEditar"
                                            data-toggle="modal" data-target="#editModal"
                                            onclick="cargarEditar(@opcion.Id)">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-danger" title="@Resources.Strings.Menu_TitleEliminar"
                                            onclick="confirmarEliminar(@opcion.Id)">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer">
        <button type="button" class="btn-modern-success" data-toggle="modal" data-target="#crearModal">
            <i class="fas fa-plus-circle mr-1"></i> @Resources.Strings.Menu_BtnCrear
        </button>
    </div>
</div>

<!-- Modal Crear -->
<div class="modal fade" id="crearModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-plus-circle"></i> @Resources.Strings.Menu_ModalCreateTitle</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <form method="post" action="/MenuOpciones/Crear">
    @Html.AntiForgeryToken()
                <div class="modal-body">
                    <small class="form-text text-muted mb-3 d-block"><span style="color:#ef4444;font-weight:700;">*</span> @Resources.Strings.Common_CamposObligatorios</small>
                    <!-- Fila 1: Código / Icono / Orden -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label><i class="fas fa-code mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_LabelCodigo <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" name="Codigo" required placeholder="Ej: DATOS_NUEVA_OPCION" />
                            <small class="form-text text-muted">@Resources.Strings.Menu_HintCodigo</small>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label><i class="fas fa-icons mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_LabelIcono</label>
                            <input type="text" class="form-control form-control-sm" name="Icono" placeholder="fas fa-icon" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label><i class="fas fa-sort-numeric-up mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_LabelOrden</label>
                            <input type="number" class="form-control form-control-sm" name="Orden" value="0" min="0" />
                            <small class="form-text text-muted">@Resources.Strings.Menu_HintOrden</small>
                        </div>
                    </div>
                    <!-- Fila 2: Nombre ES / Nombre EN (pareados) -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label><i class="fas fa-tag mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_LabelNombre <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" name="Nombre" required placeholder="@Resources.Strings.Menu_PlaceholderNombre" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label><i class="fas fa-globe mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_LabelNombreEN</label>
                            <input type="text" class="form-control form-control-sm" name="NombreEN" id="nombreEN" placeholder="@Resources.Strings.Menu_PlaceholderNombreEN" />
                        </div>
                    </div>
                    <!-- Fila 3: Descripción -->
                    <div class="mb-3">
                        <label><i class="fas fa-align-left mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_LabelDescripcion</label>
                        <input type="text" class="form-control form-control-sm" name="Descripcion" placeholder="@Resources.Strings.Menu_PlaceholderDescripcion" />
                    </div>
                    <!-- Fila 4: Controller / Action -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label><i class="fas fa-sitemap mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_LabelController <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" name="Controller" required placeholder="@Resources.Strings.Menu_PlaceholderController" />
                            <small class="form-text text-muted">@Resources.Strings.Menu_HintController</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label><i class="fas fa-play mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_LabelAction <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" name="Action" required placeholder="@Resources.Strings.Menu_PlaceholderAction" />
                            <small class="form-text text-muted">@Resources.Strings.Menu_HintAction</small>
                        </div>
                    </div>
                    <hr />
                    <p class="text-muted mb-2"><small><i class="fas fa-columns mr-1"></i>@Resources.Strings.Menu_SidebarLocation</small></p>
                    <!-- Fila 5: Categoría / Grupo -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label><i class="fas fa-folder mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_LabelCategoria <span class="text-danger">*</span></label>
                            <select class="form-control form-control-sm" id="crearCategoria" onchange="filtrarGrupos('crear')" required>
                                <option value="">@Resources.Strings.Menu_SelCategoria</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label><i class="fas fa-layer-group mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_LabelGrupo</label>
                            <select class="form-control form-control-sm" id="crearGrupoSelect" onchange="seleccionarGrupo(this, 'crear')">
                                <option value="">@Resources.Strings.Menu_SelGrupo</option>
                            </select>
                            <input type="hidden" id="crearIdGrupo" name="IdGrupo" value="" />
                            <input type="hidden" id="crearIdCategoria" name="IdCategoria" value="" />
                        </div>
                    </div>
                    <!-- Fila 6: Permisos lado a lado -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="SoloSuperAdmin" value="true" id="crearSoloSuperAdmin" />
                                <input type="hidden" name="SoloSuperAdmin" value="false" />
                                <label class="form-check-label" for="crearSoloSuperAdmin">
                                    <i class="fas fa-shield-alt text-danger mr-1"></i> @Resources.Strings.Menu_LabelSoloSuperAdmin
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="SoloAdminEmpresa" value="true" id="crearSoloAdminEmpresa" />
                                <input type="hidden" name="SoloAdminEmpresa" value="false" />
                                <label class="form-check-label" for="crearSoloAdminEmpresa">
                                    <i class="fas fa-building text-warning mr-1"></i> @Resources.Strings.Menu_LabelSoloAdminEmpresa
                                </label>
                            </div>
                        </div>
                    </div>
                    <!-- Fila 7: Menú destacado -->
                    <div class="row mt-2">
                        <div class="col-12">
                            <label class="check-dest-label" for="crearEsDestacado">
                                <input type="checkbox" name="EsDestacado" value="true" id="crearEsDestacado" style="display:none" />
                                <input type="hidden" name="EsDestacado" value="false" />
                                <i class="fas fa-star check-dest-icon"></i>
                                <span><strong>@Resources.Strings.Menu_LabelEsDestacado</strong> &mdash; <small class="text-muted">@Resources.Strings.Menu_LabelEsDestacadoDesc</small></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i>@Resources.Strings.Layout_Cancel
                    </button>
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus-circle mr-1"></i>@Resources.Strings.Common_BtnCrear
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Editar -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-edit"></i> @Resources.Strings.Menu_ModalEditTitle</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <form method="post" action="/MenuOpciones/Editar">
    @Html.AntiForgeryToken()
                <input type="hidden" id="editId" name="Id" />
                <div class="modal-body">
                    <small class="form-text text-muted mb-3 d-block"><span style="color:#ef4444;font-weight:700;">*</span> @Resources.Strings.Common_CamposObligatorios</small>
                    <!-- Fila 1: Código / Icono / Orden -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label><i class="fas fa-code mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_LabelCodigo <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" id="editCodigo" name="Codigo" required />
                            <small class="form-text text-muted">@Resources.Strings.Menu_HintCodigo</small>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label><i class="fas fa-icons mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_LabelIcono</label>
                            <input type="text" class="form-control form-control-sm" id="editIcono" name="Icono" placeholder="fas fa-icon" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label><i class="fas fa-sort-numeric-up mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_LabelOrden</label>
                            <input type="number" class="form-control form-control-sm" id="editOrden" name="Orden" min="0" />
                            <small class="form-text text-muted">@Resources.Strings.Menu_HintOrden</small>
                        </div>
                    </div>
                    <!-- Fila 2: Nombre ES / Nombre EN (pareados) -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label><i class="fas fa-tag mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_LabelNombre <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" id="editNombre" name="Nombre" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label><i class="fas fa-globe mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_LabelNombreEN</label>
                            <input type="text" class="form-control form-control-sm" id="editNombreEN" name="NombreEN" />
                        </div>
                    </div>
                    <!-- Fila 3: Descripción -->
                    <div class="mb-3">
                        <label><i class="fas fa-align-left mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_LabelDescripcion</label>
                        <input type="text" class="form-control form-control-sm" id="editDescripcion" name="Descripcion" />
                    </div>
                    <!-- Fila 4: Controller / Action -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label><i class="fas fa-sitemap mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_LabelController <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" id="editController" name="Controller" required />
                            <small class="form-text text-muted">@Resources.Strings.Menu_HintController</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label><i class="fas fa-play mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_LabelAction <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" id="editAction" name="Action" required />
                            <small class="form-text text-muted">@Resources.Strings.Menu_HintAction</small>
                        </div>
                    </div>
                    <hr />
                    <p class="text-muted mb-2"><small><i class="fas fa-columns mr-1"></i>@Resources.Strings.Menu_SidebarLocation</small></p>
                    <!-- Fila 5: Categoría / Grupo -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label><i class="fas fa-folder mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_LabelCategoria <span class="text-danger">*</span></label>
                            <select class="form-control form-control-sm" id="editCategoria" onchange="filtrarGrupos('edit')" required>
                                <option value="">@Resources.Strings.Menu_SelCategoria</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label><i class="fas fa-layer-group mr-1" style="color:#583AFF"></i>@Resources.Strings.Menu_LabelGrupo</label>
                            <select class="form-control form-control-sm" id="editGrupoSelect" onchange="seleccionarGrupo(this, 'edit')">
                                <option value="">@Resources.Strings.Menu_SelGrupo</option>
                            </select>
                            <input type="hidden" id="editIdGrupo" name="IdGrupo" value="" />
                            <input type="hidden" id="editIdCategoria" name="IdCategoria" value="" />
                        </div>
                    </div>
                    <!-- Fila 6: Permisos lado a lado -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="SoloSuperAdmin" value="true" id="editSoloSuperAdmin" />
                                <input type="hidden" name="SoloSuperAdmin" value="false" />
                                <label class="form-check-label" for="editSoloSuperAdmin">
                                    <i class="fas fa-shield-alt text-danger mr-1"></i> @Resources.Strings.Menu_LabelSoloSuperAdmin
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="SoloAdminEmpresa" value="true" id="editSoloAdminEmpresa" />
                                <input type="hidden" name="SoloAdminEmpresa" value="false" />
                                <label class="form-check-label" for="editSoloAdminEmpresa">
                                    <i class="fas fa-building text-warning mr-1"></i> @Resources.Strings.Menu_LabelSoloAdminEmpresa
                                </label>
                            </div>
                        </div>
                    </div>
                    <!-- Fila 7: Menú destacado -->
                    <div class="row mt-2">
                        <div class="col-12">
                            <label class="check-dest-label" id="editDestacadoLabel" for="editEsDestacado">
                                <input type="checkbox" name="EsDestacado" value="true" id="editEsDestacado" style="display:none" />
                                <input type="hidden" name="EsDestacado" value="false" />
                                <i class="fas fa-star check-dest-icon"></i>
                                <span><strong>@Resources.Strings.Menu_LabelEsDestacado</strong> &mdash; <small class="text-muted">@Resources.Strings.Menu_LabelEsDestacadoDesc</small></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i>@Resources.Strings.Layout_Cancel
                    </button>
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="fas fa-save mr-1"></i>@Resources.Strings.Common_GuardarCambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Form eliminar oculto -->
<form id="frmElim" method="post" action="/MenuOpciones/Eliminar" style="display:none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="elimId" />
</form>

<script>
    var _opciones   = @Html.Raw(opcionesJson);
    var _grupos     = @Html.Raw(gruposJson);
    var _categorias = @Html.Raw(categoriasJson);

    var _menuMsg = {
        selCategoria: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Menu_SelCategoria))',
        selGrupo: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Menu_SelCategoria))',
        eliminarTitle: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Menu_SelCategoria))',
        eliminarText: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Menu_SelCategoria))',
        cancelar: '@Resources.Strings.Layout_Cancel',
        confirmarEliminar: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Menu_SelCategoria))'
    };

    function poblarCategorias(selectId, idCategoriaSeleccionada) {
        var sel = document.getElementById(selectId);
        sel.innerHTML = '<option value="">' + _menuMsg.selCategoria + '</option>';
        _categorias.forEach(function (c) {
            var opt = document.createElement('option');
            opt.value = c.Id;
            opt.textContent = c.Nombre;
            if (c.Id === idCategoriaSeleccionada) { opt.selected = true; }
            sel.appendChild(opt);
        });
    }

    function filtrarGrupos(prefijo) {
        var catId    = parseInt(document.getElementById(prefijo + 'Categoria').value) || 0;
        document.getElementById(prefijo + 'IdCategoria').value = catId || '';
        var grupoSel = document.getElementById(prefijo + 'GrupoSelect');
        grupoSel.innerHTML = '<option value="">' + _menuMsg.selGrupo + '</option>';
        _grupos.forEach(function (g) {
            if (g.IdCategoria === catId) {
                var opt = document.createElement('option');
                opt.value       = g.Id;
                opt.textContent = g.Nombre;
                grupoSel.appendChild(opt);
            }
        });
        document.getElementById(prefijo + 'IdGrupo').value = '';
    }

    function seleccionarGrupo(selectElem, prefijo) {
        var val = selectElem.options[selectElem.selectedIndex].value;
        document.getElementById(prefijo + 'IdGrupo').value = val || '';
    }

    function cargarEditar(id) {
        var o = null;
        for (var i = 0; i < _opciones.length; i++) {
            if (_opciones[i].Id === id) { o = _opciones[i]; break; }
        }
        if (!o) return;

        document.getElementById('editId').value          = o.Id;
        document.getElementById('editCodigo').value      = o.Codigo        || '';
        document.getElementById('editNombre').value      = o.Nombre        || '';
        document.getElementById('editNombreEN').value    = o.NombreEN      || '';
        document.getElementById('editDescripcion').value = o.Descripcion   || '';
        document.getElementById('editIcono').value       = o.Icono         || '';
        document.getElementById('editOrden').value       = o.Orden         || 0;
        document.getElementById('editController').value  = o.Controller    || '';
        document.getElementById('editAction').value      = o.Action        || '';
        document.getElementById('editSoloSuperAdmin').checked   = o.SoloSuperAdmin;
        document.getElementById('editSoloAdminEmpresa').checked = o.SoloAdminEmpresa;
        document.getElementById('editEsDestacado').checked      = o.EsDestacado;
        actualizarEstiloDestacado('editDestacadoLabel', o.EsDestacado);

        var idCat = o.IdCategoria || 0;
        if (!idCat && o.IdGrupo) {
            for (var j = 0; j < _grupos.length; j++) {
                if (_grupos[j].Id === o.IdGrupo) { idCat = _grupos[j].IdCategoria; break; }
            }
        }
        poblarCategorias('editCategoria', idCat);
        filtrarGrupos('edit'); // también actualiza editIdCategoria

        if (o.IdGrupo) {
            var grupoSel = document.getElementById('editGrupoSelect');
            for (var k = 0; k < grupoSel.options.length; k++) {
                if (parseInt(grupoSel.options[k].value) === o.IdGrupo) {
                    grupoSel.selectedIndex = k;
                    seleccionarGrupo(grupoSel, 'edit');
                    break;
                }
            }
        }
    }

    function confirmarEliminar(id) {
        var o = null;
        for (var i = 0; i < _opciones.length; i++) {
            if (_opciones[i].Id === id) { o = _opciones[i]; break; }
        }
        var nombre = o ? o.Nombre : 'esta opcion';
        Swal.fire({
            title: _menuMsg.eliminarTitle,
            text: '"' + nombre + '" ' + _menuMsg.eliminarText,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#e74a3b',
            cancelButtonText: _menuMsg.cancelar,
            confirmButtonText: _menuMsg.confirmarEliminar
        }).then(function (r) {
            if (r.isConfirmed) {
                document.getElementById('elimId').value = id;
                document.getElementById('frmElim').submit();
            }
        });
    }

    function actualizarEstiloDestacado(labelId, activo) {
        var lbl = document.getElementById(labelId);
        if (!lbl) return;
        if (activo) {
            lbl.style.borderColor = 'rgba(1,225,215,.6)';
            lbl.style.background  = 'linear-gradient(90deg,rgba(88,58,255,.14),rgba(1,225,215,.09))';
        } else {
            lbl.style.borderColor = '';
            lbl.style.background  = '';
        }
    }

    // ───────────── Drag & drop para reordenar (columna Orden) ─────────────
    var _dragSrcRow = null;

    function initDragOrden() {
        var tbody = document.querySelector('#tablaMenuOpciones tbody');
        if (!tbody) return;

        Array.from(tbody.querySelectorAll('tr[draggable="true"]')).forEach(function (row) {
            row.addEventListener('dragstart', function () {
                _dragSrcRow = row;
                row.classList.add('dragging-row');
            });
            row.addEventListener('dragend', function () {
                row.classList.remove('dragging-row');
                tbody.querySelectorAll('.drag-over-row').forEach(function (r) { r.classList.remove('drag-over-row'); });
            });
            row.addEventListener('dragover', function (e) {
                e.preventDefault();
                if (!_dragSrcRow || _dragSrcRow === row) return;
                tbody.querySelectorAll('.drag-over-row').forEach(function (r) { r.classList.remove('drag-over-row'); });
                row.classList.add('drag-over-row');
                var bounding = row.getBoundingClientRect();
                var offset = e.clientY - bounding.top;
                if (offset > bounding.height / 2) {
                    row.parentNode.insertBefore(_dragSrcRow, row.nextSibling);
                } else {
                    row.parentNode.insertBefore(_dragSrcRow, row);
                }
            });
            row.addEventListener('drop', function (e) {
                e.preventDefault();
                row.classList.remove('drag-over-row');
                solicitarGuardarOrden();
            });
        });
    }

    // Debounce + guard: si el usuario arrastra varias filas seguidas, solo se
    // envía UNA petición a la vez y siempre con el estado final más reciente,
    // evitando que respuestas fuera de orden pisen un cambio más nuevo.
    var _guardarTimeout = null;
    var _guardandoOrden = false;
    var _reintentarAlTerminar = false;

    function solicitarGuardarOrden() {
        if (_guardarTimeout) clearTimeout(_guardarTimeout);
        _guardarTimeout = setTimeout(function () {
            if (_guardandoOrden) {
                _reintentarAlTerminar = true;
                return;
            }
            guardarNuevoOrden();
        }, 300);
    }

    function guardarNuevoOrden() {
        var tbody = document.querySelector('#tablaMenuOpciones tbody');
        var filas = Array.from(tbody.querySelectorAll('tr[data-id]'));
        if (filas.length === 0) return;

        var mapaOpciones = {};
        _opciones.forEach(function (o) { mapaOpciones[o.Id] = o; });

        // Secuencia global 1..N sobre TODOS los menús de la base de datos, sin importar
        // categoría/grupo: mover un menú recalcula el orden de todos los demás.
        var ids = [];
        var ordenes = [];

        filas.forEach(function (fila, idx) {
            var id = parseInt(fila.dataset.id);
            if (!mapaOpciones[id]) return;
            ids.push(id);
            ordenes.push(idx + 1);
        });

        _guardandoOrden = true;

        $.ajax({
            url: '@Url.Action("ActualizarOrden", "MenuOpciones")',
            type: 'POST',
            data: {
                ids: ids,
                ordenes: ordenes,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val()
            },
            traditional: true,
            success: function (response) {
                var icon = response.success ? 'success' : 'error';
                if (response.success) {
                    ids.forEach(function (id, idx) {
                        if (mapaOpciones[id]) mapaOpciones[id].Orden = ordenes[idx];
                    });
                    filas.forEach(function (fila) {
                        var id = parseInt(fila.dataset.id);
                        var celda = fila.querySelector('.col-orden');
                        if (celda && mapaOpciones[id]) celda.textContent = mapaOpciones[id].Orden;
                    });
                }
                Swal.fire({ toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end', icon: icon, title: response.message, showConfirmButton: false, timer: 2500, timerProgressBar: true });
            },
            error: function () {
                Swal.fire({ toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end', icon: 'error', title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Menu_ErrorActualizarOrden))', showConfirmButton: false, timer: 3000, timerProgressBar: true });
            },
            complete: function () {
                _guardandoOrden = false;
                if (_reintentarAlTerminar) {
                    _reintentarAlTerminar = false;
                    guardarNuevoOrden();
                }
            }
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        poblarCategorias('crearCategoria', _categorias.length > 0 ? _categorias[0].Id : 0);
        filtrarGrupos('crear');
        initDragOrden();

        // Toggle visual para los checkboxes de "Destacado"
        ['crearEsDestacado', 'editEsDestacado'].forEach(function (chkId) {
            var chk = document.getElementById(chkId);
            var lblId = chkId === 'crearEsDestacado' ? 'crearEsDestacado' : 'editDestacadoLabel';
            if (!chk) return;
            var lbl = chk.closest('label') || document.getElementById(lblId);
            if (lbl) {
                lbl.addEventListener('click', function () {
                    chk.checked = !chk.checked;
                    actualizarEstiloDestacado(lbl.id || lblId, chk.checked);
                });
            }
        });
    });
</script>
</body>
</html>
