<script>
    var _opciones   = @Html.Raw(opcionesJson);
    var _grupos     = @Html.Raw(gruposJson);
    var _categorias = @Html.Raw(categoriasJson);

    var _menuMsg = {
        selCategoria: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Menu_SelCategoria))',
        selGrupo: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Menu_SelGrupo))',
        eliminarTitle: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Menu_EliminarTitulo))',
        eliminarText: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Menu_EliminarTexto))',
        cancelar: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Layout_Cancel))',
        confirmarEliminar: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Menu_ConfirmarEliminar))',
        cuentaTodasFmt: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Menu_CuentaTodasFmt))',
        cuentaFiltradasFmt: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Menu_CuentaFiltradasFmt))',
        phGrupo: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Menu_PhGrupo))',
        hintOrdenar: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Menu_HintArrastrar))',
        hintFiltrando: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Menu_HintFiltrando))'
    };

    function poblarCategorias(selectId, idCategoriaSeleccionada) {
        var sel = document.getElementById(selectId);
        sel.innerHTML = '<option value="">' + _menuMsg.selCategoria + '</option>';
        _categorias.forEach(function (c) {
            var opt = document.createElement('option');
            opt.value = c.Id;
            opt.textContent = c.Nombre;
            if (c.Id === idCategoriaSeleccionada) { opt.selected = true; }
            sel.appendChild(opt);
        });
    }

    function filtrarGrupos(prefijo) {
        var catId    = parseInt(document.getElementById(prefijo + 'Categoria').value) || 0;
        document.getElementById(prefijo + 'IdCategoria').value = catId || '';
        var grupoSel = document.getElementById(prefijo + 'GrupoSelect');
        grupoSel.innerHTML = '<option value="">' + _menuMsg.selGrupo + '</option>';
        _grupos.forEach(function (g) {
            if (g.IdCategoria === catId) {
                var opt = document.createElement('option');
                opt.value       = g.Id;
                opt.textContent = g.Nombre;
                grupoSel.appendChild(opt);
            }
        });
        document.getElementById(prefijo + 'IdGrupo').value = '';
    }

    function seleccionarGrupo(selectElem, prefijo) {
        var val = selectElem.options[selectElem.selectedIndex].value;
        document.getElementById(prefijo + 'IdGrupo').value = val || '';
    }

    function cargarEditar(id) {
        var o = null;
        for (var i = 0; i < _opciones.length; i++) {
            if (_opciones[i].Id === id) { o = _opciones[i]; break; }
        }
        if (!o) return;

        document.getElementById('editId').value          = o.Id;
        document.getElementById('editCodigo').value      = o.Codigo        || '';
        document.getElementById('editNombre').value      = o.Nombre        || '';
        document.getElementById('editNombreEN').value    = o.NombreEN      || '';
        document.getElementById('editDescripcion').value = o.Descripcion   || '';
        document.getElementById('editIcono').value       = o.Icono         || '';
        document.getElementById('editOrden').value       = o.Orden         || 0;
        document.getElementById('editController').value  = o.Controller    || '';
        document.getElementById('editAction').value      = o.Action        || '';
        document.getElementById('editSoloSuperAdmin').checked   = o.SoloSuperAdmin;
        document.getElementById('editSoloAdminEmpresa').checked = o.SoloAdminEmpresa;
        document.getElementById('editEsDestacado').checked      = o.EsDestacado;
        var empSel = o.IdsEmpresas || [];
        document.querySelectorAll('.emp-chk-edit').forEach(function (chk) {
            chk.checked = empSel.indexOf(parseInt(chk.value, 10)) !== -1;
        });
        actualizarEstiloDestacado('editDestacadoLabel', o.EsDestacado);

        var idCat = o.IdCategoria || 0;
        if (!idCat && o.IdGrupo) {
            for (var j = 0; j < _grupos.length; j++) {
                if (_grupos[j].Id === o.IdGrupo) { idCat = _grupos[j].IdCategoria; break; }
            }
        }
        poblarCategorias('editCategoria', idCat);
        filtrarGrupos('edit'); // también actualiza editIdCategoria

        if (o.IdGrupo) {
            var grupoSel = document.getElementById('editGrupoSelect');
            for (var k = 0; k < grupoSel.options.length; k++) {
                if (parseInt(grupoSel.options[k].value) === o.IdGrupo) {
                    grupoSel.selectedIndex = k;
                    seleccionarGrupo(grupoSel, 'edit');
                    break;
                }
            }
        }
    }

    function confirmarEliminar(id) {
        var o = null;
        for (var i = 0; i < _opciones.length; i++) {
            if (_opciones[i].Id === id) { o = _opciones[i]; break; }
        }
        var nombre = o ? o.Nombre : 'esta opcion';
        Swal.fire({
            title: _menuMsg.eliminarTitle,
            text: '"' + nombre + '" ' + _menuMsg.eliminarText,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#e74a3b',
            cancelButtonText: _menuMsg.cancelar,
            confirmButtonText: _menuMsg.confirmarEliminar
        }).then(function (r) {
            if (r.isConfirmed) {
                document.getElementById('elimId').value = id;
                document.getElementById('frmElim').submit();
            }
        });
    }

    // ===== Habilitar para todos los usuarios =====
    // Los bindings de jQuery se registran dentro de DOMContentLoaded (más abajo), no aquí arriba: el
    // bundle de jQuery/Bootstrap se renderiza en _Layout DESPUÉS del cuerpo de esta vista, así que un
    // $(...) a nivel superior del script (ejecutado de inmediato al parsear la etiqueta) falla con
    // jQuery aún sin cargar. Las funciones (como confirmarEliminar) no tienen este problema porque su
    // cuerpo no corre hasta que se invocan (ya con la página totalmente cargada).
    var _habilitarTodosId = null;

    function actualizarEstiloDestacado(labelId, activo) {
        var lbl = document.getElementById(labelId);
        if (!lbl) return;
        if (activo) {
            lbl.style.borderColor = 'rgba(1,225,215,.6)';
            lbl.style.background  = 'linear-gradient(90deg,rgba(88,58,255,.14),rgba(1,225,215,.09))';
        } else {
            lbl.style.borderColor = '';
            lbl.style.background  = '';
        }
    }

    // ───────────── Filtros de la lista ─────────────
    function normalizarTexto(s) { return (s || '').toString().normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase(); }

    function estadoFiltros() {
        return {
            q: normalizarTexto(document.getElementById('mnBuscar').value.trim()),
            cat: document.getElementById('mnCategoria').value,
            grupo: document.getElementById('mnGrupo').value,
            acceso: document.getElementById('mnAcceso').value,
            dest: document.getElementById('mnDestacado').value,
            emp: (document.getElementById('mnEmpresa') || { value: '' }).value
        };
    }

    function coincide(o, f) {
        if (f.cat !== '' && (o.IdCategoria || 0) !== parseInt(f.cat, 10)) return false;
        if (f.grupo !== '' && (o.IdGrupo || 0) !== parseInt(f.grupo, 10)) return false;
        var personalizada = !!(o.IdsEmpresas && o.IdsEmpresas.length);
        if (f.acceso === 'super' && !o.SoloSuperAdmin) return false;
        if (f.acceso === 'adminemp' && !(o.SoloAdminEmpresa && !o.SoloSuperAdmin)) return false;
        if (f.acceso === 'normal' && (o.SoloSuperAdmin || o.SoloAdminEmpresa || personalizada)) return false;
        if (f.acceso === 'personalizada' && !personalizada) return false;
        if (f.dest === 'si' && !o.EsDestacado) return false;
        if (f.dest === 'no' && o.EsDestacado) return false;
        if (f.emp !== '' && (o.IdsEmpresas || []).indexOf(parseInt(f.emp, 10)) === -1) return false;
        if (f.q) {
            var texto = normalizarTexto([o.Codigo, o.Nombre, o.NombreEN, o.Descripcion, o.Controller, o.Action, o.Categoria, o.NombreGrupo].join(' '));
            if (texto.indexOf(f.q) === -1) return false;
        }
        return true;
    }

    // Grupos del filtro: los de la categoría elegida (o todos, agrupados por categoría).
    function poblarGruposFiltro() {
        var sel = document.getElementById('mnGrupo'), previo = sel.value;
        var catId = document.getElementById('mnCategoria').value;
        sel.innerHTML = '<option value="">' + _menuMsg.phGrupo + '</option>';
        var usados = {};
        _opciones.forEach(function (o) { if (o.IdGrupo) usados[o.IdGrupo] = true; });
        _categorias.forEach(function (c) {
            if (catId !== '' && parseInt(catId, 10) !== c.Id) return;
            var gs = _grupos.filter(function (g) { return g.IdCategoria === c.Id && usados[g.Id]; });
            if (!gs.length) return;
            var cont = sel;
            if (catId === '') { cont = document.createElement('optgroup'); cont.label = c.Nombre; sel.appendChild(cont); }
            gs.forEach(function (g) { var op = document.createElement('option'); op.value = g.Id; op.textContent = g.Nombre; cont.appendChild(op); });
        });
        // conserva la selección si sigue siendo válida
        if (previo && sel.querySelector('option[value="' + previo + '"]')) sel.value = previo; else sel.value = '';
    }

    function aplicarFiltros() {
        var f = estadoFiltros();
        var mapa = {};
        _opciones.forEach(function (o) { mapa[o.Id] = o; });
        var filas = document.querySelectorAll('#tablaMenuOpciones tbody tr[data-id]');
        var visibles = 0;
        filas.forEach(function (fila) {
            var o = mapa[parseInt(fila.dataset.id, 10)];
            var ok = o ? coincide(o, f) : true;
            fila.classList.toggle('mn-oculta', !ok);
            if (ok) visibles++;
        });
        var total = filas.length;
        var activos = !!(f.q || f.cat !== '' || f.grupo !== '' || f.acceso !== '' || f.dest !== '' || f.emp !== '');
        _filtrosActivos = activos;
        filas.forEach(function (fila) { fila.setAttribute('draggable', activos ? 'false' : 'true'); });

        document.getElementById('mnCuenta').textContent = (activos ? _menuMsg.cuentaFiltradasFmt.replace('{0}', visibles).replace('{1}', total) : _menuMsg.cuentaTodasFmt.replace('{0}', total));
        document.getElementById('mnResumenFiltros').textContent = activos ? _menuMsg.cuentaFiltradasFmt.replace('{0}', visibles).replace('{1}', total) : '';
        document.getElementById('mnLimpiar').hidden = !activos;
        document.getElementById('mnTablaWrap').hidden = (total > 0 && visibles === 0);
        var vacio = document.getElementById('mnSinResultados');
        if (total > 0) vacio.hidden = visibles !== 0;
        var hint = document.getElementById('mnHint');
        hint.classList.toggle('mn-hint-filtrando', activos);
        hint.innerHTML = '<i class="fas ' + (activos ? 'fa-filter' : 'fa-arrows-alt') + ' mr-1"></i>' + (activos ? _menuMsg.hintFiltrando : _menuMsg.hintOrdenar);
        document.querySelectorAll('#mnChips .mn-chip').forEach(function (chip) {
            chip.setAttribute('aria-pressed', f.cat !== '' && chip.dataset.cat === f.cat ? 'true' : 'false');
        });
    }

    function limpiarFiltros() {
        ['mnBuscar', 'mnCategoria', 'mnAcceso', 'mnDestacado', 'mnEmpresa'].forEach(function (id) { var el = document.getElementById(id); if (el) el.value = ''; });
        poblarGruposFiltro();
        document.getElementById('mnGrupo').value = '';
        aplicarFiltros();
    }

    function initFiltros() {
        poblarGruposFiltro();
        document.getElementById('mnBuscar').addEventListener('input', aplicarFiltros);
        document.getElementById('mnCategoria').addEventListener('change', function () { poblarGruposFiltro(); aplicarFiltros(); });
        ['mnGrupo', 'mnAcceso', 'mnDestacado', 'mnEmpresa'].forEach(function (id) { var el = document.getElementById(id); if (el) el.addEventListener('change', aplicarFiltros); });
        document.querySelectorAll('#mnChips .mn-chip').forEach(function (chip) {
            chip.addEventListener('click', function () {
                var sel = document.getElementById('mnCategoria');
                sel.value = (sel.value === chip.dataset.cat) ? '' : chip.dataset.cat;
                poblarGruposFiltro(); aplicarFiltros();
            });
        });
        document.getElementById('mnLimpiar').addEventListener('click', limpiarFiltros);
        var vacio = document.getElementById('mnLimpiarVacio');
        if (vacio) vacio.addEventListener('click', limpiarFiltros);
        aplicarFiltros();
    }

    // ───────────── Drag & drop para reordenar (columna Orden) ─────────────
    var _dragSrcRow = null;
    var _filtrosActivos = false;   // con filtros no se reordena: el orden es una secuencia única sobre TODAS las opciones

    function initDragOrden() {
        var tbody = document.querySelector('#tablaMenuOpciones tbody');
        if (!tbody) return;

        Array.from(tbody.querySelectorAll('tr[draggable="true"]')).forEach(function (row) {
            row.addEventListener('dragstart', function (e) {
                if (_filtrosActivos) { e.preventDefault(); return; }
                _dragSrcRow = row;
                row.classList.add('dragging-row');
            });
            row.addEventListener('dragend', function () {
                row.classList.remove('dragging-row');
                tbody.querySelectorAll('.drag-over-row').forEach(function (r) { r.classList.remove('drag-over-row'); });
            });
            row.addEventListener('dragover', function (e) {
                e.preventDefault();
                if (!_dragSrcRow || _dragSrcRow === row) return;
                tbody.querySelectorAll('.drag-over-row').forEach(function (r) { r.classList.remove('drag-over-row'); });
                row.classList.add('drag-over-row');
                var bounding = row.getBoundingClientRect();
                var offset = e.clientY - bounding.top;
                if (offset > bounding.height / 2) {
                    row.parentNode.insertBefore(_dragSrcRow, row.nextSibling);
                } else {
                    row.parentNode.insertBefore(_dragSrcRow, row);
                }
            });
            row.addEventListener('drop', function (e) {
                e.preventDefault();
                row.classList.remove('drag-over-row');
                solicitarGuardarOrden();
            });
        });
    }

    // Debounce + guard: si el usuario arrastra varias filas seguidas, solo se
    // envía UNA petición a la vez y siempre con el estado final más reciente,
    // evitando que respuestas fuera de orden pisen un cambio más nuevo.
    var _guardarTimeout = null;
    var _guardandoOrden = false;
    var _reintentarAlTerminar = false;

    function solicitarGuardarOrden() {
        if (_guardarTimeout) clearTimeout(_guardarTimeout);
        _guardarTimeout = setTimeout(function () {
            if (_guardandoOrden) {
                _reintentarAlTerminar = true;
                return;
            }
            guardarNuevoOrden();
        }, 300);
    }

    function guardarNuevoOrden() {
        var tbody = document.querySelector('#tablaMenuOpciones tbody');
        var filas = Array.from(tbody.querySelectorAll('tr[data-id]'));
        if (filas.length === 0) return;

        var mapaOpciones = {};
        _opciones.forEach(function (o) { mapaOpciones[o.Id] = o; });

        // Secuencia global 1..N sobre TODOS los menús de la base de datos, sin importar
        // categoría/grupo: mover un menú recalcula el orden de todos los demás.
        var ids = [];
        var ordenes = [];

        filas.forEach(function (fila, idx) {
            var id = parseInt(fila.dataset.id);
            if (!mapaOpciones[id]) return;
            ids.push(id);
            ordenes.push(idx + 1);
        });

        _guardandoOrden = true;

        $.ajax({
            url: '@Url.Action("ActualizarOrden", "MenuOpciones")',
            type: 'POST',
            data: {
                ids: ids,
                ordenes: ordenes,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val()
            },
            traditional: true,
            success: function (response) {
                var icon = response.success ? 'success' : 'error';
                if (response.success) {
                    ids.forEach(function (id, idx) {
                        if (mapaOpciones[id]) mapaOpciones[id].Orden = ordenes[idx];
                    });
                    filas.forEach(function (fila) {
                        var id = parseInt(fila.dataset.id);
                        var celda = fila.querySelector('.col-orden');
                        if (celda && mapaOpciones[id]) celda.textContent = mapaOpciones[id].Orden;
                    });
                }
                Swal.fire({ toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end', icon: icon, title: response.message, showConfirmButton: false, timer: 2500, timerProgressBar: true });
            },
            error: function () {
                Swal.fire({ toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end', icon: 'error', title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Menu_ErrorActualizarOrden))', showConfirmButton: false, timer: 3000, timerProgressBar: true });
            },
            complete: function () {
                _guardandoOrden = false;
                if (_reintentarAlTerminar) {
                    _reintentarAlTerminar = false;
                    guardarNuevoOrden();
                }
            }
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        poblarCategorias('crearCategoria', _categorias.length > 0 ? _categorias[0].Id : 0);
        filtrarGrupos('crear');
        initDragOrden();
        initFiltros();

        // Toggle visual para los checkboxes de "Destacado"
        ['crearEsDestacado', 'editEsDestacado'].forEach(function (chkId) {
            var chk = document.getElementById(chkId);
            var lblId = chkId === 'crearEsDestacado' ? 'crearEsDestacado' : 'editDestacadoLabel';
            if (!chk) return;
            var lbl = chk.closest('label') || document.getElementById(lblId);
            if (lbl) {
                lbl.addEventListener('click', function () {
                    chk.checked = !chk.checked;
                    actualizarEstiloDestacado(lbl.id || lblId, chk.checked);
                });
            }
        });

        // Habilitar para todos los usuarios (ver declaración de _habilitarTodosId más arriba)
        $('#habilitarTodosModal').on('show.bs.modal', function (event) {
            var btn = event.relatedTarget;
            _habilitarTodosId = parseInt(btn.dataset.id, 10);
            document.getElementById('habilitarTodosNombre').textContent = '"' + btn.dataset.nombre + '"';
        });
        // Habilitar TODAS las opciones para todos los usuarios (un solo clic)
        $('#btnConfirmarHabilitarTodas').on('click', function () {
            var $btn = $(this).prop('disabled', true);
            $.post('@Url.Action("HabilitarTodasParaTodos", "MenuOpciones")', {
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val()
            }, function (response) {
                $('#habilitarTodasModal').modal('hide');
                $btn.prop('disabled', false);
                Swal.fire({
                    toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end',
                    icon: response.success ? 'success' : 'error', title: response.message,
                    showConfirmButton: false, timer: 4000, timerProgressBar: true
                });
            }).fail(function () {
                $('#habilitarTodasModal').modal('hide');
                $btn.prop('disabled', false);
                Swal.fire({
                    toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end',
                    icon: 'error', title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Menu_ErrorHabilitarTodas))',
                    showConfirmButton: false, timer: 3000, timerProgressBar: true
                });
            });
        });
        $('#btnConfirmarHabilitarTodos').on('click', function () {
            if (!_habilitarTodosId) return;
            var $btn = $(this).prop('disabled', true);
            $.post('@Url.Action("HabilitarParaTodos", "MenuOpciones")', {
                id: _habilitarTodosId,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val()
            }, function (response) {
                $('#habilitarTodosModal').modal('hide');
                $btn.prop('disabled', false);
                Swal.fire({
                    toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end',
                    icon: response.success ? 'success' : 'error', title: response.message,
                    showConfirmButton: false, timer: 3000, timerProgressBar: true
                });
            }).fail(function () {
                $('#habilitarTodosModal').modal('hide');
                $btn.prop('disabled', false);
                Swal.fire({
                    toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end',
                    icon: 'error', title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Menu_ErrorHabilitarTodos))',
                    showConfirmButton: false, timer: 3000, timerProgressBar: true
                });
            });
        });
    });
</script>
</body>
</html>
