@model IEnumerable<bufinscustomers.Models.MenuOpciones>
@using bufinscustomers.Helpers
<!DOCTYPE html>
<html>
<head>
    <title>@Resources.Strings.Menu_PageTitle</title>
    <script src="~/Assets/js/sweetalert2.all.min.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body>

@{
    var successMsg = TempData["SuccessMessage"] as string;
    var errorMsg   = TempData["ErrorMessage"]   as string;
    var infoMsg    = TempData["InfoMessage"]     as string;

    var jss = new JavaScriptSerializer();

    var opcionesJson = jss.Serialize(Model.Select(o => new {
        o.Id, o.Codigo, o.Nombre, o.NombreEN, o.Descripcion, o.Icono, o.Orden,
        o.Controller, o.Action, o.IdGrupo, o.IdCategoria, o.NombreGrupo, o.Categoria,
        o.SoloSuperAdmin, o.SoloAdminEmpresa, o.EsDestacado, o.IdsEmpresas
    }));

    var empresasMenu = (ViewBag.Empresas as List<bufinscustomers.Models.Empresas> ?? new List<bufinscustomers.Models.Empresas>())
        .OrderBy(e => e.Nombre).ToList();
    var nombresEmpresa = empresasMenu.ToDictionary(e => e.Id, e => e.Nombre);

    var grupos     = ViewBag.Grupos     as List<bufinscustomers.Models.GrupoMenu>     ?? new List<bufinscustomers.Models.GrupoMenu>();
    var categorias = ViewBag.Categorias as List<bufinscustomers.Models.CategoriaMenu> ?? new List<bufinscustomers.Models.CategoriaMenu>();

    var gruposJson     = jss.Serialize(grupos.Select(g     => new { g.Id, g.Nombre, g.Icono, g.IdCategoria, g.NombreCategoria }));
    var categoriasJson = jss.Serialize(categorias.Select(c => new { c.Id, c.Nombre }));

    // Paleta de colores por categoría — ayuda a identificar visualmente a qué categoría/grupo
    // pertenece cada fila y dónde son válidos los arrastres para reordenar.
    var paletaColores = new[] { "#583AFF", "#01E1D7", "#F59E0B", "#EC4899", "#10B981", "#3B82F6", "#8B5CF6", "#EF4444", "#14B8A6", "#F97316" };
    var categoriasOrdenadas = categorias.OrderBy(c => c.Orden).ToList();
    var catColores = new Dictionary<int, string>();
    for (int i = 0; i < categoriasOrdenadas.Count; i++)
    {
        catColores[categoriasOrdenadas[i].Id] = paletaColores[i % paletaColores.Length];
    }

    Func<int?, string> ColorCategoria = idCat => (idCat.HasValue && catColores.ContainsKey(idCat.Value)) ? catColores[idCat.Value] : "#9ca3af";
}

@if (!string.IsNullOrEmpty(successMsg))
{
    <script>
        Swal.fire({ toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end', icon: 'success', title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(successMsg))', showConfirmButton: false, timer: 3000, timerProgressBar: true });
    </script>
}
@if (!string.IsNullOrEmpty(errorMsg))
{
    <script>
        Swal.fire({ toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end', icon: 'error', title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(errorMsg))', showConfirmButton: false, timer: 3000, timerProgressBar: true });
    </script>
}
@if (!string.IsNullOrEmpty(infoMsg))
{
    <script>
        Swal.fire({ toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end', icon: 'info', title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(infoMsg))', showConfirmButton: false, timer: 3000, timerProgressBar: true });
    </script>
}

<style>
    /* Gestor de menús: solo lo que no cubre bufins-components.css */
    .filter-card.mn-filtros { position: static; padding: .6rem .8rem; margin-bottom: .9rem; }   /* barra compacta: no se fija arriba */
    .mn-barra { display: grid; grid-template-columns: minmax(200px, 2.2fr) repeat(4, minmax(120px, 1fr)) auto; gap: .5rem; align-items: center; }
    .mn-filtros .form-control { padding: .32rem .6rem; font-size: .82rem; min-height: 0; }
    .mn-filtros .bf-input > .form-control { padding-left: 32px; }
    .mn-filtros .bf-input > i { font-size: .8rem; }
    .mn-limpiar { display: inline-flex; align-items: center; gap: .35rem; padding: .3rem .7rem; border-radius: 999px; border: 1.5px solid #d9dce6; background: #fff; color: #583AFF; font-size: .78rem; font-weight: 700; cursor: pointer; white-space: nowrap; }
    .mn-limpiar:hover { border-color: #583AFF; background: #f5f3ff; }
    .mn-limpiar[hidden] { display: none; }
    .mn-fila-chips { display: flex; align-items: center; gap: .5rem; margin-top: .5rem; }
    .mn-et { font-size: .75rem; font-weight: 700; color: #6b7280; white-space: nowrap; }
    .mn-et i { color: #583AFF; margin-right: .3rem; }
    .mn-chips { display: flex; gap: .35rem; flex: 1 1 auto; overflow-x: auto; scrollbar-width: thin; padding-bottom: 2px; }
    .mn-chip { --c: #9ca3af; display: inline-flex; align-items: center; gap: .4rem; padding: .18rem .6rem; border-radius: 999px; border: 1.5px solid #e1e4ee; background: #fff; color: #4b5563; font-size: .75rem; font-weight: 600; cursor: pointer; white-space: nowrap; flex-shrink: 0; transition: background-color .2s ease, border-color .2s ease, color .2s ease; }
    .mn-chip .mn-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--c); }
    .mn-chip .mn-n { font-weight: 700; font-size: .68rem; padding: 0 .35rem; border-radius: 999px; background: #f1f2f7; color: #6b7280; }
    .mn-chip:hover { border-color: var(--c); }
    .mn-chip[aria-pressed="true"] { background: var(--c); border-color: var(--c); color: #fff; }
    .mn-chip[aria-pressed="true"] .mn-dot { background: #fff; }
    .mn-chip[aria-pressed="true"] .mn-n { background: rgba(255,255,255,.25); color: #fff; }
    .mn-chip:focus-visible, .mn-limpiar:focus-visible { outline: 2px solid #583AFF; outline-offset: 2px; }
    .mn-resumen { font-size: .75rem; color: #6b7280; white-space: nowrap; }

    .table-container.mn-lista { padding: .8rem; }
    .mn-lista .table-header { margin-bottom: .5rem; padding-bottom: .5rem; }
    .mn-hint { margin: 0 0 .5rem; font-size: .76rem; color: #6c757d; }
    .mn-hint.mn-hint-filtrando { color: #b45309; }
    .mn-lista .table-wrapper { border: 0; max-height: 62vh; border-radius: .6rem; box-shadow: 0 0 0 1px #e8eaf3; }
    #tablaMenuOpciones { table-layout: fixed; border-collapse: separate; border-spacing: 0; }
    #tablaMenuOpciones thead th { border: 0; padding: .55rem .6rem; white-space: nowrap; font-size: .72rem; letter-spacing: .02em; }
    #tablaMenuOpciones tbody td { border: 0; border-bottom: 1px solid #eef0f6; padding: .5rem .6rem; vertical-align: middle; font-size: .8rem; }
    #tablaMenuOpciones tbody tr:last-child td { border-bottom: 0; }
    #tablaMenuOpciones tbody tr:hover td { background-color: #f6f4ff; }
    #tablaMenuOpciones tbody tr.mn-oculta { display: none; }
    #tablaMenuOpciones tbody tr[draggable="true"] { transition: opacity .15s; }
    #tablaMenuOpciones tbody tr[draggable="false"] .col-handle { cursor: not-allowed; opacity: .35; }
    #tablaMenuOpciones tbody tr.dragging-row { opacity: .4; }
    #tablaMenuOpciones tbody tr.drag-over-row td { background-color: #ede9ff; }
    #tablaMenuOpciones .col-handle   { width: 3%; text-align: center; cursor: grab; color: #9ca3af; padding-left: .2rem; padding-right: .2rem; }
    #tablaMenuOpciones .col-opcion   { width: 31%; }
    #tablaMenuOpciones .col-ubicacion{ width: 19%; }
    #tablaMenuOpciones .col-ruta     { width: 13%; }
    #tablaMenuOpciones .col-orden    { width: 5%; text-align: center; font-weight: 700; color: #583AFF; }
    #tablaMenuOpciones .col-acceso   { width: 13%; }
    #tablaMenuOpciones .col-acciones { width: 16%; text-align: right; white-space: nowrap; }
    .mn-nombre { font-weight: 600; color: #1f2937; line-height: 1.25; }
    .mn-estrella { color: #f59e0b; margin-left: .3rem; font-size: .8rem; }
    .mn-sub { display: flex; flex-wrap: wrap; align-items: center; gap: .15rem .5rem; margin-top: .15rem; font-size: .72rem; color: #6b7280; }
    .mn-sub code { font-size: .7rem; color: #583AFF; background: #f3f0ff; padding: 0 .35rem; border-radius: 4px; }
    .mn-ruta-mini { display: none; font-family: Consolas, "Courier New", monospace; }
    .mn-ruta { font-family: Consolas, "Courier New", monospace; font-size: .74rem; color: #4b5563; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; }
    .mn-ubic { display: flex; flex-wrap: wrap; gap: .25rem; }
    .cat-badge { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: .7rem; font-weight: 600; color: #fff; white-space: nowrap; }
    .grupo-badge { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: .7rem; font-weight: 600; background: #fff; white-space: nowrap; }
    .mn-acc-pills { display: flex; flex-wrap: wrap; gap: .25rem; }
    .badge-super, .badge-normal, .badge-admin-emp, .badge-personalizada { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: .68rem; font-weight: 600; color: #fff; white-space: nowrap; }
    .badge-super { background-color: #583AFF; }
    .badge-normal { background-color: #8b93a3; }
    .badge-admin-emp { background-color: #f59e0b; }
    .badge-personalizada { background-color: #0e9aa7; }
    .mn-acc { display: inline-flex; gap: .3rem; }
    .mn-acc .btn { width: 30px; height: 30px; padding: 0; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; background: #fff; border: 1px solid #e1e4ee; font-size: .78rem; box-shadow: none; }
    .mn-acc .btn-primary { color: #583AFF; } .mn-acc .btn-success { color: #059669; } .mn-acc .btn-danger { color: #dc2626; }
    .mn-acc .btn-primary:hover { background: #583AFF; border-color: #583AFF; color: #fff; }
    .mn-acc .btn-success:hover { background: #059669; border-color: #059669; color: #fff; }
    .mn-acc .btn-danger:hover { background: #dc2626; border-color: #dc2626; color: #fff; }
    .mn-pie { display: flex; gap: .6rem; flex-wrap: wrap; padding-top: .7rem; margin-top: .7rem; border-top: 1px solid #eef0f6; }

    .emp-check-list { max-height: 112px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 6px; padding: 6px 10px; background: #fff; }
    .emp-check-list .form-check { margin: 2px 0; }
    .check-dest-label { display:flex;align-items:center;gap:.4rem;padding:.55rem .85rem;border-radius:8px;border:1px solid rgba(88,58,255,.25);background:linear-gradient(90deg,rgba(88,58,255,.06),rgba(1,225,215,.04));cursor:pointer;transition:border-color .15s,background .15s }
    .check-dest-label:hover { border-color:rgba(1,225,215,.5);background:linear-gradient(90deg,rgba(88,58,255,.1),rgba(1,225,215,.07)) }
    .check-dest-icon { font-size:1rem;background:linear-gradient(135deg,#583AFF,#01E1D7);-webkit-background-clip:text;-webkit-text-fill-color:transparent }

    /* Portátiles de 14" y pantallas medianas: la ruta pasa a la línea de debajo del nombre y las columnas se reparten */
    @@media (max-width: 1279px) {
        .mn-barra { grid-template-columns: minmax(180px, 2fr) repeat(4, minmax(110px, 1fr)) auto; }
        #tablaMenuOpciones .col-ruta { display: none; }
        .mn-ruta-mini { display: inline; }
        #tablaMenuOpciones .col-opcion { width: 38%; }
        #tablaMenuOpciones .col-ubicacion { width: 21%; }
        #tablaMenuOpciones .col-acceso { width: 15%; }
        #tablaMenuOpciones .col-acciones { width: 18%; }
    }
    @@media (max-width: 991px) {
        .mn-barra { grid-template-columns: 1fr 1fr; }
        .mn-barra .mn-buscar { grid-column: 1 / -1; }
        .mn-barra .mn-limpiar { justify-self: start; }
        #tablaMenuOpciones .col-acceso { display: none; }
        #tablaMenuOpciones .col-opcion { width: 46%; }
        #tablaMenuOpciones .col-ubicacion { width: 26%; }
        #tablaMenuOpciones .col-acciones { width: 22%; }
    }
    /* Tablet vertical y teléfono: cada opción es una tarjeta */
    @@media (max-width: 767px) {
        .mn-barra { grid-template-columns: 1fr; }
        .mn-et { display: none; }
        .mn-lista .table-wrapper { max-height: none; box-shadow: none; overflow: visible; }
        #tablaMenuOpciones, #tablaMenuOpciones tbody, #tablaMenuOpciones tr, #tablaMenuOpciones td { display: block; width: 100%; }
        #tablaMenuOpciones thead { display: none; }
        #tablaMenuOpciones tbody tr { margin: 0 0 .6rem; padding: .55rem .7rem; background: #fff; border: 1px solid #e8eaf3; border-left: 5px solid var(--rail, #9ca3af); border-radius: 10px; }
        #tablaMenuOpciones tbody tr.mn-oculta { display: none; }
        #tablaMenuOpciones tbody td { border: 0; padding: .15rem 0; white-space: normal; background: transparent !important; }
        #tablaMenuOpciones tbody tr:hover td { background: transparent; }
        #tablaMenuOpciones .col-handle { display: none; }
        #tablaMenuOpciones .col-ruta, #tablaMenuOpciones .col-acceso { display: block; }
        #tablaMenuOpciones .col-orden { text-align: left; width: auto; }
        #tablaMenuOpciones .col-orden::before { content: attr(data-etq) " "; font-weight: 600; color: #6b7280; }
        #tablaMenuOpciones .col-acciones { text-align: left; padding-top: .4rem; }
        .mn-ruta-mini { display: none; }
    }
    @@media (prefers-reduced-motion: reduce) { .mn-chip, #tablaMenuOpciones tbody tr[draggable="true"] { transition: none; } }
</style>

<div class="powerbi-header">
    <div class="powerbi-header-content">
        <i class="fas fa-bars powerbi-header-icon"></i>
        <h1 class="powerbi-header-title">@Resources.Strings.Menu_PageTitle</h1>
    </div>
</div>

@{
    var totalOpciones = Model.Count();
    var empresasConPersonalizadas = Model.SelectMany(o => o.IdsEmpresas ?? new List<int>()).Distinct().Where(id => nombresEmpresa.ContainsKey(id)).OrderBy(id => nombresEmpresa[id]).ToList();
    var haySinCategoria = Model.Any(o => !o.IdCategoria.HasValue);
}

<div class="filter-card mn-filtros">
    <div class="mn-barra">
        <div class="bf-input mn-buscar"><i class="fas fa-search"></i><input type="search" id="mnBuscar" class="form-control" autocomplete="off" aria-label="@Resources.Strings.Menu_BuscarLabel" placeholder="@Resources.Strings.Menu_BuscarPH" /></div>
        <select id="mnGrupo" class="form-control" aria-label="@Resources.Strings.Menu_FiltroGrupo"><option value="">@Resources.Strings.Menu_PhGrupo</option></select>
        <select id="mnAcceso" class="form-control" aria-label="@Resources.Strings.Menu_FiltroAcceso">
            <option value="">@Resources.Strings.Menu_PhAcceso</option>
            <option value="normal">@Resources.Strings.Menu_AccesoNormal</option>
            <option value="super">@Resources.Strings.Menu_AccesoSuper</option>
            <option value="adminemp">@Resources.Strings.Menu_AccesoAdminEmp</option>
            <option value="personalizada">@Resources.Strings.Menu_AccesoPersonalizada</option>
        </select>
        <select id="mnDestacado" class="form-control" aria-label="@Resources.Strings.Menu_FiltroDestacado">
            <option value="">@Resources.Strings.Menu_PhDestacado</option>
            <option value="si">@Resources.Strings.Menu_OptSi</option>
            <option value="no">@Resources.Strings.Menu_OptNo</option>
        </select>
        @if (empresasConPersonalizadas.Count > 0)
        {
            <select id="mnEmpresa" class="form-control" aria-label="@Resources.Strings.Menu_FiltroEmpresa">
                <option value="">@Resources.Strings.Menu_PhEmpresa</option>
                @foreach (var idEmp in empresasConPersonalizadas) { <option value="@idEmp">@nombresEmpresa[idEmp]</option> }
            </select>
        }
        else
        {
            <span class="d-none d-lg-block"></span>
        }
        <button type="button" class="mn-limpiar" id="mnLimpiar" hidden><i class="fas fa-undo"></i><span>@Resources.Strings.Menu_LimpiarFiltros</span></button>
    </div>

    @* La categoría se elige con los chips (y se refleja en este selector, que queda oculto) *@
    <select id="mnCategoria" hidden aria-hidden="true">
        <option value="">@Resources.Strings.Menu_OptTodas</option>
        @foreach (var cat in categoriasOrdenadas) { <option value="@cat.Id">@cat.Nombre</option> }
        @if (haySinCategoria) { <option value="0">@Resources.Strings.Menu_SinCategoria</option> }
    </select>

    <div class="mn-fila-chips">
        <span class="mn-et"><i class="fas fa-folder"></i>@Resources.Strings.Menu_FiltroCategoria</span>
        <div class="mn-chips" id="mnChips" role="group" aria-label="@Resources.Strings.Menu_FiltroCategoria">
            @foreach (var cat in categoriasOrdenadas)
            {
                <button type="button" class="mn-chip" data-cat="@cat.Id" aria-pressed="false" style="--c:@catColores[cat.Id];">
                    <span class="mn-dot"></span>@cat.Nombre<span class="mn-n">@Model.Count(o => o.IdCategoria == cat.Id)</span>
                </button>
            }
            @if (haySinCategoria)
            {
                <button type="button" class="mn-chip" data-cat="0" aria-pressed="false">
                    <span class="mn-dot"></span>@Resources.Strings.Menu_SinCategoria<span class="mn-n">@Model.Count(o => !o.IdCategoria.HasValue)</span>
                </button>
            }
        </div>
        <span class="mn-resumen" id="mnResumenFiltros" aria-live="polite"></span>
    </div>
</div>

<div class="table-container mn-lista mb-4">
    <div class="table-header">
        <h3 class="filter-card-title" style="margin:0;padding:0;border:0;font-size:1rem;"><i class="fas fa-list"></i>@Resources.Strings.Menu_TablaTitulo</h3>
        <span class="info-badge" id="mnCuenta">@string.Format(Resources.Strings.Menu_CuentaTodasFmt, totalOpciones)</span>
    </div>

    <p class="mn-hint" id="mnHint"><i class="fas fa-arrows-alt mr-1"></i>@Resources.Strings.Menu_HintArrastrar</p>

    <div class="table-wrapper" id="mnTablaWrap">
        <table id="tablaMenuOpciones" class="data-table">
            <thead>
                <tr>
                    <th class="col-handle"></th>
                    <th class="col-opcion">@Resources.Strings.Menu_ThOpcion</th>
                    <th class="col-ubicacion">@Resources.Strings.Menu_ThUbicacion</th>
                    <th class="col-ruta">@Resources.Strings.Menu_ThRuta</th>
                    <th class="col-orden">@Resources.Strings.Menu_ThOrden</th>
                    <th class="col-acceso">@Resources.Strings.Menu_ThAcceso</th>
                    <th class="col-acciones">@Resources.Strings.Common_ThAcciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var opcion in Model)
                {
                    var colorCat = ColorCategoria(opcion.IdCategoria);
                    <tr draggable="true" data-id="@opcion.Id" style="--rail:@colorCat;">
                        <td class="col-handle" style="box-shadow: inset 4px 0 0 @colorCat;"><i class="fas fa-grip-vertical"></i></td>
                        <td class="col-opcion">
                            <div class="mn-nombre" title="@opcion.Nombre">@opcion.Nombre@if (opcion.EsDestacado) { <i class="fas fa-star mn-estrella" title="@Resources.Strings.Menu_BadgeDestacado"></i> }</div>
                            <div class="mn-sub">
                                <code title="@opcion.Codigo">@opcion.Codigo</code>
                                @if (!string.IsNullOrEmpty(opcion.NombreEN)) { <span title="@opcion.NombreEN">EN: @opcion.NombreEN</span> }
                                <span class="mn-ruta-mini">@opcion.Controller/@opcion.Action</span>
                            </div>
                        </td>
                        <td class="col-ubicacion">
                            <div class="mn-ubic">
                                @if (!string.IsNullOrEmpty(opcion.Categoria)) { <span class="cat-badge" style="background:@colorCat;">@opcion.Categoria</span> }
                                @if (!string.IsNullOrEmpty(opcion.NombreGrupo)) { <span class="grupo-badge" style="border:1px solid @colorCat;color:@colorCat;">@opcion.NombreGrupo</span> }
                            </div>
                        </td>
                        <td class="col-ruta"><span class="mn-ruta" title="@opcion.Controller / @opcion.Action">@opcion.Controller/@opcion.Action</span></td>
                        <td class="col-orden" data-etq="@Resources.Strings.Menu_LblOrden:">@opcion.Orden</td>
                        <td class="col-acceso">
                            <div class="mn-acc-pills">
                                @if (opcion.SoloSuperAdmin) { <span class="badge-super">@Resources.Strings.Menu_BadgeSuperAdmin</span> }
                                else if (opcion.SoloAdminEmpresa) { <span class="badge-admin-emp">@Resources.Strings.Menu_BadgeAdminEmp</span> }
                                else { <span class="badge-normal">@Resources.Strings.Menu_BadgeTodos</span> }
                                @if (opcion.IdsEmpresas != null && opcion.IdsEmpresas.Count > 0)
                                {
                                    <span class="badge-personalizada" title="@string.Join(", ", opcion.IdsEmpresas.Select(i => nombresEmpresa.ContainsKey(i) ? nombresEmpresa[i] : ("#" + i)))"><i class="fas fa-building mr-1"></i>@Resources.Strings.Menu_BadgePersonalizada</span>
                                }
                            </div>
                        </td>
                        <td class="col-acciones">
                            <div class="mn-acc" role="group">
                                <button type="button" class="btn btn-sm btn-primary" title="@Resources.Strings.Menu_TitleEditar" aria-label="@Resources.Strings.Menu_TitleEditar"
                                        data-toggle="modal" data-target="#editModal"
                                        onclick="cargarEditar(@opcion.Id)">
                                    <i class="fas fa-edit"></i>
                                </button>
                                @if (!opcion.SoloSuperAdmin)
                                {
                                    <button type="button" class="btn btn-sm btn-success" title="@Resources.Strings.Menu_TitleHabilitarTodos" aria-label="@Resources.Strings.Menu_TitleHabilitarTodos"
                                            data-toggle="modal" data-target="#habilitarTodosModal"
                                            data-id="@opcion.Id" data-nombre="@Html.AttributeEncode(opcion.Nombre)">
                                        <i class="fas fa-users"></i>
                                    </button>
                                }
                                <button type="button" class="btn btn-sm btn-danger" title="@Resources.Strings.Menu_TitleEliminar" aria-label="@Resources.Strings.Menu_TitleEliminar"
                                        onclick="confirmarEliminar(@opcion.Id)">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="no-data-message" id="mnSinResultados" @(totalOpciones == 0 ? "" : "hidden")>
        <i class="fas fa-filter fa-2x mb-2" style="color:#c7d2fe;"></i>
        <h5>@(totalOpciones == 0 ? Resources.Strings.Menu_NoOpciones : Resources.Strings.Menu_SinResultadosTitulo)</h5>
        @if (totalOpciones > 0)
        {
