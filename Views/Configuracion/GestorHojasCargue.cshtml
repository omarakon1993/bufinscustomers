    });

    // ── Pestaña Alcance ──
    function pintarAlcanceTab($b) {
        var h = st.sel, ro = !st.desdeBD;
        $b.html('<div class="hc-nota info"><i class="fas fa-info-circle"></i><div>' + esc(T.AlcanceNota) + '</div></div>' +
            htmlAlcance('a', h.alcance, h.empresas.slice(), st.det.filasPorEmpresa, ro) +
            '<div id="aAviso"></div>' +
            (ro ? '' : '<div class="hc-acciones"><span class="hc-estado" id="aEstado">' + esc(T.SinCambios) + '</span><button type="button" class="btn btn-modern-gradient" id="aGuardar" disabled><i class="fas fa-save mr-1"></i>' + esc(T.BtnGuardarAlcance) + '</button></div>'));
        refrescarAlcance('a');
    }
    function estadoAlcanceTab() {
        var h = st.sel, a = leerAlcance('a');
        var antes = h.empresas.slice().sort().join(','), ahora = a.empresas.slice().sort().join(',');
        var sucio = a.alcance !== h.alcance || (a.alcance === 'PERSONALIZADA' && antes !== ahora);
        $('#aGuardar').prop('disabled', !sucio);
        $('#aEstado').text(sucio ? T.CambiosPendientes : T.SinCambios);
        // Empresas con datos que dejarían de cargar esta hoja
        var pierden = [];
        if (a.alcance === 'PERSONALIZADA') {
            st.det.filasPorEmpresa.forEach(function (f) { if (a.empresas.indexOf(f.idEmpresa) < 0) pierden.push(nombreEmpresa(f.idEmpresa)); });
        }
        $('#aAviso').html(pierden.length ? '<div class="hc-nota warn mt-3"><i class="fas fa-exclamation-triangle"></i><div>' + esc(fmt(T.AvisoPierden, pierden.join(', '))) + '</div></div>' : '');
    }
    function guardarAlcanceTab() {
        var h = st.sel, a = leerAlcance('a');
        if (a.alcance === 'PERSONALIZADA' && !a.empresas.length) { error(T.Err_SinEmpresas); return; }
        sw({ icon: 'question', title: T.ConfAlcanceTitulo, text: T.ConfAlcanceTexto, showCancelButton: true, confirmButtonText: T.BtnConfirmar, cancelButtonText: T.BtnCancelar })
            .then(function (x) {
                if (!x.isConfirmed) return;
                post(URL.alcance, { id: h.id, alcance: a.alcance, empresas: a.empresas.join(',') })
                    .done(function (r) { if (r.success) { toast('success', r.message); cargar(h.id); } else error(r.message); });
            });
    }

    // ── Pestaña Uso y diagnóstico ──
    function pintarUso($b) {
        var d = st.det, h = st.sel;
        var porEmp = d.filasPorEmpresa.slice().sort(function (a, b) { return b.filas - a.filas; });
        var tablaEmp = porEmp.length
            ? '<div class="table-wrapper" style="max-height:240px;"><table class="data-table"><thead><tr><th>' + esc(T.ThEmpresa) + '</th><th style="text-align:right;">' + esc(T.ThFilas) + '</th></tr></thead><tbody>' +
              porEmp.map(function (f) { return '<tr><td>' + esc(nombreEmpresa(f.idEmpresa)) + '</td><td style="text-align:right;">' + num(f.filas) + '</td></tr>'; }).join('') + '</tbody></table></div>'
            : '<div class="text-muted" style="font-size:.85rem;">' + esc(T.SinDatos) + '</div>';
        var usada = d.usadaPor.length
            ? '<div class="hc-usado">' + d.usadaPor.map(function (u) { return '<code>' + esc(u) + '</code>'; }).join('') + '</div>'
            : '<div class="text-muted" style="font-size:.85rem;">' + esc(T.NoUsada) + '</div>';
        var iconos = { ok: 'fa-check-circle', warn: 'fa-exclamation-triangle', error: 'fa-times-circle' };
        var diag = '<ul class="hc-diag">' + d.diagnostico.map(function (x) {
            return '<li class="' + x.nivel + '"><i class="fas ' + iconos[x.nivel] + '"></i><span>' + esc(T['Diag_' + x.codigo] || x.codigo) + (x.detalle ? ' <code>' + esc(x.detalle) + '</code>' : '') + '</span></li>';
        }).join('') + '</ul>';
        $b.html('<div class="hc-stats">' +
                '<div class="hc-stat"><div class="v">' + num(d.filasIni) + '</div><div class="l">' + esc(fmt(T.StatFilas, h.tabla)) + '</div></div>' +
                '<div class="hc-stat"><div class="v">' + num(d.filasStaging) + '</div><div class="l">' + esc(T.StatStaging) + '</div></div>' +
                '<div class="hc-stat"><div class="v">' + porEmp.length + '</div><div class="l">' + esc(T.StatEmpresas) + '</div></div>' +
            '</div>' +
            '<div class="hc-subtitulo"><i class="fas fa-stethoscope"></i>' + esc(T.SubDiagnostico) + '</div>' + diag +
            '<div class="hc-subtitulo"><i class="fas fa-building"></i>' + esc(T.SubFilasEmpresa) + '</div>' + tablaEmp +
            '<div class="hc-subtitulo"><i class="fas fa-project-diagram"></i>' + esc(T.SubUsadaPor) + '</div>' + usada +
            '<div class="hc-subtitulo"><i class="fas fa-vial"></i>' + esc(T.SubPrueba) + '</div>' +
            '<div class="hc-prueba"><span class="text-muted" style="font-size:.82rem;">' + esc(T.PruebaTexto) + '</span>' +
              '<button type="button" class="btn btn-modern-excel btn-sm" id="uProbar"><i class="fas fa-vial mr-1"></i>' + esc(T.BtnPlantillaPrueba) + '</button></div>');
    }

    // ── Eliminar hoja ──
    function eliminarHoja() {
        var h = st.sel, d = st.det;
        var puedeBorrar = d && d.estructuraEditable && d.existeIni;
        sw({
            icon: 'warning',
            title: fmt(T.ConfEliminarTitulo, h.hoja),
            html: '<p>' + esc(T.ConfEliminarTexto) + '</p>' + (puedeBorrar
                ? '<label class="hc-swal-check"><input type="checkbox" id="swBorrarTablas" /> ' + esc(fmt(T.ConfEliminarBorrarTablas, h.tabla)) + '</label>'
                : '<p class="hc-swal-nota">' + esc(T.ConfEliminarConserva) + '</p>'),
            showCancelButton: true, confirmButtonText: T.BtnEliminarConfirmar, cancelButtonText: T.BtnCancelar,
            preConfirm: function () { return { borrar: !!(document.getElementById('swBorrarTablas') || {}).checked }; }
        }).then(function (x) {
            if (!x.isConfirmed) return;
            post(URL.eliminar, { id: h.id, borrarTablas: x.value.borrar }).done(function (r) {
                if (r.success) { toast('success', r.message); st.sel = null; $('#hcDetalle').html(vacioHtml); cargar(null); } else error(r.message);
            });
        });
    }

    // ── Eventos del panel ──
    var vacioHtml = $('#hcDetalle').html();
    $('#hcLista')
        .on('click', '.hc-item', function () { seleccionar(+$(this).data('id')); })
        .on('keydown', '.hc-item', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); seleccionar(+$(this).data('id')); } });
    $('#hcFiltros').on('click', '.hc-chip-f', function () { st.filtro = $(this).data('f'); $('#hcFiltros .hc-chip-f').removeClass('on'); $(this).addClass('on'); pintarLista(); });
    $('#hcBuscar').on('input', function () { st.q = this.value.trim(); pintarLista(); });
    $('#hcDetalle')
        .on('click', '.hc-tab', function () { st.tab = $(this).data('tab'); $('.hc-tab').removeClass('on'); $(this).addClass('on'); pintarTab(); })
        .on('input change', '#gHoja, #gDesc, #gOrden, #gActivo', function () { var s = generalSucio(); $('#gGuardar').prop('disabled', !s); $('#gEstado').text(s ? T.CambiosPendientes : T.SinCambios); })
        .on('click', '#gGuardar', guardarGeneral)
        .on('click', '#cAgregar', function () { abrirModalColumna(null); })
        .on('click', '[data-editcol]', function () { abrirModalColumna(st.det.columnas[+$(this).data('editcol')]); })
        .on('click', '[data-delcol]', function () { eliminarColumna(st.det.columnas[+$(this).data('delcol')]); })
        .on('click', '#aGuardar', guardarAlcanceTab)
        .on('click', '#hcEliminar', eliminarHoja)
        .on('click', '#uProbar', function () { abrirPrueba(st.sel.alcance === 'PERSONALIZADA' ? st.sel.empresas[0] : 0); });
    $('#mcTipo').on('change', ajustarModalTipo);
    $('#mcGuardar').on('click', guardarModalColumna);
    // ── Plantilla de prueba: modal claro con la lista de hojas que tendrá el Excel ──
    function abrirPrueba(idEmpresa) {
        $('#mpEmpresa').html('<option value="0">' + esc(T.PruebaEstandar) + '</option>' +
            st.empresas.map(function (e) { return '<option value="' + e.id + '">' + esc(e.nombre) + '</option>'; }).join(''))
            .val(String(idEmpresa || 0));
        pintarPrevPrueba();
        $('#hcModalPrueba').modal('show');
    }
    function pintarPrevPrueba() {
        var id = +$('#mpEmpresa').val();
        var hojas = st.hojas.filter(function (h) { return h.activo && (h.alcance === 'ESTANDAR' || (id > 0 && h.empresas.indexOf(id) >= 0)); })
            .sort(function (a, b) { return a.orden - b.orden; });
        $('#mpHojasTitulo').text(fmt(T.PruebaHojasIncluidas, hojas.length));
        $('#mpHojas').html(hojas.map(function (h) {
            return '<li><span class="hc-mono">' + esc(h.hoja) + '</span>' +
                (h.alcance === 'PERSONALIZADA' ? '<span class="hc-tag per"><i class="fas fa-puzzle-piece"></i>' + esc(T.TagPersonalizada) + '</span>' : '') + '</li>';
        }).join(''));
    }
    $('#mpEmpresa').on('change', pintarPrevPrueba);
    $('#mpDescargar').on('click', function () {
        window.location.href = URL.prueba + '?idEmpresa=' + encodeURIComponent($('#mpEmpresa').val());
        $('#hcModalPrueba').modal('hide');
    });
    $('#hcBtnPrueba').on('click', function () { abrirPrueba(0); });

    // ══════════════════ Asistente "Nueva hoja" ══════════════════
    var wz = { paso: 1, tablaManual: false, existe: false, tieneAnio: true, colsExistentes: [], verif: null, cols: [] };

    function colsIniciales() {
        return [
            { n: 'Empresa', t: 'varchar', l: 100, e: null, nul: true, d: '' },
            { n: ANIO, t: 'varchar', l: 10, e: null, nul: true, d: '' },
            { n: 'Mes', t: 'varchar', l: 10, e: null, nul: true, d: '' },
            { n: 'Valor', t: 'money', l: null, e: null, nul: true, d: '' }
        ];
    }
    function abrirAsistente() {
        var maxOrden = st.hojas.reduce(function (m, h) { return Math.max(m, h.orden); }, 0);
        wz = { paso: 1, tablaManual: false, existe: false, tieneAnio: true, colsExistentes: [], verif: null, cols: colsIniciales() };
        $('#wzHoja, #wzTabla, #wzDesc').val('');
        $('#wzOrden').val(maxOrden + 10);
        $('#wzEstadoTabla').empty();
        $('#wzAlcance').html(htmlAlcance('w', 'ESTANDAR', [], [], false));
        refrescarAlcance('w');
        pintarColsEditor();
        irPaso(1);
        $('#hcModalNueva').modal('show');
        setTimeout(function () { $('#wzHoja').trigger('focus'); }, 350);
    }
    function irPaso(p) {
        wz.paso = p;
        $('.wz-paso').hide().filter('[data-p="' + p + '"]').show();
        $('#wzPasos .hc-paso').each(function () { var n = +$(this).data('p'); $(this).toggleClass('on', n === p).toggleClass('hecho', n < p); });
        $('#wzAnterior').toggle(p > 1);
        $('#wzSiguiente').toggle(p < 4);
        $('#wzCrear').toggle(p === 4);
        if (p === 2) { $('#wzColsNuevas').toggle(!wz.existe); $('#wzColsExistentes').toggle(wz.existe); }
        if (p === 4) pintarResumen();
    }
    function nombreHojaWz() { return 'Z_' + $('#wzHoja').val().trim(); }
    function nombreTablaWz() { return 'Ini_' + $('#wzTabla').val().trim(); }

    var timerVerif = null;
    function verificarTabla() {
        clearTimeout(timerVerif);
        var tabla = nombreTablaWz();
        if (!/^Ini_[A-Za-z0-9_]{1,96}$/.test(tabla)) { wz.verif = null; $('#wzEstadoTabla').html($('#wzTabla').val() ? '<span class="hc-tag err"><i class="fas fa-times"></i>' + esc(T.EstadoInvalida) + '</span>' : ''); return; }
        $('#wzEstadoTabla').html('<span class="text-muted"><i class="fas fa-spinner fa-spin mr-1"></i>' + esc(T.EstadoVerificando) + '</span>');
        timerVerif = setTimeout(function () {
            wz.verif = $.get(URL.verificar, { tabla: tabla }).done(function (r) {
                if (!r.success || nombreTablaWz() !== tabla) return;
                wz.existe = !!r.existe; wz.tieneAnio = r.tieneAnio !== false; wz.colsExistentes = r.columnas || [];
                var html;
                if (!r.existe) html = '<span class="hc-tag ok"><i class="fas fa-plus"></i>' + esc(T.EstadoNueva) + '</span>';
                else if (!wz.tieneAnio) html = '<span class="hc-tag err"><i class="fas fa-times"></i>' + esc(T.EstadoExistenteSinAnio) + '</span>';
                else html = '<span class="hc-tag warn"><i class="fas fa-link"></i>' + esc(fmt(T.EstadoExistente, wz.colsExistentes.length)) + '</span>';
                $('#wzEstadoTabla').html(html);
                $('#wzColsExistBody').html(wz.colsExistentes.map(function (c) {
                    return '<tr><td class="hc-mono"><strong>' + esc(c.nombre) + '</strong></td><td><span class="hc-tipo">' + esc(c.tipoCompleto) + '</span></td><td>' + (c.nulos ? esc(T.Si) : esc(T.No)) + '</td><td class="hc-mono">' + (c.defecto != null ? esc(c.defecto) : '—') + '</td></tr>';
                }).join(''));
            });
        }, 400);
    }

    function pintarColsEditor() {
        $('#wzColsBody').html(wz.cols.map(function (c, i) {
            var esAnio = c.n === ANIO;
            var lp = usaLongitud(c.t) ? (c.l == null ? 100 : c.l) : (usaPrecision(c.t) ? (c.l == null ? 18 : c.l) : '');
            return '<tr data-i="' + i + '">' +
                '<td class="mov"><button type="button" class="hc-mini" data-mv="-1"' + (i === 0 ? ' disabled' : '') + '><i class="fas fa-arrow-up"></i></button> ' +
                    '<button type="button" class="hc-mini" data-mv="1"' + (i === wz.cols.length - 1 ? ' disabled' : '') + '><i class="fas fa-arrow-down"></i></button></td>' +
                '<td><input type="text" class="form-control hc-mono" data-k="n" value="' + esc(c.n) + '" placeholder="' + esc(T.PhColumna) + '" maxlength="64"' + (esAnio ? ' disabled' : '') + ' />' + '</td>' +
                '<td><select class="form-control" data-k="t">' + opcionesTipo(c.t) + '</select></td>' +
                '<td><input type="number" class="form-control num" data-k="l" value="' + lp + '"' + (usaLongitud(c.t) || usaPrecision(c.t) ? '' : ' disabled') + ' /></td>' +
                '<td><input type="number" class="form-control num" data-k="e" value="' + (usaPrecision(c.t) ? (c.e == null ? 2 : c.e) : '') + '"' + (usaPrecision(c.t) ? '' : ' disabled') + ' /></td>' +
                '<td class="chk"><input type="checkbox" data-k="nul"' + (c.nul ? ' checked' : '') + ' /></td>' +
                '<td><input type="text" class="form-control" data-k="d" value="' + esc(c.d || '') + '" placeholder="' + esc(T.PhDefecto) + '" /></td>' +
                '<td>' + (esAnio ? '<i class="fas fa-lock hc-candado" title="' + esc(T.Err_SinAnio) + '"></i>' : '<button type="button" class="hc-mini danger" data-del="1"><i class="fas fa-trash-alt"></i></button>') + '</td>' +
            '</tr>';
        }).join(''));
    }
    $('#wzColsBody')
        .on('input change', '[data-k]', function () {
            var i = +$(this).closest('tr').data('i'), k = $(this).data('k'), c = wz.cols[i];
            if (k === 'nul') c.nul = this.checked;
            else if (k === 't') { c.t = this.value; c.l = usaLongitud(c.t) ? 100 : (usaPrecision(c.t) ? 18 : null); c.e = usaPrecision(c.t) ? 2 : null; pintarColsEditor(); }
            else if (k === 'l' || k === 'e') c[k] = this.value === '' ? null : parseInt(this.value, 10);
            else c[k] = this.value;
        })
        .on('click', '[data-mv]', function () {
            var i = +$(this).closest('tr').data('i'), j = i + (+$(this).data('mv'));
            var tmp = wz.cols[i]; wz.cols[i] = wz.cols[j]; wz.cols[j] = tmp; pintarColsEditor();
        })
        .on('click', '[data-del]', function () { wz.cols.splice(+$(this).closest('tr').data('i'), 1); pintarColsEditor(); });
    $('#wzAgregarCol').on('click', function () { wz.cols.push({ n: '', t: 'varchar', l: 100, e: null, nul: true, d: '' }); pintarColsEditor(); $('#wzColsBody tr:last [data-k="n"]').trigger('focus'); });

    function columnasWz() {
        return wz.cols.map(function (c) { return leerColumna(c.n, c.t, c.l, c.e, c.nul, c.d); });
    }
    function datosWz() {
        var a = leerAlcance('w');
        return {
            NombreHoja: nombreHojaWz(), TablaIni: nombreTablaWz(), Descripcion: $('#wzDesc').val().trim(),
            Orden: parseInt($('#wzOrden').val(), 10) || 0, Alcance: a.alcance,
            Empresas: a.alcance === 'PERSONALIZADA' ? a.empresas : [],
            Columnas: wz.existe ? [] : columnasWz()
        };
    }
    function validarPaso(p) {
        if (p === 1) {
            if (!/^Z_[A-Za-z0-9_]{1,29}$/.test(nombreHojaWz())) return T.Err_NombreHoja;
            if (!/^Ini_[A-Za-z0-9_]{1,96}$/.test(nombreTablaWz())) return T.Err_NombreTabla;
            if (wz.existe && !wz.tieneAnio) return T.Err_SinAnio;
        }
        if (p === 2 && !wz.existe) {
            var cols = columnasWz(), vistos = {};
            if (!cols.length) return T.Err_SinColumnas;
            for (var i = 0; i < cols.length; i++) {
                if (!/^[A-Za-zÁÉÍÓÚáéíóúÑñÜü_][A-Za-z0-9ÁÉÍÓÚáéíóúÑñÜü_]{0,63}$/.test(cols[i].Nombre)) return T.Err_ColumnaNombre + ' (' + (cols[i].Nombre || '#' + (i + 1)) + ')';
                var k = cols[i].Nombre.toLowerCase();
                if (vistos[k]) return T.Err_ColumnaDuplicada + ' (' + cols[i].Nombre + ')';
                vistos[k] = 1;
            }
            if (!vistos[ANIO.toLowerCase()]) return T.Err_SinAnio;
        }
        if (p === 3) {
            var a = leerAlcance('w');
            if (a.alcance === 'PERSONALIZADA' && !a.empresas.length) return T.Err_SinEmpresas;
        }
        return null;
    }
    function siguiente() {
        var avanzar = function () {
            var e = validarPaso(wz.paso);
            if (e) { error(e); return; }
            irPaso(wz.paso + 1);
        };
        // En el paso 1 se espera a que termine la verificación de la tabla (existe / nueva).
        if (wz.paso === 1 && wz.verif && wz.verif.state && wz.verif.state() === 'pending') wz.verif.always(avanzar); else avanzar();
    }
    function pintarResumen() {
        var d = datosWz();
        var alc = d.Alcance === 'PERSONALIZADA' ? T.OpcPersT : T.OpcEstandarT;
        $('#wzResumen').html(
            '<div><span>' + esc(T.Res_Hoja) + '</span><strong class="hc-mono">' + esc(d.NombreHoja) + '</strong></div>' +
            '<div><span>' + esc(T.Res_Tabla) + '</span><strong class="hc-mono">' + esc(d.TablaIni) + '</strong></div>' +
            '<div><span>' + esc(T.Res_Alcance) + '</span><strong>' + esc(alc) + '</strong>' + (d.Empresas.length ? ' · ' + esc(d.Empresas.map(nombreEmpresa).join(', ')) : '') + '</div>' +
            '<div><span>' + esc(T.Res_Columnas) + '</span><strong>' + (wz.existe ? wz.colsExistentes.length : d.Columnas.length) + '</strong></div>');
        $('#wzSql').html('<div class="text-muted"><i class="fas fa-spinner fa-spin mr-1"></i>' + esc(T.Cargando) + '</div>');
        $.post(URL.preview, { datos: JSON.stringify(d) }).done(function (r) {
            if (!r.success) { $('#wzSql').html('<div class="hc-nota err"><i class="fas fa-times-circle"></i><div>' + esc(r.message) + '</div></div>'); $('#wzCrear').prop('disabled', true); return; }
            $('#wzCrear').prop('disabled', false);
            $('#wzSql').html(r.sql ? '<pre class="hc-sql">' + esc(r.sql) + '</pre>' : '<div class="hc-nota info"><i class="fas fa-link"></i><div>' + esc(T.SqlRegistrar) + '</div></div>');
        }).fail(function () { $('#wzSql').html('<div class="hc-nota err"><i class="fas fa-times-circle"></i><div>' + esc(T.ErrorRed) + '</div></div>'); });
    }
    function crear() {
        var d = datosWz();
        sw({ icon: 'question', title: T.ConfCrearTitulo, text: fmt(T.ConfCrearTexto, d.TablaIni), showCancelButton: true, confirmButtonText: T.BtnConfirmar, cancelButtonText: T.BtnCancelar })
            .then(function (x) {
                if (!x.isConfirmed) return;
                overlay(true, T.Creando);
                $.post(URL.crear, { datos: JSON.stringify(d) })
                    .always(function () { overlay(false); })
                    .done(function (r) {
                        if (!r.success) { error(r.message); return; }
                        $('#hcModalNueva').modal('hide');
                        toast('success', r.message);
                        st.filtro = 'todas'; $('#hcFiltros .hc-chip-f').removeClass('on').filter('[data-f="todas"]').addClass('on');
                        st.tab = 'columnas';   // al abrir la hoja nueva se muestra su estructura
                        cargar(r.id);
                    })
                    .fail(function () { error(T.ErrorRed); });
            });
    }

    $('#hcBtnNueva').on('click', abrirAsistente);
    $('#wzSiguiente').on('click', siguiente);
    $('#wzAnterior').on('click', function () { irPaso(wz.paso - 1); });
    $('#wzCrear').on('click', crear);
    $('#wzHoja').on('input', function () {
        // Sugerencia de tabla: Ini_ + nombre de la hoja sin Z_, hasta que el usuario la edite a mano.
        this.value = this.value.replace(/^Z_/i, '').replace(/[^A-Za-z0-9_]/g, '');
        if (!wz.tablaManual) { $('#wzTabla').val(this.value); verificarTabla(); }
    });
    $('#wzTabla').on('input', function () {
        this.value = this.value.replace(/^Ini_/i, '').replace(/[^A-Za-z0-9_]/g, '');
        wz.tablaManual = this.value !== $('#wzHoja').val();
        verificarTabla();
    });

    cargar(null);
})();
</script>
}
