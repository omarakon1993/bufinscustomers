@{
    ViewBag.Title = Resources.Strings.HojasCargue_PageTitle;

    // Textos para el JS (claves HojasCargue_*, sin el prefijo). Todos existen en ambos .resx.
    var clavesJs = new[] {
        "TagEstandar","TagPersonalizada","TagInactiva","TagEmpresas","ListaVacia","Cargando","BtnPlantillaPrueba","PruebaHojasIncluidas",
        "ArrastrarAyuda","ArrastrarSoloTodas","OrdenActualizado","Err_Orden",
        "TabGeneral","TabColumnas","TabAlcance","TabUso","BtnEliminar",
        "LblHoja","AyudaHoja","LblTabla","AyudaTablaFija","LblDescripcion","PhDescripcion","LblOrden","LblActiva","AyudaActiva",
        "BtnGuardar","SinCambios","CambiosPendientes",
        "ColsNotaEditable","ColsNotaDatos","ColsNotaUsada","ThColumna","ThTipo","ThNulos","ThDefecto","Si","No","BtnAgregarColumna","Sistema","SinTabla",
        "OpcEstandarT","OpcEstandarS","OpcPersT","OpcPersS","EmpBuscar","EmpSeleccionadas","EmpFilas","AvisoPierden","BtnGuardarAlcance","AlcanceNota",
        "StatFilas","StatStaging","StatEmpresas","SubFilasEmpresa","SinDatos","ThEmpresa","ThFilas","SubUsadaPor","NoUsada","SubDiagnostico",
        "SubPrueba","PruebaTexto","PruebaEstandar","BtnDescargar",
        "Diag_Ok","Diag_IniNoExiste","Diag_StagingNoExiste","Diag_SistemaFaltaIni","Diag_SistemaFaltaStaging","Diag_SinColumnas","Diag_SinAnio","Diag_SinMes",
        "Diag_ColumnaFaltaStaging","Diag_TipoDistinto","Diag_ColumnaSoloStaging",
        "Paso1","Paso2","Paso3","Paso4","TablaSugerida","EstadoNueva","EstadoExistente","EstadoExistenteSinAnio","EstadoInvalida","EstadoVerificando",
        "ColsAyuda","ColsExistentes","ThLongitud","ThEscala","PhColumna","PhDefecto",
        "Tipo_varchar","Tipo_nvarchar","Tipo_int","Tipo_bigint","Tipo_decimal","Tipo_money","Tipo_date","Tipo_datetime","Tipo_bit",
        "Res_Hoja","Res_Tabla","Res_Alcance","Res_Columnas","Res_Empresas","SqlTitulo","SqlRegistrar","BtnAnterior","BtnSiguiente","BtnCrear","Creando",
        "ColModalNueva","ColModalEditar",
        "ConfColTitulo","ConfColTexto","ConfEliminarColTitulo","ConfEliminarTitulo","ConfEliminarTexto","ConfEliminarBorrarTablas","ConfEliminarConserva",
        "ConfAlcanceTitulo","ConfAlcanceTexto","ConfDesactivarTitulo","ConfDesactivarTexto","ConfCrearTitulo","ConfCrearTexto",
        "BtnConfirmar","BtnEliminarConfirmar","BtnCancelar","ErrorRed",
        "Err_NombreHoja","Err_NombreTabla","Err_SinColumnas","Err_SinEmpresas","Err_SinAnio","Err_ColumnaNombre","Err_ColumnaDuplicada"
    };
    var textosJs = new System.Collections.Generic.Dictionary<string, string>();
    foreach (var k in clavesJs)
    {
        textosJs[k] = (System.Web.HttpContext.GetGlobalResourceObject("Strings", "HojasCargue_" + k) as string) ?? k;
    }
}

<link href="~/Assets/css/gestor-hojas-cargue.css" rel="stylesheet" />

<div class="container-fluid px-4 hc-root">

    <!-- ═══════════ Cabecera ═══════════ -->
    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas fa-file-excel powerbi-header-icon"></i>
            <div class="powerbi-header-text">
                <h1 class="powerbi-header-title">@Resources.Strings.HojasCargue_PageTitle</h1>
                <p class="powerbi-header-sub">@Resources.Strings.HojasCargue_PageSub</p>
            </div>
            <div class="hc-header-actions">
                <button type="button" class="btn btn-modern-secondary" id="hcBtnPrueba">
                    <i class="fas fa-file-download mr-1"></i>@Resources.Strings.HojasCargue_BtnPlantillaPrueba
                </button>
                <button type="button" class="btn btn-modern-success" id="hcBtnNueva">
                    <i class="fas fa-plus-circle mr-1"></i>@Resources.Strings.HojasCargue_BtnNueva
                </button>
            </div>
        </div>
    </div>

    <div class="hc-aviso" id="hcAvisoScript" style="display:none;">
        <i class="fas fa-exclamation-triangle"></i>
        <div>@Html.Raw(string.Format(HttpUtility.HtmlEncode(Resources.Strings.HojasCargue_AvisoSinScript), "<code>Sql/021_GestorHojasCargue.sql</code>"))</div>
    </div>

    <!-- ═══════════ KPIs + flujo ═══════════ -->
    <div class="hc-top">
        <div class="hc-kpi"><div class="hc-kpi-ic"><i class="fas fa-layer-group"></i></div><div><div class="hc-kpi-v" id="kpiActivas">–</div><div class="hc-kpi-l">@Resources.Strings.HojasCargue_KpiActivas</div></div></div>
        <div class="hc-kpi"><div class="hc-kpi-ic slate"><i class="fas fa-globe"></i></div><div><div class="hc-kpi-v" id="kpiEstandar">–</div><div class="hc-kpi-l">@Resources.Strings.HojasCargue_KpiEstandar</div></div></div>
        <div class="hc-kpi"><div class="hc-kpi-ic aqua"><i class="fas fa-puzzle-piece"></i></div><div><div class="hc-kpi-v" id="kpiPersonalizadas">–</div><div class="hc-kpi-l">@Resources.Strings.HojasCargue_KpiPersonalizadas</div></div></div>
        <div class="hc-kpi"><div class="hc-kpi-ic amber"><i class="fas fa-building"></i></div><div><div class="hc-kpi-v" id="kpiEmpresas">–</div><div class="hc-kpi-l">@Resources.Strings.HojasCargue_KpiEmpresas</div></div></div>
        <div class="hc-flujo" aria-hidden="true">
            <div class="hc-flujo-paso"><i class="fas fa-file-excel"></i><b>@Resources.Strings.HojasCargue_Flujo1T</b><span>Z_…</span></div>
            <i class="fas fa-chevron-right hc-flujo-flecha"></i>
            <div class="hc-flujo-paso"><i class="fas fa-clipboard-check"></i><b>@Resources.Strings.HojasCargue_Flujo2T</b><span>Staging_Ini_…</span></div>
            <i class="fas fa-chevron-right hc-flujo-flecha"></i>
            <div class="hc-flujo-paso"><i class="fas fa-database"></i><b>@Resources.Strings.HojasCargue_Flujo3T</b><span>Ini_…</span></div>
        </div>
    </div>

    <!-- ═══════════ Lista + detalle ═══════════ -->
    <div class="hc-main">
        <aside class="hc-panel hc-lista">
            <div class="hc-lista-head">
                <div class="hc-buscar">
                    <i class="fas fa-search"></i>
                    <input type="text" class="form-control" id="hcBuscar" placeholder="@Resources.Strings.HojasCargue_Buscar" autocomplete="off" />
                </div>
                <div class="hc-filtros" id="hcFiltros">
                    <button type="button" class="hc-chip-f on" data-f="todas">@Resources.Strings.HojasCargue_FiltroTodas<span class="n"></span></button>
                    <button type="button" class="hc-chip-f" data-f="std">@Resources.Strings.HojasCargue_FiltroEstandar<span class="n"></span></button>
                    <button type="button" class="hc-chip-f" data-f="per">@Resources.Strings.HojasCargue_FiltroPersonalizadas<span class="n"></span></button>
                    <button type="button" class="hc-chip-f" data-f="off">@Resources.Strings.HojasCargue_FiltroInactivas<span class="n"></span></button>
                </div>
                <div class="hc-orden-ayuda" id="hcOrdenAyuda"></div>
            </div>
            <div class="hc-lista-body" id="hcLista">
                <div class="hc-lista-vacia"><i class="fas fa-spinner fa-spin"></i></div>
            </div>
        </aside>

        <section class="hc-panel" id="hcDetalle">
            <div class="hc-detalle-vacio">
                <div class="empty-state-initial-icon"><i class="fas fa-mouse-pointer"></i></div>
                <h4 style="font-size:1.05rem;font-weight:700;color:#2d3748;">@Resources.Strings.HojasCargue_DetalleVacioTitulo</h4>
                <p class="mb-0" style="max-width:420px;margin:0 auto;">@Resources.Strings.HojasCargue_DetalleVacioTexto</p>
            </div>
        </section>
    </div>
</div>

<!-- ═══════════ Asistente: nueva hoja (modal de creación → look claro) ═══════════ -->
<div class="modal fade hc-modal" id="hcModalNueva" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-plus-circle"></i>@Resources.Strings.HojasCargue_WizTitulo</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="hc-pasos" id="wzPasos">
                    <div class="hc-paso" data-p="1"><span class="n">1</span><span class="txt">@Resources.Strings.HojasCargue_Paso1</span></div>
                    <div class="hc-paso" data-p="2"><span class="n">2</span><span class="txt">@Resources.Strings.HojasCargue_Paso2</span></div>
                    <div class="hc-paso" data-p="3"><span class="n">3</span><span class="txt">@Resources.Strings.HojasCargue_Paso3</span></div>
                    <div class="hc-paso" data-p="4"><span class="n">4</span><span class="txt">@Resources.Strings.HojasCargue_Paso4</span></div>
                </div>

                <!-- Paso 1 -->
                <div class="wz-paso" data-p="1">
                    <div class="hc-grid2">
                        <div class="hc-campo">
                            <label for="wzHoja"><i class="fas fa-file-excel"></i>@Resources.Strings.HojasCargue_LblHoja <span class="required">*</span></label>
                            <div class="hc-prefijo"><span class="pre">Z_</span><input type="text" class="form-control" id="wzHoja" maxlength="29" autocomplete="off" /></div>
                            <div class="hc-ayuda">@Resources.Strings.HojasCargue_AyudaHoja</div>
                        </div>
                        <div class="hc-campo">
                            <label for="wzTabla"><i class="fas fa-database"></i>@Resources.Strings.HojasCargue_LblTabla <span class="required">*</span></label>
                            <div class="hc-prefijo"><span class="pre">Ini_</span><input type="text" class="form-control" id="wzTabla" maxlength="96" autocomplete="off" /></div>
                            <div class="hc-ayuda">@Resources.Strings.HojasCargue_TablaSugerida</div>
                            <div class="hc-estado-tabla" id="wzEstadoTabla"></div>
                        </div>
                        <div class="hc-campo full">
                            <label for="wzDesc"><i class="fas fa-align-left"></i>@Resources.Strings.HojasCargue_LblDescripcion</label>
                            <input type="text" class="form-control" id="wzDesc" maxlength="500" placeholder="@Resources.Strings.HojasCargue_PhDescripcion" />
                        </div>
                        <div class="hc-campo">
                            <label for="wzOrden"><i class="fas fa-sort-numeric-down"></i>@Resources.Strings.HojasCargue_LblOrden</label>
                            <input type="number" class="form-control" id="wzOrden" min="0" max="9999" />
                        </div>
                    </div>
                </div>

                <!-- Paso 2 -->
                <div class="wz-paso" data-p="2">
                    <div id="wzColsNuevas">
                        <div class="hc-nota info"><i class="fas fa-info-circle"></i><div>@Resources.Strings.HojasCargue_ColsAyuda</div></div>
                        <div class="table-responsive">
                            <table class="hc-cols-editor">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>@Resources.Strings.HojasCargue_ThColumna</th>
                                        <th>@Resources.Strings.HojasCargue_ThTipo</th>
                                        <th>@Resources.Strings.HojasCargue_ThLongitud</th>
                                        <th>@Resources.Strings.HojasCargue_ThEscala</th>
                                        <th class="chk">@Resources.Strings.HojasCargue_ThNulos</th>
                                        <th>@Resources.Strings.HojasCargue_ThDefecto</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="wzColsBody"></tbody>
                            </table>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary mt-2" id="wzAgregarCol"><i class="fas fa-plus mr-1"></i>@Resources.Strings.HojasCargue_BtnAgregarColumna</button>
                        <div class="hc-ayuda mt-2">@Resources.Strings.HojasCargue_AyudaLongitud<br />@Resources.Strings.HojasCargue_AyudaDefecto</div>
                    </div>
                    <div id="wzColsExistentes" style="display:none;">
                        <div class="hc-nota info"><i class="fas fa-link"></i><div>@Resources.Strings.HojasCargue_ColsExistentes</div></div>
                        <div class="table-wrapper"><table class="data-table"><thead><tr><th>@Resources.Strings.HojasCargue_ThColumna</th><th>@Resources.Strings.HojasCargue_ThTipo</th><th>@Resources.Strings.HojasCargue_ThNulos</th><th>@Resources.Strings.HojasCargue_ThDefecto</th></tr></thead><tbody id="wzColsExistBody"></tbody></table></div>
                    </div>
                </div>

                <!-- Paso 3 -->
                <div class="wz-paso" data-p="3">
                    <div id="wzAlcance"></div>
                </div>

                <!-- Paso 4 -->
                <div class="wz-paso" data-p="4">
                    <div class="hc-resumen" id="wzResumen"></div>
                    <div class="hc-subtitulo"><i class="fas fa-code"></i>@Resources.Strings.HojasCargue_SqlTitulo</div>
                    <div id="wzSql"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal"><i class="fas fa-times mr-1"></i>@Resources.Strings.HojasCargue_BtnCancelar</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="wzAnterior"><i class="fas fa-arrow-left mr-1"></i>@Resources.Strings.HojasCargue_BtnAnterior</button>
                <button type="button" class="btn btn-modern-gradient btn-sm" id="wzSiguiente">@Resources.Strings.HojasCargue_BtnSiguiente<i class="fas fa-arrow-right ml-1"></i></button>
                <button type="button" class="btn btn-modern-success btn-sm" id="wzCrear" style="display:none;"><i class="fas fa-check mr-1"></i>@Resources.Strings.HojasCargue_BtnCrear</button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════ Modal: agregar / modificar columna (edición → look claro) ═══════════ -->
<div class="modal fade hc-modal hc-modal-sm" id="hcModalCol" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-columns"></i><span id="mcTitulo"></span></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="hc-nota info" id="mcNotaAgregar"><i class="fas fa-info-circle"></i><div>@Resources.Strings.HojasCargue_ColAgregarNota</div></div>
                <div class="hc-grid2">
                    <div class="hc-campo full">
                        <label for="mcNombre"><i class="fas fa-heading"></i>@Resources.Strings.HojasCargue_LblNombreCol <span class="required">*</span></label>
                        <input type="text" class="form-control hc-mono" id="mcNombre" maxlength="64" autocomplete="off" />
                    </div>
                    <div class="hc-campo">
                        <label for="mcTipo"><i class="fas fa-shapes"></i>@Resources.Strings.HojasCargue_LblTipo</label>
                        <select class="form-control" id="mcTipo"></select>
                    </div>
                    <div class="hc-campo" id="mcWrapLong">
                        <label for="mcLong"><i class="fas fa-ruler-horizontal"></i><span id="mcLblLong">@Resources.Strings.HojasCargue_LblLongitud</span></label>
                        <input type="number" class="form-control" id="mcLong" />
                    </div>
                    <div class="hc-campo" id="mcWrapEsc">
                        <label for="mcEsc"><i class="fas fa-sliders-h"></i>@Resources.Strings.HojasCargue_LblEscala</label>
                        <input type="number" class="form-control" id="mcEsc" min="0" max="38" />
                    </div>
                    <div class="hc-campo">
                        <label for="mcDef"><i class="fas fa-magic"></i>@Resources.Strings.HojasCargue_LblDefecto</label>
                        <input type="text" class="form-control" id="mcDef" placeholder="@Resources.Strings.HojasCargue_PhDefecto" />
                    </div>
                    <div class="hc-campo full">
                        <label class="hc-switch"><input type="checkbox" id="mcNulos" checked /><span class="trk"></span>@Resources.Strings.HojasCargue_LblNulos</label>
                        <div class="hc-ayuda">@Resources.Strings.HojasCargue_AyudaDefecto</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal"><i class="fas fa-times mr-1"></i>@Resources.Strings.HojasCargue_BtnCancelar</button>
                <button type="button" class="btn btn-primary btn-sm" id="mcGuardar"><i class="fas fa-save mr-1"></i>@Resources.Strings.HojasCargue_BtnGuardar</button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════ Modal: plantilla de prueba (look claro) ═══════════ -->
<div class="modal fade hc-modal hc-modal-sm" id="hcModalPrueba" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-vial"></i>@Resources.Strings.HojasCargue_SubPrueba</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <p class="hc-ayuda mt-0 mb-3" style="font-size:.85rem;">@Resources.Strings.HojasCargue_PruebaTexto</p>
                <div class="hc-campo">
                    <label for="mpEmpresa"><i class="fas fa-building"></i>@Resources.Strings.HojasCargue_LblEmpresaPrueba</label>
                    <select class="form-control" id="mpEmpresa"></select>
                </div>
                <div class="hc-subtitulo"><i class="fas fa-layer-group"></i><span id="mpHojasTitulo"></span></div>
                <ol class="hc-prev-hojas" id="mpHojas"></ol>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal"><i class="fas fa-times mr-1"></i>@Resources.Strings.HojasCargue_BtnCancelar</button>
                <button type="button" class="btn btn-modern-excel btn-sm" id="mpDescargar"><i class="fas fa-file-download mr-1"></i>@Resources.Strings.HojasCargue_BtnDescargar</button>
