<!-- Overlay de procesamiento (DDL) — versión clara del overlay estándar -->
<div class="overlay-cargando hc-overlay-claro" id="hcOverlay" style="display:none;">
    <div class="overlay-cargando-card">
        @Html.Partial("_LoaderDots", "dark")
        <div class="overlay-cargando-title" id="hcOverlayTxt">@Resources.Strings.HojasCargue_Creando</div>
    </div>
</div>

@section scripts {
<script>
(function () {
    'use strict';

    var T = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(textosJs));
    var URL = {
        listar: '@Url.Action("Listar", "GestorHojasCargue")',
        detalle: '@Url.Action("Detalle", "GestorHojasCargue")',
        verificar: '@Url.Action("VerificarTabla", "GestorHojasCargue")',
        preview: '@Url.Action("VistaPreviaSql", "GestorHojasCargue")',
        crear: '@Url.Action("Crear", "GestorHojasCargue")',
        general: '@Url.Action("GuardarGeneral", "GestorHojasCargue")',
        alcance: '@Url.Action("GuardarAlcance", "GestorHojasCargue")',
        addCol: '@Url.Action("AgregarColumna", "GestorHojasCargue")',
        modCol: '@Url.Action("ModificarColumna", "GestorHojasCargue")',
        delCol: '@Url.Action("EliminarColumna", "GestorHojasCargue")',
        eliminar: '@Url.Action("Eliminar", "GestorHojasCargue")',
        prueba: '@Url.Action("DescargarPlantillaPrueba", "GestorHojasCargue")',
        orden: '@Url.Action("ActualizarOrden", "GestorHojasCargue")'
    };
    var TIPOS = ['varchar', 'nvarchar', 'int', 'bigint', 'decimal', 'money', 'date', 'datetime', 'bit'];
    var ANIO = 'Año';

    var st = { hojas: [], empresas: [], desdeBD: true, filtro: 'todas', q: '', sel: null, det: null, tab: 'general' };

    // ── Utilidades ─────────────────────────────────────────────────────────────────
    function esc(s) { return $('<div/>').text(s == null ? '' : String(s)).html(); }
    function fmt(s) { var a = arguments; return String(s).replace(/\{(\d+)\}/g, function (m, i) { return a[+i + 1] !== undefined ? a[+i + 1] : m; }); }
    function num(n) { return (n || 0).toLocaleString(); }
    function nombreEmpresa(id) { var e = st.empresas.filter(function (x) { return x.id === id; })[0]; return e ? e.nombre : ('#' + id); }
    // SweetAlert con el tema CLARO de este gestor (el global de la app es oscuro).
    function sw(opts) {
        var o = $.extend({ buttonsStyling: false }, opts);
        o.customClass = $.extend({ popup: 'hc-swal' + (opts.toast ? ' hc-swal-toast' : ''), confirmButton: 'hc-swal-ok', cancelButton: 'hc-swal-cancel' }, opts.customClass || {});
        return Swal.fire(o);
    }
    function toast(icon, title) {
        sw({ toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end', icon: icon, title: title, showConfirmButton: false, timer: 3200, timerProgressBar: true });
    }
    function error(msg) { sw({ icon: 'error', title: msg || T.ErrorRed }); }
    function overlay(on, txt) { $('#hcOverlayTxt').text(txt || T.Creando); document.getElementById('hcOverlay').style.display = on ? 'flex' : 'none'; }
    function post(url, data) {
        overlay(true, T.Cargando);
        return $.post(url, data).always(function () { overlay(false); }).fail(function () { error(T.ErrorRed); });
    }
    function tagAlcance(h) {
        var t = h.alcance === 'PERSONALIZADA'
            ? '<span class="hc-tag per"><i class="fas fa-puzzle-piece"></i>' + esc(T.TagPersonalizada) + '</span>'
            : '<span class="hc-tag std"><i class="fas fa-globe"></i>' + esc(T.TagEstandar) + '</span>';
        if (!h.activo) t += ' <span class="hc-tag off"><i class="fas fa-pause"></i>' + esc(T.TagInactiva) + '</span>';
        return t;
    }
    function opcionesTipo(sel) {
        return TIPOS.map(function (t) { return '<option value="' + t + '"' + (t === sel ? ' selected' : '') + '>' + esc(T['Tipo_' + t]) + ' · ' + t.toUpperCase() + '</option>'; }).join('');
    }
    function usaLongitud(t) { return t === 'varchar' || t === 'nvarchar'; }
    function usaPrecision(t) { return t === 'decimal'; }

    // ── Carga y lista ──────────────────────────────────────────────────────────────
    function cargar(idSeleccion) {
        return $.get(URL.listar).done(function (r) {
            if (!r.success) { error(r.message); return; }
            st.hojas = r.hojas; st.empresas = r.empresas; st.desdeBD = r.desdeBD;
            $('#hcAvisoScript').toggle(!r.desdeBD);
            $('#hcBtnNueva').prop('disabled', !r.desdeBD);
            pintarKpis(); pintarLista();
            var id = idSeleccion !== undefined ? idSeleccion : (st.sel ? st.sel.id : null);
            if (id !== null && id !== undefined) seleccionar(id, true);
        }).fail(function () { error(T.ErrorRed); });
    }

    function pintarKpis() {
        var act = st.hojas.filter(function (h) { return h.activo; });
        var per = act.filter(function (h) { return h.alcance === 'PERSONALIZADA'; });
        var emp = {}; per.forEach(function (h) { h.empresas.forEach(function (e) { emp[e] = 1; }); });
        $('#kpiActivas').text(act.length);
        $('#kpiEstandar').text(act.length - per.length);
        $('#kpiPersonalizadas').text(per.length);
        $('#kpiEmpresas').text(Object.keys(emp).length);
        var c = { todas: st.hojas.length, std: 0, per: 0, off: 0 };
        st.hojas.forEach(function (h) { if (!h.activo) c.off++; else if (h.alcance === 'PERSONALIZADA') c.per++; else c.std++; });
        $('#hcFiltros .hc-chip-f').each(function () { $(this).find('.n').text(c[$(this).data('f')]); });
    }

    function pasaFiltro(h) {
        if (st.filtro === 'std' && !(h.activo && h.alcance === 'ESTANDAR')) return false;
        if (st.filtro === 'per' && !(h.activo && h.alcance === 'PERSONALIZADA')) return false;
        if (st.filtro === 'off' && h.activo) return false;
        if (!st.q) return true;
        var q = st.q.toLowerCase();
        return (h.hoja + ' ' + h.tabla + ' ' + (h.descripcion || '')).toLowerCase().indexOf(q) >= 0;
    }

    // Se puede arrastrar solo con la lista completa (sin filtro ni búsqueda): así el orden que se guarda
    // es el de TODAS las hojas y no el de un subconjunto.
    function puedeOrdenar() { return st.desdeBD && st.filtro === 'todas' && !st.q && st.hojas.length > 1; }

    function pintarLista() {
        st.hojas.sort(function (a, b) { return a.orden - b.orden || a.hoja.localeCompare(b.hoja); });
        var arrastrable = puedeOrdenar();
        $('#hcOrdenAyuda').html(st.desdeBD && st.hojas.length > 1
            ? '<i class="fas ' + (arrastrable ? 'fa-arrows-alt-v' : 'fa-info-circle') + '"></i>' + esc(arrastrable ? T.ArrastrarAyuda : T.ArrastrarSoloTodas)
            : '');
        var items = st.hojas.filter(pasaFiltro);
        if (!items.length) { $('#hcLista').html('<div class="hc-lista-vacia"><i class="fas fa-search mb-2 d-block"></i>' + esc(T.ListaVacia) + '</div>'); return; }
        $('#hcLista').html(items.map(function (h) {
            var meta = tagAlcance(h);
            if (h.alcance === 'PERSONALIZADA') meta += ' <span class="hc-tag neutro"><i class="fas fa-building"></i>' + esc(fmt(T.TagEmpresas, h.empresas.length)) + '</span>';
            var pos = st.hojas.indexOf(h) + 1;
            return '<div class="hc-item' + (arrastrable ? ' arrastrable' : '') + (st.sel && st.sel.id === h.id ? ' sel' : '') + (h.activo ? '' : ' inactiva') + '" data-id="' + h.id + '" role="button" tabindex="0"' + (arrastrable ? ' draggable="true"' : '') + '>' +
                (arrastrable ? '<span class="hc-grip" aria-hidden="true"><i class="fas fa-grip-vertical"></i></span>' : '') +
                '<div class="hc-item-top"><span class="hc-pos">' + pos + '</span><span class="hc-item-nombre">' + esc(h.hoja) + '</span></div>' +
                '<div class="hc-item-tabla">→ ' + esc(h.tabla) + '</div>' +
                '<div class="hc-item-meta">' + meta + '</div></div>';
        }).join(''));
    }

    // ── Reordenar arrastrando (mismo patrón que el gestor de menús) ──
    var drag = { src: null, timer: null, guardando: false, pendiente: false };
    $('#hcLista')
        .on('dragstart', '.hc-item.arrastrable', function (e) {
            drag.src = this; this.classList.add('arrastrando');
            if (e.originalEvent && e.originalEvent.dataTransfer) { e.originalEvent.dataTransfer.effectAllowed = 'move'; e.originalEvent.dataTransfer.setData('text/plain', $(this).data('id')); }
        })
        .on('dragend', '.hc-item.arrastrable', function () {
            this.classList.remove('arrastrando');
            $('#hcLista .drag-sobre').removeClass('drag-sobre');
        })
        .on('dragover', '.hc-item.arrastrable', function (e) {
            e.preventDefault();
            if (!drag.src || drag.src === this) return;
            $('#hcLista .drag-sobre').removeClass('drag-sobre'); this.classList.add('drag-sobre');
            var r = this.getBoundingClientRect();
            if (e.originalEvent.clientY - r.top > r.height / 2) this.parentNode.insertBefore(drag.src, this.nextSibling);
            else this.parentNode.insertBefore(drag.src, this);
        })
        .on('drop', '.hc-item.arrastrable', function (e) {
            e.preventDefault();
            this.classList.remove('drag-sobre');
            solicitarGuardarOrden();
        });

    // Debounce + guarda: varias suelta seguidas = UNA petición con el estado final.
    function solicitarGuardarOrden() {
        clearTimeout(drag.timer);
        drag.timer = setTimeout(function () {
            if (drag.guardando) { drag.pendiente = true; return; }
            guardarOrden();
        }, 300);
    }
    function guardarOrden() {
        var ids = $('#hcLista .hc-item').map(function () { return +$(this).data('id'); }).get();
        if (!ids.length) return;
        var ordenes = ids.map(function (id, i) { return (i + 1) * 10; });
        // Se aplica ya en pantalla (posición y orden) y se revierte si el servidor falla.
        var previo = {}; st.hojas.forEach(function (h) { previo[h.id] = h.orden; });
        ids.forEach(function (id, i) { var h = st.hojas.filter(function (x) { return x.id === id; })[0]; if (h) h.orden = ordenes[i]; });
        $('#hcLista .hc-item').each(function (i) { $(this).find('.hc-pos').text(i + 1); });
        if (st.sel && st.tab === 'general') $('#gOrden').val(st.sel.orden);

        drag.guardando = true;
        $.ajax({ url: URL.orden, type: 'POST', data: { ids: ids, ordenes: ordenes }, traditional: true })
            .done(function (r) {
                if (r.success) toast('success', r.message);
                else { st.hojas.forEach(function (h) { h.orden = previo[h.id]; }); pintarLista(); error(r.message); }
            })
            .fail(function () { st.hojas.forEach(function (h) { h.orden = previo[h.id]; }); pintarLista(); error(T.Err_Orden); })
            .always(function () {
                drag.guardando = false;
                if (drag.pendiente) { drag.pendiente = false; guardarOrden(); }
            });
    }

    // ── Detalle ────────────────────────────────────────────────────────────────────
    function seleccionar(id, conservarTab) {
        var h = st.hojas.filter(function (x) { return x.id === id; })[0];
        if (!h) { st.sel = null; $('#hcDetalle').html(vacioHtml); return; }
        st.sel = h; st.det = null;
        if (!conservarTab) st.tab = 'general';
        pintarLista();
        pintarDetalleBase();
        $.get(URL.detalle, { id: id }).done(function (r) {
            if (!st.sel || st.sel.id !== id) return;
            if (!r.success) { error(r.message); return; }
            st.det = r;
            pintarDetalleBase();
        });
    }

    function nivelDiag() {
        if (!st.det) return null;
        var n = st.det.diagnostico.map(function (d) { return d.nivel; });
        return n.indexOf('error') >= 0 ? 'err' : (n.indexOf('warn') >= 0 ? 'warn' : 'ok');
    }

    function pintarDetalleBase() {
        var h = st.sel, d = st.det;
        var nCols = d ? d.columnas.length : '…';
        var dot = nivelDiag();
        var html =
            '<div class="hc-det-head">' +
              '<div style="min-width:0;">' +
                '<h2 class="hc-det-titulo">' + esc(h.hoja) + ' ' + tagAlcance(h) + '</h2>' +
                '<div class="hc-det-ruta"><span class="seg z"><i class="fas fa-file-excel" style="color:#217346"></i> ' + esc(h.hoja) + '</span><i class="fas fa-arrow-right"></i>' +
                  '<span class="seg">Staging_' + esc(h.tabla) + '</span><i class="fas fa-arrow-right"></i><span class="seg ini">' + esc(h.tabla) + '</span></div>' +
                (h.descripcion ? '<div class="hc-ayuda" style="margin-top:.5rem;font-size:.82rem;">' + esc(h.descripcion) + '</div>' : '') +
              '</div>' +
              (st.desdeBD ? '<div class="hc-det-acciones"><button type="button" class="hc-btn-icono danger" id="hcEliminar" title="' + esc(T.BtnEliminar) + '"><i class="fas fa-trash-alt"></i></button></div>' : '') +
            '</div>' +
            '<div class="hc-tabs" role="tablist">' +
              tabBtn('general', 'fa-sliders-h', T.TabGeneral, '') +
              tabBtn('columnas', 'fa-columns', T.TabColumnas, '<span class="cnt">' + nCols + '</span>') +
              tabBtn('alcance', 'fa-building', T.TabAlcance, '') +
              tabBtn('uso', 'fa-stethoscope', T.TabUso, dot ? '<span class="dot ' + dot + '"></span>' : '') +
            '</div>' +
            '<div class="hc-tab-body" id="hcTabBody"></div>';
        $('#hcDetalle').html(html);
        pintarTab();
    }
    function tabBtn(k, ic, txt, extra) {
        return '<button type="button" class="hc-tab' + (st.tab === k ? ' on' : '') + '" data-tab="' + k + '"><i class="fas ' + ic + '"></i>' + esc(txt) + extra + '</button>';
    }

    function pintarTab() {
        var $b = $('#hcTabBody');
        if (st.tab === 'general') return pintarGeneral($b);
        if (!st.det) { $b.html('<div class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin mr-2"></i>' + esc(T.Cargando) + '</div>'); return; }
        if (st.tab === 'columnas') return pintarColumnas($b);
        if (st.tab === 'alcance') return pintarAlcanceTab($b);
        if (st.tab === 'uso') return pintarUso($b);
    }

    // ── Pestaña General ──
    function pintarGeneral($b) {
        var h = st.sel, ro = !st.desdeBD;
        $b.html(
            '<div class="hc-grid2">' +
              '<div class="hc-campo"><label for="gHoja"><i class="fas fa-file-excel"></i>' + esc(T.LblHoja) + '</label>' +
                '<input type="text" class="form-control hc-mono" id="gHoja" maxlength="31" value="' + esc(h.hoja) + '"' + (ro ? ' disabled' : '') + ' />' +
                '<div class="hc-ayuda">' + esc(T.AyudaHoja) + '</div></div>' +
              '<div class="hc-campo"><label><i class="fas fa-database"></i>' + esc(T.LblTabla) + '</label>' +
                '<input type="text" class="form-control hc-mono hc-bloqueado" value="' + esc(h.tabla) + '" disabled />' +
                '<div class="hc-ayuda"><i class="fas fa-lock mr-1"></i>' + esc(T.AyudaTablaFija) + '</div></div>' +
              '<div class="hc-campo full"><label for="gDesc"><i class="fas fa-align-left"></i>' + esc(T.LblDescripcion) + '</label>' +
                '<textarea class="form-control" id="gDesc" rows="2" maxlength="500" placeholder="' + esc(T.PhDescripcion) + '"' + (ro ? ' disabled' : '') + '>' + esc(h.descripcion || '') + '</textarea></div>' +
              '<div class="hc-campo"><label for="gOrden"><i class="fas fa-sort-numeric-down"></i>' + esc(T.LblOrden) + '</label>' +
                '<input type="number" class="form-control" id="gOrden" min="0" max="9999" value="' + h.orden + '"' + (ro ? ' disabled' : '') + ' /></div>' +
              '<div class="hc-campo"><label>&nbsp;</label>' +
                '<label class="hc-switch"><input type="checkbox" id="gActivo"' + (h.activo ? ' checked' : '') + (ro ? ' disabled' : '') + ' /><span class="trk"></span>' + esc(T.LblActiva) + '</label>' +
                '<div class="hc-ayuda">' + esc(T.AyudaActiva) + '</div></div>' +
            '</div>' +
            (ro ? '' : '<div class="hc-acciones"><span class="hc-estado" id="gEstado">' + esc(T.SinCambios) + '</span>' +
              '<button type="button" class="btn btn-modern-gradient" id="gGuardar" disabled><i class="fas fa-save mr-1"></i>' + esc(T.BtnGuardar) + '</button></div>'));
    }
    function generalSucio() {
        var h = st.sel;
        return $('#gHoja').val().trim() !== h.hoja || ($('#gDesc').val().trim() || '') !== (h.descripcion || '') ||
            parseInt($('#gOrden').val(), 10) !== h.orden || $('#gActivo').is(':checked') !== h.activo;
    }
    function guardarGeneral() {
        var h = st.sel, activo = $('#gActivo').is(':checked');
        var enviar = function () {
            post(URL.general, { id: h.id, nombreHoja: $('#gHoja').val().trim(), descripcion: $('#gDesc').val().trim(), orden: parseInt($('#gOrden').val(), 10) || 0, activo: activo })
                .done(function (r) { if (r.success) { toast('success', r.message); cargar(h.id); } else error(r.message); });
        };
        if (h.activo && !activo) {
            sw({ icon: 'warning', title: T.ConfDesactivarTitulo, text: T.ConfDesactivarTexto, showCancelButton: true, confirmButtonText: T.BtnConfirmar, cancelButtonText: T.BtnCancelar })
                .then(function (x) { if (x.isConfirmed) enviar(); });
        } else enviar();
    }

    // ── Pestaña Columnas ──
    function pintarColumnas($b) {
        var d = st.det, h = st.sel;
        if (!d.existeIni) { $b.html('<div class="hc-nota err"><i class="fas fa-times-circle"></i><div>' + esc(fmt(T.SinTabla, h.tabla)) + '</div></div>'); return; }
        var nota;
        if (d.estructuraEditable) nota = '<div class="hc-nota info"><i class="fas fa-unlock"></i><div>' + esc(T.ColsNotaEditable) + '</div></div>';
        else if (d.usadaPor.length) nota = '<div class="hc-nota warn"><i class="fas fa-lock"></i><div>' + esc(fmt(T.ColsNotaUsada, d.usadaPor.join(', '))) + '</div></div>';
        else nota = '<div class="hc-nota warn"><i class="fas fa-lock"></i><div>' + esc(T.ColsNotaDatos) + '</div></div>';

        var filas = d.columnas.map(function (c, i) {
            var acc = '';
            if (st.desdeBD && d.estructuraEditable) {
                acc = '<button type="button" class="hc-mini" data-editcol="' + i + '" title="' + esc(T.ColModalEditar) + '"><i class="fas fa-pen"></i></button> ' +
                      (c.nombre === ANIO ? '' : '<button type="button" class="hc-mini danger" data-delcol="' + i + '"><i class="fas fa-trash-alt"></i></button>');
            }
            return '<tr><td class="text-muted" style="width:1%;">' + (i + 1) + '</td><td><strong class="hc-mono">' + esc(c.nombre) + '</strong>' +
                (c.nombre === ANIO ? '<i class="fas fa-lock hc-candado"></i>' : '') + '</td>' +
                '<td><span class="hc-tipo">' + esc(c.tipoCompleto) + '</span></td>' +
                '<td>' + (c.nulos ? esc(T.Si) : '<strong>' + esc(T.No) + '</strong>') + '</td>' +
                '<td class="hc-mono">' + (c.defecto != null ? esc(c.defecto) : '<span class="text-muted">—</span>') + '</td>' +
                '<td class="acc">' + acc + '</td></tr>';
        }).join('');

        var sistema = d.columnasSistema.map(function (c) { return '<span class="hc-tag neutro hc-mono">' + esc(c.nombre) + ' · ' + esc(c.tipoCompleto) + '</span>'; }).join('');

        $b.html(nota +
            '<div class="table-wrapper hc-tabla-cols"><table class="data-table"><thead><tr><th>#</th><th>' + esc(T.ThColumna) + '</th><th>' + esc(T.ThTipo) + '</th><th>' + esc(T.ThNulos) + '</th><th>' + esc(T.ThDefecto) + '</th><th></th></tr></thead><tbody>' + filas + '</tbody></table></div>' +
            (st.desdeBD ? '<button type="button" class="btn btn-modern-gradient btn-sm mt-3" id="cAgregar"><i class="fas fa-plus mr-1"></i>' + esc(T.BtnAgregarColumna) + '</button>' : '') +
            '<details class="hc-sistema"><summary><i class="fas fa-chevron-right"></i><i class="fas fa-cog"></i>' + esc(fmt(T.Sistema, d.columnasSistema.length)) + '</summary><div class="hc-sistema-lista">' + sistema + '</div></details>');
    }

    // Modal de columna (agregar / modificar)
    var mc = { modo: 'nueva', original: null };
    function abrirModalColumna(col) {
        mc.modo = col ? 'editar' : 'nueva'; mc.original = col ? col.nombre : null;
        $('#mcTitulo').text(col ? T.ColModalEditar : T.ColModalNueva);
        $('#mcNotaAgregar').toggle(!col);
        $('#mcTipo').html(opcionesTipo(col ? col.tipo : 'varchar'));
        $('#mcNombre').val(col ? col.nombre : '').prop('disabled', !!col && col.nombre === ANIO);
        $('#mcLong').val(col ? (usaPrecision(col.tipo) ? col.precision : col.longitud) : 100);
        $('#mcEsc').val(col && col.escala != null ? col.escala : 2);
        $('#mcDef').val(col && col.defecto != null ? col.defecto : '');
        $('#mcNulos').prop('checked', col ? col.nulos : true);
        ajustarModalTipo();
        $('#hcModalCol').modal('show');
    }
    function ajustarModalTipo() {
        var t = $('#mcTipo').val();
        $('#mcWrapLong').toggle(usaLongitud(t) || usaPrecision(t));
        $('#mcWrapEsc').toggle(usaPrecision(t));
        $('#mcLblLong').text(usaPrecision(t) ? '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.HojasCargue_LblPrecision))' : '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.HojasCargue_LblLongitud))');
        if (usaPrecision(t) && (!$('#mcLong').val() || +$('#mcLong').val() > 38)) $('#mcLong').val(18);
    }
    function leerColumna(nombre, tipo, longPrec, escala, nulos, defecto) {
        var c = { Nombre: (nombre || '').trim(), Tipo: tipo, PermiteNulos: !!nulos, ValorDefecto: (defecto || '').trim() || null };
        if (usaLongitud(tipo)) c.Longitud = parseInt(longPrec, 10);
        if (usaPrecision(tipo)) { c.Precision = parseInt(longPrec, 10); c.Escala = parseInt(escala, 10) || 0; }
        return c;
    }
    function guardarModalColumna() {
        var col = leerColumna(mc.original === ANIO ? ANIO : $('#mcNombre').val(), $('#mcTipo').val(), $('#mcLong').val(), $('#mcEsc').val(), $('#mcNulos').is(':checked'), $('#mcDef').val());
        if (!/^[A-Za-zÁÉÍÓÚáéíóúÑñÜü_][A-Za-z0-9ÁÉÍÓÚáéíóúÑñÜü_]{0,63}$/.test(col.Nombre)) { error(T.Err_ColumnaNombre); return; }
        var h = st.sel;
        sw({ icon: 'question', title: T.ConfColTitulo, text: fmt(T.ConfColTexto, h.tabla), showCancelButton: true, confirmButtonText: T.BtnConfirmar, cancelButtonText: T.BtnCancelar })
            .then(function (x) {
                if (!x.isConfirmed) return;
                var data = { id: h.id, columna: JSON.stringify(col) };
                if (mc.modo === 'editar') data.nombreOriginal = mc.original;
                post(mc.modo === 'editar' ? URL.modCol : URL.addCol, data).done(function (r) {
                    if (r.success) { $('#hcModalCol').modal('hide'); toast('success', r.message); cargar(h.id); } else error(r.message);
                });
            });
    }
    function eliminarColumna(col) {
        var h = st.sel;
        sw({ icon: 'warning', title: fmt(T.ConfEliminarColTitulo, col.nombre), text: fmt(T.ConfColTexto, h.tabla), showCancelButton: true, confirmButtonText: T.BtnEliminarConfirmar, cancelButtonText: T.BtnCancelar })
            .then(function (x) {
                if (!x.isConfirmed) return;
                post(URL.delCol, { id: h.id, nombre: col.nombre }).done(function (r) { if (r.success) { toast('success', r.message); cargar(h.id); } else error(r.message); });
            });
    }

    // ── Selector de alcance (compartido: pestaña Alcance y asistente) ──
    function htmlAlcance(prefijo, alcance, seleccion, filasPorEmpresa, ro) {
        var filas = {}; (filasPorEmpresa || []).forEach(function (f) { filas[f.idEmpresa] = f.filas; });
        var lista = st.empresas.map(function (e) {
            var chk = seleccion.indexOf(e.id) >= 0;
            return '<label class="hc-emp" data-nombre="' + esc(e.nombre.toLowerCase()) + '"><input type="checkbox" class="' + prefijo + 'Emp" value="' + e.id + '"' + (chk ? ' checked' : '') + (ro ? ' disabled' : '') + ' />' +
                esc(e.nombre) + (filas[e.id] ? '<span class="filas">' + esc(fmt(T.EmpFilas, num(filas[e.id]))) + '</span>' : '') + '</label>';
        }).join('');
        return '<div class="hc-opciones">' +
              opcionAlcance(prefijo, 'ESTANDAR', 'fa-globe', T.OpcEstandarT, T.OpcEstandarS, alcance, ro) +
              opcionAlcance(prefijo, 'PERSONALIZADA', 'fa-puzzle-piece', T.OpcPersT, T.OpcPersS, alcance, ro) +
            '</div>' +
            '<div id="' + prefijo + 'EmpWrap"' + (alcance === 'PERSONALIZADA' ? '' : ' style="display:none;"') + '>' +
              '<div class="hc-empresas"><div class="hc-empresas-head"><div class="hc-buscar"><i class="fas fa-search"></i><input type="text" class="form-control form-control-sm" id="' + prefijo + 'EmpQ" placeholder="' + esc(T.EmpBuscar) + '" /></div>' +
                '<span class="cuenta" id="' + prefijo + 'EmpCuenta"></span></div>' +
                '<div class="hc-empresas-lista">' + lista + '</div></div>' +
              '<div class="hc-emp-sel" id="' + prefijo + 'EmpSel"></div>' +
            '</div>';
    }
    function opcionAlcance(prefijo, valor, ic, t, s, actual, ro) {
        return '<label class="hc-opcion' + (actual === valor ? ' on' : '') + '"><input type="radio" name="' + prefijo + 'Alcance" value="' + valor + '"' + (actual === valor ? ' checked' : '') + (ro ? ' disabled' : '') + ' />' +
            '<span class="ic"><i class="fas ' + ic + '"></i></span><span><span class="t">' + esc(t) + '</span><span class="s">' + esc(s) + '</span></span></label>';
    }
    function leerAlcance(prefijo) {
        return {
            alcance: $('input[name="' + prefijo + 'Alcance"]:checked').val(),
            empresas: $('.' + prefijo + 'Emp:checked').map(function () { return +this.value; }).get()
        };
    }
    function refrescarAlcance(prefijo) {
        var a = leerAlcance(prefijo);
        $('input[name="' + prefijo + 'Alcance"]').each(function () { $(this).closest('.hc-opcion').toggleClass('on', this.checked); });
        $('#' + prefijo + 'EmpWrap').toggle(a.alcance === 'PERSONALIZADA');
        $('#' + prefijo + 'EmpCuenta').text(fmt(T.EmpSeleccionadas, a.empresas.length));
        $('#' + prefijo + 'EmpSel').html(a.empresas.map(function (id) {
            return '<span class="hc-emp-chip">' + esc(nombreEmpresa(id)) + '<button type="button" data-quitar="' + id + '" data-pref="' + prefijo + '">&times;</button></span>';
        }).join(''));
    }
    $(document).on('change', 'input[type=radio][name$="Alcance"], .aEmp, .wEmp', function () {
        var pref = this.name && /Alcance$/.test(this.name) ? this.name.replace('Alcance', '') : ($(this).hasClass('aEmp') ? 'a' : 'w');
        refrescarAlcance(pref);
        if (pref === 'a') estadoAlcanceTab();
    });
    $(document).on('input', '#aEmpQ, #wEmpQ', function () {
        var q = this.value.toLowerCase(), pref = this.id.charAt(0);
        $('.' + pref + 'Emp').closest('.hc-emp').each(function () { $(this).toggle($(this).data('nombre').indexOf(q) >= 0); });
    });
    $(document).on('click', '.hc-emp-chip button', function () {
        var pref = $(this).data('pref');
