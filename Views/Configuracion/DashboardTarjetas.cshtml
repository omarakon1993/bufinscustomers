@model List<bufinscustomers.Models.DashboardTarjeta>
@using bufinscustomers.Helpers
@using System.Web.Script.Serialization

<!DOCTYPE html>
<html>
<head>
    <title>Dashboard · Tarjetas</title>
    <script src="~/Assets/js/sweetalert2.all.min.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script src="~/Assets/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Assets/Scripts/bootstrap.bundle.min.js"></script>
    <link href="~/Assets/css/configuracion-admin.css" rel="stylesheet" />
    <style>
        .dash-tipo-badge { font-size:.7rem; font-weight:700; padding:2px 8px; border-radius:5px; display:inline-block; }
        .dash-tipo-kpi   { background:#583AFF; color:#fff; }
        .dash-tipo-info  { background:#01E1D7; color:#160933; }
        .form-sec-title  { font-size:.72rem; font-weight:700; color:#6B6787; text-transform:uppercase; letter-spacing:.8px; margin:1rem 0 .5rem; padding-top:.75rem; border-top:1px solid #eee; }
        .sql-hint        { font-size:.72rem; color:#6c757d; background:#f8f9fc; border-radius:6px; padding:.5rem .75rem; border-left:3px solid #583AFF; margin-top:.3rem; }
        .sql-hint code   { color:#583AFF; font-size:.7rem; }
        .sql-area        { font-family:'Courier New',monospace; font-size:.8rem; min-height:120px; resize:vertical; }
    </style>
</head>
<body>

@{
    var successMsg = TempData["SuccessMessage"] as string;
    var errorMsg   = TempData["ErrorMessage"]   as string;
    var jss        = new JavaScriptSerializer();
    var jsonData   = jss.Serialize(Model.Select(t => new {
        t.Id, t.Nombre, t.Tipo, t.Icono, t.ColorIcono, t.Orden, t.Activo,
        t.ConsultaSQL, t.UnidadValor,
        t.InfoTitulo, t.InfoSubtitulo, t.InfoCuerpo, t.InfoUrlAccion, t.InfoTextoAccion
    }));
}

@if (!string.IsNullOrEmpty(successMsg))
{
<script>document.addEventListener('DOMContentLoaded',function(){Swal.fire({icon:'success',title:'¡Listo!',text:@Html.Raw("'" + successMsg.Replace("'","\\'") + "'"),timer:2500,showConfirmButton:false});});</script>
}
@if (!string.IsNullOrEmpty(errorMsg))
{
<script>document.addEventListener('DOMContentLoaded',function(){Swal.fire({icon:'error',title:'Error',text:@Html.Raw("'" + errorMsg.Replace("'","\\'") + "'")});});</script>
}

<!-- ===== TABLA ===== -->
<div class="card shadow mb-4 mt-4">
    <div class="card-header d-flex align-items-center justify-content-between">
        <span><i class="fas fa-th-large"></i> Dashboard &middot; Tarjetas</span>
        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrear">
            <i class="fas fa-plus"></i> Nueva tarjeta
        </button>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive table-wrapper">
            <table class="table table-bordered table-hover table-compact">
                <thead>
                    <tr>
                        <th style="width:40px">#</th>
                        <th style="width:65px">Tipo</th>
                        <th>Nombre</th>
                        <th style="width:70px;text-align:center">Icono</th>
                        <th style="width:55px;text-align:center">Orden</th>
                        <th style="width:80px;text-align:center">Estado</th>
                        <th style="width:100px;text-align:center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-3">No hay tarjetas registradas.</td></tr>
                    }
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td>@t.Id</td>
                            <td>
                                @if (t.Tipo == 1) { <span class="dash-tipo-badge dash-tipo-kpi">KPI</span> }
                                else              { <span class="dash-tipo-badge dash-tipo-info">Info</span> }
                            </td>
                            <td><strong>@t.Nombre</strong></td>
                            <td style="text-align:center"><i class="@t.Icono" style="color:@t.ColorIcono;font-size:1.1rem"></i></td>
                            <td style="text-align:center">@t.Orden</td>
                            <td style="text-align:center">
                                @if (t.Activo) { <span class="badge-activo">Activa</span> }
                                else           { <span class="badge-inactivo">Inactiva</span> }
                            </td>
                            <td style="text-align:center">
                                <button class="btn btn-xs btn-outline-secondary me-1" onclick="cargarEditar(@t.Id)" title="Editar">
                                    <i class="fas fa-pen"></i>
                                </button>
                                <button class="btn btn-xs btn-outline-danger" onclick="confirmarEliminar(@t.Id,'@Html.Raw(t.Nombre?.Replace("'","\\'")??"")')" title="Eliminar">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ===== MODAL CREAR ===== -->
<div class="modal fade" id="modalCrear" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-plus"></i> Nueva tarjeta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            @using (Html.BeginForm("Crear", "DashboardTarjetas", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <!-- Campos comunes -->
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">Nombre <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" name="Nombre" id="c_Nombre" required maxlength="100" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Tipo</label>
                            <select class="form-select form-select-sm" name="Tipo" id="c_Tipo" onchange="toggleCampos('c',this.value)">
                                <option value="1">KPI / Valor</option>
                                <option value="2">Info</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Orden</label>
                            <input type="number" class="form-control form-control-sm" name="Orden" id="c_Orden" value="0" min="0" />
                        </div>
                        <div class="col-md-1 d-flex align-items-end pb-1">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="Activo" id="c_Activo" value="true" checked />
                                <label class="form-check-label small" for="c_Activo">Act.</label>
                            </div>
                        </div>
                    </div>
                    <div class="row g-2 mt-1">
                        <div class="col-md-5">
                            <label class="form-label">Icono <small class="text-muted">(FontAwesome)</small></label>
                            <input type="text" class="form-control form-control-sm" name="Icono" id="c_Icono" placeholder="fas fa-chart-bar" value="fas fa-chart-bar" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Color icono</label>
                            <div class="input-group input-group-sm">
                                <input type="color" class="form-control form-control-sm form-control-color" name="ColorIcono" id="c_ColorIcono" value="#583AFF" style="width:44px;padding:2px" />
                                <input type="text" class="form-control form-control-sm" id="c_ColorText" value="#583AFF" maxlength="7" />
                            </div>
                        </div>
                    </div>
                    <!-- KPI -->
                    <div id="c_sec_kpi">
                        <div class="form-sec-title"><i class="fas fa-chart-bar"></i> Configuración KPI</div>
                        <div class="mb-2">
                            <label class="form-label">Consulta SQL</label>
                            <textarea class="form-control form-control-sm sql-area" name="ConsultaSQL" id="c_ConsultaSQL" rows="5"
                                      placeholder="SELECT e.Id AS IdEmpresa, e.Nombre AS NombreEmpresa, FORMAT(COUNT(*),'N0') AS Valor, 'cargues últimos 7d' AS Etiqueta&#10;FROM Empresas e LEFT JOIN ... GROUP BY e.Id, e.Nombre"></textarea>
                            <div class="sql-hint">
                                Columnas requeridas: <code>IdEmpresa</code>, <code>Valor</code> &nbsp;|&nbsp;
                                Opcionales: <code>NombreEmpresa</code>, <code>Etiqueta</code>
                            </div>
                        </div>
                        <div style="max-width:200px">
                            <label class="form-label">Unidad / sufijo</label>
                            <input type="text" class="form-control form-control-sm" name="UnidadValor" id="c_UnidadValor" placeholder="COP M, %, ud" maxlength="30" />
                        </div>
                    </div>
                    <!-- Info -->
                    <div id="c_sec_info" style="display:none">
                        <div class="form-sec-title"><i class="fas fa-info-circle"></i> Configuración Info</div>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label">Título</label>
                                <input type="text" class="form-control form-control-sm" name="InfoTitulo" id="c_InfoTitulo" maxlength="100" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Subtítulo</label>
                                <input type="text" class="form-control form-control-sm" name="InfoSubtitulo" id="c_InfoSubtitulo" maxlength="200" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Cuerpo</label>
                                <textarea class="form-control form-control-sm" name="InfoCuerpo" id="c_InfoCuerpo" rows="3"></textarea>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">URL acción</label>
                                <input type="text" class="form-control form-control-sm" name="InfoUrlAccion" id="c_InfoUrlAccion" placeholder="/Informes/AnalisisIA" maxlength="300" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Texto acción</label>
                                <input type="text" class="form-control form-control-sm" name="InfoTextoAccion" id="c_InfoTextoAccion" placeholder="Ver más" maxlength="100" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Crear</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- ===== MODAL EDITAR ===== -->
<div class="modal fade" id="modalEditar" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-pen"></i> Editar tarjeta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            @using (Html.BeginForm("Editar", "DashboardTarjetas", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="e_Id" />
                <div class="modal-body">
                    <!-- Campos comunes -->
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">Nombre <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" name="Nombre" id="e_Nombre" required maxlength="100" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Tipo</label>
                            <select class="form-select form-select-sm" name="Tipo" id="e_Tipo" onchange="toggleCampos('e',this.value)">
                                <option value="1">KPI / Valor</option>
                                <option value="2">Info</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Orden</label>
                            <input type="number" class="form-control form-control-sm" name="Orden" id="e_Orden" min="0" />
                        </div>
                        <div class="col-md-1 d-flex align-items-end pb-1">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="Activo" id="e_Activo" value="true" />
                                <label class="form-check-label small" for="e_Activo">Act.</label>
                            </div>
                        </div>
                    </div>
                    <div class="row g-2 mt-1">
                        <div class="col-md-5">
                            <label class="form-label">Icono <small class="text-muted">(FontAwesome)</small></label>
                            <input type="text" class="form-control form-control-sm" name="Icono" id="e_Icono" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Color icono</label>
                            <div class="input-group input-group-sm">
                                <input type="color" class="form-control form-control-sm form-control-color" name="ColorIcono" id="e_ColorIcono" value="#583AFF" style="width:44px;padding:2px" />
                                <input type="text" class="form-control form-control-sm" id="e_ColorText" value="#583AFF" maxlength="7" />
                            </div>
                        </div>
                    </div>
                    <!-- KPI -->
                    <div id="e_sec_kpi">
                        <div class="form-sec-title"><i class="fas fa-chart-bar"></i> Configuración KPI</div>
                        <div class="mb-2">
                            <label class="form-label">Consulta SQL</label>
                            <textarea class="form-control form-control-sm sql-area" name="ConsultaSQL" id="e_ConsultaSQL" rows="5"></textarea>
                            <div class="sql-hint">
                                Columnas requeridas: <code>IdEmpresa</code>, <code>Valor</code> &nbsp;|&nbsp;
                                Opcionales: <code>NombreEmpresa</code>, <code>Etiqueta</code>
                            </div>
                        </div>
                        <div style="max-width:200px">
                            <label class="form-label">Unidad / sufijo</label>
                            <input type="text" class="form-control form-control-sm" name="UnidadValor" id="e_UnidadValor" maxlength="30" />
                        </div>
                    </div>
                    <!-- Info -->
                    <div id="e_sec_info" style="display:none">
                        <div class="form-sec-title"><i class="fas fa-info-circle"></i> Configuración Info</div>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label">Título</label>
                                <input type="text" class="form-control form-control-sm" name="InfoTitulo" id="e_InfoTitulo" maxlength="100" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Subtítulo</label>
                                <input type="text" class="form-control form-control-sm" name="InfoSubtitulo" id="e_InfoSubtitulo" maxlength="200" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Cuerpo</label>
                                <textarea class="form-control form-control-sm" name="InfoCuerpo" id="e_InfoCuerpo" rows="3"></textarea>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">URL acción</label>
                                <input type="text" class="form-control form-control-sm" name="InfoUrlAccion" id="e_InfoUrlAccion" maxlength="300" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Texto acción</label>
                                <input type="text" class="form-control form-control-sm" name="InfoTextoAccion" id="e_InfoTextoAccion" maxlength="100" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Guardar</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Form eliminar oculto -->
@using (Html.BeginForm("Eliminar", "DashboardTarjetas", FormMethod.Post, new { id = "frmElim" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="elimId" />
}

<script>
    var _tarjetas = @Html.Raw(jsonData);

    function toggleCampos(pfx, tipo) {
        document.getElementById(pfx + '_sec_kpi').style.display  = parseInt(tipo) === 1 ? '' : 'none';
        document.getElementById(pfx + '_sec_info').style.display = parseInt(tipo) === 1 ? 'none' : '';
    }

    // Sincronizar color picker ↔ text
    ['c', 'e'].forEach(function(p) {
        var picker = document.getElementById(p + '_ColorIcono');
        var text   = document.getElementById(p + '_ColorText');
        if (picker) picker.addEventListener('input', function() { text.value = picker.value; });
        if (text)   text.addEventListener('input',   function() { if (/^#[0-9a-fA-F]{6}$/.test(text.value)) picker.value = text.value; });
    });

    document.getElementById('modalCrear').addEventListener('show.bs.modal', function() {
        toggleCampos('c', document.getElementById('c_Tipo').value);
    });

    function cargarEditar(id) {
        var t = _tarjetas.find(function(x) { return x.Id === id; });
        if (!t) { return; }

        document.getElementById('e_Id').value              = t.Id;
        document.getElementById('e_Nombre').value          = t.Nombre || '';
        document.getElementById('e_Tipo').value            = t.Tipo;
        document.getElementById('e_Icono').value           = t.Icono || '';
        document.getElementById('e_ColorIcono').value      = t.ColorIcono || '#583AFF';
        document.getElementById('e_ColorText').value       = t.ColorIcono || '#583AFF';
        document.getElementById('e_Orden').value           = t.Orden;
        document.getElementById('e_Activo').checked        = t.Activo;
        document.getElementById('e_ConsultaSQL').value     = t.ConsultaSQL || '';
        document.getElementById('e_UnidadValor').value     = t.UnidadValor || '';
        document.getElementById('e_InfoTitulo').value      = t.InfoTitulo || '';
        document.getElementById('e_InfoSubtitulo').value   = t.InfoSubtitulo || '';
        document.getElementById('e_InfoCuerpo').value      = t.InfoCuerpo || '';
        document.getElementById('e_InfoUrlAccion').value   = t.InfoUrlAccion || '';
        document.getElementById('e_InfoTextoAccion').value = t.InfoTextoAccion || '';

        toggleCampos('e', t.Tipo);
        $('#modalEditar').modal('show');
    }

    function confirmarEliminar(id, nombre) {
        Swal.fire({
            title: '¿Eliminar tarjeta?',
            text: '"' + nombre + '" se eliminará permanentemente.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#e74a3b',
            cancelButtonText: 'Cancelar',
            confirmButtonText: 'Sí, eliminar'
        }).then(function(r) {
            if (r.isConfirmed) {
                document.getElementById('elimId').value = id;
                document.getElementById('frmElim').submit();
            }
        });
    }
</script>
</body>
</html>
