@model IEnumerable<bufinscustomers.Models.Reportes>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Maestro de reportes</title>
    <script src="~/Assets/js/sweetalert2.all.min.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script src="~/Assets/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Assets/Scripts/bootstrap.bundle.min.js"></script>
</head>
<body>
    <style>
        .table-wrapper {
            max-height: 280px;
            overflow-y: auto;
        }

        .bg-primary {
            background-color: #583AFF !important; /* Cambia el color de fondo del encabezado del modal */
        }

        .enlace-reporte {
            color: #007bff;
            text-decoration: none;
            cursor: pointer;
            font-size: 1.2em;
            transition: color 0.3s ease;
        }

        .enlace-reporte:hover {
            color: #0056b3;
            text-decoration: none;
        }

        .enlace-reporte.disabled {
            color: #6c757d;
            cursor: not-allowed;
        }

        .enlace-reporte.invalid {
            color: #dc3545;
            cursor: not-allowed;
        }

        .url-input {
            position: relative;
        }

        .url-feedback {
            font-size: 0.875em;
            margin-top: 0.25rem;
        }

        .url-feedback.valid {
            color: #28a745;
        }

        .url-feedback.invalid {
            color: #dc3545;
        }

        /* === COLORES === */
        :root {
            --color-primario: #583AFF;
            --color-secundario: #01E1D7;
        }

        /* === ENCABEZADO CARD === */
        .card-header {
            background: linear-gradient(90deg, var(--color-primario), var(--color-secundario));
            color: white;
            padding: 1.2rem 1.5rem;
            font-weight: 600;
            font-size: 1.2rem;
        }

        .card-header i {
            margin-right: 8px;
        }
    </style>

    <div class="card shadow mb-4 mt-4">
        <div class="card-header">
            <i class="bi bi-file-earmark-bar-graph-fill"></i> Maestro reportes
        </div>
        <div class="card-body">
            <div class="table-responsive table-wrapper">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Empresa</th>
                            <th>Nombre</th>
                            <th>A&ntildeo Inicial</th>
                            <th>A&ntildeo Final</th>
                            <th>Descripci&oacuten</th>
                            <th style="text-align: center;">Ver Reporte</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reporte in Model)
                        {
                            <tr>
                                <td>@reporte.Id</td>
                                <td>@reporte.NombreEmpresa</td>
                                <td>@reporte.Nombre</td>
                                <td>@(reporte.AnioInicial ?? "")</td>
                                <td>@(reporte.AnioFinal ?? "")</td>
                                <td>@(reporte.Descripcion ?? "")</td>
                                <td style="text-align: center;">
                                    @if (!string.IsNullOrEmpty(reporte.EnlaceHTML))
                                    {
                                        <a href="#" onclick="abrirEnlaceValidado('@(Html.AttributeEncode(reporte.EnlaceHTML))', this)" class="enlace-reporte" title="Verificar y abrir reporte">
                                            <i class="fas fa-external-link-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <i class="fas fa-ban enlace-reporte disabled" title="Sin enlace disponible"></i>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group" aria-label="Reporte Actions">
                                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#editReporteModal"
                                                data-id="@reporte.Id" 
                                                data-idempresa="@reporte.IdEmpresa" 
                                                data-nombre="@Html.AttributeEncode(reporte.Nombre ?? "")" 
                                                data-anioinicial="@Html.AttributeEncode(reporte.AnioInicial ?? "")" 
                                                data-aniofinal="@Html.AttributeEncode(reporte.AnioFinal ?? "")" 
                                                data-descripcion="@Html.AttributeEncode(reporte.Descripcion ?? "")" 
                                                data-enlacehtml="@Html.AttributeEncode(reporte.EnlaceHTML ?? "")"
                                                onclick="setEditReporteFromData(this)">
                                            Editar
                                        </button>
                                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal" onclick="setIdReporte(@reporte.Id)">
                                            Eliminar
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer">
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#crearReporteModal">
                Crear
            </button>
        </div>
    </div>

    <!-- Modal de confirmacion para eliminar -->
    <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="confirmDeleteModalLabel">Confirmar eliminaci&oacute;n</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    &iquestEst&aacute;s seguro de que deseas eliminar este reporte?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <form id="deleteForm" method="post" action="/Reportes/EliminarReporte">
                        <input type="hidden" id="idReporte" name="idReporte" />
                        <button type="submit" class="btn btn-danger">Eliminar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de edición -->
    <div class="modal fade" id="editReporteModal" tabindex="-1" aria-labelledby="editReporteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="editReporteModalLabel">Editar Reporte</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <form method="post" action="/Reportes/EditarReporte" onsubmit="return validarFormularioEditar()">
                    <div class="modal-body">
                        <input type="hidden" id="editIdReporte" name="Id" />
                        
                        <div class="form-group">
                            <label for="editIdEmpresa">Empresa:</label>
                            <select class="form-control" id="editIdEmpresa" name="IdEmpresa" required>
                                <option value="">Seleccione una empresa</option>
                                @foreach (var empresa in ViewBag.Empresas as List<bufinscustomers.Models.Empresas>)
                                {
                                    <option value="@empresa.Id">@empresa.Nombre</option>
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="editNombre">Nombre:</label>
                            <input type="text" class="form-control" id="editNombre" name="Nombre" required />
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="editAnioInicial">A&ntildeo Inicial:</label>
                                    <input type="text" class="form-control" id="editAnioInicial" name="AnioInicial" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="editAnioFinal">A&ntildeo Final:</label>
                                    <input type="text" class="form-control" id="editAnioFinal" name="AnioFinal" />
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="editDescripcion">Descripci&oacuten:</label>
                            <textarea class="form-control" id="editDescripcion" name="Descripcion" rows="3"></textarea>
                        </div>

                        <div class="form-group url-input">
                            <label for="editEnlaceHTML">Enlace HTML:</label>
                            <input type="text" class="form-control" id="editEnlaceHTML" name="EnlaceHTML" required oninput="validarURL('editEnlaceHTML', 'editUrlFeedback')" />
                            <div id="editUrlFeedback" class="url-feedback"></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Actualizar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal de creación -->
    <div class="modal fade" id="crearReporteModal" tabindex="-1" aria-labelledby="crearReporteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="crearReporteModalLabel">Crear Nuevo Reporte</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <form method="post" action="/Reportes/CrearReporte" onsubmit="return validarFormularioCrear()">
                    <div class="modal-body">
                        <div class="form-group">
                            <label for="IdEmpresa">Empresa:</label>
                            <select class="form-control" id="IdEmpresa" name="IdEmpresa" required>
                                <option value="">Seleccione una empresa</option>
                                @foreach (var empresa in ViewBag.Empresas as List<bufinscustomers.Models.Empresas>)
                                {
                                    <option value="@empresa.Id">@empresa.Nombre</option>
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="Nombre">Nombre:</label>
                            <input type="text" class="form-control" id="Nombre" name="Nombre" required />
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="AnioInicial">A&ntildeo Inicial:</label>
                                    <input type="text" class="form-control" id="AnioInicial" name="AnioInicial" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="AnioFinal">A&ntildeo Final:</label>
                                    <input type="text" class="form-control" id="AnioFinal" name="AnioFinal" />
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="Descripcion">Descripci&oacuten:</label>
                            <textarea class="form-control" id="Descripcion" name="Descripcion" rows="3"></textarea>
                        </div>

                        <div class="form-group url-input">
                            <label for="EnlaceHTML">Enlace HTML:</label>
                            <input type="text" class="form-control" id="EnlaceHTML" name="EnlaceHTML" required oninput="validarURL('EnlaceHTML', 'createUrlFeedback')" />
                            <div id="createUrlFeedback" class="url-feedback"></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Crear</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            const isMobile = window.innerWidth <= 768;
            Swal.fire({
                toast: true,
                position: isMobile ? 'top' : 'top-end',
                icon: 'error',
                title: '@TempData["ErrorMessage"]',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer);
                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                }
            });
        </script>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            const isMobile = window.innerWidth <= 768;
            Swal.fire({
                toast: true,
                position: isMobile ? 'top' : 'top-end',
                icon: 'success',
                title: '@TempData["SuccessMessage"]',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer);
                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                }
            });
        </script>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <script>
        const isMobile = window.innerWidth <= 768;
        Swal.fire({
            toast: true,
            position: isMobile ? 'top' : 'top-end',
            icon: 'info',
            title: '@TempData["InfoMessage"]',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer);
                toast.addEventListener('mouseleave', Swal.resumeTimer);
            }
        });
        </script>
    }

    <script>

        function esURLValida(url) {
            try {

                if (!url || url.trim() === '') {
                    return true;
                }

                url = url.trim();

                const urlPattern = /^(https?:\/\/)?([\w\-]+\.)+[\w\-]+(\/.*)?$/i;
                

                try {

                    let urlParaValidar = url;
                    if (!url.match(/^https?:\/\//i)) {
                        urlParaValidar = 'https://' + url;
                    }
                    
                    const urlObj = new URL(urlParaValidar);
                    

                    const dominioValido = /^[\w\-]+(\.[\w\-]+)+$/.test(urlObj.hostname);
                    
                    return dominioValido || urlPattern.test(url);
                } catch (e) {

                    return urlPattern.test(url);
                }
            } catch (e) {
                return false;
            }
        }

 
        function validarURL(inputId, feedbackId) {
            const input = document.getElementById(inputId);
            const feedback = document.getElementById(feedbackId);
            const url = input.value.trim();

            if (url === '') {
                feedback.textContent = '';
                feedback.className = 'url-feedback';
                return true;
            }

            if (esURLValida(url)) {
                feedback.textContent = 'URL correcta';
                feedback.className = 'url-feedback valid';
                return true;
            } else {
                feedback.textContent = 'URL incorrecta. Ejemplos validos: https://ejemplo.com, app.powerbi.com/view';
                feedback.className = 'url-feedback invalid';
                return false;
            }
        }

 
        function abrirEnlaceValidado(url, elemento) {
            if (!url || url.trim() === '') {
                Swal.fire({
                    toast: true,
                    position: window.innerWidth <= 768 ? 'top' : 'top-end',
                    icon: 'warning',
                    title: 'No hay enlace disponible',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
                return false;
            }


            if (url.trim().length < 3) {
                Swal.fire({
                    toast: true,
                    position: window.innerWidth <= 768 ? 'top' : 'top-end',
                    icon: 'error',
                    title: 'El enlace es muy corto o no valido',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
                return false;
            }

  
            let enlaceFinal = url.trim();
            if (!enlaceFinal.startsWith('http://') && !enlaceFinal.startsWith('https://')) {
                enlaceFinal = 'https://' + enlaceFinal;
            }

            try {
                window.open(enlaceFinal, '_blank');
                return true;
            } catch (e) {
                Swal.fire({
                    toast: true,
                    position: window.innerWidth <= 768 ? 'top' : 'top-end',
                    icon: 'error',
                    title: 'Error al abrir el enlace',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
                return false;
            }
        }


        function validarFormularioCrear() {
            const url = document.getElementById('EnlaceHTML').value.trim();
            if (url !== '' && !esURLValida(url)) {
                Swal.fire({
                    toast: true,
                    position: window.innerWidth <= 768 ? 'top' : 'top-end',
                    icon: 'error',
                    title: 'Por favor, ingresa una URL correcta',
                    text: 'Ejemplos: https://ejemplo.com, app.powerbi.com/view',
                    showConfirmButton: false,
                    timer: 4000,
                    timerProgressBar: true
                });
                return false;
            }
            return true;
        }


        function validarFormularioEditar() {
            const url = document.getElementById('editEnlaceHTML').value.trim();
            if (url !== '' && !esURLValida(url)) {
                Swal.fire({
                    toast: true,
                    position: window.innerWidth <= 768 ? 'top' : 'top-end',
                    icon: 'error',
                    title: 'Por favor, ingresa una URL correcta',
                    text: 'Ejemplos: https://ejemplo.com, app.powerbi.com/view',
                    showConfirmButton: false,
                    timer: 4000,
                    timerProgressBar: true
                });
                return false;
            }
            return true;
        }

        function setIdReporte(id) {
            document.getElementById("idReporte").value = id;
        }

        function setEditReporte(id, idEmpresa, nombre, anioInicial, anioFinal, descripcion, enlaceHTML) {
            document.getElementById("editIdReporte").value = id;
            document.getElementById("editIdEmpresa").value = idEmpresa;
            document.getElementById("editNombre").value = nombre;
            document.getElementById("editAnioInicial").value = anioInicial;
            document.getElementById("editAnioFinal").value = anioFinal;
            document.getElementById("editDescripcion").value = descripcion;
            document.getElementById("editEnlaceHTML").value = enlaceHTML;
            // Validar URL al cargar
            validarURL('editEnlaceHTML', 'editUrlFeedback');
        }

        function setEditReporteFromData(button) {
            var id = button.getAttribute('data-id');
            var idEmpresa = button.getAttribute('data-idempresa');
            var nombre = button.getAttribute('data-nombre');
            var anioInicial = button.getAttribute('data-anioinicial');
            var anioFinal = button.getAttribute('data-aniofinal');
            var descripcion = button.getAttribute('data-descripcion');
            var enlaceHTML = button.getAttribute('data-enlacehtml');
            
            document.getElementById("editIdReporte").value = id;
            document.getElementById("editIdEmpresa").value = idEmpresa;
            document.getElementById("editNombre").value = nombre;
            document.getElementById("editAnioInicial").value = anioInicial;
            document.getElementById("editAnioFinal").value = anioFinal;
            document.getElementById("editDescripcion").value = descripcion;
            document.getElementById("editEnlaceHTML").value = enlaceHTML;
            // Validar URL al cargar
            validarURL('editEnlaceHTML', 'editUrlFeedback');
        }
    </script>
</body>
</html>
