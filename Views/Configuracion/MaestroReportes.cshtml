@model IEnumerable<bufinscustomers.Models.Reportes>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <title>@Resources.Strings.Rep_PageTitle</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script src="~/Assets/js/sweetalert2.all.min.js"></script>
    <script src="~/Assets/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Assets/Scripts/bootstrap.bundle.min.js"></script>
</head>
<body>
    <style>
        :root {
            --color-primario: #583AFF;
            --color-secundario: #01E1D7;
        }

        .bg-primary {
            background-color: #583AFF !important;
        }

        /* === TABLA COMPACTA === */
        .table-wrapper {
            max-height: 450px;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .table-compact {
            table-layout: fixed;
            width: 100%;
            margin-bottom: 0;
        }

        .table-compact thead th {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            color: #fff;
            padding: 0.5rem 0.4rem;
            white-space: nowrap;
            border-bottom: 2px solid #dee2e6;
            background: var(--content-gradient);
            position: sticky;
            top: 0;
            z-index: 1;
        }

        .table-compact tbody td {
            font-size: 0.8rem;
            padding: 0.35rem 0.4rem;
            vertical-align: middle;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .table-compact tbody tr:hover {
            background-color: #f0edff;
        }

        /* Anchos de columna */
        .col-id          { width: 4%;  text-align: center; }
        .col-empresa     { width: 14%; }
        .col-nombre      { width: 16%; }
        .col-anio-ini    { width: 8%;  text-align: center; }
        .col-anio-fin    { width: 8%;  text-align: center; }
        .col-desc        { width: 22%; }
        .col-ver         { width: 7%;  text-align: center; }
        .col-acciones    { width: 21%; text-align: center; white-space: nowrap; }

        /* === BOTONES DE ACCIONES === */
        .btn-group { gap: 0.25rem; }

        .btn-group .btn {
            padding: 0.2rem 0.45rem;
            font-size: 0.75rem;
            border-radius: 0.25rem;
        }

        .btn-group .btn i { margin-right: 0; }

        /* Enlace de reporte */
        .enlace-reporte {
            color: var(--color-primario);
            text-decoration: none;
            cursor: pointer;
            font-size: 1.1em;
            transition: color 0.3s ease;
        }

        .enlace-reporte:hover {
            color: #583AFF;
            text-decoration: none;
        }

        .enlace-reporte.disabled {
            color: #6c757d;
            cursor: not-allowed;
        }

        .enlace-reporte.invalid {
            color: #dc3545;
            cursor: not-allowed;
        }

        /* Feedback URL */
        .url-input { position: relative; }

        .url-feedback {
            font-size: 0.875em;
            margin-top: 0.25rem;
        }

        .url-feedback.valid  { color: #28a745; }
        .url-feedback.invalid { color: #dc3545; }
    </style>

    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas fa-file-powerpoint powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@Resources.Strings.Rep_PageTitle</h1>
        </div>
    </div>

    <div class="card shadow mb-4 mt-4">
        <div class="card-body p-0">
            <div class="table-responsive table-wrapper">
                <table class="table table-bordered table-hover table-compact" id="dataTable">
                    <thead>
                        <tr>
                            <th class="col-id">Id</th>
                            <th class="col-empresa">@Resources.Strings.Rep_ThEmpresa</th>
                            <th class="col-nombre">@Resources.Strings.Rep_LabelNombre</th>
                            <th class="col-anio-ini">@Resources.Strings.Rep_ThAnioIni</th>
                            <th class="col-anio-fin">@Resources.Strings.Rep_ThAnioFin</th>
                            <th class="col-desc">@Resources.Strings.Common_LabelDescripcion</th>
                            <th class="col-ver">@Resources.Strings.Rep_ThVer</th>
                            <th class="col-acciones">@Resources.Strings.Common_ThAcciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-3">
                                    @Resources.Strings.Rep_NoReportes
                                </td>
                            </tr>
                        }
                        @foreach (var reporte in Model)
                        {
                            <tr>
                                <td class="col-id">@reporte.Id</td>
                                <td class="col-empresa" title="@reporte.NombreEmpresa"><strong>@reporte.NombreEmpresa</strong></td>
                                <td class="col-nombre" title="@reporte.Nombre">@reporte.Nombre</td>
                                <td class="col-anio-ini">@(reporte.AnioInicial ?? "")</td>
                                <td class="col-anio-fin">@(reporte.AnioFinal ?? "")</td>
                                <td class="col-desc" title="@(reporte.Descripcion ?? "")">@(reporte.Descripcion ?? "")</td>
                                <td class="col-ver">
                                    @if (!string.IsNullOrEmpty(reporte.EnlaceHTML))
                                    {
                                        <a href="#" onclick="abrirEnlaceValidado('@(Html.Raw(reporte.EnlaceHTML))', this); return false;"
                                           class="enlace-reporte" title="@Resources.Strings.Rep_TitleAbrir">
                                            <i class="fas fa-external-link-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <i class="fas fa-ban enlace-reporte disabled" title="@Resources.Strings.Rep_TitleSinEnlace"></i>
                                    }
                                </td>
                                <td class="col-acciones">
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-primary btn-sm"
                                                data-toggle="modal" data-target="#editReporteModal"
                                                data-id="@reporte.Id"
                                                data-idempresa="@reporte.IdEmpresa"
                                                data-nombre="@Html.Raw(reporte.Nombre ?? "")"
                                                data-anioinicial="@Html.Raw(reporte.AnioInicial ?? "")"
                                                data-aniofinal="@Html.Raw(reporte.AnioFinal ?? "")"
                                                data-descripcion="@Html.Raw(reporte.Descripcion ?? "")"
                                                data-enlacehtml="@Html.Raw(reporte.EnlaceHTML ?? "")"
                                                onclick="setEditReporteFromData(this)">
                                            <i class="fas fa-edit mr-1"></i>@Resources.Strings.Rep_BtnEditar
                                        </button>
                                        <button type="button" class="btn btn-danger btn-sm"
                                                data-toggle="modal" data-target="#confirmDeleteModal"
                                                onclick="setIdReporte(@reporte.Id)">
                                            <i class="fas fa-trash-alt mr-1"></i>@Resources.Strings.Common_BtnEliminar
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer">
            <button type="button" class="btn-modern-success" data-toggle="modal" data-target="#crearReporteModal">
                <i class="fas fa-plus-circle mr-1"></i> @Resources.Strings.Rep_BtnCrear
            </button>
        </div>
    </div>

    <!-- ═══════════════════ MODAL ELIMINAR ═══════════════════ -->
    <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="confirmDeleteModalLabel">
                        <i class="fas fa-exclamation-triangle mr-2"></i>@Resources.Strings.Common_ModalDeleteTitle
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        <i class="fas fa-question-circle text-warning mr-2"></i>
                        @Resources.Strings.Rep_ModalDeleteBody
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i>@Resources.Strings.Layout_Cancel
                    </button>
                    <form id="deleteForm" method="post" action="/Reportes/EliminarReporte" style="display: inline;">
    @Html.AntiForgeryToken()
                        <input type="hidden" id="idReporte" name="idReporte" />
                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="fas fa-trash-alt mr-1"></i>@Resources.Strings.Common_BtnEliminar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════ MODAL EDITAR ═══════════════════ -->
    <div class="modal fade" id="editReporteModal" tabindex="-1" aria-labelledby="editReporteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editReporteModalLabel">
                        <i class="fas fa-edit mr-2" style="color: #583AFF;"></i>@Resources.Strings.Rep_ModalEditTitle
                    </h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form method="post" action="/Reportes/EditarReporte" onsubmit="return validarFormularioEditar()">
    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <input type="hidden" id="editIdReporte" name="Id" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="editIdEmpresa" class="form-label">
                                    <i class="fas fa-building mr-2" style="color: #583AFF;"></i>@Resources.Strings.Rep_LabelEmpresa <span class="text-danger">*</span>
                                </label>
                                <select class="form-control form-control-sm" id="editIdEmpresa" name="IdEmpresa" required>
                                    <option value="">@Resources.Strings.Rep_SelEmpresa</option>
                                    @foreach (var empresa in ViewBag.Empresas as List<bufinscustomers.Models.Empresas>)
                                    {
                                        <option value="@empresa.Id">@empresa.Nombre</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="editNombre" class="form-label">
                                    <i class="fas fa-file-alt mr-2" style="color: #583AFF;"></i>@Resources.Strings.Rep_LabelNombre <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control form-control-sm" id="editNombre" name="Nombre" required />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="editAnioInicial" class="form-label">
                                    <i class="fas fa-calendar-alt mr-2" style="color: #583AFF;"></i>@Resources.Strings.Rep_LabelAnioInicial
                                </label>
                                <input type="text" class="form-control form-control-sm" id="editAnioInicial" name="AnioInicial" placeholder="Ej: 2023" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="editAnioFinal" class="form-label">
                                    <i class="fas fa-calendar-check mr-2" style="color: #583AFF;"></i>@Resources.Strings.Rep_LabelAnioFinal
                                </label>
                                <input type="text" class="form-control form-control-sm" id="editAnioFinal" name="AnioFinal" placeholder="Ej: 2025" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="editDescripcion" class="form-label">
                                <i class="fas fa-align-left mr-2" style="color: #583AFF;"></i>@Resources.Strings.Common_LabelDescripcion
                            </label>
                            <textarea class="form-control form-control-sm" id="editDescripcion" name="Descripcion" rows="2"></textarea>
                        </div>

                        <div class="mb-3 url-input">
                            <label for="editEnlaceHTML" class="form-label">
                                <i class="fas fa-link mr-2" style="color: #583AFF;"></i>@Resources.Strings.Rep_LabelEnlaceHTML <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control form-control-sm" id="editEnlaceHTML" name="EnlaceHTML" required
                                   oninput="validarURL('editEnlaceHTML', 'editUrlFeedback')" />
                            <div id="editUrlFeedback" class="url-feedback"></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                            <i class="fas fa-times mr-1"></i>@Resources.Strings.Layout_Cancel
                        </button>
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fas fa-save mr-1"></i>@Resources.Strings.Rep_BtnActualizar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ═══════════════════ MODAL CREAR ═══════════════════ -->
    <div class="modal fade" id="crearReporteModal" tabindex="-1" aria-labelledby="crearReporteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="crearReporteModalLabel">
                        <i class="fas fa-plus-circle mr-2" style="color: #583AFF;"></i>@Resources.Strings.Rep_ModalCreateTitle
                    </h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form method="post" action="/Reportes/CrearReporte" onsubmit="return validarFormularioCrear()">
    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="IdEmpresa" class="form-label">
                                    <i class="fas fa-building mr-2" style="color: #583AFF;"></i>@Resources.Strings.Rep_LabelEmpresa <span class="text-danger">*</span>
                                </label>
                                <select class="form-control form-control-sm" id="IdEmpresa" name="IdEmpresa" required>
                                    <option value="">@Resources.Strings.Rep_SelEmpresa</option>
                                    @foreach (var empresa in ViewBag.Empresas as List<bufinscustomers.Models.Empresas>)
                                    {
                                        <option value="@empresa.Id">@empresa.Nombre</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="Nombre" class="form-label">
                                    <i class="fas fa-file-alt mr-2" style="color: #583AFF;"></i>@Resources.Strings.Rep_LabelNombre <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control form-control-sm" id="Nombre" name="Nombre" required />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="AnioInicial" class="form-label">
                                    <i class="fas fa-calendar-alt mr-2" style="color: #583AFF;"></i>@Resources.Strings.Rep_LabelAnioInicial
                                </label>
                                <input type="text" class="form-control form-control-sm" id="AnioInicial" name="AnioInicial" placeholder="Ej: 2023" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="AnioFinal" class="form-label">
                                    <i class="fas fa-calendar-check mr-2" style="color: #583AFF;"></i>@Resources.Strings.Rep_LabelAnioFinal
                                </label>
                                <input type="text" class="form-control form-control-sm" id="AnioFinal" name="AnioFinal" placeholder="Ej: 2025" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="Descripcion" class="form-label">
                                <i class="fas fa-align-left mr-2" style="color: #583AFF;"></i>@Resources.Strings.Common_LabelDescripcion
                            </label>
                            <textarea class="form-control form-control-sm" id="Descripcion" name="Descripcion" rows="2"></textarea>
                        </div>

                        <div class="mb-3 url-input">
                            <label for="EnlaceHTML" class="form-label">
                                <i class="fas fa-link mr-2" style="color: #583AFF;"></i>@Resources.Strings.Rep_LabelEnlaceHTML <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control form-control-sm" id="EnlaceHTML" name="EnlaceHTML" required
                                   oninput="validarURL('EnlaceHTML', 'createUrlFeedback')" />
                            <div id="createUrlFeedback" class="url-feedback"></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                            <i class="fas fa-times mr-1"></i>@Resources.Strings.Layout_Cancel
                        </button>
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fas fa-plus-circle mr-1"></i>@Resources.Strings.Common_BtnCrear
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            var isMobile1 = window.innerWidth <= 768;
            Swal.fire({
                toast: true,
                position: isMobile1 ? 'top' : 'top-end',
                icon: 'error',
                title: '@TempData["ErrorMessage"]',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer);
                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                }
            });
        </script>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            var isMobile2 = window.innerWidth <= 768;
            Swal.fire({
                toast: true,
                position: isMobile2 ? 'top' : 'top-end',
                icon: 'success',
                title: '@TempData["SuccessMessage"]',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer);
                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                }
            });
        </script>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <script>
            var isMobile3 = window.innerWidth <= 768;
            Swal.fire({
                toast: true,
                position: isMobile3 ? 'top' : 'top-end',
                icon: 'info',
                title: '@TempData["InfoMessage"]',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer);
                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                }
            });
        </script>
    }

    <script>
        var _urlCorrecta   = '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Rep_JS_URLCorrecta)';
        var _urlIncorrecta = '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Rep_JS_URLIncorrecta)';

        function esURLValida(url) {
            try {
                if (!url || url.trim() === '') {
                    return true;
                }

                url = url.trim();
                var urlPattern = /^(https?:\/\/)?([\w\-]+\.)+[\w\-]+(\/.*)?$/i;

                try {
                    var urlParaValidar = url;
                    if (!url.match(/^https?:\/\//i)) {
                        urlParaValidar = 'https://' + url;
                    }

                    var urlObj = new URL(urlParaValidar);
                    var dominioValido = /^[\w\-]+(\.[\w\-]+)+$/.test(urlObj.hostname);

                    return dominioValido || urlPattern.test(url);
                } catch (e) {
                    return urlPattern.test(url);
                }
            } catch (e) {
                return false;
            }
        }

        function validarURL(inputId, feedbackId) {
            var input = document.getElementById(inputId);
            var feedback = document.getElementById(feedbackId);
            var url = input.value.trim();

            if (url === '') {
                feedback.textContent = '';
                feedback.className = 'url-feedback';
                return true;
            }

            if (esURLValida(url)) {
                feedback.textContent = _urlCorrecta;
                feedback.className = 'url-feedback valid';
                return true;
            } else {
                feedback.textContent = _urlIncorrecta;
                feedback.className = 'url-feedback invalid';
                return false;
            }
        }

        function abrirEnlaceValidado(url, elemento) {
            if (!url || url.trim() === '') {
                Swal.fire({
                    toast: true,
                    position: window.innerWidth <= 768 ? 'top' : 'top-end',
                    icon: 'warning',
                    title: '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Rep_JS_SinEnlace)',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
                return false;
            }

            if (url.trim().length < 3) {
                Swal.fire({
                    toast: true,
                    position: window.innerWidth <= 768 ? 'top' : 'top-end',
                    icon: 'error',
                    title: '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Rep_JS_EnlaceCorto)',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
                return false;
            }

            var enlaceFinal = url.trim();
            if (!enlaceFinal.startsWith('http://') && !enlaceFinal.startsWith('https://')) {
                enlaceFinal = 'https://' + enlaceFinal;
            }

            try {
                window.open(enlaceFinal, '_blank');
                return true;
            } catch (e) {
                Swal.fire({
                    toast: true,
                    position: window.innerWidth <= 768 ? 'top' : 'top-end',
                    icon: 'error',
                    title: '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Rep_JS_ErrorAbrir)',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
                return false;
            }
        }

        function validarFormularioCrear() {
            var url = document.getElementById('EnlaceHTML').value.trim();
            if (url !== '' && !esURLValida(url)) {
                Swal.fire({
                    toast: true,
                    position: window.innerWidth <= 768 ? 'top' : 'top-end',
                    icon: 'error',
                    title: '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Rep_JS_IngresaURL)',
                    text: '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Rep_JS_EjemplosURL)',
                    showConfirmButton: false,
                    timer: 4000,
                    timerProgressBar: true
                });
                return false;
            }
            return true;
        }

        function validarFormularioEditar() {
            var url = document.getElementById('editEnlaceHTML').value.trim();
            if (url !== '' && !esURLValida(url)) {
                Swal.fire({
                    toast: true,
                    position: window.innerWidth <= 768 ? 'top' : 'top-end',
                    icon: 'error',
                    title: '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Rep_JS_IngresaURL)',
                    text: '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Rep_JS_EjemplosURL)',
                    showConfirmButton: false,
                    timer: 4000,
                    timerProgressBar: true
                });
                return false;
            }
            return true;
        }

        function setIdReporte(id) {
            document.getElementById("idReporte").value = id;
        }

        function setEditReporteFromData(button) {
            var id = button.getAttribute('data-id');
            var idEmpresa = button.getAttribute('data-idempresa');
            var nombre = button.getAttribute('data-nombre') || '';
            var anioInicial = button.getAttribute('data-anioinicial') || '';
            var anioFinal = button.getAttribute('data-aniofinal') || '';
            var descripcion = button.getAttribute('data-descripcion') || '';
            var enlaceHTML = button.getAttribute('data-enlacehtml') || '';

            document.getElementById("editIdReporte").value = id;
            document.getElementById("editIdEmpresa").value = idEmpresa;
            document.getElementById("editNombre").value = nombre;
            document.getElementById("editAnioInicial").value = anioInicial;
            document.getElementById("editAnioFinal").value = anioFinal;
            document.getElementById("editDescripcion").value = descripcion;
            document.getElementById("editEnlaceHTML").value = enlaceHTML;

            validarURL('editEnlaceHTML', 'editUrlFeedback');
        }
    </script>
</body>
</html>
