@model System.Collections.Generic.List<bufinscustomers.Services.Integracion>
@{
    ViewBag.Title = Resources.Strings.Integ_PageTitle;
    bool disponible = ViewBag.Disponible;
    string idiomaQs = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("en") ? "?idioma=en" : "";
    string baseApi = ViewBag.BaseApi as string;
    var empresas = (System.Collections.Generic.List<bufinscustomers.Models.Empresas>)ViewBag.Empresas
                   ?? new System.Collections.Generic.List<bufinscustomers.Models.Empresas>();
    var direcciones = ViewBag.Direcciones as System.Collections.Generic.Dictionary<int, string>
                      ?? new System.Collections.Generic.Dictionary<int, string>();
    var visibles = Model.Where(x => !x.FechaRevocada.HasValue).ToList();
    var activas = visibles.Where(x => x.Activo).ToList();
    var saludes = ViewBag.Salud as System.Collections.Generic.Dictionary<int, bufinscustomers.Controllers.SaludIntegracionVM>;
    Func<string, string> js = s => HttpUtility.JavaScriptStringEncode(s ?? "");
}

<link href="~/Assets/css/bufins-components.css" rel="stylesheet" />

@Html.AntiForgeryToken()

<div class="container-fluid px-4">

    <div class="powerbi-header" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;overflow:visible !important;">
        <div class="powerbi-header-content">
            <i class="fas fa-plug powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@Resources.Strings.Integ_PageTitle</h1>
        </div>
        @if (disponible)
        {
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
                <div class="dropdown">
                    <button type="button" class="btn btn-outline-secondary cx-menu-toggle" style="padding:.4rem .95rem;font-size:.8125rem;" aria-haspopup="true" aria-expanded="false">
                        <i class="fas fa-book mr-1"></i>@Resources.Strings.Integ_Cx_Documentacion <i class="fas fa-caret-down ml-1"></i>
                    </button>
                    <div class="dropdown-menu dropdown-menu-right">
                        <a class="dropdown-item" href="@Url.Content("~/api/v1/manual")@idiomaQs" target="_blank" rel="noopener"><i class="fas fa-book-open fa-fw mr-1"></i>@Resources.Strings.Integ_BtnManual</a>
                        <a class="dropdown-item" href="@Url.Content("~/api/v1/docs")@idiomaQs" target="_blank" rel="noopener"><i class="fas fa-flask fa-fw mr-1"></i>@Resources.Strings.Integ_BtnProbador</a>
                        <a class="dropdown-item" href="@Url.Content("~/api/v1/openapi.json")" target="_blank" rel="noopener"><i class="fas fa-file-code fa-fw mr-1"></i>@Resources.Strings.Integ_BtnContrato</a>
                    </div>
                </div>
                <button type="button" class="btn-modern-secondary" data-toggle="modal" data-target="#cxAyudaModal">
                    <i class="fas fa-life-ring mr-1"></i>@Resources.Strings.Integ_Cx_Ayuda
                </button>
                <button type="button" class="btn-modern-success" data-toggle="modal" data-target="#integConectarModal">
                    <i class="fas fa-plus mr-1"></i>@Resources.Strings.Integ_Cx_Conectar
                </button>
            </div>
        }
    </div>

    <p class="text-muted mt-3" style="font-size:0.88rem;">
        <i class="fas fa-info-circle mr-1"></i>@Resources.Strings.Integ_PageHint
    </p>

    @if (!disponible)
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle mr-1"></i>@Resources.Strings.Integ_NoDisponible
        </div>
    }
    else if (!visibles.Any())
    {
        <div class="card shadow mb-4">
            <div class="card-body text-center py-5">
                <i class="fas fa-plug fa-2x text-muted mb-3"></i>
                <h5 class="font-weight-bold">@Resources.Strings.Integ_Cx_VacioTitulo</h5>
                <p class="text-muted mb-3">@Resources.Strings.Integ_Cx_VacioTexto</p>
                <button type="button" class="btn btn-success" data-toggle="modal" data-target="#integConectarModal">
                    <i class="fas fa-plus mr-1"></i>@Resources.Strings.Integ_Cx_Conectar
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var i in visibles)
            {
                bufinscustomers.Controllers.SaludIntegracionVM sv = null;
                if (saludes != null) { saludes.TryGetValue(i.Id, out sv); }
                string nivel = !i.Activo ? "inactiva" : (sv != null ? sv.Nivel : "ok");
                string color = nivel == "problema" ? "#dc3545" : nivel == "atencion" ? "#f6a609" : nivel == "inactiva" ? "#adb5bd" : "#1cc88a";
                string direccion = direcciones.TryGetValue(i.IdEmpresa, out var dir) ? dir : baseApi;
                string iniciales = new string((i.NombreEmpresa ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])).ToArray());
                <div class="col-md-6 col-xl-4 mb-3">
                    <div class="card shadow-sm h-100" style="border-left:4px solid @color;">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center" style="gap:10px;">
                                <div class="d-flex align-items-center justify-content-center font-weight-bold" style="width:34px;height:34px;border-radius:10px;background:#eef1ff;color:#4e5bd6;font-size:0.8rem;flex:none;">@iniciales</div>
                                <div class="flex-fill" style="min-width:0;">
                                    <div class="font-weight-bold text-truncate" style="line-height:1.2;">@i.NombreEmpresa</div>
                                    <div class="small" style="color:@color;line-height:1.3;" title="@(sv != null ? string.Join(" · ", sv.Textos) : "")">
                                        <i class="fas fa-circle mr-1" style="font-size:0.5rem;vertical-align:middle;"></i>@if (!i.Activo) { @Resources.Strings.Integ_Cx_Pausada }
                                        else if (sv != null && sv.Textos.Count > 0) { @sv.Textos[0] }
                                        else { @Resources.Strings.Integ_NuncaUsada }
                                    </div>
                                </div>
                                <span class="badge @(i.Sandbox ? "badge-info" : "badge-secondary")" style="flex:none;">@(i.Sandbox ? Resources.Strings.Integ_BadgePruebas : Resources.Strings.Integ_Cx_Real)</span>
                            </div>

                            <div class="d-flex align-items-center mt-3 px-2 py-1" style="background:#f6f7fb;border-radius:8px;gap:8px;">
                                <code class="flex-fill text-truncate" style="font-size:0.8rem;color:#2e3a59;" title="@direccion">@direccion</code>
                                <button type="button" class="btn btn-sm btn-link p-0 cx-copiar-texto" data-texto="@direccion" title="@Resources.Strings.Integ_BtnCopiar"><i class="fas fa-copy"></i></button>
                            </div>
                            <div class="small text-muted mt-1 px-1">@Resources.Strings.Integ_Cx_Clave: <code style="color:#6b7280;">@(i.Sandbox ? "bft_" : "bfk_")@(i.Prefijo)_••••</code></div>

                            <div class="d-flex mt-3" style="gap:8px;">
                                <button type="button" class="btn btn-primary btn-sm flex-fill integ-actividad" data-id="@i.Id" data-nombre="@i.NombreEmpresa">
                                    <i class="fas fa-list-ul mr-1"></i>@Resources.Strings.Integ_Cx_VerEnvios
                                </button>
                                <div class="dropdown">
                                    <button type="button" class="btn btn-sm btn-outline-secondary cx-menu-toggle" aria-haspopup="true" aria-expanded="false" title="@Resources.Strings.Integ_Cx_Mas" aria-label="@Resources.Strings.Integ_Cx_Mas">
                                        <i class="fas fa-ellipsis-h"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-right">
                                        <button type="button" class="dropdown-item integ-editar" data-id="@i.Id" data-nombre="@i.Nombre" data-activo="@(i.Activo ? "1" : "0")"
                                                data-confirma="@(i.PermiteConfirmar ? "1" : "0")" data-ips="@i.IpPermitidas"><i class="fas fa-edit fa-fw mr-1"></i>@Resources.Strings.Integ_Cx_OpEditar</button>
                                        <button type="button" class="dropdown-item integ-rotar" data-id="@i.Id" data-nombre="@i.NombreEmpresa"><i class="fas fa-sync-alt fa-fw mr-1"></i>@Resources.Strings.Integ_Cx_OpClave</button>
                                        <button type="button" class="dropdown-item integ-webhook" data-id="@i.Id" data-nombre="@i.NombreEmpresa"><i class="fas fa-bullhorn fa-fw mr-1"></i>@Resources.Strings.Integ_Cx_OpAvisos</button>
                                        <div class="dropdown-divider"></div>
                                        <button type="button" class="dropdown-item text-danger integ-revocar" data-id="@i.Id" data-nombre="@i.NombreEmpresa"><i class="fas fa-ban fa-fw mr-1"></i>@Resources.Strings.Integ_Cx_OpAnular</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ═══════════════════ MODAL EDITAR ═══════════════════ -->
<div class="modal fade" id="integEditarModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered bf-modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-edit"></i> @Resources.Strings.Integ_ModalEditarTitle</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <form id="integEditarForm" autocomplete="off">
                <input type="hidden" id="editId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="editNombre">@Resources.Strings.Integ_LabelNombre <span class="text-danger">*</span></label>
                        <div class="bf-input"><i class="fas fa-tag"></i>
                            <input type="text" id="editNombre" class="form-control" maxlength="100" required />
                        </div>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="editActiva" />
                        <label class="form-check-label" for="editActiva">@Resources.Strings.Integ_LabelActiva</label>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="editConfirma" />
                        <label class="form-check-label" for="editConfirma">@Resources.Strings.Integ_LabelConfirmar</label>
                        <small class="form-text text-muted">@Resources.Strings.Integ_LabelConfirmarHint</small>
                    </div>
                    <div class="mb-1">
                        <label for="editIps">@Resources.Strings.Integ_LabelIps</label>
                        <textarea id="editIps" class="form-control" rows="2" maxlength="500"></textarea>
                        <small class="form-text text-muted">@Resources.Strings.Integ_LabelIpsHint</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <span class="bf-footer-note"><b>*</b> @Resources.Strings.Common_CamposObligatorios</span>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal"><i class="fas fa-times mr-1"></i>@Resources.Strings.Layout_Cancel</button>
                    <button type="submit" class="btn btn-primary" id="integEditarBtn"><i class="fas fa-save mr-1"></i>@Resources.Strings.Common_GuardarCambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ═══════════════════ MODAL ACTIVIDAD ═══════════════════ -->
<div class="modal fade" id="integActividadModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered bf-modal-wide">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-heartbeat"></i> @Resources.Strings.Integ_Pn_Titulo · <span id="actNombre"></span></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="bf-section">@Resources.Strings.Integ_Pn_SecResumen</div>
                <ul id="actMensajes" class="list-unstyled mb-1"></ul>
                <div id="actConexion" class="small text-muted mb-3"></div>

                <div class="bf-section">@Resources.Strings.Integ_Pn_SecEnvios</div>
                <div id="actSinSeguimiento" class="alert alert-warning small d-none">@Resources.Strings.Integ_Pn_SinSeguimiento</div>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered mb-3">
                        <thead><tr>
                            <th>@Resources.Strings.Integ_Wh_ThFecha</th><th>@Resources.Strings.Integ_Pn_ThArchivo</th><th>@Resources.Strings.Integ_Pn_ThPeriodo</th>
                            <th class="text-right">@Resources.Strings.Integ_Pn_ThFilas</th><th class="text-center">@Resources.Strings.Integ_Pn_ThErrores</th>
                            <th>@Resources.Strings.Integ_Pn_ThSituacion</th><th></th>
                        </tr></thead>
                        <tbody id="actCargues"></tbody>
                    </table>
                </div>

                <div class="bf-section">@Resources.Strings.Integ_Pn_SecModelos</div>
                <ul id="actModelos" class="list-unstyled small mb-3"></ul>

                <div class="bf-section">@Resources.Strings.Integ_Pn_SecAvisos</div>
                <ul id="actAvisos" class="list-unstyled small mb-0"></ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal"><i class="fas fa-times mr-1"></i>@Resources.Strings.Common_Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════ MODAL WEBHOOK ═══════════════════ -->
<div class="modal fade" id="integWebhookModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered bf-modal-wide">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-bullhorn"></i> @Resources.Strings.Integ_Wh_Titulo · <span id="whNombre"></span></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted">@Resources.Strings.Integ_Wh_Hint</p>
                <div id="whNoDisp" class="alert alert-warning d-none"><i class="fas fa-exclamation-triangle mr-1"></i>@Resources.Strings.Integ_Wh_NoDisponible</div>
                <div id="whCuerpo">
                    <div class="bf-section">@Resources.Strings.Integ_Wh_SecConfig</div>
                    <div class="mb-2">
                        <label for="whUrl">@Resources.Strings.Integ_Wh_LabelUrl</label>
                        <div class="bf-input"><i class="fas fa-link"></i>
                            <input type="url" id="whUrl" class="form-control" maxlength="500" placeholder="https://su-sistema.com/bufins/webhook" autocomplete="off" />
                        </div>
                        <small class="form-text text-muted">@Resources.Strings.Integ_Wh_UrlHint</small>
                    </div>
                    <div id="whSecretoBloque" class="d-none mb-3">
                        <div class="alert alert-warning small mb-2"><i class="fas fa-exclamation-triangle mr-1"></i>@Resources.Strings.Integ_Wh_SecretoAviso</div>
                        <div class="input-group">
                            <input type="text" id="whSecretoValor" class="form-control" readonly style="font-family:monospace;" />
                            <div class="input-group-append">
                                <button type="button" class="btn btn-primary" id="whCopiar"><i class="fas fa-copy mr-1"></i>@Resources.Strings.Integ_BtnCopiar</button>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <span id="whSecretoEstado" class="badge badge-secondary"></span>
                    </div>
                    <div class="d-flex flex-wrap" style="gap:8px;">
                        <button type="button" class="btn btn-primary" id="whGuardar"><i class="fas fa-save mr-1"></i>@Resources.Strings.Common_GuardarCambios</button>
                        <button type="button" class="btn btn-secondary" id="whProbar"><i class="fas fa-paper-plane mr-1"></i>@Resources.Strings.Integ_Wh_BtnProbar</button>
                        <button type="button" class="btn btn-warning" id="whRotar"><i class="fas fa-sync-alt mr-1"></i>@Resources.Strings.Integ_Wh_BtnRotar</button>
                    </div>

                    <div class="bf-section mt-4">@Resources.Strings.Integ_Wh_SecEntregas</div>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered mb-0">
                            <thead><tr>
                                <th>@Resources.Strings.Integ_Wh_ThFecha</th><th>@Resources.Strings.Integ_Wh_ThEvento</th><th class="text-center">@Resources.Strings.Common_Estado</th>
                                <th class="text-center">@Resources.Strings.Integ_Wh_ThIntentos</th><th>@Resources.Strings.Integ_Wh_ThDetalle</th>
                            </tr></thead>
                            <tbody id="whEntregas"></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal"><i class="fas fa-times mr-1"></i>@Resources.Strings.Common_Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════ MODAL CONECTAR UNA EMPRESA ═══════════════════ -->
<div class="modal fade" id="integConectarModal" tabindex="-1" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered bf-modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-plug"></i> @Resources.Strings.Integ_Cx_Conectar</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" id="cxX"><span aria-hidden="true">&times;</span></button>
            </div>

            <div id="cxPaso1">
                <div class="modal-body">
                    <h6 class="font-weight-bold">@Resources.Strings.Integ_Cx_Paso1Titulo</h6>
                    <p class="small text-muted">@Resources.Strings.Integ_Cx_Paso1Texto</p>
                    <div class="mb-3">
                        <label for="cxEmpresa">@Resources.Strings.Integ_Cx_Empresa</label>
                        <select id="cxEmpresa" class="form-control">
                            <option value="">@Resources.Strings.Integ_SelEmpresa</option>
                            @foreach (var e in empresas)
                            {
                                <option value="@e.Id">@e.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-sm-6 mb-2">
                            <button type="button" class="btn btn-outline-primary btn-block text-left h-100 cx-tipo" data-valor="1">
                                <span class="d-block w-100">
                                    <strong class="d-block mb-1"><i class="fas fa-flask mr-1"></i>@Resources.Strings.Integ_Cx_TipoPruebasT</strong>
                                    <span class="small d-block" style="white-space:normal;">@Resources.Strings.Integ_Cx_TipoPruebasD</span>
                                </span>
                            </button>
                        </div>
                        <div class="col-sm-6 mb-2">
                            <button type="button" class="btn btn-outline-primary btn-block text-left h-100 cx-tipo" data-valor="0">
                                <span class="d-block w-100">
                                    <strong class="d-block mb-1"><i class="fas fa-database mr-1"></i>@Resources.Strings.Integ_Cx_TipoRealT</strong>
                                    <span class="small d-block" style="white-space:normal;">@Resources.Strings.Integ_Cx_TipoRealD</span>
                                </span>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal"><i class="fas fa-times mr-1"></i>@Resources.Strings.Layout_Cancel</button>
                    <button type="button" class="btn btn-primary" id="cxCrear"><i class="fas fa-plus-circle mr-1"></i>@Resources.Strings.Integ_Cx_BtnCrear</button>
                </div>
            </div>

            <div id="cxListo" class="d-none">
                <div class="modal-body">
                    <div class="text-center mb-3">
                        <i class="fas fa-check-circle fa-2x text-success mb-2"></i>
                        <h6 class="font-weight-bold mb-1" id="cxListoTitulo"></h6>
                        <p class="small text-muted mb-0">@Resources.Strings.Integ_Cx_ListoTexto</p>
                    </div>
                    <label class="small text-muted mb-1">@Resources.Strings.Integ_Cx_Direccion</label>
                    <div class="input-group mb-3">
                        <input type="text" id="cxDir" class="form-control" readonly style="font-family:monospace;" />
                        <div class="input-group-append">
                            <button type="button" class="btn btn-primary cx-copiar" data-origen="#cxDir"><i class="fas fa-copy mr-1"></i>@Resources.Strings.Integ_BtnCopiar</button>
                        </div>
                    </div>
                    <label class="small text-muted mb-1">@Resources.Strings.Integ_Cx_Clave</label>
                    <div class="input-group mb-2">
                        <input type="text" id="cxClave" class="form-control" readonly style="font-family:monospace;" />
                        <div class="input-group-append">
                            <button type="button" class="btn btn-primary cx-copiar" data-origen="#cxClave"><i class="fas fa-copy mr-1"></i>@Resources.Strings.Integ_BtnCopiar</button>
                        </div>
                    </div>
                    <div class="alert alert-warning small mb-3"><i class="fas fa-exclamation-triangle mr-1"></i>@Resources.Strings.Integ_ClaveAviso</div>
                    <button type="button" class="btn btn-secondary btn-block" id="cxInstr"><i class="fas fa-paste mr-1"></i>@Resources.Strings.Integ_Cx_CopiarInstr</button>
                    <div class="small text-muted mt-1 text-center">@Resources.Strings.Integ_Cx_InstrAviso</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" id="cxCerrar"><i class="fas fa-check mr-1"></i>@Resources.Strings.Integ_Cx_YaCopie</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════ MODAL AYUDA ═══════════════════ -->
<div class="modal fade" id="cxAyudaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered bf-modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-life-ring"></i> @Resources.Strings.Integ_As_AyudaTitulo</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="asAyudaInteg">@Resources.Strings.Integ_As_AyudaIntegracion</label>
                    <select id="asAyudaInteg" class="form-control">
                        <option value="">@Resources.Strings.Integ_As_AyudaNinguna</option>
                        @foreach (var a in activas)
                        {
                            <option value="@a.Id">@a.NombreEmpresa</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="asMensaje">@Resources.Strings.Integ_As_AyudaMensaje <span class="text-danger">*</span></label>
                    <textarea id="asMensaje" class="form-control" rows="4" maxlength="1000"></textarea>
                </div>
                <div class="form-group mb-0">
                    <label for="asContacto">@Resources.Strings.Integ_As_AyudaContacto</label>
                    <input type="text" id="asContacto" class="form-control" maxlength="200" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal"><i class="fas fa-times mr-1"></i>@Resources.Strings.Layout_Cancel</button>
                <button type="button" class="btn btn-primary" id="asEnviar"><i class="fas fa-paper-plane mr-1"></i>@Resources.Strings.Integ_As_AyudaEnviar</button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════ MODAL CLAVE (se muestra una sola vez) ═══════════════════ -->
<div class="modal fade" id="integClaveModal" tabindex="-1" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered bf-modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-key"></i> <span id="integClaveTitulo">@Resources.Strings.Integ_ClaveTitulo</span></h5>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning small mb-3"><i class="fas fa-exclamation-triangle mr-1"></i>@Resources.Strings.Integ_ClaveAviso</div>
                <div class="input-group">
                    <input type="text" id="integClaveValor" class="form-control" readonly style="font-family:monospace;" />
                    <div class="input-group-append">
                        <button type="button" class="btn btn-primary" id="integCopiar"><i class="fas fa-copy mr-1"></i>@Resources.Strings.Integ_BtnCopiar</button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="integClaveCerrar"><i class="fas fa-check mr-1"></i>@Resources.Strings.Integ_BtnYaCopie</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
(function () {
    var T = {
        errRed: '@Html.Raw(js(Resources.Strings.Integ_ErrRed))',
        copiado: '@Html.Raw(js(Resources.Strings.Integ_Copiado))',
        claveNuevaTitulo: '@Html.Raw(js(Resources.Strings.Integ_ClaveNuevaTitulo))',
        rotarTitulo: '@Html.Raw(js(Resources.Strings.Integ_ConfRotarTitulo))',
        rotarTexto: '@Html.Raw(js(Resources.Strings.Integ_ConfRotarTexto))',
        revocarTitulo: '@Html.Raw(js(Resources.Strings.Integ_ConfRevocarTitulo))',
        revocarTexto: '@Html.Raw(js(Resources.Strings.Integ_ConfRevocarTexto))',
        btnRotar: '@Html.Raw(js(Resources.Strings.Integ_BtnRotar))',
        btnRevocar: '@Html.Raw(js(Resources.Strings.Integ_BtnRevocar))',
        cancelar: '@Html.Raw(js(Resources.Strings.Layout_Cancel))',
        whSinEntregas: '@Html.Raw(js(Resources.Strings.Integ_Wh_SinEntregas))',
        whSecretoSi: '@Html.Raw(js(Resources.Strings.Integ_Wh_SecretoSi))',
        whSecretoNo: '@Html.Raw(js(Resources.Strings.Integ_Wh_SecretoNo))',
        whRotarTitulo: '@Html.Raw(js(Resources.Strings.Integ_Wh_ConfRotarTitulo))',
        whRotarTexto: '@Html.Raw(js(Resources.Strings.Integ_Wh_ConfRotarTexto))',
        whRotarBtn: '@Html.Raw(js(Resources.Strings.Integ_Wh_BtnRotar))',
        whPendiente: '@Html.Raw(js(Resources.Strings.Integ_Wh_EstadoPendiente))',
        whEntregado: '@Html.Raw(js(Resources.Strings.Integ_Wh_EstadoEntregado))',
        whFallido: '@Html.Raw(js(Resources.Strings.Integ_Wh_EstadoFallido))',
        pnSinEnvios: '@Html.Raw(js(Resources.Strings.Integ_Pn_SinEnvios))',
        pnSinModelos: '@Html.Raw(js(Resources.Strings.Integ_Pn_SinModelos))',
        pnSinAvisos: '@Html.Raw(js(Resources.Strings.Integ_Pn_SinAvisos))',
        pnSinWebhook: '@Html.Raw(js(Resources.Strings.Integ_Pn_SinWebhook))',
        pnUltimoUso: '@Html.Raw(js(Resources.Strings.Integ_Pn_UltimoUso))',
        pnNuncaUsada: '@Html.Raw(js(Resources.Strings.Integ_NuncaUsada))',
        pnRevisar: '@Html.Raw(js(Resources.Strings.Integ_Pn_Revisar))',
        asErrMensaje: '@Html.Raw(js(Resources.Strings.Integ_As_ErrMensaje))',
        cxErrEmpresa: '@Html.Raw(js(Resources.Strings.Integ_Cx_ErrEmpresa))',
        cxListoTitulo: '@Html.Raw(js(Resources.Strings.Integ_Cx_ListoTitulo))',
        cxMensaje: '@Html.Raw(js(Resources.Strings.Integ_Cx_Mensaje))'
    };
    var enlaces = {
        manual: '@Html.Raw(js(baseApi + "/manual" + idiomaQs))',
        docs: '@Html.Raw(js(baseApi + "/docs" + idiomaQs))',
        contrato: '@Html.Raw(js(baseApi + "/openapi.json"))'
    };
    var urls = {
        usuarios: '@Url.Action("UsuariosDeEmpresa", "Integraciones")',
        crear: '@Url.Action("Crear", "Integraciones")',
        editar: '@Url.Action("Editar", "Integraciones")',
        rotar: '@Url.Action("Rotar", "Integraciones")',
        revocar: '@Url.Action("Revocar", "Integraciones")',
        whEstado: '@Url.Action("WebhookEstado", "Integraciones")',
        whGuardar: '@Url.Action("WebhookGuardar", "Integraciones")',
        whRotar: '@Url.Action("WebhookRotar", "Integraciones")',
        whProbar: '@Url.Action("WebhookProbar", "Integraciones")',
        actividad: '@Url.Action("Actividad", "Integraciones")',
        crearConexion: '@Url.Action("CrearConexion", "Integraciones")',
        ayuda: '@Url.Action("SolicitarAyuda", "Integraciones")'
    };

    function token() { return $('input[name="__RequestVerificationToken"]').first().val(); }
    function toast(icon, title) { Swal.fire({ toast: true, position: 'top-end', icon: icon, title: title, showConfirmButton: false, timer: 3500, timerProgressBar: true }); }
    function post(url, datos) {
        datos = datos || {}; datos.__RequestVerificationToken = token();
        return $.post(url, datos).fail(function () { toast('error', T.errRed); });
    }
    function mostrarClave(clave, titulo) {
        $('#integClaveTitulo').text(titulo);
        $('#integClaveValor').val(clave);
        $('#integClaveModal').modal('show');
    }

    $(document).on('click', '.integ-editar', function () {
        var d = $(this).data();
        $('#editId').val(d.id); $('#editNombre').val(d.nombre); $('#editIps').val(d.ips || '');
        $('#editActiva').prop('checked', String(d.activo) === '1'); $('#editConfirma').prop('checked', String(d.confirma) === '1');
        $('#integEditarModal').modal('show');
    });

    $('#integEditarForm').on('submit', function (e) {
        e.preventDefault();
        var $b = $('#integEditarBtn').prop('disabled', true);
        post(urls.editar, {
            id: $('#editId').val(), nombre: $('#editNombre').val(), activo: $('#editActiva').is(':checked'),
            permiteConfirmar: $('#editConfirma').is(':checked'), ipPermitidas: $('#editIps').val()
        }).done(function (r) {
            if (!r.success) { toast('error', r.message); return; }
            location.reload();
        }).always(function () { $b.prop('disabled', false); });
    });

    $(document).on('click', '.integ-rotar', function () {
        var id = $(this).data('id'), nombre = $(this).data('nombre');
        Swal.fire({ icon: 'warning', title: T.rotarTitulo, text: T.rotarTexto.replace('{0}', nombre), showCancelButton: true, confirmButtonText: T.btnRotar, cancelButtonText: T.cancelar })
            .then(function (x) {
                if (!x.isConfirmed) return;
                post(urls.rotar, { id: id }).done(function (r) {
                    if (!r.success) { toast('error', r.message); return; }
                    mostrarClave(r.clave, T.claveNuevaTitulo);
                });
            });
    });

    $(document).on('click', '.integ-revocar', function () {
        var id = $(this).data('id'), nombre = $(this).data('nombre');
        Swal.fire({ icon: 'warning', title: T.revocarTitulo, text: T.revocarTexto.replace('{0}', nombre), showCancelButton: true, confirmButtonText: T.btnRevocar, cancelButtonText: T.cancelar })
            .then(function (x) {
                if (!x.isConfirmed) return;
                post(urls.revocar, { id: id }).done(function (r) {
                    if (!r.success) { toast('error', r.message); return; }
                    location.reload();
                });
            });
    });

    $('#integCopiar').on('click', function () {
        var $i = $('#integClaveValor'); $i.trigger('select');
        var ok = function () { toast('success', T.copiado); };
        if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText($i.val()).then(ok);
        else { document.execCommand('copy'); ok(); }
    });

    // ── Panel de actividad ──
    function claseNivel(n) { return n === 'problema' ? 'text-danger' : (n === 'atencion' ? 'text-warning' : (n === 'inactiva' ? 'text-muted' : 'text-success')); }
    function claseSituacion(s) {
        return s === 'Confirmado' ? 'badge-success' : (s === 'ConErrores' ? 'badge-danger' : (s === 'PendienteRevision' ? 'badge-warning'
            : (s === 'Simulado' ? 'badge-info' : 'badge-secondary')));
    }
    $(document).on('click', '.integ-actividad', function () {
        $('#actNombre').text($(this).data('nombre'));
        $('#actMensajes, #actCargues, #actModelos, #actAvisos').empty(); $('#actConexion').text('');
        $('#integActividadModal').modal('show');
        $.getJSON(urls.actividad, { id: $(this).data('id') }).done(function (r) {
            if (!r.success) { toast('error', r.message); return; }
            var $m = $('#actMensajes').empty();
            $.each(r.mensajes, function (_, t) { $m.append($('<li class="mb-1">').append($('<i class="fas fa-circle mr-2">').addClass(claseNivel(r.nivel))).append(document.createTextNode(t))); });
            $('#actConexion').text(r.ultimoUso ? T.pnUltimoUso.replace('{0}', r.ultimoUso).replace('{1}', r.ipUltimoUso || '') : T.pnNuncaUsada);

            $('#actSinSeguimiento').toggleClass('d-none', !!r.seguimientoDisponible);
            var $c = $('#actCargues').empty();
            if (!r.cargues.length) $c.append($('<tr>').append($('<td colspan="7" class="text-center text-muted">').text(T.pnSinEnvios)));
            $.each(r.cargues, function (_, c) {
                var $fila = $('<tr>')
                    .append($('<td class="small">').text(c.fecha)).append($('<td class="small">').text(c.archivo || ('#' + c.idLote)))
                    .append($('<td class="small">').text(c.periodo)).append($('<td class="small text-right">').text(Number(c.filas).toLocaleString()))
                    .append($('<td class="small text-center">').text(c.errores))
                    .append($('<td class="small">').append($('<span class="badge">').addClass(claseSituacion(c.situacion)).text(c.situacionTexto)));
                var $a = $('<td class="small text-right">');
                if (c.url) $a.append($('<a target="_blank" rel="noopener">').attr('href', c.url).text(T.pnRevisar));
                $c.append($fila.append($a));
            });

            var $mo = $('#actModelos').empty();
            if (!r.modelos.length) $mo.append($('<li class="text-muted">').text(T.pnSinModelos));
            $.each(r.modelos, function (_, e) { $mo.append($('<li>').text(e.inicio + ' · ' + e.estadoTexto + (e.fin ? ' (' + e.fin + ')' : ''))); });

            var $av = $('#actAvisos').empty();
            if (r.entregas === null) $av.append($('<li class="text-muted">').text(T.pnSinWebhook));
            else if (!r.entregas.length) $av.append($('<li class="text-muted">').text(T.pnSinAvisos));
            else $.each(r.entregas, function (_, e) {
                var etq = e.estado === 'Entregado' ? T.whEntregado : (e.estado === 'Fallido' ? T.whFallido : T.whPendiente);
                $av.append($('<li>').text(e.fecha + ' · ' + e.evento + ' · ' + etq + ' (' + e.intentos + ')'));
            });
        }).fail(function () { toast('error', T.errRed); });
    });

    // ── Webhook ──
    var whId = 0;
    function whMostrarSecreto(s) { $('#whSecretoValor').val(s); $('#whSecretoBloque').toggleClass('d-none', !s); }
    function whCargar() {
        $.getJSON(urls.whEstado, { id: whId }).done(function (r) {
            if (!r.success) { toast('error', r.message); return; }
            $('#whNoDisp').toggleClass('d-none', !!r.disponible); $('#whCuerpo').toggleClass('d-none', !r.disponible);
            if (!r.disponible) return;
            $('#whUrl').val(r.url || '');
            $('#whSecretoEstado').text(r.tieneSecreto ? T.whSecretoSi : T.whSecretoNo).toggleClass('badge-success', r.tieneSecreto).toggleClass('badge-secondary', !r.tieneSecreto);
            $('#whRotar').prop('disabled', !r.tieneSecreto);
            var $b = $('#whEntregas').empty();
            if (!r.entregas.length) { $b.append($('<tr>').append($('<td colspan="5" class="text-center text-muted">').text(T.whSinEntregas))); return; }
            $.each(r.entregas, function (_, e) {
                var etq = e.estado === 'Entregado' ? T.whEntregado : (e.estado === 'Fallido' ? T.whFallido : T.whPendiente);
                var cls = e.estado === 'Entregado' ? 'badge-success' : (e.estado === 'Fallido' ? 'badge-danger' : 'badge-warning');
                $b.append($('<tr>')
                    .append($('<td class="small">').text(e.fecha)).append($('<td class="small">').append($('<code>').text(e.evento)))
                    .append($('<td class="text-center">').append($('<span class="badge">').addClass(cls).text(etq)))
                    .append($('<td class="text-center">').text(e.intentos))
                    .append($('<td class="small">').text(e.error || (e.codigo ? 'HTTP ' + e.codigo : ''))));
            });
        }).fail(function () { toast('error', T.errRed); });
    }
    $(document).on('click', '.integ-webhook', function () {
        whId = $(this).data('id'); $('#whNombre').text($(this).data('nombre')); whMostrarSecreto(''); $('#whUrl').val('');
        $('#integWebhookModal').modal('show'); whCargar();
    });
    $('#whGuardar').on('click', function () {
        var $b = $(this).prop('disabled', true);
        post(urls.whGuardar, { id: whId, url: $('#whUrl').val() }).done(function (r) {
            if (!r.success) { toast('error', r.message); return; }
            toast('success', r.message); whMostrarSecreto(r.secreto || ''); whCargar();
        }).always(function () { $b.prop('disabled', false); });
    });
    $('#whProbar').on('click', function () {
        var $b = $(this).prop('disabled', true);
        post(urls.whProbar, { id: whId }).done(function (r) { toast(r.success ? 'success' : 'error', r.message); whCargar(); })
            .always(function () { $b.prop('disabled', false); });
    });
    $('#whRotar').on('click', function () {
        Swal.fire({ icon: 'warning', title: T.whRotarTitulo, text: T.whRotarTexto, showCancelButton: true, confirmButtonText: T.whRotarBtn, cancelButtonText: T.cancelar })
            .then(function (x) {
                if (!x.isConfirmed) return;
                post(urls.whRotar, { id: whId }).done(function (r) {
                    if (!r.success) { toast('error', r.message); return; }
                    toast('success', r.message); whMostrarSecreto(r.secreto); whCargar();
                });
            });
    });
    $('#whCopiar').on('click', function () {
        var $i = $('#whSecretoValor'); $i.trigger('select');
        var ok = function () { toast('success', T.copiado); };
        if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText($i.val()).then(ok);
        else { document.execCommand('copy'); ok(); }
    });
    $('#integWebhookModal').on('hidden.bs.modal', function () { whMostrarSecreto(''); });

    // ── Menús desplegables propios (el sitio no carga Popper, que los de Bootstrap necesitan) ──
    function cerrarMenus() { $('.cx-menu-toggle').attr('aria-expanded', 'false').siblings('.dropdown-menu').removeClass('show'); }
    $(document).on('click', '.cx-menu-toggle', function (e) {
        e.stopPropagation();
        var $m = $(this).siblings('.dropdown-menu'), abrir = !$m.hasClass('show');
        cerrarMenus();
        if (abrir) { $m.addClass('show'); $(this).attr('aria-expanded', 'true'); }
    });
    $(document).on('click', cerrarMenus);
    $(document).on('keydown', function (e) { if (e.key === 'Escape') cerrarMenus(); });

    // ── Conectar una empresa ──
    function copiarTexto(texto) {
        var ok = function () { toast('success', T.copiado); };
        if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(texto).then(ok);
        else { var $t = $('<textarea>').val(texto).appendTo('body'); $t[0].select(); document.execCommand('copy'); $t.remove(); ok(); }
    }
    var cxSandbox = '1', cxEmpresaNombre = '', cxDireccion = '';
    function cxTipo(v) {
        cxSandbox = v;
        $('.cx-tipo').each(function () {
            var on = String($(this).data('valor')) === v;
            $(this).toggleClass('btn-primary', on).toggleClass('btn-outline-primary', !on);
        });
    }
    $(document).on('click', '.cx-tipo', function () { cxTipo(String($(this).data('valor'))); });
    $(document).on('click', '.cx-copiar', function () { copiarTexto($($(this).data('origen')).val()); });
    $(document).on('click', '.cx-copiar-texto', function () { copiarTexto(String($(this).data('texto'))); });
    $('#integConectarModal').on('show.bs.modal', function () {
        $('#cxPaso1').removeClass('d-none'); $('#cxListo').addClass('d-none'); $('#cxX').removeClass('d-none');
        $('#cxEmpresa').val(''); cxTipo('1');
    });
    $('#cxCrear').on('click', function () {
        var idEmpresa = $('#cxEmpresa').val();
        if (!idEmpresa) { toast('warning', T.cxErrEmpresa); return; }
        var $b = $(this).prop('disabled', true);
        post(urls.crearConexion, { idEmpresa: idEmpresa, sandbox: cxSandbox === '1' }).done(function (r) {
            if (!r.success) { toast('error', r.message); return; }
            cxEmpresaNombre = r.empresa;
            $('#cxPaso1').addClass('d-none'); $('#cxListo').removeClass('d-none'); $('#cxX').addClass('d-none');
            $('#cxListoTitulo').text(T.cxListoTitulo.replace('{0}', r.empresa));
            cxDireccion = r.direccion; $('#cxDir').val(r.direccion); $('#cxClave').val(r.clave);
        }).always(function () { $b.prop('disabled', false); });
    });
    $('#cxInstr').on('click', function () {
        copiarTexto(T.cxMensaje.replace('{0}', cxEmpresaNombre).replace(/\{1\}/g, cxDireccion).replace('{2}', enlaces.manual).replace('{3}', enlaces.docs));
    });
    // La clave se borra de la pantalla al terminar y se recarga el listado.
    $('#cxCerrar').on('click', function () { $('#cxClave').val(''); location.reload(); });

    // ── Pedir ayuda ──
    $('#cxAyudaModal').on('hidden.bs.modal', function () { $('#asMensaje, #asContacto').val(''); });
    $('#asEnviar').on('click', function () {
        var mensaje = $.trim($('#asMensaje').val());
        if (!mensaje) { toast('warning', T.asErrMensaje); $('#asMensaje').trigger('focus'); return; }
        var $b = $(this).prop('disabled', true);
        post(urls.ayuda, { idIntegracion: $('#asAyudaInteg').val(), mensaje: mensaje, contacto: $('#asContacto').val() })
            .done(function (r) {
                toast(r.success ? 'success' : 'error', r.message);
                if (r.success) $('#cxAyudaModal').modal('hide');
            }).always(function () { $b.prop('disabled', false); });
    });

    // La clave no se vuelve a mostrar: al cerrar se borra del formulario y se recarga el listado.
    $('#integClaveCerrar').on('click', function () { $('#integClaveValor').val(''); location.reload(); });
})();
</script>
}
