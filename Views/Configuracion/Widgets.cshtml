                        <div class="col-md-1 mb-3 d-flex align-items-end pb-1">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="Activo" id="e_Activo" value="true" />
                                <label class="form-check-label small" for="e_Activo">Act.</label>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-5 mb-3">
                            <label><i class="fas fa-icons mr-1" style="color:#583AFF"></i>Icono <small class="text-muted">(FontAwesome)</small></label>
                            <input type="text" class="form-control form-control-sm" name="Icono" id="e_Icono" />
                        </div>
                        <div class="col-md-4 mb-3">
