<script>
    var _tarjetas = @Html.Raw(jsonData);

    var EJEMPLOS = {
        KPI:  @Html.Raw(jss.Serialize(ejemploKpi)),
        GRAF: @Html.Raw(jss.Serialize(ejemploGraf)),
        ADV:  @Html.Raw(jss.Serialize(ejemploAdv))
    };

    function usarEjemplo(pfx, tipo) {
        var map = { KPI: pfx + '_ConsultaSQL_KPI', GRAF: pfx + '_ConsultaSQL_GRAF', ADV: pfx + '_ConsultaSQL_ADV' };
        document.getElementById(map[tipo]).value = EJEMPLOS[tipo];
    }

    function toggleCampos(pfx) {
        var tipoEl   = document.querySelector('#' + pfx + '_tipoGroup input:checked');
        var fuenteEl = document.querySelector('#' + pfx + '_fuenteGroup input:checked');
        var tipo   = tipoEl   ? parseInt(tipoEl.value)   : 1;
        var fuente = fuenteEl ? parseInt(fuenteEl.value) : 1;
        var esSQL  = fuente === 1;

        document.getElementById(pfx + '_sec_kpi').style.display  = tipo === 1 ? '' : 'none';
        document.getElementById(pfx + '_sec_graf').style.display = tipo === 2 ? '' : 'none';
        document.getElementById(pfx + '_sec_adv').style.display  = tipo === 3 ? '' : 'none';
        document.getElementById(pfx + '_sec_apariencia').style.display = tipo === 3 ? 'none' : '';

        document.getElementById(pfx + '_bloque_sp').style.display = esSQL ? 'none' : '';
        document.getElementById(pfx + '_kpi_sql').style.display   = esSQL ? '' : 'none';
        document.getElementById(pfx + '_graf_sql').style.display  = esSQL ? '' : 'none';
        document.getElementById(pfx + '_adv_sql').style.display   = esSQL ? '' : 'none';
        document.getElementById(pfx + '_ejemplo_kpi').style.display  = (esSQL && tipo === 1) ? '' : 'none';
        document.getElementById(pfx + '_ejemplo_graf').style.display = (esSQL && tipo === 2) ? '' : 'none';
        document.getElementById(pfx + '_ejemplo_adv').style.display  = (esSQL && tipo === 3) ? '' : 'none';

        var kpi  = document.getElementById(pfx + '_ConsultaSQL_KPI');
        var graf = document.getElementById(pfx + '_ConsultaSQL_GRAF');
        var adv  = document.getElementById(pfx + '_ConsultaSQL_ADV');
        var sp   = document.getElementById(pfx + '_NombreSP');

        kpi.name  = (esSQL && tipo === 1) ? 'ConsultaSQL' : 'ConsultaSQL_KPI_disabled';
        graf.name = (esSQL && tipo === 2) ? 'ConsultaSQL' : 'ConsultaSQL_GRAF_disabled';
        adv.name  = (esSQL && tipo === 3) ? 'ConsultaSQL' : 'ConsultaSQL_ADV_disabled';
        kpi.disabled  = !(esSQL && tipo === 1);
        graf.disabled = !(esSQL && tipo === 2);
        adv.disabled  = !(esSQL && tipo === 3);
        sp.disabled   = esSQL;
    }

    ['c', 'e'].forEach(function(p) {
        var picker = document.getElementById(p + '_ColorIcono');
        var text   = document.getElementById(p + '_ColorText');
        if (picker) picker.addEventListener('input', function() { text.value = picker.value; });
        if (text)   text.addEventListener('input',   function() { if (/^#[0-9a-fA-F]{6}$/.test(text.value)) picker.value = text.value; });

        var iconoInput   = document.getElementById(p + '_Icono');
        var iconoPreview = document.getElementById(p + '_IconoPreview');
        if (iconoInput && iconoPreview) {
            iconoInput.addEventListener('input', function() {
                iconoPreview.className = iconoInput.value.trim() || 'fas fa-question';
            });
        }
    });

    $('#modalCrear').on('show.bs.modal', function() {
        toggleCampos('c');
        var prev = document.getElementById('c_IconoPreview');
        if (prev) prev.className = document.getElementById('c_Icono').value || 'fas fa-chart-bar';
    });

    function cargarEditar(id) {
        var t = _tarjetas.find(function(x) { return x.Id === id; });
        if (!t) return;

        document.getElementById('e_Id').value          = t.Id;
        document.getElementById('e_Nombre').value      = t.Nombre || '';
        document.getElementById('e_NombreEn').value    = t.NombreEn || '';
        document.getElementById('e_tipo_' + t.Tipo).checked = true;
        document.getElementById('e_fuente_' + (t.TipoFuente === 2 ? 'sp' : 'sql')).checked = true;
        document.getElementById('e_sev_' + (t.Severidad || 'warning')).checked = true;
        document.querySelectorAll('#e_sec_adv input[name="Subtipo"]').forEach(function(r) { r.checked = false; });
        if (t.Subtipo === 'plantilla' || t.Subtipo === 'modelo') {
            document.getElementById('e_sub_' + t.Subtipo).checked = true;
        }
        document.getElementById('e_NombreSP').value    = t.NombreSP || '';
        document.getElementById('e_Icono').value       = t.Icono || '';
        document.getElementById('e_IconoPreview').className = t.Icono || 'fas fa-chart-bar';
        document.getElementById('e_ColorIcono').value  = t.ColorIcono || '#583AFF';
        document.getElementById('e_ColorText').value   = t.ColorIcono || '#583AFF';
        document.getElementById('e_Orden').value       = t.Orden;
        document.getElementById('e_Activo').checked    = t.Activo;
        document.getElementById('e_UnidadValor').value = t.UnidadValor || '';
        document.getElementById('e_TipoGrafico').value = t.TipoGrafico || 'bar';
        document.getElementById('e_FondoOscuro').checked = !!t.FondoOscuro;

        document.getElementById('e_ConsultaSQL_KPI').value  = t.Tipo === 1 ? (t.ConsultaSQL || '') : '';
        document.getElementById('e_ConsultaSQL_GRAF').value = t.Tipo === 2 ? (t.ConsultaSQL || '') : '';
        document.getElementById('e_ConsultaSQL_ADV').value  = t.Tipo === 3 ? (t.ConsultaSQL || '') : '';

        toggleCampos('e');
    }

    $('#eliminarModal').on('show.bs.modal', function (event) {
        var btn = $(event.relatedTarget);
        $('#eliminarId').val(btn.data('id'));
        $('#eliminarNombre').text(btn.data('nombre'));
    });

    // ───────────── Drag & drop para reordenar (mismo mecanismo que Gestor de Menús) ─────────────
    var _dragSrcRow = null;

    function initDragOrden() {
        var tbody = document.querySelector('#tablaWidgets tbody');
        if (!tbody) return;

        Array.from(tbody.querySelectorAll('tr[draggable="true"]')).forEach(function (row) {
            row.addEventListener('dragstart', function () {
                _dragSrcRow = row;
                row.classList.add('dragging-row');
            });
            row.addEventListener('dragend', function () {
                row.classList.remove('dragging-row');
                tbody.querySelectorAll('.drag-over-row').forEach(function (r) { r.classList.remove('drag-over-row'); });
            });
            row.addEventListener('dragover', function (e) {
                e.preventDefault();
                if (!_dragSrcRow || _dragSrcRow === row) return;
                tbody.querySelectorAll('.drag-over-row').forEach(function (r) { r.classList.remove('drag-over-row'); });
                row.classList.add('drag-over-row');
                var bounding = row.getBoundingClientRect();
                var offset = e.clientY - bounding.top;
                if (offset > bounding.height / 2) {
                    row.parentNode.insertBefore(_dragSrcRow, row.nextSibling);
                } else {
                    row.parentNode.insertBefore(_dragSrcRow, row);
                }
            });
            row.addEventListener('drop', function (e) {
                e.preventDefault();
                row.classList.remove('drag-over-row');
                solicitarGuardarOrden();
            });
        });
    }

    var _guardarTimeout = null;
    var _guardandoOrden = false;
    var _reintentarAlTerminar = false;

    function solicitarGuardarOrden() {
        if (_guardarTimeout) clearTimeout(_guardarTimeout);
        _guardarTimeout = setTimeout(function () {
            if (_guardandoOrden) { _reintentarAlTerminar = true; return; }
            guardarNuevoOrden();
        }, 300);
    }

    function guardarNuevoOrden() {
        var tbody = document.querySelector('#tablaWidgets tbody');
        var filas = Array.from(tbody.querySelectorAll('tr[data-id]'));
        if (filas.length === 0) return;

        var mapaWidgets = {};
        _tarjetas.forEach(function (w) { mapaWidgets[w.Id] = w; });

        var ids = [];
        var ordenes = [];
        filas.forEach(function (fila, idx) {
            var id = parseInt(fila.dataset.id);
            if (!mapaWidgets[id]) return;
            ids.push(id);
            ordenes.push(idx + 1);
        });

        _guardandoOrden = true;

        $.ajax({
            url: '@Url.Action("ActualizarOrden", "Widgets")',
            type: 'POST',
            data: {
                ids: ids,
                ordenes: ordenes,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val()
            },
            traditional: true,
            success: function (response) {
                var icon = response.success ? 'success' : 'error';
                if (response.success) {
                    ids.forEach(function (id, idx) { if (mapaWidgets[id]) mapaWidgets[id].Orden = ordenes[idx]; });
                    filas.forEach(function (fila) {
                        var id = parseInt(fila.dataset.id);
                        var celda = fila.querySelector('.col-orden');
                        if (celda && mapaWidgets[id]) celda.textContent = mapaWidgets[id].Orden;
                    });
                }
                Swal.fire({ toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end', icon: icon, title: response.message, showConfirmButton: false, timer: 2500, timerProgressBar: true });
            },
            error: function () {
                Swal.fire({ toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end', icon: 'error', title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Wid_ErrorActualizarOrden))', showConfirmButton: false, timer: 3000, timerProgressBar: true });
            },
            complete: function () {
                _guardandoOrden = false;
                if (_reintentarAlTerminar) { _reintentarAlTerminar = false; guardarNuevoOrden(); }
            }
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        toggleCampos('c');
        initDragOrden();
    });
</script>
</body>
</html>
