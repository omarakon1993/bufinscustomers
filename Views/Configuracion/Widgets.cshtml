@model List<bufinscustomers.Models.WidgetTarjeta>
@using bufinscustomers.Helpers
@using System.Web.Script.Serialization

<!DOCTYPE html>
<html>
<head>
    <title>@Resources.Strings.Wid_PageTitle</title>
    <script src="~/Assets/js/sweetalert2.all.min.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="~/Assets/css/configuracion-admin.css" rel="stylesheet" />
    <style>
        /* ---------- Tabla ---------- */
        .gestor-hint { font-size:.75rem; color:#6c757d; margin:.5rem 0 .75rem; display:flex; align-items:center; gap:.4rem; }
        #tablaWidgets tbody tr[draggable="true"] { cursor:grab; transition: background-color .15s, opacity .15s; }
        #tablaWidgets tbody tr.dragging-row { opacity:.4; }
        #tablaWidgets tbody tr.drag-over-row { background-color:#ede9ff; }
        .col-handle { width:34px; text-align:center; color:#b7b3cf; }
        .col-handle i { font-size:.95rem; }

        .dash-tipo-badge   { font-size:.7rem; font-weight:700; padding:2px 8px; border-radius:5px; display:inline-block; white-space:nowrap; }
        .dash-tipo-kpi     { background:#583AFF; color:#fff; }
        .dash-tipo-graf    { background:#01E1D7; color:#160933; }
        .dash-tipo-adv     { background:#f59e0b; color:#160933; }
        .dash-fuente-badge { background:#eef0f7; color:#4b4b66; font-size:.68rem; font-weight:600; padding:3px 9px; border-radius:5px; display:inline-flex; align-items:center; gap:5px; white-space:nowrap; }
        .dash-nombre-en { font-size:.7rem; color:#8a86a3; margin-top:1px; display:flex; align-items:center; gap:4px; }
        .dash-nombre-en i { font-size:.62rem; }

        .icono-preview { width:28px; height:28px; border-radius:6px; background:#f8f9fc; border:1px solid #e5e3f2; display:inline-flex; align-items:center; justify-content:center; font-size:.85rem; flex-shrink:0; }

        .wid-empty { color:#A0A0B8; }
        .wid-empty i { font-size:2.4rem; color:#583AFF; opacity:.35; margin-bottom:.6rem; display:block; }
        .wid-empty h4 { font-size:1rem; font-weight:700; color:#160933; margin-bottom:.25rem; }
        .wid-empty p { font-size:.8rem; margin:0; }

        /* ---------- Modales: secciones ---------- */
        #modalCrear .modal-body, #modalEditar .modal-body { padding:1rem 1.15rem; }
        #modalCrear .modal-body .mb-3, #modalEditar .modal-body .mb-3 { margin-bottom:.55rem !important; }
        #modalCrear .modal-body .row, #modalEditar .modal-body .row {
            margin-left:-6px; margin-right:-6px; margin-bottom:.3rem;
        }
        #modalCrear .modal-body .row > [class*="col-"], #modalEditar .modal-body .row > [class*="col-"] {
            padding-left:6px; padding-right:6px;
        }
        #modalCrear .modal-body label, #modalEditar .modal-body label { margin-bottom:.25rem; font-size:.78rem; }

        .form-sec-title  { font-size:.68rem; font-weight:700; color:#6B6787; text-transform:uppercase; letter-spacing:.8px; margin:0 0 .45rem; display:flex; align-items:center; gap:.35rem; }
        .form-sec-title i { font-size:.76rem; }
        .form-sec        { margin-bottom:.7rem; padding-bottom:.6rem; border-bottom:1px solid #eee; }
        .form-sec:last-child { border-bottom:none; padding-bottom:0; margin-bottom:0; }

        /* ---------- Switch "Activo" ---------- */
        .wid-switch { position:relative; width:38px; height:21px; margin-top:2px; flex-shrink:0; }
        .wid-switch input { position:absolute; opacity:0; width:0; height:0; }
        .wid-switch label {
            position:absolute; inset:0; margin:0; cursor:pointer; border-radius:99px;
            background:#d9d6ec; transition:background .15s;
        }
        .wid-switch label::after {
            content:''; position:absolute; top:2px; left:2px; width:17px; height:17px;
            border-radius:50%; background:#fff; box-shadow:0 1px 3px rgba(0,0,0,.25); transition:transform .15s;
        }
        .wid-switch input:checked + label { background:#583AFF; }
        .wid-switch input:checked + label::after { transform:translateX(17px); }

        /* ---------- Selector de Tipo (tarjetas) ---------- */
        .wtype-row { display:flex; gap:.5rem; flex-wrap:wrap; }
        .wtype-card-wrap { flex:1 1 130px; position:relative; }
        .wtype-card-wrap input { position:absolute; opacity:0; width:0; height:0; }
        .wtype-card {
            display:flex; flex-direction:column; gap:.1rem; cursor:pointer;
            border:2px solid #e5e3f2; border-radius:8px; padding:.5rem .6rem;
            background:#fff; height:100%; transition:border-color .15s, background .15s;
        }
        .wtype-card i { font-size:.85rem; color:#583AFF; margin-bottom:.15rem; }
        .wtype-card .t { font-size:.74rem; font-weight:700; color:#160933; }
        .wtype-card .d { font-size:.64rem; color:#8a86a3; line-height:1.25; }
        .wtype-card-wrap input:checked + .wtype-card { border-color:#583AFF; background:linear-gradient(180deg,#f5f3ff,#fff); }
        .wtype-card-wrap input:focus-visible + .wtype-card { outline:2px solid #583AFF; outline-offset:1px; }

        /* ---------- Selector de Fuente (segmentado) ---------- */
        .wseg-row { display:inline-flex; border:1px solid #d9d6ec; border-radius:8px; overflow:hidden; }
        .wseg-row input { position:absolute; opacity:0; width:0; height:0; }
        .wseg-row label {
            margin:0; padding:.35rem .8rem; font-size:.74rem; font-weight:600; color:#6B6787;
            cursor:pointer; background:#fff; display:flex; align-items:center; gap:.35rem; transition:background .15s,color .15s;
        }
        .wseg-row label i { color:inherit; font-size:.8rem; }
        .wseg-row label:not(:last-of-type) { border-right:1px solid #d9d6ec; }
        .wseg-row input:checked + label { background:#583AFF; color:#fff; }
        .wseg-row input:checked + label i { color:#fff; }

        /* ---------- Selector de Severidad (chips) ---------- */
        .wsev-row { display:flex; gap:.4rem; flex-wrap:wrap; }
        .wsev-chip-wrap input { position:absolute; opacity:0; width:0; height:0; }
        .wsev-chip {
            display:flex; align-items:center; gap:.35rem; cursor:pointer; font-size:.74rem; font-weight:600;
            border:2px solid #e5e3f2; border-radius:99px; padding:.3rem .75rem; color:#6B6787; transition:all .15s;
        }
        .wsev-chip .dot { width:10px; height:10px; border-radius:50%; }
        .wsev-success .dot { background:#22c55e; } .wsev-warning .dot { background:#f59e0b; } .wsev-error .dot { background:#ef4444; }
        .wsev-chip-wrap input:checked + .wsev-success { border-color:#22c55e; background:#f0fdf4; color:#15803d; }
        .wsev-chip-wrap input:checked + .wsev-warning { border-color:#f59e0b; background:#fffbeb; color:#92400e; }
        .wsev-chip-wrap input:checked + .wsev-error   { border-color:#ef4444; background:#fef2f2; color:#b91c1c; }

        /* ---------- Guía de columnas + ejemplo ---------- */
        .sql-cols { font-size:.7rem; color:#4b4b66; background:#f8f9fc; border-radius:7px; padding:.45rem .65rem; margin-top:.35rem; }
        .sql-cols .grp { display:block; margin-bottom:.15rem; }
        .sql-cols .grp:last-child { margin-bottom:0; }
        .sql-cols .lbl { font-weight:700; margin-right:.3rem; }
        .sql-cols .lbl.req { color:#b91c1c; } .sql-cols .lbl.opt { color:#6B6787; }
        .sql-cols code { background:#fff; border:1px solid #e5e3f2; border-radius:4px; padding:1px 5px; font-size:.68rem; color:#583AFF; }

        .sql-example { margin-top:.45rem; border:1px solid #e5e3f2; border-radius:7px; overflow:hidden; }
        .sql-example-hdr { display:flex; align-items:center; justify-content:space-between; background:#f8f9fc; padding:.3rem .6rem; border-bottom:1px solid #e5e3f2; }
        .sql-example-hdr span { font-size:.64rem; font-weight:700; color:#6B6787; text-transform:uppercase; letter-spacing:.5px; }
        .sql-example-hdr button { border:none; background:#583AFF; color:#fff; font-size:.63rem; font-weight:600; padding:.18rem .55rem; border-radius:5px; cursor:pointer; }
        .sql-example-hdr button:hover { background:#4527e0; }
        .sql-example pre { margin:0; padding:.5rem .7rem; font-size:.68rem; line-height:1.4; color:#160933; background:#fff; overflow-x:auto; font-family:'Courier New',monospace; }

        .sql-area { font-family:'Courier New',monospace; font-size:.76rem; min-height:95px; resize:vertical; }
        .fondo-switch { display:flex; align-items:center; gap:.5rem; }
        .fondo-switch .preview { width:28px; height:28px; border-radius:6px; border:1px solid #ddd; }
    </style>
</head>
<body>

@{
    var successMsg = TempData["SuccessMessage"] as string;
    var errorMsg   = TempData["ErrorMessage"]   as string;
    var jss        = new JavaScriptSerializer();
    var jsonData   = jss.Serialize(Model.Select(t => new {
        t.Id, t.Nombre, t.NombreEn, t.Tipo, t.Icono, t.ColorIcono, t.Orden, t.Activo,
        t.ConsultaSQL, t.UnidadValor, t.TipoGrafico, t.FondoOscuro,
        t.TipoFuente, t.NombreSP, t.Severidad, t.Subtipo
    }));

    string ejemploKpi  = "SELECT e.Id AS IdEmpresa, e.Nombre AS NombreEmpresa,\n       FORMAT(COUNT(*), 'N0') AS Valor, 'cargues' AS Etiqueta, 'loads' AS EtiquetaEn\nFROM Empresas e\nLEFT JOIN Cargues c ON c.IdEmpresa = e.Id\nGROUP BY e.Id, e.Nombre";
    string ejemploGraf = "SELECT e.Id AS IdEmpresa, e.Nombre AS NombreEmpresa,\n       MONTH(c.Fecha) AS Etiqueta, DATENAME(MONTH, c.Fecha) AS EtiquetaEn, SUM(c.Total) AS Valor\nFROM Cargues c\nJOIN Empresas e ON e.Id = c.IdEmpresa\nGROUP BY e.Id, e.Nombre, MONTH(c.Fecha), DATENAME(MONTH, c.Fecha)";
    string ejemploAdv  = "SELECT e.Id AS IdEmpresa, e.Nombre AS NombreEmpresa,\n       'Ingresos con posible cambio de escala en ' + CAST(a.Anio AS varchar) AS Mensaje,\n       'Revenue with a possible scale change in ' + CAST(a.Anio AS varchar) AS MensajeEn\nFROM AlgunaTablaDeAnalisis a\nJOIN Empresas e ON e.Id = a.IdEmpresa\nWHERE a.Anomalia = 1";
}

@if (!string.IsNullOrEmpty(successMsg))
{
    <script>
        const isMobileS = window.innerWidth <= 768;
        Swal.fire({ toast: true, position: isMobileS ? 'top' : 'top-end', icon: 'success', title: '@Html.Raw(successMsg.Replace("'", "\\'"))', showConfirmButton: false, timer: 3000, timerProgressBar: true });
    </script>
}
@if (!string.IsNullOrEmpty(errorMsg))
{
    <script>
        const isMobileE = window.innerWidth <= 768;
        Swal.fire({ toast: true, position: isMobileE ? 'top' : 'top-end', icon: 'error', title: '@Html.Raw(errorMsg.Replace("'", "\\'"))', showConfirmButton: false, timer: 3000, timerProgressBar: true });
    </script>
}

<div class="powerbi-header">
    <div class="powerbi-header-content">
        <i class="fas fa-th-large powerbi-header-icon"></i>
        <h1 class="powerbi-header-title">@Resources.Strings.Wid_PageTitle</h1>
    </div>
</div>

<div class="gestor-hint"><i class="fas fa-arrows-alt"></i> @Resources.Strings.Wid_HintArrastrar</div>

<!-- ===== TABLA ===== -->
<div class="card shadow mb-4">
    <div class="card-body p-0">
        <div class="table-responsive table-wrapper">
            <table class="table table-bordered table-hover table-compact" id="tablaWidgets">
                <thead>
                    <tr>
                        <th class="col-handle"></th>
                        <th style="width:40px">#</th>
                        <th style="width:110px">@Resources.Strings.Wid_ThTipo</th>
                        <th style="width:110px">@Resources.Strings.Wid_ColFuente</th>
                        <th>@Resources.Strings.Common_LabelDescripcion</th>
                        <th style="width:70px;text-align:center">@Resources.Strings.Mod_ThIcono</th>
                        <th style="width:55px;text-align:center" class="col-orden-th">@Resources.Strings.Wid_LabelOrden</th>
                        <th style="width:80px;text-align:center">@Resources.Strings.Common_Estado</th>
                        <th style="width:100px;text-align:center">@Resources.Strings.Common_ThAcciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5">
                                <div class="wid-empty">
                                    <i class="fas fa-th-large"></i>
                                    <h4>@Resources.Strings.Wid_NoWidgets</h4>
                                    <p>@Resources.Strings.Wid_NoWidgetsDesc</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var t in Model)
                    {
                        <tr draggable="true" data-id="@t.Id">
                            <td class="col-handle"><i class="fas fa-grip-vertical"></i></td>
                            <td>@t.Id</td>
                            <td>
                                @if (t.Tipo == 1)      { <span class="dash-tipo-badge dash-tipo-kpi">KPI</span> }
                                else if (t.Tipo == 3)  { <span class="dash-tipo-badge dash-tipo-adv">@Resources.Strings.Wid_TipoAdvertencia</span> }
                                else                   { <span class="dash-tipo-badge dash-tipo-graf">@Resources.Strings.Wid_TipoGrafico</span> }
                            </td>
                            <td>
                                <span class="dash-fuente-badge">
                                    <i class="fas @(t.TipoFuente == 2 ? "fa-microchip" : "fa-database")"></i>
                                    @(t.TipoFuente == 2 ? Resources.Strings.Wid_FuenteSP : Resources.Strings.Wid_FuenteSQL)
                                </span>
                            </td>
                            <td>
                                <strong>@t.Nombre</strong>
                                @if (!string.IsNullOrEmpty(t.NombreEn))
                                {
                                    <div class="dash-nombre-en"><i class="fas fa-globe"></i> @t.NombreEn</div>
                                }
                            </td>
                            <td style="text-align:center"><span class="icono-preview"><i class="@t.Icono" style="color:@t.ColorIcono"></i></span></td>
                            <td style="text-align:center" class="col-orden">@t.Orden</td>
                            <td style="text-align:center">
                                @if (t.Activo) { <span class="badge-activo">@Resources.Strings.Common_Activo</span> }
                                else           { <span class="badge-inactivo">@Resources.Strings.Common_Inactivo</span> }
                            </td>
                            <td style="text-align:center">
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-sm btn-primary" title="Editar" data-toggle="modal" data-target="#modalEditar"
                                            onclick="cargarEditar(@t.Id)">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-danger" title="Eliminar" data-toggle="modal" data-target="#eliminarModal"
                                            data-id="@t.Id" data-nombre="@t.Nombre">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer">
        <button type="button" class="btn-modern-success" data-toggle="modal" data-target="#modalCrear">
            <i class="fas fa-plus-circle mr-1"></i> @Resources.Strings.Wid_BtnNuevo
        </button>
    </div>
</div>

<!-- ===== MODAL CREAR ===== -->
<div class="modal fade" id="modalCrear" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="fas fa-plus-circle"></i> @Resources.Strings.Wid_ModalCreateTitle</h5>
        <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
      </div>
      <form method="post" action="/Widgets/Crear">
        @Html.AntiForgeryToken()
        <div class="modal-body">

          <!-- 1. Identificación -->
          <div class="form-sec">
            <div class="form-sec-title"><i class="fas fa-id-badge"></i> @Resources.Strings.Wid_SeccionIdentificacion</div>
            <div class="row">
              <div class="col-md-4 mb-2">
                <label>@Resources.Strings.Wid_LabelNombre <span class="text-danger">*</span></label>
                <input type="text" class="form-control form-control-sm" name="Nombre" id="c_Nombre" required maxlength="100" />
              </div>
              <div class="col-md-4 mb-2">
                <label>@Resources.Strings.Wid_LabelNombreEn</label>
                <input type="text" class="form-control form-control-sm" name="NombreEn" id="c_NombreEn" maxlength="100" />
              </div>
              <div class="col-md-2 mb-2">
                <label>@Resources.Strings.Wid_LabelOrden</label>
                <input type="number" class="form-control form-control-sm" name="Orden" id="c_Orden" value="0" min="0" />
              </div>
              <div class="col-md-2 mb-2 d-flex flex-column">
                <label>@Resources.Strings.Wid_LabelActivo</label>
                <div class="wid-switch">
                  <input type="checkbox" name="Activo" id="c_Activo" value="true" checked />
                  <label for="c_Activo"></label>
                </div>
              </div>
            </div>
          </div>

          <!-- 2. Tipo de widget -->
          <div class="form-sec">
            <div class="form-sec-title"><i class="fas fa-shapes"></i> @Resources.Strings.Wid_SeccionTipo</div>
            <div class="wtype-row" id="c_tipoGroup">
              <div class="wtype-card-wrap">
                <input type="radio" name="Tipo" id="c_tipo_1" value="1" checked onchange="toggleCampos('c')">
                <label for="c_tipo_1" class="wtype-card">
                  <i class="fas fa-tachometer-alt"></i>
                  <span class="t">@Resources.Strings.Wid_TipoKpiNombre</span>
                  <span class="d">@Resources.Strings.Wid_TipoKpiDesc</span>
                </label>
              </div>
              <div class="wtype-card-wrap">
                <input type="radio" name="Tipo" id="c_tipo_2" value="2" onchange="toggleCampos('c')">
                <label for="c_tipo_2" class="wtype-card">
                  <i class="fas fa-chart-pie"></i>
                  <span class="t">@Resources.Strings.Wid_TipoGrafico</span>
                  <span class="d">@Resources.Strings.Wid_TipoGraficoDesc</span>
                </label>
              </div>
              <div class="wtype-card-wrap">
                <input type="radio" name="Tipo" id="c_tipo_3" value="3" onchange="toggleCampos('c')">
                <label for="c_tipo_3" class="wtype-card">
                  <i class="fas fa-shield-alt"></i>
                  <span class="t">@Resources.Strings.Wid_TipoAdvertencia</span>
                  <span class="d">@Resources.Strings.Wid_TipoAdvertenciaDesc</span>
                </label>
              </div>
            </div>
          </div>

          <!-- 3. Apariencia (no aplica a Advertencia) -->
          <div class="form-sec" id="c_sec_apariencia">
            <div class="form-sec-title"><i class="fas fa-palette"></i> @Resources.Strings.Wid_SeccionApariencia</div>
            <div class="row">
              <div class="col-md-5 mb-3">
                <label>@Resources.Strings.Wid_LabelIcono</label>
                <div class="input-group input-group-sm">
                  <span class="icono-preview mr-2"><i id="c_IconoPreview" class="fas fa-chart-bar"></i></span>
                  <input type="text" class="form-control form-control-sm" name="Icono" id="c_Icono" placeholder="fas fa-chart-bar" value="fas fa-chart-bar" />
                </div>
              </div>
              <div class="col-md-4 mb-3">
                <label>@Resources.Strings.Wid_LabelColorIcono</label>
                <div class="input-group input-group-sm">
                  <input type="color" class="form-control form-control-sm" name="ColorIcono" id="c_ColorIcono" value="#583AFF" style="width:44px;padding:2px" />
                  <input type="text" class="form-control form-control-sm" id="c_ColorText" value="#583AFF" maxlength="7" />
                </div>
              </div>
              <div class="col-md-3 mb-3">
                <label>@Resources.Strings.Wid_LabelFondo</label>
                <div class="form-check pt-1">
                  <input class="form-check-input" type="checkbox" name="FondoOscuro" id="c_FondoOscuro" value="true" />
                  <label class="form-check-label small" for="c_FondoOscuro">@Resources.Strings.Wid_FondoOscuro</label>
                </div>
              </div>
            </div>
          </div>

          <!-- 4. Fuente de datos (una sola vez, compartida por los 3 tipos) -->
          <div class="form-sec">
            <div class="form-sec-title"><i class="fas fa-plug"></i> @Resources.Strings.Wid_LabelFuente</div>
            <div class="wseg-row" id="c_fuenteGroup">
              <input type="radio" name="TipoFuente" id="c_fuente_sql" value="1" checked onchange="toggleCampos('c')">
              <label for="c_fuente_sql"><i class="fas fa-database"></i> @Resources.Strings.Wid_FuenteSQL</label>
              <input type="radio" name="TipoFuente" id="c_fuente_sp" value="2" onchange="toggleCampos('c')">
              <label for="c_fuente_sp"><i class="fas fa-microchip"></i> @Resources.Strings.Wid_FuenteSP</label>
            </div>
            <div class="mb-0 mt-3" id="c_bloque_sp" style="display:none">
              <label>@Resources.Strings.Wid_LabelNombreSP</label>
              <input type="text" class="form-control form-control-sm" name="NombreSP" id="c_NombreSP" placeholder="dbo.sp_MiWidget" maxlength="128" disabled />
              <div class="sql-cols">@Resources.Strings.Wid_HintNombreSP</div>
            </div>
          </div>

          <!-- 5. Configuración específica del tipo elegido -->
          <div class="form-sec">

            <div id="c_sec_kpi">
              <div class="form-sec-title"><i class="fas fa-chart-bar"></i> @Resources.Strings.Wid_CfgKPI</div>
              <div class="mb-3" style="max-width:200px">
                <label>@Resources.Strings.Wid_LabelUnidad</label>
                <input type="text" class="form-control form-control-sm" name="UnidadValor" id="c_UnidadValor" placeholder="COP M, %, ud" maxlength="30" />
              </div>
              <div class="mb-3" id="c_kpi_sql">
                <label>@Resources.Strings.Wid_LabelSQL</label>
                <textarea class="form-control form-control-sm sql-area" name="ConsultaSQL_KPI" id="c_ConsultaSQL_KPI" rows="5" placeholder="@Resources.Strings.Wid_PlaceholderSQL"></textarea>
              </div>
              <div class="sql-cols">
                <span class="grp"><span class="lbl req">@Resources.Strings.Wid_ColRequeridas.ToUpper():</span> <code>IdEmpresa</code> <code>Valor</code></span>
                <span class="grp"><span class="lbl opt">@Resources.Strings.Wid_ColOpcionales.ToUpper():</span> <code>NombreEmpresa</code> <code>Etiqueta</code> <code>EtiquetaEn</code></span>
              </div>
              <div class="sql-example" id="c_ejemplo_kpi">
                <div class="sql-example-hdr">
                  <span>@Resources.Strings.Wid_EjemploTitulo</span>
                  <button type="button" onclick="usarEjemplo('c','KPI')">@Resources.Strings.Wid_BtnUsarEjemplo</button>
                </div>
                <pre>@ejemploKpi</pre>
              </div>
            </div>

            <div id="c_sec_graf" style="display:none">
