@model List<bufinscustomers.Models.WidgetTarjeta>
@using bufinscustomers.Helpers
@using System.Web.Script.Serialization

<!DOCTYPE html>
<html>
<head>
    <title>@Resources.Strings.Wid_PageTitle</title>
    <script src="~/Assets/js/sweetalert2.all.min.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="~/Assets/css/configuracion-admin.css" rel="stylesheet" />
    <style>
        .dash-tipo-badge  { font-size:.7rem; font-weight:700; padding:2px 8px; border-radius:5px; display:inline-block; }
        .dash-tipo-kpi    { background:#583AFF; color:#fff; }
        .dash-tipo-graf   { background:#01E1D7; color:#160933; }
        .form-sec-title   { font-size:.72rem; font-weight:700; color:#6B6787; text-transform:uppercase; letter-spacing:.8px; margin:1rem 0 .5rem; padding-top:.75rem; border-top:1px solid #eee; }
        .sql-hint         { font-size:.72rem; color:#6c757d; background:#f8f9fc; border-radius:6px; padding:.5rem .75rem; border-left:3px solid #583AFF; margin-top:.3rem; }
        .sql-hint code    { color:#583AFF; font-size:.7rem; }
        .sql-area         { font-family:'Courier New',monospace; font-size:.8rem; min-height:120px; resize:vertical; }
        .fondo-switch     { display:flex; align-items:center; gap:.5rem; }
        .fondo-switch .preview { width:28px; height:28px; border-radius:6px; border:1px solid #ddd; }
    </style>
</head>
<body>

@{
    var successMsg = TempData["SuccessMessage"] as string;
    var errorMsg   = TempData["ErrorMessage"]   as string;
    var jss        = new JavaScriptSerializer();
    var jsonData   = jss.Serialize(Model.Select(t => new {
        t.Id, t.Nombre, t.Tipo, t.Icono, t.ColorIcono, t.Orden, t.Activo,
        t.ConsultaSQL, t.UnidadValor, t.TipoGrafico, t.FondoOscuro
    }));
}

@if (!string.IsNullOrEmpty(successMsg))
{
    <script>
        const isMobileS = window.innerWidth <= 768;
        Swal.fire({ toast: true, position: isMobileS ? 'top' : 'top-end', icon: 'success', title: '@Html.Raw(successMsg.Replace("'", "\\'"))', showConfirmButton: false, timer: 3000, timerProgressBar: true });
    </script>
}
@if (!string.IsNullOrEmpty(errorMsg))
{
    <script>
        const isMobileE = window.innerWidth <= 768;
        Swal.fire({ toast: true, position: isMobileE ? 'top' : 'top-end', icon: 'error', title: '@Html.Raw(errorMsg.Replace("'", "\\'"))', showConfirmButton: false, timer: 3000, timerProgressBar: true });
    </script>
}

<div class="powerbi-header">
    <div class="powerbi-header-content">
        <i class="fas fa-th-large powerbi-header-icon"></i>
        <h1 class="powerbi-header-title">@Resources.Strings.Wid_PageTitle</h1>
    </div>
</div>

<!-- ===== TABLA ===== -->
<div class="card shadow mb-4 mt-4">
    <div class="card-body p-0">
        <div class="table-responsive table-wrapper">
            <table class="table table-bordered table-hover table-compact">
                <thead>
                    <tr>
                        <th style="width:40px">#</th>
                        <th style="width:80px">@Resources.Strings.Wid_ThTipo</th>
                        <th>@Resources.Strings.Common_LabelDescripcion</th>
                        <th style="width:70px;text-align:center">Icono</th>
                        <th style="width:55px;text-align:center">Orden</th>
                        <th style="width:80px;text-align:center">@Resources.Strings.Common_Estado</th>
                        <th style="width:100px;text-align:center">@Resources.Strings.Common_ThAcciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-3">@Resources.Strings.Wid_NoWidgets</td></tr>
                    }
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td>@t.Id</td>
                            <td>
                                @if (t.Tipo == 1) { <span class="dash-tipo-badge dash-tipo-kpi">KPI</span> }
                                else              { <span class="dash-tipo-badge dash-tipo-graf">@Resources.Strings.Wid_TipoGrafico</span> }
                            </td>
                            <td><strong>@t.Nombre</strong></td>
                            <td style="text-align:center"><i class="@t.Icono" style="color:@t.ColorIcono;font-size:1.1rem"></i></td>
                            <td style="text-align:center">@t.Orden</td>
                            <td style="text-align:center">
                                @if (t.Activo) { <span class="badge-activo">@Resources.Strings.Common_Activo</span> }
                                else           { <span class="badge-inactivo">@Resources.Strings.Common_Inactivo</span> }
                            </td>
                            <td style="text-align:center">
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-sm btn-primary" title="Editar" data-toggle="modal" data-target="#modalEditar"
                                            onclick="cargarEditar(@t.Id)">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-danger" title="Eliminar"
                                            onclick="confirmarEliminar(@t.Id,'@Html.Raw(t.Nombre?.Replace("'","\\'")??"")')">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer">
        <button type="button" class="btn-modern-success" data-toggle="modal" data-target="#modalCrear">
            <i class="fas fa-plus-circle mr-1"></i> @Resources.Strings.Wid_BtnNuevo
        </button>
    </div>
</div>

<!-- ===== MODAL CREAR ===== -->
<div class="modal fade" id="modalCrear" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-plus-circle"></i> @Resources.Strings.Wid_ModalCreateTitle</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <form method="post" action="/Widgets/Crear">
    @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label><i class="fas fa-tag mr-1" style="color:#583AFF"></i>Nombre <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" name="Nombre" id="c_Nombre" required maxlength="100" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label><i class="fas fa-layer-group mr-1" style="color:#583AFF"></i>Tipo</label>
                            <select class="form-control form-control-sm" name="Tipo" id="c_Tipo" onchange="toggleCampos('c',this.value)">
                                <option value="1">KPI / Valor</option>
                                <option value="2">Gr&aacute;fico</option>
                            </select>
                        </div>
                        <div class="col-md-2 mb-3">
                            <label><i class="fas fa-sort-numeric-up mr-1" style="color:#583AFF"></i>Orden</label>
                            <input type="number" class="form-control form-control-sm" name="Orden" id="c_Orden" value="0" min="0" />
                        </div>
                        <div class="col-md-1 mb-3 d-flex align-items-end pb-1">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="Activo" id="c_Activo" value="true" checked />
                                <label class="form-check-label small" for="c_Activo">Act.</label>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-5 mb-3">
                            <label><i class="fas fa-icons mr-1" style="color:#583AFF"></i>Icono <small class="text-muted">(FontAwesome)</small></label>
                            <input type="text" class="form-control form-control-sm" name="Icono" id="c_Icono" placeholder="fas fa-chart-bar" value="fas fa-chart-bar" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label><i class="fas fa-palette mr-1" style="color:#583AFF"></i>Color icono</label>
                            <div class="input-group input-group-sm">
                                <input type="color" class="form-control form-control-sm" name="ColorIcono" id="c_ColorIcono" value="#583AFF" style="width:44px;padding:2px" />
                                <input type="text" class="form-control form-control-sm" id="c_ColorText" value="#583AFF" maxlength="7" />
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label><i class="fas fa-fill-drip mr-1" style="color:#583AFF"></i>Fondo tarjeta</label>
                            <div class="form-check pt-1">
                                <input class="form-check-input" type="checkbox" name="FondoOscuro" id="c_FondoOscuro" value="true" />
                                <label class="form-check-label small" for="c_FondoOscuro">Oscuro corporativo</label>
                            </div>
                        </div>
                    </div>
                    <!-- KPI -->
                    <div id="c_sec_kpi">
                        <div class="form-sec-title"><i class="fas fa-chart-bar"></i> Configuraci&oacute;n KPI</div>
                        <div class="mb-3">
                            <label>Consulta SQL</label>
                            <textarea class="form-control form-control-sm sql-area" name="ConsultaSQL_KPI" id="c_ConsultaSQL_KPI" rows="5"
                                      placeholder="SELECT e.Id AS IdEmpresa, e.Nombre AS NombreEmpresa, FORMAT(COUNT(*),'N0') AS Valor, 'cargues' AS Etiqueta&#10;FROM Empresas e LEFT JOIN ... GROUP BY e.Id, e.Nombre"></textarea>
                            <div class="sql-hint">
                                Columnas requeridas: <code>IdEmpresa</code>, <code>Valor</code> &nbsp;|&nbsp;
                                Opcionales: <code>NombreEmpresa</code>, <code>Etiqueta</code>
                            </div>
                        </div>
                        <div class="mb-3" style="max-width:200px">
                            <label>Unidad / sufijo</label>
                            <input type="text" class="form-control form-control-sm" name="UnidadValor" id="c_UnidadValor" placeholder="COP M, %, ud" maxlength="30" />
                        </div>
                    </div>
                    <!-- Gráfico -->
                    <div id="c_sec_graf" style="display:none">
                        <div class="form-sec-title"><i class="fas fa-chart-pie"></i> Configuraci&oacute;n Gr&aacute;fico</div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label><i class="fas fa-shapes mr-1" style="color:#01E1D7"></i>Tipo de gr&aacute;fico</label>
                                <select class="form-control form-control-sm" name="TipoGrafico" id="c_TipoGrafico">
                                    <option value="bar">Barras</option>
                                    <option value="line">L&iacute;neas</option>
                                    <option value="area">&Aacute;rea</option>
                                    <option value="doughnut">Dona</option>
                                    <option value="pie">Pastel</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label>Consulta SQL</label>
                            <textarea class="form-control form-control-sm sql-area" name="ConsultaSQL_GRAF" id="c_ConsultaSQL_GRAF" rows="5"
                                      placeholder="SELECT e.Id AS IdEmpresa, e.Nombre AS NombreEmpresa, MONTH(c.Fecha) AS Etiqueta, SUM(c.Total) AS Valor&#10;FROM Cargues c JOIN Empresas e ON e.Id=c.IdEmpresa&#10;GROUP BY e.Id, e.Nombre, MONTH(c.Fecha)"></textarea>
                            <div class="sql-hint">
                                Columnas requeridas: <code>IdEmpresa</code>, <code>Etiqueta</code>, <code>Valor</code> &nbsp;|&nbsp;
                                Opcionales: <code>Serie</code> (m&uacute;ltiples series), <code>NombreEmpresa</code>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i>Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus-circle mr-1"></i>Crear
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===== MODAL EDITAR ===== -->
