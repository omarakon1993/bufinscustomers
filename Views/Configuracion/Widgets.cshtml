<!-- Form eliminar oculto -->
<form id="frmElim" method="post" action="/Widgets/Eliminar" style="display:none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="elimId" />
</form>

<script>
    var _tarjetas = @Html.Raw(jsonData);

    function toggleCampos(pfx, tipo) {
        var t = parseInt(tipo);
        document.getElementById(pfx + '_sec_kpi').style.display  = t === 1 ? '' : 'none';
        document.getElementById(pfx + '_sec_graf').style.display = t === 2 ? '' : 'none';

        // Solo el textarea visible debe llamarse "ConsultaSQL" para ser enviado
        var kpi  = document.getElementById(pfx + '_ConsultaSQL_KPI');
        var graf = document.getElementById(pfx + '_ConsultaSQL_GRAF');
        if (t === 1) {
            kpi.name  = 'ConsultaSQL';
            graf.name = 'ConsultaSQL_GRAF_disabled';
            graf.disabled = true;
            kpi.disabled  = false;
        } else {
            kpi.name  = 'ConsultaSQL_KPI_disabled';
            graf.name = 'ConsultaSQL';
            kpi.disabled  = true;
            graf.disabled = false;
        }
    }

    ['c', 'e'].forEach(function(p) {
        var picker = document.getElementById(p + '_ColorIcono');
        var text   = document.getElementById(p + '_ColorText');
        if (picker) picker.addEventListener('input', function() { text.value = picker.value; });
        if (text)   text.addEventListener('input',   function() { if (/^#[0-9a-fA-F]{6}$/.test(text.value)) picker.value = text.value; });
    });

    $('#modalCrear').on('show.bs.modal', function() {
        toggleCampos('c', document.getElementById('c_Tipo').value);
    });

    function cargarEditar(id) {
        var t = _tarjetas.find(function(x) { return x.Id === id; });
        if (!t) return;

        document.getElementById('e_Id').value          = t.Id;
        document.getElementById('e_Nombre').value      = t.Nombre || '';
        document.getElementById('e_Tipo').value        = t.Tipo;
        document.getElementById('e_Icono').value       = t.Icono || '';
        document.getElementById('e_ColorIcono').value  = t.ColorIcono || '#583AFF';
        document.getElementById('e_ColorText').value   = t.ColorIcono || '#583AFF';
        document.getElementById('e_Orden').value       = t.Orden;
        document.getElementById('e_Activo').checked    = t.Activo;
        document.getElementById('e_UnidadValor').value = t.UnidadValor || '';
        document.getElementById('e_TipoGrafico').value = t.TipoGrafico || 'bar';
        document.getElementById('e_FondoOscuro').checked = !!t.FondoOscuro;

        // El SQL se asigna al textarea correspondiente al tipo
        if (t.Tipo === 2) {
            document.getElementById('e_ConsultaSQL_GRAF').value = t.ConsultaSQL || '';
            document.getElementById('e_ConsultaSQL_KPI').value  = '';
        } else {
            document.getElementById('e_ConsultaSQL_KPI').value  = t.ConsultaSQL || '';
            document.getElementById('e_ConsultaSQL_GRAF').value = '';
        }

        toggleCampos('e', t.Tipo);
    }

    function confirmarEliminar(id, nombre) {
        Swal.fire({
            title: '@Resources.Strings.Wid_JS_ElimTitle',
            text: '"' + nombre + '" @Resources.Strings.Wid_JS_ElimSuffix',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#e74a3b',
            cancelButtonText: '@Resources.Strings.Layout_Cancel',
            confirmButtonText: '@Resources.Strings.Menu_JS_ConfirmarEliminar'
        }).then(function(r) {
            if (r.isConfirmed) {
                document.getElementById('elimId').value = id;
                document.getElementById('frmElim').submit();
            }
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        toggleCampos('c', '1');
    });
</script>
</body>
</html>
