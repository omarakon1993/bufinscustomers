﻿@model IEnumerable<bufinscustomers.Models.ConfiguracionSistemaItem>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <title>@Resources.Strings.CfgIA_PageTitle</title>
    <script src="~/Assets/js/sweetalert2.all.min.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="~/Assets/css/configuracion-admin.css" rel="stylesheet" />
    <link href="~/Assets/css/bufins-components.css" rel="stylesheet" />
    <link href="~/Assets/css/select2/select2.min.css" rel="stylesheet" />
    <style>
        /* ── Selector de modelos (OpenAI): campo único, claro, con la lista desplegable integrada ── */
        .modelo-select-wrap { position: relative; }
        .mp-field { display: flex; align-items: center; background: #fff; border: 1px solid #d9dce6; border-radius: 8px; transition: border-color .15s, box-shadow .15s; }
        .mp-field:focus-within { border-color: #583AFF; box-shadow: 0 0 0 3px rgba(88,58,255,.14); }
        .mp-input { flex: 1; min-width: 0; border: 0; background: transparent; outline: 0; padding: 6px 4px 6px 10px; font-size: .84rem; color: #2d3748; }
        .mp-input::placeholder { color: #9ca3af; }
        .mp-btn { width: 30px; height: 30px; border: 0; background: transparent; color: #8b90a0; border-radius: 6px; margin-right: 2px; display: inline-flex; align-items: center; justify-content: center; font-size: .75rem; cursor: pointer; transition: background .15s, color .15s; }
        .mp-btn:hover { background: #f1effc; color: #583AFF; }
        .mp-btn:focus-visible { outline: 2px solid #583AFF; outline-offset: -2px; }
        .mp-btn + .mp-btn { margin-left: 0; }
        .mp-field .mp-sep { width: 1px; height: 18px; background: #e5e7ee; margin: 0 2px; }
        .modelos-dropdown { position: absolute; top: calc(100% + 6px); left: 0; right: 0; min-width: 220px; background: #fff; border: 1px solid #e3e6f0; border-radius: 10px; box-shadow: 0 12px 32px rgba(22,9,51,.14); z-index: 1060; overflow: hidden; }
        .modelos-lista { max-height: 220px; overflow-y: auto; padding: 4px; }
        .modelos-lista::-webkit-scrollbar { width: 6px; }
        .modelos-lista::-webkit-scrollbar-thumb { background: #d6d3ee; border-radius: 4px; }
        .modelo-item { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 7px 10px; border-radius: 7px; font-size: .82rem; color: #374151; cursor: pointer; white-space: nowrap; }
        .modelo-item:hover, .modelo-item.hl { background: #f4f3fb; color: #2d3748; }
        .modelo-item.activo { background: rgba(88,58,255,.09); color: #583AFF; font-weight: 700; }
        .modelo-item.activo i { color: #583AFF; font-size: .72rem; }
        .modelo-item.mp-vacio { color: #6b7280; font-style: italic; border-bottom: 1px solid #f0eef8; border-radius: 7px 7px 0 0; margin-bottom: 2px; }
        .modelo-item-empty { padding: 12px; font-size: .78rem; color: #9ca3af; text-align: center; }
        .mp-foot { padding: 6px 12px; font-size: .72rem; color: #6b7280; border-top: 1px solid #f0eef8; background: #fbfaff; }
        .mp-foot.err { color: #b91c1c; }
        /* Input password toggle */
        .input-pass-wrap { position: relative; }
        .input-pass-wrap .btn-eye {
            position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
            background: none; border: none; color: #9ca3af; cursor: pointer; padding: 0;
        }
        .input-pass-wrap .btn-eye:hover { color: #583AFF; }
        /* ── Pestaña General: parámetros agrupados, en filas compactas ── */
        .cfgg-wrap { padding: 16px 20px 24px; }
        .cfgg-toolbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
        .cfgg-search { position: relative; flex: 1; min-width: 220px; max-width: 420px; }
        .cfgg-search i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #9ca3af; font-size: .8rem; }
        .cfgg-search input { width: 100%; padding: 7px 12px 7px 32px; border: 1px solid #e3e6f0; border-radius: 999px; font-size: .84rem; background: #fff; outline: none; }
        .cfgg-search input:focus { border-color: #583AFF; box-shadow: 0 0 0 3px rgba(88,58,255,.12); }
        .cfgg-toolbar .btn-modern-success { margin-left: auto; padding: 7px 16px; font-size: .82rem; }
        .cfgg-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
        .cfgg-chip { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 999px; font-size: .76rem; font-weight: 600; background: #f4f3fb; color: #3b3f66; border: 1px solid #e0ddf0; }
        .cfgg-chip b { font-family: 'Courier New', monospace; font-weight: 700; color: #160933; }
        .cfgg-chip.ok { background: #ecfdf5; border-color: #a7f3d0; color: #047857; }
        .cfgg-chip.bad { background: #fef2f2; border-color: #fecaca; color: #b91c1c; }
        .cfgg-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(440px, 1fr)); gap: 16px; align-items: start; }
        .cfgg-group { background: #fff; border: 1px solid #e3e6f0; border-radius: 12px; box-shadow: 0 2px 8px rgba(22,9,51,.05); overflow: hidden; }
        .cfgg-group > header { display: flex; align-items: center; gap: 10px; padding: 10px 14px; background: #f8f9fc; border-bottom: 1px solid #e3e6f0; }
        .cfgg-group > header .ic { width: 28px; height: 28px; border-radius: 8px; background: var(--content-gradient); color: #fff; display: flex; align-items: center; justify-content: center; font-size: .8rem; }
        .cfgg-group > header h3 { margin: 0; font-size: .9rem; font-weight: 800; color: #2d3748; flex: 1; }
        .cfgg-count { font-size: .7rem; font-weight: 700; padding: 1px 8px; border-radius: 999px; background: rgba(88,58,255,.1); color: #583AFF; }
        .cfgg-row { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: center; gap: 12px; padding: 9px 14px; border-top: 1px solid #f0eef8; }
        .cfgg-row:first-of-type { border-top: 0; }
        .cfgg-row:hover { background: #fbfaff; }
        .cfgg-key { font-family: 'Courier New', monospace; font-size: .78rem; font-weight: 700; color: #160933; }
        .cfgg-desc { font-size: .74rem; color: #6b7280; line-height: 1.35; margin-top: 1px; }
        .cfgg-val { max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: 'Courier New', monospace; font-size: .78rem; padding: 3px 10px; border-radius: 6px; background: #f4f3fb; color: #374151; border: 1px solid #e8e5f5; }
        .cfgg-val.masked { color: #9ca3af; font-style: italic; }
        .cfgg-act { display: flex; gap: 4px; }
        .cfgg-ico { width: 28px; height: 28px; border-radius: 8px; border: 1px solid #e3e6f0; background: #fff; color: #5b6472; font-size: .78rem; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: all .15s; }
        .cfgg-ico:hover { border-color: #583AFF; color: #583AFF; background: #f4f3fb; }
        .cfgg-ico.danger:hover { border-color: #ef4444; color: #b91c1c; background: #fef2f2; }
        .cfgg-vacio { text-align: center; color: #9ca3af; padding: 24px; display: none; }
        @@media (max-width: 768px) {
            .cfgg-wrap { padding: 12px; }
            .cfgg-grid { grid-template-columns: 1fr; }
            .cfgg-row { grid-template-columns: minmax(0, 1fr) auto; }
            .cfgg-val { grid-column: 1; max-width: 100%; }
            .cfgg-act { grid-column: 2; grid-row: 1; }
        }

        /* ── Pestañas Por Empresa y Uso y costos (mismo lenguaje que General: cfgg-*) ── */
        .cfge-toolbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; }
        .cfge-pick { flex: 1; min-width: 240px; max-width: 440px; }
        .cfge-layout { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 16px; align-items: start; }
        .cfge-main { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
        .cfge-card { background: #fff; border: 1px solid #e3e6f0; border-radius: 12px; box-shadow: 0 2px 8px rgba(22,9,51,.05); overflow: hidden; }
        .cfge-card > header { display: flex; align-items: center; gap: 10px; padding: 10px 14px; background: #f8f9fc; border-bottom: 1px solid #e3e6f0; }
        .cfge-card > header .ic { width: 28px; height: 28px; border-radius: 8px; background: var(--content-gradient); color: #fff; display: flex; align-items: center; justify-content: center; font-size: .8rem; flex-shrink: 0; }
        .cfge-card > header h3 { margin: 0; font-size: .9rem; font-weight: 800; color: #2d3748; flex: 1; }
        .cfge-body { padding: 14px 16px; }
        /* El formulario aloja el desplegable de modelos: no puede recortarlo (overflow visible) */
        #cfgeForm { overflow: visible; }
        #cfgeForm > header { border-radius: 12px 12px 0 0; }
        #cfgeForm .cfge-foot { border-radius: 0 0 12px 12px; }
        .cfge-hero { padding: 16px 18px; }
        .cfge-hero-top { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; flex-wrap: wrap; }
        .cfge-big { font-size: 2rem; font-weight: 800; line-height: 1; color: #160933; letter-spacing: -.5px; }
        .cfge-de { font-size: .85rem; color: #6b7280; margin-left: 6px; }
        .cfge-pct { font-size: .8rem; font-weight: 800; padding: 3px 10px; border-radius: 999px; background: rgba(88,58,255,.1); color: #583AFF; }
        .cfge-pct.warn { background: #fef3c7; color: #92400e; }
        .cfge-pct.bad { background: #fee2e2; color: #b91c1c; }
        .cfge-track { height: 10px; border-radius: 999px; background: #ede9fe; overflow: hidden; margin: 12px 0 10px; }
        .cfge-fill { height: 100%; width: 0; background: var(--content-gradient); border-radius: 999px; transition: width .4s ease; }
        .cfge-fill.agotado { background: linear-gradient(135deg, #ef4444, #b91c1c); }
        .cfge-meta { display: flex; flex-wrap: wrap; gap: 8px; }
        .cfge-sec { font-size: .78rem; font-weight: 800; color: #2d3748; margin: 18px 0 8px; padding-bottom: 6px; border-bottom: 1px solid #f0eef8; display: flex; align-items: center; gap: 6px; }
        .cfge-sec:first-child { margin-top: 0; }
        .cfge-sec i { color: #583AFF; }
        .cfge-grid3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; }
        .cfge-field label { font-size: .78rem; font-weight: 700; color: #374151; margin-bottom: 4px; display: flex; align-items: center; gap: 6px; }
        .cfge-field .form-control { font-size: .84rem; }
        .cfge-info { color: #9ca3af; font-size: .72rem; cursor: help; }
        .cfge-switchrow { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 12px; border: 1px solid #e3e6f0; border-radius: 10px; background: #fbfaff; }
        .cfge-switchrow b { font-size: .84rem; color: #2d3748; }
        .cfge-switchrow small { display: block; color: #6b7280; font-size: .74rem; }
        .cfge-pills { display: flex; flex-wrap: wrap; gap: 8px; }
        .cfge-pill { position: relative; margin: 0; }
        .cfge-pill input { position: absolute; opacity: 0; pointer-events: none; }
        .cfge-pill span { display: inline-flex; align-items: center; padding: 6px 14px; border-radius: 999px; border: 1px solid #e0ddf0; background: #fff; font-size: .8rem; font-weight: 600; color: #5b6472; cursor: pointer; transition: all .15s; }
        .cfge-pill input:checked + span { background: var(--content-gradient); border-color: transparent; color: #fff; }
        .cfge-pill input:focus-visible + span { outline: 2px solid #583AFF; outline-offset: 2px; }
        .cfge-foot { display: flex; align-items: center; justify-content: flex-end; gap: 12px; padding: 10px 16px; border-top: 1px solid #e3e6f0; background: #f8f9fc; }
        .cfge-dirty { font-size: .78rem; color: #6b7280; margin-right: auto; }
        .cfge-dirty.on { color: #92400e; font-weight: 700; }
        .cfge-desc { font-size: .76rem; color: #6b7280; padding: 10px 14px 6px; margin: 0; }
        .cfge-users { max-height: 520px; overflow-y: auto; }
        .cfge-user { display: flex; align-items: center; gap: 10px; padding: 8px 14px; border-top: 1px solid #f0eef8; }
        .cfge-avatar { width: 30px; height: 30px; border-radius: 50%; background: #ede9fe; color: #583AFF; font-size: .72rem; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .cfge-uinfo { flex: 1; min-width: 0; }
        .cfge-uinfo .n, .cfge-uinfo .m { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .cfge-uinfo .n { font-size: .84rem; font-weight: 700; color: #2d3748; }
        .cfge-uinfo .m { font-size: .72rem; color: #6b7280; }
        .cfge-user.off .cfge-uinfo .n { color: #9ca3af; text-decoration: line-through; }

        .cfgu-toolbar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; }
        .cfgu-seg { display: inline-flex; gap: 2px; padding: 3px; background: #f4f3fb; border: 1px solid #e0ddf0; border-radius: 9px; }
        .cfgu-seg button { border: 0; background: transparent; font-size: .78rem; font-weight: 700; color: #5B5570; padding: 5px 12px; border-radius: 7px; cursor: pointer; }
        .cfgu-seg button.active { background: #fff; color: #583AFF; box-shadow: 0 1px 3px rgba(22,9,51,.12); }
        .cfgu-dates { display: flex; align-items: center; gap: 6px; }
        .cfgu-dates input { width: auto; padding: 4px 8px; font-size: .8rem; }
        .cfgu-clear { margin-left: auto; }
        .cfgu-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-bottom: 16px; }
        .cfgu-kpi { display: flex; align-items: center; gap: 10px; padding: 10px 12px; background: #fff; border: 1px solid #e3e6f0; border-radius: 12px; }
        .cfgu-kpi .ic { width: 34px; height: 34px; border-radius: 10px; background: rgba(88,58,255,.1); color: #583AFF; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .cfgu-kpi .v { font-size: 1.15rem; font-weight: 800; line-height: 1.1; color: #160933; }
        .cfgu-kpi .l { font-size: .72rem; color: #6b7280; }
        .cfgu-chart { display: flex; align-items: flex-end; gap: 2px; height: 140px; padding: 14px 16px 0; }
        .cfgu-bar { flex: 1; min-width: 2px; background: var(--content-gradient); border-radius: 3px 3px 0 0; opacity: .85; }
        .cfgu-bar:hover { opacity: 1; }
        .cfgu-bar.vacia { background: #e5e7eb; opacity: 1; height: 2px !important; }
        .cfgu-axis { display: flex; justify-content: space-between; padding: 4px 16px 12px; font-size: .7rem; color: #9ca3af; }
        .cfgu-ranks { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; margin: 16px 0; align-items: start; }
        .cfgu-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 10px; padding: 8px 14px; border-top: 1px solid #f0eef8; align-items: center; }
        .cfgu-row .n { font-size: .82rem; font-weight: 700; color: #2d3748; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .cfgu-row .v { font-size: .76rem; color: #374151; text-align: right; white-space: nowrap; }
        .cfgu-row .e { color: #b91c1c; font-weight: 800; margin-left: 6px; }
        .cfgu-row .bar { grid-column: 1 / -1; height: 5px; border-radius: 999px; background: #f0eef8; overflow: hidden; }
        .cfgu-row .bar i { display: block; height: 100%; background: var(--content-gradient); }
        .cfgu-vacio { padding: 18px; text-align: center; color: #9ca3af; font-size: .82rem; }
        .cfgu-err summary { cursor: pointer; padding: 10px 14px; font-size: .88rem; font-weight: 800; color: #2d3748; list-style: none; }
        .cfgu-err summary::-webkit-details-marker { display: none; }
        .cfgu-err summary i { color: #b91c1c; margin-right: 6px; }
        @@media (max-width: 992px) {
            .cfge-layout { grid-template-columns: 1fr; }
            .cfgu-clear { margin-left: 0; }
        }

        /* ── Tabs General / Por Empresa — segmented control con "thumb" deslizante (mismo lenguaje visual que AuditoriaHub) ── */
        .cfgia-seg {
            position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px;
            padding: 6px; background: #eef0f4; border: 1px solid #e3e6eb; border-radius: 999px;
            max-width: 540px; margin: 18px 20px 0;
        }
        .cfgia-seg-thumb {
            position: absolute; left: 0; top: 0; width: 0; height: 0; border-radius: 999px;
            background: var(--content-gradient); box-shadow: 0 8px 20px -8px rgba(59,130,246,.6);
            transform: translate(0, 0);
            transition: transform .42s cubic-bezier(.32,.72,0,1), width .42s cubic-bezier(.32,.72,0,1), height .42s cubic-bezier(.32,.72,0,1);
            will-change: transform, width, height; pointer-events: none; z-index: 0;
        }
        .cfgia-seg-thumb.no-anim { transition: none; }
        .cfgia-seg-btn {
            position: relative; z-index: 1; border: 0; background: transparent; color: #5b6472;
            font-size: .85rem; font-weight: 600; padding: .6rem .6rem; border-radius: 999px; cursor: pointer;
            display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
            white-space: nowrap; transition: color .34s ease;
        }
        .cfgia-seg-btn:hover:not(.is-active) { color: #3b3f66; }
        .cfgia-seg-btn.is-active { color: #fff; }
        @@media (prefers-reduced-motion: reduce) { .cfgia-seg-thumb { transition: none; } }

        .cfg-ia-emp-panel { padding:20px; }
    </style>
</head>
<body>

    <!-- ── Header ── -->
    <div class="powerbi-header" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
        <div class="powerbi-header-content">
            <i class="fas fa-sliders-h powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@Resources.Strings.CfgIA_PageTitle</h1>
        </div>
        <small style="font-weight:400;opacity:.85;color:#fff;">@Resources.Strings.CfgIA_HeaderDesc</small>
    </div>

    <!-- ── Tabs ── -->
    <div class="cfgia-seg" id="cfgiaTabs" role="tablist">
        <span class="cfgia-seg-thumb no-anim" aria-hidden="true"></span>
        <button type="button" class="cfgia-seg-btn is-active" data-tab="general">
            <i class="fas fa-sliders-h"></i>@Resources.Strings.CfgIA_TabGeneral
        </button>
        <button type="button" class="cfgia-seg-btn" data-tab="empresa">
            <i class="fas fa-building"></i>@Resources.Strings.CfgIA_TabPorEmpresa
        </button>
        <button type="button" class="cfgia-seg-btn" data-tab="uso">
            <i class="fas fa-chart-line"></i>@Resources.Strings.CfgIA_TabUso
        </button>
    </div>

    <div id="panelGeneral">

    @{
        Func<string, string> valorDe = k => Model.FirstOrDefault(i => i.Clave == k)?.Valor;
        bool hayClave = !string.IsNullOrWhiteSpace(valorDe("OpenAIApiKey"));
        var gruposCfg = new[]
        {
            new { Icono = "fas fa-plug", Titulo = Resources.Strings.CfgIA_G_Proveedor,
                  Claves = new[] { "OpenAIApiKey", "OpenAIModel", "IA_ModeloEconomico", "IA_ModeloSimple", "OpenAIMaxTokens", "OpenAITemperature" } },
            new { Icono = "fas fa-coins", Titulo = Resources.Strings.CfgIA_G_Presupuesto,
                  Claves = new[] { "IA_TokensMensualesPorEmpresa", "IA_CostoPor1kTokensPrompt", "IA_CostoPor1kTokensRespuesta" } },
            new { Icono = "fas fa-bolt", Titulo = Resources.Strings.CfgIA_G_Cache,
                  Claves = new[] { "IA_CacheHoras", "IA_CacheHorasModelo", "IA_MaxCaracteresPregunta" } }
        };
        var clavesAgrupadas = gruposCfg.SelectMany(g => g.Claves).ToList();
        var otrosCfg = Model.Where(i => !clavesAgrupadas.Contains(i.Clave)).ToList();
        string modeloCfg = valorDe("OpenAIModel");
        string tokensCfg = valorDe("OpenAIMaxTokens");
        string cacheCfg = valorDe("IA_CacheHoras");
    }

    <div class="cfgg-wrap">
        <div class="cfgg-toolbar">
            <div class="cfgg-search">
                <i class="fas fa-search"></i>
                <input type="text" id="cfggBuscar" placeholder="@Resources.Strings.CfgIA_G_Buscar" autocomplete="off" />
            </div>
            <button type="button" class="btn-modern-success" onclick="abrirNuevo()">
                <i class="fas fa-plus-circle mr-1"></i>@Resources.Strings.CfgIA_BtnCrear
            </button>
        </div>

        <div class="cfgg-chips">
            <span class="cfgg-chip @(hayClave ? "ok" : "bad")"><i class="fas @(hayClave ? "fa-check-circle" : "fa-exclamation-circle")"></i>@(hayClave ? Resources.Strings.CfgIA_G_ChipClaveOk : Resources.Strings.CfgIA_G_ChipClaveNo)</span>
            @if (!string.IsNullOrWhiteSpace(modeloCfg)) { <span class="cfgg-chip">@Resources.Strings.CfgIA_G_ChipModelo <b>@modeloCfg</b></span> }
            @if (!string.IsNullOrWhiteSpace(tokensCfg)) { <span class="cfgg-chip">@Resources.Strings.CfgIA_G_ChipTokens <b>@tokensCfg</b></span> }
            @if (!string.IsNullOrWhiteSpace(cacheCfg)) { <span class="cfgg-chip">@Resources.Strings.CfgIA_G_ChipCache <b>@cacheCfg @Resources.Strings.CfgIA_G_Horas</b></span> }
        </div>

        @if (!Model.Any())
        {
            <div class="no-data-message">
                <i class="fas fa-cog"></i>
                <h4>@Resources.Strings.CfgIA_NoItems</h4>
            </div>
        }
        else
        {
            <div class="cfgg-grid" id="cfggGrid">
                @foreach (var g in gruposCfg)
                {
                    var items = g.Claves.Select(k => Model.FirstOrDefault(i => i.Clave == k)).Where(i => i != null).ToList();
                    if (!items.Any()) { continue; }
                    @RenderGrupo(g.Icono, g.Titulo, items)
                }
                @if (otrosCfg.Any())
                {
                    @RenderGrupo("fas fa-cog", Resources.Strings.CfgIA_G_Otros, otrosCfg)
                }
            </div>
            <div class="cfgg-vacio" id="cfggVacio"><i class="fas fa-search mr-1"></i>@Resources.Strings.CfgIA_G_SinResultados</div>
        }
    </div>

    @helper RenderGrupo(string icono, string titulo, List<bufinscustomers.Models.ConfiguracionSistemaItem> items)
    {
        <section class="cfgg-group">
            <header>
                <span class="ic"><i class="@icono"></i></span>
                <h3>@titulo</h3>
                <span class="cfgg-count">@items.Count</span>
            </header>
            @foreach (var item in items)
            {
                string valorVisible = string.IsNullOrEmpty(item.Valor) ? "—" : item.Valor;
                <div class="cfgg-row" data-buscar="@((item.Clave + " " + item.Descripcion + " " + (item.EsSecreta ? "" : item.Valor)).ToLowerInvariant())">
                    <div>
                        <div class="cfgg-key">@item.Clave</div>
                        <div class="cfgg-desc">@(string.IsNullOrWhiteSpace(item.Descripcion) ? "—" : item.Descripcion)</div>
                    </div>
                    <span class="cfgg-val @(item.EsSecreta ? "masked" : "")" title="@(item.EsSecreta ? "" : valorVisible)">
                        @if (item.EsSecreta) { <i class="fas fa-lock mr-1"></i> }@valorVisible
                    </span>
                    <div class="cfgg-act">
                        <button type="button" class="cfgg-ico cfgg-editar" title="@Resources.Strings.CfgIA_TitleEditar"
                                data-clave="@item.Clave" data-valor="@(item.EsSecreta ? "" : (item.Valor ?? ""))" data-desc="@(item.Descripcion ?? "")">
                            <i class="fas fa-pen"></i>
                        </button>
                        <button type="button" class="cfgg-ico danger cfgg-eliminar" title="@Resources.Strings.CfgIA_TitleEliminar" data-clave="@item.Clave">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </div>
                </div>
            }
        </section>
    }

