    var _empIAActual = null;

    // ── Segmented tabs General / Por Empresa, con "thumb" deslizante (mismo patrón que AuditoriaHub) ──
    (function () {
        var $seg   = $('#cfgiaTabs');
        var $tabs  = $seg.find('.cfgia-seg-btn');
        var $thumb = $seg.find('.cfgia-seg-thumb');

        function moverThumb(btn, sinAnim) {
            if (!btn) return;
            var cont = $seg[0];
            var cr = cont.getBoundingClientRect();
            var br = btn.getBoundingClientRect();
            var x = br.left - cr.left - cont.clientLeft;
            var y = br.top - cr.top - cont.clientTop;
            if (sinAnim) $thumb.addClass('no-anim');
            $thumb.css({ width: br.width + 'px', height: br.height + 'px', transform: 'translate(' + x + 'px,' + y + 'px)' });
            if (sinAnim) { void $thumb[0].offsetWidth; $thumb.removeClass('no-anim'); }
        }

        function activar($btn) {
            var tab = $btn.data('tab');
            $tabs.removeClass('is-active');
            $btn.addClass('is-active');
            moverThumb($btn[0]);
            document.getElementById('panelGeneral').style.display = (tab === 'general') ? '' : 'none';
            document.getElementById('panelPorEmpresa').style.display = (tab === 'empresa') ? '' : 'none';
            document.getElementById('panelUso').style.display = (tab === 'uso') ? '' : 'none';
            if (tab === 'uso' && !window._usoCargado) { window._usoCargado = true; cargarUsoIA(); }
        }

        $tabs.on('click', function () { activar($(this)); });
        $(window).on('resize', function () {
            var a = $tabs.filter('.is-active')[0];
            if (a) moverThumb(a, true);
        });

        moverThumb($tabs.filter('.is-active')[0], true);
    })();

    $('#selEmpresaIA').select2({ width: '100%', allowClear: false });
    $('#selEmpresaIA').on('change', function () {
        var idEmpresa = $(this).val();
        if (!idEmpresa) {
            document.getElementById('empresaIAVacio').style.display = '';
            document.getElementById('empresaIAContenido').style.display = 'none';
            return;
        }
        cargarResumenEmpresaIA(idEmpresa);
    });

    function cargarResumenEmpresaIA(idEmpresa) {
        document.getElementById('empresaIAVacio').style.display = 'none';
        document.getElementById('empresaIAContenido').style.display = 'none';
        document.getElementById('empresaIACargando').style.display = '';

        $.ajax({
            url: _empIAMsg.urlResumen,
            type: 'GET',
            data: { idEmpresa: idEmpresa },
            success: function (r) {
                document.getElementById('empresaIACargando').style.display = 'none';
                if (!r || !r.ok) {
                    Swal.fire({ icon:'error', title:'Error', text:(r && r.mensaje) || _empIAMsg.errorCargar,
                        toast:true, position:'top-end', showConfirmButton:false, timer:3500 });
                    return;
                }
                _empIAActual = r.resumen;
                pintarResumenEmpresaIA(r.resumen);
                document.getElementById('empresaIAContenido').style.display = '';
            },
            error: function () {
                document.getElementById('empresaIACargando').style.display = 'none';
                Swal.fire({ icon:'error', title:'Error', text: _empIAMsg.errorCargar,
                    toast:true, position:'top-end', showConfirmButton:false, timer:3500 });
            }
        });
    }

    function empEsc(s) { return $('<div>').text(s == null ? '' : s).html(); }

    function marcarSucio() {
        $('#btnGuardarControl').prop('disabled', false);
        $('#empDirty').addClass('on').text(_empIAMsg.cambios);
    }
    function limpiarSucio() {
        $('#btnGuardarControl').prop('disabled', true);
        $('#empDirty').removeClass('on').text(_empIAMsg.sinCambios);
    }
    $('#cfgeForm').on('input change', 'input, select, textarea', marcarSucio);

    function pintarResumenEmpresaIA(resumen) {
        var consumido = Number(resumen.ConsumidoMes || 0);
        document.getElementById('empConsumoNum').textContent = consumido.toLocaleString();
        document.getElementById('empConsumoDe').textContent = resumen.Ilimitado
            ? _empIAMsg.sinLimite
            : _empIAMsg.deTokens.replace('{0}', Number(resumen.PresupuestoEfectivo).toLocaleString());

        var pct = resumen.Ilimitado ? null : resumen.PorcentajeConsumido;
        var $pct = $('#empConsumoPct').removeClass('warn bad');
        $pct.toggle(pct !== null).text(pct === null ? '' : pct + '%');
        if (pct !== null && pct >= 100) $pct.addClass('bad'); else if (pct !== null && pct >= 80) $pct.addClass('warn');

        var barra = document.getElementById('empConsumoBarra');
        barra.style.width = resumen.Ilimitado ? '0%' : Math.min(100, pct) + '%';
        barra.classList.toggle('agotado', pct !== null && pct >= 100);

        var meta = '<span class="cfgg-chip"><i class="fas fa-calendar-alt"></i>' + empEsc(_empIAMsg.periodoDesde.replace('{0}', resumen.InicioPeriodo)) + '</span>';
        if (resumen.EnPool) meta += '<span class="cfgg-chip"><i class="fas fa-layer-group"></i>' +
            empEsc(_empIAMsg.poolActivo.replace('{0}', resumen.NombreGrupo || '').replace('{1}', resumen.EmpresasEnPool)) + '</span>';
        document.getElementById('empConsumoMeta').innerHTML = meta;

        var cfg = resumen.Config || {};
        var activa = cfg.IaHabilitada !== false;
        $('#empEstado').show().removeClass('ok bad').addClass(activa ? 'ok' : 'bad')
            .html('<i class="fas ' + (activa ? 'fa-check-circle' : 'fa-ban') + '"></i>' + empEsc(activa ? _empIAMsg.estadoActiva : _empIAMsg.estadoApagada));

        document.getElementById('empHabilitada').checked = activa;
        document.getElementById('empPolitica').value = cfg.PoliticaAgotado || 'Bloquear';
        document.getElementById('empDiaCorte').value = (cfg.DiaCorte === null || cfg.DiaCorte === undefined) ? '' : cfg.DiaCorte;
        document.getElementById('empTopeUsuario').value = (cfg.TopeDiarioUsuario === null || cfg.TopeDiarioUsuario === undefined) ? '' : cfg.TopeDiarioUsuario;
        document.getElementById('empModelo').value = cfg.ModeloPermitido || '';
        document.getElementById('empContexto').value = cfg.ContextoNegocio || '';
        var poolChk = document.getElementById('empPool');
        poolChk.checked = !!cfg.PoolGrupo && resumen.TieneGrupo;
        poolChk.disabled = !resumen.TieneGrupo;
        document.getElementById('empPoolHint').setAttribute('title', resumen.TieneGrupo ? _empIAMsg.poolHint : _empIAMsg.poolSinGrupo);
        var funciones = cfg.FuncionesPermitidas; // null = todas
        $('.emp-func').each(function () {
            this.checked = !funciones || funciones.indexOf(this.value) >= 0;
        });

        var inputPresupuesto = document.getElementById('empPresupuestoInput');
        inputPresupuesto.value = (resumen.PresupuestoOverride === null || resumen.PresupuestoOverride === undefined)
            ? '' : resumen.PresupuestoOverride;
        inputPresupuesto.placeholder = _empIAMsg.presupuestoPlaceholder
            .replace('{0}', resumen.PresupuestoGlobalDefault > 0
                ? resumen.PresupuestoGlobalDefault.toLocaleString()
                : _empIAMsg.ilimitado);

        limpiarSucio();
        pintarUsuariosIA(resumen.Usuarios || []);
    }

    function pintarUsuariosIA(usuarios) {
        var cont = document.getElementById('empUsuariosBody');
        cont.innerHTML = '';
        if (!usuarios.length) {
            cont.innerHTML = '<div class="cfgu-vacio">' + empEsc(_empIAMsg.sinUsuarios) + '</div>';
            document.getElementById('empUsuariosCuenta').textContent = '0';
            return;
        }
        usuarios.forEach(function (u) {
            var nombre = u.NombreCompleto || '';
            var iniciales = nombre.split(/\s+/).filter(Boolean).slice(0, 2).map(function (p) { return p.charAt(0).toUpperCase(); }).join('') || '?';
            var div = document.createElement('div');
            div.className = 'cfge-user' + (u.AccesoEfectivo ? '' : ' off');
            div.innerHTML =
                '<span class="cfge-avatar" aria-hidden="true">' + empEsc(iniciales) + '</span>' +
                '<div class="cfge-uinfo"><div class="n" title="' + empEsc(nombre) + '">' + empEsc(nombre) + '</div><div class="m" title="' + empEsc(u.Correo) + '">' + empEsc(u.Correo) + '</div></div>' +
                '<div class="custom-control custom-switch"><input type="checkbox" class="custom-control-input cfge-uacc" id="uacc' + u.Id + '" data-id="' + u.Id + '"' + (u.AccesoEfectivo ? ' checked' : '') + '>' +
                '<label class="custom-control-label" for="uacc' + u.Id + '"><span class="sr-only">' + empEsc(_empIAMsg.accesoPermitido) + ': ' + empEsc(nombre) + '</span></label></div>';
            cont.appendChild(div);
        });
        actualizarCuentaUsuarios();
    }

    function actualizarCuentaUsuarios() {
        var total = $('.cfge-uacc').length, con = $('.cfge-uacc:checked').length;
        document.getElementById('empUsuariosCuenta').textContent = _empIAMsg.usuariosCuenta.replace('{0}', con).replace('{1}', total);
    }

    $(document).on('change', '.cfge-uacc', function () {
        var $chk = $(this);
