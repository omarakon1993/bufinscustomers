    ══════════════════════════════════════ -->
    <div class="modal fade" id="editarModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width:540px;">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editarModalTitle">
                        <i class="fas fa-edit" style="color:#583AFF;"></i>
                        <span id="editarModalTitleText">@Resources.Strings.CfgIA_ModalEditTitle</span>
                    </h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <form method="post" action="@Url.Action("Guardar","ConfiguracionGlobalIA")">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">

                        <!-- Clave -->
                        <div class="mb-3 mt-2">
                            <label class="form-label" style="font-size:.82rem;font-weight:600;">
                                <i class="fas fa-hashtag mr-1" style="color:#583AFF;"></i>@Resources.Strings.CfgIA_LabelClave
                                <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control form-control-sm"
                                   id="editClave" name="Clave" required
                                   style="font-family:monospace;" />
                            <small id="claveReadonlyNote" class="text-muted" style="display:none;">
                                <i class="fas fa-lock mr-1"></i>La clave de un par&aacute;metro existente no se puede cambiar.
                                Para cambiar la clave, elimina este y crea uno nuevo.
                            </small>
                        </div>

                        <!-- Descripción -->
                        <div class="mb-3">
                            <label class="form-label" style="font-size:.82rem;font-weight:600;">
                                <i class="fas fa-align-left mr-1" style="color:#583AFF;"></i>@Resources.Strings.CfgIA_LabelDescripcion
                            </label>
                            <input type="text" class="form-control form-control-sm"
                                   id="editDescripcion" name="Descripcion" maxlength="300" />
                        </div>

                        <!-- Valor — cambia según la clave -->
                        <div class="mb-3">
                            <label class="form-label" style="font-size:.82rem;font-weight:600;">
                                <i class="fas fa-pencil-alt mr-1" style="color:#583AFF;"></i>@Resources.Strings.CfgIA_LabelValor
                                <span class="text-danger">*</span>
                            </label>

                            <!-- API Key: password con toggle. Empieza vacío; vacío = no cambiar. -->
                            <div id="wrapApiKey" style="display:none;">
                                <div class="input-pass-wrap">
                                    <input type="password" class="form-control form-control-sm"
                                           id="editValorApiKey" autocomplete="off"
                                           placeholder="@Resources.Strings.CfgIA_ApiKeySinCambios" />
                                    <button type="button" class="btn-eye" onclick="toggleApiKey()">
                                        <i class="fas fa-eye" id="eyeIcon"></i>
                                    </button>
                                </div>
                                <div class="d-flex align-items-center flex-wrap mt-1" style="gap:8px;">
                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="revelarApiKey()">
                                        <i class="fas fa-unlock-alt mr-1"></i>@Resources.Strings.CfgIA_BtnRevelar
                                    </button>
                                    <small class="text-muted" style="font-size:.72rem;">
                                        <i class="fas fa-shield-alt mr-1 text-success"></i>@Resources.Strings.CfgIA_ApiKeyHint
                                    </small>
                                </div>
                            </div>

                            <!-- Modelo (OpenAIModel / IA_ModeloEconomico): desplegable de los modelos de OpenAI -->
                            <div id="wrapModelo" style="display:none;">
                                <div id="modalModeloHost"></div>
                                <small class="text-muted d-block mt-1" style="font-size:.72rem;">
                                    <i class="fas fa-info-circle mr-1"></i>@Resources.Strings.CfgIA_ModeloHint
                                </small>
                            </div>

                            <!-- MaxTokens: número con rango -->
                            <div id="wrapTokens" style="display:none;">
                                <input type="number" class="form-control form-control-sm"
                                       id="editValorTokens" min="100" max="32000" step="100" />
                                <small class="text-muted" style="font-size:.72rem;">
                                    <i class="fas fa-info-circle mr-1"></i>@Resources.Strings.CfgIA_MaxTokensHint
                                </small>
                            </div>

                            <!-- Genérico: texto libre -->
                            <div id="wrapGenerico" style="display:none;">
                                <input type="text" class="form-control form-control-sm"
                                       id="editValorGenerico" maxlength="500" />
                            </div>

                            <!-- Input oculto que siempre se envía -->
                            <input type="hidden" id="editValor" name="Valor" />
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                            <i class="fas fa-times mr-1"></i>@Resources.Strings.Layout_Cancel
                        </button>
                        <button type="button" class="btn btn-primary btn-sm" onclick="submitGuardar()">
                            <i class="fas fa-save mr-1"></i>@Resources.Strings.CfgIA_BtnGuardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════
         MODAL ELIMINAR
    ══════════════════════════════════════ -->
    <div class="modal fade modal-confirm" id="eliminarModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle"></i> @Resources.Strings.CfgIA_TitleEliminar
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        <i class="fas fa-question-circle text-warning mr-2"></i>
                        @Resources.Strings.CfgIA_ModalDeleteBody
                        <strong id="eliminarClaveNombre"></strong>?
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i>@Resources.Strings.Layout_Cancel
                    </button>
                    <form method="post" action="@Url.Action("Eliminar","ConfiguracionGlobalIA")" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="eliminarClave" name="clave" />
                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="fas fa-trash-alt mr-1"></i>@Resources.Strings.Common_BtnEliminar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <script>Swal.fire({ toast:true, position: window.innerWidth<=768?'top':'top-end', icon:'error',   title:'@Html.Raw(TempData["ErrorMessage"])', showConfirmButton:false, timer:3500, timerProgressBar:true });</script>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <script>Swal.fire({ toast:true, position: window.innerWidth<=768?'top':'top-end', icon:'success', title:'@Html.Raw(TempData["SuccessMessage"])', showConfirmButton:false, timer:3000, timerProgressBar:true });</script>
    }

    @section scripts {
    <script src="~/Assets/js/select2/select2.min.js"></script>
    <script>
    var _cfgMsg = {
        cargando:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_JS_CargandoModelos))',
        cargados:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_JS_ModelosCargados))',
        errorModelos:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_JS_ErrorModelos))',
        apiKeyVacia:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_JS_ApiKeyVacia))',
        tituloEditar:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_ModalEditTitle))',
        tituloCrear:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_ModalCreateTitle))',
        mpPlaceholder:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Modelo_Placeholder))',
        mpGlobal:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Modelo_Global))',
        mpRecargar:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Modelo_Recargar))',
        mpAbrir:        '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Modelo_Abrir))',
        mpSinResultados:'@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Modelo_SinResultados))',
        urlCargar:      '@Url.Action("ObtenerModelosOpenAI","ConfiguracionGlobalIA")'
    };

    // ── clave activa en el modal ──
    var _claveActiva = '';
    var _modoCrear   = false;

    function abrirEditar(clave, valor, desc) {
        _claveActiva = clave;
        _modoCrear   = false;
        document.getElementById('editarModalTitleText').textContent = _cfgMsg.tituloEditar;
        document.getElementById('editClave').value       = clave;
        document.getElementById('editClave').readOnly    = true;
        document.getElementById('editDescripcion').value = desc;
        document.getElementById('claveReadonlyNote').style.display = 'block';
        configurarWrap(clave, valor);
        $('#editarModal').modal('show');
    }

    function abrirNuevo() {
        _claveActiva = '';
        _modoCrear   = true;
        document.getElementById('editarModalTitleText').textContent = _cfgMsg.tituloCrear;
        document.getElementById('editClave').value       = '';
        document.getElementById('editClave').readOnly    = false;
        document.getElementById('editDescripcion').value = '';
        document.getElementById('claveReadonlyNote').style.display = 'none';
        configurarWrap('', '');
        $('#editarModal').modal('show');
    }

    function abrirEliminar(clave) {
        document.getElementById('eliminarClave').value         = clave;
        document.getElementById('eliminarClaveNombre').textContent = '"' + clave + '"';
        $('#eliminarModal').modal('show');
    }

    // ── selecciona el control correcto según la clave ──
    function configurarWrap(clave, valor) {
        ['wrapApiKey','wrapModelo','wrapTokens','wrapGenerico'].forEach(function(id) {
            document.getElementById(id).style.display = 'none';
        });

        if (clave === 'OpenAIApiKey') {
            document.getElementById('wrapApiKey').style.display = '';
            document.getElementById('editValorApiKey').value = valor;
        } else if (esClaveModelo(clave)) {
            document.getElementById('wrapModelo').style.display = '';
            document.getElementById('editValorModelo').value = valor;
        } else if (clave === 'OpenAIMaxTokens') {
            document.getElementById('wrapTokens').style.display = '';
            document.getElementById('editValorTokens').value = valor;
        } else {
            document.getElementById('wrapGenerico').style.display = '';
            document.getElementById('editValorGenerico').value = valor;
        }
    }

    // ── toggle show/hide API Key ──
    function toggleApiKey() {
        var inp = document.getElementById('editValorApiKey');
        var ico = document.getElementById('eyeIcon');
        if (inp.type === 'password') {
            inp.type = 'text';
            ico.className = 'fas fa-eye-slash';
        } else {
            inp.type = 'password';
            ico.className = 'fas fa-eye';
        }
    }

    // ── revelar la API Key actual (llamada auditada al servidor) ──
    function revelarApiKey() {
        var token = $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url: '@Url.Action("Revelar", "ConfiguracionGlobalIA")',
            type: 'POST',
            data: { clave: 'OpenAIApiKey', __RequestVerificationToken: token },
            success: function (r) {
                if (r && r.ok) {
                    var inp = document.getElementById('editValorApiKey');
                    inp.value = r.valor || '';
                    inp.type  = 'text';
                    document.getElementById('eyeIcon').className = 'fas fa-eye-slash';
                } else {
                    Swal.fire({ icon:'error', title:'Error', text:(r && r.mensaje) || 'No se pudo revelar la clave.',
                        toast:true, position:'top-end', showConfirmButton:false, timer:3500 });
                }
            },
            error: function () {
                Swal.fire({ icon:'error', title:'Error', text:'No se pudo revelar la clave.',
                    toast:true, position:'top-end', showConfirmButton:false, timer:3500 });
            }
        });
    }

    // ── recopila el valor del control activo y envía el form ──
    function submitGuardar() {
        var clave = document.getElementById('editClave').value.trim();
        if (!clave) {
            Swal.fire({ icon:'warning', title:'Clave requerida', text:'El campo Clave es requerido.', toast:true, position:'top-end', showConfirmButton:false, timer:2500 });
            return;
        }

        var valor = '';
        if (clave === 'OpenAIApiKey') {
            valor = document.getElementById('editValorApiKey').value.trim();
        } else if (esClaveModelo(clave)) {
            valor = document.getElementById('editValorModelo').value.trim();
        } else if (clave === 'OpenAIMaxTokens') {
            valor = document.getElementById('editValorTokens').value.trim();
        } else {
            valor = document.getElementById('editValorGenerico').value.trim();
        }

        // Para la API key, vacío es válido: significa "no cambiar" (el servidor conserva la actual).
        if (!valor && clave !== 'OpenAIApiKey') {
            Swal.fire({ icon:'warning', title:'Valor requerido', text:'El campo Valor es requerido.', toast:true, position:'top-end', showConfirmButton:false, timer:2500 });
            return;
        }

        document.getElementById('editValor').value = valor;

        // Re-habilitar clave para que la envíe el form
        var claveInput = document.getElementById('editClave');
        claveInput.readOnly = false;
        claveInput.closest('form').submit();
    }

    // Claves cuyo valor es el nombre de un modelo de OpenAI: usan el mismo desplegable.
    function esClaveModelo(clave) { return clave === 'OpenAIModel' || clave === 'IA_ModeloEconomico' || clave === 'IA_ModeloSimple'; }

    // ══════════════════════════════════════
    // SELECTOR DE MODELOS DE OPENAI (reutilizable)
    //  - Se carga la lista una sola vez (y se comparte entre todos los selectores); botón para recargarla.
    //  - Se puede elegir de la lista, filtrar escribiendo o escribir un modelo que no aparezca.
    //  - Teclado: ↑ ↓ Enter Esc.
    // ══════════════════════════════════════
    var ModelosOpenAI = { lista: null, cargando: false, error: null, esperando: [] };

    function cargarListaModelos(forzar, cb) {
        if (ModelosOpenAI.lista && !forzar) { if (cb) cb(); return; }
        if (cb) ModelosOpenAI.esperando.push(cb);
        if (ModelosOpenAI.cargando) return;
        ModelosOpenAI.cargando = true;
        function terminar() {
            ModelosOpenAI.cargando = false;
            var cbs = ModelosOpenAI.esperando.splice(0);
            cbs.forEach(function (f) { f(); });
        }
        $.ajax({ url: _cfgMsg.urlCargar, type: 'GET' }).done(function (r) {
            if (r && r.ok) { ModelosOpenAI.lista = r.modelos || []; ModelosOpenAI.error = null; }
            else { ModelosOpenAI.error = (r && r.mensaje) || _cfgMsg.errorModelos; }
        }).fail(function () { ModelosOpenAI.error = _cfgMsg.errorModelos; }).always(terminar);
    }

    function mpEsc(s) { return $('<div>').text(s == null ? '' : s).html(); }

    function ModeloPicker(host, opts) {
        var id = opts.id, uid = id + '_dd', activo = -1, abierto = false, filtrando = false;
        var $host = $(host);
        $host.html(
            '<div class="modelo-select-wrap">' +
              '<div class="mp-field">' +
                '<input type="text" class="mp-input" id="' + id + '" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="' + uid + '" placeholder="' + mpEsc(opts.placeholder || _cfgMsg.mpPlaceholder) + '" />' +
                '<button type="button" class="mp-btn mp-reload" tabindex="-1" title="' + mpEsc(_cfgMsg.mpRecargar) + '" aria-label="' + mpEsc(_cfgMsg.mpRecargar) + '"><i class="fas fa-sync-alt"></i></button>' +
                '<span class="mp-sep" aria-hidden="true"></span>' +
                '<button type="button" class="mp-btn mp-toggle" tabindex="-1" title="' + mpEsc(_cfgMsg.mpAbrir) + '" aria-label="' + mpEsc(_cfgMsg.mpAbrir) + '"><i class="fas fa-chevron-down"></i></button>' +
              '</div>' +
              '<div class="modelos-dropdown" id="' + uid + '" style="display:none;"><div class="modelos-lista" role="listbox"></div><div class="mp-foot"></div></div>' +
            '</div>');

        var $input = $host.find('#' + id), $dd = $host.find('.modelos-dropdown'), $lista = $dd.find('.modelos-lista'), $foot = $dd.find('.mp-foot');
        var $chev = $host.find('.mp-toggle i'), $reload = $host.find('.mp-reload i');

        function items() {
            var q = filtrando ? $.trim($input.val()).toLowerCase() : '';
            var base = (ModelosOpenAI.lista || []).filter(function (m) { return !q || m.toLowerCase().indexOf(q) >= 0; });
            var res = base.map(function (m) { return { v: m, t: m }; });
            if (opts.vacio && !q) res.unshift({ v: '', t: opts.vacio });
            return res;
        }

        function pintar() {
            var lista = items(), actual = $input.val();
            if (!lista.length) {
                $lista.html('<div class="modelo-item-empty">' + mpEsc(_cfgMsg.mpSinResultados) + '</div>');
            } else {
                $lista.html(lista.map(function (it, i) {
                    var cls = 'modelo-item' + (it.v === actual ? ' activo' : '') + (i === activo ? ' hl' : '') + (it.v === '' ? ' mp-vacio' : '');
                    return '<div class="' + cls + '" role="option" data-val="' + mpEsc(it.v) + '"><span>' + mpEsc(it.t) + '</span>' +
                           (it.v === actual ? '<i class="fas fa-check"></i>' : '') + '</div>';
                }).join(''));
                var a = $lista.find('.activo, .hl')[0];
                if (a) a.scrollIntoView({ block: 'nearest' });
            }
            if (ModelosOpenAI.cargando) $foot.removeClass('err').html('<i class="fas fa-circle-notch fa-spin mr-1"></i>' + mpEsc(_cfgMsg.cargando));
            else if (ModelosOpenAI.error) $foot.addClass('err').text(ModelosOpenAI.error);
            else $foot.removeClass('err').text((ModelosOpenAI.lista || []).length + ' ' + _cfgMsg.cargados);
        }

        function abrir() {
            if (abierto) return;
            abierto = true; filtrando = false; activo = -1;
            $dd.show(); $input.attr('aria-expanded', 'true'); $chev.attr('class', 'fas fa-chevron-up');
            pintar();
            if (!ModelosOpenAI.lista) cargarListaModelos(false, function () { if (abierto) pintar(); });
        }
        function cerrar() {
            if (!abierto) return;
            abierto = false; $dd.hide(); $input.attr('aria-expanded', 'false'); $chev.attr('class', 'fas fa-chevron-down');
        }
        function elegir(v) {
            $input.val(v).trigger('input'); // 'input' para que el formulario detecte el cambio
            cerrar();
        }

        $input.on('focus', abrir);
        $input.on('input', function () { filtrando = true; activo = -1; if (!abierto) abrir(); else pintar(); });
        $input.on('keydown', function (e) {
            var lista = items();
            if (e.which === 40 || e.which === 38) {
                e.preventDefault();
                if (!abierto) { abrir(); return; }
                activo = e.which === 40 ? Math.min(lista.length - 1, activo + 1) : Math.max(0, activo - 1);
                pintar();
            } else if (e.which === 13 && abierto && activo >= 0 && lista[activo]) {
                e.preventDefault(); elegir(lista[activo].v);
            } else if (e.which === 13 && abierto) {
                e.preventDefault(); cerrar(); // Enter sin opción resaltada: conserva lo escrito sin enviar el formulario del modal
            } else if (e.which === 27) { cerrar(); }
        });
        $host.find('.mp-toggle').on('click', function () { if (abierto) cerrar(); else { abrir(); $input.focus(); } });
        $host.find('.mp-reload').on('click', function () {
            $reload.addClass('fa-spin');
            if (!abierto) abrir();
            cargarListaModelos(true, function () { $reload.removeClass('fa-spin'); if (abierto) pintar(); });
            pintar();
        });
        $lista.on('mousedown', '.modelo-item', function (e) { e.preventDefault(); elegir(String($(this).attr('data-val'))); });
        $(document).on('mousedown', function (e) { if (!$host[0].contains(e.target)) cerrar(); });

        return {
            getValue: function () { return $.trim($input.val()); },
            setValue: function (v) { $input.val(v || ''); },
            close: cerrar
        };
    }

    // Instancias: modal de parámetros (OpenAIModel / IA_ModeloEconomico) y "Modelo fijo de la empresa".
    var pickModal = ModeloPicker('#modalModeloHost', { id: 'editValorModelo' });
