﻿@model IEnumerable<bufinscustomers.Models.ConfiguracionSistemaItem>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <title>@Resources.Strings.CfgIA_PageTitle</title>
    <script src="~/Assets/js/sweetalert2.all.min.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="~/Assets/css/configuracion-admin.css" rel="stylesheet" />
    <link href="~/Assets/css/bufins-components.css" rel="stylesheet" />
    <link href="~/Assets/css/select2/select2.min.css" rel="stylesheet" />
    <style>
        /* ── Panel de configuración ── */
        .cfg-ia-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
            gap: 18px;
            padding: 20px;
        }
        .cfg-ia-card {
            background: #fff;
            border-radius: 14px;
            border: 1px solid #ede9fe;
            box-shadow: 0 2px 12px rgba(22,9,51,.08);
            overflow: hidden;
            transition: box-shadow .2s;
        }
        .cfg-ia-card:hover { box-shadow: 0 4px 20px rgba(22,9,51,.15); }
        .cfg-ia-card-header {
            background: var(--content-gradient);
            padding: 12px 16px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .cfg-ia-card-icon {
            width: 34px; height: 34px;
            background: rgba(255,255,255,.18);
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 1rem;
        }
        .cfg-ia-card-title {
            font-size: .82rem; font-weight: 700; color: #fff;
            font-family: 'Courier New', monospace; letter-spacing: .3px;
        }
        .cfg-ia-card-body { padding: 16px; }
        .cfg-ia-desc {
            font-size: .75rem; color: #6b7280; margin-bottom: 10px;
            min-height: 18px;
        }
        .cfg-ia-valor-row {
            display: flex; align-items: center; gap: 8px;
            background: #f9f8ff; border: 1px solid #e0e7ff;
            border-radius: 8px; padding: 8px 12px;
        }
        .cfg-ia-valor-text {
            flex: 1; font-size: .82rem; color: #374151;
            font-family: 'Courier New', monospace;
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        }
        .cfg-ia-valor-text.masked { color: #9ca3af; font-style: italic; }
        .cfg-ia-actions { display: flex; gap: 6px; margin-top: 12px; }
        /* Botón "Cargar modelos" */
        .btn-load-models {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 6px 14px; font-size: .78rem; font-weight: 600;
            border: 1.5px solid #583AFF; border-radius: 8px;
            background: #fff; color: #583AFF; cursor: pointer;
            transition: all .2s; white-space: nowrap;
        }
        .btn-load-models:hover { background: #583AFF; color: #fff; }
        .btn-load-models:disabled { opacity: .6; cursor: not-allowed; }
        /* Hint badge verde OK */
        .modelos-badge {
            display: inline-flex; align-items: center; gap: 4px;
            font-size: .72rem; color: #065f46; background: #d1fae5;
            border: 1px solid #6ee7b7; border-radius: 999px;
            padding: 2px 10px; margin-top: 4px;
        }
        /* Custom modelo dropdown */
        .modelo-select-wrap { position: relative; }
        .modelos-dropdown {
            position: absolute;
            top: calc(100% + 2px); left: 0; right: 0;
            background: #fff;
            border: 1.5px solid #583AFF;
            border-radius: 10px;
            box-shadow: 0 8px 28px rgba(22,9,51,.18);
            z-index: 1060;
            overflow: hidden;
        }
        .modelos-search-wrap {
            padding: 8px 10px 6px;
            border-bottom: 1px solid #ede9fe;
            background: #f9f8ff;
        }
        .modelos-search-wrap input {
            width: 100%; border: 1px solid #c4b5fd; border-radius: 6px;
            padding: 4px 10px; font-size: .78rem; outline: none;
            background: #fff; color: #374151;
        }
        .modelos-search-wrap input:focus { border-color: #583AFF; }
        .modelos-lista {
            max-height: 200px;
            overflow-y: auto;
            padding: 4px 0;
        }
        .modelos-lista::-webkit-scrollbar { width: 5px; }
        .modelos-lista::-webkit-scrollbar-track { background: #f3f0ff; }
        .modelos-lista::-webkit-scrollbar-thumb { background: #a5b4fc; border-radius: 4px; }
        .modelo-item {
            padding: 7px 14px; font-size: .82rem;
            font-family: 'Courier New', monospace;
            cursor: pointer; color: #374151;
            border-bottom: 1px solid #f5f3ff;
            transition: background .1s;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        .modelo-item:last-child { border-bottom: none; }
        .modelo-item:hover { background: #ede9fe; color: #583AFF; }
        .modelo-item.activo { background: #583AFF; color: #fff; font-weight: 600; }
        .modelo-item strong { color: inherit; text-decoration: underline; }
        .modelo-item-empty {
            padding: 12px 14px; font-size: .78rem; color: #9ca3af; text-align: center;
        }
        /* Input password toggle */
        .input-pass-wrap { position: relative; }
        .input-pass-wrap .btn-eye {
            position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
            background: none; border: none; color: #9ca3af; cursor: pointer; padding: 0;
        }
        .input-pass-wrap .btn-eye:hover { color: #583AFF; }
        /* Separador nueva cfg */
        .cfg-nueva-section {
            padding: 0 20px 20px;
        }
        /* ── Tabs General / Por Empresa — segmented control con "thumb" deslizante (mismo lenguaje visual que AuditoriaHub) ── */
        .cfgia-seg {
            position: relative; display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px;
            padding: 6px; background: #eef0f4; border: 1px solid #e3e6eb; border-radius: 999px;
            max-width: 360px; margin: 18px 20px 0;
        }
        .cfgia-seg-thumb {
            position: absolute; left: 0; top: 0; width: 0; height: 0; border-radius: 999px;
            background: var(--content-gradient); box-shadow: 0 8px 20px -8px rgba(59,130,246,.6);
            transform: translate(0, 0);
            transition: transform .42s cubic-bezier(.32,.72,0,1), width .42s cubic-bezier(.32,.72,0,1), height .42s cubic-bezier(.32,.72,0,1);
            will-change: transform, width, height; pointer-events: none; z-index: 0;
        }
        .cfgia-seg-thumb.no-anim { transition: none; }
        .cfgia-seg-btn {
            position: relative; z-index: 1; border: 0; background: transparent; color: #5b6472;
            font-size: .85rem; font-weight: 600; padding: .6rem .6rem; border-radius: 999px; cursor: pointer;
            display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
            white-space: nowrap; transition: color .34s ease;
        }
        .cfgia-seg-btn:hover:not(.is-active) { color: #3b3f66; }
        .cfgia-seg-btn.is-active { color: #fff; }
        @@media (prefers-reduced-motion: reduce) { .cfgia-seg-thumb { transition: none; } }

        .cfg-ia-emp-panel { padding:20px; }
        .cfg-ia-emp-barra-track { background:#ede9fe; border-radius:999px; height:10px; overflow:hidden; }
        .cfg-ia-emp-barra-fill { height:100%; background:var(--content-gradient); width:0%; transition:width .4s ease; }
        .cfg-ia-emp-barra-fill.agotado { background:linear-gradient(135deg,#ef4444,#b91c1c); }
        .cfg-ia-emp-acceso-btn { min-width:120px; border-radius: 999px !important; font-weight:600; }
        .cfg-ia-emp-presupuesto-row { display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
        .cfg-ia-emp-presupuesto-row input[type="number"] { max-width:260px; }
        #empUsuariosBody td { vertical-align: middle; }
    </style>
</head>
<body>

    <!-- ── Header ── -->
    <div class="powerbi-header" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
        <div class="powerbi-header-content">
            <i class="fas fa-sliders-h powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@Resources.Strings.CfgIA_PageTitle</h1>
        </div>
        <small style="font-weight:400;opacity:.85;color:#fff;">@Resources.Strings.CfgIA_HeaderDesc</small>
    </div>

    <!-- ── Tabs ── -->
    <div class="cfgia-seg" id="cfgiaTabs" role="tablist">
        <span class="cfgia-seg-thumb no-anim" aria-hidden="true"></span>
        <button type="button" class="cfgia-seg-btn is-active" data-tab="general">
            <i class="fas fa-sliders-h"></i>@Resources.Strings.CfgIA_TabGeneral
        </button>
        <button type="button" class="cfgia-seg-btn" data-tab="empresa">
            <i class="fas fa-building"></i>@Resources.Strings.CfgIA_TabPorEmpresa
        </button>
    </div>

    <div id="panelGeneral">

    <!-- ── Grid de tarjetas ── -->
    @if (!Model.Any())
    {
        <div class="card shadow mb-4">
            <div class="card-body text-center text-muted py-4">
                <i class="fas fa-cog fa-2x mb-2"></i>
                <p>@Resources.Strings.CfgIA_NoItems</p>
            </div>
        </div>
    }
    else
    {
        <div class="cfg-ia-grid">
            @foreach (var item in Model)
            {
                bool esApiKey  = item.Clave == "OpenAIApiKey";
                bool esModelo  = item.Clave == "OpenAIModel";
                bool esTokens  = item.Clave == "OpenAIMaxTokens";

                string iconoCls = esApiKey  ? "fas fa-key"
                                : esModelo  ? "fas fa-robot"
                                : esTokens  ? "fas fa-tachometer-alt"
                                :             "fas fa-cog";

                // Los secretos ya llegan enmascarados desde el servicio; el resto se muestra tal cual.
                string valorVisible = item.EsSecreta
                    ? (string.IsNullOrEmpty(item.Valor) ? "—" : item.Valor)
                    : (item.Valor ?? "—");

                <div class="cfg-ia-card">
                    <div class="cfg-ia-card-header">
                        <div class="cfg-ia-card-icon"><i class="@iconoCls"></i></div>
                        <div class="cfg-ia-card-title">@item.Clave</div>
                    </div>
                    <div class="cfg-ia-card-body">
                        <div class="cfg-ia-desc">
                            @(string.IsNullOrWhiteSpace(item.Descripcion) ? "—" : item.Descripcion)
                        </div>
                        <div class="cfg-ia-valor-row">
                            <span class="cfg-ia-valor-text @(item.EsSecreta ? "masked" : "")">@valorVisible</span>
                            @if (item.EsSecreta)
                            {
                                <small class="text-muted" style="font-size:.68rem;white-space:nowrap;">
                                    <i class="fas fa-lock"></i> @Resources.Strings.CfgIA_LabelMasked
                                </small>
                            }
                        </div>
                        <div class="cfg-ia-actions">
                            <button type="button" class="btn btn-primary btn-sm"
                                    title="@Resources.Strings.CfgIA_TitleEditar"
                                    onclick="abrirEditar('@Html.Raw(item.Clave)', '@Html.Raw(item.EsSecreta ? "" : (item.Valor ?? "").Replace("'", "\\'"))', '@Html.Raw((item.Descripcion ?? "").Replace("'", "\\'"))')">
                                <i class="fas fa-edit mr-1"></i>@Resources.Strings.CfgIA_TitleEditar
                            </button>
                            <button type="button" class="btn btn-danger btn-sm"
                                    title="@Resources.Strings.CfgIA_TitleEliminar"
                                    onclick="abrirEliminar('@Html.Raw(item.Clave)')">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- ── Botón Nueva configuración ── -->
    <div class="cfg-nueva-section">
        <button type="button" class="btn-modern-success"
                onclick="abrirNuevo()">
            <i class="fas fa-plus-circle mr-1"></i>@Resources.Strings.CfgIA_BtnCrear
        </button>
    </div>

    </div><!-- /panelGeneral -->

    <!-- ══════════════════════════════════════
         TAB: POR EMPRESA
    ══════════════════════════════════════ -->
    <div id="panelPorEmpresa" class="cfg-ia-emp-panel" style="display:none;">

        <div class="filter-card" style="margin-bottom:18px;">
            <div class="form-group" style="max-width:420px;margin-bottom:0;">
                <label class="form-label" style="font-weight:600;">
                    <i class="fas fa-building mr-1" style="color:#583AFF;"></i>@Resources.Strings.CfgIA_Emp_SelLabel
                </label>
                <select id="selEmpresaIA" class="form-control select2" style="width:100%;">
                    <option value="">@Resources.Strings.CfgIA_Emp_SelPlaceholder</option>
                    @foreach (var empresa in ViewBag.Empresas)
                    {
                        <option value="@empresa.Id">@empresa.Nombre</option>
                    }
                </select>
            </div>
        </div>

        <div id="empresaIAVacio" class="no-data-message">
            <i class="fas fa-building"></i>
            <h4>@Resources.Strings.CfgIA_Emp_SeleccionaEmpresaMsg</h4>
        </div>

        <div id="empresaIACargando" style="display:none;text-align:center;padding:30px;color:#6b7280;">
            <i class="fas fa-circle-notch fa-spin fa-2x"></i>
        </div>

        <div id="empresaIAContenido" style="display:none;">

            <div class="cfg-ia-card" style="margin-bottom:18px;">
                <div class="cfg-ia-card-header">
                    <div class="cfg-ia-card-icon"><i class="fas fa-chart-pie"></i></div>
                    <div class="cfg-ia-card-title">@Resources.Strings.CfgIA_Emp_ConsumoTitulo</div>
                </div>
                <div class="cfg-ia-card-body">
                    <div id="empConsumoTexto" style="font-size:.92rem;font-weight:600;color:#374151;margin-bottom:8px;"></div>
                    <div class="cfg-ia-emp-barra-track">
                        <div id="empConsumoBarra" class="cfg-ia-emp-barra-fill"></div>
                    </div>
                </div>
            </div>

            <div class="cfg-ia-card" style="margin-bottom:18px;">
                <div class="cfg-ia-card-header">
                    <div class="cfg-ia-card-icon"><i class="fas fa-coins"></i></div>
                    <div class="cfg-ia-card-title">@Resources.Strings.CfgIA_Emp_PresupuestoTitulo</div>
                </div>
                <div class="cfg-ia-card-body">
                    <div class="cfg-ia-emp-presupuesto-row">
                        <input type="number" min="0" step="1000" class="form-control"
                               id="empPresupuestoInput" />
                        <button type="button" class="btn-modern-gradient" onclick="guardarPresupuestoEmpresaIA()">
                            <i class="fas fa-save mr-1"></i>@Resources.Strings.CfgIA_Emp_BtnGuardarPresupuesto
                        </button>
                    </div>
                    <small class="text-muted d-block mt-2">@Resources.Strings.CfgIA_Emp_PresupuestoHint</small>
                </div>
            </div>

            <div class="table-container">
                <div class="table-header">
                    <h5><i class="fas fa-users mr-2"></i>@Resources.Strings.CfgIA_Emp_UsuariosTitulo</h5>
                </div>
                <div style="padding:10px 16px 0;">
                    <small class="text-muted">@Resources.Strings.CfgIA_Emp_UsuariosDesc</small>
                </div>
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>@Resources.Strings.CfgIA_Emp_ColUsuario</th>
                                <th>@Resources.Strings.CfgIA_Emp_ColAcceso</th>
                            </tr>
                        </thead>
                        <tbody id="empUsuariosBody"></tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>

    <!-- ══════════════════════════════════════
         MODAL EDITAR / CREAR
    ══════════════════════════════════════ -->
    <div class="modal fade" id="editarModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width:540px;">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editarModalTitle">
                        <i class="fas fa-edit" style="color:#583AFF;"></i>
                        <span id="editarModalTitleText">@Resources.Strings.CfgIA_ModalEditTitle</span>
                    </h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <form method="post" action="@Url.Action("Guardar","ConfiguracionGlobalIA")">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">

                        <!-- Clave -->
                        <div class="mb-3 mt-2">
                            <label class="form-label" style="font-size:.82rem;font-weight:600;">
                                <i class="fas fa-hashtag mr-1" style="color:#583AFF;"></i>@Resources.Strings.CfgIA_LabelClave
                                <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control form-control-sm"
                                   id="editClave" name="Clave" required
                                   style="font-family:monospace;" />
                            <small id="claveReadonlyNote" class="text-muted" style="display:none;">
                                <i class="fas fa-lock mr-1"></i>La clave de un par&aacute;metro existente no se puede cambiar.
                                Para cambiar la clave, elimina este y crea uno nuevo.
                            </small>
                        </div>

                        <!-- Descripción -->
                        <div class="mb-3">
                            <label class="form-label" style="font-size:.82rem;font-weight:600;">
                                <i class="fas fa-align-left mr-1" style="color:#583AFF;"></i>@Resources.Strings.CfgIA_LabelDescripcion
                            </label>
                            <input type="text" class="form-control form-control-sm"
                                   id="editDescripcion" name="Descripcion" maxlength="300" />
                        </div>

                        <!-- Valor — cambia según la clave -->
                        <div class="mb-3">
                            <label class="form-label" style="font-size:.82rem;font-weight:600;">
                                <i class="fas fa-pencil-alt mr-1" style="color:#583AFF;"></i>@Resources.Strings.CfgIA_LabelValor
                                <span class="text-danger">*</span>
                            </label>

                            <!-- API Key: password con toggle. Empieza vacío; vacío = no cambiar. -->
                            <div id="wrapApiKey" style="display:none;">
                                <div class="input-pass-wrap">
                                    <input type="password" class="form-control form-control-sm"
                                           id="editValorApiKey" autocomplete="off"
                                           placeholder="@Resources.Strings.CfgIA_ApiKeySinCambios" />
                                    <button type="button" class="btn-eye" onclick="toggleApiKey()">
                                        <i class="fas fa-eye" id="eyeIcon"></i>
                                    </button>
                                </div>
                                <div class="d-flex align-items-center flex-wrap mt-1" style="gap:8px;">
                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="revelarApiKey()">
                                        <i class="fas fa-unlock-alt mr-1"></i>@Resources.Strings.CfgIA_BtnRevelar
                                    </button>
                                    <small class="text-muted" style="font-size:.72rem;">
                                        <i class="fas fa-shield-alt mr-1 text-success"></i>@Resources.Strings.CfgIA_ApiKeyHint
                                    </small>
                                </div>
                            </div>

                            <!-- Modelo: custom dropdown con búsqueda -->
                            <div id="wrapModelo" style="display:none;">
                                <div class="modelo-select-wrap mb-1" id="modeloSelectWrap">
                                    <div class="input-group input-group-sm">
                                        <input type="text" class="form-control form-control-sm"
                                               id="editValorModelo"
                                               placeholder="Ej: gpt-4o-mini" autocomplete="off"
                                               oninput="filtrarModelosDesdeInput(this.value)"
                                               onfocus="mostrarDropdownModelos()" />
                                        <div class="input-group-append">
                                            <button type="button" class="btn btn-outline-secondary btn-sm px-2"
                                                    onclick="toggleDropdownModelos()" tabindex="-1"
                                                    title="Ver modelos disponibles">
                                                <i class="fas fa-chevron-down" id="modeloChevron" style="font-size:.75rem;"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <!-- Panel dropdown -->
                                    <div id="modelosDropdown" class="modelos-dropdown" style="display:none;">
                                        <div class="modelos-search-wrap">
                                            <input type="text" id="modelosBuscar"
                                                   placeholder="Filtrar modelos..."
                                                   oninput="filtrarModelosPanel(this.value)" />
                                        </div>
                                        <div id="modelosLista" class="modelos-lista"></div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center flex-wrap mt-1" style="gap:8px;">
                                    <button type="button" class="btn-load-models" id="btnCargarModelos"
                                            onclick="cargarModelosOpenAI()">
                                        <i class="fas fa-sync-alt"></i>
                                        <span id="btnCargarModelosText">@Resources.Strings.CfgIA_BtnCargarModelos</span>
                                    </button>
                                    <span id="modelosBadge" style="display:none;" class="modelos-badge">
                                        <i class="fas fa-check-circle"></i>
                                        <span id="modelosCount">0</span> @Resources.Strings.CfgIA_JS_ModelosCargados
                                    </span>
                                </div>
                                <small class="text-muted d-block mt-1" style="font-size:.72rem;">
                                    <i class="fas fa-info-circle mr-1"></i>@Resources.Strings.CfgIA_ModeloHint
                                </small>
                            </div>

                            <!-- MaxTokens: número con rango -->
                            <div id="wrapTokens" style="display:none;">
                                <input type="number" class="form-control form-control-sm"
                                       id="editValorTokens" min="100" max="32000" step="100" />
                                <small class="text-muted" style="font-size:.72rem;">
                                    <i class="fas fa-info-circle mr-1"></i>@Resources.Strings.CfgIA_MaxTokensHint
                                </small>
                            </div>

                            <!-- Genérico: texto libre -->
                            <div id="wrapGenerico" style="display:none;">
                                <input type="text" class="form-control form-control-sm"
                                       id="editValorGenerico" maxlength="500" />
                            </div>

                            <!-- Input oculto que siempre se envía -->
                            <input type="hidden" id="editValor" name="Valor" />
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                            <i class="fas fa-times mr-1"></i>@Resources.Strings.Layout_Cancel
                        </button>
                        <button type="button" class="btn btn-primary btn-sm" onclick="submitGuardar()">
                            <i class="fas fa-save mr-1"></i>@Resources.Strings.CfgIA_BtnGuardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════
         MODAL ELIMINAR
    ══════════════════════════════════════ -->
    <div class="modal fade modal-confirm" id="eliminarModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle"></i> @Resources.Strings.CfgIA_TitleEliminar
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        <i class="fas fa-question-circle text-warning mr-2"></i>
                        @Resources.Strings.CfgIA_ModalDeleteBody
                        <strong id="eliminarClaveNombre"></strong>?
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i>@Resources.Strings.Layout_Cancel
                    </button>
                    <form method="post" action="@Url.Action("Eliminar","ConfiguracionGlobalIA")" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="eliminarClave" name="clave" />
                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="fas fa-trash-alt mr-1"></i>@Resources.Strings.Common_BtnEliminar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <script>Swal.fire({ toast:true, position: window.innerWidth<=768?'top':'top-end', icon:'error',   title:'@Html.Raw(TempData["ErrorMessage"])', showConfirmButton:false, timer:3500, timerProgressBar:true });</script>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <script>Swal.fire({ toast:true, position: window.innerWidth<=768?'top':'top-end', icon:'success', title:'@Html.Raw(TempData["SuccessMessage"])', showConfirmButton:false, timer:3000, timerProgressBar:true });</script>
    }

    @section scripts {
    <script src="~/Assets/js/select2/select2.min.js"></script>
    <script>
    var _cfgMsg = {
        cargando:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_JS_CargandoModelos))',
        cargados:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_JS_CargandoModelos))',
        errorModelos:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_JS_CargandoModelos))',
        apiKeyVacia:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_JS_CargandoModelos))',
        tituloEditar:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_JS_CargandoModelos))',
        tituloCrear:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_JS_CargandoModelos))',
        urlCargar:      '@Url.Action("ObtenerModelosOpenAI","ConfiguracionGlobalIA")'
    };

    // ── clave activa en el modal ──
    var _claveActiva = '';
    var _modoCrear   = false;

    function abrirEditar(clave, valor, desc) {
        _claveActiva = clave;
        _modoCrear   = false;
        document.getElementById('editarModalTitleText').textContent = _cfgMsg.tituloEditar;
        document.getElementById('editClave').value       = clave;
        document.getElementById('editClave').readOnly    = true;
        document.getElementById('editDescripcion').value = desc;
        document.getElementById('claveReadonlyNote').style.display = 'block';
        configurarWrap(clave, valor);
        $('#editarModal').modal('show');
    }

    function abrirNuevo() {
        _claveActiva = '';
        _modoCrear   = true;
        document.getElementById('editarModalTitleText').textContent = _cfgMsg.tituloCrear;
        document.getElementById('editClave').value       = '';
        document.getElementById('editClave').readOnly    = false;
        document.getElementById('editDescripcion').value = '';
        document.getElementById('claveReadonlyNote').style.display = 'none';
        configurarWrap('', '');
        $('#editarModal').modal('show');
    }

    function abrirEliminar(clave) {
        document.getElementById('eliminarClave').value         = clave;
        document.getElementById('eliminarClaveNombre').textContent = '"' + clave + '"';
        $('#eliminarModal').modal('show');
    }

    // ── selecciona el control correcto según la clave ──
    function configurarWrap(clave, valor) {
        ['wrapApiKey','wrapModelo','wrapTokens','wrapGenerico'].forEach(function(id) {
            document.getElementById(id).style.display = 'none';
        });
        document.getElementById('modelosBadge').style.display = 'none';

        if (clave === 'OpenAIApiKey') {
            document.getElementById('wrapApiKey').style.display = '';
            document.getElementById('editValorApiKey').value = valor;
        } else if (clave === 'OpenAIModel') {
            document.getElementById('wrapModelo').style.display = '';
            document.getElementById('editValorModelo').value = valor;
        } else if (clave === 'OpenAIMaxTokens') {
            document.getElementById('wrapTokens').style.display = '';
            document.getElementById('editValorTokens').value = valor;
        } else {
            document.getElementById('wrapGenerico').style.display = '';
            document.getElementById('editValorGenerico').value = valor;
        }
    }

    // ── toggle show/hide API Key ──
    function toggleApiKey() {
        var inp = document.getElementById('editValorApiKey');
        var ico = document.getElementById('eyeIcon');
        if (inp.type === 'password') {
            inp.type = 'text';
            ico.className = 'fas fa-eye-slash';
        } else {
            inp.type = 'password';
            ico.className = 'fas fa-eye';
        }
    }

    // ── revelar la API Key actual (llamada auditada al servidor) ──
    function revelarApiKey() {
        var token = $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url: '@Url.Action("Revelar", "ConfiguracionGlobalIA")',
            type: 'POST',
            data: { clave: 'OpenAIApiKey', __RequestVerificationToken: token },
            success: function (r) {
                if (r && r.ok) {
                    var inp = document.getElementById('editValorApiKey');
                    inp.value = r.valor || '';
                    inp.type  = 'text';
                    document.getElementById('eyeIcon').className = 'fas fa-eye-slash';
                } else {
                    Swal.fire({ icon:'error', title:'Error', text:(r && r.mensaje) || 'No se pudo revelar la clave.',
                        toast:true, position:'top-end', showConfirmButton:false, timer:3500 });
                }
            },
            error: function () {
                Swal.fire({ icon:'error', title:'Error', text:'No se pudo revelar la clave.',
                    toast:true, position:'top-end', showConfirmButton:false, timer:3500 });
            }
        });
    }

    // ── recopila el valor del control activo y envía el form ──
    function submitGuardar() {
        var clave = document.getElementById('editClave').value.trim();
        if (!clave) {
            Swal.fire({ icon:'warning', title:'Clave requerida', text:'El campo Clave es requerido.', toast:true, position:'top-end', showConfirmButton:false, timer:2500 });
            return;
        }

        var valor = '';
        if (clave === 'OpenAIApiKey') {
            valor = document.getElementById('editValorApiKey').value.trim();
        } else if (clave === 'OpenAIModel') {
            valor = document.getElementById('editValorModelo').value.trim();
        } else if (clave === 'OpenAIMaxTokens') {
            valor = document.getElementById('editValorTokens').value.trim();
        } else {
            valor = document.getElementById('editValorGenerico').value.trim();
        }

        // Para la API key, vacío es válido: significa "no cambiar" (el servidor conserva la actual).
        if (!valor && clave !== 'OpenAIApiKey') {
            Swal.fire({ icon:'warning', title:'Valor requerido', text:'El campo Valor es requerido.', toast:true, position:'top-end', showConfirmButton:false, timer:2500 });
            return;
        }

        document.getElementById('editValor').value = valor;

        // Re-habilitar clave para que la envíe el form
        var claveInput = document.getElementById('editClave');
        claveInput.readOnly = false;
        claveInput.closest('form').submit();
    }

    // ── lista global de modelos cargados ──
    var _modelos = [];

    // ── renderiza la lista filtrada en el panel ──
    function renderModelosLista(items, q) {
        var lista = document.getElementById('modelosLista');
        var valorActual = document.getElementById('editValorModelo').value;
        if (!items.length) {
            lista.innerHTML = '<div class="modelo-item-empty">Sin resultados</div>';
            return;
        }
        var re = q ? new RegExp('(' + q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi') : null;
        lista.innerHTML = items.map(function(m) {
            var label = re ? m.replace(re, '<strong>$1</strong>') : m;
            var cls   = (m === valorActual) ? 'modelo-item activo' : 'modelo-item';
            return '<div class="' + cls + '" data-val="' + m.replace(/"/g, '&quot;') + '">' + label + '</div>';
        }).join('');

        lista.querySelectorAll('.modelo-item').forEach(function(el) {
            el.addEventListener('mousedown', function(e) {
                e.preventDefault();
                seleccionarModelo(this.getAttribute('data-val'));
            });
        });

        // scroll al activo
        var activo = lista.querySelector('.activo');
        if (activo) activo.scrollIntoView({ block: 'nearest' });
    }

    // ── filtrar desde el input del buscador interno ──
    function filtrarModelosPanel(q) {
        var items = q ? _modelos.filter(function(m){ return m.toLowerCase().indexOf(q.toLowerCase()) >= 0; }) : _modelos;
        renderModelosLista(items, q);
    }

    // ── filtrar mientras escribe en el input principal ──
    function filtrarModelosDesdeInput(q) {
        if (!_modelos.length) return;
        document.getElementById('modelosBuscar').value = q;
        filtrarModelosPanel(q);
        mostrarDropdownModelos();
    }

    // ── seleccionar un modelo ──
    function seleccionarModelo(val) {
        document.getElementById('editValorModelo').value = val;
        ocultarDropdownModelos();
    }

    // ── mostrar panel dropdown ──
    function mostrarDropdownModelos() {
        if (!_modelos.length) return;
        var dd = document.getElementById('modelosDropdown');
        dd.style.display = '';
        document.getElementById('modeloChevron').className = 'fas fa-chevron-up';
        var q = document.getElementById('modelosBuscar').value;
        filtrarModelosPanel(q);
    }

    // ── ocultar panel dropdown ──
    function ocultarDropdownModelos() {
        document.getElementById('modelosDropdown').style.display = 'none';
        document.getElementById('modeloChevron').className = 'fas fa-chevron-down';
    }

    // ── alternar dropdown ──
    function toggleDropdownModelos() {
        var dd = document.getElementById('modelosDropdown');
        if (dd.style.display === 'none') mostrarDropdownModelos();
        else ocultarDropdownModelos();
    }

    // ── cerrar al hacer clic fuera ──
    document.addEventListener('mousedown', function(e) {
        var wrap = document.getElementById('modeloSelectWrap');
        if (wrap && !wrap.contains(e.target)) ocultarDropdownModelos();
    });

    // ── cargar modelos desde OpenAI ──
    function cargarModelosOpenAI() {
        var btn  = document.getElementById('btnCargarModelos');
        var span = document.getElementById('btnCargarModelosText');
        btn.disabled  = true;
        span.textContent = _cfgMsg.cargando;

        $.ajax({
            url:  _cfgMsg.urlCargar,
            type: 'GET',
            success: function (resp) {
                btn.disabled = false;
                span.textContent = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_JS_CargandoModelos))';

                if (!resp.ok) {
                    Swal.fire({ icon:'error', title:'Error', text: resp.mensaje || _cfgMsg.errorModelos,
                        toast:true, position:'top-end', showConfirmButton:false, timer:4000 });
                    return;
                }

                _modelos = resp.modelos || [];

                // Badge
                document.getElementById('modelosCount').textContent = _modelos.length;
                document.getElementById('modelosBadge').style.display = 'inline-flex';

                // Si el campo está vacío, preseleccionar el primero
                var inp = document.getElementById('editValorModelo');
                if (!inp.value && _modelos.length > 0) inp.value = _modelos[0];

                // Limpiar buscador y mostrar lista
                document.getElementById('modelosBuscar').value = '';
                renderModelosLista(_modelos, '');
                mostrarDropdownModelos();
            },
            error: function () {
                btn.disabled = false;
                span.textContent = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_JS_CargandoModelos))';
                Swal.fire({ icon:'error', title:'Error', text: _cfgMsg.errorModelos,
                    toast:true, position:'top-end', showConfirmButton:false, timer:4000 });
            }
        });
    }

    // ── limpiar dropdown al cerrar modal ──
    $('#editarModal').on('hidden.bs.modal', function() {
        ocultarDropdownModelos();
        _modelos = [];
        document.getElementById('modelosBadge').style.display = 'none';
        document.getElementById('modelosLista').innerHTML = '';
        document.getElementById('modelosBuscar').value = '';
    });

    // Al cambiar la clave manualmente (modo crear), actualizar los wraps
    document.getElementById('editClave').addEventListener('input', function() {
        if (_modoCrear) configurarWrap(this.value.trim(), '');
    });

    // ══════════════════════════════════════
    // TAB: POR EMPRESA
    // ══════════════════════════════════════
    var _empIAMsg = {
        ilimitado:        '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Emp_Ilimitado))',
        tokensUsados:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Emp_TokensUsados))',
        tokensUsadosIlim: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Emp_TokensUsadosIlimitado))',
        presupuestoPlaceholder: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Emp_PresupuestoPlaceholder))',
        sinUsuarios:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Emp_SinUsuarios))',
        accesoPermitido:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Emp_AccesoPermitido))',
        accesoBloqueado:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Emp_AccesoBloqueado))',
        guardadoOk:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Emp_MsgGuardadoOk))',
        errorGuardar:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Emp_MsgErrorGuardar))',
        errorCargar:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Emp_MsgErrorCargar))',
        urlResumen:       '@Url.Action("ObtenerResumenEmpresaIA", "ConfiguracionGlobalIA")',
        urlGuardarPresupuesto: '@Url.Action("GuardarPresupuestoEmpresaIA", "ConfiguracionGlobalIA")',
        urlGuardarAcceso: '@Url.Action("GuardarAccesoUsuarioIA", "ConfiguracionGlobalIA")'
    };
    var _empIAActual = null;

    // ── Segmented tabs General / Por Empresa, con "thumb" deslizante (mismo patrón que AuditoriaHub) ──
    (function () {
        var $seg   = $('#cfgiaTabs');
        var $tabs  = $seg.find('.cfgia-seg-btn');
        var $thumb = $seg.find('.cfgia-seg-thumb');

        function moverThumb(btn, sinAnim) {
            if (!btn) return;
            var cont = $seg[0];
            var cr = cont.getBoundingClientRect();
            var br = btn.getBoundingClientRect();
            var x = br.left - cr.left - cont.clientLeft;
            var y = br.top - cr.top - cont.clientTop;
            if (sinAnim) $thumb.addClass('no-anim');
            $thumb.css({ width: br.width + 'px', height: br.height + 'px', transform: 'translate(' + x + 'px,' + y + 'px)' });
            if (sinAnim) { void $thumb[0].offsetWidth; $thumb.removeClass('no-anim'); }
        }

        function activar($btn) {
            var tab = $btn.data('tab');
            $tabs.removeClass('is-active');
            $btn.addClass('is-active');
            moverThumb($btn[0]);
            document.getElementById('panelGeneral').style.display = (tab === 'general') ? '' : 'none';
            document.getElementById('panelPorEmpresa').style.display = (tab === 'empresa') ? '' : 'none';
        }

        $tabs.on('click', function () { activar($(this)); });
        $(window).on('resize', function () {
            var a = $tabs.filter('.is-active')[0];
            if (a) moverThumb(a, true);
        });

        moverThumb($tabs.filter('.is-active')[0], true);
    })();

    $('#selEmpresaIA').select2({ width: '100%', allowClear: false });
    $('#selEmpresaIA').on('change', function () {
        var idEmpresa = $(this).val();
        if (!idEmpresa) {
            document.getElementById('empresaIAVacio').style.display = '';
            document.getElementById('empresaIAContenido').style.display = 'none';
            return;
        }
        cargarResumenEmpresaIA(idEmpresa);
    });

    function cargarResumenEmpresaIA(idEmpresa) {
        document.getElementById('empresaIAVacio').style.display = 'none';
        document.getElementById('empresaIAContenido').style.display = 'none';
        document.getElementById('empresaIACargando').style.display = '';

        $.ajax({
            url: _empIAMsg.urlResumen,
            type: 'GET',
            data: { idEmpresa: idEmpresa },
            success: function (r) {
                document.getElementById('empresaIACargando').style.display = 'none';
                if (!r || !r.ok) {
                    Swal.fire({ icon:'error', title:'Error', text:(r && r.mensaje) || _empIAMsg.errorCargar,
                        toast:true, position:'top-end', showConfirmButton:false, timer:3500 });
                    return;
                }
                _empIAActual = r.resumen;
                pintarResumenEmpresaIA(r.resumen);
                document.getElementById('empresaIAContenido').style.display = '';
            },
            error: function () {
                document.getElementById('empresaIACargando').style.display = 'none';
                Swal.fire({ icon:'error', title:'Error', text: _empIAMsg.errorCargar,
                    toast:true, position:'top-end', showConfirmButton:false, timer:3500 });
            }
        });
    }

    function pintarResumenEmpresaIA(resumen) {
        var textoConsumo = resumen.Ilimitado
            ? _empIAMsg.tokensUsadosIlim.replace('{0}', resumen.ConsumidoMes.toLocaleString())
            : _empIAMsg.tokensUsados
                .replace('{0}', resumen.ConsumidoMes.toLocaleString())
                .replace('{1}', resumen.PresupuestoEfectivo.toLocaleString())
                .replace('{2}', resumen.PorcentajeConsumido);
        document.getElementById('empConsumoTexto').textContent = textoConsumo;

        var barra = document.getElementById('empConsumoBarra');
        barra.style.width = resumen.Ilimitado ? '0%' : Math.min(100, resumen.PorcentajeConsumido) + '%';
        barra.classList.toggle('agotado', !resumen.Ilimitado && resumen.PorcentajeConsumido >= 100);

        var inputPresupuesto = document.getElementById('empPresupuestoInput');
        inputPresupuesto.value = (resumen.PresupuestoOverride === null || resumen.PresupuestoOverride === undefined)
            ? '' : resumen.PresupuestoOverride;
        inputPresupuesto.placeholder = _empIAMsg.presupuestoPlaceholder
            .replace('{0}', resumen.PresupuestoGlobalDefault > 0
                ? resumen.PresupuestoGlobalDefault.toLocaleString()
                : _empIAMsg.ilimitado);

        var tbody = document.getElementById('empUsuariosBody');
        tbody.innerHTML = '';
        if (!resumen.Usuarios || resumen.Usuarios.length === 0) {
            tbody.innerHTML = '<tr><td colspan="2" class="text-muted text-center">' + _empIAMsg.sinUsuarios + '</td></tr>';
            return;
        }
        resumen.Usuarios.forEach(function (u) {
            var tr = document.createElement('tr');
            tr.innerHTML =
                '<td>' + u.NombreCompleto + '<br><small class="text-muted">' + u.Correo + '</small></td>' +
                '<td><button type="button" class="btn btn-sm cfg-ia-emp-acceso-btn ' +
                    (u.AccesoEfectivo ? 'btn-success' : 'btn-danger') + '" data-id="' + u.Id + '" data-acceso="' + (u.AccesoEfectivo ? '1' : '0') + '">' +
                    '<i class="fas ' + (u.AccesoEfectivo ? 'fa-check-circle' : 'fa-ban') + ' mr-1"></i>' +
                    (u.AccesoEfectivo ? _empIAMsg.accesoPermitido : _empIAMsg.accesoBloqueado) +
                '</button></td>';
            tbody.appendChild(tr);
        });

        $(tbody).off('click', 'button').on('click', 'button', function () {
            var btn = $(this);
            var idUsuario = btn.data('id');
            var nuevoAcceso = btn.data('acceso') == '1' ? false : true;
            guardarAccesoUsuarioIA(idUsuario, nuevoAcceso, btn);
        });
    }

    function guardarPresupuestoEmpresaIA() {
        if (!_empIAActual) return;
        var valor = document.getElementById('empPresupuestoInput').value.trim();
        var token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url: _empIAMsg.urlGuardarPresupuesto,
            type: 'POST',
            data: { idEmpresa: _empIAActual.IdEmpresa, presupuesto: valor, __RequestVerificationToken: token },
            success: function (r) {
                Swal.fire({ toast:true, position:'top-end', icon: (r && r.ok) ? 'success' : 'error',
                    title: (r && r.mensaje) || _empIAMsg.errorGuardar, showConfirmButton:false, timer:3000 });
                if (r && r.ok) cargarResumenEmpresaIA(_empIAActual.IdEmpresa);
            },
            error: function () {
                Swal.fire({ toast:true, position:'top-end', icon:'error', title:_empIAMsg.errorGuardar, showConfirmButton:false, timer:3000 });
            }
        });
    }

    function guardarAccesoUsuarioIA(idUsuario, nuevoAcceso, btn) {
        var token = $('input[name="__RequestVerificationToken"]').val();
        btn.prop('disabled', true);

        $.ajax({
            url: _empIAMsg.urlGuardarAcceso,
            type: 'POST',
            data: { idUsuario: idUsuario, acceso: nuevoAcceso, __RequestVerificationToken: token },
            success: function (r) {
                btn.prop('disabled', false);
                if (r && r.ok) {
                    btn.data('acceso', nuevoAcceso ? '1' : '0');
                    btn.removeClass('btn-success btn-danger').addClass(nuevoAcceso ? 'btn-success' : 'btn-danger');
                    btn.html('<i class="fas ' + (nuevoAcceso ? 'fa-check-circle' : 'fa-ban') + ' mr-1"></i>' +
                        (nuevoAcceso ? _empIAMsg.accesoPermitido : _empIAMsg.accesoBloqueado));
                } else {
                    Swal.fire({ toast:true, position:'top-end', icon:'error', title:(r && r.mensaje) || _empIAMsg.errorGuardar, showConfirmButton:false, timer:3000 });
                }
            },
            error: function () {
                btn.prop('disabled', false);
                Swal.fire({ toast:true, position:'top-end', icon:'error', title:_empIAMsg.errorGuardar, showConfirmButton:false, timer:3000 });
            }
        });
    }
    </script>
    }

</body>
</html>
