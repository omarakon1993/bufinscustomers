    });

    function guardarConfigEmpresaIA() {
        if (!_empIAActual) return;
        var token = $('input[name="__RequestVerificationToken"]').val();
        var funciones = $('.emp-func:checked').map(function () { return this.value; }).get().join(',');
        $('#btnGuardarControl').prop('disabled', true);

        $.ajax({
            url: _empIAMsg.urlGuardarConfig,
            type: 'POST',
            data: {
                idEmpresa: _empIAActual.IdEmpresa,
                presupuesto: document.getElementById('empPresupuestoInput').value.trim(),
                iaHabilitada: document.getElementById('empHabilitada').checked,
                politica: document.getElementById('empPolitica').value,
                poolGrupo: document.getElementById('empPool').checked,
                diaCorte: document.getElementById('empDiaCorte').value.trim(),
                modeloPermitido: document.getElementById('empModelo').value.trim(),
                funciones: funciones,
                topeDiarioUsuario: document.getElementById('empTopeUsuario').value.trim(),
                contextoNegocio: document.getElementById('empContexto').value,
                __RequestVerificationToken: token
            },
            success: function (r) {
                Swal.fire({ toast:true, position:'top-end', icon: (r && r.ok) ? 'success' : 'error',
                    title: (r && r.mensaje) || _empIAMsg.errorGuardar, showConfirmButton:false, timer:3000 });
                if (r && r.ok) cargarResumenEmpresaIA(_empIAActual.IdEmpresa); else marcarSucio();
            },
            error: function () {
                marcarSucio();
                Swal.fire({ toast:true, position:'top-end', icon:'error', title:_empIAMsg.errorGuardar, showConfirmButton:false, timer:3000 });
            }
        });
    }


    // Contexto de la empresa: inserta una plantilla guiada (a qué se dedica, productos, país, etc.)
    $('#btnContextoPlantilla').on('click', function () {
        var $t = $('#empContexto');
        var plantilla = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Emp_ContextoPlantillaTexto))';
        $t.val($.trim($t.val()) ? ($t.val() + '\n\n' + plantilla) : plantilla).trigger('input').focus();
    });

    // ══════════════════════════════════════
    // TAB: GENERAL — búsqueda y acciones por fila
    // ══════════════════════════════════════
    $('#cfggBuscar').on('input', function () {
        var q = $.trim($(this).val()).toLowerCase();
        $('.cfgg-row').each(function () {
            $(this).toggle(!q || String($(this).data('buscar')).indexOf(q) >= 0);
        });
        $('.cfgg-group').each(function () {
            var visibles = $(this).find('.cfgg-row:visible').length;
            $(this).toggle(visibles > 0);
            $(this).find('.cfgg-count').text(visibles);
        });
        $('#cfggVacio').toggle($('.cfgg-group:visible').length === 0);
    });
    $(document).on('click', '.cfgg-editar', function () {
        var $b = $(this);
        abrirEditar(String($b.data('clave')), String($b.attr('data-valor') || ''), String($b.attr('data-desc') || ''));
    });
    $(document).on('click', '.cfgg-eliminar', function () { abrirEliminar(String($(this).data('clave'))); });

    // ══════════════════════════════════════
    // TAB: USO Y COSTOS
    // ══════════════════════════════════════
    var _usoMsg = {
        url: '@Url.Action("ObtenerObservabilidadIA", "ConfiguracionGlobalIA")',
        error: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Uso_Error))',
        sinDatos: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IAConsumo_SinDatos))',
        kConsultas: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Uso_KConsultas))',
        kExito: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Uso_KExito))',
        kTokens: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Uso_KTokens))',
        kCosto: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Uso_KCosto))',
        kCache: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Uso_KCache))',
        kCachePrompt: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Uso_KCachePrompt))',
        kLatencia: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Uso_KLatencia))',
        colConsultas: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IAUso_ColConsultas))',
        colTokens: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IAUso_ColTokens))'
    };

    function usoEsc(s) { return $('<div>').text(s == null ? '' : s).html(); }
    function usoNum(n) { return Number(n || 0).toLocaleString(); }
    function usoUsd(n) { return Number(n || 0).toFixed(2); }
    function usoIso(d) { return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2); }

    function usoRank(lista) {
        if (!lista || !lista.length) return '<div class="cfgu-vacio">' + usoEsc(_usoMsg.sinDatos) + '</div>';
        var max = Math.max.apply(null, [1].concat(lista.map(function (g) { return g.Tokens; })));
        return lista.map(function (g) {
            return '<div class="cfgu-row"><div class="n" title="' + usoEsc(g.Clave) + '">' + usoEsc(g.Clave) + '</div>' +
                   '<div class="v">' + usoNum(g.Tokens) + ' · US$ ' + usoUsd(g.Costo) + (g.Errores ? '<span class="e" title="Errores">' + g.Errores + '</span>' : '') + '</div>' +
                   '<div class="bar"><i style="width:' + Math.max(2, Math.round(g.Tokens * 100 / max)) + '%"></i></div></div>';
        }).join('');
    }

    function usoKpi(icono, titulo, valor) {
        return '<div class="cfgu-kpi"><span class="ic"><i class="fas ' + icono + '"></i></span><div><div class="v">' + valor + '</div><div class="l">' + usoEsc(titulo) + '</div></div></div>';
    }

    // Gráfico de barras por día: se completan los días sin consumo para que el eje de tiempo sea continuo.
    function usoGrafico(porDia, desde, hasta, totalTokens) {
        var mapa = {};
        (porDia || []).forEach(function (d) { mapa[d.Dia] = d; });
        var dias = [], d0 = new Date(desde + 'T00:00:00'), d1 = new Date(hasta + 'T00:00:00');
        for (var d = new Date(d0); d <= d1 && dias.length < 400; d.setDate(d.getDate() + 1)) dias.push(usoIso(d));
        var max = Math.max.apply(null, [1].concat((porDia || []).map(function (x) { return x.Tokens; })));
        $('#usoChart').html(dias.map(function (iso) {
            var x = mapa[iso];
            if (!x) return '<div class="cfgu-bar vacia" title="' + iso + '"></div>';
            return '<div class="cfgu-bar" style="height:' + Math.max(4, Math.round(x.Tokens * 100 / max)) + '%" title="' + iso + ' · ' +
                   usoEsc(_usoMsg.colConsultas) + ': ' + usoNum(x.Consultas) + ' · ' + usoEsc(_usoMsg.colTokens) + ': ' + usoNum(x.Tokens) + ' · US$ ' + usoUsd(x.Costo) + '"></div>';
        }).join(''));
        $('#usoChartEje').html('<span>' + usoEsc(dias[0] || '') + '</span><span>' + usoEsc(dias[dias.length - 1] || '') + '</span>');
        $('#usoChartTotal').text(usoNum(totalTokens) + ' ' + _usoMsg.colTokens.toLowerCase());
    }

    function usoSeleccionarRango(valor) {
        var hoy = new Date(), desde = new Date();
        if (valor === 'mes') desde = new Date(hoy.getFullYear(), hoy.getMonth(), 1);
        else desde.setDate(hoy.getDate() - (parseInt(valor, 10) - 1));
        $('#usoDesde').val(usoIso(desde));
        $('#usoHasta').val(usoIso(hoy));
        $('#usoRangos button').removeClass('active').filter('[data-dias="' + valor + '"]').addClass('active');
    }
    $('#usoRangos').on('click', 'button', function () {
        usoSeleccionarRango(String($(this).data('dias')));
        cargarUsoIA();
    });
    $('#usoDesde, #usoHasta').on('change', function () { $('#usoRangos button').removeClass('active'); });

    function cargarUsoIA() {
        $.get(_usoMsg.url, { desde: $('#usoDesde').val(), hasta: $('#usoHasta').val() }).done(function (r) {
            if (!r || !r.ok) {
                Swal.fire({ icon:'error', title:'Error', text:(r && r.mensaje) || _usoMsg.error, toast:true, position:'top-end', showConfirmButton:false, timer:3500 });
                return;
            }
            if (!$('#usoDesde').val()) { $('#usoDesde').val(r.desde); $('#usoHasta').val(r.hasta); }
            $('#usoNoDisponible').toggle(!r.Disponible);
            $('#usoContenido').toggle(!!r.Disponible);
            if (!r.Disponible) return;

            var t = r.Totales, n = t.Consultas || 0;
            var exito = n ? Math.round(t.Exitosas * 100 / n) : 0;
            var cache = t.Exitosas ? Math.round(t.DesdeCache * 100 / t.Exitosas) : 0;
            var cachePrompt = t.TokensEntrada ? Math.round(t.TokensCacheados * 100 / t.TokensEntrada) + '%' : '—';
            var lat = (t.LatenciaP50 == null) ? '—' : (Math.round(t.LatenciaP50) + ' / ' + Math.round(t.LatenciaP95) + ' ms');
            $('#usoKpis').html(
                usoKpi('fa-comments', _usoMsg.kConsultas, usoNum(n)) + usoKpi('fa-check-circle', _usoMsg.kExito, exito + '%') +
                usoKpi('fa-coins', _usoMsg.kTokens, usoNum(t.Tokens)) + usoKpi('fa-dollar-sign', _usoMsg.kCosto, 'US$ ' + usoUsd(t.Costo)) +
                usoKpi('fa-bolt', _usoMsg.kCache, cache + '%') + usoKpi('fa-layer-group', _usoMsg.kCachePrompt, cachePrompt) + usoKpi('fa-stopwatch', _usoMsg.kLatencia, lat));

            usoGrafico(r.PorDia, r.desde, r.hasta, t.Tokens);
            $('#usoRankFunc').html(usoRank(r.PorFuncion));
            $('#usoRankModelo').html(usoRank(r.PorModelo));
            $('#usoRankEmpresa').html(usoRank(r.PorEmpresa));

            var errores = r.Errores || [];
            $('#usoErroresCuenta').text(errores.length);
            $('#usoErrores').html(errores.length ? errores.map(function (e) {
                return '<tr><td style="white-space:nowrap;">' + usoEsc(e.Fecha) + '</td><td>' + usoEsc(e.Empresa) + '</td><td>' + usoEsc(e.Funcion) + '</td><td>' + usoEsc(e.Detalle) + '</td></tr>';
            }).join('') : '<tr><td colspan="4" class="text-center text-muted">' + usoEsc(_usoMsg.sinDatos) + '</td></tr>');
        }).fail(function () {
            Swal.fire({ icon:'error', title:'Error', text:_usoMsg.error, toast:true, position:'top-end', showConfirmButton:false, timer:3500 });
        });
    }
    $('#btnUsoConsultar').on('click', cargarUsoIA);

    // Limpiar estadísticas (solo Super Admin: el controlador completo lo exige). No toca presupuesto ni auditoría.
    $('#btnUsoLimpiar').on('click', function () {
        Swal.fire({
            icon: 'warning',
            title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Uso_LimpiarTitulo))',
            text: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Uso_LimpiarTexto))',
            showCancelButton: true,
            confirmButtonText: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.CfgIA_Uso_LimpiarConfirmar))',
            cancelButtonText: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Layout_Cancel))',
            reverseButtons: true, focusCancel: true
        }).then(function (res) {
            if (!res.isConfirmed) return;
            $.post('@Url.Action("LimpiarUsoIA", "ConfiguracionGlobalIA")',
                { __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val() },
                function (r) {
                    Swal.fire({ toast: true, position: 'top-end', icon: (r && r.ok) ? 'success' : 'error',
                        title: (r && r.mensaje) || _usoMsg.error, showConfirmButton: false, timer: 3500 });
                    if (r && r.ok) cargarUsoIA();
                }).fail(function () {
                    Swal.fire({ toast: true, position: 'top-end', icon: 'error', title: _usoMsg.error, showConfirmButton: false, timer: 3500 });
                });
        });
    });

    function guardarAccesoUsuarioIA(idUsuario, nuevoAcceso, $chk) {
        var token = $('input[name="__RequestVerificationToken"]').val();
        $chk.prop('disabled', true);

        function revertir() { $chk.prop('checked', !nuevoAcceso); }

        $.ajax({
            url: _empIAMsg.urlGuardarAcceso,
            type: 'POST',
            data: { idUsuario: idUsuario, acceso: nuevoAcceso, __RequestVerificationToken: token },
            success: function (r) {
                $chk.prop('disabled', false);
                if (r && r.ok) {
                    $chk.closest('.cfge-user').toggleClass('off', !nuevoAcceso);
                    actualizarCuentaUsuarios();
                } else {
                    revertir();
                    Swal.fire({ toast:true, position:'top-end', icon:'error', title:(r && r.mensaje) || _empIAMsg.errorGuardar, showConfirmButton:false, timer:3000 });
                }
            },
            error: function () {
                $chk.prop('disabled', false);
                revertir();
                Swal.fire({ toast:true, position:'top-end', icon:'error', title:_empIAMsg.errorGuardar, showConfirmButton:false, timer:3000 });
            }
        });
    }
    </script>
    }

</body>
</html>
