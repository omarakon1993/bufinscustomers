@model IEnumerable<bufinscustomers.Models.PromptIA>
@using bufinscustomers.Helpers

<!DOCTYPE html>
<html>
<head>
    <title>@Resources.Strings.Prompt_PageTitle</title>
    <script src="~/Assets/js/sweetalert2.all.min.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="~/Assets/css/configuracion-admin.css" rel="stylesheet" />
</head>
<body>

    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas fa-robot powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@Resources.Strings.Prompt_PageTitle</h1>
        </div>
    </div>

    <div class="card shadow mb-4 mt-4">
        <div class="card-body p-0">
            <div class="table-responsive table-wrapper">
                <table class="table table-bordered table-hover table-compact">
                    <thead>
                        <tr>
                            <th class="col-id">Id</th>
                            <th class="col-codigo">@Resources.Strings.Prompt_ThCodigo</th>
                            <th class="col-nombre">@Resources.Strings.Emp_LabelNombre</th>
                            <th class="col-desc">@Resources.Strings.Common_LabelDescripcion</th>
                            <th class="col-estado">@Resources.Strings.Common_Estado</th>
                            <th class="col-acciones">@Resources.Strings.Common_ThAcciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-3">
                                    @Resources.Strings.Prompt_NoPrompts
                                </td>
                            </tr>
                        }
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="col-id">@p.Id</td>
                                <td class="col-codigo" title="@p.Codigo">
                                    <span class="codigo-tag">@p.Codigo</span>
                                </td>
                                <td class="col-nombre" title="@p.Nombre"><strong>@p.Nombre</strong></td>
                                <td class="col-desc" title="@p.Descripcion">@(string.IsNullOrEmpty(p.Descripcion) ? "—" : p.Descripcion)</td>
                                <td class="col-estado">
                                    @if (p.Activo)
                                    {
                                        <span class="badge-activo">@Resources.Strings.Common_Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge-inactivo">@Resources.Strings.Common_Inactivo</span>
                                    }
                                </td>
                                <td class="col-acciones">
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-primary btn-sm" title="@Resources.Strings.Prompt_TitleVer"
                                                data-toggle="modal" data-target="#verTextoModal"
                                                data-nombre="@Html.AttributeEncode(p.Nombre)"
                                                data-texto="@Html.AttributeEncode(p.TextoPrompt ?? string.Empty)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-primary btn-sm btn-editar-prompt" title="@Resources.Strings.Prompt_TitleEditar"
                                                data-toggle="modal" data-target="#editarModal"
                                                data-id="@p.Id"
                                                data-codigo="@Html.AttributeEncode(p.Codigo)"
                                                data-nombre="@Html.AttributeEncode(p.Nombre)"
                                                data-desc="@Html.AttributeEncode(p.Descripcion ?? string.Empty)"
                                                data-texto="@Html.AttributeEncode(p.TextoPrompt ?? string.Empty)"
                                                data-activo="@(p.Activo ? "true" : "false")">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button type="button" class="btn btn-danger btn-sm btn-eliminar-prompt" title="@Resources.Strings.Prompt_TitleEliminar"
                                                data-toggle="modal" data-target="#eliminarModal"
                                                data-id="@p.Id"
                                                data-nombre="@Html.AttributeEncode(p.Nombre)">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer">
            <button type="button" class="btn-modern-success" data-toggle="modal" data-target="#crearModal">
                <i class="fas fa-plus-circle mr-1"></i> @Resources.Strings.Prompt_BtnCrear
            </button>
        </div>
    </div>

    <!-- ═══════════════════ MODAL VER TEXTO ═══════════════════ -->
    <div class="modal fade" id="verTextoModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-file-alt" style="color:#583AFF;"></i> <span id="verTextoNombre"></span>
                    </h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <pre id="verTextoContenido" style="white-space: pre-wrap; font-size: 0.85rem; background: #f8f9fa; padding: 1rem; border-radius: 6px; border: 1px solid #dee2e6; max-height: 400px; overflow-y: auto;"></pre>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i>@Resources.Strings.Layout_Close
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════ MODAL CREAR ═══════════════════ -->
    <div class="modal fade" id="crearModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-plus-circle" style="color:#583AFF;"></i> @Resources.Strings.Prompt_ModalCreateTitle
                    </h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <form method="post" action="@Url.Action("Crear", "GestorPrompts")">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-5 mb-3 mt-2">
                                <label for="crearCodigo" class="form-label">
                                    <i class="fas fa-code mr-2" style="color:#583AFF;"></i>@Resources.Strings.Prompt_LabelCodigo <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control form-control-sm" id="crearCodigo" name="Codigo"
                                       placeholder="Ej: RESUMEN_GERENCIAL" maxlength="50" required
                                       style="font-family: monospace; text-transform: uppercase;" />
                            </div>
                            <div class="col-md-7 mb-3 mt-2">
                                <label for="crearNombre" class="form-label">
                                    <i class="fas fa-tag mr-2" style="color:#583AFF;"></i>@Resources.Strings.Emp_LabelNombre <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control form-control-sm" id="crearNombre" name="Nombre"
                                       placeholder="Ej: Resumen Gerencial Ejecutivo" maxlength="100" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="crearDescripcion" class="form-label">
                                <i class="fas fa-align-left mr-2" style="color:#583AFF;"></i>@Resources.Strings.Common_LabelDescripcion
                            </label>
                            <input type="text" class="form-control form-control-sm" id="crearDescripcion" name="Descripcion"
                                   placeholder="Ej: Instrucciones para el análisis automático" maxlength="255" />
                        </div>
                        <div class="mb-3">
                            <label for="crearTextoPrompt" class="form-label">
                                <i class="fas fa-robot mr-2" style="color:#583AFF;"></i>@Resources.Strings.Prompt_LabelTextoPrompt <span class="text-danger">*</span>
                                <small class="text-muted">@Resources.Strings.Prompt_LabelTextoHint</small>
                            </label>
                            <textarea class="form-control textarea-prompt" id="crearTextoPrompt" name="TextoPrompt"
                                      rows="8" placeholder="Ej: Genera un resumen gerencial ejecutivo en 3 a 5 párrafos..." required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                            <i class="fas fa-times mr-1"></i>@Resources.Strings.Layout_Cancel
                        </button>
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fas fa-plus-circle mr-1"></i>@Resources.Strings.Common_BtnCrear
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ═══════════════════ MODAL EDITAR ═══════════════════ -->
    <div class="modal fade" id="editarModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-edit" style="color:#583AFF;"></i> @Resources.Strings.Prompt_ModalEditTitle
                    </h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <form method="post" action="@Url.Action("Editar", "GestorPrompts")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editId" name="Id" />
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-5 mb-3 mt-2">
                                <label for="editCodigo" class="form-label">
                                    <i class="fas fa-code mr-2" style="color:#583AFF;"></i>@Resources.Strings.Prompt_LabelCodigo <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control form-control-sm" id="editCodigo" name="Codigo"
                                       maxlength="50" required style="font-family: monospace; text-transform: uppercase;" />
                            </div>
                            <div class="col-md-7 mb-3 mt-2">
                                <label for="editNombre" class="form-label">
                                    <i class="fas fa-tag mr-2" style="color:#583AFF;"></i>@Resources.Strings.Emp_LabelNombre <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control form-control-sm" id="editNombre" name="Nombre"
                                       maxlength="100" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="editDescripcion" class="form-label">
                                <i class="fas fa-align-left mr-2" style="color:#583AFF;"></i>@Resources.Strings.Common_LabelDescripcion
                            </label>
                            <input type="text" class="form-control form-control-sm" id="editDescripcion" name="Descripcion"
                                   maxlength="255" />
                        </div>
                        <div class="mb-3">
                            <label for="editTextoPrompt" class="form-label">
                                <i class="fas fa-robot mr-2" style="color:#583AFF;"></i>@Resources.Strings.Prompt_LabelTextoPrompt <span class="text-danger">*</span>
                                <small class="text-muted">@Resources.Strings.Prompt_LabelTextoHint</small>
                            </label>
                            <textarea class="form-control textarea-prompt" id="editTextoPrompt" name="TextoPrompt"
                                      rows="8" required></textarea>
                        </div>
                        <div class="mb-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="editActivo" name="Activo" value="true" />
                                <input type="hidden" name="Activo" value="false" />
                                <label class="form-check-label" for="editActivo">@Resources.Strings.Common_Activo</label>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                            <i class="fas fa-times mr-1"></i>@Resources.Strings.Layout_Cancel
                        </button>
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fas fa-save mr-1"></i>@Resources.Strings.Common_GuardarCambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ═══════════════════ MODAL ELIMINAR ═══════════════════ -->
    <div class="modal fade" id="eliminarModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle"></i> @Resources.Strings.Common_ModalDeleteTitle
                    </h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        <i class="fas fa-question-circle text-warning mr-2"></i>
                        @Resources.Strings.Prompt_ModalDeleteBody <strong id="eliminarNombre"></strong>?
                    </p>
                    <p class="text-muted small mt-2 mb-0">@Resources.Strings.Prompt_ModalDeleteNote</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i>@Resources.Strings.Layout_Cancel
                    </button>
                    <form method="post" action="@Url.Action("Eliminar", "GestorPrompts")" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="eliminarId" name="id" />
                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="fas fa-trash-alt mr-1"></i>@Resources.Strings.Common_BtnEliminar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            Swal.fire({ toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end', icon: 'error', title: '@TempData["ErrorMessage"]', showConfirmButton: false, timer: 3000, timerProgressBar: true });
        </script>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            Swal.fire({ toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end', icon: 'success', title: '@TempData["SuccessMessage"]', showConfirmButton: false, timer: 3000, timerProgressBar: true });
        </script>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <script>
            Swal.fire({ toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end', icon: 'info', title: '@TempData["InfoMessage"]', showConfirmButton: false, timer: 3000, timerProgressBar: true });
        </script>
    }

    @section scripts {
    <script>
        $('#verTextoModal').on('show.bs.modal', function (event) {
            var btn = event.relatedTarget;
            document.getElementById('verTextoNombre').textContent    = btn.dataset.nombre;
            document.getElementById('verTextoContenido').textContent = btn.dataset.texto;
        });

        $('#editarModal').on('show.bs.modal', function (event) {
            var btn = event.relatedTarget;
            document.getElementById('editId').value          = btn.dataset.id;
            document.getElementById('editCodigo').value      = btn.dataset.codigo;
            document.getElementById('editNombre').value      = btn.dataset.nombre;
            document.getElementById('editDescripcion').value = btn.dataset.desc || '';
            document.getElementById('editTextoPrompt').value = btn.dataset.texto || '';
            document.getElementById('editActivo').checked    = btn.dataset.activo === 'true';
        });

        $('#eliminarModal').on('show.bs.modal', function (event) {
            var btn = event.relatedTarget;
            document.getElementById('eliminarId').value           = btn.dataset.id;
            document.getElementById('eliminarNombre').textContent = '"' + btn.dataset.nombre + '"';
        });
    </script>
    }
</body>
</html>
