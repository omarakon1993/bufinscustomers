@model IEnumerable<bufinscustomers.Models.PromptIA>
@using bufinscustomers.Helpers

<!DOCTYPE html>
<html>
<head>
    <title>Gestor de Prompts IA</title>
    <script src="~/Assets/js/sweetalert2.all.min.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script src="~/Assets/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Assets/Scripts/bootstrap.bundle.min.js"></script>
</head>
<body>
    <style>
        :root {
            --color-primario: #583AFF;
            --color-secundario: #01E1D7;
        }

        .card-header {
            background: linear-gradient(90deg, var(--color-primario), var(--color-secundario));
            color: white;
            padding: 1rem 1.2rem;
            font-weight: 600;
            font-size: 1.1rem;
        }

        .card-header i { margin-right: 8px; }

        .table-wrapper {
            max-height: 450px;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .table-compact {
            table-layout: fixed;
            width: 100%;
            margin-bottom: 0;
        }

        .table-compact thead th {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            color: #555;
            padding: 0.5rem 0.4rem;
            white-space: nowrap;
            border-bottom: 2px solid #dee2e6;
            background-color: #f8f9fa;
            position: sticky;
            top: 0;
            z-index: 1;
        }

        .table-compact tbody td {
            font-size: 0.8rem;
            padding: 0.35rem 0.4rem;
            vertical-align: middle;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .table-compact tbody tr:hover { background-color: #f0edff; }

        .col-id       { width: 5%;  text-align: center; }
        .col-codigo   { width: 20%; }
        .col-nombre   { width: 18%; }
        .col-desc     { width: 35%; }
        .col-estado   { width: 10%; text-align: center; }
        .col-acciones { width: 12%; text-align: center; white-space: nowrap; }

        .btn-group { gap: 0.25rem; }
        .btn-group .btn { padding: 0.2rem 0.45rem; font-size: 0.75rem; border-radius: 0.25rem; }
        .btn-group .btn i { margin-right: 0; }

        .codigo-tag {
            font-family: 'Courier New', monospace;
            font-size: 0.77rem;
            background: #f1f5f9;
            color: #334155;
            padding: 0.15rem 0.4rem;
            border-radius: 3px;
            border: 1px solid #e2e8f0;
            display: inline-block;
            max-width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .badge-activo {
            font-size: 0.7rem;
            padding: 0.25rem 0.55rem;
            border-radius: 999px;
            background-color: #d1fae5;
            color: #065f46;
            border: 1px solid #6ee7b7;
            font-weight: 600;
        }

        .badge-inactivo {
            font-size: 0.7rem;
            padding: 0.25rem 0.55rem;
            border-radius: 999px;
            background-color: #fee2e2;
            color: #991b1b;
            border: 1px solid #fca5a5;
            font-weight: 600;
        }

        .textarea-prompt {
            font-family: 'Segoe UI', sans-serif;
            font-size: 0.85rem;
            resize: vertical;
            min-height: 140px;
        }
    </style>

    <div class="card shadow mb-4 mt-4">
        <div class="card-header">
            <i class="fas fa-robot"></i> Gestor de Prompts IA
        </div>
        <div class="card-body p-0">
            <div class="table-responsive table-wrapper">
                <table class="table table-bordered table-hover table-compact">
                    <thead>
                        <tr>
                            <th class="col-id">Id</th>
                            <th class="col-codigo">C&oacute;digo</th>
                            <th class="col-nombre">Nombre</th>
                            <th class="col-desc">Descripci&oacute;n</th>
                            <th class="col-estado">Estado</th>
                            <th class="col-acciones">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-3">
                                    No hay prompts registrados.
                                </td>
                            </tr>
                        }
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="col-id">@p.Id</td>
                                <td class="col-codigo" title="@p.Codigo">
                                    <span class="codigo-tag">@p.Codigo</span>
                                </td>
                                <td class="col-nombre" title="@p.Nombre"><strong>@p.Nombre</strong></td>
                                <td class="col-desc" title="@p.Descripcion">@(string.IsNullOrEmpty(p.Descripcion) ? "—" : p.Descripcion)</td>
                                <td class="col-estado">
                                    @if (p.Activo)
                                    {
                                        <span class="badge-activo">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge-inactivo">Inactivo</span>
                                    }
                                </td>
                                <td class="col-acciones">
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-info btn-sm" title="Ver texto del prompt"
                                                onclick="verTextoPrompt('@Html.Raw(p.Nombre.Replace("'", "\\'"))', '@Html.Raw((p.TextoPrompt ?? "").Replace("'", "\\'").Replace("\r\n", "\\n").Replace("\n", "\\n"))')">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-primary" title="Editar prompt"
                                                data-bs-toggle="modal" data-bs-target="#editarModal"
                                                onclick="setEditarPrompt(@p.Id, '@Html.Raw(p.Codigo.Replace("'","\\'" ))', '@Html.Raw(p.Nombre.Replace("'","\\'" ))', '@Html.Raw((p.Descripcion ?? "").Replace("'","\\'" ))', '@Html.Raw((p.TextoPrompt ?? "").Replace("'","\\'" ).Replace("\r\n","\\n").Replace("\n","\\n"))', @(p.Activo ? "true" : "false"))">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-danger" title="Eliminar prompt"
                                                data-bs-toggle="modal" data-bs-target="#eliminarModal"
                                                onclick="setEliminarPrompt(@p.Id, '@Html.Raw(p.Nombre.Replace("'","\\'" ))')">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer">
            <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#crearModal">
                <i class="fas fa-plus-circle mr-1"></i> Crear prompt
            </button>
        </div>
    </div>

    <!-- ═══════════════════ MODAL VER TEXTO ═══════════════════ -->
    <div class="modal fade" id="verTextoModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-file-alt" style="color:#583AFF;"></i> <span id="verTextoNombre"></span>
                    </h5>
                    <button type="button" class="close" data-bs-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <pre id="verTextoContenido" style="white-space: pre-wrap; font-size: 0.85rem; background: #f8f9fa; padding: 1rem; border-radius: 6px; border: 1px solid #dee2e6; max-height: 400px; overflow-y: auto;"></pre>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                        <i class="fas fa-times mr-1"></i>Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════ MODAL CREAR ═══════════════════ -->
    <div class="modal fade" id="crearModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-plus-circle" style="color:#583AFF;"></i> Crear prompt IA
                    </h5>
                    <button type="button" class="close" data-bs-dismiss="modal"><span>&times;</span></button>
                </div>
                <form method="post" action="@Url.Action("Crear", "GestorPrompts")">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-5 mb-3 mt-2">
                                <label for="crearCodigo" class="form-label">
                                    <i class="fas fa-code mr-2" style="color:#583AFF;"></i>C&oacute;digo <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control form-control-sm" id="crearCodigo" name="Codigo"
                                       placeholder="Ej: RESUMEN_GERENCIAL" maxlength="50" required
                                       style="font-family: monospace; text-transform: uppercase;" />
                            </div>
                            <div class="col-md-7 mb-3 mt-2">
                                <label for="crearNombre" class="form-label">
                                    <i class="fas fa-tag mr-2" style="color:#583AFF;"></i>Nombre <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control form-control-sm" id="crearNombre" name="Nombre"
                                       placeholder="Ej: Resumen Gerencial Ejecutivo" maxlength="100" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="crearDescripcion" class="form-label">
                                <i class="fas fa-align-left mr-2" style="color:#583AFF;"></i>Descripci&oacute;n
                            </label>
                            <input type="text" class="form-control form-control-sm" id="crearDescripcion" name="Descripcion"
                                   placeholder="Ej: Instrucciones para el análisis automático" maxlength="255" />
                        </div>
                        <div class="mb-3">
                            <label for="crearTextoPrompt" class="form-label">
                                <i class="fas fa-robot mr-2" style="color:#583AFF;"></i>Texto del prompt <span class="text-danger">*</span>
                                <small class="text-muted">(instrucciones que se enviar&aacute;n a la IA)</small>
                            </label>
                            <textarea class="form-control textarea-prompt" id="crearTextoPrompt" name="TextoPrompt"
                                      rows="8" placeholder="Ej: Genera un resumen gerencial ejecutivo en 3 a 5 párrafos..." required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                            <i class="fas fa-times mr-1"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fas fa-plus-circle mr-1"></i>Crear
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ═══════════════════ MODAL EDITAR ═══════════════════ -->
    <div class="modal fade" id="editarModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-edit" style="color:#583AFF;"></i> Editar prompt IA
                    </h5>
                    <button type="button" class="close" data-bs-dismiss="modal"><span>&times;</span></button>
                </div>
                <form method="post" action="@Url.Action("Editar", "GestorPrompts")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editId" name="Id" />
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-5 mb-3 mt-2">
                                <label for="editCodigo" class="form-label">
                                    <i class="fas fa-code mr-2" style="color:#583AFF;"></i>C&oacute;digo <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control form-control-sm" id="editCodigo" name="Codigo"
                                       maxlength="50" required style="font-family: monospace; text-transform: uppercase;" />
                            </div>
                            <div class="col-md-7 mb-3 mt-2">
                                <label for="editNombre" class="form-label">
                                    <i class="fas fa-tag mr-2" style="color:#583AFF;"></i>Nombre <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control form-control-sm" id="editNombre" name="Nombre"
                                       maxlength="100" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="editDescripcion" class="form-label">
                                <i class="fas fa-align-left mr-2" style="color:#583AFF;"></i>Descripci&oacute;n
                            </label>
                            <input type="text" class="form-control form-control-sm" id="editDescripcion" name="Descripcion"
                                   maxlength="255" />
                        </div>
                        <div class="mb-3">
                            <label for="editTextoPrompt" class="form-label">
                                <i class="fas fa-robot mr-2" style="color:#583AFF;"></i>Texto del prompt <span class="text-danger">*</span>
                                <small class="text-muted">(instrucciones que se enviar&aacute;n a la IA)</small>
                            </label>
                            <textarea class="form-control textarea-prompt" id="editTextoPrompt" name="TextoPrompt"
                                      rows="8" required></textarea>
                        </div>
                        <div class="mb-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="editActivo" name="Activo" value="true" />
                                <input type="hidden" name="Activo" value="false" />
                                <label class="form-check-label" for="editActivo">Activo</label>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                            <i class="fas fa-times mr-1"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fas fa-save mr-1"></i>Guardar cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ═══════════════════ MODAL ELIMINAR ═══════════════════ -->
    <div class="modal fade" id="eliminarModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle"></i> Confirmar eliminaci&oacute;n
                    </h5>
                    <button type="button" class="close" data-bs-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        <i class="fas fa-question-circle text-warning mr-2"></i>
                        &iquest;Est&aacute;s seguro de que deseas eliminar el prompt <strong id="eliminarNombre"></strong>?
                    </p>
                    <p class="text-muted small mt-2 mb-0">El prompt quedar&aacute; inactivo y no ser&aacute; utilizado por la IA.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                        <i class="fas fa-times mr-1"></i>Cancelar
                    </button>
                    <form method="post" action="@Url.Action("Eliminar", "GestorPrompts")" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="eliminarId" name="id" />
                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="fas fa-trash-alt mr-1"></i>Eliminar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            Swal.fire({ toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end', icon: 'error', title: '@TempData["ErrorMessage"]', showConfirmButton: false, timer: 3000, timerProgressBar: true });
        </script>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            Swal.fire({ toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end', icon: 'success', title: '@TempData["SuccessMessage"]', showConfirmButton: false, timer: 3000, timerProgressBar: true });
        </script>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <script>
            Swal.fire({ toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end', icon: 'info', title: '@TempData["InfoMessage"]', showConfirmButton: false, timer: 3000, timerProgressBar: true });
        </script>
    }

    <script>
        function verTextoPrompt(nombre, texto) {
            document.getElementById('verTextoNombre').textContent = nombre;
            document.getElementById('verTextoContenido').textContent = texto.replace(/\\n/g, '\n');
            new bootstrap.Modal(document.getElementById('verTextoModal')).show();
        }

        function setEditarPrompt(id, codigo, nombre, desc, texto, activo) {
            document.getElementById('editId').value          = id;
            document.getElementById('editCodigo').value      = codigo;
            document.getElementById('editNombre').value      = nombre;
            document.getElementById('editDescripcion').value = desc;
            document.getElementById('editTextoPrompt').value = texto.replace(/\\n/g, '\n');
            document.getElementById('editActivo').checked    = (activo === true || activo === 'true');
        }

        function setEliminarPrompt(id, nombre) {
            document.getElementById('eliminarId').value           = id;
            document.getElementById('eliminarNombre').textContent = '"' + nombre + '"';
        }
    </script>
</body>
</html>
