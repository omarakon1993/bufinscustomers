@{
    ViewBag.Title = "Reportes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>

<html>
<style>
    .iframe-expandido {
        width: 100vw !important;
        height: 100vh !important;
        border: none !important;
    }
</style>
<head>
    <title>Importar excel</title>

    <script src="~/Assets/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Assets/Scripts/bootstrap.bundle.min.js"></script>
    <script src="~/Assets/js/sweetalert2.all.min.js"></script>

    <div class="container mt-4">
        <h4 class="mb-4">Módulo de reportes</h4>

        <div class="row">

            @{
                var usuario = bufinscustomers.Helpers.UsuarioSesionHelper.UsuarioActual;
                var esAdmin = usuario?.Admin == 1;
                ViewBag.EsAdmin = esAdmin;
                var idEmpresa = usuario?.IdEmpresa ?? 0;
            }

            <div class="col-md-3 mb-3">
                <label for="buscarReporte">Buscar por nombre:</label>
                <input type="text" id="buscarReporte" class="form-control" placeholder="Escribe parte del nombre...">
            </div>

            <div class="col-md-3 mb-3">
                <label for="filtroAnioInicial">Año Inicial:</label>
                <select id="filtroAnioInicial" class="form-control">
                    <option value="">-- Seleccionar --</option>
                </select>
            </div>

            <div class="col-md-3 mb-3">
                <label for="filtroAnioFinal">Año Final:</label>
                <select id="filtroAnioFinal" class="form-control">
                    <option value="">-- Seleccionar --</option>
                </select>
            </div>

            @if (esAdmin)
            {
                <div class="col-md-3 mb-3">
                    <label for="filtroEmpresa">Empresa:</label>
                    <select id="filtroEmpresa" class="form-control">
                        <option value="">-- Todas las empresas --</option>
                    </select>
                </div>
            }

        </div>

        <div class="row">
            <div class="col-md-12 mb-3">
                <label for="selectReporte">Reporte:</label>
                <select id="selectReporte" class="form-control">
                    <option value="">-- Seleccione un reporte --</option>
                </select>
            </div>
            <div class="col-md-12 mb-3">
                <button id="btnConsultar" class="btn btn-primary w-100">
                    Consultar
                </button>
            </div>
            <div class="col-md-12 mb-3">
                <button id="btnPantallaCompleta" class="btn btn-secondary w-100" style="display: none;">
                    Pantalla completa
                </button>
            </div>
        </div>

        <div id="iframeContainer" style="position: relative;">
            <iframe id="iframeReporte"
                    style="width: 100%; height: 80vh; border: 1px solid #ccc;"
                    src="">
            </iframe>
        </div>
    </div>

    @section scripts {
        <script>
        const esAdmin = @Html.Raw((ViewBag.EsAdmin ?? false).ToString().ToLower());

        if (esAdmin) {
            fetch('@Url.Action("ObtenerEmpresas", "Reportes")')
                .then(res => res.json())
                .then(data => {
                    if (!Array.isArray(data)) return;
                    const filtroEmpresa = document.getElementById("filtroEmpresa");
                    data.forEach(emp => {
                        const opt = document.createElement("option");
                        opt.value = emp.nombre;
                        opt.textContent = emp.nombre;
                        filtroEmpresa.appendChild(opt);
                    });
                });
        }

        fetch('@Url.Action("ObtenerAniosReporte", "Reportes")')
        .then(res => res.json())
        .then(data => {
            const { iniciales, finales } = data;

            const selInicial = document.getElementById("filtroAnioInicial");
            const selFinal = document.getElementById("filtroAnioFinal");

            iniciales.forEach(anio => {
                const opt = document.createElement("option");
                opt.value = anio;
                opt.textContent = anio;
                selInicial.appendChild(opt);
            });

            finales.forEach(anio => {
                const opt = document.createElement("option");
                opt.value = anio;
                opt.textContent = anio;
                selFinal.appendChild(opt);
            });
        });

        $.getJSON('@Url.Action("ObtenerReportes", "Reportes")', function (data) {
            var select = $('#selectReporte');
            select.empty();
            select.append('<option value="">-- Seleccione un reporte --</option>');
            data.forEach(function (r) {
                select.append('<option value="' + r.Id + '">' + r.Nombre + '</option>');
            });
        });

         function cargarReportesFiltrados() {
            const nombre = $('#buscarReporte').val();
            const anioInicial = $('#filtroAnioInicial').val();
            const anioFinal = $('#filtroAnioFinal').val();
            const empresa = esAdmin ? $('#filtroEmpresa').val() : '';

            $.ajax({
                url: '@Url.Action("ObtenerReportesFiltrados", "Reportes")',
                method: 'GET',
                data: {
                    nombre,
                    anioInicial,
                    anioFinal,
                    empresa
                },
                success: function (data) {
                    const $select = $('#selectReporte');
                    $select.empty();
                    $select.append('<option value="">-- Seleccione un reporte --</option>');

                    if (Array.isArray(data) && data.length > 0) {
                        data.forEach(r => {
                            $select.append(`<option value="${r.Id}">${r.Nombre}</option>`);
                        });
                    } else {
                        $select.append('<option value="">No se encontraron reportes</option>');
                    }
                },
                error: function () {
                    alert("Error al obtener los reportes filtrados");
                }
            });
        }

        $(document).ready(function () {
            $('#buscarReporte').on('input', cargarReportesFiltrados);
            $('#filtroAnioInicial, #filtroAnioFinal').on('change', cargarReportesFiltrados);
            if (esAdmin) {
                $('#filtroEmpresa').on('change', cargarReportesFiltrados);
            }
        });

        $('#btnConsultar').on('click', function () {
        const idReporte = $('#selectReporte').val();

        if (!idReporte) {
            Swal.fire({
                toast: true,
                position: window.innerWidth <= 768 ? 'top' : 'top-end',
                icon: 'warning',
                title: 'Por favor, selecciona un reporte.',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer);
                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                }
            });
            $('#iframeReporte').attr('src', '');
            $('#btnPantallaCompleta').hide(); 
            return;
        }

        $.ajax({
            url: '@Url.Action("ObtenerEnlaceReporte", "Reportes")',
            method: 'GET',
            data: { id: idReporte },
            success: function (data) {
                if (data.enlace) {
                    $('#iframeReporte').attr('src', data.enlace);
                    $('#btnPantallaCompleta').show(); 
                } else {
                    Swal.fire({
                        toast: true,
                        position: window.innerWidth <= 768 ? 'top' : 'top-end',
                        icon: 'info',
                        title: 'No se encontró el enlace para este reporte.',
                        showConfirmButton: false,
                        timer: 3000,
                        timerProgressBar: true,
                        didOpen: (toast) => {
                            toast.addEventListener('mouseenter', Swal.stopTimer);
                            toast.addEventListener('mouseleave', Swal.resumeTimer);
                        }
                    });
                    $('#btnPantallaCompleta').hide(); 
                }
            },
            error: function () {
                    Swal.fire({
                        toast: true,
                        position: window.innerWidth <= 768 ? 'top' : 'top-end',
                        icon: 'error',
                        title: 'Error al obtener el enlace del reporte.',
                        showConfirmButton: false,
                        timer: 3000,
                        timerProgressBar: true,
                        didOpen: (toast) => {
                            toast.addEventListener('mouseenter', Swal.stopTimer);
                            toast.addEventListener('mouseleave', Swal.resumeTimer);
                        }
                    });
                }
            });
        });

        document.getElementById('btnPantallaCompleta').addEventListener('click', function () {
            const container = document.getElementById('iframeContainer');

            if (!document.fullscreenElement) {
                container.requestFullscreen().catch(err => {
                    alert(`Error al activar pantalla completa: ${err.message}`);
                });
            } else {
                document.exitFullscreen();
            }
        });

        document.addEventListener('fullscreenchange', function () {
            const btn = document.getElementById('btnPantallaCompleta');
            const iframe = document.getElementById('iframeReporte');

            if (document.fullscreenElement) {
                btn.textContent = 'Salir de pantalla completa';
                iframe.classList.add('iframe-expandido');
            } else {
                btn.textContent = 'Pantalla completa';
                iframe.classList.remove('iframe-expandido');
            }
        });

        </script>
    }
    </head>
</html>