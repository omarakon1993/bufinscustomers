@{
    ViewBag.Title = "Dashboards Power BI";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var usuario = bufinscustomers.Helpers.UsuarioSesionHelper.UsuarioActual;
    var esSuperAdmin = bufinscustomers.Helpers.UsuarioSesionHelper.EsSuperAdmin();
}

<link href="~/Assets/css/informe-relacionamientos.css" rel="stylesheet" />

<style>
    /* ── Iframe ──────────────────────────────────────────────────── */
    .reporte-iframe-wrapper {
        border-radius: 0.5rem;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(99,102,241,0.10);
        background: #f8f9fc;
        border: 1px solid #e3e6f0;
        line-height: 0;
    }

    #iframeReporte {
        width: 100%;
        height: 80vh;
        border: none;
        display: block;
    }

    #iframeContainer:fullscreen          { background: #000; }
    #iframeContainer:-webkit-full-screen { background: #000; }
    #iframeContainer:-moz-full-screen    { background: #000; }
    #iframeContainer:fullscreen #iframeReporte {
        width: 100vw;
        height: 100vh;
    }

    /* ── Estado vacío ────────────────────────────────────────────── */
    .reporte-empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 300px;
        gap: 0.75rem;
        color: #9ca3af;
    }

    .reporte-empty-state i      { font-size: 3rem; color: #c4b5fd; }
    .reporte-empty-state p      { font-size: 0.95rem; margin: 0; }

    /* ── Botón pantalla completa ─────────────────────────────────── */
    .btn-fullscreen {
        background: white;
        color: #6366F1;
        border: 1.5px solid #c4b5fd;
        padding: 0.625rem 1.2rem;
        border-radius: 0.375rem;
        font-weight: 600;
        font-size: 0.875rem;
        transition: all 0.2s ease;
        cursor: pointer;
        white-space: nowrap;
    }

    .btn-fullscreen:hover {
        background: #ede9fe;
        border-color: #6366F1;
        color: #4338ca;
    }

    /* ── Empresa badge (usuario no super admin) ──────────────────── */
    .empresa-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: #ede9fe;
        color: #4338ca;
        border: 1px solid #c4b5fd;
        border-radius: 0.375rem;
        padding: 0.45rem 0.85rem;
        font-size: 0.875rem;
        font-weight: 600;
        width: 100%;
    }

    .empresa-badge i { color: #6366F1; }

    /* ── Contador de reportes ────────────────────────────────────── */
    .reporte-count {
        font-size: 0.78rem;
        color: #9ca3af;
        margin-top: 0.3rem;
        min-height: 1rem;
    }

    /* ── Separador visual entre grupos de filtros ────────────────── */
    .filtros-separador {
        border: none;
        border-top: 1px dashed #e2e8f0;
        margin: 0.75rem 0;
    }
</style>

<div class="container-fluid px-4">

    <!-- Header -->
    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas fa-chart-pie powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">Dashboards Power BI</h1>
        </div>
    </div>

    <!-- Card de filtros y selección -->
    <div class="filter-card">
        <h3 class="filter-card-title">
            <i class="fas fa-filter"></i>
            Selecci&oacute;n de reporte
        </h3>

        <div class="filter-section">

            <!-- ── Fila 1: Empresa + Búsqueda ─────────────────────── -->
            <div class="row g-3 mb-3">

                <!-- Empresa -->
                <div class="col-md-4">
                    <div class="form-group mb-0">
                        <label for="filtroEmpresa">
                            <i class="fas fa-building"></i>
                            Empresa <span class="required">*</span>
                        </label>
                        @if (esSuperAdmin)
                        {
                            <select id="filtroEmpresa" class="form-control">
                                <option value="">-- Todas las empresas --</option>
                            </select>
                        }
                        else
                        {
                            <!-- Usuario normal: muestra su empresa como badge no editable -->
                            <div class="empresa-badge" id="empresaBadge">
                                <i class="fas fa-lock"></i>
                                <span id="empresaNombreDisplay">Cargando...</span>
                            </div>
                            <input type="hidden" id="filtroEmpresa" value="" />
                        }
                    </div>
                </div>

                <!-- Buscar por nombre -->
                <div class="col-md-4">
                    <div class="form-group mb-0">
                        <label for="buscarReporte">
                            <i class="fas fa-search"></i> Buscar por nombre
                        </label>
                        <input type="text" id="buscarReporte" class="form-control"
                               placeholder="Escribe parte del nombre..." />
                    </div>
                </div>

            </div>

            <!-- ── Fila 2: Años ───────────────────────────────────── -->
            <div class="row g-3 mb-3">

                <div class="col-md-2">
                    <div class="form-group mb-0">
                        <label for="filtroAnioInicial">
                            <i class="fas fa-calendar-alt"></i> A&ntilde;o inicial
                        </label>
                        <select id="filtroAnioInicial" class="form-control">
                            <option value="">-- Todos --</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-group mb-0">
                        <label for="filtroAnioFinal">
                            <i class="fas fa-calendar-check"></i> A&ntilde;o final
                        </label>
                        <select id="filtroAnioFinal" class="form-control">
                            <option value="">-- Todos --</option>
                        </select>
                    </div>
                </div>

            </div>

            <hr class="filtros-separador" />

            <!-- ── Fila 3: Reporte + Acciones ────────────────────── -->
            <div class="row g-3 align-items-end">

                <div class="col-md-6">
                    <div class="form-group mb-0">
                        <label for="selectReporte">
                            <i class="fas fa-file-powerpoint"></i>
                            Reporte <span class="required">*</span>
                        </label>
                        <select id="selectReporte" class="form-control">
                            <option value="">-- Seleccione una empresa primero --</option>
                        </select>
                        <div class="reporte-count" id="reporteCount"></div>
                    </div>
                </div>

                <div class="col-md-3">
                    <button id="btnConsultar" class="btn-modern-gradient w-100" disabled>
                        <i class="fas fa-eye me-1"></i>
                        <span id="btnConsultarTexto">Ver reporte</span>
                    </button>
                </div>

                <div class="col-md-3">
                    <button id="btnPantallaCompleta" class="btn-fullscreen w-100" style="display:none;">
                        <i class="fas fa-expand me-1" id="iconoFullscreen"></i>
                        <span id="textoFullscreen">Pantalla completa</span>
                    </button>
                </div>

            </div>

        </div>
    </div>

    <!-- Área del reporte -->
    <div class="filter-card" style="padding: 0; overflow: hidden;">
        <div id="iframeContainer">
            <div class="reporte-empty-state" id="emptyState">
                <i class="fas fa-chart-bar"></i>
                <p>Seleccione una empresa y un reporte, luego presione <strong>Ver reporte</strong></p>
            </div>
            <div class="reporte-iframe-wrapper" id="iframeWrapper" style="display:none;">
                <iframe id="iframeReporte" src="" allowfullscreen></iframe>
            </div>
        </div>
    </div>

</div>

@section scripts {
<script>
    const esSuperAdmin = @Html.Raw(esSuperAdmin.ToString().ToLower());

    // ─────────────────────────────────────────────────────────────────
    // Utilidades
    // ─────────────────────────────────────────────────────────────────

    function poblarSelectReportes(data) {
        const $sel = $('#selectReporte');
        $sel.empty();

        if (Array.isArray(data) && data.length > 0) {
            $sel.append('<option value="">-- Seleccione un reporte --</option>');
            data.forEach(r => $sel.append(`<option value="${r.Id}">${r.Nombre}</option>`));
            $('#reporteCount').text(data.length + ' reporte' + (data.length !== 1 ? 's' : '') + ' disponible' + (data.length !== 1 ? 's' : ''));
            $('#btnConsultar').prop('disabled', false);
        } else {
            $sel.append('<option value="">No hay reportes para esta empresa</option>');
            $('#reporteCount').text('');
            $('#btnConsultar').prop('disabled', true);
        }

        // Al cambiar empresa limpiar el iframe
        limpiarIframe();
    }

    function limpiarIframe() {
        $('#iframeReporte').attr('src', '');
        $('#iframeWrapper').hide();
        $('#emptyState').show();
        $('#btnPantallaCompleta').hide();
    }

    function getEmpresaSeleccionada() {
        return esSuperAdmin ? $('#filtroEmpresa').val() : $('#filtroEmpresa').val();
    }

    // ─────────────────────────────────────────────────────────────────
    // Cargar años disponibles (solo los que tienen reportes)
    // ─────────────────────────────────────────────────────────────────

    fetch('@Url.Action("ObtenerAniosReporte", "Reportes")')
        .then(r => r.json())
        .then(data => {
            const { iniciales, finales } = data;
            const sI = document.getElementById('filtroAnioInicial');
            const sF = document.getElementById('filtroAnioFinal');
            iniciales.forEach(a => { const o = document.createElement('option'); o.value = a; o.textContent = a; sI.appendChild(o); });
            finales.forEach(a  => { const o = document.createElement('option'); o.value = a; o.textContent = a; sF.appendChild(o); });
        });

    // ─────────────────────────────────────────────────────────────────
    // Cargar empresas y configurar flujo inicial
    // ─────────────────────────────────────────────────────────────────

    fetch('@Url.Action("ObtenerEmpresas", "Reportes")')
        .then(r => r.json())
        .then(data => {
            if (!Array.isArray(data)) return;

            if (esSuperAdmin) {
                // Super Admin: poblar dropdown con todas las empresas
                const sel = document.getElementById('filtroEmpresa');
                data.forEach(emp => {
                    const o = document.createElement('option');
                    o.value    = emp.nombre;
                    o.textContent = emp.nombre;
                    sel.appendChild(o);
                });
                // Cargar todos los reportes por defecto (sin filtro de empresa)
                cargarReportesFiltrados();

            } else {
                // Usuario normal: solo tiene su empresa → mostrarla y cargar sus reportes
                if (data.length > 0) {
                    const empresa = data[0];
                    document.getElementById('empresaNombreDisplay').textContent = empresa.nombre;
                    document.getElementById('filtroEmpresa').value = empresa.nombre;
                }
                cargarReportesFiltrados();
            }
        });

    // ─────────────────────────────────────────────────────────────────
    // Filtrado dinámico de reportes
    // ─────────────────────────────────────────────────────────────────

    function cargarReportesFiltrados() {
        $('#selectReporte').empty().append('<option value="">Cargando...</option>');
        $('#btnConsultar').prop('disabled', true);

        $.ajax({
            url:    '@Url.Action("ObtenerReportesFiltrados", "Reportes")',
            method: 'GET',
            data: {
                nombre:      $('#buscarReporte').val(),
                anioInicial: $('#filtroAnioInicial').val(),
                anioFinal:   $('#filtroAnioFinal').val(),
                empresa:     getEmpresaSeleccionada()
            },
            success: function (data) { poblarSelectReportes(data); },
            error:   function () {
                $('#selectReporte').empty().append('<option value="">Error al cargar reportes</option>');
                Swal.fire({
                    toast: true, position: 'top-end', icon: 'error',
                    title: 'Error al filtrar reportes.',
                    showConfirmButton: false, timer: 3000
                });
            }
        });
    }

    $(document).ready(function () {
        // Cambio de empresa → recargar reportes y limpiar iframe
        $('#filtroEmpresa').on('change', function () {
            limpiarIframe();
            cargarReportesFiltrados();
        });

        // Otros filtros → solo refiltrar reportes (sin limpiar iframe)
        $('#buscarReporte').on('input', cargarReportesFiltrados);
        $('#filtroAnioInicial, #filtroAnioFinal').on('change', cargarReportesFiltrados);

        // Habilitar botón solo cuando hay reporte seleccionado
        $('#selectReporte').on('change', function () {
            $('#btnConsultar').prop('disabled', !$(this).val());
        });
    });

    // ─────────────────────────────────────────────────────────────────
    // Ver reporte
    // ─────────────────────────────────────────────────────────────────

    $('#btnConsultar').on('click', function () {
        const idReporte = $('#selectReporte').val();

        if (!idReporte) {
            Swal.fire({
                toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end',
                icon: 'warning', title: 'Por favor selecciona un reporte.',
                showConfirmButton: false, timer: 3000, timerProgressBar: true,
                didOpen: (t) => { t.addEventListener('mouseenter', Swal.stopTimer); t.addEventListener('mouseleave', Swal.resumeTimer); }
            });
            return;
        }

        const $btn = $('#btnConsultar');
        $btn.prop('disabled', true);
        $('#btnConsultarTexto').text('Cargando...');
        $btn.prepend('<span class="spinner-border spinner-border-sm me-1" id="spinnerConsultar"></span>');

        $.ajax({
            url:    '@Url.Action("ObtenerEnlaceReporte", "Reportes")',
            method: 'GET',
            data:   { id: idReporte },
            success: function (data) {
                if (data.enlace) {
                    $('#iframeReporte').attr('src', data.enlace);
                    $('#emptyState').hide();
                    $('#iframeWrapper').show();
                    $('#btnPantallaCompleta').show();
                } else {
                    Swal.fire({
                        toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end',
                        icon: 'info', title: 'No se encontr\u00f3 el enlace para este reporte.',
                        showConfirmButton: false, timer: 3500, timerProgressBar: true
                    });
                    $('#btnPantallaCompleta').hide();
                }
            },
            error: function () {
                Swal.fire({
                    toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end',
                    icon: 'error', title: 'Error al obtener el enlace del reporte.',
                    showConfirmButton: false, timer: 3500, timerProgressBar: true
                });
            },
            complete: function () {
                $('#spinnerConsultar').remove();
                $('#btnConsultarTexto').text('Ver reporte');
                $('#btnConsultar').prop('disabled', !$('#selectReporte').val());
            }
        });
    });

    // ─────────────────────────────────────────────────────────────────
    // Pantalla completa
    // ─────────────────────────────────────────────────────────────────

    document.getElementById('btnPantallaCompleta').addEventListener('click', function () {
        const container = document.getElementById('iframeContainer');
        if (!document.fullscreenElement) {
            container.requestFullscreen().catch(() => {
                Swal.fire({ toast:true, position:'top-end', icon:'error', title:'No se pudo activar pantalla completa.', showConfirmButton:false, timer:3000 });
            });
        } else {
            document.exitFullscreen();
        }
    });

    document.addEventListener('fullscreenchange', function () {
        const enFS = !!document.fullscreenElement;
        document.getElementById('textoFullscreen').textContent = enFS ? 'Salir de pantalla' : 'Pantalla completa';
        document.getElementById('iconoFullscreen').className   = enFS ? 'fas fa-compress me-1' : 'fas fa-expand me-1';
    });
</script>
}
