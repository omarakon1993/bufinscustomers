﻿@{
    ViewBag.Title = Resources.Strings.Rprt_PageTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var usuario = bufinscustomers.Helpers.UsuarioSesionHelper.UsuarioActual;
    var esSuperAdmin = bufinscustomers.Helpers.UsuarioSesionHelper.EsSuperAdmin();
}

<link href="~/Assets/css/informe-relacionamientos.css" rel="stylesheet" />

<style>
    /* ── Iframe ──────────────────────────────────────────────────── */
    .reporte-iframe-wrapper {
        border-radius: 0.5rem;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(99,102,241,0.10);
        background: #f8f9fc;
        border: 1px solid #e3e6f0;
        line-height: 0;
    }

    #iframeReporte {
        width: 100%;
        height: 80vh;
        border: none;
        display: block;
    }

    #iframeContainer:fullscreen          { background: #000; }
    #iframeContainer:-webkit-full-screen { background: #000; }
    #iframeContainer:-moz-full-screen    { background: #000; }
    #iframeContainer:fullscreen #iframeReporte {
        width: 100vw;
        height: 100vh;
    }

    /* ── Estado vacío ────────────────────────────────────────────── */
    .reporte-empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 300px;
        gap: 0.75rem;
        color: #9ca3af;
    }

    .reporte-empty-state i      { font-size: 3rem; color: #c4b5fd; }
    .reporte-empty-state p      { font-size: 0.95rem; margin: 0; }

    /* ── Botón pantalla completa ─────────────────────────────────── */
    .btn-fullscreen {
        background: white;
        color: #583AFF;
        border: 1.5px solid #c4b5fd;
        padding: 0.625rem 1.2rem;
        border-radius: 0.375rem;
        font-weight: 600;
        font-size: 0.875rem;
        transition: all 0.2s ease;
        cursor: pointer;
        white-space: nowrap;
    }

    .btn-fullscreen:hover {
        background: #ede9fe;
        border-color: #583AFF;
        color: #583AFF;
    }

    /* ── Empresa badge (usuario no super admin) ──────────────────── */
    .empresa-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: #ede9fe;
        color: #583AFF;
        border: 1px solid #c4b5fd;
        border-radius: 0.375rem;
        padding: 0.45rem 0.85rem;
        font-size: 0.875rem;
        font-weight: 600;
        width: 100%;
    }

    .empresa-badge i { color: #583AFF; }

    /* ── Contador de reportes ────────────────────────────────────── */
    .reporte-count {
        font-size: 0.78rem;
        color: #9ca3af;
        margin-top: 0.3rem;
        min-height: 1rem;
    }

    /* ── Separador visual entre grupos de filtros ────────────────── */
    .filtros-separador {
        border: none;
        border-top: 1px dashed #e2e8f0;
        margin: 0.75rem 0;
    }

    /* ── Logo Power BI en header ─────────────────────────────────── */
    .powerbi-header .powerbi-header-content {
        justify-content: space-between !important;
        width: 100% !important;
    }
    .pbi-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .pbi-logo-badge {
        display: flex;
        align-items: center;
        gap: 8px;
        background: white;
        border-radius: 8px;
        padding: 6px 13px 6px 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.18);
        transition: box-shadow 0.2s;
    }
    .pbi-logo-badge:hover {
        box-shadow: 0 3px 14px rgba(0,0,0,0.26);
    }
    .pbi-logo-badge .pbi-label {
        font-size: 0.73rem;
        font-weight: 700;
        color: #1e293b;
        letter-spacing: 0.2px;
        line-height: 1;
    }
    .pbi-logo-badge .pbi-sub {
        font-size: 0.58rem;
        font-weight: 500;
        color: #64748b;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        line-height: 1;
    }
</style>

<div class="container-fluid px-4">

    <!-- Header -->
    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <div class="pbi-header-left">
                <i class="fas fa-chart-column powerbi-header-icon"></i>
                <h1 class="powerbi-header-title">@Resources.Strings.Rprt_PageTitle</h1>
            </div>
            <div class="pbi-logo-badge">
                <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" width="26" height="26" style="flex-shrink:0">
                    <rect width="100" height="100" rx="14" fill="#F2C811"/>
                    <rect x="12" y="60" width="14" height="28" rx="3" fill="white"/>
                    <rect x="31" y="42" width="14" height="46" rx="3" fill="white"/>
                    <rect x="50" y="20" width="14" height="68" rx="3" fill="white"/>
                    <rect x="69" y="38" width="14" height="50" rx="3" fill="rgba(255,255,255,0.88)"/>
                </svg>
                <div style="display:flex;flex-direction:column;gap:2px">
                    <span class="pbi-label">Power BI</span>
                    <span class="pbi-sub">Microsoft</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Card de filtros y selección -->
    <div class="filter-card">
        <h3 class="filter-card-title">
            <i class="fas fa-filter"></i>
            @Resources.Strings.Rprt_FilterTitle
        </h3>

        <div class="filter-section">

            <!-- ── Fila 1: Empresa + Búsqueda ─────────────────────── -->
            <div class="row g-3 mb-3">

                <!-- Empresa -->
                <div class="col-md-4">
                    <div class="form-group mb-0">
                        <label for="filtroEmpresa">
                            <i class="fas fa-building"></i>
                            @Resources.Strings.Rprt_LabelEmpresa <span class="required">*</span>
                        </label>
                        <!--
                            #filtroEmpresa (hidden) es la única fuente de verdad de la empresa
                            seleccionada. La UI visible cambia según cuántas empresas tenga el
                            usuario: selector editable (Super Admin, o usuario con más de una
                            empresa por pertenecer a un Grupo Empresarial) o badge fijo (una sola
                            empresa disponible).
                        -->
                        <input type="hidden" id="filtroEmpresa" value="" />
                        <select id="filtroEmpresaVisible" class="form-control" style="display:none;">
                            <option value="">@Resources.Strings.Rprt_TodasEmpresas</option>
                        </select>
                        <div class="empresa-badge" id="empresaBadge" style="display:none;">
                            <i class="fas fa-lock"></i>
                            <span id="empresaNombreDisplay">@Resources.Strings.Rprt_JS_Cargando</span>
                        </div>
                    </div>
                </div>

                <!-- Buscar por nombre -->
                <div class="col-md-4">
                    <div class="form-group mb-0">
                        <label for="buscarReporte">
                            <i class="fas fa-search"></i> @Resources.Strings.Rprt_LabelBuscar
                        </label>
                        <input type="text" id="buscarReporte" class="form-control"
                               placeholder="@Resources.Strings.Rprt_BuscarPlaceholder" />
                    </div>
                </div>

            </div>

            <!-- ── Fila 2: Años ───────────────────────────────────── -->
            <div class="row g-3 mb-3">

                <div class="col-md-2">
                    <div class="form-group mb-0">
                        <label for="filtroAnioInicial">
                            <i class="fas fa-calendar-alt"></i> @Resources.Strings.Rprt_LabelAnioInicial
                        </label>
                        <select id="filtroAnioInicial" class="form-control">
                            <option value="">@Resources.Strings.Common_Todos</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-group mb-0">
                        <label for="filtroAnioFinal">
                            <i class="fas fa-calendar-check"></i> @Resources.Strings.Rprt_LabelAnioFinal
                        </label>
                        <select id="filtroAnioFinal" class="form-control">
                            <option value="">@Resources.Strings.Common_Todos</option>
                        </select>
                    </div>
                </div>

            </div>

            <hr class="filtros-separador" />

            <!-- ── Fila 3: Reporte + Acciones ────────────────────── -->
            <div class="row g-3 align-items-end">

                <div class="col-md-6">
                    <div class="form-group mb-0">
                        <label for="selectReporte">
                            <i class="fas fa-file-powerpoint"></i>
                            @Resources.Strings.Rprt_LabelReporte <span class="required">*</span>
                        </label>
                        <select id="selectReporte" class="form-control">
                            <option value="">@Resources.Strings.Rprt_SelEmpresaPrimero</option>
                        </select>
                        <div class="reporte-count" id="reporteCount"></div>
                    </div>
                </div>

                <div class="col-md-3">
                    <button id="btnConsultar" class="btn-modern-gradient w-100" disabled>
                        <i class="fas fa-eye me-1"></i>
                        <span id="btnConsultarTexto">@Resources.Strings.Rprt_BtnVer</span>
                    </button>
                </div>

                <div class="col-md-3">
                    <button id="btnPantallaCompleta" class="btn-fullscreen w-100" style="display:none;">
                        <i class="fas fa-expand me-1" id="iconoFullscreen"></i>
                        <span id="textoFullscreen">@Resources.Strings.Rprt_BtnPantallaCompleta</span>
                    </button>
                </div>

            </div>

        </div>
    </div>

    <!-- Área del reporte -->
    <div class="filter-card" style="padding: 0; overflow: hidden;">
        <div id="iframeContainer">
            <div class="reporte-empty-state" id="emptyState">
                <i class="fas fa-chart-bar"></i>
                <p>@Resources.Strings.Rprt_EmptyState <strong>@Resources.Strings.Rprt_BtnVer</strong></p>
            </div>
            <div class="reporte-iframe-wrapper" id="iframeWrapper" style="display:none;">
                <iframe id="iframeReporte" src="" allowfullscreen></iframe>
            </div>
        </div>
    </div>

</div>

@section scripts {
<script>
    const esSuperAdmin = @Html.Raw(esSuperAdmin.ToString().ToLower());
    const _strSelReporte    = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Rprt_SelReporte))';
    const _strNoReportes    = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Rprt_NoReportes))';
    const _strCargando      = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Rprt_JS_Cargando))';
    const _strVerReporte    = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Rprt_JS_Ver))';
    const _strPantallaComp  = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Rprt_BtnPantallaCompleta))';
    const _strSalirPantalla = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Rprt_BtnSalirPantalla))';

    // ─────────────────────────────────────────────────────────────────
    // Utilidades
    // ─────────────────────────────────────────────────────────────────

    function poblarSelectReportes(data) {
        const $sel = $('#selectReporte');
        $sel.empty();

        if (Array.isArray(data) && data.length > 0) {
            $sel.append('<option value="">' + _strSelReporte + '</option>');
            data.forEach(r => $sel.append(`<option value="${r.Id}">${r.Nombre}</option>`));
            $('#reporteCount').text(data.length + ' reporte' + (data.length !== 1 ? 's' : '') + ' disponible' + (data.length !== 1 ? 's' : ''));
            $('#btnConsultar').prop('disabled', false);
        } else {
            $sel.append('<option value="">' + _strNoReportes + '</option>');
            $('#reporteCount').text('');
            $('#btnConsultar').prop('disabled', true);
        }

        // Al cambiar empresa limpiar el iframe
        limpiarIframe();
    }

    function limpiarIframe() {
        $('#iframeReporte').attr('src', '');
        $('#iframeWrapper').hide();
        $('#emptyState').show();
        $('#btnPantallaCompleta').hide();
    }

    function getEmpresaSeleccionada() {
        return $('#filtroEmpresa').val();
    }

    // ─────────────────────────────────────────────────────────────────
    // Cargar años disponibles (solo los que tienen reportes)
    // ─────────────────────────────────────────────────────────────────

    fetch('@Url.Action("ObtenerAniosReporte", "Reportes")')
        .then(r => r.json())
        .then(data => {
            const { iniciales, finales } = data;
            const sI = document.getElementById('filtroAnioInicial');
            const sF = document.getElementById('filtroAnioFinal');
            iniciales.forEach(a => { const o = document.createElement('option'); o.value = a; o.textContent = a; sI.appendChild(o); });
            finales.forEach(a  => { const o = document.createElement('option'); o.value = a; o.textContent = a; sF.appendChild(o); });
        });

    // ─────────────────────────────────────────────────────────────────
    // Cargar empresas y configurar flujo inicial
    // ─────────────────────────────────────────────────────────────────

    fetch('@Url.Action("ObtenerEmpresas", "Reportes")')
        .then(r => r.json())
        .then(data => {
            if (!Array.isArray(data)) return;

            if (esSuperAdmin || data.length > 1) {
                // Super Admin (todas las empresas) o usuario con más de una empresa disponible
                // (empresa propia + empresas de su mismo Grupo Empresarial): selector editable.
                const sel = document.getElementById('filtroEmpresaVisible');
                data.forEach(emp => {
                    const o = document.createElement('option');
                    o.value    = emp.nombre;
                    o.textContent = emp.nombre;
                    sel.appendChild(o);
                });
                sel.style.display = '';
                document.getElementById('empresaBadge').style.display = 'none';
                // Sin selección explícita: se ven los reportes de todas sus empresas disponibles
                cargarReportesFiltrados();

            } else {
                // Una sola empresa disponible: mostrarla como badge no editable
                document.getElementById('filtroEmpresaVisible').style.display = 'none';
                document.getElementById('empresaBadge').style.display = '';
                if (data.length > 0) {
                    const empresa = data[0];
                    document.getElementById('empresaNombreDisplay').textContent = empresa.nombre;
                    document.getElementById('filtroEmpresa').value = empresa.nombre;
                }
                cargarReportesFiltrados();
            }
        });

    // ─────────────────────────────────────────────────────────────────
    // Filtrado dinámico de reportes
    // ─────────────────────────────────────────────────────────────────

    function cargarReportesFiltrados() {
        $('#selectReporte').empty().append('<option value="">' + _strCargando + '</option>');
        $('#btnConsultar').prop('disabled', true);

        $.ajax({
            url:    '@Url.Action("ObtenerReportesFiltrados", "Reportes")',
            method: 'GET',
            data: {
                nombre:      $('#buscarReporte').val(),
                anioInicial: $('#filtroAnioInicial').val(),
                anioFinal:   $('#filtroAnioFinal').val(),
                empresa:     getEmpresaSeleccionada()
            },
            success: function (data) { poblarSelectReportes(data); },
            error:   function () {
                $('#selectReporte').empty().append('<option value="">' + _strNoReportes + '</option>');
                Swal.fire({
                    toast: true, position: 'top-end', icon: 'error',
                    title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Rprt_JS_ErrorFiltrar))',
                    showConfirmButton: false, timer: 3000
                });
            }
        });
    }

    $(document).ready(function () {
        // Cambio de empresa (selector visible) → actualizar el valor real, recargar reportes y limpiar iframe
        $('#filtroEmpresaVisible').on('change', function () {
            $('#filtroEmpresa').val(this.value);
            limpiarIframe();
            cargarReportesFiltrados();
        });

        // Otros filtros → solo refiltrar reportes (sin limpiar iframe)
        $('#buscarReporte').on('input', cargarReportesFiltrados);
        $('#filtroAnioInicial, #filtroAnioFinal').on('change', cargarReportesFiltrados);

        // Habilitar botón solo cuando hay reporte seleccionado
        $('#selectReporte').on('change', function () {
            $('#btnConsultar').prop('disabled', !$(this).val());
        });
    });

    // ─────────────────────────────────────────────────────────────────
    // Ver reporte
    // ─────────────────────────────────────────────────────────────────

    $('#btnConsultar').on('click', function () {
        const idReporte = $('#selectReporte').val();

        if (!idReporte) {
            Swal.fire({
                toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end',
                icon: 'warning', title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Rprt_JS_SinReporte))',
                showConfirmButton: false, timer: 3000, timerProgressBar: true,
                didOpen: (t) => { t.addEventListener('mouseenter', Swal.stopTimer); t.addEventListener('mouseleave', Swal.resumeTimer); }
            });
            return;
        }

        const $btn = $('#btnConsultar');
        $btn.prop('disabled', true);
        $('#btnConsultarTexto').text(_strCargando);
        $btn.prepend('<span class="spinner-border spinner-border-sm me-1" id="spinnerConsultar"></span>');

        $.ajax({
            url:    '@Url.Action("ObtenerEnlaceReporte", "Reportes")',
            method: 'GET',
            data:   { id: idReporte },
            success: function (data) {
                if (data.enlace) {
                    $('#iframeReporte').attr('src', data.enlace);
                    $('#emptyState').hide();
                    $('#iframeWrapper').show();
                    $('#btnPantallaCompleta').show();
                } else {
                    Swal.fire({
                        toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end',
                        icon: 'info', title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Rprt_JS_SinEnlace))',
                        showConfirmButton: false, timer: 3500, timerProgressBar: true
                    });
                    $('#btnPantallaCompleta').hide();
                }
            },
            error: function () {
                Swal.fire({
                    toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end',
                    icon: 'error', title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Rprt_JS_ErrorEnlace))',
                    showConfirmButton: false, timer: 3500, timerProgressBar: true
                });
            },
            complete: function () {
                $('#spinnerConsultar').remove();
                $('#btnConsultarTexto').text(_strVerReporte);
                $('#btnConsultar').prop('disabled', !$('#selectReporte').val());
            }
        });
    });

    // ─────────────────────────────────────────────────────────────────
    // Pantalla completa
    // ─────────────────────────────────────────────────────────────────

    document.getElementById('btnPantallaCompleta').addEventListener('click', function () {
        const container = document.getElementById('iframeContainer');
        if (!document.fullscreenElement) {
            container.requestFullscreen().catch(() => {
                Swal.fire({ toast:true, position:'top-end', icon:'error', title:'@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Rprt_JS_SinPantallaCompleta))', showConfirmButton:false, timer:3000 });
            });
        } else {
            document.exitFullscreen();
        }
    });

    document.addEventListener('fullscreenchange', function () {
        const enFS = !!document.fullscreenElement;
        document.getElementById('textoFullscreen').textContent = enFS ? _strSalirPantalla : _strPantallaComp;
        document.getElementById('iconoFullscreen').className   = enFS ? 'fas fa-compress me-1' : 'fas fa-expand me-1';
    });
</script>
}
