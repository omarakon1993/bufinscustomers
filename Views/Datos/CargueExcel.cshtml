﻿@using bufinscustomers.Models
@{
    ViewBag.Title = Resources.Strings.Datos_PageTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var resultado = TempData["ResultadoCarga"] as ResultadoCargaExcel;
    var nombreArchivo = TempData["NombreArchivo"] as string;
}

<link href="~/Assets/css/informe-relacionamientos.css" rel="stylesheet" />

<style>
    /* Botonera de acciones más compacta (evita el wrap en pantallas de 14") */
    #formCarga .btn-group-actions { gap: 0.5rem; }
    #formCarga .btn-group-actions .btn {
        padding: 0.45rem 0.9rem;
        font-size: 0.8rem;
    }
    #formCarga .btn-group-actions .btn i { margin-right: 0.4rem !important; }

    /* Aviso en línea de "qué falta" para habilitar Cargar Datos */
    .carga-inline-hint {
        display: none;
        align-items: center;
        gap: 7px;
        margin-top: 0.75rem;
        padding: 8px 12px;
        background: #fff7e6;
        border: 1px solid #ffe0a3;
        border-radius: 8px;
        color: #8a5300;
        font-size: 0.78rem;
    }
    .carga-inline-hint.show { display: flex; }
    .carga-inline-hint i { color: #d97706; }

    /* Alerta "Confirmar carga": icono y título un poco más pequeños */
    .swal-carga-compact .swal2-icon {
        width: 3.4em;
        height: 3.4em;
        margin: 1.4em auto 0.4em;
    }
    .swal-carga-compact .swal2-icon .swal2-icon-content { font-size: 2.4em; }
    .swal-carga-compact .swal2-title { font-size: 1.2rem; }
</style>

<div class="container-fluid px-4">
    <!-- Header -->
    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas fa-file-excel powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@Resources.Strings.Datos_PageTitle</h1>
        </div>
    </div>

    <!-- Mensajes -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle mr-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle mr-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- Info último cargue -->
    @if (!string.IsNullOrEmpty(ViewBag.UltimoUsuarioCargue as string))
    {
        <div class="filter-card" style="margin-bottom: 1.25rem; padding: 0.75rem 1.25rem;">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-info-circle" style="color: #583AFF;"></i>
                <span style="font-size: 0.85rem; color: #4a5568;">@ViewBag.UltimoUsuarioCargue</span>
            </div>
        </div>
    }

    <!-- Card de carga -->
    <div class="filter-card">
        <h3 class="filter-card-title">
            <i class="fas fa-file-excel"></i>
            @Resources.Strings.Datos_CardTitle
        </h3>

        <form id="formCarga" action="@Url.Action("CargarExcel", "Datos")" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="filter-section">
                <p style="font-size: 0.85rem; color: #6c757d; margin-bottom: 1rem;">
                    <i class="fas fa-info-circle" style="color: #583AFF;"></i>
                    @Resources.Strings.Datos_UploadHint1
                    <strong>@Resources.Strings.Datos_UploadHint2</strong>
                    @Resources.Strings.Datos_UploadHint3
                </p>

                <div class="row">
                    <!-- Selector de Empresa -->
                    <div class="col-md-6 form-group mb-3">
                        <label for="idEmpresaSeleccionada" class="form-label" style="font-weight: 600; font-size: 0.9rem;">@Resources.Strings.Datos_EmpresaLabel</label>
                        <select class="form-control form-control-sm" id="idEmpresaSeleccionada" name="idEmpresaSeleccionada" required>
                            <option value="0">@Resources.Strings.Datos_SelectEmpresa</option>
                            @if (ViewBag.Empresas != null)
                            {
                                foreach (var empresa in ViewBag.Empresas)
                                {
                                    <option value="@empresa.Id">@empresa.Nombre</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Selector de Año -->
                    <div class="col-md-6 form-group mb-3" id="divSelectAnio" style="display: none;">
                        <label for="selectAnio" class="form-label" style="font-weight: 600; font-size: 0.9rem;">
                            <i class="fas fa-calendar-alt mr-1" style="color: #583AFF;"></i>
                            @Resources.Strings.Datos_AnioLabel
                        </label>
                        <select class="form-control form-control-sm" id="selectAnio" name="anioSeleccionado">
                            <option value="">@Resources.Strings.Datos_JS_SelectAnio</option>
                        </select>
                        <input type="hidden" name="modoSeleccionado" id="modoSeleccionado" value="" />
                        <div id="loadingAnios" style="display: none; font-size: 0.82rem; color: #583AFF; margin-top: 0.35rem;">
                            <i class="fas fa-spinner fa-spin mr-1"></i>@Resources.Strings.Datos_CargandoAnios
                        </div>
                    </div>
                </div>

                <!-- Zona de Drop -->
                <div id="dropZone" style="border: 2px dashed #d1d5db; border-radius: 0.5rem; padding: 2rem; text-align: center; cursor: pointer; transition: all 0.2s ease; background: white;">
                    <i class="fas fa-cloud-upload-alt" style="font-size: 2.5rem; color: #c7d2fe; margin-bottom: 0.75rem;"></i>
                    <p style="font-size: 0.95rem; font-weight: 600; color: #2d3748; margin-bottom: 0.25rem;" id="dropText">
                        @Resources.Strings.Datos_DropText
                    </p>
                    <p style="font-size: 0.8rem; color: #9ca3af; margin: 0;" id="dropSubtext">
                        @Resources.Strings.Datos_DropSubtext
                    </p>
                </div>
                <input type="file" id="archivoExcel" name="archivoExcel" accept=".xlsx,.xlsm"
                       style="display: none;" />
            </div>

            <!-- Botones -->
            <div class="btn-group-actions">
                <button type="submit" id="btnCargar" class="btn btn-modern-gradient" disabled>
                    <i class="fas fa-upload mr-2"></i>@Resources.Strings.Datos_BtnCargar
                </button>
                <button type="button" id="btnInstructivo" class="btn btn-modern-secondary">
                    <i class="fas fa-book mr-2"></i>@Resources.Strings.Datos_BtnInstructivo
                </button>
                <a href="~/Assets/Plantillas/PlantillaBufins.xlsx" download class="btn btn-modern-excel">
                    <i class="fas fa-file-download mr-2"></i>@Resources.Strings.Datos_BtnPlantilla
                </a>
                <span id="wrapPlantillaConDatos" class="d-inline-block" tabindex="0"
                      title="@Resources.Strings.Datos_TipPlantillaConDatosBloqueado">
                    <button type="button" id="btnPlantillaConDatos" class="btn btn-modern-excel"
                            title="@Resources.Strings.Datos_TipPlantillaConDatosBloqueado" style="pointer-events: none;" disabled>
                        <i class="fas fa-database mr-2"></i>@Resources.Strings.Datos_BtnPlantillaConDatos
                    </button>
                </span>
                @if (resultado != null && resultado.MostrarDescargaLog)
                {
                    <a href="@Url.Action("DescargarLog", "Datos")" class="btn btn-modern-secondary">
                        <i class="fas fa-file-alt mr-2"></i>@Resources.Strings.Datos_BtnDescargarLog
                    </a>
                }
                <button type="button" id="btnLimpiar" class="btn btn-modern-secondary" style="display: none;">
                    <i class="fas fa-times mr-2"></i>@Resources.Strings.Datos_BtnQuitarArchivo
                </button>
            </div>

            <!-- Aviso: qué falta para habilitar "Cargar Datos" -->
            <div id="cargaHint" class="carga-inline-hint" role="status">
                <i class="fas fa-info-circle"></i> <span id="cargaHintTexto"></span>
            </div>
        </form>
    </div>

    <!-- Resultados de la carga -->
    @if (resultado != null && resultado.DetalleHojas != null && resultado.DetalleHojas.Count > 0)
    {
        <div class="filter-card">
            <h3 class="filter-card-title">
                <i class="fas fa-clipboard-check"></i>
                @Resources.Strings.Datos_ResultTitle
                @if (!string.IsNullOrEmpty(nombreArchivo))
                {
                    <span style="font-size: 0.8rem; font-weight: 400; color: #6c757d; margin-left: 0.5rem;">
                        &mdash; @nombreArchivo
                    </span>
                }
            </h3>

            <!-- Resumen -->
            <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1rem;">
                <div style="background: @(resultado.Exito ? "linear-gradient(135deg, #10b981, #059669)" : "linear-gradient(135deg, #ef4444, #dc2626)"); color: white; padding: 0.5rem 1rem; border-radius: 0.5rem; font-size: 0.85rem; font-weight: 600;">
                    <i class="fas @(resultado.Exito ? "fa-check-circle" : "fa-times-circle")" style="margin-right: 4px;"></i>
                    @(resultado.Exito ? Resources.Strings.Datos_StatusExitoso : Resources.Strings.Datos_StatusFallido)
                </div>
                @if (resultado.TotalHojasProcesadas > 0)
                {
                    <div style="background: var(--app-btn-gradient); color: white; padding: 0.5rem 1rem; border-radius: 0.5rem; font-size: 0.85rem; font-weight: 600;">
                        <i class="fas fa-table" style="margin-right: 4px;"></i>
                        @resultado.TotalHojasProcesadas @Resources.Strings.Datos_Tablas
                    </div>
                    <div style="background: var(--app-btn-gradient); color: white; padding: 0.5rem 1rem; border-radius: 0.5rem; font-size: 0.85rem; font-weight: 600;">
                        <i class="fas fa-database" style="margin-right: 4px;"></i>
                        @resultado.TotalFilasInsertadas.ToString("N0") @Resources.Strings.Datos_Registros
                    </div>
                }
                @if (resultado.TotalHojasIgnoradas > 0)
                {
                    <div style="background: linear-gradient(135deg, #f59e0b, #d97706); color: white; padding: 0.5rem 1rem; border-radius: 0.5rem; font-size: 0.85rem; font-weight: 600;">
                        <i class="fas fa-forward" style="margin-right: 4px;"></i>
                        @resultado.TotalHojasIgnoradas @Resources.Strings.Datos_Ignoradas
                    </div>
                }
            </div>

            <!-- Detalle por hoja -->
            <div class="table-wrapper" style="max-height: 400px;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@Resources.Strings.Datos_ThHoja</th>
                            <th>@Resources.Strings.Datos_ThTabla</th>
                            <th>@Resources.Strings.Datos_ThEstado</th>
                            <th>@Resources.Strings.Datos_ThFilas</th>
                            <th>@Resources.Strings.Datos_ThColumnas</th>
                            <th>@Resources.Strings.Datos_ThDetalle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detalle in resultado.DetalleHojas)
                        {
                            string rowColor;
                            string iconClass;
                            switch (detalle.Estado)
                            {
                                case "Exitoso":
                                    rowColor = "#f0fdf4";
                                    iconClass = "fa-check-circle";
                                    break;
                                case "Error":
                                case "Revertido":
                                    rowColor = "#fef2f2";
                                    iconClass = "fa-times-circle";
                                    break;
                                default:
                                    rowColor = "#fefce8";
                                    iconClass = "fa-forward";
                                    break;
                            }
                            <tr style="background-color: @rowColor;">
                                <td><strong>@detalle.NombreHoja</strong></td>
                                <td>@detalle.NombreTabla</td>
                                <td>
                                    <i class="fas @iconClass" style="margin-right: 4px;
                                       color: @(detalle.Estado == "Exitoso" ? "#10b981" : detalle.Estado == "Ignorada" ? "#f59e0b" : "#ef4444");"></i>
                                    @(detalle.Estado == "Exitoso" ? Resources.Strings.Datos_StatusExitoso :
                                      detalle.Estado == "Ignorada" ? Resources.Strings.Datos_StatusIgnorada :
                                      detalle.Estado == "Revertido" ? Resources.Strings.Datos_StatusRevertido :
                                      Resources.Strings.Datos_StatusFallido)
                                </td>
                                <td>@(detalle.FilasInsertadas > 0 ? detalle.FilasInsertadas.ToString("N0") : "-")</td>
                                <td>@(detalle.TotalColumnas > 0 ? detalle.TotalColumnas.ToString() : "-")</td>
                                <td style="font-size: 0.8rem; color: #6c757d;">@(detalle.MensajeError ?? "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Overlay de procesamiento -->
<div id="overlayProcesando" class="overlay-cargando" style="display:none;">
    <div class="overlay-cargando-card">
        @Html.Partial("_LoaderDots", "aqua")
        <h5 class="overlay-cargando-title" id="overlayTitulo">@Resources.Strings.Datos_JS_Procesando</h5>
        <p class="overlay-cargando-text">@Resources.Strings.Datos_OverlayNoCierre</p>
        <div class="overlay-cargando-timer">
            <i class="fas fa-clock"></i>
            <span id="overlayTimer">0s</span>
        </div>
    </div>
</div>

<!-- Modal Instructivo -->
<style>
    #instructivoModal .modal-content {
        border: none;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 24px 60px rgba(88, 58, 255, 0.22);
    }
    #instructivoModal .modal-header {
        background: var(--content-gradient);
        padding: 1.05rem 1.5rem;
        border-bottom: none;
        align-items: center;
    }
    #instructivoModal .modal-title {
        color: #fff;
        font-weight: 700;
        font-size: 1.12rem;
        margin: 0;
        letter-spacing: -0.2px;
    }
    #instructivoModal .instr-subtitle { color: rgba(255, 255, 255, 0.72); font-size: 0.76rem; }
    #instructivoModal .instr-brand-badge {
        width: 38px; height: 38px;
        border-radius: 11px;
        display: inline-flex; align-items: center; justify-content: center;
        background: rgba(255, 255, 255, 0.18);
        border: 1px solid rgba(255, 255, 255, 0.35);
        color: #fff;
        font-weight: 800;
        font-size: 1.15rem;
        letter-spacing: -0.5px;
        font-family: 'Nunito', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        flex-shrink: 0;
    }
    #instructivoModal .modal-body {
        padding: 1.4rem 1.5rem;
        color: #2d3748;
        font-size: 0.88rem;
        line-height: 1.6;
    }
    #instructivoModal .modal-footer {
        border-top: 1px solid #e9ecf5;
        padding: 0.85rem 1.5rem;
        background: #f8f9fc;
    }

    /* Intro */
    #instructivoModal .instr-intro {
        background: #f5f6ff;
        border: 1px solid #e6e8ff;
        border-radius: 10px;
        padding: 13px 15px;
        margin-bottom: 16px;
        font-size: 0.84rem;
        color: #4a5168;
        line-height: 1.55;
    }
    #instructivoModal .instr-intro p { margin: 0; display: flex; gap: 0.55rem; }
    #instructivoModal .instr-intro p + p { margin-top: 0.5rem; }
    #instructivoModal .instr-intro i { margin-top: 0.15rem; color: #583AFF; flex-shrink: 0; }

    /* Buscador */
    #instructivoModal .instr-search-wrap { position: relative; margin-bottom: 14px; }
    #instructivoModal .instr-search-wrap > i {
        position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
        color: #9aa3b8; font-size: 0.82rem;
    }
    #instructivoModal .instr-search {
        width: 100%;
        border: 1.5px solid #e4e7f2;
        border-radius: 9px;
        padding: 0.55rem 0.9rem 0.55rem 2.35rem;
        font-size: 0.85rem;
        color: #2d3748;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    #instructivoModal .instr-search:focus {
        border-color: #583AFF;
        box-shadow: 0 0 0 3px rgba(88, 58, 255, 0.12);
        outline: none;
    }

    /* Secciones e ítems: misma familia visual */
    #instructivoModal .instr-section,
    #instructivoModal .instr-item {
        border: 1px solid #e9ecf5;
        border-radius: 10px;
        overflow: hidden;
        background: #fff;
    }
    #instructivoModal .instr-section { margin-bottom: 12px; }
    #instructivoModal .instr-section:last-child { margin-bottom: 0; }
    #instructivoModal .instr-item { border-radius: 8px; margin-bottom: 8px; }
    #instructivoModal .instr-item:last-child { margin-bottom: 0; }

    #instructivoModal .instr-head {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 13px 16px;
        background: #fff;
        border: none;
        text-align: left;
        font-weight: 700;
        font-size: 0.9rem;
        color: #2d3748;
        cursor: pointer;
        transition: background 0.15s ease;
    }
    #instructivoModal .instr-item .instr-head {
        padding: 10px 14px;
        font-weight: 600;
        font-size: 0.84rem;
        color: #3a3f51;
    }
    #instructivoModal .instr-head:hover,
    #instructivoModal .instr-head[aria-expanded="true"] { background: #f6f7fc; }
    #instructivoModal .instr-head:focus { outline: none; }

    #instructivoModal .instr-ico {
        width: 30px; height: 30px;
        border-radius: 8px;
        display: inline-flex; align-items: center; justify-content: center;
        background: rgba(88, 58, 255, 0.1);
        color: #583AFF;
        font-size: 0.78rem;
        flex-shrink: 0;
    }
    #instructivoModal .instr-item .instr-ico { width: 26px; height: 26px; font-size: 0.72rem; }
    #instructivoModal .instr-title { flex: 1; }
    #instructivoModal .instr-chev { color: #a0a6b8; font-size: 0.78rem; transition: transform 0.2s ease; }
    #instructivoModal .instr-head[aria-expanded="true"] .instr-chev { transform: rotate(180deg); }

    #instructivoModal .instr-body {
        padding: 14px 18px 16px;
        background: #fbfbfe;
        border-top: 1px solid #eef0f7;
        font-size: 0.84rem;
        color: #4a5168;
        line-height: 1.6;
    }
    #instructivoModal .instr-item .instr-body { padding: 12px 16px 14px; font-size: 0.82rem; }
    #instructivoModal .instr-body ol,
    #instructivoModal .instr-body ul { padding-left: 1.15rem; margin-bottom: 0; }
    #instructivoModal .instr-body li { margin-bottom: 0.4rem; }
    #instructivoModal .instr-body li:last-child { margin-bottom: 0; }
    #instructivoModal .instr-body ul ul { margin-top: 0.3rem; }
    #instructivoModal .instr-body strong { color: #2d3748; }

    #instructivoModal .instr-item.oculto { display: none; }
    #instructivoModal .instr-sin-resultados {
        display: none;
        text-align: center;
        color: #8a90a2;
        font-size: 0.83rem;
        padding: 14px 0 4px;
    }

    @@media (max-width: 575.98px) {
        #instructivoModal .modal-body { padding: 1.1rem 1rem; }
    }
</style>

<div class="modal fade" id="instructivoModal" tabindex="-1" role="dialog" aria-labelledby="instructivoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div style="display: flex; align-items: center; gap: 0.85rem;">
                    <span class="instr-brand-badge" aria-hidden="true">B</span>
                    <div>
                        <h5 class="modal-title" id="instructivoModalLabel">@Resources.Strings.Datos_ModalTitle</h5>
                        <span class="instr-subtitle">@Resources.Strings.Datos_ModalSubtitle</span>
                    </div>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: white; opacity: 0.9; text-shadow: none; font-size: 1.5rem;">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="instr-intro">
                    <p><i class="fas fa-database"></i><span>@Resources.Strings.Datos_InstructivoIntro1</span></p>
                    <p><i class="fas fa-info-circle"></i><span>@Resources.Strings.Datos_InstructivoIntro2</span></p>
                </div>

                <!-- Sección: reglas generales -->
                <div class="instr-section">
                    <button class="instr-head" type="button" data-toggle="collapse" data-target="#collapseInstructivo"
                            aria-expanded="false" aria-controls="collapseInstructivo">
                        <span class="instr-ico"><i class="fas fa-list-check"></i></span>
                        <span class="instr-title">@Resources.Strings.Datos_BtnParaTenerEnCuenta</span>
                        <i class="fas fa-chevron-down instr-chev"></i>
                    </button>
                    <div class="collapse" id="collapseInstructivo">
                        <div class="instr-body">
                            <ol>
                                <li>@Resources.Strings.Datos_Regla1</li>
                                <li>@Resources.Strings.Datos_Regla2</li>
                                <li>@Resources.Strings.Datos_Regla3</li>
                                <li>@Resources.Strings.Datos_Regla4</li>
                                <li>@Resources.Strings.Datos_Regla5</li>
                                <li>@Resources.Strings.Datos_Regla6</li>
                                <li>@Resources.Strings.Datos_Regla7</li>
                                <li>@Resources.Strings.Datos_Regla8</li>
                                <li>@Resources.Strings.Datos_Regla9</li>
                                <li>@Resources.Strings.Datos_Regla10</li>
                                <li>@Resources.Strings.Datos_Regla11</li>
                                <li>@Resources.Strings.Datos_Regla12</li>
                            </ol>
                        </div>
                    </div>
                </div>

                <!-- Sección: guía por hoja -->
                <div class="instr-section">
                    <button class="instr-head" type="button" data-toggle="collapse" data-target="#collapsePestanas"
                            aria-expanded="true" aria-controls="collapsePestanas">
                        <span class="instr-ico"><i class="fas fa-folder-open"></i></span>
                        <span class="instr-title">@Resources.Strings.Datos_BtnPestanas</span>
                        <i class="fas fa-chevron-down instr-chev"></i>
                    </button>
                    <div class="collapse show" id="collapsePestanas">
                        <div class="instr-body">
                            <div class="instr-search-wrap">
                                <i class="fas fa-search"></i>
                                <input type="text" class="instr-search" id="busquedaPestanas" placeholder="@Resources.Strings.Datos_BuscarHoja" onkeyup="filtrarPestanas()">
                            </div>

                            <div id="accordionPestanas">

                                <!-- Z_BalancePrueba -->
                                <div class="instr-item" data-hoja="Z_BalancePrueba">
                                    <button class="instr-head" type="button" data-toggle="collapse" data-target="#collapseBalancePrueba" aria-expanded="false" aria-controls="collapseBalancePrueba">
                                        <span class="instr-ico"><i class="fas fa-coins"></i></span>
                                        <span class="instr-title">Z_BalancePrueba</span>
                                        <i class="fas fa-chevron-down instr-chev"></i>
                                    </button>
                                    <div id="collapseBalancePrueba" class="collapse" data-parent="#accordionPestanas">
                                        <div class="instr-body">
                                            <ul>
                                                <li>Los datos de <strong>Z_BalancePrueba</strong> deben estar en la misma unidad de medida reportada en <strong>Z_Moneda</strong>.</li>
                                                <li>La celda <strong>F1</strong> debe ser id&eacute;ntica a la reportada en <strong>Z_Moneda</strong>.</li>
                                                <li>El nombre de las empresas deber&aacute; estar escrito en forma id&eacute;ntica a como se report&oacute; en la hoja de <strong>Z_Empresa</strong>.</li>
                                                <li>El nombre de los pa&iacute;ses deber&aacute; estar escrito en forma id&eacute;ntica a como se report&oacute; en la hoja de <strong>Z_Paises</strong>.</li>
                                                <li>En la celda <strong>A1</strong> coloque los datos del balance de prueba (balance de comprobaci&oacute;n) respetando el orden de las columnas. Esta informaci&oacute;n deber&aacute; estar por tres a&ntilde;os y por meses, comenzando por el a&ntilde;o actual y los dos a&ntilde;os anteriores para las empresas y pa&iacute;ses que se vayan a consolidar.</li>
                                                <li>El <strong>Z_BalancePrueba</strong> debe estar a 1, 2, 4 y 6 d&iacute;gitos del PUC.</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                                <!-- Z_CteYnoCte -->
                                <div class="instr-item" data-hoja="Z_CteYnoCte">
                                    <button class="instr-head" type="button" data-toggle="collapse" data-target="#collapseCteYnoCte" aria-expanded="false" aria-controls="collapseCteYnoCte">
                                        <span class="instr-ico"><i class="fas fa-book"></i></span>
                                        <span class="instr-title">Z_CteYnoCte</span>
                                        <i class="fas fa-chevron-down instr-chev"></i>
                                    </button>
                                    <div id="collapseCteYnoCte" class="collapse" data-parent="#accordionPestanas">
                                        <div class="instr-body">
                                            <ul>
                                                <li>Aplican las mismas instrucciones de la hoja <strong>Z_BalancePrueba</strong> a 4 d&iacute;gitos del PUC, para las cuentas de activos y pasivos que deben clasificarse como de car&aacute;cter corriente y no corriente.</li>
                                                <li>En la columna <strong>K</strong> deber&aacute; indicar si el activo o el pasivo es corriente o no corriente, para lo cual deber&aacute; usar la descripci&oacute;n de <strong>Z_Categorias</strong> usando la lista desplegable.</li>
                                                <li>Las cuentas <strong>Z_CteYnoCte</strong> deben estar a 4 d&iacute;gitos del PUC.</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                                <!-- Z_PYGDetallado -->
                                <div class="instr-item" data-hoja="Z_PYGDetallado">
                                    <button class="instr-head" type="button" data-toggle="collapse" data-target="#collapsePYGDetallado" aria-expanded="false" aria-controls="collapsePYGDetallado">
                                        <span class="instr-ico"><i class="fas fa-file-invoice-dollar"></i></span>
                                        <span class="instr-title">Z_PYGDetallado</span>
                                        <i class="fas fa-chevron-down instr-chev"></i>
                                    </button>
                                    <div id="collapsePYGDetallado" class="collapse" data-parent="#accordionPestanas">
                                        <div class="instr-body">
                                            <ul>
                                                <li>Los datos de <strong>Z_PYGDetallado</strong> deben estar en la misma unidad de medida reportada en <strong>Z_Moneda</strong>.</li>
                                                <li>La celda <strong>E (Nuevo saldo)</strong> debe ser id&eacute;ntica a la reportada en <strong>Z_Moneda</strong>.</li>
                                                <li>El nombre de las empresas deber&aacute; estar escrito en forma id&eacute;ntica a como se report&oacute; en la hoja de <strong>Z_Empresa</strong>.</li>
                                                <li>El nombre de los pa&iacute;ses deber&aacute; estar escrito en forma id&eacute;ntica a como se report&oacute; en la hoja de <strong>Z_Paises</strong>.</li>
                                                <li>En la celda <strong>A1</strong> coloque los datos del estado de resultados a 6 d&iacute;gitos del PUC, respetando el orden de las columnas.</li>
                                                <li>En la columna <strong>C (Tipo)</strong> coloque el nombre de las l&iacute;neas de venta que se hayan definido previamente.</li>
                                                <li>En la columna <strong>D (L&iacute;nea de negocio)</strong> coloque el nombre de las l&iacute;neas de negocio que se hayan definido previamente.</li>
                                                <li>En la columna <strong>J (Ajuste1)</strong> indique si el ingreso o el gasto se considera parte del Ebitda o no: <strong>Ebitda</strong> o <strong>No Ebitda</strong>.</li>
                                                <li>
                                                    En la columna <strong>K (Ajuste2)</strong> coloque la clasificaci&oacute;n de los costos y los gastos seg&uacute;n su naturaleza:
                                                    <ul>
                                                        <li>GASTOS FIJOS</li>
                                                        <li>GASTOS VARIABLES</li>
                                                        <li>OTROS GASTOS</li>
                                                    </ul>
                                                </li>
                                                <li>Las cuentas de <strong>Z_PYGDetallado</strong> deben estar a 6 d&iacute;gitos del PUC.</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                                <!-- Z_PYGDetalladoConAjuste -->
                                <div class="instr-item" data-hoja="Z_PYGDetalladoConAjuste">
                                    <button class="instr-head" type="button" data-toggle="collapse" data-target="#collapsePYGDetalladoConAjuste" aria-expanded="false" aria-controls="collapsePYGDetalladoConAjuste">
                                        <span class="instr-ico"><i class="fas fa-chart-line"></i></span>
                                        <span class="instr-title">Z_PYGDetalladoConAjuste</span>
                                        <i class="fas fa-chevron-down instr-chev"></i>
                                    </button>
                                    <div id="collapsePYGDetalladoConAjuste" class="collapse" data-parent="#accordionPestanas">
                                        <div class="instr-body">
                                            Esta hoja es id&eacute;ntica a la de Z_PYGDetallado. La &uacute;nica diferencia es que podr&aacute; reclasificar ingresos, costos y gastos para obtener el Ebitda Ajustado.
                                            Las cuentas Z_PYGDetalladoConAjuste deben estar a 6 d&iacute;gitos del PUC.
                                        </div>
                                    </div>
                                </div>

                                <!-- Z_PresupuestoBalance -->
                                <div class="instr-item" data-hoja="Z_PresupuestoBalance">
                                    <button class="instr-head" type="button" data-toggle="collapse" data-target="#collapsePresupuestoBalance" aria-expanded="false" aria-controls="collapsePresupuestoBalance">
                                        <span class="instr-ico"><i class="fas fa-chart-bar"></i></span>
                                        <span class="instr-title">Z_PresupuestoBalance</span>
                                        <i class="fas fa-chevron-down instr-chev"></i>
                                    </button>
                                    <div id="collapsePresupuestoBalance" class="collapse" data-parent="#accordionPestanas">
                                        <div class="instr-body">
                                            En esta hoja se debe reportar el presupuesto de la compa&ntilde;&iacute;a por cuentas de balance a 1, 2, 4 y 6 d&iacute;gitos del PUC. En caso de no tener presupuesto de balance se debe dejar en blanco.
                                            Las cuentas de Z_Presupuesto deben estar a 6 d&iacute;gitos del PUC.
                                        </div>
                                    </div>
                                </div>

                                <!-- Z_PptoPYGDetallado -->
                                <div class="instr-item" data-hoja="Z_PptoPYGDetallado">
                                    <button class="instr-head" type="button" data-toggle="collapse" data-target="#collapsePptoPYGDetallado" aria-expanded="false" aria-controls="collapsePptoPYGDetallado">
                                        <span class="instr-ico"><i class="fas fa-piggy-bank"></i></span>
                                        <span class="instr-title">Z_PptoPYGDetallado</span>
                                        <i class="fas fa-chevron-down instr-chev"></i>
                                    </button>
                                    <div id="collapsePptoPYGDetallado" class="collapse" data-parent="#accordionPestanas">
                                        <div class="instr-body">
                                            Este es el presupuesto detallado discriminado por tipo y L&iacute;neas de negocio. La estructura de esta hoja es igual a la Z_PYGDetallado.
                                            Las cuentas de Z_PresupuestoDetallado deben estar a 6 d&iacute;gitos del PUC.
                                        </div>
                                    </div>
                                </div>

                                <!-- Z_PptoPYGDetalladoConAjuste -->
                                <div class="instr-item" data-hoja="Z_PptoPYGDetalladoConAjuste">
                                    <button class="instr-head" type="button" data-toggle="collapse" data-target="#collapsePptoPYGDetalladoConAjuste" aria-expanded="false" aria-controls="collapsePptoPYGDetalladoConAjuste">
                                        <span class="instr-ico"><i class="fas fa-money-bill-wave"></i></span>
                                        <span class="instr-title">Z_PptoPYGDetalladoConAjuste</span>
                                        <i class="fas fa-chevron-down instr-chev"></i>
                                    </button>
                                    <div id="collapsePptoPYGDetalladoConAjuste" class="collapse" data-parent="#accordionPestanas">
                                        <div class="instr-body">
                                            Este es el presupuesto detallado discriminado por tipo y L&iacute;neas de negocio. La estructura de esta hoja es igual a la Z_PYGDetalladoConAjuste.
                                            Las cuentas de Z_PresupuestoDetalladoConAjuste deben estar a 6 d&iacute;gitos del PUC.
                                        </div>
                                    </div>
                                </div>

                                <!-- Z_PCH -->
                                <div class="instr-item" data-hoja="Z_PCH">
                                    <button class="instr-head" type="button" data-toggle="collapse" data-target="#collapsePCH" aria-expanded="false" aria-controls="collapsePCH">
                                        <span class="instr-ico"><i class="fas fa-bullseye"></i></span>
                                        <span class="instr-title">Z_PCH</span>
                                        <i class="fas fa-chevron-down instr-chev"></i>
                                    </button>
                                    <div id="collapsePCH" class="collapse" data-parent="#accordionPestanas">
                                        <div class="instr-body">
                                            Las cuentas de Z_PCH deben estar a de 4 a 6 d&iacute;gitos del PUC y corresponden a las indicadas en la hoja.
                                            Los valores de Z_PCH equivalen a los ahorros que se estiman como objetivos.
                                        </div>
                                    </div>
                                </div>

                                <!-- Z_EjecPCH -->
                                <div class="instr-item" data-hoja="Z_EjecPCH">
                                    <button class="instr-head" type="button" data-toggle="collapse" data-target="#collapseEjecPCH" aria-expanded="false" aria-controls="collapseEjecPCH">
                                        <span class="instr-ico"><i class="fas fa-flag"></i></span>
                                        <span class="instr-title">Z_EjecPCH</span>
                                        <i class="fas fa-chevron-down instr-chev"></i>
                                    </button>
                                    <div id="collapseEjecPCH" class="collapse" data-parent="#accordionPestanas">
                                        <div class="instr-body">
                                            Las cuentas de Z_EjecPCH deben estar a de 4 a 6 d&iacute;gitos del PUC.
                                            Las cuentas de Z_EjecPCH equivalen a los ahorros ejecutados.
                                        </div>
                                    </div>
                                </div>

                                <div class="instr-sin-resultados" id="pestanasSinResultados">
                                    <i class="fas fa-search mr-1"></i>@Resources.Strings.Datos_SinResultadosHoja
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="justify-content: space-between;">
                <a href="~/Assets/Plantillas/InstructivoPlantillaCargue.xlsx" download class="btn btn-modern-excel">
                    <i class="fas fa-file-excel mr-2"></i>@Resources.Strings.Datos_BtnInstructivoExcel
                </a>
                <button type="button" class="btn btn-modern-gradient" data-dismiss="modal">
                    <i class="fas fa-times mr-2"></i>@Resources.Strings.Layout_Close
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: descargar plantilla con los datos actuales -->
<div class="modal fade modal-confirm" id="modalPlantillaConDatos" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-database mr-2"></i>@Resources.Strings.Datos_ModalPlantillaConDatos_Titulo
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p style="font-size: 0.88rem;">@Resources.Strings.Datos_ModalPlantillaConDatos_Intro</p>
                <label style="display: flex; align-items: center; gap: 0.6rem; font-weight: 600; padding: 0.4rem 0.2rem; border-bottom: 1px solid rgba(255,255,255,0.08); cursor: pointer;">
                    <input type="checkbox" id="pcdTodos" disabled>
                    @Resources.Strings.Datos_ModalPlantillaConDatos_SeleccionarTodos
                </label>
                <div id="pcdListaAnios" style="max-height: 240px; overflow-y: auto; margin-top: 0.25rem;"></div>
                <div id="pcdSinAnios" style="display: none; padding: 0.75rem 0; color: #fbbf24; font-size: 0.88rem;">
                    @Resources.Strings.Datos_ModalPlantillaConDatos_SinAnios
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">@Resources.Strings.Layout_Cancel</button>
                <button type="button" id="btnPcdDescargar" class="btn btn-primary" disabled>
                    <i class="fas fa-file-download mr-1"></i>@Resources.Strings.Datos_ModalPlantillaConDatos_Descargar
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        var _datosMsg = {
            formatoInvalido: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Datos_JS_FormatoInvalido))',
            soloXlsx: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Datos_JS_SoloXlsx))',
            empresaRequerida: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Datos_JS_EmpresaRequerida))',
            seleccionarEmpresa: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Datos_JS_SeleccionarEmpresa))',
            confirmarCarga: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Datos_JS_ConfirmarCarga))',
            confirmarBold: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Datos_JS_ConfirmarBold))',
            confirmarRest: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Datos_JS_ConfirmarRest))',
            confirmarPregunta: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Datos_JS_ConfirmarPregunta))',
            siCargar: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Datos_JS_SiCargar))',
            cancelar: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Layout_Cancel))',
            procesando: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Datos_JS_Procesando))',
            dropText: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Datos_DropText))',
            dropSubtext: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Datos_DropSubtext))',
            empresaLabel: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Datos_EmpresaLabel))',
            anioLabel: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Datos_AnioLabel))',
            selectAnio: '@Resources.Strings.Datos_JS_SelectAnio',
            anioEjecucion: '@Resources.Strings.Datos_JS_AnioEjecucion',
            anosHistoricos: '@Resources.Strings.Datos_JS_AnosHistoricos',
            historico: '@Resources.Strings.Datos_JS_Historico',
            anioRequerido: '@Resources.Strings.Datos_JS_AnioRequerido',
            seleccionarAnio: '@Resources.Strings.Datos_JS_SeleccionarAnio',
            configIncompleta: '@Resources.Strings.Datos_JS_ConfigIncompleta',
            errorCargarAnios: '@Resources.Strings.Datos_JS_ErrorCargarAnios',
            modoEjecucion: '@Resources.Strings.Datos_JS_ModoEjecucion',
            modoHistorico: '@Resources.Strings.Datos_JS_ModoHistorico',
            modo: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Datos_JS_Modo))',
            faltan: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Datos_JS_Faltan))',
            faltaEmpresa: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Datos_JS_FaltaEmpresa))',
            faltaAnio: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Datos_JS_FaltaAnio))',
            faltaArchivo: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Datos_JS_FaltaArchivo))'
        };

        var _pcdUrls = {
            anios: '@Url.Action("ObtenerAniosConDatos", "Datos")',
            descargar: '@Url.Action("DescargarPlantillaConDatos", "Datos")'
        };
        var _pcdMsg = {
            generando: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Datos_JS_PlantillaConDatosGenerando))',
            registros: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Datos_ModalPlantillaConDatos_Registros))',
            sinAnios: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Datos_ModalPlantillaConDatos_SinAnios))',
            errorGenerico: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Datos_PlantillaConDatosError))',
            tipBloqueado: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Datos_TipPlantillaConDatosBloqueado))',
            tipHabilitado: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Datos_TipPlantillaConDatosHabilitado))'
        };

        function actualizarTipPlantillaDatos(habilitado) {
            var txt = habilitado ? _pcdMsg.tipHabilitado : _pcdMsg.tipBloqueado;
            var wrap = document.getElementById('wrapPlantillaConDatos');
            var btn = document.getElementById('btnPlantillaConDatos');
            if (wrap) { wrap.setAttribute('title', txt); }
            if (btn) {
                btn.setAttribute('title', txt);
                btn.style.pointerEvents = habilitado ? 'auto' : 'none';
            }
        }

        $(document).ready(function () {
            var dropZone = $('#dropZone');
            var fileInput = $('#archivoExcel');
            var btnCargar = $('#btnCargar');
            var btnLimpiar = $('#btnLimpiar');

            // ── Habilita "Cargar Datos" solo con empresa + año + archivo ─────────
            function estadoBotonCargar() {
                var faltan = [];
                var emp = $('#idEmpresaSeleccionada').val();
                if (!emp || emp === '0')            faltan.push(_datosMsg.faltaEmpresa);
                if (!$('#selectAnio').val())        faltan.push(_datosMsg.faltaAnio);
                if (!fileInput[0].files.length)     faltan.push(_datosMsg.faltaArchivo);

                var ok = faltan.length === 0;
                btnCargar.prop('disabled', !ok);
                if (ok) {
                    $('#cargaHint').removeClass('show');
                } else {
                    $('#cargaHintTexto').text(_datosMsg.faltan + ' ' + faltan.join(', '));
                    $('#cargaHint').addClass('show');
                }
            }
            estadoBotonCargar();

            // ── Selector de año ──────────────────────────────────────────────────
            $('#idEmpresaSeleccionada').on('change', function () {
                var idEmpresa = $(this).val();
                var divAnio = $('#divSelectAnio');
                var selectAnio = $('#selectAnio');

                // Reset
                selectAnio.html('<option value="">' + _datosMsg.selectAnio + '</option>');
                $('#modoSeleccionado').val('');
                divAnio.hide();
                var empresaOk = !!idEmpresa && idEmpresa !== '0';
                $('#btnPlantillaConDatos').prop('disabled', !empresaOk);
                actualizarTipPlantillaDatos(empresaOk);
                estadoBotonCargar();

                if (!idEmpresa || idEmpresa === '0') return;

                $('#loadingAnios').show();
                divAnio.show();

                $.get('@Url.Action("ObtenerAnosDisponibles", "Datos")', { idEmpresa: idEmpresa })
                    .done(function (data) {
                        $('#loadingAnios').hide();
                        if (data.success) {
                            var html = '<option value="">' + _datosMsg.selectAnio + '</option>';
                            html += '<optgroup label="' + _datosMsg.anioEjecucion + '">';
                            html += '<option value="' + data.anioEjecucion + '" data-modo="ejecucion">' + data.anioEjecucion + ' &mdash; ' + _datosMsg.anioEjecucion + '</option>';
                            html += '</optgroup>';
                            if (data.anosHistoricos && data.anosHistoricos.length > 0) {
                                html += '<optgroup label="' + _datosMsg.anosHistoricos + '">';
                                $.each(data.anosHistoricos, function (i, ano) {
                                    html += '<option value="' + ano + '" data-modo="historico">' + ano + ' &mdash; ' + _datosMsg.historico + '</option>';
                                });
                                html += '</optgroup>';
                            }
                            selectAnio.html(html);
                        } else {
                            divAnio.hide();
                            Swal.fire({ icon: 'warning', html: '<b>' + _datosMsg.configIncompleta + '</b><br>' + (data.message || _datosMsg.errorCargarAnios) });
                        }
                    })
                    .fail(function () {
                        $('#loadingAnios').hide();
                        divAnio.hide();
                    });
            });

            $('#selectAnio').on('change', function () {
                var modo = $(this).find(':selected').data('modo') || '';
                $('#modoSeleccionado').val(modo);
                estadoBotonCargar();
            });

            // ── Drop Zone ────────────────────────────────────────────────────────
            // Click en zona de drop abre selector de archivos
            dropZone.on('click', function () {
                fileInput[0].click();
            });

            // Drag & Drop
            dropZone.on('dragover', function (e) {
                e.preventDefault();
                e.stopPropagation();
                $(this).css({
                    'border-color': '#583AFF',
                    'background': '#eef2ff'
                });
            });

            dropZone.on('dragleave', function (e) {
                e.preventDefault();
                e.stopPropagation();
                $(this).css({
                    'border-color': '#d1d5db',
                    'background': 'white'
                });
            });

            dropZone.on('drop', function (e) {
                e.preventDefault();
                e.stopPropagation();
                $(this).css({
                    'border-color': '#d1d5db',
                    'background': 'white'
                });

                var files = e.originalEvent.dataTransfer.files;
                if (files.length > 0) {
                    fileInput[0].files = files;
                    actualizarArchivo(files[0]);
                }
            });

            // Cambio de archivo via input
            fileInput.on('change', function () {
                if (this.files.length > 0) {
                    actualizarArchivo(this.files[0]);
                }
            });

            function actualizarArchivo(file) {
                var ext = file.name.split('.').pop().toLowerCase();
                if (ext !== 'xlsx' && ext !== 'xlsm') {
                    Swal.fire({
                        icon: 'warning',
                        title: _datosMsg.formatoInvalido,
                        text: _datosMsg.soloXlsx
                    });
                    return;
                }

                var sizeMB = (file.size / (1024 * 1024)).toFixed(2);
                $('#dropText').html('<i class="fas fa-file-excel" style="color: #10b981; margin-right: 6px;"></i>' + file.name);
                $('#dropSubtext').text(sizeMB + ' MB');
                dropZone.css({
                    'border-color': '#10b981',
                    'background': '#f0fdf4'
                });
                btnLimpiar.show();
                estadoBotonCargar();
            }

            // Quitar archivo
            btnLimpiar.on('click', function (e) {
                e.stopPropagation();
                fileInput.val('');
                $('#dropText').text(_datosMsg.dropText);
                $('#dropSubtext').text(_datosMsg.dropSubtext);
                dropZone.css({
                    'border-color': '#d1d5db',
                    'background': 'white'
                });
                btnLimpiar.hide();
                estadoBotonCargar();
            });

            // Abrir modal instructivo
            $('#btnInstructivo').on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                $('#instructivoModal').modal('show');
            });

            // ── Confirmación antes de cargar ─────────────────────────────────────
            $('#formCarga').on('submit', function (e) {
                e.preventDefault();
                var form = this;

                // Validar empresa
                var empresa = $('#idEmpresaSeleccionada').val();
                if (!empresa || empresa === '0') {
                    Swal.fire({
                        icon: 'warning',
                        title: _datosMsg.empresaRequerida,
                        text: _datosMsg.seleccionarEmpresa
                    });
                    return;
                }

                // Validar año
                var anio = $('#selectAnio').val();
                if (!anio) {
                    Swal.fire({
                        icon: 'warning',
                        html: '<b>' + _datosMsg.anioRequerido + '</b><br>' + _datosMsg.seleccionarAnio
                    });
                    return;
                }

                var modo = $('#modoSeleccionado').val();
                var esEjecucion = modo === 'ejecucion';
                var empresaNombre = $('#idEmpresaSeleccionada option:selected').text();
                var modoBadge = esEjecucion
                    ? '<span style="display:inline-flex;align-items:center;gap:.35rem;background:rgba(16,185,129,.16);color:#34d399;border:1px solid rgba(16,185,129,.32);border-radius:999px;padding:.15rem .65rem;font-size:.82rem;font-weight:600;"><i class="fas fa-play-circle"></i>' + _datosMsg.modoEjecucion.replace(':', '') + '</span>'
                    : '<span style="display:inline-flex;align-items:center;gap:.35rem;background:rgba(245,158,11,.16);color:#fbbf24;border:1px solid rgba(245,158,11,.32);border-radius:999px;padding:.15rem .65rem;font-size:.82rem;font-weight:600;"><i class="fas fa-history"></i>' + _datosMsg.modoHistorico.replace(':', '') + '</span>';

                var filaResumen = function (icono, etiqueta, valor) {
                    return '<div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.6rem 0;">' +
                           '<span style="color:rgba(255,255,255,.5);font-size:.85rem;white-space:nowrap;"><i class="fas ' + icono + '" style="width:16px;margin-right:.5rem;opacity:.8;"></i>' + etiqueta + '</span>' +
                           '<span style="color:#fff;font-size:.9rem;font-weight:600;text-align:right;">' + valor + '</span></div>';
                };

                Swal.fire({
                    icon: 'warning',
                    title: _datosMsg.confirmarCarga,
                    html: '<p style="color:rgba(255,255,255,.66);font-size:.9rem;line-height:1.5;margin:.25rem 0 1rem;">' +
                              '<strong style="color:#fbbf24;font-weight:600;">' + _datosMsg.confirmarBold + '</strong> ' + _datosMsg.confirmarRest +
                          '</p>' +
                          '<div style="background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:.35rem 1rem;text-align:left;">' +
                              filaResumen('fa-building', _datosMsg.empresaLabel.replace(':', ''), empresaNombre) +
                              '<div style="height:1px;background:rgba(255,255,255,.07);"></div>' +
                              filaResumen('fa-calendar-alt', _datosMsg.anioLabel.replace(':', ''), anio) +
                              '<div style="height:1px;background:rgba(255,255,255,.07);"></div>' +
                              filaResumen('fa-cog', _datosMsg.modo, modoBadge) +
                          '</div>' +
                          '<p style="color:rgba(255,255,255,.8);font-size:.92rem;font-weight:600;margin:1.1rem 0 0;">' + _datosMsg.confirmarPregunta + '</p>',
                    width: 460,
                    customClass: { popup: 'swal-carga-compact' },
                    showCancelButton: true,
                    reverseButtons: true,
                    focusCancel: true,
                    confirmButtonText: '<i class="fas fa-upload mr-2"></i>' + _datosMsg.siCargar,
                    cancelButtonText: _datosMsg.cancelar
                }).then(function (result) {
                    if (result.isConfirmed) {
                        btnCargar.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-2"></i>' + _datosMsg.procesando);

                        // Mostrar overlay y arrancar temporizador
                        var overlay = document.getElementById('overlayProcesando');
                        overlay.style.display = 'flex';
                        var segundos = 0;
                        var timerInterval = setInterval(function () {
                            segundos++;
                            var m = Math.floor(segundos / 60);
                            var s = segundos % 60;
                            document.getElementById('overlayTimer').textContent =
                                m > 0 ? m + 'm ' + s + 's' : s + 's';
                        }, 1000);

                        // Guardar el interval en el form por si acaso se necesita limpiar
                        $(form).data('timerInterval', timerInterval);
                        form.submit();
                    }
                });
            });

            // ── Descargar plantilla con los datos actuales ───────────────────────
            var $modalPcd = $('#modalPlantillaConDatos');

            function actualizarBotonPcd() {
                $('#btnPcdDescargar').prop('disabled', $('#pcdListaAnios .pcd-anio:checked').length === 0);
            }

            $('#btnPlantillaConDatos').on('click', function () {
                var idEmpresa = $('#idEmpresaSeleccionada').val();
                if (!idEmpresa || idEmpresa === '0') return;

                $('#pcdListaAnios').html('<div style="padding:.6rem .2rem;color:#94a3b8;"><i class="fas fa-spinner fa-spin mr-2"></i></div>');
                $('#pcdSinAnios').hide();
                $('#pcdTodos').prop('checked', false).prop('disabled', true);
                $('#btnPcdDescargar').prop('disabled', true);
                $modalPcd.modal('show');

                $.get(_pcdUrls.anios, { idEmpresa: idEmpresa })
                    .done(function (data) {
                        if (!data.success || !data.anios || data.anios.length === 0) {
                            $('#pcdListaAnios').empty();
                            $('#pcdSinAnios').text((data && data.message) ? data.message : _pcdMsg.sinAnios).show();
                            return;
                        }
                        var html = '';
                        $.each(data.anios, function (i, a) {
                            html += '<label class="pcd-anio-row" style="display:flex;align-items:center;gap:.6rem;padding:.45rem .2rem;cursor:pointer;">' +
                                        '<input type="checkbox" class="pcd-anio" value="' + a.anio + '">' +
                                        '<span style="font-weight:600;">' + a.anio + '</span>' +
                                        '<span class="info-badge" style="margin-left:auto;">' + Number(a.registros).toLocaleString() + ' ' + _pcdMsg.registros + '</span>' +
                                    '</label>';
                        });
                        $('#pcdListaAnios').html(html);
                        $('#pcdTodos').prop('disabled', false);
                    })
                    .fail(function () {
                        $('#pcdListaAnios').empty();
                        $('#pcdSinAnios').text(_pcdMsg.errorGenerico).show();
                    });
            });

            $('#pcdTodos').on('change', function () {
                $('#pcdListaAnios .pcd-anio').prop('checked', this.checked);
                actualizarBotonPcd();
            });

            $('#pcdListaAnios').on('change', '.pcd-anio', function () {
                var total = $('#pcdListaAnios .pcd-anio').length;
                var marcados = $('#pcdListaAnios .pcd-anio:checked').length;
                $('#pcdTodos').prop('checked', total > 0 && marcados === total);
                actualizarBotonPcd();
            });

            $('#btnPcdDescargar').on('click', function () {
                var idEmpresa = $('#idEmpresaSeleccionada').val();
                var anios = $('#pcdListaAnios .pcd-anio:checked').map(function () { return this.value; }).get();
                if (!idEmpresa || anios.length === 0) return;

                $modalPcd.modal('hide');

                var overlay = document.getElementById('overlayProcesando');
                var overlayTitulo = document.getElementById('overlayTitulo');
                overlayTitulo.textContent = _pcdMsg.generando;
                overlay.style.display = 'flex';
                var segundos = 0;
                var timer = setInterval(function () {
                    segundos++;
                    var m = Math.floor(segundos / 60), s = segundos % 60;
                    document.getElementById('overlayTimer').textContent = m > 0 ? m + 'm ' + s + 's' : s + 's';
                }, 1000);

                function cerrarOverlay() {
                    clearInterval(timer);
                    overlay.style.display = 'none';
                    overlayTitulo.textContent = _datosMsg.procesando;
                }

                var url = _pcdUrls.descargar + '?idEmpresa=' + encodeURIComponent(idEmpresa) +
                          '&anios=' + encodeURIComponent(anios.join(','));

                fetch(url)
                    .then(function (r) {
                        var ct = r.headers.get('Content-Type') || '';
                        if (ct.indexOf('application/json') >= 0) {
                            return r.json().then(function (d) { return { error: (d && d.error) ? d.error : _pcdMsg.errorGenerico }; });
                        }
                        var cd = r.headers.get('Content-Disposition') || '';
                        var mm = cd.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
                        var filename = mm ? mm[1].replace(/['"]/g, '') : 'PlantillaConDatos.xlsx';
                        return r.blob().then(function (b) { return { blob: b, filename: filename }; });
                    })
                    .then(function (res) {
                        cerrarOverlay();
                        if (res.error) { Swal.fire({ icon: 'warning', text: res.error }); return; }
                        var u = window.URL.createObjectURL(res.blob);
                        var a = document.createElement('a');
                        a.href = u;
                        a.download = res.filename;
                        document.body.appendChild(a);
                        a.click();
                        document.body.removeChild(a);
                        window.URL.revokeObjectURL(u);
                    })
                    .catch(function () {
                        cerrarOverlay();
                        Swal.fire({ icon: 'error', text: _pcdMsg.errorGenerico });
                    });
            });
        });

        // Filtro de búsqueda del instructivo (guía por hoja)
        function filtrarPestanas() {
            var campo = document.getElementById('busquedaPestanas');
            var q = (campo ? campo.value : '').trim().toUpperCase();
            var items = document.querySelectorAll('#accordionPestanas .instr-item');
            var visibles = 0;

            items.forEach(function (item) {
                var texto = (item.getAttribute('data-hoja') || item.textContent || '').toUpperCase();
                var coincide = texto.indexOf(q) !== -1;
                item.classList.toggle('oculto', !coincide);
                if (coincide) {
                    visibles++;
                } else {
                    var collapse = item.querySelector('.collapse.show');
                    if (collapse) { $(collapse).collapse('hide'); }
                }
            });

            var vacio = document.getElementById('pestanasSinResultados');
            if (vacio) { vacio.style.display = (visibles === 0 && q !== '') ? 'block' : 'none'; }
        }

        // Al cerrar el modal: limpiar buscador y volver al estado inicial de las secciones
        $('#instructivoModal').on('hidden.bs.modal', function () {
            var campo = document.getElementById('busquedaPestanas');
            if (campo) { campo.value = ''; filtrarPestanas(); }
            $('#accordionPestanas .collapse.show').collapse('hide');
            $('#collapseInstructivo').collapse('hide');
            $('#collapsePestanas').collapse('show');
        });
    </script>
}
