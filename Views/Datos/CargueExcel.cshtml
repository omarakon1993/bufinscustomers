@section scripts {
    <script>
        $(document).ready(function () {
            var dropZone = $('#dropZone');
            var fileInput = $('#archivoExcel');
            var btnCargar = $('#btnCargar');
            var btnLimpiar = $('#btnLimpiar');

            // Click en zona de drop abre selector de archivos
            dropZone.on('click', function () {
                fileInput[0].click();
            });

            // Drag & Drop
            dropZone.on('dragover', function (e) {
                e.preventDefault();
                e.stopPropagation();
                $(this).css({
                    'border-color': '#6366F1',
                    'background': '#eef2ff'
                });
            });

            dropZone.on('dragleave', function (e) {
                e.preventDefault();
                e.stopPropagation();
                $(this).css({
                    'border-color': '#d1d5db',
                    'background': 'white'
                });
            });

            dropZone.on('drop', function (e) {
                e.preventDefault();
                e.stopPropagation();
                $(this).css({
                    'border-color': '#d1d5db',
                    'background': 'white'
                });

                var files = e.originalEvent.dataTransfer.files;
                if (files.length > 0) {
                    fileInput[0].files = files;
                    actualizarArchivo(files[0]);
                }
            });

            // Cambio de archivo via input
            fileInput.on('change', function () {
                if (this.files.length > 0) {
                    actualizarArchivo(this.files[0]);
                }
            });

            function actualizarArchivo(file) {
                var ext = file.name.split('.').pop().toLowerCase();
                if (ext !== 'xlsx' && ext !== 'xlsm') {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Formato no v\u00e1lido',
                        text: 'Solo se permiten archivos .xlsx o .xlsm'
                    });
                    return;
                }

                var sizeMB = (file.size / (1024 * 1024)).toFixed(2);
                $('#dropText').html('<i class="fas fa-file-excel" style="color: #10b981; margin-right: 6px;"></i>' + file.name);
                $('#dropSubtext').text(sizeMB + ' MB');
                dropZone.css({
                    'border-color': '#10b981',
                    'background': '#f0fdf4'
                });
                btnCargar.prop('disabled', false);
                btnLimpiar.show();
            }

            // Quitar archivo
            btnLimpiar.on('click', function (e) {
                e.stopPropagation();
                fileInput.val('');
                $('#dropText').text('Arrastre su archivo aqu\u00ed o haga clic para seleccionar');
                $('#dropSubtext').text('Formatos permitidos: .xlsx, .xlsm');
                dropZone.css({
                    'border-color': '#d1d5db',
                    'background': 'white'
                });
                btnCargar.prop('disabled', true);
                btnLimpiar.hide();
            });

            // Abrir modal instructivo
            $('#btnInstructivo').on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                $('#instructivoModal').modal('show');
            });

            // Confirmación antes de cargar
            $('#formCarga').on('submit', function (e) {
                e.preventDefault();
                var form = this;

                // Validar empresa
                var empresa = $('#idEmpresaSeleccionada').val();
                if (!empresa || empresa === '0') {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Empresa no seleccionada',
                        text: 'Debe seleccionar una empresa antes de cargar el archivo.'
                    });
                    return;
                }

                Swal.fire({
                    icon: 'warning',
                    title: 'Confirmar carga',
                    html: '<strong>Esta acci\u00f3n eliminar\u00e1 todos los datos existentes</strong> de las tablas Z_ para la empresa seleccionada y los reemplazar\u00e1 con los nuevos datos del Excel.<br><br>\u00bfDesea continuar?',
                    showCancelButton: true,
                    confirmButtonText: 'S\u00ed, cargar datos',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: '#6366F1',
                    cancelButtonColor: '#6c757d'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        btnCargar.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-2"></i>Procesando...');
                        form.submit();
                    }
                });
            });
        });

        // Filtro de búsqueda del instructivo
        function filtrarPestanas() {
            var input = document.getElementById('busquedaPestanas').value.toUpperCase();
            var cards = document.querySelectorAll('#accordionPestanas .card');

            cards.forEach(function (card) {
                var boton = card.querySelector('button');
                if (!boton) return;

                var textoBoton = boton.textContent || boton.innerText;
                var collapse = card.querySelector('.collapse');

                if (textoBoton.toUpperCase().includes(input)) {
                    card.classList.remove('oculto');
                    card.classList.add('visible-con-margen');
                } else {
                    if (collapse && $(collapse).hasClass('show')) {
                        $(collapse).collapse('hide');
                    }
                    card.classList.add('oculto');
                    card.classList.remove('visible-con-margen');
                }
            });
        }

        // Limpiar filtro al cerrar modal
        $('#instructivoModal').on('hidden.bs.modal', function () {
            var input = document.getElementById('busquedaPestanas');
            if (input) {
                input.value = '';
                filtrarPestanas();
            }
        });
    </script>
}
