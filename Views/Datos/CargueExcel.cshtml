@model List<(string nombre, System.Data.DataTable tabla)>

@{
    ViewBag.Title = "CargueExcel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <title>Importar excel</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <script src="~/Assets/js/sweetalert2.all.min.js"></script>
    <script src="~/Assets/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Assets/Scripts/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="~/Assets/css/bootstrap-icons.min.css">

    <style>
        .tabla-scroll {
            max-height: 600px;
            overflow-y: auto;
            padding: 10px;
            border: 1px solid #dee2e6;
            background-color: #fff;
            border-radius: 0.5rem;
        }

        .table-container {
            margin-bottom: 40px;
        }

        .pagination {
            justify-content: center;
        }

            .pagination .page-link {
                padding: 0.375rem 0.65rem;
                min-width: 36px;
                text-align: center;
            }

        #loaderOverlay {
            transition: opacity 0.3s ease;
        }

        .custom-header {
            display: flex;
            align-items: center; /* centra verticalmente */
            justify-content: flex-start; /* deja logo y texto al inicio */
            gap: 340px; /* espacio entre logo y texto */
        }

        .logo-bufins {
            height: 35px;
            width: auto;
        }

        .instructivo-title {
            color: #65efd1;
            font-weight: bold;
            font-size: 1.4rem;
            margin: 0;
        }

        /* === COLORES === */
        :root {
            --color-primario: #583AFF;
            --color-secundario: #01E1D7;
        }

        /* === ENCABEZADO CARD === */
        .card-header {
            background: linear-gradient(90deg, var(--color-primario), var(--color-secundario));
            color: white;
            padding: 1.2rem 1.5rem;
            font-weight: 600;
            font-size: 1.2rem;
        }

        .card-header i {
            margin-right: 8px;
        }

    </style>

</head>
<body>
    <div class="card shadow mb-4 mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-file-earmark-arrow-up"></i> Importación de excel</span>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#instructivoModal">
                    Instructivo dinámico
                </button>
                &nbsp;&nbsp;
                <a href="~/Assets/Plantillas/InstructivoPlantillaCargue.xlsx" download class="btn btn-success btn-sm">
                    Instructivo excel
                </a>
                &nbsp;&nbsp;
                <a href="~/Assets/Plantillas/PlantillaBufins.xlsx" download class="btn btn-success btn-sm">
                    Plantilla
                </a>
            </div>
            <div class="modal fade" id="instructivoModal" tabindex="-1" aria-labelledby="instructivoModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header custom-header">
                            <img src="~/Assets/img/logoBufinsInst.png" alt="Bufins" class="logo-bufins">
                            <h5 class="modal-title instructivo-title" id="instructivoModalLabel">Instructivo de uso</h5>
                        </div>
                        <div class="modal-body" style="color:black;>
                            <p>
                                <i class="bi bi-database-fill text-primary me-2"></i>
                                <strong>Bufins</strong> usa las bases de datos contables como fuentes de información para preparar la información financiera.
                            </p>
                            <p>
                                <i class="bi bi-info-circle-fill text-info me-2"></i>
                                En este instructivo encontrará los parámetros para el diligenciamiento de la información, y así aprovechar las ventajas de este sistema de bases de datos.
                            </p>

                            <p>
                                <button class="btn w-100 text-white fw-bold" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#collapseInstructivo"
                                        aria-expanded="false" aria-controls="collapseInstructivo"
                                        style="background-color: #583AFF !important;">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Para tener en cuenta
                                </button>
                            </p>
                            <div class="collapse" id="collapseInstructivo">
                                <div class="card card-body">
                                    <ol>
                                        <li><i></i> Las hojas de este libro tiene nombres que no pueden ser cambiados</li>
                                        <li><i></i> Ninguna de las hojas de este libro se puede eliminar, ni ocultar</li>
                                        <li><i></i> Conserve el orden de las hojas</li>
                                        <li><i></i> Dentro de cada hoja diligencie la infomación solicitada</li>
                                        <li><i></i> No inserte filas y/o columnas dentro de las hojas porque las bases de datos están prediseñadas para darle a los datos una estructura predeterminada constante para el uso de SQLS y PowerBI</li>
                                        <li><i></i> No cambie títulos en las tablas de datos. Estos están parametrizados de acuerdo con el lenguaje contable y financiero</li>
                                        <li><i></i> No cambie formatos en ninguna celda de este libro</li>
                                        <li><i></i> Los símbolos para los datos son (.) punto  para miles y (,) coma para decimales</li>
                                        <li><i></i> Las celdas no pueden contener espacios ni antes ni al final de su contenido</li>
                                        <li><i></i> No modifique ni reemplace el diseño de tablas de datos. Solo debe agregar los datos sin ningún formato</li>
                                    </ol>
                                </div>
                            </div>

                            <p>
                                <button class="btn w-100 fw-bold" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#collapsePestanas"
                                        aria-expanded="false" aria-controls="collapsePestanas"
                                        style="background-color: #65efd1 !important; color: #fff !important; ">
                                    <i class="bi bi-folder-fill me-2"></i> Así se usan cada una de las pestañas
                                </button>
                            </p>
                            <div class="collapse" id="collapsePestanas">
                                <div class="card card-body">

                                    <style>
                                        .oculto {
                                            display: none !important;
                                            margin: 0 !important; /* Quita espacio cuando está oculta */
                                        }

                                        .visible-con-margen {
                                            display: block !important;
                                            margin-bottom: 0.5rem !important; /* Solo margen a visibles */
                                        }
                                    </style>

                                    <script>
                                        function filtrarPestanas() {
                                            const input = document.getElementById('busquedaPestanas').value.toUpperCase();
                                            const cards = document.querySelectorAll('#accordionPestanas .card');

                                            cards.forEach(card => {
                                                const boton = card.querySelector('button');
                                                if (!boton) return;

                                                const textoBoton = boton.textContent || boton.innerText;
                                                const collapse = card.querySelector('.collapse');

                                                if (textoBoton.toUpperCase().includes(input)) {
                                                    card.classList.remove('oculto');
                                                    card.classList.add('visible-con-margen');
                                                } else {
                                                    // cerrar collapse si estaba abierto
                                                    if (collapse && collapse.classList.contains('show')) {
                                                        const bsCollapse = bootstrap.Collapse.getInstance(collapse);
                                                        if (bsCollapse) bsCollapse.hide();
                                                    }
                                                    card.classList.add('oculto');
                                                    card.classList.remove('visible-con-margen');
                                                }
                                            });
                                        }
                                        const miModal = document.getElementById('instructivoModal');

                                        if (miModal) {
                                            miModal.addEventListener('hidden.bs.modal', () => {
                                                const input = document.getElementById('busquedaPestanas');
                                                if (input) {
                                                    input.value = '';     // Limpia el filtro
                                                    filtrarPestanas();    // Muestra todas las cards
                                                }
                                            });
                                        }
                                    </script>
                                    <div class="mb-3">
                                        <input type="text" class="form-control" id="busquedaPestanas" placeholder="Buscar" onkeyup="filtrarPestanas()">
                                    </div>
                                    <div class="accordion " id="accordionPestanas">
                                        <div class="card shadow-sm mb-2">
                                            <div class="card-header p-0" id="headingBalancePrueba">
                                                <h5 class="mb-0">
                                                    <button class="btn w-100 text-white text-start"
                                                            style="background-color: #583AFF; border:none; padding: 10px 18px; border-radius: 6px;"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#collapseBalancePrueba"
                                                            aria-expanded="false"
                                                            aria-controls="collapseBalancePrueba">
                                                        <i class="bi bi-cash-stack me-2"></i>
                                                        Z_BalancePrueba
                                                    </button>
                                                </h5>
                                            </div>
                                            <div id="collapseBalancePrueba" class="collapse" aria-labelledby="headingBalancePrueba" data-bs-parent="#accordionPestanas">
                                                <div class="card-body" style="padding: 12px 18px;">
                                                    <ul>
                                                        <li>Los datos de <strong>Z_BalancePrueba</strong> deben estar en la misma unidad de medida reportada en <strong>Z_Moneda</strong>.</li>
                                                        <li>La celda <strong>F1</strong> debe ser idéntica a la reportada en <strong>Z_Moneda</strong>.</li>
                                                        <li>El nombre de las empresas deberá estar escrito en forma idéntica a como se reportó en la hoja de <strong>Z_Empresa</strong>.</li>
                                                        <li>El nombre de los países deberá estar escrito en forma idéntica a como se reportó en la hoja de <strong>Z_Paises</strong>.</li>
                                                        <li>En la celda <strong>A1</strong> coloque los datos del balance de prueba (balance de comprobación) respetando el orden de las columnas. Esta información deberá estar por tres años y por meses, comenzando por el año actual y los dos años anteriores para las empresas y países que se vayan a consolidar.</li>
                                                        <li>El <strong>Z_BalancePrueba</strong> debe estar a 1, 2, 4 y 6 dígitos del PUC.</li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="accordion " id="accordionPestanas">
                                        <div class="card shadow-sm mb-2">
                                            <div class="card-header p-0" id="headingCteYnoCte">
                                                <h5 class="mb-0">
                                                    <button class="btn w-100 text-white text-start"
                                                            style="background-color: #583AFF; border:none; padding: 10px 18px; border-radius: 6px;"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#collapseCteYnoCte"
                                                            aria-expanded="false"
                                                            aria-controls="collapseCteYnoCte">
                                                        <i class="bi bi-journal-text me-2"></i>
                                                        Z_CteYnoCte
                                                    </button>
                                                </h5>
                                            </div>
                                            <div id="collapseCteYnoCte" class="collapse" aria-labelledby="headingCteYnoCte" data-bs-parent="#accordionPestanas">
                                                <div class="card-body" style="padding: 12px 18px;">
                                                    <ul>
                                                        <li>Aplican las mismas instrucciones de la hoja <strong>Z_BalancePrueba</strong> a 4 dígitos del PUC, para las cuentas de activos y pasivos que deben clasificarse como de carácter corriente y no corriente.</li>
                                                        <li>En la columna <strong>K</strong> deberá indicar si el activo o el pasivo es corriente o no corriente, para lo cual deberá usar la descripción de <strong>Z_Categorias</strong> usando la lista desplegable.</li>
                                                        <li>Las cuentas <strong>Z_CteYnoCte</strong> deben estar a 4 dígitos del PUC.</li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="accordion " id="accordionPestanas">
                                        <div class="card shadow-sm mb-2">
                                            <div class="card-header p-0" id="headingPYGDetallado">
                                                <h5 class="mb-0">
                                                    <button class="btn w-100 text-white text-start"
                                                            style="background-color: #583AFF; border:none; padding: 10px 18px; border-radius: 6px;"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#collapsePYGDetallado"
                                                            aria-expanded="false"
                                                            aria-controls="collapsePYGDetallado">
                                                        <i class="bi bi-journal-code me-2"></i>
                                                        Z_PYGDetallado
                                                    </button>
                                                </h5>
                                            </div>
                                            <div id="collapsePYGDetallado" class="collapse" aria-labelledby="headingPYGDetallado" data-bs-parent="#accordionPestanas">
                                                <div class="card-body" style="padding: 12px 18px;">
                                                    <ul>
                                                        <li>Los datos de <strong>Z_PYGDetallado</strong> deben estar en la misma unidad de medida reportada en <strong>Z_Moneda</strong>.</li>
                                                        <li>La celda <strong>E (Nuevo saldo)</strong> debe ser idéntica a la reportada en <strong>Z_Moneda</strong>.</li>
                                                        <li>El nombre de las empresas deberá estar escrito en forma idéntica a como se reportó en la hoja de <strong>Z_Empresa</strong>.</li>
                                                        <li>El nombre de los países deberá estar escrito en forma idéntica a como se reportó en la hoja de <strong>Z_Paises</strong>.</li>
                                                        <li>En la celda <strong>A1</strong> coloque los datos del estado de resultados a 6 dígitos del PUC, respetando el orden de las columnas. Esta información deberá estar por tres años y por meses, comenzando por el año actual y los dos años anteriores para las empresas y países que se vayan a consolidar.</li>
                                                        <li>En la columna <strong>C (Tipo)</strong> coloque el nombre de las líneas de venta que se hayan definido previamente. Estos nombres deberán ser siempre idénticos a la forma en que se reportarán en las bases de datos.</li>
                                                        <li>En la columna <strong>D (Línea de negocio)</strong> coloque el nombre de las líneas de negocio que se hayan definido previamente. Estos nombres deberán ser siempre idénticos a la forma en que se reportarán en las bases de datos.</li>
                                                        <li>En la columna <strong>J (Ajuste1)</strong> indique si el ingreso o el gasto se considera parte del Ebitda o no hace parte de él. Debe indicar siempre: <strong>Ebitda</strong> o <strong>No Ebitda</strong> usando la lista desplegable.</li>
                                                        <li>
                                                            En la columna <strong>K (Ajuste2)</strong> coloque la clasificación de los costos y los gastos según su naturaleza usando la lista desplegable:
                                                            <ul>
                                                                <li>GASTOS FIJOS</li>
                                                                <li>GASTOS VARIABLES</li>
                                                                <li>OTROS GASTOS</li>
                                                            </ul>
                                                        </li>
                                                        <li>Las cuentas de <strong>Z_PYGDetallado</strong> deben estar a 6 dígitos del PUC.</li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="accordion " id="accordionPestanas">
                                        <div class="card shadow-sm mb-2">
                                            <div class="card-header p-0" id="headingPYGDetalladoConAjuste">
                                                <h5 class="mb-0">
                                                    <button class="btn w-100 text-white text-start"
                                                            style="background-color: #583AFF; border:none; padding: 10px 18px; border-radius: 6px;"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#collapsePYGDetalladoConAjuste"
                                                            aria-expanded="false"
                                                            aria-controls="collapsePYGDetalladoConAjuste">
                                                        <i class="bi bi-graph-up me-2"></i>
                                                        Z_PYGDetalladoConAjuste
                                                    </button>
                                                </h5>
                                            </div>
                                            <div id="collapsePYGDetalladoConAjuste" class="collapse" aria-labelledby="headingPYGDetalladoConAjuste" data-bs-parent="#accordionPestanas">
                                                <div class="card-body" style="padding: 12px 18px;">
                                                    Esta hoja es idéntica a la de Z_PYGDetallado. La única diferencia es que podrá reclasificar ingresos, costos y gastos para ottener el Ebitda Ajustado
                                                    Las cuentas Z_PYGDetalladoConAjuste deben estar a 6 dígitos del PUC
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="accordion " id="accordionPestanas">
                                        <div class="card shadow-sm mb-2">
                                            <div class="card-header p-0" id="headingPresupuestoBalance">
                                                <h5 class="mb-0">
                                                    <button class="btn w-100 text-white text-start"
                                                            style="background-color: #583AFF; border:none; padding: 10px 18px; border-radius: 6px;"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#collapsePresupuestoBalance"
                                                            aria-expanded="false"
                                                            aria-controls="collapsePresupuestoBalance">
                                                        <i class="bi bi-graph-up-arrow me-2"></i>
                                                        Z_PresupuestoBalance
                                                    </button>
                                                </h5>
                                            </div>
                                            <div id="collapsePresupuestoBalance" class="collapse" aria-labelledby="headingPresupuestoBalance" data-bs-parent="#accordionPestanas">
                                                <div class="card-body" style="padding: 12px 18px;">
                                                    En esta hoja se debe reportar el presupuesto de la compañía por cuentas de balance a 1. 2, 4 y 6 dígitos del PUC. En caso de no tener presupuesto de balance se debe dejar en blanco
                                                    Las cuentas de Z_Presupuesto deben estar a 6 dígitos del PUC
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="accordion " id="accordionPestanas">
                                        <div class="card shadow-sm mb-2">
                                            <div class="card-header p-0" id="headingPptoPYGDetallado">
                                                <h5 class="mb-0">
                                                    <button class="btn w-100 text-white text-start"
                                                            style="background-color: #583AFF; border:none; padding: 10px 18px; border-radius: 6px;"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#collapsePptoPYGDetallado"
                                                            aria-expanded="false"
                                                            aria-controls="collapsePptoPYGDetallado">
                                                        <i class="bi bi-piggy-bank-fill me-2"></i>
                                                        Z_PptoPYGDetallado
                                                    </button>
                                                </h5>
                                            </div>
                                            <div id="collapsePptoPYGDetallado" class="collapse" aria-labelledby="headingPptoPYGDetallado" data-bs-parent="#accordionPestanas">
                                                <div class="card-body" style="padding: 12px 18px;">
                                                    Este es el presupuesto detallado discriminado por tipo y Líneas de negocio. La estructura de esta hoja es igual a la Z_PYGDetallado
                                                    Las cuentas de Z_PresupuestoDetallado deben estar a 6 dígitos del PUC
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="accordion " id="accordionPestanas">
                                        <div class="card shadow-sm mb-2">
                                            <div class="card-header p-0" id="headingPptoPYGDetalladoConAjuste">
                                                <h5 class="mb-0">
                                                    <button class="btn w-100 text-white text-start"
                                                            style="background-color: #583AFF; border:none; padding: 10px 18px; border-radius: 6px;"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#collapsePptoPYGDetalladoConAjuste"
                                                            aria-expanded="false"
                                                            aria-controls="collapsePptoPYGDetalladoConAjuste">
                                                        <i class="bi bi-cash-coin me-2"></i>
                                                        Z_PptoPYGDetalladoConAjuste
                                                    </button>
                                                </h5>
                                            </div>
                                            <div id="collapsePptoPYGDetalladoConAjuste" class="collapse" aria-labelledby="headingPptoPYGDetalladoConAjuste" data-bs-parent="#accordionPestanas">
                                                <div class="card-body" style="padding: 12px 18px;">
                                                    Este es el presupuesto detallado discriminado por tipo y Líneas de negocio. La estructura de esta hoja es igual a la Z_PYGDetalladoConAjuste
                                                    Las cuentas de Z_PresupuestoDetalladoConAjuste deben estar a 6 dígitos del PUC
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="accordion " id="accordionPestanas">
                                        <div class="card shadow-sm mb-2">
                                            <div class="card-header p-0" id="headingPCH">
                                                <h5 class="mb-0">
                                                    <button class="btn w-100 text-white text-start"
                                                            style="background-color: #583AFF; border:none; padding: 10px 18px; border-radius: 6px;"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#collapsePCH"
                                                            aria-expanded="false"
                                                            aria-controls="collapsePCH">
                                                        <i class="bi bi-cash-coin me-2"></i>
                                                        Z_PCH
                                                    </button>
                                                </h5>
                                            </div>
                                            <div id="collapsePCH" class="collapse" aria-labelledby="headingPCH" data-bs-parent="#accordionPestanas">
                                                <div class="card-body" style="padding: 12px 18px;">
                                                    Las cuentas de Z_PCH deben estar a de 4 a 6 dígitos del PUC y corresponden a las indicadas en la hoja
                                                    Los valores de Z_PCH equivalen a los ahorros que se estiman como objetivos
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="accordion " id="accordionPestanas">
                                        <div class="card shadow-sm mb-2">
                                            <div class="card-header p-0" id="headingEjecPCH">
                                                <h5 class="mb-0">
                                                    <button class="btn w-100 text-white text-start"
                                                            style="background-color: #583AFF; border:none; padding: 10px 18px; border-radius: 6px;"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#collapseEjecPCH"
                                                            aria-expanded="false"
                                                            aria-controls="collapseEjecPCH">
                                                        <i class="bi bi-flag-fill me-2"></i>
                                                        Z_EjecPCH
                                                    </button>
                                                </h5>
                                            </div>
                                            <div id="collapseEjecPCH" class="collapse" aria-labelledby="headingEjecPCH" data-bs-parent="#accordionPestanas">
                                                <div class="card-body" style="padding: 12px 18px;">
                                                    Las cuentas de Z_EjecPCH deben estar a de 4 a 6 dígitos del PUC
                                                    Las cuentas de Z_EjecPCH deben estar a de 4 a 6 dígitos del PUC y equivalen a los ahorros que ejecutados
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="accordion " id="accordionPestanas">
                                        <div class="card shadow-sm mb-2">
                                            <div class="card-header p-0" id="headingTablaPUC">
                                                <h5 class="mb-0">
                                                    <button class="btn w-100 text-white text-start"
                                                            style="background-color: #583AFF; border:none; padding: 10px 18px; border-radius: 6px;"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#collapseTablaPUC"
                                                            aria-expanded="false"
                                                            aria-controls="collapseTablaPUC">
                                                        <i class="bi bi-journal-bookmark-fill me-2"></i>
                                                        Z_TablaPUC
                                                    </button>
                                                </h5>
                                            </div>
                                            <div id="collapseTablaPUC" class="collapse" aria-labelledby="headingTablaPUC" data-bs-parent="#accordionPestanas">
                                                <div class="card-body" style="padding: 12px 18px;">
                                                    Este es el PUC de Colombia
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <div class="ui segment">
                    <div class="field">
                        <input type="hidden" name="MAX_FILE_SIZE" value="100000" />
                        @using (Html.BeginForm("CargarExcel", "Datos", FormMethod.Post, new { enctype = "multipart/form-data", @id = "formCarga" }))
                        {
                            <div class="ps-4 mb-3">

                                @if (!string.IsNullOrEmpty(ViewBag.UltimoUsuarioCargue))
                                {
                                    <div class="alert alert-info mb-3">
                                        @ViewBag.UltimoUsuarioCargue
                                    </div>
                                }

                                <!-- Selector de Empresa -->
                                <div class="form-group mb-3">
                                    <label for="idEmpresaSeleccionada" class="form-label"><strong>Empresa a cargar:</strong></label>
                                    <select class="form-control form-control-sm" id="idEmpresaSeleccionada" name="idEmpresaSeleccionada" required>
                                        <option value="0">Seleccione una empresa...</option>
                                        @if (ViewBag.Empresas != null)
                                        {
                                            foreach (var empresa in ViewBag.Empresas)
                                            {
                                                <option value="@empresa.Id">@empresa.Nombre</option>
                                            }
                                        }
                                    </select>
                                </div>

                                <div class="d-flex align-items-center gap-3">

                                    <div class="form-group mb-0">
                                        <input type="file" class="form-control-file form-control-sm" id="archivoExcel" name="archivoExcel">
                                    </div>

                                    <input type="button" name="accion" value="Validar" class="btn btn-primary btn-sm" onclick="validarArchivo();" />

                                    @if (TempData["MostrarBotonImportar"] != null && (bool)TempData["MostrarBotonImportar"])
                                    {
                                        <input type="button" name="accion" value="Importar" id="btnImportar" style="margin-left: 20px;" class="btn btn-success btn-sm" />

                                        <form method="get" action="@Url.Action("CargueExcel", "Datos")" class="mb-0">
                                            <input type="hidden" name="limpiar" value="true" />
                                            <button type="submit" class="btn btn-outline-secondary btn-sm" title="Limpiar validación" style="margin-left: 20px;">
                                                Limpiar validación
                                            </button>
                                        </form>
                                    }

                                    <button type="submit" id="btnSubmitOculto" style="display: none;" name="accion" value="RetornoTablaDeDatos"></button>

                                </div>
                            </div>

                        }

                        <div id="loaderOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5); z-index: 9999; align-items: center; justify-content: center;">
                            <div class="spinner-border text-light" role="status" style="width: 4rem; height: 4rem;">
                            </div>
                        </div>

                        <script>
                            document.addEventListener("DOMContentLoaded", function () {
                                const btn = document.getElementById("btnImportar");
                                if (btn) {
                                    btn.addEventListener("click", function () {
                                        if (confirm("¿Estás seguro de que deseas importar los datos?")) {
                                            const form = document.getElementById("formCarga");
                                            let inputAccion = document.createElement("input");
                                            inputAccion.type = "hidden";
                                            inputAccion.name = "accion";
                                            inputAccion.value = "Importar";
                                            form.appendChild(inputAccion);

                                            document.getElementById('loaderOverlay').style.display = 'flex';
                                            setTimeout(() => {
                                                form.submit();
                                            }, 300);
                                        } else {
                                            fetch('/Datos/LimpiarDatosImportacion', {
                                                method: 'POST'
                                            }).then(response => {
                                                if (response.redirected) {
                                                    window.location.href = response.url;
                                                }
                                            });
                                        }
                                    });
                                }
                            });
                        </script>

                        <script src="~/Assets/js/xlsx.full.min.js"></script>
                        <script>

                            function mostrarErrorValidacion(mensaje) {
                                // Mostrar el mensaje de error
                                const div = document.getElementById('mensajeErrorTabla');
                                div.innerHTML = `<div class="alert alert-danger" role="alert">${mensaje}</div>`;

                                // Ocultar el mensaje "No hay datos para mostrar"
                                const mensajeVacio = document.getElementById('mensajeSinDatos');
                                if (mensajeVacio) {
                                    mensajeVacio.style.display = 'none';
                                }

                                // Ocultar o eliminar datos actuales si existen
                                const contenedorTablas = document.getElementById('contenedorTablas');
                                if (contenedorTablas) contenedorTablas.remove();

                            }

                            async function validarArchivo() {
                                // Validar que se haya seleccionado una empresa
                                const empresaSelect = document.getElementById('idEmpresaSeleccionada');
                                if (!empresaSelect || empresaSelect.value === '0') {
                                    Swal.fire({
                                        icon: 'warning',
                                        title: 'Empresa no seleccionada',
                                        text: 'Debe seleccionar una empresa antes de validar el archivo.'
                                    });
                                    return;
                                }

                                //const btnImportar = document.getElementById('btnImportar');
                                const btnSubmitOculto = document.getElementById('btnSubmitOculto');
                                //btnImportar.style.display = 'none'; // ocultar siempre al inicio


                                const archivo = document.getElementById('archivoExcel').files[0];
                                if (!archivo) {
                                    alert("Debe seleccionar un archivo.");
                                    return;
                                }

                                if (!archivo.name.endsWith('.xlsx')) {
                                    alert("El archivo debe ser .xlsx");
                                    return;
                                }

                                const data = await archivo.arrayBuffer();
                                try {
                                    const workbook = XLSX.read(data, { type: 'array' });

                                    if (workbook.SheetNames.length !== 10) {
                                        //alert("La cantidad de tablas no coincide con las especificadas en la plantilla - BUFINS");
                                        mostrarErrorValidacion("La cantidad de tablas no coincide con las especificadas en la plantilla - BUFINS.");
                                        return;
                                    }

                                    for (let nombreHoja of workbook.SheetNames) {
                                        const sheet = workbook.Sheets[nombreHoja];
                                        const json = XLSX.utils.sheet_to_json(sheet, { header: 1 });

                                        const encabezados = json[0];
                                        if (encabezados.some(h => !h || String(h).trim() === "")) {
                                            alert(`La hoja "${nombreHoja}" tiene columnas vacías.`);
                                            return;
                                        }
                                    }

                                    //alert("¡Validación exitosa!");
                                    //btnImportar.style.display = 'inline-block';

                                    document.getElementById('loaderOverlay').style.display = 'flex';
                                    setTimeout(() => {
                                        btnSubmitOculto.click();
                                    }, 300);

                                    // ✅ Enviar formulario automáticamente
                                    btnSubmitOculto.click();

                                } catch (e) {
                                    alert(e);
                                    //alert("El archivo no se pudo leer. ¿Tiene contraseña?");
                                    //btnImportar.style.display = 'none';
                                }
                            }
                        </script>

                        <script>
                            document.getElementById('formCarga').addEventListener('submit', function () {
                                document.getElementById('progresoWrapper').classList.remove('d-none');
                            });
                        </script>

                        @if (TempData["Mensaje"] != null && TempData["MensajeTipo"] != null)
                        {
                            <script>
                                Swal.fire({
                                    toast: true,
                                    position: window.innerWidth <= 768 ? 'top' : 'top-end',
                                    icon: '@TempData["MensajeTipo"]',
                                    title: '@TempData["Mensaje"]',
                                    showConfirmButton: false,
                                    timer: 3000,
                                    timerProgressBar: true,
                                    didOpen: (toast) => {
                                        toast.addEventListener('mouseenter', Swal.stopTimer);
                                        toast.addEventListener('mouseleave', Swal.resumeTimer);
                                    }
                                });
                            </script>

                            TempData.Remove("Mensaje");
                            TempData.Remove("MensajeTipo");

                        }

                    </div>

                    <div class="tabla-scroll">
                        <div id="contenedorTablas">
                            @if (Model != null && Model.Count > 0)
                            {
                                int tablaIndex = 0;

                                foreach (var tabla in Model)
                                {
                                    <div class="table-container">
                                        <h5 class="mt-4">@tabla.nombre</h5>

                                        <div class="table-responsive">
                                            <table class="table table-striped table-bordered table-sm" id="tabla_@tablaIndex">
                                                <thead class="table-dark">
                                                    <tr>
                                                        @foreach (System.Data.DataColumn col in tabla.tabla.Columns)
                                                        {
                                                            <th>@col.ColumnName</th>
                                                        }
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @{
                                                        int filaIndex = 0;
                                                        foreach (System.Data.DataRow row in tabla.tabla.Rows)
                                                        {
                                                            var clase = (filaIndex >= 100) ? "d-none" : "";
                                                            <tr class="@clase">
                                                                @foreach (var item in row.ItemArray)
                                                                {
                                                                    <td>@item</td>
                                                                }
                                                            </tr>
                                                            filaIndex++;
                                                        }
                                                    }
                                                </tbody>
                                            </table>
                                        </div>

                                        <nav>
                                            <ul class="pagination" data-tabla="@tablaIndex"></ul>
                                        </nav>
                                    </div>

                                    tablaIndex++;
                                }
                            }
                            else
                            {
                                <p id="mensajeSinDatos" class="text-muted">No hay datos para mostrar.</p>
                            }
                        </div>

                        <div id="mensajeErrorTabla" class="mt-3"></div>

                    </div>

                    @section scripts {
                        <script src="~/Assets/js/jquery-3.6.0.min.js"></script>
                        <script>
                            $(function () {
                                const filasPorPagina = 100;

                                $('table').each(function (i, tabla) {
                                    const $tabla = $(tabla);
                                    const $filas = $tabla.find('tbody tr');
                                    //const $filas = $tabla.find('tbody tr').not('.fila-mensaje');
                                    const totalFilas = $filas.length;
                                    const totalPaginas = Math.ceil(totalFilas / filasPorPagina);

                                    const $paginador = $(`<ul class="pagination justify-content-center mt-2 flex-wrap" data-tabla="${i}"></ul>`);
                                    $tabla.after($paginador);

                                    // Scroll para tabla
                                    $tabla.wrap('<div style="max-height: 400px; overflow-y: auto; margin-bottom: 15px;"></div>');

                                    function mostrarPagina(pagina) {
                                        $filas.addClass('d-none');
                                        $filas.slice(pagina * filasPorPagina, (pagina + 1) * filasPorPagina).removeClass('d-none');
                                        renderPaginador(pagina);
                                    }

                                    function crearBoton(pagina, label = null, isActive = false, isDisabled = false) {
                                        const li = $('<li class="page-item ' + (isActive ? 'active' : '') + (isDisabled ? ' disabled' : '') + '"></li>');
                                        const a = $('<a class="page-link" href="#"></a>').text(label || (pagina + 1));
                                        a.on('click', function (e) {
                                            e.preventDefault();
                                            if (!isDisabled) mostrarPagina(pagina);
                                        });
                                        li.append(a);
                                        $paginador.append(li);
                                    }

                                    function crearSeparador() {
                                        const li = $('<li class="page-item disabled"><span class="page-link">...</span></li>');
                                        $paginador.append(li);
                                    }

                                    function renderPaginador(paginaActual) {
                                        $paginador.empty();
                                        let inicio = Math.max(1, paginaActual - 2);
                                        let fin = Math.min(totalPaginas - 2, paginaActual + 2);

                                        // Primera
                                        crearBoton(0, '1', paginaActual === 0);
                                        if (inicio > 1) crearSeparador();

                                        for (let i = inicio; i <= fin; i++) {
                                            crearBoton(i, null, paginaActual === i);
                                        }

                                        if (fin < totalPaginas - 2) crearSeparador();

                                        if (totalPaginas > 1) {
                                            crearBoton(totalPaginas - 1, totalPaginas.toString(), paginaActual === totalPaginas - 1);
                                        }
                                    }

                                    mostrarPagina(0);
                                });
                            });
                        </script>
                    }
                </div>
            </div>
        </div>
    </div>
    @*<script>
            if (window.history.replaceState) {
                window.history.replaceState(null, null, window.location.href);
            }
        </script>*@
</body>
</html>