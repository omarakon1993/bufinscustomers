@model bufinscustomers.Models.ModeloPageViewModel
@using bufinscustomers.Helpers
@{
    ViewBag.Title = "Ejecución de Modelos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var usuario = UsuarioSesionHelper.UsuarioActual;
    var esAdmin = usuario?.Admin == 1 || usuario?.Admin == 2;
    var idEmpresaUsuario = usuario?.IdEmpresa ?? 0;
}

<link href="~/Assets/css/informe-relacionamientos.css" rel="stylesheet" />


<div class="container-fluid px-4">

    <!-- Header -->
    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas fa-cogs powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">Ejecuci&oacute;n de Modelos</h1>
        </div>
    </div>


    <!-- Card principal -->
    <div class="filter-card">
        <h3 class="filter-card-title">
            <i class="fas fa-play-circle"></i>
            Seleccione empresa, a&ntilde;o y modelo
        </h3>

        <form id="modeloForm" method="post" action="@Url.Action("EjecutarModelo", "Datos")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="idModelo" id="idModelo" value="" />

            <div class="filter-section">
                <div class="row g-3">

                    <!-- Empresa -->
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="idEmpresa">
                                <i class="fas fa-building"></i>
                                Empresa <span class="required">*</span>
                            </label>
                            <select class="form-control" id="idEmpresa" name="idEmpresa" required>
                                <option value="">-- Seleccione una empresa --</option>
                                @if (esAdmin)
                                {
                                    foreach (var empresa in Model.Empresas)
                                    {
                                        <option value="@empresa.Id">@empresa.Nombre</option>
                                    }
                                }
                                else
                                {
                                    var emp = Model.Empresas.FirstOrDefault(e => e.Id == idEmpresaUsuario);
                                    if (emp != null)
                                    {
                                        <option value="@emp.Id">@emp.Nombre</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Año -->
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="anio">
                                <i class="fas fa-calendar-alt"></i>
                                A&ntilde;o de ejecuci&oacute;n <span class="required">*</span>
                            </label>
                            <select class="form-control" id="anio" name="anio" required disabled>
                                <option value="">-- Seleccione una empresa primero --</option>
                            </select>
                        </div>
                    </div>

                    <!-- Modelo -->
                    <div class="col-md-8">
                        <div class="form-group">
                            <label for="selectModelo">
                                <i class="fas fa-cog"></i>
                                Modelo <span class="required">*</span>
                            </label>
                            <select class="form-control" id="selectModelo" required>
                                <option value="">-- Seleccione un modelo --</option>
                                @foreach (var m in Model.Modelos)
                                {
                                    <option value="@m.Id"
                                            data-descripcion="@(m.Descripcion ?? "")"
                                            data-icono="@(m.Icono ?? "fas fa-cog")">
                                        @m.Nombre
                                    </option>
                                }
                            </select>
                            <!-- Panel informativo dinámico -->
                            <div id="modeloInfoPanel" class="modelo-info-panel">
                                <i id="modeloIcono" class="fas fa-cog"></i>
                                <span id="modeloDescripcion"></span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Botón -->
            <div class="d-flex align-items-center gap-3 mt-2">
                <button type="submit" id="btnEjecutar" class="btn-modern-gradient" disabled>
                    <i class="fas fa-play me-2"></i>
                    <span id="btnTexto">Ejecutar modelo</span>
                </button>
                <small class="text-muted" id="textoAyuda">
                    <i class="fas fa-info-circle" style="color:#6366F1;"></i>
                    Complete los tres campos para habilitar la ejecuci&oacute;n.
                </small>
            </div>
        </form>
    </div>

</div>

@section scripts {

@if (TempData["SuccessMessage"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: '\u00a1\u00c9xito!',
            text: '@Html.Raw(TempData["SuccessMessage"].ToString().Replace("'", "\\'"))',
            confirmButtonText: 'Aceptar',
            confirmButtonColor: '#6366F1',
            allowOutsideClick: false
        }).then(function () {
            location.reload();
        });
    </script>
}
@if (TempData["ErrorMessage"] != null)
{
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: '@Html.Raw(TempData["ErrorMessage"].ToString().Replace("'", "\\'"))',
            confirmButtonText: 'Aceptar',
            confirmButtonColor: '#6366F1',
            allowOutsideClick: false
        }).then(function () {
            location.reload();
        });
    </script>
}
@if (TempData["InfoMessage"] != null)
{
    <script>
        Swal.fire({
            icon: 'info',
            title: 'Informaci\u00f3n',
            text: '@Html.Raw(TempData["InfoMessage"].ToString().Replace("'", "\\'"))',
            confirmButtonText: 'Aceptar',
            confirmButtonColor: '#6366F1',
            allowOutsideClick: false
        }).then(function () {
            location.reload();
        });
    </script>
}

<script>
    $(function () {

        // ── Cargar año al cambiar empresa ───────────────────────────────
        $('#idEmpresa').on('change', function () {
            var idEmpresa = $(this).val();
            var $anio = $('#anio');

            if (!idEmpresa) {
                $anio.html('<option value="">-- Seleccione una empresa primero --</option>');
                $anio.prop('disabled', true);
                actualizarBoton();
                return;
            }

            $anio.html('<option value="">Cargando...</option>');
            $anio.prop('disabled', true);

            $.ajax({
                url: '/Datos/ObtenerAnioEjecucion',
                type: 'GET',
                data: { idEmpresa: idEmpresa },
                success: function (response) {
                    if (response.success) {
                        $anio.html('<option value="' + response.anioEjecucion + '" selected>' + response.anioEjecucion + '</option>');
                        $anio.prop('disabled', false);
                    } else {
                        $anio.html('<option value="">' + (response.message || 'Sin configuración de año') + '</option>');
                        $anio.prop('disabled', true);
                    }
                    actualizarBoton();
                },
                error: function () {
                    $anio.html('<option value="">Error al cargar el a&ntilde;o</option>');
                    $anio.prop('disabled', true);
                    actualizarBoton();
                }
            });
        });

        $('#anio').on('change', actualizarBoton);

        // ── Actualizar panel descripción al cambiar modelo ───────────────
        $('#selectModelo').on('change', function () {
            var $opt = $(this).find(':selected');
            var val = $(this).val();
            var desc = $opt.data('descripcion');
            var icono = $opt.data('icono') || 'fas fa-cog';

            $('#idModelo').val(val);

            var $panel = $('#modeloInfoPanel');
            if (val && desc) {
                $('#modeloIcono').attr('class', icono);
                $('#modeloDescripcion').text(desc);
                $panel.addClass('visible');
            } else {
                $panel.removeClass('visible');
            }

            actualizarBoton();
        });

        // ── Habilitar/deshabilitar botón ─────────────────────────────────
        function actualizarBoton() {
            var ok = $('#idEmpresa').val() && $('#anio').val() && $('#selectModelo').val();
            var $btn = $('#btnEjecutar');
            var $ayuda = $('#textoAyuda');
            $btn.prop('disabled', !ok);
            $ayuda.toggle(!ok);
        }

        // ── Loading state al hacer submit ────────────────────────────────
        $('#modeloForm').on('submit', function () {
            if (!$('#idModelo').val()) return false;

            var $btn = $('#btnEjecutar');
            $btn.prop('disabled', true);
            $('#btnTexto').text('Ejecutando...');
            $btn.find('i').attr('class', 'spinner-border spinner-border-sm me-2');
        });
    });
</script>
}
