@model bufinscustomers.Models.ModeloPageViewModel
@using bufinscustomers.Helpers
@{
    ViewBag.Title = Resources.Strings.Modelo_PageTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var usuario = UsuarioSesionHelper.UsuarioActual;
    var esAdmin = usuario?.Admin == 1 || usuario?.Admin == 2;
    var idEmpresaUsuario = usuario?.IdEmpresa ?? 0;
}

<link href="~/Assets/css/bufins-components.css" rel="stylesheet" />

<div class="container-fluid px-4 mc-page">

    <!-- Header Power BI -->
    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas fa-database powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@Resources.Strings.Modelo_PageTitle</h1>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <!-- Barra de trabajo -->
    <div class="mc-toolbar">

        <!-- Fila 1: filtros -->
        <div class="mc-toolbar-row">

            <div class="mc-field">
                <label for="idEmpresa">
                    @Resources.Strings.Modelo_LabelEmpresa <span class="required">*</span>
                </label>
                <select class="form-control" id="idEmpresa">
                    <option value="">@Resources.Strings.Modelo_SelectEmpresa</option>
                    @if (esAdmin)
                    {
                        foreach (var empresa in Model.Empresas)
                        {
                            <option value="@empresa.Id" data-nombre="@empresa.Nombre">@empresa.Nombre</option>
                        }
                    }
                    else
                    {
                        var emp = Model.Empresas.FirstOrDefault(e => e.Id == idEmpresaUsuario);
                        if (emp != null)
                        {
                            <option value="@emp.Id" data-nombre="@emp.Nombre">@emp.Nombre</option>
                        }
                    }
                </select>
            </div>

            <!-- Selector unificado: uno o varios modelos (consultar usa el único elegido; exportar/correo usan la selección completa) -->
            <div class="mc-field wide">
                <label>@Resources.Strings.Modelo_LabelModelo <span class="required">*</span></label>
                <div class="mc-multiselect" id="modeloPicker">
                    <button type="button" class="mc-ms-toggle" id="modeloPickerToggle" aria-haspopup="true" aria-expanded="false">
                        <span id="modeloPickerLabel">@Resources.Strings.Modelo_Picker_Placeholder</span>
                        <i class="fas fa-chevron-down"></i>
                    </button>
                    <div class="mc-ms-panel" id="modeloPickerPanel" hidden>
                        <label class="mc-modelo-item mc-modelo-all">
                            <input type="checkbox" id="modeloSelAll">
                            <span>@Resources.Strings.Modelo_Correo_SelTodos</span>
                        </label>
                        @foreach (var m in Model.Modelos)
                        {
                            <label class="mc-modelo-item">
                                <input type="checkbox" class="mc-modelo-pick" value="@m.Id"
                                       data-nombre="@m.Nombre"
                                       data-descripcion="@(m.Descripcion ?? "")"
                                       data-icono="@(m.Icono ?? "fas fa-cog")">
                                <span>@m.Nombre</span>
                            </label>
                        }
                    </div>
                </div>
            </div>

            <div class="mc-field">
                <label for="idEscenario">
                    @Resources.Strings.Modelo_LabelEscenario
                </label>
                <select class="form-control" id="idEscenario">
                    @if (ViewBag.Escenarios != null)
                    {
                        foreach (var escenario in ViewBag.Escenarios)
                        {
                            <option value="@escenario.Id">@escenario.Nombre</option>
                        }
                    }
                </select>
            </div>

            <div class="mc-search" id="mcSearchWrap" style="display:none;">
                <i class="fas fa-search"></i>
                <input type="text" id="filtroResultados" autocomplete="off"
                       placeholder="@Resources.Strings.Modelo_FiltrarResultados">
            </div>
        </div>

        <!-- Fila 2: acciones -->
        <div class="mc-toolbar-row mc-toolbar-acciones">

            <button type="button" id="btnEjecutar" class="mc-btn-primary" disabled onclick="ejecutarModelo()"
                    title="@Resources.Strings.Modelo_Ejecutar_RequiereUno">
                <span class="mc-ico"><i class="fas fa-play mr-1"></i></span><span id="btnTexto">@Resources.Strings.Modelo_BtnEjecutar</span>
            </button>

            <button type="button" id="btnExportarTodos" class="mc-btn-solid excel" disabled
                    onclick="exportarModelos()" title="@Resources.Strings.Modelo_BtnExportTooltip">
                <span class="mc-ico"><i id="btnExportarTodosIcono" class="fas fa-layer-group mr-1"></i></span><span id="btnExportarTodosTexto">@Resources.Strings.Modelo_BtnExportarTodos</span>
            </button>

            <button type="button" id="btnEnviarCorreo" class="mc-btn-solid mail" disabled
                    onclick="abrirModalCorreo()" title="@Resources.Strings.Modelo_BtnEnviarTooltip">
                <span class="mc-ico"><i class="fas fa-paper-plane mr-1"></i></span><span>@Resources.Strings.Modelo_BtnEnviarCorreo</span>
            </button>
        </div>

        <div id="modeloInfoPanel" class="mc-modelo-info" style="display:none;">
            <i id="modeloIcono" class="fas fa-cog mr-1" style="color:#583AFF;"></i>
            <span id="modeloDescripcion"></span>
        </div>
    </div>

    <div id="avisoSinDatosEscenario" class="alert alert-warning d-flex align-items-center" role="alert" style="display:none;border-left: 4px solid #f6c23e;">
        <i class="fas fa-exclamation-triangle mr-3" style="font-size:1.2rem;"></i>
        <div>@Resources.Strings.Modelo_AvisoSinDatosEscenario</div>
    </div>

    <!-- Loading (ejecución AJAX) -->
    <div id="loadingEjecucion" style="display:none;text-align:center;padding:2.5rem;">
        <div class="spinner-border text-primary" style="width:3rem;height:3rem;" role="status"></div>
        <p class="mt-3 text-muted fw-semibold">@Resources.Strings.Modelo_JS_Ejecutando</p>
    </div>

    <!-- Overlay exportación (fetch/blob) -->
    <div id="overlayExportacion" class="overlay-cargando" style="display:none;">
        <div class="overlay-cargando-card">
            @Html.Partial("_LoaderDots", "aqua")
            <h5 id="overlayTitulo" class="overlay-cargando-title">@Resources.Strings.Modelo_JS_ExportandoTodos</h5>
            <p class="overlay-cargando-text mb-0" id="overlayTimerTexto">0s</p>
        </div>
    </div>

    <!-- Estado inicial: aun no se ha ejecutado ninguna consulta -->
    <div id="estadoInicial" class="empty-state-initial">
        <div class="empty-state-initial-icon"><i class="fas fa-table"></i></div>
        <h4>@Resources.Strings.Common_EstadoInicialTitulo</h4>
        <p>@Resources.Strings.Modelo_EstadoInicialDesc</p>
    </div>

    <!-- Resultados del modelo individual -->
    <div id="resultadosSection" style="display:none;">
        <div class="mc-table-card">
            <div class="mc-table-head">
                <i id="resultadosIcono" class="fas fa-table mc-table-head-icon"></i>
                <span id="resultadosTitulo" class="mc-table-head-title">@Resources.Strings.Modelo_Resultados</span>
                <span id="mcContexto" class="mc-table-head-ctx"></span>
                <span id="resultadosContador" class="mc-table-head-count" style="display:none;"></span>
            </div>
            <div class="mc-table-wrapper">
                <table class="mc-table">
                    <thead id="resultadosThead"></thead>
                    <tbody id="resultadosTbody"></tbody>
                </table>
            </div>
            <div class="mc-table-foot">
                <span class="mc-range" id="mcRango"></span>
                <div class="pagination-controls mc-pag" id="paginacionControls" style="display:none;padding:0;margin:0;border:none;"></div>
            </div>
        </div>
    </div>

    <!-- Estado vacío -->
    <div id="noResultados" style="display:none;">
        <div class="no-data-message">
            <i class="fas fa-inbox"></i>
            <h4>@Resources.Strings.Modelo_NoResultados</h4>
            <p>@Resources.Strings.Modelo_NoResultadosDesc</p>
        </div>
    </div>

    <!-- Modal: enviar modelos por correo -->
    <div class="modal fade" id="modalEnviarCorreo" tabindex="-1" role="dialog" aria-labelledby="modalEnviarCorreoLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalEnviarCorreoLabel">
                        <i class="fas fa-paper-plane mr-2" style="color:#583AFF;"></i>@Resources.Strings.Modelo_Correo_ModalTitle
                    </h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p class="text-muted mb-3" style="font-size:0.85rem;">
                        <i class="fas fa-building mr-1" style="color:#583AFF;"></i>
                        @Resources.Strings.Modelo_LabelEmpresa: <strong id="correoEmpresaNombre">-</strong>
                        &nbsp;&middot;&nbsp;
                        <i class="fas fa-layer-group mr-1" style="color:#583AFF;"></i>
                        @Resources.Strings.Modelo_Correo_LabelEscenario: <strong id="correoEscenarioNombre">-</strong>
                    </p>

                    <div class="form-group">
                        <label>
                            <i class="fas fa-cubes mr-1"></i>@Resources.Strings.Modelo_Correo_LabelModelos <span class="required">*</span>
                        </label>
                        <div class="mc-modelos-box">
                            <label class="mc-modelo-item mc-modelo-all">
                                <input type="checkbox" id="correoSelAll">
                                <span>@Resources.Strings.Modelo_Correo_SelTodos</span>
                            </label>
                            <div id="correoListaModelos">
                                @foreach (var m in Model.Modelos)
                                {
                                    <label class="mc-modelo-item">
                                        <input type="checkbox" class="mc-modelo-chk" value="@m.Id">
                                        <span>@m.Nombre</span>
                                    </label>
                                }
                            </div>
                        </div>
                        <small class="form-text text-muted" id="correoContadorModelos">0 @Resources.Strings.Modelo_Correo_Seleccionados</small>
                    </div>

                    <div class="form-group">
                        <label for="correoDestino">
                            <i class="fas fa-at mr-1"></i>@Resources.Strings.Modelo_Correo_LabelDestino <span class="required">*</span>
                        </label>
                        <input type="text" class="form-control" id="correoDestino" autocomplete="off"
                               placeholder="@Resources.Strings.Modelo_Correo_PlaceholderDestino">
                        <small class="form-text text-muted">@Resources.Strings.Modelo_Correo_HintDestino</small>
                    </div>

                    <div class="form-group mb-0">
                        <label for="correoMensaje">
                            <i class="fas fa-align-left mr-1"></i>@Resources.Strings.Modelo_Correo_LabelMensaje
                        </label>
                        <textarea class="form-control" id="correoMensaje" rows="2" maxlength="1000"
                                  placeholder="@Resources.Strings.Modelo_Correo_PlaceholderMensaje"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i>@Resources.Strings.Layout_Cancel
                    </button>
                    <button type="button" class="btn btn-primary btn-sm" id="btnEnviarCorreoConfirmar" onclick="enviarModelosCorreo()">
                        <i class="fas fa-paper-plane mr-1"></i>@Resources.Strings.Modelo_Correo_BtnEnviar
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

@section scripts {

<script>
    var _modelo = {
        urlEjecutar:          '@Url.Action("EjecutarModeloAjax",         "Datos")',
        urlExportarTodos:     '@Url.Action("ExportarTodosModelos",       "Datos")',
        urlExportarIndividual:'@Url.Action("ExportarModeloIndividual",   "Datos")',
        urlExportarSeleccionados:'@Url.Action("ExportarModelosSeleccionados", "Datos")',
        urlEnviarCorreo:      '@Url.Action("EnviarModelosPorCorreo",     "Datos")',
        urlAniosConDatos:     '@Url.Action("ObtenerAniosConDatos",       "Datos")',
        token: $('input[name="__RequestVerificationToken"]').val(),
        textos: {
            correoEnviando:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Correo_Enviando))',
            correoExitoTitulo:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Correo_ExitoTitulo))',
            correoValModelos:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Correo_ValModelos))',
            correoValCorreo:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Correo_ValCorreo))',
            correoSeleccionados:'@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Correo_Seleccionados))',
            ejecutando:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_JS_Ejecutando))',
            exportandoTodos:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_JS_ExportandoTodos))',
            exportandoUno:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_BtnExportarModelo))',
            exportandoSeleccionados: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_JS_ExportandoSeleccionados))',
            registros:        '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Registros))',
            btnEjecutar:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_BtnEjecutar))',
            btnExportarTodos:        '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_BtnExportarTodos))',
            btnDescargarModeloFmt:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_BtnDescargarModeloFmt))',
            btnExportarSeleccionadosFmt: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_BtnExportarSeleccionadosFmt))',
            exportTooltipTodos:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_BtnExportTooltip))',
            exportTooltipSeleccionado: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_BtnExportTooltipSeleccionado))',
            exportadosOk:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_JS_ExportadosOk))',
            exito:              '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Exito))',
            error:              '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Error))',
            aceptar:            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Aceptar))',
            erroresExportacion: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_JS_ErroresExportacion))',
            descargarLog:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_JS_DescargarLog))',
            cerrar:             '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_JS_Cerrar))',
            pickerPlaceholder:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Picker_Placeholder))',
            pickerTodos:        '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Picker_Todos))',
            pickerVariosFmt:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Picker_VariosFmt))',
            resultadosTitulo:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Resultados))'
        }
    };

    var _moneyColSet = { 'valor': true, 'valoracumulado': true, 'valorfuturo': true, 'valorpresupuesto': true, 'valorpresupuestoacumulado': true, 'valorpresupuestoconajuste': true };

    // ── Estado de paginación ──────────────────────────────────────────────
    var _pag = {
        filas:      [],
        filasVista: [],   // filas tras aplicar el filtro de texto sobre los resultados
        columnas:   [],
        pagina:     1,
        porPagina:  50,
        idModelo:   null,
        idEmpresa:  null
    };

    // ── Selector de modelos (uno o varios) ───────────────────────────────
    function modelosSeleccionados() {
        return $('.mc-modelo-pick:checked').map(function () { return this.value; }).get();
    }

    function abrirPicker() {
        $('#modeloPicker').addClass('open');
        $('#modeloPickerToggle').attr('aria-expanded', 'true');
        $('#modeloPickerPanel').prop('hidden', false);
    }
    function cerrarPicker() {
        $('#modeloPicker').removeClass('open');
        $('#modeloPickerToggle').attr('aria-expanded', 'false');
        $('#modeloPickerPanel').prop('hidden', true);
    }

    // Repinta la etiqueta del selector según cuántos modelos hay marcados.
    function pintarPickerLabel() {
        var sel   = modelosSeleccionados();
        var total = $('.mc-modelo-pick').length;
        var $lbl  = $('#modeloPickerLabel');

        if (sel.length === 0) {
            $lbl.text(_modelo.textos.pickerPlaceholder).removeClass('has-sel');
        } else if (sel.length === 1) {
            $lbl.text($('.mc-modelo-pick:checked').data('nombre')).addClass('has-sel');
        } else if (sel.length === total) {
            $lbl.text(_modelo.textos.pickerTodos).addClass('has-sel');
        } else {
            $lbl.text(_modelo.textos.pickerVariosFmt.replace('{0}', sel.length)).addClass('has-sel');
        }

        $('#modeloSelAll')
            .prop('checked', sel.length > 0 && sel.length === total)
            .prop('indeterminate', sel.length > 0 && sel.length < total);
    }

    // Cambió la selección de modelos: descripción (solo con 1), etiqueta y botones.
    function onModelosChange() {
        var sel = modelosSeleccionados();

        if (sel.length === 1) {
            var $c   = $('.mc-modelo-pick:checked');
            var desc = $c.data('descripcion');
            var ico  = $c.data('icono') || 'fas fa-cog';
            if (desc) {
                $('#modeloIcono').attr('class', ico + ' mr-1').css('color', '#583AFF');
                $('#modeloDescripcion').text(desc);
                $('#modeloInfoPanel').show();
            } else {
                $('#modeloInfoPanel').hide();
            }
        } else {
            $('#modeloInfoPanel').hide();
        }

        pintarPickerLabel();
        actualizarBotones();
    }

    var _sinDatosEscenario = false;

    function actualizarBotones() {
        var tieneEmpresa = !!$('#idEmpresa').val();
        var nSel = modelosSeleccionados().length;
        var habilitado = tieneEmpresa && !_sinDatosEscenario;
        $('#btnEjecutar').prop('disabled', !(habilitado && nSel === 1));
        $('#btnExportarTodos').prop('disabled', !habilitado);
        $('#btnEnviarCorreo').prop('disabled', !habilitado);
        actualizarBotonExportar();
    }

    // Verifica si la empresa/escenario elegidos tienen datos cargados (reutiliza el mismo
    // endpoint que usa "Plantilla con datos" en Cargue de Excel) y muestra un aviso en vez de
    // dejar que el usuario dispare un error del procedimiento almacenado al ejecutar/exportar.
    function verificarDatosEscenario() {
        var idEmpresa = $('#idEmpresa').val();
        var idEscenario = $('#idEscenario').val();

        if (!idEmpresa) {
            _sinDatosEscenario = false;
            $('#avisoSinDatosEscenario').hide();
            actualizarBotones();
            return;
        }

        $.get(_modelo.urlAniosConDatos, { idEmpresa: idEmpresa, idEscenario: idEscenario })
            .done(function (data) {
                _sinDatosEscenario = !(data && data.success && data.anios && data.anios.length > 0);
                $('#avisoSinDatosEscenario').toggle(_sinDatosEscenario);
                actualizarBotones();
            })
            .fail(function () {
                _sinDatosEscenario = false;
                $('#avisoSinDatosEscenario').hide();
                actualizarBotones();
            });
    }

    // Texto/ícono del botón de exportación, según la selección del selector unificado:
    // 1 modelo → "Exportar <nombre>"; varios (no todos) → "Exportar N modelos seleccionados";
    // ninguno o todos → "Exportar todos los modelos".
    function actualizarBotonExportar() {
        var sel   = modelosSeleccionados();
        var total = $('.mc-modelo-pick').length;

        if (sel.length === 1) {
            var txtUno = _modelo.textos.btnDescargarModeloFmt.replace('{0}', $('.mc-modelo-pick:checked').data('nombre'));
            $('#btnExportarTodosIcono').attr('class', 'fas fa-file-excel mr-1');
            $('#btnExportarTodosTexto').text(txtUno);
            $('#btnExportarTodos').attr('title', txtUno);   // nombre completo al pasar el ratón (el botón lo recorta)
        } else if (sel.length > 1 && sel.length < total) {
            $('#btnExportarTodosIcono').attr('class', 'fas fa-file-excel mr-1');
            $('#btnExportarTodosTexto').text(_modelo.textos.btnExportarSeleccionadosFmt.replace('{0}', sel.length));
            $('#btnExportarTodos').attr('title', _modelo.textos.exportTooltipTodos);
        } else {
            $('#btnExportarTodosIcono').attr('class', 'fas fa-layer-group mr-1');
            $('#btnExportarTodosTexto').text(_modelo.textos.btnExportarTodos);
            $('#btnExportarTodos').attr('title', _modelo.textos.exportTooltipTodos);
        }
    }

    $(function () {

        $('#idEmpresa').on('change', function () { actualizarBotones(); verificarDatosEscenario(); });
        $('#idEscenario').on('change', verificarDatosEscenario);

        // ── Selector de modelos ─────────────────────────────────────────
        $('#modeloPickerToggle').on('click', function (e) {
            e.stopPropagation();
            $('#modeloPicker').hasClass('open') ? cerrarPicker() : abrirPicker();
        });
        $(document).on('click', function (e) {
            if (!$(e.target).closest('#modeloPicker').length) cerrarPicker();
        });
        $('#modeloSelAll').on('change', function () {
            $('.mc-modelo-pick').prop('checked', this.checked);
            onModelosChange();
        });
        $(document).on('change', '.mc-modelo-pick', onModelosChange);

        // Nota: la única empresa se preselecciona sola, pero eso no cuenta como una elección
        // deliberada del usuario — solo se actualizan los botones, sin disparar todavía el
        // aviso de "sin datos" (ese se reserva para cuando el usuario realmente interactúa
        // con empresa/escenario, o al intentar ejecutar/exportar).
        if ($('#idEmpresa option').length === 2) {
            $('#idEmpresa option:last').prop('selected', true);
            actualizarBotones();
        }

        onModelosChange();

        // ── Filtro de texto sobre los resultados ya cargados (cliente) ────
        $('#filtroResultados').on('input', function () {
            var q = ($(this).val() || '').toLowerCase().trim();
            _pag.filasVista = q
                ? _pag.filas.filter(function (fila) {
                      return fila.some(function (celda) {
                          return String(celda == null ? '' : celda).toLowerCase().indexOf(q) >= 0;
                      });
                  })
                : _pag.filas;
            renderPagina(1);
        });

        // ── Modal enviar por correo ──────────────────────────────────────
        $('#correoSelAll').on('change', function () {
            $('.mc-modelo-chk').prop('checked', this.checked);
            actualizarContadorCorreo();
        });
        $(document).on('change', '.mc-modelo-chk', actualizarContadorCorreo);
    });

    function actualizarContadorCorreo() {
        var total = $('.mc-modelo-chk').length;
        var n = $('.mc-modelo-chk:checked').length;
        $('#correoContadorModelos').text(n + ' ' + _modelo.textos.correoSeleccionados);
        $('#correoSelAll')
            .prop('checked', n > 0 && n === total)
            .prop('indeterminate', n > 0 && n < total);
    }

    function abrirModalCorreo() {
        var idEmpresa = $('#idEmpresa').val();
        if (!idEmpresa) return;

        $('#correoEmpresaNombre').text($('#idEmpresa option:selected').data('nombre') || $('#idEmpresa option:selected').text());
        $('#correoEscenarioNombre').text($('#idEscenario option:selected').text());

        // Preselecciona en el modal los modelos ya marcados en el selector unificado.
        var sel = modelosSeleccionados();
        $('.mc-modelo-chk').each(function () {
            this.checked = sel.indexOf(this.value) !== -1;
        });

        // Recuerda el último destino usado.
        try {
            var last = localStorage.getItem('bufins_modelo_correo_dest');
            if (last && !$('#correoDestino').val()) $('#correoDestino').val(last);
        } catch (e) { }

        actualizarContadorCorreo();
        $('#modalEnviarCorreo').modal('show');
    }

    function enviarModelosCorreo() {
        var idEmpresa = $('#idEmpresa').val();
        if (!idEmpresa) return;

        var ids = $('.mc-modelo-chk:checked').map(function () { return this.value; }).get();
        if (ids.length === 0) {
            Swal.fire({ icon: 'warning', title: _modelo.textos.error, text: _modelo.textos.correoValModelos,
                        confirmButtonText: _modelo.textos.aceptar, confirmButtonColor: '#583AFF' });
            return;
        }

        var correosRaw = ($('#correoDestino').val() || '').trim();
        var tokens = correosRaw.split(/[,;\s]+/).filter(function (t) { return t.length > 0; });
        var rx = /^[^@@\s]+@@[^@@\s]+\.[^@@\s]+$/;
        if (tokens.length === 0 || !tokens.every(function (t) { return rx.test(t); })) {
            Swal.fire({ icon: 'warning', title: _modelo.textos.error, text: _modelo.textos.correoValCorreo,
                        confirmButtonText: _modelo.textos.aceptar, confirmButtonColor: '#583AFF' });
            return;
        }

        try { localStorage.setItem('bufins_modelo_correo_dest', correosRaw); } catch (e) { }

        var totalModelos = $('.mc-modelo-chk').length;
        var idsModelos = (ids.length === totalModelos) ? 'todos' : ids.join(',');

        $('#modalEnviarCorreo').modal('hide');

        document.getElementById('overlayTitulo').textContent = _modelo.textos.correoEnviando;
        var overlay = document.getElementById('overlayExportacion');
        overlay.style.display = 'flex';
        var segundos = 0;
        document.getElementById('overlayTimerTexto').textContent = '0s';
        var timer = setInterval(function () {
            segundos++;
            document.getElementById('overlayTimerTexto').textContent = segundos + 's';
        }, 1000);

        $.ajax({
            url: _modelo.urlEnviarCorreo,
            type: 'POST',
            data: {
                __RequestVerificationToken: _modelo.token,
                idEmpresa: idEmpresa,
                idsModelos: idsModelos,
                correos: correosRaw,
                mensaje: $('#correoMensaje').val() || '',
                idEscenario: $('#idEscenario').val()
            },
            success: function (resp) {
                clearInterval(timer);
                overlay.style.display = 'none';
                if (resp && resp.exito) {
                    Swal.fire({ icon: 'success', title: _modelo.textos.correoExitoTitulo, text: resp.mensaje,
                                confirmButtonText: _modelo.textos.aceptar, confirmButtonColor: '#583AFF' });
                } else if (resp && resp.errores) {
                    mostrarErroresModelos(resp.errores);
                } else {
                    Swal.fire({ icon: 'error', title: _modelo.textos.error, text: (resp && resp.mensaje) || 'Error',
                                confirmButtonText: _modelo.textos.aceptar, confirmButtonColor: '#583AFF' });
                }
            },
            error: function () {
                clearInterval(timer);
                overlay.style.display = 'none';
                Swal.fire({ icon: 'error', title: _modelo.textos.error,
                            text: 'Error de conexión al enviar el correo.',
                            confirmButtonText: _modelo.textos.aceptar, confirmButtonColor: '#583AFF' });
            }
        });
    }

    // ── Ejecutar modelo individual (AJAX) ─────────────────────────────────
    function ejecutarModelo() {
        var idEmpresa = $('#idEmpresa').val();
        var sel = modelosSeleccionados();
        if (!idEmpresa || sel.length !== 1) return;

        var $c        = $('.mc-modelo-pick[value="' + sel[0] + '"]');
        var idModelo  = sel[0];
        var nomModelo = $c.data('nombre') || '';
        var icoModelo = $c.data('icono') || 'fas fa-table';

        $('#estadoInicial').hide();
        $('#resultadosSection').hide();
        $('#noResultados').hide();
        $('#loadingEjecucion').show();
        $('#btnEjecutar').prop('disabled', true);
        $('#btnTexto').text(_modelo.textos.ejecutando);

        $.ajax({
            url:  _modelo.urlEjecutar,
            type: 'POST',
            data: {
                __RequestVerificationToken: _modelo.token,
                idEmpresa: idEmpresa,
                idModelo:  idModelo,
                idEscenario: $('#idEscenario').val()
            },
            success: function (resp) {
                $('#loadingEjecucion').hide();
                $('#btnTexto').text(_modelo.textos.btnEjecutar);
                actualizarBotones();

                if (!resp.exito) {
                    $('#estadoInicial').show();
                    ocultarHerramientasResultado();
                    Swal.fire({ icon: 'error', title: _modelo.textos.error, text: resp.mensaje,
                                confirmButtonText: _modelo.textos.aceptar, confirmButtonColor: '#583AFF' });
                    return;
                }

                if (!resp.columnas || resp.columnas.length === 0 || !resp.filas || resp.filas.length === 0) {
                    $('#noResultados').show();
                    ocultarHerramientasResultado();
                    return;
                }

                // Guardar estado de paginación
                _pag.filas      = resp.filas;
                _pag.filasVista = resp.filas;
                _pag.columnas   = resp.columnas;
                _pag.pagina     = 1;
                _pag.idModelo   = idModelo;
                _pag.idEmpresa  = idEmpresa;

                // Header de la tabla (alinea a la derecha las columnas de valor)
                var thead = '<tr>';
                for (var i = 0; i < resp.columnas.length; i++) {
                    var esNum = !!_moneyColSet[(resp.columnas[i] || '').toLowerCase()];
                    thead += '<th' + (esNum ? ' class="num"' : '') + '>' +
                             $('<span>').text(resp.columnas[i]).html() + '</th>';
                }
                thead += '</tr>';
                $('#resultadosThead').html(thead);

                // Cabecera contextual de la tarjeta de resultados
                var nomEmpresa = $('#idEmpresa option:selected').data('nombre') ||
                                 $('#idEmpresa option:selected').text();
                $('#resultadosIcono').attr('class', icoModelo + ' mc-table-head-icon');
                $('#resultadosTitulo').text(nomModelo);
                $('#mcContexto').text(nomEmpresa || '');   // el separador lo pone .mc-table-head-ctx::before (CSS)
                $('#resultadosContador')
                    .text(resp.filas.length + ' ' + _modelo.textos.registros)
                    .show();

                // Herramientas que solo aplican con resultados en pantalla
                $('#mcSearchWrap').css('display', 'flex');
                $('#filtroResultados').val('');

                renderPagina(1);
                $('#resultadosSection').show();
                $('html, body').animate({ scrollTop: $('#resultadosSection').offset().top - 90 }, 400);
            },
            error: function () {
                $('#loadingEjecucion').hide();
                $('#btnTexto').text(_modelo.textos.btnEjecutar);
                actualizarBotones();
                $('#estadoInicial').show();
                ocultarHerramientasResultado();
                Swal.fire({ icon: 'error', title: _modelo.textos.error,
                            text: 'Error de conexión al ejecutar el modelo.',
                            confirmButtonText: _modelo.textos.aceptar, confirmButtonColor: '#583AFF' });
            }
        });
    }

    // Oculta las herramientas que solo tienen sentido con una tabla de resultados en pantalla.
    function ocultarHerramientasResultado() {
        $('#mcSearchWrap').hide();
        $('#resultadosContador').hide();
        $('#mcContexto').text('');
        $('#resultadosTitulo').text(_modelo.textos.resultadosTitulo);
    }

    // ── Paginación ────────────────────────────────────────────────────────
    function renderPagina(pagina) {
        _pag.pagina = pagina;
        var datos  = _pag.filasVista.length || $('#filtroResultados').val() ? _pag.filasVista : _pag.filas;
        var inicio = (pagina - 1) * _pag.porPagina;
        var fin    = Math.min(inicio + _pag.porPagina, datos.length);
        var slice  = datos.slice(inicio, fin);

        var tbody = '';
        for (var r = 0; r < slice.length; r++) {
            tbody += '<tr>';
            for (var c = 0; c < slice[r].length; c++) {
                var col   = (_pag.columnas[c] || '').toLowerCase();
                var esNum = !!_moneyColSet[col];
                var esKey = (col === 'cuentapuc' || col === 'codigo');
                var val   = slice[r][c];
                if (val !== '' && esNum) {
                    var num = parseFloat(val);
                    if (!isNaN(num))
                        val = num.toLocaleString('es-CO', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                }
                var cls = esNum ? ' class="num"' : (esKey ? ' class="key"' : '');
                tbody += '<td' + cls + '>' + $('<span>').text(val).html() + '</td>';
            }
            tbody += '</tr>';
        }
        $('#resultadosTbody').html(tbody);

        // Rango legible, p.ej. "1-50 de 2.268"
        $('#mcRango').text(
            datos.length === 0
                ? '0'
                : (inicio + 1).toLocaleString('es-CO') + '\u2013' + fin.toLocaleString('es-CO') +
                  ' de ' + datos.length.toLocaleString('es-CO')
        );

        actualizarPaginacion(datos.length);
    }

    function actualizarPaginacion(totalFilas) {
        var n      = (typeof totalFilas === 'number') ? totalFilas : _pag.filas.length;
        var total  = Math.ceil(n / _pag.porPagina);
        var actual = _pag.pagina;
        var $ctrl  = $('#paginacionControls');

        if (total <= 1) { $ctrl.hide(); return; }

        var ini = Math.max(1, actual - 2);
        var fin = Math.min(total, ini + 4);
        ini = Math.max(1, fin - 4);

        var html = '';
        html += '<button class="btn-pagination' + (actual === 1 ? ' disabled' : '') + '" ' +
                (actual === 1 ? 'disabled' : 'onclick="renderPagina(' + (actual - 1) + ')"') + '>' +
                '<i class="fas fa-chevron-left"></i></button>';

        for (var p = ini; p <= fin; p++) {
            html += '<button class="btn-pagination' + (p === actual ? ' active' : '') +
                    '" onclick="renderPagina(' + p + ')">' + p + '</button>';
        }

        html += '<button class="btn-pagination' + (actual === total ? ' disabled' : '') + '" ' +
                (actual === total ? 'disabled' : 'onclick="renderPagina(' + (actual + 1) + ')"') + '>' +
                '<i class="fas fa-chevron-right"></i></button>';

        $ctrl.html(html).show();
    }

    // Botón de exportación: usa la selección del selector unificado.
    // 1 modelo → ese; varios (no todos) → esos; ninguno o todos → todos.
    function exportarModelos() {
        var idEmpresa = $('#idEmpresa').val();
        if (!idEmpresa) return;

        var sel   = modelosSeleccionados();
        var total = $('.mc-modelo-pick').length;

        if (sel.length === 1)                          exportarExcel('seleccionado', sel);
        else if (sel.length > 1 && sel.length < total) exportarExcel('multiple', sel);
        else                                           exportarExcel('todos', sel);
    }

    // ── Exportar (todos los modelos, una selección múltiple, o un único modelo) ───────────────
    function exportarExcel(modo, ids) {
        var idEmpresa = $('#idEmpresa').val();
        if (!idEmpresa) return;
        var idEscenario = $('#idEscenario').val();
        ids = ids || [];

        var url, titulo;
        if (modo === 'multiple') {
            if (ids.length === 0) return;
            url    = _modelo.urlExportarSeleccionados + '?idEmpresa=' + idEmpresa + '&idsModelos=' + ids.join(',') + '&idEscenario=' + idEscenario;
            titulo = _modelo.textos.exportandoSeleccionados;
        } else if (modo === 'seleccionado') {
            if (ids.length === 0) return;
            var nombreSel = $('.mc-modelo-pick[value="' + ids[0] + '"]').data('nombre') || '';
            url    = _modelo.urlExportarIndividual + '?idEmpresa=' + idEmpresa + '&idModelo=' + ids[0] + '&idEscenario=' + idEscenario;
            titulo = nombreSel ? _modelo.textos.btnDescargarModeloFmt.replace('{0}', nombreSel) : _modelo.textos.exportandoUno;
        } else {
            url    = _modelo.urlExportarTodos + '?idEmpresa=' + idEmpresa + '&idEscenario=' + idEscenario;
            titulo = _modelo.textos.exportandoTodos;
        }

        document.getElementById('overlayTitulo').textContent = titulo;

        var overlay  = document.getElementById('overlayExportacion');
        overlay.style.display = 'flex';
        var segundos = 0;
        var timer = setInterval(function () {
            segundos++;
            document.getElementById('overlayTimerTexto').textContent = segundos + 's';
        }, 1000);

        var filename = 'Modelos.xlsx';
        fetch(url)
            .then(function (response) {
                if (!response.ok) throw new Error('Error en la respuesta del servidor.');
                var ct = response.headers.get('Content-Type') || '';
                if (ct.indexOf('application/json') >= 0) {
                    return response.json().then(function (data) { return { tipo: 'error', data: data }; });
                }
                var cd    = response.headers.get('Content-Disposition') || '';
                var match = cd.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
                if (match) filename = match[1].replace(/['"]/g, '');
                return response.blob().then(function (blob) { return { tipo: 'archivo', blob: blob }; });
            })
            .then(function (result) {
                clearInterval(timer);
                overlay.style.display = 'none';
                if (result.tipo === 'error') {
                    mostrarErroresModelos(result.data.errores, result.data.exitosos);
                } else {
                    var blobUrl = window.URL.createObjectURL(result.blob);
                    var a = document.createElement('a');
                    a.href = blobUrl;
                    a.download = filename;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    window.URL.revokeObjectURL(blobUrl);
                }
            })
            .catch(function (err) {
                clearInterval(timer);
                overlay.style.display = 'none';
                Swal.fire({ icon: 'error', title: _modelo.textos.error, text: err.message,
                            confirmButtonText: _modelo.textos.aceptar, confirmButtonColor: '#583AFF' });
            });
    }

    function mostrarErroresModelos(errores, exitosos) {
        var html = '<div style="text-align:left;max-height:280px;overflow-y:auto;padding-right:4px;">';
        if (exitosos && exitosos.length > 0) {
            html += '<div style="margin-bottom:12px;padding:10px 12px;background:#f0fdf4;border-left:4px solid #22c55e;border-radius:4px;">';
            html += '<strong style="color:#166534;"><i class="fas fa-check-circle mr-1"></i>' + _modelo.textos.exportadosOk + '</strong>';
            html += '<div style="color:#166534;font-size:0.85em;margin-top:4px;">' + $('<span>').text(exitosos.join(', ')).html() + '</div>';
            html += '</div>';
        }
        errores.forEach(function (e) {
            html += '<div style="margin-bottom:10px;padding:10px 12px;background:#fef2f2;border-left:4px solid #ef4444;border-radius:4px;">';
            html += '<strong style="color:#1f2937;">' + e.nombre + '</strong><br>';
            html += '<small style="color:#6b7280;">' + e.nombreSP + '</small><br>';
            html += '<span style="color:#dc2626;font-size:0.85em;">' + e.mensaje + '</span>';
            html += '</div>';
        });
        html += '</div>';

        Swal.fire({
            icon: 'error',
            title: _modelo.textos.erroresExportacion,
            html: html,
            width: 640,
            confirmButtonText: '<i class="fas fa-download mr-1"></i> ' + _modelo.textos.descargarLog,
            confirmButtonColor: '#583AFF',
            showCancelButton: true,
            cancelButtonText: _modelo.textos.cerrar,
            cancelButtonColor: '#6b7280'
        }).then(function (result) {
            if (!result.isConfirmed) return;
            var txt = 'ERRORES EN EXPORTACION DE MODELOS\n';
            txt += '====================================\n\n';
            errores.forEach(function (e) {
                txt += 'Modelo   : ' + e.nombre + '\n';
                txt += 'SP       : ' + e.nombreSP + '\n';
                txt += 'Error    : ' + e.mensaje + '\n';
                txt += '------------------------------------\n\n';
            });
            var blob = new Blob([txt], { type: 'text/plain;charset=utf-8' });
            var bUrl = URL.createObjectURL(blob);
            var a    = document.createElement('a');
            a.href   = bUrl;
            a.download = 'ErroresExportacion_' + new Date().toISOString().slice(0, 10) + '.txt';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(bUrl);
        });
    }
</script>

