{
    <script>
        $(function () {
            Swal.fire({ icon: 'success', title: _modelo.textos.exito,
                        text: '@Html.Raw(TempData["SuccessMessage"].ToString().Replace("'", "\\'"))',
                        confirmButtonText: _modelo.textos.aceptar, confirmButtonColor: '#583AFF' });
        });
    </script>
}
