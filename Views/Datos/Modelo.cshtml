@model bufinscustomers.Models.ModeloPageViewModel
@using bufinscustomers.Helpers
@{
    ViewBag.Title = Resources.Strings.Modelo_PageTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var usuario = UsuarioSesionHelper.UsuarioActual;
    var esAdmin = usuario?.Admin == 1 || usuario?.Admin == 2;
    var idEmpresaUsuario = usuario?.IdEmpresa ?? 0;
}

<link href="~/Assets/css/bufins-components.css" rel="stylesheet" />

<style>
    .btn-export-all {
        position: relative;
        overflow: hidden;
        color: #fff !important;
        border: none;
        background: linear-gradient(110deg, #185c37 0%, #217346 25%, #2e9e5b 50%, #217346 75%, #185c37 100%);
        background-size: 300% 100%;
        padding: 0.375rem 0.85rem;
        border-radius: 0.45rem;
        font-size: 0.875rem;
        font-weight: 600;
        letter-spacing: 0.01em;
        cursor: pointer;
        transition: box-shadow 0.25s ease;
        animation: exportShine 4s linear infinite;
    }
    .btn-export-all:disabled {
        background: #9ca3af !important;
        animation: none !important;
        cursor: not-allowed;
        box-shadow: none !important;
        opacity: 0.7;
    }
    .btn-export-all:not(:disabled):hover {
        box-shadow: 0 4px 20px rgba(33, 115, 70, 0.45);
        animation: exportShine 1.8s linear infinite;
    }
    .btn-export-all:not(:disabled):hover .ico-export {
        transform: translateY(-2px) scale(1.15);
    }
    .ico-export {
        transition: transform 0.25s ease;
        display: inline-block;
    }
    @@keyframes exportShine {
        0%   { background-position: 100% 0; }
        100% { background-position: -200% 0; }
    }
</style>

@Html.AntiForgeryToken()

<div class="container-fluid px-4">

    <!-- Header -->
    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fa-solid fa-database powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@Resources.Strings.Modelo_PageTitle</h1>
        </div>
    </div>

    <!-- Filter card -->
    <div class="filter-card">
        <h3 class="filter-card-title">
            <i class="fas fa-play-circle"></i>
            @Resources.Strings.Modelo_CardTitleFiltros
        </h3>
        <div class="filter-section">
            <div class="row g-3">

                <!-- Empresa -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="idEmpresa">
                            <i class="fas fa-building mr-1"></i>
                            @Resources.Strings.Modelo_LabelEmpresa <span class="required">*</span>
                        </label>
                        <select class="form-control" id="idEmpresa">
                            <option value="">@Resources.Strings.Modelo_SelectEmpresa</option>
                            @if (esAdmin)
                            {
                                foreach (var empresa in Model.Empresas)
                                {
                                    <option value="@empresa.Id" data-nombre="@empresa.Nombre">@empresa.Nombre</option>
                                }
                            }
                            else
                            {
                                var emp = Model.Empresas.FirstOrDefault(e => e.Id == idEmpresaUsuario);
                                if (emp != null)
                                {
                                    <option value="@emp.Id" data-nombre="@emp.Nombre">@emp.Nombre</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <!-- Modelo -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="selectModelo">
                            <i class="fas fa-cog mr-1"></i>
                            @Resources.Strings.Modelo_LabelModelo <span class="required">*</span>
                        </label>
                        <select class="form-control" id="selectModelo">
                            <option value="">@Resources.Strings.Modelo_SelectModelo</option>
                            @foreach (var m in Model.Modelos)
                            {
                                <option value="@m.Id"
                                        data-descripcion="@(m.Descripcion ?? "")"
                                        data-icono="@(m.Icono ?? "fas fa-cog")"
                                        data-nombre="@m.Nombre">
                                    @m.Nombre
                                </option>
                            }
                        </select>
                        <div id="modeloInfoPanel" style="display:none;margin-top:6px;padding:8px 12px;background:#f0f0ff;border-radius:8px;border-left:3px solid #583AFF;font-size:0.85rem;color:#4b5563;">
                            <i id="modeloIcono" class="fas fa-cog mr-1" style="color:#583AFF;"></i>
                            <span id="modeloDescripcion"></span>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="btn-group-actions">
            <button type="button" id="btnEjecutar" class="btn btn-modern-gradient" disabled onclick="ejecutarModelo()">
                <i class="fas fa-play mr-1"></i>
                <span id="btnTexto">@Resources.Strings.Modelo_BtnEjecutar</span>
            </button>
            <button type="button" id="btnExportarTodos" class="btn btn-export-all" disabled onclick="exportarExcel('todos')" title="@Resources.Strings.Modelo_BtnExportTooltip">
                <span class="ico-export"><i class="fas fa-layer-group mr-1"></i></span>
                @Resources.Strings.Modelo_BtnExportarTodos
            </button>
            <small class="text-muted" id="textoAyuda">
                <i class="fas fa-info-circle" style="color:#583AFF;"></i>
                @Resources.Strings.Modelo_HintCompletar
            </small>
        </div>
    </div>

    <!-- Loading (ejecución AJAX) -->
    <div id="loadingEjecucion" style="display:none;text-align:center;padding:2.5rem;">
        <div class="spinner-border text-primary" style="width:3rem;height:3rem;" role="status"></div>
        <p class="mt-3 text-muted fw-semibold">@Resources.Strings.Modelo_JS_Ejecutando</p>
    </div>

    <!-- Overlay exportación (fetch/blob) -->
    <div id="overlayExportacion" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.6);z-index:9999;justify-content:center;align-items:center;">
        <div style="background:#fff;border-radius:16px;padding:2.5rem 3rem;text-align:center;max-width:400px;box-shadow:0 20px 60px rgba(0,0,0,.3);">
            <div class="spinner-border text-primary mb-3" style="width:3rem;height:3rem;" role="status"></div>
            <h5 id="overlayTitulo" style="font-weight:700;color:#1e293b;">@Resources.Strings.Modelo_JS_ExportandoTodos</h5>
            <p class="text-muted mb-0" id="overlayTimerTexto">0s</p>
        </div>
    </div>

    <!-- Estado inicial: aun no se ha ejecutado ninguna consulta -->
    <div id="estadoInicial" class="empty-state-initial">
        <div class="empty-state-initial-icon"><i class="fas fa-table"></i></div>
        <h4>@Resources.Strings.Common_EstadoInicialTitulo</h4>
        <p>@Resources.Strings.Modelo_EstadoInicialDesc</p>
    </div>

    <!-- Resultados del modelo individual -->
    <div id="resultadosSection" style="display:none;">
        <div class="table-container">
            <div class="table-header">
                <h5>
                    <i id="resultadosIcono" class="fas fa-table mr-2"></i>
                    <span id="resultadosTitulo">@Resources.Strings.Modelo_Resultados</span>
                </h5>
                <div class="d-flex align-items-center gap-2">
                    <span class="info-badge" id="resultadosContador">0 @Resources.Strings.Modelo_Registros</span>
                    <button type="button" id="btnExportarModelo" class="btn-modern-excel" onclick="exportarExcel('individual')" title="@Resources.Strings.Modelo_BtnExportarModelo">
                        <i class="fas fa-file-excel mr-1"></i>
                        @Resources.Strings.Modelo_BtnExportarModelo
                    </button>
                </div>
            </div>
            <div class="table-wrapper" style="max-height:520px;overflow:auto;">
                <table class="data-table">
                    <thead id="resultadosThead"></thead>
                    <tbody id="resultadosTbody"></tbody>
                </table>
            </div>
            <!-- Paginación -->
            <div class="pagination-controls" id="paginacionControls" style="display:none;"></div>
        </div>
    </div>

    <!-- Estado vacío -->
    <div id="noResultados" style="display:none;">
        <div class="no-data-message">
            <i class="fas fa-inbox"></i>
            <h4>@Resources.Strings.Modelo_NoResultados</h4>
            <p>@Resources.Strings.Modelo_NoResultadosDesc</p>
        </div>
    </div>

</div>

@section scripts {

<script>
    var _modelo = {
        urlEjecutar:          '@Url.Action("EjecutarModeloAjax",       "Datos")',
        urlExportarTodos:     '@Url.Action("ExportarTodosModelos",     "Datos")',
        urlExportarIndividual:'@Url.Action("ExportarModeloIndividual", "Datos")',
        token: $('input[name="__RequestVerificationToken"]').val(),
        textos: {
            ejecutando:       '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_JS_Ejecutando)',
            exportandoTodos:  '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_JS_ExportandoTodos)',
            exportandoUno:    '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_BtnExportarModelo)',
            registros:        '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Registros)',
            btnEjecutar:      '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_BtnEjecutar)',
            exito:              '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Exito)',
            error:              '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Error)',
            aceptar:            '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Aceptar)',
            erroresExportacion: '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_JS_ErroresExportacion)',
            descargarLog:       '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_JS_DescargarLog)',
            cerrar:             '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_JS_Cerrar)'
        }
    };

    var _moneyColSet = { 'valor': true, 'valoracumulado': true, 'valorfuturo': true };

    // ── Estado de paginación ──────────────────────────────────────────────
    var _pag = {
        filas:      [],
        columnas:   [],
        pagina:     1,
        porPagina:  50,
        idModelo:   null,
        idEmpresa:  null
    };

    $(function () {

        $('#idEmpresa, #selectModelo').on('change', actualizarBotones);

        $('#selectModelo').on('change', function () {
            var $opt = $(this).find(':selected');
            var val  = $(this).val();
            var desc = $opt.data('descripcion');
            var ico  = $opt.data('icono') || 'fas fa-cog';
            if (val && desc) {
                $('#modeloIcono').attr('class', ico + ' mr-1').css('color', '#583AFF');
                $('#modeloDescripcion').text(desc);
                $('#modeloInfoPanel').show();
            } else {
                $('#modeloInfoPanel').hide();
            }
        });

        function actualizarBotones() {
            var tieneEmpresa = !!$('#idEmpresa').val();
            var ok = tieneEmpresa && !!$('#selectModelo').val();
            $('#btnEjecutar').prop('disabled', !ok);
            $('#btnExportarTodos').prop('disabled', !tieneEmpresa);
            $('#textoAyuda').toggle(!ok);
        }

        if ($('#idEmpresa option').length === 2)
            $('#idEmpresa option:last').prop('selected', true).trigger('change');
    });

    // ── Ejecutar modelo individual (AJAX) ─────────────────────────────────
    function ejecutarModelo() {
        var idEmpresa = $('#idEmpresa').val();
        var idModelo  = $('#selectModelo').val();
        var nomModelo = $('#selectModelo option:selected').data('nombre') || '';
        var icoModelo = $('#selectModelo option:selected').data('icono') || 'fas fa-table';

        $('#estadoInicial').hide();
        $('#resultadosSection').hide();
        $('#noResultados').hide();
        $('#loadingEjecucion').show();
        $('#btnEjecutar').prop('disabled', true);
        $('#btnTexto').text(_modelo.textos.ejecutando);

        $.ajax({
            url:  _modelo.urlEjecutar,
            type: 'POST',
            data: {
                __RequestVerificationToken: _modelo.token,
                idEmpresa: idEmpresa,
                idModelo:  idModelo
            },
            success: function (resp) {
                $('#loadingEjecucion').hide();
                $('#btnEjecutar').prop('disabled', false);
                $('#btnTexto').text(_modelo.textos.btnEjecutar);

                if (!resp.exito) {
                    $('#estadoInicial').show();
                    Swal.fire({ icon: 'error', title: _modelo.textos.error, text: resp.mensaje,
                                confirmButtonText: _modelo.textos.aceptar, confirmButtonColor: '#583AFF' });
                    return;
                }

                if (!resp.columnas || resp.columnas.length === 0 || !resp.filas || resp.filas.length === 0) {
                    $('#noResultados').show();
                    return;
                }

                // Guardar estado de paginación
                _pag.filas     = resp.filas;
                _pag.columnas  = resp.columnas;
                _pag.pagina    = 1;
                _pag.idModelo  = idModelo;
                _pag.idEmpresa = idEmpresa;

                // Header de la tabla
                var thead = '<tr>';
                for (var i = 0; i < resp.columnas.length; i++)
                    thead += '<th>' + $('<span>').text(resp.columnas[i]).html() + '</th>';
                thead += '</tr>';
                $('#resultadosThead').html(thead);

                // Información del encabezado de la sección
                $('#resultadosIcono').attr('class', icoModelo + ' mr-2');
                $('#resultadosTitulo').text(nomModelo);
                $('#resultadosContador').text(resp.filas.length + ' ' + _modelo.textos.registros);

                renderPagina(1);
                $('#resultadosSection').show();
                $('html, body').animate({ scrollTop: $('#resultadosSection').offset().top - 20 }, 400);
            },
            error: function () {
                $('#loadingEjecucion').hide();
                $('#btnEjecutar').prop('disabled', false);
                $('#btnTexto').text(_modelo.textos.btnEjecutar);
                $('#estadoInicial').show();
                Swal.fire({ icon: 'error', title: _modelo.textos.error,
                            text: 'Error de conexión al ejecutar el modelo.',
                            confirmButtonText: _modelo.textos.aceptar, confirmButtonColor: '#583AFF' });
            }
        });
    }

    // ── Paginación ────────────────────────────────────────────────────────
    function renderPagina(pagina) {
        _pag.pagina = pagina;
        var inicio  = (pagina - 1) * _pag.porPagina;
        var fin     = Math.min(inicio + _pag.porPagina, _pag.filas.length);
        var slice   = _pag.filas.slice(inicio, fin);

        var tbody = '';
        for (var r = 0; r < slice.length; r++) {
            tbody += '<tr>';
            for (var c = 0; c < slice[r].length; c++) {
                var val = slice[r][c];
                if (val !== '' && _moneyColSet[(_pag.columnas[c] || '').toLowerCase()]) {
                    var num = parseFloat(val);
                    if (!isNaN(num))
                        val = num.toLocaleString('es-CO', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                }
                tbody += '<td>' + $('<span>').text(val).html() + '</td>';
            }
            tbody += '</tr>';
        }
        $('#resultadosTbody').html(tbody);

        actualizarPaginacion();
    }

    function actualizarPaginacion() {
        var total  = Math.ceil(_pag.filas.length / _pag.porPagina);
        var actual = _pag.pagina;
        var $ctrl  = $('#paginacionControls');

        if (total <= 1) { $ctrl.hide(); return; }

        var ini = Math.max(1, actual - 2);
        var fin = Math.min(total, ini + 4);
        ini = Math.max(1, fin - 4);

        var html = '';
        html += '<button class="btn-pagination' + (actual === 1 ? ' disabled' : '') + '" ' +
                (actual === 1 ? 'disabled' : 'onclick="renderPagina(' + (actual - 1) + ')"') + '>' +
                '<i class="fas fa-chevron-left"></i></button>';

        for (var p = ini; p <= fin; p++) {
            html += '<button class="btn-pagination' + (p === actual ? ' active' : '') +
                    '" onclick="renderPagina(' + p + ')">' + p + '</button>';
        }

        html += '<button class="btn-pagination' + (actual === total ? ' disabled' : '') + '" ' +
                (actual === total ? 'disabled' : 'onclick="renderPagina(' + (actual + 1) + ')"') + '>' +
                '<i class="fas fa-chevron-right"></i></button>';

        $ctrl.html(html).show();
    }

    // ── Exportar (todos los modelos O el modelo individual) ───────────────
    function exportarExcel(modo) {
        var idEmpresa = $('#idEmpresa').val();
        if (!idEmpresa) return;

        var url, titulo;
        if (modo === 'todos') {
            url    = _modelo.urlExportarTodos + '?idEmpresa=' + idEmpresa;
            titulo = _modelo.textos.exportandoTodos;
        } else {
            if (!_pag.idModelo) return;
            url    = _modelo.urlExportarIndividual + '?idEmpresa=' + idEmpresa + '&idModelo=' + _pag.idModelo;
            titulo = _modelo.textos.exportandoUno;
        }

        document.getElementById('overlayTitulo').textContent = titulo;

        var overlay  = document.getElementById('overlayExportacion');
        overlay.style.display = 'flex';
        var segundos = 0;
        var timer = setInterval(function () {
            segundos++;
            document.getElementById('overlayTimerTexto').textContent = segundos + 's';
        }, 1000);

        var filename = 'Modelos.xlsx';
        fetch(url)
            .then(function (response) {
                if (!response.ok) throw new Error('Error en la respuesta del servidor.');
                var ct = response.headers.get('Content-Type') || '';
                if (ct.indexOf('application/json') >= 0) {
                    return response.json().then(function (data) { return { tipo: 'error', data: data }; });
                }
                var cd    = response.headers.get('Content-Disposition') || '';
                var match = cd.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
                if (match) filename = match[1].replace(/['"]/g, '');
                return response.blob().then(function (blob) { return { tipo: 'archivo', blob: blob }; });
            })
            .then(function (result) {
                clearInterval(timer);
                overlay.style.display = 'none';
                if (result.tipo === 'error') {
                    mostrarErroresModelos(result.data.errores);
                } else {
                    var blobUrl = window.URL.createObjectURL(result.blob);
                    var a = document.createElement('a');
                    a.href = blobUrl;
                    a.download = filename;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    window.URL.revokeObjectURL(blobUrl);
                }
            })
            .catch(function (err) {
                clearInterval(timer);
                overlay.style.display = 'none';
                Swal.fire({ icon: 'error', title: _modelo.textos.error, text: err.message,
                            confirmButtonText: _modelo.textos.aceptar, confirmButtonColor: '#583AFF' });
            });
    }

    function mostrarErroresModelos(errores) {
        var html = '<div style="text-align:left;max-height:280px;overflow-y:auto;padding-right:4px;">';
        errores.forEach(function (e) {
            html += '<div style="margin-bottom:10px;padding:10px 12px;background:#fef2f2;border-left:4px solid #ef4444;border-radius:4px;">';
            html += '<strong style="color:#1f2937;">' + e.nombre + '</strong><br>';
            html += '<small style="color:#6b7280;">' + e.nombreSP + '</small><br>';
            html += '<span style="color:#dc2626;font-size:0.85em;">' + e.mensaje + '</span>';
            html += '</div>';
        });
        html += '</div>';

        Swal.fire({
            icon: 'error',
            title: _modelo.textos.erroresExportacion,
            html: html,
            width: 640,
            confirmButtonText: '<i class="fas fa-download mr-1"></i> ' + _modelo.textos.descargarLog,
            confirmButtonColor: '#583AFF',
            showCancelButton: true,
            cancelButtonText: _modelo.textos.cerrar,
            cancelButtonColor: '#6b7280'
        }).then(function (result) {
            if (!result.isConfirmed) return;
            var txt = 'ERRORES EN EXPORTACIÓN DE MODELOS\n';
            txt += '====================================\n\n';
            errores.forEach(function (e) {
                txt += 'Modelo   : ' + e.nombre + '\n';
                txt += 'SP       : ' + e.nombreSP + '\n';
                txt += 'Error    : ' + e.mensaje + '\n';
                txt += '------------------------------------\n\n';
            });
            var blob = new Blob([txt], { type: 'text/plain;charset=utf-8' });
            var bUrl = URL.createObjectURL(blob);
            var a    = document.createElement('a');
            a.href   = bUrl;
            a.download = 'ErroresExportacion_' + new Date().toISOString().slice(0, 10) + '.txt';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(bUrl);
        });
    }
</script>

@if (TempData["SuccessMessage"] != null)
{
    <script>
        $(function () {
            Swal.fire({ icon: 'success', title: _modelo.textos.exito,
                        text: '@Html.Raw(TempData["SuccessMessage"].ToString().Replace("'", "\\'"))',
                        confirmButtonText: _modelo.textos.aceptar, confirmButtonColor: '#583AFF' });
        });
    </script>
}
@if (TempData["ErrorMessage"] != null)
{
    <script>
        $(function () {
            Swal.fire({ icon: 'error', title: _modelo.textos.error,
                        text: '@Html.Raw(TempData["ErrorMessage"].ToString().Replace("'", "\\'"))',
                        confirmButtonText: _modelo.textos.aceptar, confirmButtonColor: '#583AFF' });
        });
    </script>
}

}
