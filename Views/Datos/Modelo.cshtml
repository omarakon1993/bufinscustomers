@model IEnumerable<bufinscustomers.Models.Empresas>
@using bufinscustomers.Helpers
@{
    var usuario = UsuarioSesionHelper.UsuarioActual;
    var esAdmin = usuario?.Admin == 1 || usuario?.Admin == 2;
    var idEmpresaUsuario = usuario?.IdEmpresa ?? 0;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Modelo</title>
    <script src="~/Assets/js/sweetalert2.all.min.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script src="~/Assets/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Assets/Scripts/bootstrap.bundle.min.js"></script>
</head>
<body>
    <style>
        .bg-primary {
            background-color: #583AFF !important;
        }

        /* === COLORES === */
        :root {
            --color-primario: #583AFF;
            --color-secundario: #01E1D7;
        }

        /* === ENCABEZADO CARD === */
        .card-header {
            background: linear-gradient(90deg, var(--color-primario), var(--color-secundario));
            color: white;
            padding: 1.2rem 1.5rem;
            font-weight: 600;
            font-size: 1.2rem;
        }

        .card-header i {
            margin-right: 8px;
        }
    </style>

    <div class="card shadow mb-4 mt-4">
        <div class="card-header">
            <i class="bi bi-gear-fill"></i> Ejecuci&oacute;n de modelos
        </div>
        <div class="card-body">
            <form id="modeloForm" method="post">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="idEmpresa" class="form-label">Empresa</label>
                            <select class="form-control" id="idEmpresa" name="idEmpresa" required>
                                <option value="" selected disabled>Seleccione una empresa</option>
                                @if (esAdmin)
                                {
                                    foreach (var empresa in Model)
                                    {
                                        <option value="@empresa.Id">@empresa.Nombre</option>
                                    }
                                }
                                else
                                {
                                    var empresaUsuario = Model.FirstOrDefault(e => e.Id == idEmpresaUsuario);
                                    if (empresaUsuario != null)
                                    {
                                        <option value="@empresaUsuario.Id">@empresaUsuario.Nombre</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="anio" class="form-label">A&ntilde;o</label>
                            <select class="form-control" id="anio" name="anio" required disabled>
                                <option value="" selected disabled>Seleccione una empresa primero</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary" id="btnEjecutarBalance" formaction="/Datos/EjecutarModeloBalance">
                        <i class="fas fa-scale-balanced"></i> Balance
                    </button>
                    <button type="submit" class="btn btn-primary" id="btnEjecutarPYG" formaction="/Datos/EjecutarModeloPYG">
                        <i class="fas fa-chart-line"></i> PYG
                    </button>
                    <button type="submit" class="btn btn-primary" id="btnEjecutarFlujoCaja">
                        <i class="fas fa-arrow-right-arrow-left"></i> Flujo de caja
                    </button>
                    <button type="submit" class="btn btn-primary" id="btnEjecutarEbitda">
                        <i class="fas fa-chart-column"></i> Ebitda
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            const isMobile = window.innerWidth <= 768;
            Swal.fire({
                toast: true,
                position: isMobile ? 'top' : 'top-end',
                icon: 'error',
                title: '@TempData["ErrorMessage"]',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer);
                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                }
            });
        </script>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            const isMobile = window.innerWidth <= 768;
            Swal.fire({
                toast: true,
                position: isMobile ? 'top' : 'top-end',
                icon: 'success',
                title: '@TempData["SuccessMessage"]',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer);
                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                }
            });
        </script>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <script>
            const isMobile = window.innerWidth <= 768;
            Swal.fire({
                toast: true,
                position: isMobile ? 'top' : 'top-end',
                icon: 'info',
                title: '@TempData["InfoMessage"]',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer);
                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                }
            });
        </script>
    }

    <script>
        $(document).ready(function () {
            $('#idEmpresa').on('change', function () {
                var idEmpresa = $(this).val();
                var $anio = $('#anio');

                if (!idEmpresa) {
                    $anio.html('<option value="" selected disabled>Seleccione una empresa primero</option>');
                    $anio.prop('disabled', true);
                    return;
                }

                $anio.html('<option value="" selected disabled>Cargando...</option>');
                $anio.prop('disabled', true);

                $.ajax({
                    url: '/Datos/ObtenerAnioEjecucion',
                    type: 'GET',
                    data: { idEmpresa: idEmpresa },
                    success: function (response) {
                        if (response.success) {
                            $anio.html('<option value="' + response.anioEjecucion + '" selected>' + response.anioEjecucion + '</option>');
                            $anio.prop('disabled', false);
                        } else {
                            $anio.html('<option value="" selected disabled>' + response.message + '</option>');
                            $anio.prop('disabled', true);
                        }
                    },
                    error: function () {
                        $anio.html('<option value="" selected disabled>Error al cargar el a&ntilde;o</option>');
                        $anio.prop('disabled', true);
                    }
                });
            });
        });
    </script>
</body>
</html>