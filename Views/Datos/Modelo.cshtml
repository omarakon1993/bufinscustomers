@model bufinscustomers.Models.ModeloPageViewModel
@using bufinscustomers.Helpers
@{
    ViewBag.Title = Resources.Strings.Modelo_PageTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var usuario = UsuarioSesionHelper.UsuarioActual;
    var esAdmin = usuario?.Admin == 1 || usuario?.Admin == 2;
    var idEmpresaUsuario = usuario?.IdEmpresa ?? 0;
}

<link href="~/Assets/css/bufins-components.css" rel="stylesheet" />

<div class="container-fluid px-4 mc-page">

    <!-- Header Power BI -->
    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas fa-database powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@Resources.Strings.Modelo_PageTitle</h1>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <!-- Barra de trabajo -->
    <div class="mc-toolbar">

        <!-- Fila 1: filtros -->
        <div class="mc-toolbar-row">

            <div class="mc-field">
                <label for="idEmpresa">
                    @Resources.Strings.Modelo_LabelEmpresa <span class="required">*</span>
                </label>
                <select class="form-control" id="idEmpresa" autocomplete="off">
                    <option value="">@Resources.Strings.Modelo_SelectEmpresa</option>
                    @if (esAdmin)
                    {
                        foreach (var empresa in Model.Empresas)
                        {
                            <option value="@empresa.Id" data-nombre="@empresa.Nombre">@empresa.Nombre</option>
                        }
                    }
                    else
                    {
                        var emp = Model.Empresas.FirstOrDefault(e => e.Id == idEmpresaUsuario);
                        if (emp != null)
                        {
                            <option value="@emp.Id" data-nombre="@emp.Nombre">@emp.Nombre</option>
                        }
                    }
                </select>
            </div>

            <div class="mc-field">
                <label for="idEscenario">
                    @Resources.Strings.Modelo_LabelEscenario
                </label>
                <select class="form-control" id="idEscenario" autocomplete="off">
                    @if (ViewBag.Escenarios != null)
                    {
                        foreach (var escenario in ViewBag.Escenarios)
                        {
                            <option value="@escenario.Id">@escenario.Nombre</option>
                        }
                    }
                </select>
            </div>
        </div>

        <!-- Selector de modelos: tarjetas seleccionables — uno, varios o todos -->
        <div class="mc-modelos-panel">
            <div class="mc-modelos-panel-head">
                <span class="mc-modelos-panel-title">
                    <i class="fas fa-cubes mr-1"></i>@Resources.Strings.Modelo_LabelModelo <span class="required">*</span>
                </span>
                <div class="mc-modelos-panel-actions">
                    <span class="mc-modelos-contador" id="modeloContador">@Resources.Strings.Modelo_Picker_Placeholder</span>
                    <label class="mc-chip-todos" id="modeloSelAllChip">
                        <input type="checkbox" id="modeloSelAll">
                        <i class="fas fa-check-double mr-1"></i>@Resources.Strings.Modelo_Correo_SelTodos
                    </label>
                </div>
            </div>
            <div class="mc-modelos-grid" id="modeloGrid">
                @foreach (var m in Model.Modelos)
                {
                    <label class="mc-modelo-card" title="@(m.Descripcion ?? m.Nombre)">
                        <input type="checkbox" class="mc-modelo-pick" value="@m.Id"
                               data-nombre="@m.Nombre"
                               data-descripcion="@(m.Descripcion ?? "")"
                               data-icono="@(m.Icono ?? "fas fa-cog")">
                        <span class="mc-modelo-card-check"><i class="fas fa-check"></i></span>
                        <span class="mc-modelo-card-icon"><i class="@(m.Icono ?? "fas fa-cog")"></i></span>
                        <span class="mc-modelo-card-texto">
                            <span class="mc-modelo-card-nombre">@m.Nombre</span>
                            @if (!string.IsNullOrEmpty(m.Descripcion))
                            {
                                <span class="mc-modelo-card-desc">@m.Descripcion</span>
                            }
                        </span>
                    </label>
                }
            </div>
        </div>

        <!-- Fila 2: acciones -->
        <div class="mc-toolbar-row mc-toolbar-acciones">

            <button type="button" id="btnEjecutar" class="mc-btn-primary" disabled onclick="ejecutarModelo()"
                    title="@Resources.Strings.Modelo_Ejecutar_RequiereUno">
                <span class="mc-ico"><i class="fas fa-play mr-1"></i></span><span id="btnTexto">@Resources.Strings.Modelo_BtnEjecutar</span>
            </button>

            <button type="button" id="btnExportarTodos" class="mc-btn-solid excel" disabled
                    onclick="exportarModelos()" title="@Resources.Strings.Modelo_BtnExportTooltip">
                <span class="mc-ico"><i id="btnExportarTodosIcono" class="fas fa-layer-group mr-1"></i></span><span id="btnExportarTodosTexto">@Resources.Strings.Modelo_BtnExportarTodos</span>
            </button>

            <button type="button" id="btnEnviarCorreo" class="mc-btn-solid mail" disabled
                    onclick="abrirModalCorreo()" title="@Resources.Strings.Modelo_BtnEnviarTooltip">
                <span class="mc-ico"><i class="fas fa-paper-plane mr-1"></i></span><span>@Resources.Strings.Modelo_BtnEnviarCorreo</span>
            </button>
        </div>

    </div>

    <div id="avisoSinDatosEscenario" class="alert alert-warning" role="alert" style="display:none;border-left: 4px solid #f6c23e;">
        <div style="display:flex;align-items:center;">
            <i class="fas fa-exclamation-triangle mr-3" style="font-size:1.2rem;"></i>
            <div>@Resources.Strings.Modelo_AvisoSinDatosEscenario</div>
        </div>
    </div>

    <!-- Loading (ejecución AJAX) -->
    <div id="loadingEjecucion" style="display:none;text-align:center;padding:2.5rem;">
        <div class="spinner-border text-primary" style="width:3rem;height:3rem;" role="status"></div>
        <p class="mt-3 text-muted fw-semibold">@Resources.Strings.Modelo_JS_Ejecutando</p>
    </div>

    <!-- Overlay exportación (fetch/blob) -->
    <div id="overlayExportacion" class="overlay-cargando" style="display:none;">
        <div class="overlay-cargando-card">
            @Html.Partial("_LoaderDots", "aqua")
            <h5 id="overlayTitulo" class="overlay-cargando-title">@Resources.Strings.Modelo_JS_ExportandoTodos</h5>
            <p class="overlay-cargando-text mb-0" id="overlayTimerTexto">0s</p>
        </div>
    </div>

    <!-- Estado inicial: aun no se ha ejecutado ninguna consulta -->
    <div id="estadoInicial" class="empty-state-initial">
        <div class="empty-state-initial-icon"><i class="fas fa-table"></i></div>
        <h4>@Resources.Strings.Common_EstadoInicialTitulo</h4>
        <p>@Resources.Strings.Modelo_EstadoInicialDesc</p>
    </div>

    <div id="resultadosAnchor"></div>

    <!-- Cápsulas de navegación entre los modelos consultados (solo si se consultó más de uno) -->
    <div id="resultadosTabs" class="mc-tabs" style="display:none;"></div>

    <!-- Barra de filtros — SOLO afecta la tabla de resultados de abajo, nunca la consulta al
         servidor. Colapsada por defecto (un botón); el panel se abre bajo demanda para no
         ocupar espacio permanente encima de la tabla. Vive fuera de .mc-table-card a propósito:
         esa tarjeta tiene overflow:hidden (por las esquinas redondeadas) y recortaría el panel. -->
    <div class="mc-filtro-bar" id="mcFiltroBar" style="display:none;">
        <button type="button" class="mc-filtro-toggle" id="mcFiltroToggle" aria-expanded="false">
            <i class="fas fa-filter"></i>
            <span>@Resources.Strings.Modelo_Filtro_Btn</span>
            <span class="mc-filtro-badge" id="mcFiltroBadge" style="display:none;">0</span>
            <i class="fas fa-chevron-down mc-filtro-caret"></i>
        </button>

        <div class="mc-filtro-panel" id="mcFiltroPanel" hidden>
            <div class="mc-filtro-seccion">
                <label><i class="fas fa-search mr-1"></i>@Resources.Strings.Modelo_Filtro_Buscar</label>
                <div class="mc-search">
                    <i class="fas fa-search"></i>
                    <input type="text" id="filtroResultados" autocomplete="off"
                           placeholder="@Resources.Strings.Modelo_FiltrarResultados">
                </div>
            </div>

            <div class="mc-filtro-sep"></div>

            <div class="mc-filtro-seccion">
                <label><i class="fas fa-sliders-h mr-1"></i>@Resources.Strings.Modelo_Filtro_PorCampo</label>
                <div class="mc-filtro-builder">
                    <select id="mcFiltroCampo" class="form-control form-control-sm"></select>
                    <select id="mcFiltroOperador" class="form-control form-control-sm"></select>
                    <input type="text" id="mcFiltroValor" class="form-control form-control-sm"
                           placeholder="@Resources.Strings.Modelo_Filtro_Valor">
                    <button type="button" id="mcFiltroAgregar" class="mc-filtro-add" title="@Resources.Strings.Modelo_Filtro_Agregar">
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
                <div class="mc-filtro-chips" id="mcFiltroChips"></div>
            </div>

            <div class="mc-filtro-foot">
                <button type="button" id="mcFiltroLimpiar" class="mc-filtro-limpiar">
                    <i class="fas fa-eraser mr-1"></i>@Resources.Strings.Common_Limpiar
                </button>
            </div>
        </div>
    </div>

    <!-- Resultados del modelo activo -->
    <div id="resultadosSection" style="display:none;">
        <div class="mc-table-card">
            <div class="mc-table-head">
                <i id="resultadosIcono" class="fas fa-table mc-table-head-icon"></i>
                <span id="resultadosTitulo" class="mc-table-head-title">@Resources.Strings.Modelo_Resultados</span>
                <span id="mcContexto" class="mc-table-head-ctx"></span>
                <span id="resultadosContador" class="mc-table-head-count" style="display:none;"></span>
            </div>
            <div class="mc-table-wrapper">
                <table class="mc-table">
                    <thead id="resultadosThead"></thead>
                    <tbody id="resultadosTbody"></tbody>
                </table>
            </div>
            <div class="mc-table-foot">
                <span class="mc-range" id="mcRango"></span>
                <div class="pagination-controls mc-pag" id="paginacionControls" style="display:none;padding:0;margin:0;border:none;"></div>
            </div>
        </div>
    </div>

    <!-- Estado vacío / error del modelo activo -->
    <div id="noResultados" style="display:none;">
        <div class="no-data-message">
            <i id="noResultadosIcono" class="fas fa-inbox"></i>
            <h4 id="noResultadosTitulo">@Resources.Strings.Modelo_NoResultados</h4>
            <p id="noResultadosDesc">@Resources.Strings.Modelo_NoResultadosDesc</p>
        </div>
    </div>

    <!-- Modal: enviar modelos por correo -->
    <div class="modal fade" id="modalEnviarCorreo" tabindex="-1" role="dialog" aria-labelledby="modalEnviarCorreoLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalEnviarCorreoLabel">
                        <i class="fas fa-paper-plane mr-2" style="color:#583AFF;"></i>@Resources.Strings.Modelo_Correo_ModalTitle
                    </h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p class="text-muted mb-3" style="font-size:0.85rem;">
                        <i class="fas fa-building mr-1" style="color:#583AFF;"></i>
                        @Resources.Strings.Modelo_LabelEmpresa: <strong id="correoEmpresaNombre">-</strong>
                        &nbsp;&middot;&nbsp;
                        <i class="fas fa-layer-group mr-1" style="color:#583AFF;"></i>
                        @Resources.Strings.Modelo_Correo_LabelEscenario: <strong id="correoEscenarioNombre">-</strong>
                    </p>

                    <div class="form-group">
                        <label>
                            <i class="fas fa-cubes mr-1"></i>@Resources.Strings.Modelo_Correo_LabelModelos
                        </label>
                        <div class="mc-correo-modelos-resumen" id="correoModelosResumen"></div>
                        <small class="form-text text-muted">
                            <i class="fas fa-info-circle mr-1"></i>@Resources.Strings.Modelo_Correo_ResumenHint
                        </small>
                    </div>

                    <div class="form-group">
                        <label for="correoDestino">
                            <i class="fas fa-at mr-1"></i>@Resources.Strings.Modelo_Correo_LabelDestino <span class="required">*</span>
                        </label>
                        <input type="text" class="form-control" id="correoDestino" autocomplete="off"
                               placeholder="@Resources.Strings.Modelo_Correo_PlaceholderDestino">
                        <small class="form-text text-muted">@Resources.Strings.Modelo_Correo_HintDestino</small>
                    </div>

                    <div class="form-group mb-0">
                        <label for="correoMensaje">
                            <i class="fas fa-align-left mr-1"></i>@Resources.Strings.Modelo_Correo_LabelMensaje
                        </label>
                        <textarea class="form-control" id="correoMensaje" rows="2" maxlength="1000"
                                  placeholder="@Resources.Strings.Modelo_Correo_PlaceholderMensaje"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i>@Resources.Strings.Layout_Cancel
                    </button>
                    <button type="button" class="btn btn-primary btn-sm" id="btnEnviarCorreoConfirmar" onclick="enviarModelosCorreo()">
                        <i class="fas fa-paper-plane mr-1"></i>@Resources.Strings.Modelo_Correo_BtnEnviar
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

@section scripts {

<script>
    var _modelo = {
        urlEjecutar:          '@Url.Action("EjecutarModeloAjax",         "Datos")',
        urlExportarTodos:     '@Url.Action("ExportarTodosModelos",       "Datos")',
        urlExportarIndividual:'@Url.Action("ExportarModeloIndividual",   "Datos")',
        urlExportarSeleccionados:'@Url.Action("ExportarModelosSeleccionados", "Datos")',
        urlEnviarCorreo:      '@Url.Action("EnviarModelosPorCorreo",     "Datos")',
        urlAniosConDatos:     '@Url.Action("ObtenerAniosConDatos",       "Datos")',
        token: $('input[name="__RequestVerificationToken"]').val(),
        textos: {
            correoEnviando:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Correo_Enviando))',
            correoExitoTitulo:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Correo_ExitoTitulo))',
            correoValModelos:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Correo_ValModelos))',
            correoValCorreo:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Correo_ValCorreo))',
            ejecutando:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_JS_Ejecutando))',
            exportandoTodos:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_JS_ExportandoTodos))',
            exportandoUno:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_BtnExportarModelo))',
            exportandoSeleccionados: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_JS_ExportandoSeleccionados))',
            registros:        '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Registros))',
            btnEjecutar:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_BtnEjecutar))',
            btnExportarTodos:        '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_BtnExportarTodos))',
            btnDescargarModeloFmt:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_BtnDescargarModeloFmt))',
            btnExportarSeleccionadosFmt: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_BtnExportarSeleccionadosFmt))',
            exportTooltipTodos:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_BtnExportTooltip))',
            exportTooltipSeleccionado: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_BtnExportTooltipSeleccionado))',
            exportadosOk:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_JS_ExportadosOk))',
            exito:              '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Exito))',
            error:              '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Error))',
            aceptar:            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Aceptar))',
            erroresExportacion: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_JS_ErroresExportacion))',
            descargarLog:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_JS_DescargarLog))',
            cerrar:             '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_JS_Cerrar))',
            pickerPlaceholder:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Picker_Placeholder))',
            pickerTodos:        '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Picker_Todos))',
            pickerVariosFmt:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Picker_VariosFmt))',
            resultadosTitulo:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Resultados))',
            btnConsultarUnoFmt:          '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_BtnConsultarUnoFmt))',
            btnConsultarSeleccionadosFmt:'@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_BtnConsultarSeleccionadosFmt))',
            btnConsultarTodos:           '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_BtnConsultarTodos))',
            ejecutarTooltip:             '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Ejecutar_RequiereUno))',
            ejecutandoMultiFmt:          '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_JS_EjecutandoMultiFmt))',
            errorConexionConsulta:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_JS_ErrorConexionConsulta))',
            exportTooltipMultiple:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_BtnExportTooltipMultiple))',
            noResultadosTitulo:          '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_NoResultados))',
            noResultadosDesc:            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_NoResultadosDesc))',
            filtroSelectCampo: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Filtro_SelectCampo))',
            filtroChipValorFmt:'@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Filtro_ChipValorFmt))',
            opContiene:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Filtro_Op_Contiene))',
            opNoContiene: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Filtro_Op_NoContiene))',
            opIgual:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Filtro_Op_Igual))',
            opEmpieza:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Filtro_Op_Empieza))',
            opTermina:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Filtro_Op_Termina))',
            opMayor:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Filtro_Op_Mayor))',
            opMayorIgual: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Filtro_Op_MayorIgual))',
            opMenor:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Filtro_Op_Menor))',
            opMenorIgual: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Modelo_Filtro_Op_MenorIgual))'
        }
    };

    var _moneyColSet = { 'valor': true, 'valoracumulado': true, 'valorfuturo': true, 'valorpresupuesto': true, 'valorpresupuestoacumulado': true, 'valorpresupuestoconajuste': true };

    // ── Estado de paginación ──────────────────────────────────────────────
    var _pag = {
        filas:      [],
        filasVista: [],   // filas tras aplicar los filtros de la tabla (búsqueda general + por campo)
        columnas:   [],
        pagina:     1,
        porPagina:  50,
        idModelo:   null,
        idEmpresa:  null
    };

    // ── Filtros de la tabla de resultados ─────────────────────────────────
    // Dos mecanismos que se combinan con AND: una búsqueda de texto libre sobre TODAS las
    // columnas (_busquedaGlobal) y una lista de filtros por campo específico (_filtrosCampo),
    // cada uno con su propio operador según el tipo de columna (texto vs. numérica/dinero).
    var _busquedaGlobal = '';
    var _filtrosCampo   = [];   // { campoIdx, campoNombre, operador, operadorLabel, valor, esNum }

    function operadoresParaColumna(esNum) {
        return esNum
            ? [
                  { value: 'igual',      label: _modelo.textos.opIgual },
                  { value: 'mayor',      label: _modelo.textos.opMayor },
                  { value: 'mayorigual', label: _modelo.textos.opMayorIgual },
                  { value: 'menor',      label: _modelo.textos.opMenor },
                  { value: 'menorigual', label: _modelo.textos.opMenorIgual }
              ]
            : [
                  { value: 'contiene',   label: _modelo.textos.opContiene },
                  { value: 'nocontiene', label: _modelo.textos.opNoContiene },
                  { value: 'igual',      label: _modelo.textos.opIgual },
                  { value: 'empieza',    label: _modelo.textos.opEmpieza },
                  { value: 'termina',    label: _modelo.textos.opTermina }
              ];
    }

    // Se llama cada vez que se muestra una tabla nueva (nuevo modelo consultado o cambio de
    // cápsula): las columnas cambian de un modelo a otro, así que los filtros de campo de la
    // tabla anterior ya no tendrían sentido y se descartan junto con la búsqueda de texto.
    function reiniciarFiltrosTabla(columnas) {
        _busquedaGlobal = '';
        _filtrosCampo   = [];
        $('#filtroResultados').val('');
        $('#mcFiltroPanel').prop('hidden', true);
        $('#mcFiltroToggle').attr('aria-expanded', 'false').removeClass('is-open');

        var opciones = '<option value="">' + _modelo.textos.filtroSelectCampo + '</option>';
        for (var i = 0; i < columnas.length; i++) {
            opciones += '<option value="' + i + '">' + $('<span>').text(columnas[i]).html() + '</option>';
        }
        $('#mcFiltroCampo').html(opciones);
        poblarOperadoresParaCampo();
        pintarChipsFiltro();
    }

    // Repuebla el <select> de operadores según si la columna elegida es numérica/dinero o texto.
    function poblarOperadoresParaCampo() {
        var idx = $('#mcFiltroCampo').val();
        var esNum = idx !== '' && !!_moneyColSet[(_pag.columnas[idx] || '').toLowerCase()];
        var ops = operadoresParaColumna(esNum);
        $('#mcFiltroOperador').html(ops.map(function (o) {
            return '<option value="' + o.value + '">' + o.label + '</option>';
        }).join(''));
    }

    // Agrega un filtro por campo a la lista (no reemplaza los existentes: se pueden combinar
    // varios filtros, incluso sobre el mismo campo, todos exigidos a la vez — AND).
    function agregarFiltroCampo() {
        var idx = $('#mcFiltroCampo').val();
        var valor = ($('#mcFiltroValor').val() || '').trim();
        if (idx === '' || idx == null || !valor) return;

        var campoNombre  = _pag.columnas[idx];
        var esNum        = !!_moneyColSet[(campoNombre || '').toLowerCase()];
        var operador     = $('#mcFiltroOperador').val();
        var operadorLabel = $('#mcFiltroOperador option:selected').text();

        _filtrosCampo.push({
            campoIdx: parseInt(idx, 10), campoNombre: campoNombre,
            operador: operador, operadorLabel: operadorLabel, valor: valor, esNum: esNum
        });

        $('#mcFiltroValor').val('').focus();
        pintarChipsFiltro();
        aplicarFiltrosYRender();
    }

    // Pinta los "chips" removibles de los filtros de campo activos + el badge con el total
    // (búsqueda general cuenta como 1 más, si tiene texto).
    function pintarChipsFiltro() {
        var html = _filtrosCampo.map(function (f, i) {
            return '<span class="mc-filtro-chip" data-idx="' + i + '">' +
                   '<strong>' + $('<span>').text(f.campoNombre).html() + '</strong> ' +
                   $('<span>').text(f.operadorLabel).html() + ' ' +
                   _modelo.textos.filtroChipValorFmt.replace('{0}', $('<span>').text(f.valor).html()) +
                   '<button type="button" class="mc-filtro-chip-x"><i class="fas fa-times"></i></button>' +
                   '</span>';
        }).join('');
        $('#mcFiltroChips').html(html);

        var total = _filtrosCampo.length + (_busquedaGlobal ? 1 : 0);
        $('#mcFiltroBadge').text(total).toggle(total > 0);
        $('#mcFiltroToggle').toggleClass('has-filtros', total > 0);
    }

    // Evalúa un único filtro de campo contra el valor de una celda.
    function evaluarFiltroCampo(valorCelda, f) {
        if (f.esNum) {
            var n = parseFloat(valorCelda);
            var fv = parseFloat(f.valor.replace(',', '.'));
            if (isNaN(n) || isNaN(fv)) return false;
            switch (f.operador) {
                case 'igual':      return n === fv;
                case 'mayor':      return n > fv;
                case 'mayorigual': return n >= fv;
                case 'menor':      return n < fv;
                case 'menorigual': return n <= fv;
            }
            return true;
        }
        var s  = String(valorCelda == null ? '' : valorCelda).toLowerCase();
        var fv2 = f.valor.toLowerCase();
        switch (f.operador) {
            case 'contiene':   return s.indexOf(fv2) >= 0;
            case 'nocontiene': return s.indexOf(fv2) < 0;
            case 'igual':      return s === fv2;
            case 'empieza':    return s.indexOf(fv2) === 0;
            case 'termina':    return s.length >= fv2.length && s.slice(-fv2.length) === fv2;
        }
        return true;
    }

    // Combina (AND) la búsqueda general + todos los filtros de campo sobre _pag.filas y
    // repinta la primera página del resultado. Es la única puerta de entrada para filtrar:
    // tanto el buscador general como el constructor de filtros por campo pasan por aquí.
    function aplicarFiltrosYRender() {
        var datos = _pag.filas;

        if (_busquedaGlobal) {
            datos = datos.filter(function (fila) {
                return fila.some(function (celda) {
                    return String(celda == null ? '' : celda).toLowerCase().indexOf(_busquedaGlobal) >= 0;
                });
            });
        }

        _filtrosCampo.forEach(function (f) {
            datos = datos.filter(function (fila) { return evaluarFiltroCampo(fila[f.campoIdx], f); });
        });

        _pag.filasVista = datos;
        renderPagina(1);
    }

    // ── Selector de modelos (uno o varios) ───────────────────────────────
    function modelosSeleccionados() {
        return $('.mc-modelo-pick:checked').map(function () { return this.value; }).get();
    }

    // Resalta visualmente las tarjetas marcadas (borde/fondo de marca vía clase .is-selected).
    function actualizarTarjetasModelo() {
        $('.mc-modelo-card').each(function () {
            var $card = $(this);
            $card.toggleClass('is-selected', $card.find('.mc-modelo-pick').is(':checked'));
        });
    }

    // Repinta el contador/resumen de la selección y el chip "Seleccionar todos" (tri-estado).
    function pintarContadorModelos() {
        var sel   = modelosSeleccionados();
        var total = $('.mc-modelo-pick').length;
        var $ctd  = $('#modeloContador');

        if (sel.length === 0) {
            $ctd.text(_modelo.textos.pickerPlaceholder).removeClass('has-sel');
        } else if (sel.length === 1) {
            $ctd.text($('.mc-modelo-pick:checked').data('nombre')).addClass('has-sel');
        } else if (sel.length === total) {
            $ctd.text(_modelo.textos.pickerTodos).addClass('has-sel');
        } else {
            $ctd.text(_modelo.textos.pickerVariosFmt.replace('{0}', sel.length)).addClass('has-sel');
        }

        $('#modeloSelAll')
            .prop('checked', sel.length > 0 && sel.length === total)
            .prop('indeterminate', sel.length > 0 && sel.length < total);
        $('#modeloSelAllChip').toggleClass('is-partial', sel.length > 0 && sel.length < total);
    }

    // Cambió la selección de modelos: tarjetas, contador y botones.
    function onModelosChange() {
        actualizarTarjetasModelo();
        pintarContadorModelos();
        actualizarBotones();
    }

    var _sinDatosEscenario = false;

    // Los tres botones de acción solo se habilitan cuando hay empresa + al menos un modelo
    // marcado (con el chulito) — nunca se asume "todos" por selección vacía: lo que se
    // consulta/exporta/envía es exactamente lo que está marcado arriba.
    function actualizarBotones() {
        var tieneEmpresa = !!$('#idEmpresa').val();
        var nSel = modelosSeleccionados().length;
        var habilitado = tieneEmpresa && !_sinDatosEscenario && nSel > 0;
        $('#btnEjecutar').prop('disabled', !habilitado);
        $('#btnExportarTodos').prop('disabled', !habilitado);
        $('#btnEnviarCorreo').prop('disabled', !habilitado);
        actualizarBotonConsultar();
        actualizarBotonExportar();
    }

    // Texto del botón "Consultar", igual de dinámico que el de exportar:
    // 1 modelo → "Consultar <nombre>"; varios (no todos) → "Consultar N modelos seleccionados";
    // todos → "Consultar todos los modelos"; ninguno → texto genérico (botón deshabilitado).
    function actualizarBotonConsultar() {
        if (_consultando) return; // no pisar el texto de progreso ("Consultando X de Y…")

        var sel   = modelosSeleccionados();
        var total = $('.mc-modelo-pick').length;

        if (sel.length === 1) {
            var txtUno = _modelo.textos.btnConsultarUnoFmt.replace('{0}', $('.mc-modelo-pick:checked').data('nombre'));
            $('#btnTexto').text(txtUno);
            $('#btnEjecutar').attr('title', txtUno);
        } else if (sel.length > 1 && sel.length < total) {
            $('#btnTexto').text(_modelo.textos.btnConsultarSeleccionadosFmt.replace('{0}', sel.length));
            $('#btnEjecutar').attr('title', _modelo.textos.ejecutarTooltip);
        } else if (sel.length === total && total > 0) {
            $('#btnTexto').text(_modelo.textos.btnConsultarTodos);
            $('#btnEjecutar').attr('title', _modelo.textos.btnConsultarTodos);
        } else {
            $('#btnTexto').text(_modelo.textos.btnEjecutar);
            $('#btnEjecutar').attr('title', _modelo.textos.ejecutarTooltip);
        }
    }

    // Verifica si la empresa/escenario elegidos tienen datos cargados (reutiliza el mismo
    // endpoint que usa "Plantilla con datos" en Cargue de Excel) y muestra un aviso en vez de
    // dejar que el usuario dispare un error del procedimiento almacenado al ejecutar/exportar.
    //
    // _verifSeq evita una condición de carrera: si el usuario cambia la selección varias veces
    // seguidas (o la vuelve a dejar en blanco) mientras una consulta anterior sigue en camino,
    // esa respuesta "vieja" ya no puede pintar el aviso — solo cuenta la última llamada emitida.
    var _verifSeq = 0;

    function verificarDatosEscenario() {
        var idEmpresa = $('#idEmpresa').val();
        var idEscenario = $('#idEscenario').val();
        var seq = ++_verifSeq;

        if (!idEmpresa) {
            _sinDatosEscenario = false;
            $('#avisoSinDatosEscenario').hide();
            actualizarBotones();
            return;
        }

        $.get(_modelo.urlAniosConDatos, { idEmpresa: idEmpresa, idEscenario: idEscenario })
            .done(function (data) {
                if (seq !== _verifSeq) return; // respuesta obsoleta: ya hubo un cambio posterior
                _sinDatosEscenario = !(data && data.success && data.anios && data.anios.length > 0);
                $('#avisoSinDatosEscenario').toggle(_sinDatosEscenario);
                actualizarBotones();
            })
            .fail(function () {
                if (seq !== _verifSeq) return;
                _sinDatosEscenario = false;
                $('#avisoSinDatosEscenario').hide();
                actualizarBotones();
            });
    }

    // Texto/ícono del botón de exportación, según lo marcado en el panel de modelos:
    // 1 modelo → "Exportar <nombre>"; varios (no todos) → "Exportar N modelos seleccionados";
    // todos → "Exportar todos los modelos"; ninguno → texto genérico (botón deshabilitado).
    function actualizarBotonExportar() {
        var sel   = modelosSeleccionados();
        var total = $('.mc-modelo-pick').length;

        if (sel.length === 1) {
            var txtUno = _modelo.textos.btnDescargarModeloFmt.replace('{0}', $('.mc-modelo-pick:checked').data('nombre'));
            $('#btnExportarTodosIcono').attr('class', 'fas fa-file-excel mr-1');
            $('#btnExportarTodosTexto').text(txtUno);
            $('#btnExportarTodos').attr('title', txtUno);   // nombre completo al pasar el ratón (el botón lo recorta)
        } else if (sel.length > 1 && sel.length < total) {
            $('#btnExportarTodosIcono').attr('class', 'fas fa-file-excel mr-1');
            $('#btnExportarTodosTexto').text(_modelo.textos.btnExportarSeleccionadosFmt.replace('{0}', sel.length));
            $('#btnExportarTodos').attr('title', _modelo.textos.exportTooltipMultiple);
        } else if (sel.length === total && total > 0) {
            $('#btnExportarTodosIcono').attr('class', 'fas fa-layer-group mr-1');
            $('#btnExportarTodosTexto').text(_modelo.textos.btnExportarTodos);
            $('#btnExportarTodos').attr('title', _modelo.textos.exportTooltipTodos);
        } else {
            $('#btnExportarTodosIcono').attr('class', 'fas fa-layer-group mr-1');
            $('#btnExportarTodosTexto').text(_modelo.textos.btnExportarTodos);
            $('#btnExportarTodos').attr('title', _modelo.textos.exportTooltipTodos);
        }
    }

    // Blindaje del estado inicial: por si el navegador restaura la selección de un <select>
    // (tras un refresh F5, o al volver con el botón Atrás/Adelante desde el caché bfcache) sin
    // disparar 'change', se re-sincroniza el aviso contra el valor real que haya quedado en los
    // selects — en vez de solo ocultarlo a ciegas, que dejaba mostrado un aviso "congelado" de
    // una visita anterior cuando la página volvía a mostrarse vía bfcache (evento que NO reejecuta
    // $(document).ready, así que los tres intentos previos de arreglo no cubrían este caso).
    function reiniciarAvisoEscenario() {
        if ($('#idEmpresa').val()) {
            verificarDatosEscenario();
        } else {
            _sinDatosEscenario = false;
            $('#avisoSinDatosEscenario').hide();
            actualizarBotones();
        }
    }

    // 'pageshow' se dispara tanto en la carga normal como al volver a esta página restaurada
    // desde el caché bfcache (botón Atrás/Adelante) — a diferencia de $(document).ready, que en
    // una restauración bfcache NO se vuelve a ejecutar. Sin esto, el aviso quedaba "congelado"
    // tal como estaba antes de navegar a otra pantalla y volver.
    window.addEventListener('pageshow', function (e) {
        if (e.persisted) reiniciarAvisoEscenario();
    });

    $(function () {

        reiniciarAvisoEscenario();

        $('#idEmpresa').on('change', function () { actualizarBotones(); verificarDatosEscenario(); });
        $('#idEscenario').on('change', verificarDatosEscenario);

        // ── Selector de modelos (tarjetas) ────────────────────────────────
        $('#modeloSelAll').on('change', function () {
            $('.mc-modelo-pick').prop('checked', this.checked);
            onModelosChange();
        });
        $(document).on('change', '.mc-modelo-pick', onModelosChange);

        // ── Cápsulas de navegación entre resultados de varios modelos ─────
        $(document).on('click', '.mc-tab', function () {
            if ($(this).hasClass('active')) return;
            activarResultadoModelo($(this).data('id'));
            $('html, body').animate({ scrollTop: $('#resultadosAnchor').offset().top - 90 }, 250);
        });

        // Nota: la única empresa se preselecciona sola, pero eso no cuenta como una elección
        // deliberada del usuario — solo se actualizan los botones, sin disparar todavía el
        // aviso de "sin datos" (ese se reserva para cuando el usuario realmente interactúa
        // con empresa/escenario, o al intentar ejecutar/exportar).
        if ($('#idEmpresa option').length === 2) {
            $('#idEmpresa option:last').prop('selected', true);
            actualizarBotones();
        }

        onModelosChange();

        // ── Filtros de la tabla de resultados (búsqueda general + por campo) ──────
        $('#mcFiltroToggle').on('click', function (e) {
            e.stopPropagation();
            var abierto = !$('#mcFiltroPanel').prop('hidden');
            $('#mcFiltroPanel').prop('hidden', abierto);
            $('#mcFiltroToggle').attr('aria-expanded', String(!abierto)).toggleClass('is-open', !abierto);
        });
        $(document).on('click', function (e) {
            if (!$(e.target).closest('#mcFiltroBar').length) {
                $('#mcFiltroPanel').prop('hidden', true);
                $('#mcFiltroToggle').attr('aria-expanded', 'false').removeClass('is-open');
            }
        });

        $('#filtroResultados').on('input', function () {
            _busquedaGlobal = ($(this).val() || '').toLowerCase().trim();
            aplicarFiltrosYRender();
        });

        $('#mcFiltroCampo').on('change', poblarOperadoresParaCampo);

        $('#mcFiltroAgregar').on('click', agregarFiltroCampo);
        $('#mcFiltroValor').on('keydown', function (e) {
            if (e.key === 'Enter') { e.preventDefault(); agregarFiltroCampo(); }
        });

        $(document).on('click', '.mc-filtro-chip .mc-filtro-chip-x', function () {
            var idx = $(this).closest('.mc-filtro-chip').data('idx');
            _filtrosCampo.splice(idx, 1);
            pintarChipsFiltro();
            aplicarFiltrosYRender();
        });

        $('#mcFiltroLimpiar').on('click', function () {
            _filtrosCampo = [];
            _busquedaGlobal = '';
            $('#filtroResultados').val('');
            pintarChipsFiltro();
            aplicarFiltrosYRender();
        });
    });

    // Pinta, dentro del modal de correo, los "chips" de solo lectura con los modelos que están
    // marcados arriba en el panel de tarjetas — ya no hay una lista propia que seleccionar aquí.
    function pintarResumenModelosCorreo() {
        var sel   = modelosSeleccionados();
        var total = $('.mc-modelo-pick').length;

        var html = sel.map(function (id) {
            var $c = $('.mc-modelo-pick[value="' + id + '"]');
            return '<span class="mc-chip-modelo"><i class="' + ($c.data('icono') || 'fas fa-cog') + '"></i>' +
                   $('<span>').text($c.data('nombre')).html() + '</span>';
        }).join('');
        $('#correoModelosResumen').html(html);
    }

    function abrirModalCorreo() {
        var idEmpresa = $('#idEmpresa').val();
        if (!idEmpresa || modelosSeleccionados().length === 0) return;

        $('#correoEmpresaNombre').text($('#idEmpresa option:selected').data('nombre') || $('#idEmpresa option:selected').text());
        $('#correoEscenarioNombre').text($('#idEscenario option:selected').text());

        pintarResumenModelosCorreo();

        // Recuerda el último destino usado.
        try {
            var last = localStorage.getItem('bufins_modelo_correo_dest');
            if (last && !$('#correoDestino').val()) $('#correoDestino').val(last);
        } catch (e) { }

        $('#modalEnviarCorreo').modal('show');
    }

    function enviarModelosCorreo() {
        var idEmpresa = $('#idEmpresa').val();
        if (!idEmpresa) return;

        var ids = modelosSeleccionados();
        if (ids.length === 0) {
            Swal.fire({ icon: 'warning', title: _modelo.textos.error, text: _modelo.textos.correoValModelos,
                        confirmButtonText: _modelo.textos.aceptar, confirmButtonColor: '#583AFF' });
            return;
        }

        var correosRaw = ($('#correoDestino').val() || '').trim();
        var tokens = correosRaw.split(/[,;\s]+/).filter(function (t) { return t.length > 0; });
        var rx = /^[^@@\s]+@@[^@@\s]+\.[^@@\s]+$/;
        if (tokens.length === 0 || !tokens.every(function (t) { return rx.test(t); })) {
            Swal.fire({ icon: 'warning', title: _modelo.textos.error, text: _modelo.textos.correoValCorreo,
                        confirmButtonText: _modelo.textos.aceptar, confirmButtonColor: '#583AFF' });
            return;
        }

        try { localStorage.setItem('bufins_modelo_correo_dest', correosRaw); } catch (e) { }

        var totalModelos = $('.mc-modelo-pick').length;
        var idsModelos = (ids.length === totalModelos) ? 'todos' : ids.join(',');

        $('#modalEnviarCorreo').modal('hide');

        document.getElementById('overlayTitulo').textContent = _modelo.textos.correoEnviando;
        var overlay = document.getElementById('overlayExportacion');
        overlay.style.display = 'flex';
        var segundos = 0;
        document.getElementById('overlayTimerTexto').textContent = '0s';
        var timer = setInterval(function () {
            segundos++;
            document.getElementById('overlayTimerTexto').textContent = segundos + 's';
        }, 1000);

        $.ajax({
            url: _modelo.urlEnviarCorreo,
            type: 'POST',
            data: {
                __RequestVerificationToken: _modelo.token,
                idEmpresa: idEmpresa,
                idsModelos: idsModelos,
                correos: correosRaw,
                mensaje: $('#correoMensaje').val() || '',
                idEscenario: $('#idEscenario').val()
            },
            success: function (resp) {
                clearInterval(timer);
                overlay.style.display = 'none';
                if (resp && resp.exito) {
                    Swal.fire({ icon: 'success', title: _modelo.textos.correoExitoTitulo, text: resp.mensaje,
                                confirmButtonText: _modelo.textos.aceptar, confirmButtonColor: '#583AFF' });
                } else if (resp && resp.errores) {
                    mostrarErroresModelos(resp.errores);
                } else {
                    Swal.fire({ icon: 'error', title: _modelo.textos.error, text: (resp && resp.mensaje) || 'Error',
                                confirmButtonText: _modelo.textos.aceptar, confirmButtonColor: '#583AFF' });
                }
            },
            error: function () {
                clearInterval(timer);
                overlay.style.display = 'none';
                Swal.fire({ icon: 'error', title: _modelo.textos.error,
                            text: 'Error de conexión al enviar el correo.',
                            confirmButtonText: _modelo.textos.aceptar, confirmButtonColor: '#583AFF' });
            }
        });
    }

    // ── Ejecutar modelo(s) (AJAX) ──────────────────────────────────────────
    // Consulta, en fila (una petición a la vez, sin saturar la BD), cada modelo marcado en el
    // panel de tarjetas. Con 1 solo modelo se comporta igual que antes; con varios, al terminar
    // se muestran cápsulas de navegación (una por modelo) para saltar entre sus tablas de
    // resultados sin perder ninguna.
    var _resultadosMulti = {};   // idModelo -> { nombre, icono, columnas, filas, error }
    var _idModeloActivo  = null;
    var _consultando     = false;

    function ejecutarModelo() {
        var idEmpresa = $('#idEmpresa').val();
        var sel = modelosSeleccionados();
        if (!idEmpresa || sel.length === 0 || _consultando) return;

        var idEscenario = $('#idEscenario').val();

        _consultando = true;
        _resultadosMulti = {};
        $('#estadoInicial').hide();
        $('#resultadosSection').hide();
        $('#noResultados').hide();
        $('#resultadosTabs').hide().empty();
        $('#loadingEjecucion').show();
        $('#btnEjecutar, #btnExportarTodos, #btnEnviarCorreo').prop('disabled', true);
        $('.mc-modelo-pick, #modeloSelAll').prop('disabled', true);
        $('#modeloGrid').addClass('is-disabled');

        var cola      = sel.slice();
        var totalCola = cola.length;

        function siguiente() {
            if (cola.length === 0) {
                _consultando = false;
                $('#loadingEjecucion').hide();
                $('.mc-modelo-pick, #modeloSelAll').prop('disabled', false);
                $('#modeloGrid').removeClass('is-disabled');
                actualizarBotones();
                mostrarResultadosConsulta(sel);
                return;
            }

            var idModelo = cola.shift();
            var indice   = totalCola - cola.length;
            var $c       = $('.mc-modelo-pick[value="' + idModelo + '"]');

            $('#btnTexto').text(
                totalCola > 1
                    ? _modelo.textos.ejecutandoMultiFmt.replace('{0}', indice).replace('{1}', totalCola)
                    : _modelo.textos.ejecutando
            );

            $.ajax({
                url:  _modelo.urlEjecutar,
                type: 'POST',
                data: {
                    __RequestVerificationToken: _modelo.token,
                    idEmpresa: idEmpresa,
                    idModelo:  idModelo,
                    idEscenario: idEscenario
                },
                success: function (resp) {
                    _resultadosMulti[idModelo] = {
                        nombre:   $c.data('nombre') || '',
                        icono:    $c.data('icono') || 'fas fa-table',
                        columnas: resp.exito ? resp.columnas : null,
                        filas:    resp.exito ? resp.filas : null,
                        error:    resp.exito ? null : (resp.mensaje || _modelo.textos.error)
                    };
                    siguiente();
                },
                error: function () {
                    _resultadosMulti[idModelo] = {
                        nombre: $c.data('nombre') || '', icono: $c.data('icono') || 'fas fa-table',
                        columnas: null, filas: null, error: _modelo.textos.errorConexionConsulta
                    };
                    siguiente();
                }
            });
        }
        siguiente();
    }

    // Al terminar la cola: arma las cápsulas (solo si se consultó más de un modelo) y activa
    // la primera pestaña con datos reales (o la primera de todas, si ninguna tuvo datos).
    function mostrarResultadosConsulta(ids) {
        if (ids.length > 1) {
            var html = ids.map(function (id) {
                var r = _resultadosMulti[id] || {};
                var conError = !r.filas || r.error || r.filas.length === 0;
                return '<button type="button" class="mc-tab' + (conError ? ' has-error' : '') + '" data-id="' + id + '">' +
                       '<i class="' + (r.icono || 'fas fa-table') + '"></i>' +
                       '<span>' + $('<span>').text(r.nombre || '').html() + '</span>' +
                       (conError ? '<i class="fas fa-exclamation-circle"></i>' : '') +
                       '</button>';
            }).join('');
            $('#resultadosTabs').html(html).show();
        } else {
            $('#resultadosTabs').hide().empty();
        }

        var primero = ids.filter(function (id) {
            var r = _resultadosMulti[id];
            return r && !r.error && r.filas && r.filas.length > 0;
        })[0];

        activarResultadoModelo(primero || ids[0]);
        $('html, body').animate({ scrollTop: $('#resultadosAnchor').offset().top - 90 }, 400);
    }

    // Pinta en la tarjeta de resultados los datos guardados del modelo elegido (cambia de
    // cápsula sin volver a consultar el servidor: todo quedó en memoria desde ejecutarModelo()).
    function activarResultadoModelo(idModelo) {
        _idModeloActivo = idModelo;
        $('.mc-tab').removeClass('active').filter('[data-id="' + idModelo + '"]').addClass('active');

        var r = _resultadosMulti[idModelo];

        if (!r || r.error) {
            $('#resultadosSection').hide();
            $('#mcFiltroBar').hide();
            $('#noResultadosIcono').attr('class', 'fas fa-exclamation-triangle');
            $('#noResultadosTitulo').text(_modelo.textos.error);
            $('#noResultadosDesc').text((r && r.error) || _modelo.textos.noResultadosDesc);
            $('#noResultados').show();
            return;
        }

        if (!r.columnas || r.columnas.length === 0 || !r.filas || r.filas.length === 0) {
            $('#resultadosSection').hide();
            $('#mcFiltroBar').hide();
            $('#noResultadosIcono').attr('class', 'fas fa-inbox');
            $('#noResultadosTitulo').text(_modelo.textos.noResultadosTitulo);
            $('#noResultadosDesc').text(_modelo.textos.noResultadosDesc);
            $('#noResultados').show();
            return;
        }

        $('#noResultados').hide();

        // Guardar estado de paginación
        _pag.filas      = r.filas;
        _pag.filasVista = r.filas;
        _pag.columnas   = r.columnas;
        _pag.pagina     = 1;
        _pag.idModelo   = idModelo;
        _pag.idEmpresa  = $('#idEmpresa').val();

        // Header de la tabla (alinea a la derecha las columnas de valor)
        var thead = '<tr>';
        for (var i = 0; i < r.columnas.length; i++) {
            var esNum = !!_moneyColSet[(r.columnas[i] || '').toLowerCase()];
            thead += '<th' + (esNum ? ' class="num"' : '') + '>' +
                     $('<span>').text(r.columnas[i]).html() + '</th>';
        }
        thead += '</tr>';
        $('#resultadosThead').html(thead);

        // Cabecera contextual de la tarjeta de resultados
        var nomEmpresa = $('#idEmpresa option:selected').data('nombre') ||
                         $('#idEmpresa option:selected').text();
        $('#resultadosIcono').attr('class', r.icono + ' mc-table-head-icon');
        $('#resultadosTitulo').text(r.nombre);
        $('#mcContexto').text(nomEmpresa || '');   // el separador lo pone .mc-table-head-ctx::before (CSS)
        $('#resultadosContador')
            .text(r.filas.length + ' ' + _modelo.textos.registros)
            .show();

        // La barra de filtros solo tiene sentido con una tabla en pantalla, y sus opciones de
        // campo dependen de las columnas de ESTE modelo — se reconstruye en cada activación.
        $('#mcFiltroBar').show();
        reiniciarFiltrosTabla(r.columnas);

        renderPagina(1);
        $('#resultadosSection').show();
    }

    // ── Paginación ────────────────────────────────────────────────────────
    function renderPagina(pagina) {
        _pag.pagina = pagina;
        var datos  = _pag.filasVista;
        var inicio = (pagina - 1) * _pag.porPagina;
        var fin    = Math.min(inicio + _pag.porPagina, datos.length);
        var slice  = datos.slice(inicio, fin);

        var tbody = '';
        for (var r = 0; r < slice.length; r++) {
            tbody += '<tr>';
            for (var c = 0; c < slice[r].length; c++) {
                var col   = (_pag.columnas[c] || '').toLowerCase();
                var esNum = !!_moneyColSet[col];
                var esKey = (col === 'cuentapuc' || col === 'codigo');
                var val   = slice[r][c];
                if (val !== '' && esNum) {
                    var num = parseFloat(val);
                    if (!isNaN(num))
                        val = num.toLocaleString('es-CO', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                }
                var cls = esNum ? ' class="num"' : (esKey ? ' class="key"' : '');
                tbody += '<td' + cls + '>' + $('<span>').text(val).html() + '</td>';
            }
            tbody += '</tr>';
        }
        $('#resultadosTbody').html(tbody);

        // Rango legible, p.ej. "1-50 de 2.268"
        $('#mcRango').text(
            datos.length === 0
                ? '0'
                : (inicio + 1).toLocaleString('es-CO') + '\u2013' + fin.toLocaleString('es-CO') +
                  ' de ' + datos.length.toLocaleString('es-CO')
        );

        actualizarPaginacion(datos.length);
    }

    function actualizarPaginacion(totalFilas) {
        var n      = (typeof totalFilas === 'number') ? totalFilas : _pag.filas.length;
        var total  = Math.ceil(n / _pag.porPagina);
        var actual = _pag.pagina;
        var $ctrl  = $('#paginacionControls');

        if (total <= 1) { $ctrl.hide(); return; }

        var ini = Math.max(1, actual - 2);
        var fin = Math.min(total, ini + 4);
        ini = Math.max(1, fin - 4);

        var html = '';
        html += '<button class="btn-pagination' + (actual === 1 ? ' disabled' : '') + '" ' +
                (actual === 1 ? 'disabled' : 'onclick="renderPagina(' + (actual - 1) + ')"') + '>' +
                '<i class="fas fa-chevron-left"></i></button>';

        for (var p = ini; p <= fin; p++) {
            html += '<button class="btn-pagination' + (p === actual ? ' active' : '') +
                    '" onclick="renderPagina(' + p + ')">' + p + '</button>';
        }

        html += '<button class="btn-pagination' + (actual === total ? ' disabled' : '') + '" ' +
                (actual === total ? 'disabled' : 'onclick="renderPagina(' + (actual + 1) + ')"') + '>' +
                '<i class="fas fa-chevron-right"></i></button>';

        $ctrl.html(html).show();
    }

    // Botón de exportación: exporta exactamente lo marcado en el panel de modelos.
    // 1 modelo → ese; varios (no todos) → esos; todos marcados → todos; ninguno → no hace nada
    // (el botón está deshabilitado en ese caso).
    function exportarModelos() {
        var idEmpresa = $('#idEmpresa').val();
        var sel   = modelosSeleccionados();
        if (!idEmpresa || sel.length === 0) return;

        var total = $('.mc-modelo-pick').length;

        if (sel.length === 1)             exportarExcel('seleccionado', sel);
        else if (sel.length === total)    exportarExcel('todos', sel);
        else                               exportarExcel('multiple', sel);
    }

    // ── Exportar (todos los modelos, una selección múltiple, o un único modelo) ───────────────
    function exportarExcel(modo, ids) {
        var idEmpresa = $('#idEmpresa').val();
        if (!idEmpresa) return;
        var idEscenario = $('#idEscenario').val();
        ids = ids || [];

        var url, titulo;
        if (modo === 'multiple') {
            if (ids.length === 0) return;
            url    = _modelo.urlExportarSeleccionados + '?idEmpresa=' + idEmpresa + '&idsModelos=' + ids.join(',') + '&idEscenario=' + idEscenario;
            titulo = _modelo.textos.exportandoSeleccionados;
        } else if (modo === 'seleccionado') {
            if (ids.length === 0) return;
            var nombreSel = $('.mc-modelo-pick[value="' + ids[0] + '"]').data('nombre') || '';
            url    = _modelo.urlExportarIndividual + '?idEmpresa=' + idEmpresa + '&idModelo=' + ids[0] + '&idEscenario=' + idEscenario;
            titulo = nombreSel ? _modelo.textos.btnDescargarModeloFmt.replace('{0}', nombreSel) : _modelo.textos.exportandoUno;
        } else {
            url    = _modelo.urlExportarTodos + '?idEmpresa=' + idEmpresa + '&idEscenario=' + idEscenario;
            titulo = _modelo.textos.exportandoTodos;
        }

        document.getElementById('overlayTitulo').textContent = titulo;

        var overlay  = document.getElementById('overlayExportacion');
        overlay.style.display = 'flex';
        var segundos = 0;
        var timer = setInterval(function () {
            segundos++;
            document.getElementById('overlayTimerTexto').textContent = segundos + 's';
        }, 1000);

        var filename = 'Modelos.xlsx';
        fetch(url)
            .then(function (response) {
                if (!response.ok) throw new Error('Error en la respuesta del servidor.');
                var ct = response.headers.get('Content-Type') || '';
                if (ct.indexOf('application/json') >= 0) {
                    return response.json().then(function (data) { return { tipo: 'error', data: data }; });
                }
                var cd    = response.headers.get('Content-Disposition') || '';
                var match = cd.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
                if (match) filename = match[1].replace(/['"]/g, '');
                return response.blob().then(function (blob) { return { tipo: 'archivo', blob: blob }; });
            })
            .then(function (result) {
                clearInterval(timer);
                overlay.style.display = 'none';
                if (result.tipo === 'error') {
                    mostrarErroresModelos(result.data.errores, result.data.exitosos);
                } else {
                    var blobUrl = window.URL.createObjectURL(result.blob);
                    var a = document.createElement('a');
                    a.href = blobUrl;
                    a.download = filename;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    window.URL.revokeObjectURL(blobUrl);
                }
            })
            .catch(function (err) {
                clearInterval(timer);
                overlay.style.display = 'none';
                Swal.fire({ icon: 'error', title: _modelo.textos.error, text: err.message,
                            confirmButtonText: _modelo.textos.aceptar, confirmButtonColor: '#583AFF' });
            });
    }

    function mostrarErroresModelos(errores, exitosos) {
        var html = '<div style="text-align:left;max-height:280px;overflow-y:auto;padding-right:4px;">';
        if (exitosos && exitosos.length > 0) {
            html += '<div style="margin-bottom:12px;padding:10px 12px;background:#f0fdf4;border-left:4px solid #22c55e;border-radius:4px;">';
            html += '<strong style="color:#166534;"><i class="fas fa-check-circle mr-1"></i>' + _modelo.textos.exportadosOk + '</strong>';
            html += '<div style="color:#166534;font-size:0.85em;margin-top:4px;">' + $('<span>').text(exitosos.join(', ')).html() + '</div>';
            html += '</div>';
        }
        errores.forEach(function (e) {
            html += '<div style="margin-bottom:10px;padding:10px 12px;background:#fef2f2;border-left:4px solid #ef4444;border-radius:4px;">';
            html += '<strong style="color:#1f2937;">' + e.nombre + '</strong><br>';
            html += '<small style="color:#6b7280;">' + e.nombreSP + '</small><br>';
            html += '<span style="color:#dc2626;font-size:0.85em;">' + e.mensaje + '</span>';
            html += '</div>';
        });
        html += '</div>';

        Swal.fire({
            icon: 'error',
            title: _modelo.textos.erroresExportacion,
            html: html,
            width: 640,
            confirmButtonText: '<i class="fas fa-download mr-1"></i> ' + _modelo.textos.descargarLog,
            confirmButtonColor: '#583AFF',
            showCancelButton: true,
            cancelButtonText: _modelo.textos.cerrar,
            cancelButtonColor: '#6b7280'
        }).then(function (result) {
            if (!result.isConfirmed) return;
            var txt = 'ERRORES EN EXPORTACION DE MODELOS\n';
            txt += '====================================\n\n';
            errores.forEach(function (e) {
                txt += 'Modelo   : ' + e.nombre + '\n';
                txt += 'SP       : ' + e.nombreSP + '\n';
                txt += 'Error    : ' + e.mensaje + '\n';
                txt += '------------------------------------\n\n';
            });
            var blob = new Blob([txt], { type: 'text/plain;charset=utf-8' });
            var bUrl = URL.createObjectURL(blob);
            var a    = document.createElement('a');
            a.href   = bUrl;
            a.download = 'ErroresExportacion_' + new Date().toISOString().slice(0, 10) + '.txt';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(bUrl);
        });
    }
</script>

@if (TempData["SuccessMessage"] != null)
{
    <script>
        $(function () {
            Swal.fire({ icon: 'success', title: _modelo.textos.exito,
                        text: '@Html.Raw(TempData["SuccessMessage"].ToString().Replace("'", "\\'"))',
                        confirmButtonText: _modelo.textos.aceptar, confirmButtonColor: '#583AFF' });
        });
    </script>
}
@if (TempData["ErrorMessage"] != null)
{
    <script>
        $(function () {
            Swal.fire({ icon: 'error', title: _modelo.textos.error,
                        text: '@Html.Raw(TempData["ErrorMessage"].ToString().Replace("'", "\\'"))',
                        confirmButtonText: _modelo.textos.aceptar, confirmButtonColor: '#583AFF' });
        });
    </script>
}

}
