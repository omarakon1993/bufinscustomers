@* Descarte ordenado al recargar la página (ver script). *@
@using (Html.BeginForm("AbandonarCargue", "Datos", FormMethod.Post, new { id = "frmAbandonarCargue", @class = "d-none" }))
{
    @Html.AntiForgeryToken()
    @Html.Hidden("idLote", Model.Lote.IdLote)
    @Html.Hidden("porRecarga", true)
}

@section scripts {
    @if (hayHallazgos)
    {
        var rcDatos = new
        {
            urlExcel = Url.Action("ExportarHallazgosExcel", "Datos", new { idLote = Model.Lote.IdLote }),
            urlCorreo = Url.Action("EnviarHallazgosPorCorreo", "Datos"),
            idLote = Model.Lote.IdLote,
            correoUsuario = correoUsuario,
            ctx = new
            {
                empresa = Model.Lote.NombreEmpresa ?? "",
                anio = Model.Lote.Anio,
                modo = Model.Lote.Modo == 0 ? Resources.Strings.RevisarCargue_ModoEjecucion : Resources.Strings.RevisarCargue_ModoHistorico,
                escenario = Model.Lote.IdEscenario,
                archivo = Model.NombreArchivo ?? "",
                nErr = nErr,
                nAdv = nAdv
            },
            hallazgos = hallazgos.Select(h => new
            {
                err = h.Severidad == CargueLoteSeveridad.Error,
                t = esIngles && !string.IsNullOrWhiteSpace(h.TituloEn) ? h.TituloEn : (h.Titulo ?? ""),
                m = esIngles && !string.IsNullOrWhiteSpace(h.MensajeEn) ? h.MensajeEn : (h.Mensaje ?? ""),
                hoja = h.NombreHoja ?? "",
                fila = h.NumeroFilaExcel,
                col = h.Columna ?? ""
            }).ToList(),
            t = new
            {
                generando = Resources.Strings.RevisarCargue_Exp_Generando,
                listo = Resources.Strings.RevisarCargue_Exp_Listo,
                errorGenerar = Resources.Strings.RevisarCargue_Exp_ErrorGenerar,
                imagenCopiada = Resources.Strings.RevisarCargue_Exp_ImagenCopiada,
                imagenDescargada = Resources.Strings.RevisarCargue_Exp_ImagenDescargada,
                titulo = Resources.Strings.RevisarCargue_Exp_TituloInforme,
                hallazgos = Resources.Strings.RevisarCargue_Hallazgos,
                pendiente = Resources.Strings.RevisarCargue_Pdf_Pendiente,
                generado = Resources.Strings.RevisarCargue_Pdf_Generado,
                pagina = Resources.Strings.RevisarCargue_Pdf_Pagina,
                lblEmpresa = Resources.Strings.RevisarCargue_Empresa,
                lblAnio = Resources.Strings.RevisarCargue_Anio,
                lblModo = Resources.Strings.RevisarCargue_Modo,
                lblEscenario = Resources.Strings.RevisarCargue_Escenario,
                lblArchivo = Resources.Strings.RevisarCargue_Exp_Archivo,
                lblErrores = Resources.Strings.RevisarCargue_Filtro_Errores,
                lblAdvertencias = Resources.Strings.RevisarCargue_Filtro_Advertencias,
                sevError = Resources.Strings.RevisarCargue_SeveridadError,
                sevAdv = Resources.Strings.RevisarCargue_SeveridadAdvertencia,
                colHoja = Resources.Strings.RevisarCargue_Exp_ColHoja,
                colFila = Resources.Strings.RevisarCargue_Exp_ColFila,
                colColumna = Resources.Strings.RevisarCargue_Exp_ColColumna,
                correoValDestino = Resources.Strings.RevisarCargue_Correo_ValDestino,
                correoValMaximo = Resources.Strings.RevisarCargue_Correo_ValMaximo,
                correoEnviando = Resources.Strings.RevisarCargue_Correo_Enviando,
                correoError = Resources.Strings.RevisarCargue_Correo_Error,
                correoExitoTitulo = Resources.Strings.Modelo_Correo_ExitoTitulo,
                aceptar = Resources.Strings.Common_Aceptar
            }
        };
        <script src="~/Assets/js/html2canvas.min.js"></script>
        <script src="~/Assets/js/jspdf.umd.min.js"></script>
        <script>
            (function () {
                var D = @Html.Raw(Json.Encode(rcDatos));
                var T = D.t;
                var $exp = $('#rcExp'), $btn = $('#rcExpBtn');

                // ── Menú ──────────────────────────────────────────────────
                function abrirMenu(abrir) {
                    $exp.toggleClass('open', abrir);
                    $btn.attr('aria-expanded', abrir ? 'true' : 'false');
                    if (abrir) setTimeout(function () { $exp.find('.rc-exp-opt').first().trigger('focus'); }, 30);
                }
                $btn.on('click', function (e) { e.stopPropagation(); abrirMenu(!$exp.hasClass('open')); });
                $(document).on('click', function (e) { if (!$(e.target).closest('#rcExp').length) abrirMenu(false); });
                $(document).on('keydown', function (e) {
                    if (!$exp.hasClass('open')) return;
                    var $opts = $exp.find('.rc-exp-opt'), i = $opts.index(document.activeElement);
                    if (e.key === 'Escape') { abrirMenu(false); $btn.trigger('focus'); }
                    else if (e.key === 'ArrowDown') { e.preventDefault(); $opts.eq((i + 1) % $opts.length).trigger('focus'); }
                    else if (e.key === 'ArrowUp') { e.preventDefault(); $opts.eq((i - 1 + $opts.length) % $opts.length).trigger('focus'); }
                });

                // Estado "generando" en el propio botón (el menú se cierra al elegir una opción).
                var textoBtn = $('#rcExpTexto').text();
                function ocupado(si) {
                    $exp.toggleClass('busy', si);
                    $('#rcExpIcono').attr('class', si ? 'fas fa-spinner fa-spin' : 'fas fa-arrow-up-from-bracket');
                    $('#rcExpTexto').text(si ? T.generando : textoBtn);
                }
                function aviso(icono, titulo) {
                    Swal.fire({ toast: true, position: 'top-end', icon: icono, title: titulo, showConfirmButton: false, timer: 3200, timerProgressBar: true });
                }
                function descargarBlob(blob, nombre) {
                    var url = URL.createObjectURL(blob), a = document.createElement('a');
                    a.href = url; a.download = nombre; document.body.appendChild(a); a.click();
                    setTimeout(function () { URL.revokeObjectURL(url); a.remove(); }, 1500);
                }
                function nombreArchivo(ext) {
                    var emp = (D.ctx.empresa || 'Empresa').replace(/[^A-Za-z0-9]+/g, '_').replace(/^_+|_+$/g, '');
                    var d = new Date(), p = function (n) { return (n < 10 ? '0' : '') + n; };
                    return 'Validacion_Cargue_' + emp + '_' + D.ctx.anio + '_Esc' + D.ctx.escenario + '_' +
                        d.getFullYear() + p(d.getMonth() + 1) + p(d.getDate()) + '_' + p(d.getHours()) + p(d.getMinutes()) + '.' + ext;
                }

                // ── Excel (servidor; con fetch para no salir de la página, lo que descartaría el lote) ──
                function exportarExcel() {
                    return fetch(D.urlExcel, { credentials: 'same-origin' }).then(function (r) {
                        var tipo = r.headers.get('Content-Type') || '';
                        if (!r.ok || tipo.indexOf('spreadsheet') < 0) throw new Error('excel');
                        var cd = r.headers.get('Content-Disposition') || '';
                        var m = /filename\*=UTF-8''([^;]+)/i.exec(cd) || /filename="?([^";]+)"?/i.exec(cd);
                        return r.blob().then(function (b) {
                            descargarBlob(b, m ? decodeURIComponent(m[1]) : nombreArchivo('xlsx'));
                            aviso('success', T.listo);
                        });
                    });
                }

                // ── PDF (jsPDF puro, A4 vertical) ─────────────────────────
                function txt(s) {
                    // Helvetica de jsPDF solo cubre Latin-1: se normalizan comillas/guiones tipográficos.
                    return String(s == null ? '' : s)
                        .replace(/[‘’]/g, "'").replace(/[“”]/g, '"')
                        .replace(/[–—]/g, '-').replace(/…/g, '...')
                        .replace(/[^\x00-\xFF]/g, '?');
                }
                function construirPdf() {
                    var doc = new window.jspdf.jsPDF({ orientation: 'p', unit: 'mm', format: 'a4' });
                    var W = 210, H = 297, M = 14, ancho = W - 2 * M;
                    var lh = function (pt) { return pt * 0.3528 * 1.2; };

                    // Banda con el degradado de marca
                    var stops = [[99, 102, 241], [59, 130, 246], [6, 182, 212], [1, 225, 215]], pos = [0, .35, .7, 1];
                    for (var i = 0, n = 140; i < n; i++) {
                        var f = i / (n - 1), k = 0;
                        while (k < pos.length - 2 && f > pos[k + 1]) k++;
                        var u = (f - pos[k]) / (pos[k + 1] - pos[k]);
                        doc.setFillColor.apply(doc, [0, 1, 2].map(function (c) { return Math.round(stops[k][c] + (stops[k + 1][c] - stops[k][c]) * u); }));
                        doc.rect(W * i / n, 0, W / n + 0.4, 30, 'F');
                    }
                    doc.setTextColor(255, 255, 255);
                    doc.setFont('helvetica', 'bold'); doc.setFontSize(17); doc.text(txt(T.titulo), M, 13);
                    doc.setFontSize(15); doc.text('bufins', W - M, 13, { align: 'right' });
                    doc.setFont('helvetica', 'normal'); doc.setFontSize(10.5); doc.text(txt(D.ctx.empresa), M, 20.5);
                    doc.setFontSize(8.5); doc.text(txt(T.generado.replace('{0}', new Date().toLocaleString())), M, 26);

                    // Contadores + contexto
                    var y = 37;
                    function contador(x, num, etiqueta, fondo, borde, color) {
                        doc.setFillColor.apply(doc, fondo); doc.setDrawColor.apply(doc, borde);
                        doc.roundedRect(x, y, 38, 17, 2.5, 2.5, 'FD');
                        doc.setTextColor.apply(doc, color);
                        doc.setFont('helvetica', 'bold'); doc.setFontSize(17); doc.text(String(num), x + 4, y + 8.5);
                        doc.setFontSize(8.5); doc.text(txt(etiqueta), x + 4, y + 13.8);
                    }
                    contador(M, D.ctx.nErr, T.lblErrores, [254, 242, 242], [254, 202, 202], [185, 28, 28]);
                    contador(M + 42, D.ctx.nAdv, T.lblAdvertencias, [255, 251, 235], [253, 230, 138], [146, 64, 14]);

                    var xc = M + 88, filasCtx = [
                        [T.lblArchivo, D.ctx.archivo], [T.lblAnio, String(D.ctx.anio)],
                        [T.lblModo, D.ctx.modo], [T.lblEscenario, String(D.ctx.escenario)]];
                    doc.setFontSize(9);
                    filasCtx.forEach(function (c, j) {
                        var yy = y + 3.6 + j * 4.3;
                        doc.setFont('helvetica', 'bold'); doc.setTextColor(91, 85, 112); doc.text(txt(c[0]) + ':', xc, yy);
                        doc.setFont('helvetica', 'normal'); doc.setTextColor(45, 55, 72);
                        var v = doc.splitTextToSize(txt(c[1]), W - M - xc - 22)[0] || '';
                        doc.text(v, xc + 22, yy);
                    });
                    y += 23;

                    doc.setFillColor(248, 249, 252); doc.roundedRect(M, y, ancho, 9, 2, 2, 'F');
                    doc.setFont('helvetica', 'normal'); doc.setFontSize(9); doc.setTextColor(91, 85, 112);
                    doc.text(txt(T.pendiente), M + 4, y + 5.9);
                    y += 16;

                    doc.setFont('helvetica', 'bold'); doc.setFontSize(12.5); doc.setTextColor(45, 55, 72);
                    doc.text(txt(T.hallazgos) + ' (' + D.hallazgos.length + ')', M, y);
                    y += 5;

                    // Hallazgos como tarjetas con barra de severidad
                    var interior = ancho - 10;
                    D.hallazgos.forEach(function (h) {
                        doc.setFont('helvetica', 'bold'); doc.setFontSize(10.5);
                        var tit = h.t ? doc.splitTextToSize(txt(h.t), interior) : [];
                        doc.setFont('helvetica', 'normal'); doc.setFontSize(9.5);
                        var msg = h.m ? doc.splitTextToSize(txt(h.m), interior) : [];
                        var meta = [];
                        if (h.hoja) meta.push(T.colHoja + ': ' + h.hoja);
                        if (h.fila) meta.push(T.colFila + ': ' + h.fila);
                        if (h.col) meta.push(T.colColumna + ': ' + h.col);
                        var alto = 4 + lh(8) + 1 + tit.length * lh(10.5) + msg.length * lh(9.5) + (meta.length ? lh(8.5) + 0.5 : 0) + 3;

                        if (y + alto > H - 16) { doc.addPage(); y = 16; }

                        doc.setFillColor.apply(doc, h.err ? [254, 242, 242] : [255, 251, 235]);
                        doc.roundedRect(M, y, ancho, alto, 2, 2, 'F');
                        doc.setFillColor.apply(doc, h.err ? [239, 68, 68] : [245, 158, 11]);
                        doc.rect(M, y, 1.6, alto, 'F');

                        var yy = y + 4 + lh(8) - 1;
                        doc.setFont('helvetica', 'bold'); doc.setFontSize(8); doc.setTextColor.apply(doc, h.err ? [185, 28, 28] : [146, 64, 14]);
                        doc.text(txt((h.err ? T.sevError : T.sevAdv).toUpperCase()), M + 5, yy);
                        yy += 1;
                        if (tit.length) {
                            doc.setFontSize(10.5); doc.setTextColor(45, 55, 72);
                            tit.forEach(function (l) { yy += lh(10.5); doc.text(l, M + 5, yy - 1); });
                        }
                        if (msg.length) {
                            doc.setFont('helvetica', 'normal'); doc.setFontSize(9.5); doc.setTextColor(91, 85, 112);
                            msg.forEach(function (l) { yy += lh(9.5); doc.text(l, M + 5, yy - 1); });
                        }
                        if (meta.length) {
                            doc.setFontSize(8.5); doc.setTextColor(130, 125, 150);
                            yy += lh(8.5) + 0.5; doc.text(txt(meta.join('   ·   ')), M + 5, yy - 1);
                        }
                        y += alto + 3;
                    });

                    // Pie en todas las páginas
                    var total = doc.getNumberOfPages();
                    for (var p = 1; p <= total; p++) {
                        doc.setPage(p);
                        doc.setDrawColor(227, 230, 240); doc.line(M, H - 11, W - M, H - 11);
                        doc.setFont('helvetica', 'normal'); doc.setFontSize(8); doc.setTextColor(140, 135, 160);
                        doc.text(txt('Bufins  ·  ' + D.ctx.empresa + '  ·  ' + T.titulo), M, H - 6.5);
                        doc.text(txt(T.pagina.replace('{0}', p).replace('{1}', total)), W - M, H - 6.5, { align: 'right' });
                    }
                    return doc;
                }
                function exportarPdf() {
                    return new Promise(function (ok) {
                        construirPdf().save(nombreArchivo('pdf'));
                        aviso('success', T.listo);
                        ok();
                    });
                }

                // ── Copiar como imagen (estado + hallazgos, tal como se ven) ──
                function capturar() {
                    var el = document.getElementById('rcCaptura');
                    var escala = Math.min(2, 14000 / Math.max(el.scrollHeight, 1));
                    return html2canvas(el, {
                        backgroundColor: '#ffffff', scale: escala, logging: false, useCORS: true,
                        ignoreElements: function (n) { return n.classList && n.classList.contains('rc-exp'); }
                    }).then(function (c) { return new Promise(function (ok) { c.toBlob(ok, 'image/png'); }); });
                }
                function copiarImagen() {
                    var blobP = capturar();
                    var respaldo = function () {
                        return blobP.then(function (b) { descargarBlob(b, nombreArchivo('png')); aviso('info', T.imagenDescargada); });
                    };
                    // ClipboardItem recibe la promesa en el mismo gesto del clic (requisito de Safari).
                    if (window.isSecureContext && navigator.clipboard && navigator.clipboard.write && window.ClipboardItem) {
                        try {
                            return navigator.clipboard.write([new ClipboardItem({ 'image/png': blobP })])
                                .then(function () { aviso('success', T.imagenCopiada); }, respaldo);
                        } catch (e) { return respaldo(); }
                    }
                    return respaldo();
                }

                // ── Correo ────────────────────────────────────────────────
                var rxCorreo = /^[^@@\s]+@@[^@@\s]+\.[^@@\s]+$/;
                function errorCorreo(msg) { $('#rcCorreoError').text(msg || '').toggleClass('d-none', !msg); }
                function abrirCorreo() {
                    errorCorreo('');
                    $('#rcModalCorreo').modal('show');
                }
                $('#rcModalCorreo').on('shown.bs.modal', function () {
                    if (!$('#rcCorreoYo').is(':checked')) $('#rcCorreoOtros').trigger('focus');
                });
                $('#rcCorreoEnviar').on('click', function () {
                    var $b = $(this);
                    var incluirme = $('#rcCorreoYo').is(':checked');
                    var otros = ($('#rcCorreoOtros').val() || '').split(/[,;\s]+/).filter(function (c) { return c; });
                    var invalidos = otros.filter(function (c) { return !rxCorreo.test(c); });
                    if ((!incluirme && otros.length === 0) || invalidos.length) {
                        errorCorreo(T.correoValDestino + (invalidos.length ? ' (' + invalidos.join(', ') + ')' : ''));
                        return;
                    }
                    if (otros.length + (incluirme ? 1 : 0) > 10) { errorCorreo(T.correoValMaximo); return; }
                    errorCorreo('');

                    var htmlBtn = $b.html();
                    $b.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i>' + $('<span>').text(T.correoEnviando).html());
                    var pdf = '';
                    try { pdf = construirPdf().output('datauristring'); } catch (e) { pdf = ''; }

                    $.ajax({
                        url: D.urlCorreo, type: 'POST',
                        data: {
                            __RequestVerificationToken: $('#frmDescartarCargue input[name="__RequestVerificationToken"]').val(),
                            idLote: D.idLote, correos: otros.join(','), incluirmeAMi: incluirme,
                            mensaje: $('#rcCorreoMensaje').val() || '', pdfBase64: pdf
                        }
                    }).done(function (r) {
                        if (r && r.exito) {
                            $('#rcModalCorreo').modal('hide');
                            Swal.fire({ icon: 'success', title: T.correoExitoTitulo, text: r.mensaje, confirmButtonText: T.aceptar });
                        } else {
                            errorCorreo((r && r.mensaje) || T.correoError);
                        }
                    }).fail(function () {
                        errorCorreo(T.correoError);
                    }).always(function () {
                        $b.prop('disabled', false).html(htmlBtn);
                    });
                });

                // ── Despacho de opciones ──────────────────────────────────
                var acciones = { excel: exportarExcel, pdf: exportarPdf, imagen: copiarImagen };
                $exp.on('click', '.rc-exp-opt', function () {
                    var accion = $(this).data('accion');
                    abrirMenu(false);
                    if (accion === 'correo') { abrirCorreo(); return; }
                    if ($exp.hasClass('busy')) return;
                    ocupado(true);
                    var p;
                    try { p = Promise.resolve(acciones[accion]()); } catch (e) { p = Promise.reject(e); }
                    p.catch(function () { aviso('error', T.errorGenerar); })
                     .then(function () { ocupado(false); });
                });
            })();
        </script>
    }
    <script>
        $(function () {
            // Reducción fuerte: el botón Confirmar se habilita solo al tildar la confirmación reforzada
            // (el servidor lo vuelve a exigir, esto es solo comodidad de la pantalla).
            $('#chkReemplazo').on('change', function () {
                $('#btnConfirmarCargue').prop('disabled', !this.checked || @(Model.Lote.PuedeConfirmar && !impVacio ? "false" : "true"));
            });

            $('#rcFiltro button').on('click', function () {
                var f = $(this).data('filtro');
                $('#rcFiltro button').removeClass('active');
                $(this).addClass('active');
                $('.rc-item').each(function () {
                    $(this).toggle(f === 'all' || $(this).data('sev') === f);
                });
            });

            // Salir de la pantalla o recargarla (de cualquier forma) sin Confirmar/Descartar descarta el
            // lote, para que no quede pegado bloqueando el próximo cargue.
            var rcSaliendoPorFormulario = false;
            $('#frmConfirmarCargue, #frmDescartarCargue, #frmAbandonarCargue').on('submit', function () { rcSaliendoPorFormulario = true; });

            // Página recargada: el aviso de 'pagehide' pudo no haber llegado aún al servidor, así que aquí
            // se descarta de forma ordenada y se vuelve a Cargue de Excel con el aviso correspondiente.
            var nav = (performance.getEntriesByType && performance.getEntriesByType('navigation')[0]) || null;
            var esRecarga = nav ? nav.type === 'reload' : (performance.navigation && performance.navigation.type === 1);
            if (esRecarga) {
                $('#frmAbandonarCargue').trigger('submit');
                return;
            }

            window.addEventListener('pagehide', function () {
                if (rcSaliendoPorFormulario || !navigator.sendBeacon) return;
                var fd = new FormData();
                fd.append('idLote', '@Model.Lote.IdLote');
                fd.append('__RequestVerificationToken', $('#frmDescartarCargue input[name="__RequestVerificationToken"]').val());
                navigator.sendBeacon('@Url.Action("AbandonarCargue", "Datos")', fd);
            });
            // Si el navegador restaura la página desde su caché (botón Atrás), el lote ya pudo descartarse:
            // se recarga para que el servidor decida.
            window.addEventListener('pageshow', function (e) { if (e.persisted) window.location.reload(); });
        });
    </script>
}
