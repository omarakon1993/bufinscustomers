@using bufinscustomers.Models
@model RevisarCargueViewModel
@{
    ViewBag.Title = Resources.Strings.RevisarCargue_PageTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool esIngles = System.Threading.Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName == "en";
    bool hayErrores = Model.Lote.TotalErrores > 0;
    bool puedeConfirmar = Model.Lote.PuedeConfirmar;
    int nErr = Model.Lote.TotalErrores;
    int nAdv = Model.Lote.TotalAdvertencias;
    string estado = nErr > 0 ? "err" : (nAdv > 0 ? "adv" : "ok");
    var hallazgos = Model.Hallazgos.OrderBy(x => x.Severidad == CargueLoteSeveridad.Error ? 0 : 1).ToList();

}

<link href="~/Assets/css/bufins-components.css" rel="stylesheet" />

<style>
    .rc-steps { display: flex; align-items: center; gap: 6px; margin-left: auto; font-size: 12.5px; font-weight: 700; color: #fff; }
    .rc-step { opacity: .8; display: inline-flex; align-items: center; gap: 6px; }
    .rc-step.active { opacity: 1; background: rgba(255,255,255,.22); padding: 4px 10px; border-radius: 20px; }
    .rc-step-sep { width: 18px; height: 1px; background: rgba(255,255,255,.6); }

    .rc-stack > * + * { margin-top: 20px; }
    .rc-card { background: #fff; border: 1px solid #e3e6f0; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,.06); overflow: hidden; }

    .rc-status { display: flex; align-items: center; gap: 20px; padding: 22px 24px; }
    .rc-status-icon { width: 52px; height: 52px; border-radius: 14px; font-size: 22px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .rc-status-icon.err { background: #fee2e2; color: #b91c1c; }
    .rc-status-icon.adv { background: #fef3c7; color: #92400e; }
    .rc-status-icon.ok { background: #d1fae5; color: #047857; }
    .rc-status-text { flex: 1; display: flex; flex-direction: column; gap: 4px; }
    .rc-status-title { font-size: 19px; font-weight: 800; color: #2d3748; letter-spacing: -.2px; margin: 0; }
    .rc-status-desc { font-size: 14.5px; color: #5B5570; line-height: 1.5; margin: 0; }
    .rc-counters { display: flex; gap: 10px; }
    .rc-counter { min-width: 104px; padding: 10px 14px; border-radius: 10px; border: 1px solid; }
    .rc-counter-num { font-size: 24px; font-weight: 800; line-height: 1; }
    .rc-counter-lbl { font-size: 12px; font-weight: 700; }
    .rc-counter.err { background: #fef2f2; border-color: #fecaca; color: #b91c1c; }
    .rc-counter.adv { background: #fffbeb; border-color: #fde68a; color: #92400e; }

    .rc-meta { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; padding: 12px 24px; background: #f8f9fc; border-top: 1px solid #e3e6f0; }
    .rc-file { display: flex; align-items: center; gap: 8px; flex: 1; min-width: 0; font-size: 13.5px; font-weight: 700; color: #2d3748; }
    .rc-file i { color: #217346; font-size: 17px; }
    .rc-file span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .rc-pills { display: flex; flex-wrap: wrap; gap: 8px; }
    .rc-pill { font-size: 12.5px; color: #5B5570; background: #fff; border: 1px solid #e3e6f0; padding: 4px 10px; border-radius: 999px; }
    .rc-pill b { color: #2d3748; }

    .rc-hall { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 14px; }
    .rc-hall-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; }
    .rc-hall-title { font-size: 17px; font-weight: 700; margin: 0; color: #2d3748; }
    .rc-hall-title i { color: #583AFF; font-size: 15px; margin-right: 8px; }
    .rc-seg { display: inline-flex; gap: 2px; padding: 3px; background: #f4f3fb; border: 1px solid #e0ddf0; border-radius: 9px; }
    .rc-seg button { border: 0; background: transparent; color: #5B5570; font-size: 12.5px; font-weight: 700; padding: 6px 13px; border-radius: 7px; cursor: pointer; }
    .rc-seg button .rc-cnt { font-size: 11px; padding: 1px 7px; border-radius: 10px; background: #e8e6f2; margin-left: 6px; }
    .rc-seg button.active { background: #fff; color: #583AFF; box-shadow: 0 1px 3px rgba(22,9,51,.12); }
    .rc-seg button.active .rc-cnt { background: rgba(88,58,255,.1); }

    .rc-list { border: 1px solid #e3e6f0; border-radius: 8px; overflow: hidden; }
    .rc-item { display: flex; gap: 14px; padding: 14px 16px; }
    .rc-item + .rc-item { border-top: 1px solid #e3e6f0; }
    .rc-item-bar { width: 4px; border-radius: 4px; flex-shrink: 0; }
    .rc-item.err .rc-item-bar { background: #ef4444; }
    .rc-item.adv .rc-item-bar { background: #f59e0b; }
    .rc-item-icon { font-size: 16px; padding-top: 1px; }
    .rc-item.err .rc-item-icon, .rc-item.err .rc-item-sev { color: #b91c1c; }
    .rc-item.adv .rc-item-icon, .rc-item.adv .rc-item-sev { color: #92400e; }
    .rc-item-body { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
    .rc-item-sev { font-size: 11.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; margin-right: 10px; }
    .rc-item-title { font-size: 14.5px; font-weight: 700; color: #2d3748; }
    .rc-item-msg { font-size: 13.5px; color: #5B5570; line-height: 1.5; }

    .rc-empty { text-align: center; padding: 36px 20px; }
    .rc-empty-icon { width: 64px; height: 64px; border-radius: 50%; background: rgba(16,185,129,.1); color: #10b981; font-size: 28px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 10px; }
    .rc-empty h4 { font-size: 17px; font-weight: 700; margin: 0 0 4px; }
    .rc-empty p { font-size: 14.5px; color: #6c757d; margin: 0; }

    /* Botonera igual a CargueExcel: compacta, alineada a la izquierda, mismo tamaño */
    .rc-actions { padding-top: 16px; border-top: 1px solid #e3e6f0; }
    .rc-actions .btn-group-actions { gap: 0.5rem; }
    .rc-actions .btn-group-actions form { margin: 0; }
    .rc-actions .btn-group-actions .btn { padding: 0.45rem 0.9rem; font-size: 0.8rem; }
    .rc-actions .btn-group-actions .btn i { margin-right: 0.4rem; }
    .rc-help { margin-top: 0.75rem; font-size: 0.78rem; color: #5B5570; }
    .rc-help i { margin-right: 6px; }
    .rc-help i.lock { color: #a39cc0; }
    .rc-help i.shield { color: #583AFF; }
    .rc-btn-subir, .rc-btn-subir:hover { color: #fff; }

    @@media (max-width: 767.98px) {
        .rc-steps { display: none; }
        .rc-status { flex-direction: column; align-items: flex-start; }
        .rc-counters { width: 100%; }
        .rc-actions .btn-group-actions .btn, .rc-actions .btn-group-actions form { width: 100%; }
    }
</style>

<div class="container-fluid px-4">

    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas fa-clipboard-check powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@Resources.Strings.RevisarCargue_HeaderTitle</h1>
            <div class="rc-steps">
                <span class="rc-step"><i class="fas fa-check-circle"></i>@Resources.Strings.RevisarCargue_Paso_Subir</span>
                <span class="rc-step-sep"></span>
                <span class="rc-step active"><i class="fas fa-search"></i>@Resources.Strings.RevisarCargue_Paso_Revisar</span>
                <span class="rc-step-sep"></span>
                <span class="rc-step"><i class="far fa-circle"></i>@Resources.Strings.RevisarCargue_Paso_Confirmar</span>
            </div>
        </div>
    </div>

    <div class="rc-stack mt-3">

        <!-- Tarjeta de estado -->
        <div class="rc-card">
            <div class="rc-status">
                <div class="rc-status-icon @estado">
                    <i class="fas @(estado == "err" ? "fa-times-circle" : estado == "adv" ? "fa-exclamation-triangle" : "fa-check-circle")"></i>
                </div>
                <div class="rc-status-text">
                    @if (estado == "err")
                    {
                        <h2 class="rc-status-title">@Resources.Strings.RevisarCargue_EstadoErrores_Titulo</h2>
                        <p class="rc-status-desc">@(nErr == 1 ? Resources.Strings.RevisarCargue_EstadoErrores_Texto1 : string.Format(Resources.Strings.RevisarCargue_EstadoErrores_Texto, nErr))</p>
                    }
                    else if (estado == "adv")
                    {
                        <h2 class="rc-status-title">@Resources.Strings.RevisarCargue_EstadoAdvertencias_Titulo</h2>
                        <p class="rc-status-desc">@Resources.Strings.RevisarCargue_EstadoAdvertencias_Texto</p>
                    }
                    else
                    {
                        <h2 class="rc-status-title">@Resources.Strings.RevisarCargue_EstadoOk_Titulo</h2>
                        <p class="rc-status-desc">@Resources.Strings.RevisarCargue_EstadoOk_Texto</p>
                    }
                </div>
                <div class="rc-counters">
                    @if (nErr > 0)
                    {
                        <div class="rc-counter err">
                            <div class="rc-counter-num">@nErr</div>
                            <div class="rc-counter-lbl">@(nErr == 1 ? Resources.Strings.RevisarCargue_Contador_Error : Resources.Strings.RevisarCargue_Contador_Errores)</div>
                        </div>
                    }
                    @if (nAdv > 0)
                    {
                        <div class="rc-counter adv">
                            <div class="rc-counter-num">@nAdv</div>
                            <div class="rc-counter-lbl">@(nAdv == 1 ? Resources.Strings.RevisarCargue_Contador_Advertencia : Resources.Strings.RevisarCargue_Contador_Advertencias)</div>
                        </div>
                    }
                </div>
            </div>
            <div class="rc-meta">
                <div class="rc-file"><i class="fas fa-file-excel"></i><span title="@Model.NombreArchivo">@Model.NombreArchivo</span></div>
                <div class="rc-pills">
                    <span class="rc-pill">@Resources.Strings.RevisarCargue_Empresa <b>@Model.Lote.NombreEmpresa</b></span>
                    <span class="rc-pill">@Resources.Strings.RevisarCargue_Anio <b>@Model.Lote.Anio</b></span>
                    <span class="rc-pill">@Resources.Strings.RevisarCargue_Modo <b>@(Model.Lote.Modo == 0 ? Resources.Strings.RevisarCargue_ModoEjecucion : Resources.Strings.RevisarCargue_ModoHistorico)</b></span>
                    <span class="rc-pill">@Resources.Strings.RevisarCargue_Escenario <b>@Model.Lote.IdEscenario</b></span>
                </div>
            </div>
        </div>

        <!-- Tarjeta de hallazgos -->
        <div class="rc-card rc-hall">
            <div class="rc-hall-head">
                <h3 class="rc-hall-title"><i class="fas fa-list"></i>@Resources.Strings.RevisarCargue_Hallazgos</h3>
                @if (hallazgos.Any())
                {
                    <div class="rc-seg" id="rcFiltro">
                        <button type="button" class="active" data-filtro="all">@Resources.Strings.RevisarCargue_Filtro_Todos<span class="rc-cnt">@hallazgos.Count</span></button>
                        <button type="button" data-filtro="err">@Resources.Strings.RevisarCargue_Filtro_Errores<span class="rc-cnt">@hallazgos.Count(x => x.Severidad == CargueLoteSeveridad.Error)</span></button>
                        <button type="button" data-filtro="adv">@Resources.Strings.RevisarCargue_Filtro_Advertencias<span class="rc-cnt">@hallazgos.Count(x => x.Severidad != CargueLoteSeveridad.Error)</span></button>
                    </div>
                }
            </div>

            @if (!hallazgos.Any())
            {
                <div class="rc-empty">
                    <div class="rc-empty-icon"><i class="fas fa-check-circle"></i></div>
                    <h4>@Resources.Strings.RevisarCargue_SinHallazgosTitulo</h4>
                    <p>@Resources.Strings.RevisarCargue_SinHallazgosTexto</p>
                </div>
            }
            else
            {
                <div class="rc-list">
                    @foreach (var h in hallazgos)
                    {
                        bool esError = h.Severidad == CargueLoteSeveridad.Error;
                        string titulo = esIngles && !string.IsNullOrWhiteSpace(h.TituloEn) ? h.TituloEn : h.Titulo;
                        <div class="rc-item @(esError ? "err" : "adv")" data-sev="@(esError ? "err" : "adv")">
                            <div class="rc-item-bar"></div>
                            <i class="fas @(esError ? "fa-times-circle" : "fa-exclamation-triangle") rc-item-icon"></i>
                            <div class="rc-item-body">
                                <div>
                                    <span class="rc-item-sev">@(esError ? Resources.Strings.RevisarCargue_SeveridadError : Resources.Strings.RevisarCargue_SeveridadAdvertencia)</span>
                                    @if (!string.IsNullOrEmpty(titulo))
                                    {
                                        <span class="rc-item-title">@titulo</span>
                                    }
                                </div>
                                <div class="rc-item-msg">@(esIngles && !string.IsNullOrWhiteSpace(h.MensajeEn) ? h.MensajeEn : h.Mensaje)</div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Acciones -->
        <div class="rc-actions">
            <div class="btn-group-actions">
                @using (Html.BeginForm("ConfirmarCargue", "Datos", FormMethod.Post, new { id = "frmConfirmarCargue" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("idLote", Model.Lote.IdLote)
                    <button type="submit" class="btn btn-modern-gradient" @(puedeConfirmar ? "" : "disabled")>
                        <i class="fas fa-check"></i>@(nAdv > 0 && !hayErrores ? Resources.Strings.RevisarCargue_BtnConfirmarConAdvertencias : Resources.Strings.RevisarCargue_BtnConfirmar)
                    </button>
                }
                @if (hayErrores)
                {
                    <a href="@Url.Action("CargueExcel", "Datos", new { idEmpresa = Model.Lote.IdEmpresa, anio = Model.Lote.Anio, idEscenario = Model.Lote.IdEscenario })" class="btn btn-modern-gradient rc-btn-subir">
                        <i class="fas fa-file-upload"></i>@Resources.Strings.RevisarCargue_BtnSubirCorregido
                    </a>
                }
                <button type="button" class="btn btn-modern-secondary" data-toggle="modal" data-target="#descartarCargueModal">
                    <i class="fas fa-trash-alt"></i>@Resources.Strings.RevisarCargue_BtnDescartar
                </button>
            </div>
            <div class="rc-help">
                @if (hayErrores)
                {
                    <i class="fas fa-lock lock"></i>@Resources.Strings.RevisarCargue_AyudaBloqueado
                }
                else
                {
                    <i class="fas fa-shield-alt shield"></i>@Resources.Strings.RevisarCargue_AyudaSeguro
                }
            </div>
        </div>

    </div>
</div>

<!-- Modal: descartar cargue (tema oscuro obligatorio en modales de confirmación) -->
<div class="modal fade modal-confirm" id="descartarCargueModal" tabindex="-1" role="dialog" aria-labelledby="descartarCargueModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="descartarCargueModalLabel">
                    <i class="fas fa-exclamation-triangle mr-2"></i>@Resources.Strings.RevisarCargue_ModalDescartarTitulo
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <p>@Resources.Strings.RevisarCargue_ModalDescartarTexto</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">@Resources.Strings.RevisarCargue_ModalDescartarCancelar</button>
                @using (Html.BeginForm("DescartarCargue", "Datos", FormMethod.Post, new { id = "frmDescartarCargue" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("idLote", Model.Lote.IdLote)
                    <button type="submit" class="btn btn-danger">@Resources.Strings.RevisarCargue_ModalDescartarConfirmar</button>
                }
            </div>
        </div>
    </div>
</div>

@* Descarte ordenado al recargar la página (ver script). *@
@using (Html.BeginForm("AbandonarCargue", "Datos", FormMethod.Post, new { id = "frmAbandonarCargue", @class = "d-none" }))
{
    @Html.AntiForgeryToken()
    @Html.Hidden("idLote", Model.Lote.IdLote)
    @Html.Hidden("porRecarga", true)
}

@section scripts {
    <script>
        $(function () {
            $('#rcFiltro button').on('click', function () {
                var f = $(this).data('filtro');
                $('#rcFiltro button').removeClass('active');
                $(this).addClass('active');
                $('.rc-item').each(function () {
                    $(this).toggle(f === 'all' || $(this).data('sev') === f);
                });
            });

            // Salir de la pantalla o recargarla (de cualquier forma) sin Confirmar/Descartar descarta el
            // lote, para que no quede pegado bloqueando el próximo cargue.
            var rcSaliendoPorFormulario = false;
            $('#frmConfirmarCargue, #frmDescartarCargue, #frmAbandonarCargue').on('submit', function () { rcSaliendoPorFormulario = true; });

            // Página recargada: el aviso de 'pagehide' pudo no haber llegado aún al servidor, así que aquí
            // se descarta de forma ordenada y se vuelve a Cargue de Excel con el aviso correspondiente.
            var nav = (performance.getEntriesByType && performance.getEntriesByType('navigation')[0]) || null;
            var esRecarga = nav ? nav.type === 'reload' : (performance.navigation && performance.navigation.type === 1);
            if (esRecarga) {
                $('#frmAbandonarCargue').trigger('submit');
                return;
            }

            window.addEventListener('pagehide', function () {
                if (rcSaliendoPorFormulario || !navigator.sendBeacon) return;
                var fd = new FormData();
                fd.append('idLote', '@Model.Lote.IdLote');
                fd.append('__RequestVerificationToken', $('#frmDescartarCargue input[name="__RequestVerificationToken"]').val());
                navigator.sendBeacon('@Url.Action("AbandonarCargue", "Datos")', fd);
            });
            // Si el navegador restaura la página desde su caché (botón Atrás), el lote ya pudo descartarse:
            // se recarga para que el servidor decida.
            window.addEventListener('pageshow', function (e) { if (e.persisted) window.location.reload(); });
        });
    </script>
}
