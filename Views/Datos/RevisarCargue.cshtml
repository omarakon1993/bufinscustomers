@using bufinscustomers.Models
@model RevisarCargueViewModel
@{
    ViewBag.Title = Resources.Strings.RevisarCargue_PageTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool esIngles = System.Threading.Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName == "en";
    bool hayErrores = Model.Lote.TotalErrores > 0;
    // Impacto sobre los datos actuales: un cargue sin filas no se confirma; una reducción fuerte exige tildar la confirmación.
    var impacto = Model.Impacto;
    bool impVacio = impacto != null && impacto.CargaVacia;
    bool impRiesgo = impacto != null && impacto.RequiereConfirmacion;
    bool puedeConfirmar = Model.Lote.PuedeConfirmar && !impVacio;
    int nErr = Model.Lote.TotalErrores;
    int nAdv = Model.Lote.TotalAdvertencias;
    string estado = nErr > 0 ? "err" : (nAdv > 0 ? "adv" : "ok");
    var hallazgos = Model.Hallazgos.OrderBy(x => x.Severidad == CargueLoteSeveridad.Error ? 0 : 1).ToList();
    // El botón Exportar (Excel / PDF / imagen / correo) solo aparece si hay al menos un error o advertencia.
    bool hayHallazgos = hallazgos.Any();
    string correoUsuario = (bufinscustomers.Helpers.UsuarioSesionHelper.UsuarioActual?.Correo ?? "").Trim();
}

<link href="~/Assets/css/bufins-components.css" rel="stylesheet" />

<style>
    .rc-steps { display: flex; align-items: center; gap: 6px; margin-left: auto; font-size: 12.5px; font-weight: 700; color: #fff; }
    .rc-step { opacity: .8; display: inline-flex; align-items: center; gap: 6px; }
    .rc-step.active { opacity: 1; background: rgba(255,255,255,.22); padding: 4px 10px; border-radius: 20px; }
    .rc-step-sep { width: 18px; height: 1px; background: rgba(255,255,255,.6); }

    .rc-stack > * + * { margin-top: 20px; }

    /* Impacto del cargue sobre los datos actuales */
    .rc-imp { padding: 18px 22px; }
    .rc-imp.riesgo { border-color: #f59e0b; box-shadow: 0 2px 10px rgba(245,158,11,.25); }
    .rc-imp.vacio { border-color: #dc2626; box-shadow: 0 2px 10px rgba(220,38,38,.22); }
    .rc-imp-title { font-size: 16px; font-weight: 800; color: #2d3748; margin: 0 0 4px; display: flex; align-items: center; gap: 8px; }
    .rc-imp-desc { font-size: 13.5px; color: #5B5570; margin: 0 0 12px; }
    .rc-imp-table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
    .rc-imp-table th { text-align: left; font-size: 11.5px; text-transform: uppercase; letter-spacing: .03em; color: #6b7280; padding: 6px 8px; border-bottom: 1px solid #e3e6f0; }
    .rc-imp-table td { padding: 7px 8px; border-bottom: 1px solid #f0f1f6; color: #2d3748; }
    .rc-imp-table .num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .rc-imp-table tfoot td { font-weight: 800; border-bottom: 0; border-top: 2px solid #e3e6f0; }
    .rc-imp-tag { display: inline-block; padding: 2px 9px; border-radius: 20px; font-size: 11.5px; font-weight: 700; }
    .rc-imp-tag.ok { background: #d1fae5; color: #047857; }
    .rc-imp-tag.red { background: #fef3c7; color: #92400e; }
    .rc-imp-tag.vac { background: #fee2e2; color: #b91c1c; }
    .rc-imp-alert { margin-top: 14px; padding: 12px 14px; border-radius: 10px; font-size: 13.5px; line-height: 1.5; }
    .rc-imp-alert.riesgo { background: #fffbeb; border: 1px solid #fcd34d; color: #78350f; }
    .rc-imp-alert.vacio { background: #fef2f2; border: 1px solid #fca5a5; color: #7f1d1d; }
    .rc-imp-check { display: flex; align-items: flex-start; gap: 10px; margin-top: 10px; font-weight: 700; cursor: pointer; }
    .rc-imp-check input { margin-top: 3px; width: 17px; height: 17px; flex-shrink: 0; }
    .rc-card { background: #fff; border: 1px solid #e3e6f0; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,.06); overflow: hidden; }

    .rc-status { display: flex; align-items: center; gap: 20px; padding: 22px 24px; }
    .rc-status-icon { width: 52px; height: 52px; border-radius: 14px; font-size: 22px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .rc-status-icon.err { background: #fee2e2; color: #b91c1c; }
    .rc-status-icon.adv { background: #fef3c7; color: #92400e; }
    .rc-status-icon.ok { background: #d1fae5; color: #047857; }
    .rc-status-text { flex: 1; display: flex; flex-direction: column; gap: 4px; }
    .rc-status-title { font-size: 19px; font-weight: 800; color: #2d3748; letter-spacing: -.2px; margin: 0; }
    .rc-status-desc { font-size: 14.5px; color: #5B5570; line-height: 1.5; margin: 0; }
    .rc-counters { display: flex; gap: 10px; }
    .rc-counter { min-width: 104px; padding: 10px 14px; border-radius: 10px; border: 1px solid; }
    .rc-counter-num { font-size: 24px; font-weight: 800; line-height: 1; }
    .rc-counter-lbl { font-size: 12px; font-weight: 700; }
    .rc-counter.err { background: #fef2f2; border-color: #fecaca; color: #b91c1c; }
    .rc-counter.adv { background: #fffbeb; border-color: #fde68a; color: #92400e; }

    .rc-meta { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; padding: 12px 24px; background: #f8f9fc; border-top: 1px solid #e3e6f0; }
    .rc-file { display: flex; align-items: center; gap: 8px; flex: 1; min-width: 0; font-size: 13.5px; font-weight: 700; color: #2d3748; }
    .rc-file i { color: #217346; font-size: 17px; }
    .rc-file span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .rc-pills { display: flex; flex-wrap: wrap; gap: 8px; }
    .rc-pill { font-size: 12.5px; color: #5B5570; background: #fff; border: 1px solid #e3e6f0; padding: 4px 10px; border-radius: 999px; }
    .rc-pill b { color: #2d3748; }

    .rc-hall { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 14px; }
    .rc-hall-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; }
    .rc-hall-title { font-size: 17px; font-weight: 700; margin: 0; color: #2d3748; }
    .rc-hall-title i { color: #583AFF; font-size: 15px; margin-right: 8px; }
    .rc-seg { display: inline-flex; gap: 2px; padding: 3px; background: #f4f3fb; border: 1px solid #e0ddf0; border-radius: 9px; }
    .rc-seg button { border: 0; background: transparent; color: #5B5570; font-size: 12.5px; font-weight: 700; padding: 6px 13px; border-radius: 7px; cursor: pointer; }
    .rc-seg button .rc-cnt { font-size: 11px; padding: 1px 7px; border-radius: 10px; background: #e8e6f2; margin-left: 6px; }
    .rc-seg button.active { background: #fff; color: #583AFF; box-shadow: 0 1px 3px rgba(22,9,51,.12); }
    .rc-seg button.active .rc-cnt { background: rgba(88,58,255,.1); }

    .rc-list { border: 1px solid #e3e6f0; border-radius: 8px; overflow: hidden; }
    .rc-item { display: flex; gap: 14px; padding: 14px 16px; }
    .rc-item + .rc-item { border-top: 1px solid #e3e6f0; }
    .rc-item-bar { width: 4px; border-radius: 4px; flex-shrink: 0; }
    .rc-item.err .rc-item-bar { background: #ef4444; }
    .rc-item.adv .rc-item-bar { background: #f59e0b; }
    .rc-item-icon { font-size: 16px; padding-top: 1px; }
    .rc-item.err .rc-item-icon, .rc-item.err .rc-item-sev { color: #b91c1c; }
    .rc-item.adv .rc-item-icon, .rc-item.adv .rc-item-sev { color: #92400e; }
    .rc-item-body { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
    .rc-item-sev { font-size: 11.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; margin-right: 10px; }
    .rc-item-title { font-size: 14.5px; font-weight: 700; color: #2d3748; }
    .rc-item-msg { font-size: 13.5px; color: #5B5570; line-height: 1.5; }

    .rc-empty { text-align: center; padding: 36px 20px; }
    .rc-empty-icon { width: 64px; height: 64px; border-radius: 50%; background: rgba(16,185,129,.1); color: #10b981; font-size: 28px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 10px; }
    .rc-empty h4 { font-size: 17px; font-weight: 700; margin: 0 0 4px; }
    .rc-empty p { font-size: 14.5px; color: #6c757d; margin: 0; }

    /* Botonera igual a CargueExcel: compacta, alineada a la izquierda, mismo tamaño */
    .rc-actions { padding-top: 16px; border-top: 1px solid #e3e6f0; }
    .rc-actions .btn-group-actions { gap: 0.5rem; }
    .rc-actions .btn-group-actions form { margin: 0; }
    .rc-actions .btn-group-actions .btn { padding: 0.45rem 0.9rem; font-size: 0.8rem; }
    .rc-actions .btn-group-actions .btn i { margin-right: 0.4rem; }
    .rc-help { margin-top: 0.75rem; font-size: 0.78rem; color: #5B5570; }
    .rc-help i { margin-right: 6px; }
    .rc-help i.lock { color: #a39cc0; }
    .rc-help i.shield { color: #583AFF; }
    .rc-btn-subir, .rc-btn-subir:hover { color: #fff; }

    /* ── Exportar hallazgos: botón destacado + menú de formatos ── */
    .rc-card.rc-hall { overflow: visible; } /* el menú Exportar sobresale de la tarjeta */
    .rc-hall-tools { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .rc-exp { position: relative; }
    .rc-exp-btn { position: relative; display: inline-flex; align-items: center; gap: 10px; height: 36px; min-width: 210px; padding: 0 14px 0 6px; border: 0; border-radius: 10px; color: #fff; font-size: 13px; font-weight: 500; letter-spacing: .1px; cursor: pointer; background: linear-gradient(90deg,#6366F1 0%,#3B82F6 25%,#06B6D4 50%,#01E1D7 65%,#3B82F6 85%,#6366F1 100%); background-size: 220% 100%; animation: rcExpFondo 7s ease-in-out infinite alternate; box-shadow: 0 4px 14px rgba(59,130,246,.35); transition: transform .15s, box-shadow .15s; }
    @@keyframes rcExpFondo { 0% { background-position: 0% 50%; } 100% { background-position: 100% 50%; } }
    .rc-exp-icono { width: 26px; height: 26px; border-radius: 7px; background: rgba(255,255,255,.22); box-shadow: inset 0 0 0 1px rgba(255,255,255,.35); display: inline-flex; align-items: center; justify-content: center; font-size: 12px; flex-shrink: 0; }
    .rc-exp-btn:hover .rc-exp-icono i:not(.fa-spin) { animation: rcExpSube .5s ease; }
    @@keyframes rcExpSube { 0%, 100% { transform: translateY(0); } 45% { transform: translateY(-3px); } }
    .rc-exp-btn #rcExpTexto { flex: 1; text-align: left; }
    .rc-exp-btn:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(59,130,246,.45); }
    .rc-exp-btn:focus-visible { outline: 2px solid #583AFF; outline-offset: 2px; }
    .rc-exp-btn::after { content: ''; position: absolute; inset: -3px; border-radius: 12px; border: 2px solid rgba(99,102,241,.6); opacity: 0; pointer-events: none; animation: rcExpPulso 1.8s ease-out .6s 3; }
    @@keyframes rcExpPulso { 0% { opacity: .9; transform: scale(1); } 100% { opacity: 0; transform: scale(1.14); } }
    .rc-exp-fmt { display: inline-flex; gap: 3px; padding-left: 8px; border-left: 1px solid rgba(255,255,255,.4); }
    .rc-exp-fmt span { width: 20px; height: 20px; border-radius: 5px; background: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 11px; }
    .rc-exp-fmt .xls { color: #217346; }
    .rc-exp-fmt .pdf { color: #D93025; }
    .rc-exp-fmt .mail { color: #0284C7; }
    .rc-exp-caret { font-size: 10px; transition: transform .15s; }
    .rc-exp.open .rc-exp-caret { transform: rotate(180deg); }
    .rc-exp.busy .rc-exp-btn { pointer-events: none; opacity: .85; }
    .rc-exp-menu { position: absolute; right: 0; top: calc(100% + 8px); width: 300px; max-width: calc(100vw - 32px); background: #fff; border: 1px solid #e3e6f0; border-radius: 12px; box-shadow: 0 12px 32px rgba(22,9,51,.18); padding: 6px; z-index: 1050; opacity: 0; visibility: hidden; transform: translateY(-4px); transition: opacity .15s, transform .15s, visibility .15s; }
    .rc-exp.open .rc-exp-menu { opacity: 1; visibility: visible; transform: none; }
    .rc-exp-menu-title { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; color: #a39cc0; padding: 8px 10px 6px; }
    .rc-exp-opt { display: flex; align-items: center; gap: 12px; width: 100%; border: 0; background: transparent; padding: 9px 10px; border-radius: 9px; text-align: left; cursor: pointer; }
    .rc-exp-opt:hover, .rc-exp-opt:focus-visible { background: #f6f5fd; outline: none; }
    .rc-exp-ic { width: 36px; height: 36px; border-radius: 9px; display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }
    .rc-exp-opt.xls .rc-exp-ic { background: #e8f3ec; color: #217346; }
    .rc-exp-opt.pdf .rc-exp-ic { background: #fdecea; color: #D93025; }
    .rc-exp-opt.img .rc-exp-ic { background: rgba(88,58,255,.1); color: #583AFF; }
    .rc-exp-opt.mail .rc-exp-ic { background: #e0f2fe; color: #0284C7; }
    .rc-exp-txt { display: flex; flex-direction: column; min-width: 0; }
    .rc-exp-t { font-size: 13.5px; font-weight: 700; color: #2d3748; }
    .rc-exp-s { font-size: 12px; color: #5B5570; }
    .rc-exp-sep { height: 1px; background: #eceaf5; margin: 4px 6px; }

    /* Modal de correo (formulario: look claro de Bootstrap) */
    .rc-mail-ctx { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
    .rc-mail-yo { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: 1px solid #e3e6f0; border-radius: 10px; background: #f8f9fc; margin-bottom: 14px; cursor: pointer; }
    .rc-mail-yo input { width: 16px; height: 16px; margin: 0; flex-shrink: 0; accent-color: #583AFF; }
    .rc-mail-yo-t { font-size: 13.5px; font-weight: 700; color: #2d3748; display: block; }
    .rc-mail-yo-s { font-size: 12.5px; color: #5B5570; word-break: break-all; }
    .rc-mail-yo.disabled { cursor: default; opacity: .7; }
    .rc-mail-adj { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: #5B5570; margin-top: 12px; }
    .rc-mail-adj .fa-file-excel { color: #217346; font-size: 15px; }
    .rc-mail-adj .fa-file-pdf { color: #D93025; font-size: 15px; }

    @@media (prefers-reduced-motion: reduce) {
        .rc-exp-btn, .rc-exp-btn::after, .rc-exp-btn:hover .rc-exp-icono i { animation: none; }
    }

    @@media (max-width: 767.98px) {
        .rc-steps { display: none; }
        .rc-status { flex-direction: column; align-items: flex-start; }
        .rc-counters { width: 100%; }
        .rc-actions .btn-group-actions .btn, .rc-actions .btn-group-actions form { width: 100%; }
    }
</style>

<div class="container-fluid px-4">

    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas fa-clipboard-check powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@Resources.Strings.RevisarCargue_HeaderTitle</h1>
            <div class="rc-steps">
                <span class="rc-step"><i class="fas fa-check-circle"></i>@Resources.Strings.RevisarCargue_Paso_Subir</span>
                <span class="rc-step-sep"></span>
                <span class="rc-step active"><i class="fas fa-search"></i>@Resources.Strings.RevisarCargue_Paso_Revisar</span>
                <span class="rc-step-sep"></span>
                <span class="rc-step"><i class="far fa-circle"></i>@Resources.Strings.RevisarCargue_Paso_Confirmar</span>
            </div>
        </div>
    </div>

    <div class="rc-stack mt-3">

      @* #rcCaptura = lo que se copia como imagen (estado + hallazgos, sin el botón Exportar). *@
      <div class="rc-stack" id="rcCaptura">

        <!-- Tarjeta de estado -->
        <div class="rc-card">
            <div class="rc-status">
                <div class="rc-status-icon @estado">
                    <i class="fas @(estado == "err" ? "fa-times-circle" : estado == "adv" ? "fa-exclamation-triangle" : "fa-check-circle")"></i>
                </div>
                <div class="rc-status-text">
                    @if (estado == "err")
                    {
                        <h2 class="rc-status-title">@Resources.Strings.RevisarCargue_EstadoErrores_Titulo</h2>
                        <p class="rc-status-desc">@(nErr == 1 ? Resources.Strings.RevisarCargue_EstadoErrores_Texto1 : string.Format(Resources.Strings.RevisarCargue_EstadoErrores_Texto, nErr))</p>
                    }
                    else if (estado == "adv")
                    {
                        <h2 class="rc-status-title">@Resources.Strings.RevisarCargue_EstadoAdvertencias_Titulo</h2>
                        <p class="rc-status-desc">@Resources.Strings.RevisarCargue_EstadoAdvertencias_Texto</p>
                    }
                    else
                    {
                        <h2 class="rc-status-title">@Resources.Strings.RevisarCargue_EstadoOk_Titulo</h2>
                        <p class="rc-status-desc">@Resources.Strings.RevisarCargue_EstadoOk_Texto</p>
                    }
                </div>
                <div class="rc-counters">
                    @if (nErr > 0)
                    {
                        <div class="rc-counter err">
                            <div class="rc-counter-num">@nErr</div>
                            <div class="rc-counter-lbl">@(nErr == 1 ? Resources.Strings.RevisarCargue_Contador_Error : Resources.Strings.RevisarCargue_Contador_Errores)</div>
                        </div>
                    }
                    @if (nAdv > 0)
                    {
                        <div class="rc-counter adv">
                            <div class="rc-counter-num">@nAdv</div>
                            <div class="rc-counter-lbl">@(nAdv == 1 ? Resources.Strings.RevisarCargue_Contador_Advertencia : Resources.Strings.RevisarCargue_Contador_Advertencias)</div>
                        </div>
                    }
                </div>
            </div>
            <div class="rc-meta">
                <div class="rc-file"><i class="fas fa-file-excel"></i><span title="@Model.NombreArchivo">@Model.NombreArchivo</span></div>
                <div class="rc-pills">
                    <span class="rc-pill">@Resources.Strings.RevisarCargue_Empresa <b>@Model.Lote.NombreEmpresa</b></span>
                    <span class="rc-pill">@Resources.Strings.RevisarCargue_Anio <b>@Model.Lote.Anio</b></span>
                    <span class="rc-pill">@Resources.Strings.RevisarCargue_Modo <b>@(Model.Lote.Modo == 0 ? Resources.Strings.RevisarCargue_ModoEjecucion : Resources.Strings.RevisarCargue_ModoHistorico)</b></span>
                    <span class="rc-pill">@Resources.Strings.RevisarCargue_Escenario <b>@Model.Lote.IdEscenario</b></span>
                </div>
            </div>
        </div>

        @if (impacto != null && impacto.Tablas.Count > 0)
        {
            <!-- Impacto sobre los datos actuales -->
            <div class="rc-card rc-imp @(impVacio ? "vacio" : (impRiesgo ? "riesgo" : ""))">
                <h3 class="rc-imp-title"><i class="fas fa-balance-scale"></i>@Resources.Strings.RevisarCargue_Imp_Titulo</h3>
                <p class="rc-imp-desc">@string.Format(Resources.Strings.RevisarCargue_Imp_Desc, Model.Lote.NombreEmpresa, Model.Lote.Anio, Model.Lote.Modo == 0 ? Resources.Strings.RevisarCargue_ModoEjecucion : Resources.Strings.RevisarCargue_ModoHistorico, Model.Lote.IdEscenario)</p>
                <table class="rc-imp-table">
                    <thead>
                        <tr>
                            <th>@Resources.Strings.RevisarCargue_Imp_ThTabla</th>
                            <th class="num">@Resources.Strings.RevisarCargue_Imp_ThActuales</th>
                            <th class="num">@Resources.Strings.RevisarCargue_Imp_ThNuevas</th>
                            <th>@Resources.Strings.RevisarCargue_Imp_ThEstado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in impacto.Tablas)
                        {
                            <tr>
                                <td>@t.Tabla</td>
                                <td class="num">@t.Existentes.ToString("N0")</td>
                                <td class="num">@t.Nuevas.ToString("N0")</td>
                                <td>
                                    @if (t.QuedaVacia)
                                    {<span class="rc-imp-tag vac">@Resources.Strings.RevisarCargue_Imp_EstadoVacia</span>}
                                    else if (impacto.EsReduccionFuerte(t))
                                    {<span class="rc-imp-tag red">@Resources.Strings.RevisarCargue_Imp_EstadoReduccion</span>}
                                    else
                                    {<span class="rc-imp-tag ok">@Resources.Strings.RevisarCargue_Imp_EstadoOk</span>}
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td>@Resources.Strings.RevisarCargue_Imp_Total</td>
                            <td class="num">@impacto.TotalExistentes.ToString("N0")</td>
                            <td class="num">@impacto.TotalNuevas.ToString("N0")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>

                @if (impVacio)
                {
                    <div class="rc-imp-alert vacio"><i class="fas fa-ban mr-1"></i>@string.Format(Resources.Strings.RevisarCargue_Imp_AlertaVacio, Model.Lote.Anio)</div>
                }
                else if (impRiesgo)
                {
                    <div class="rc-imp-alert riesgo">
                        <i class="fas fa-exclamation-triangle mr-1"></i>@string.Format(Resources.Strings.RevisarCargue_Imp_AlertaRiesgo, impacto.TotalExistentes.ToString("N0"), impacto.TotalNuevas.ToString("N0"), impacto.PorcentajeConservado, impacto.UmbralPct)
                        <label class="rc-imp-check">
                            <input type="checkbox" id="chkReemplazo" name="confirmarReemplazo" value="true" form="frmConfirmarCargue" />
                            <span>@string.Format(Resources.Strings.RevisarCargue_Imp_Entiendo, impacto.TotalExistentes.ToString("N0"), impacto.TotalNuevas.ToString("N0"))</span>
                        </label>
                    </div>
                }
            </div>
        }

        <!-- Tarjeta de hallazgos -->
        <div class="rc-card rc-hall">
            <div class="rc-hall-head">
                <h3 class="rc-hall-title"><i class="fas fa-list"></i>@Resources.Strings.RevisarCargue_Hallazgos</h3>
                @if (hayHallazgos)
                {
                    <div class="rc-hall-tools">
                        <div class="rc-seg" id="rcFiltro">
                            <button type="button" class="active" data-filtro="all">@Resources.Strings.RevisarCargue_Filtro_Todos<span class="rc-cnt">@hallazgos.Count</span></button>
                            <button type="button" data-filtro="err">@Resources.Strings.RevisarCargue_Filtro_Errores<span class="rc-cnt">@hallazgos.Count(x => x.Severidad == CargueLoteSeveridad.Error)</span></button>
                            <button type="button" data-filtro="adv">@Resources.Strings.RevisarCargue_Filtro_Advertencias<span class="rc-cnt">@hallazgos.Count(x => x.Severidad != CargueLoteSeveridad.Error)</span></button>
                        </div>

                        <div class="rc-exp" id="rcExp">
                            <button type="button" class="rc-exp-btn" id="rcExpBtn" aria-haspopup="true" aria-expanded="false" title="@Resources.Strings.RevisarCargue_Exp_BtnTooltip">
                                <span class="rc-exp-icono"><i class="fas fa-arrow-up-from-bracket" id="rcExpIcono"></i></span><span id="rcExpTexto">@Resources.Strings.RevisarCargue_Exp_Btn</span>
                                <span class="rc-exp-fmt" aria-hidden="true">
                                    <span class="xls"><i class="fas fa-file-excel"></i></span>
                                    <span class="pdf"><i class="fas fa-file-pdf"></i></span>
                                    <span class="mail"><i class="fas fa-envelope"></i></span>
                                </span>
                                <i class="fas fa-chevron-down rc-exp-caret"></i>
                            </button>
                            <div class="rc-exp-menu" role="menu" aria-labelledby="rcExpBtn">
                                <div class="rc-exp-menu-title">@Resources.Strings.RevisarCargue_Exp_MenuTitulo</div>
                                <button type="button" class="rc-exp-opt xls" role="menuitem" data-accion="excel">
                                    <span class="rc-exp-ic"><i class="fas fa-file-excel"></i></span>
                                    <span class="rc-exp-txt"><span class="rc-exp-t">@Resources.Strings.RevisarCargue_Exp_Excel</span><span class="rc-exp-s">@Resources.Strings.RevisarCargue_Exp_ExcelDesc</span></span>
                                </button>
                                <button type="button" class="rc-exp-opt pdf" role="menuitem" data-accion="pdf">
                                    <span class="rc-exp-ic"><i class="fas fa-file-pdf"></i></span>
                                    <span class="rc-exp-txt"><span class="rc-exp-t">@Resources.Strings.RevisarCargue_Exp_Pdf</span><span class="rc-exp-s">@Resources.Strings.RevisarCargue_Exp_PdfDesc</span></span>
                                </button>
                                <button type="button" class="rc-exp-opt img" role="menuitem" data-accion="imagen">
                                    <span class="rc-exp-ic"><i class="fas fa-image"></i></span>
                                    <span class="rc-exp-txt"><span class="rc-exp-t">@Resources.Strings.RevisarCargue_Exp_Imagen</span><span class="rc-exp-s">@Resources.Strings.RevisarCargue_Exp_ImagenDesc</span></span>
                                </button>
                                <div class="rc-exp-sep"></div>
                                <button type="button" class="rc-exp-opt mail" role="menuitem" data-accion="correo">
                                    <span class="rc-exp-ic"><i class="fas fa-envelope"></i></span>
                                    <span class="rc-exp-txt"><span class="rc-exp-t">@Resources.Strings.RevisarCargue_Exp_Correo</span><span class="rc-exp-s">@Resources.Strings.RevisarCargue_Exp_CorreoDesc</span></span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (!hallazgos.Any())
            {
                <div class="rc-empty">
                    <div class="rc-empty-icon"><i class="fas fa-check-circle"></i></div>
                    <h4>@Resources.Strings.RevisarCargue_SinHallazgosTitulo</h4>
                    <p>@Resources.Strings.RevisarCargue_SinHallazgosTexto</p>
                </div>
            }
            else
            {
                <div class="rc-list">
                    @foreach (var h in hallazgos)
                    {
                        bool esError = h.Severidad == CargueLoteSeveridad.Error;
                        string titulo = esIngles && !string.IsNullOrWhiteSpace(h.TituloEn) ? h.TituloEn : h.Titulo;
                        <div class="rc-item @(esError ? "err" : "adv")" data-sev="@(esError ? "err" : "adv")">
                            <div class="rc-item-bar"></div>
                            <i class="fas @(esError ? "fa-times-circle" : "fa-exclamation-triangle") rc-item-icon"></i>
                            <div class="rc-item-body">
                                <div>
                                    <span class="rc-item-sev">@(esError ? Resources.Strings.RevisarCargue_SeveridadError : Resources.Strings.RevisarCargue_SeveridadAdvertencia)</span>
                                    @if (!string.IsNullOrEmpty(titulo))
                                    {
                                        <span class="rc-item-title">@titulo</span>
                                    }
                                </div>
                                <div class="rc-item-msg">@(esIngles && !string.IsNullOrWhiteSpace(h.MensajeEn) ? h.MensajeEn : h.Mensaje)</div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

      </div>

        <!-- Acciones -->
        <div class="rc-actions">
            <div class="btn-group-actions">
                @using (Html.BeginForm("ConfirmarCargue", "Datos", FormMethod.Post, new { id = "frmConfirmarCargue" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("idLote", Model.Lote.IdLote)
                    <button type="submit" id="btnConfirmarCargue" class="btn btn-modern-gradient" @((puedeConfirmar && !impRiesgo) ? "" : "disabled")>
                        <i class="fas fa-check"></i>@(nAdv > 0 && !hayErrores ? Resources.Strings.RevisarCargue_BtnConfirmarConAdvertencias : Resources.Strings.RevisarCargue_BtnConfirmar)
                    </button>
                }
                @if (hayErrores)
                {
                    <a href="@Url.Action("CargueExcel", "Datos", new { idEmpresa = Model.Lote.IdEmpresa, anio = Model.Lote.Anio, idEscenario = Model.Lote.IdEscenario })" class="btn btn-modern-gradient rc-btn-subir">
                        <i class="fas fa-file-upload"></i>@Resources.Strings.RevisarCargue_BtnSubirCorregido
                    </a>
                }
                <button type="button" class="btn btn-modern-secondary" data-toggle="modal" data-target="#descartarCargueModal">
                    <i class="fas fa-trash-alt"></i>@Resources.Strings.RevisarCargue_BtnDescartar
                </button>
            </div>
            <div class="rc-help">
                @if (hayErrores)
                {
                    <i class="fas fa-lock lock"></i>@Resources.Strings.RevisarCargue_AyudaBloqueado
                }
                else
                {
                    <i class="fas fa-shield-alt shield"></i>@Resources.Strings.RevisarCargue_AyudaSeguro
                }
            </div>
        </div>

    </div>
</div>

