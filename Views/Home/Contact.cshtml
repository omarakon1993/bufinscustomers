@{
    ViewBag.Title = Resources.Strings.Contact_Title;
}
<main aria-labelledby="title">
    <h2 id="title">@ViewBag.Title.</h2>
    <h3>@ViewBag.Message</h3>

    <address>
        @Html.Raw(Resources.Strings.Contact_Address)
    </address>

    <address>
        <strong>@Resources.Strings.Contact_Support</strong>   <a href="mailto:Support@example.com">Support@example.com</a><br />
        <strong>@Resources.Strings.Contact_Marketing</strong> <a href="mailto:Marketing@example.com">Marketing@example.com</a>
    </address>
</main>