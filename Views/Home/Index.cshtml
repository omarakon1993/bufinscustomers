@using bufinscustomers.Helpers
@{
    ViewBag.Title = "Inicio";

    var usuario  = UsuarioSesionHelper.UsuarioActual;
    var empresas = ViewBag.Empresas as List<bufinscustomers.Models.Empresas>;

    var empMap = new Dictionary<int, string>();
    var empAbrevMap = new Dictionary<int, string>();
    if (empresas != null)
    {
        foreach (var e in empresas)
        {
            empMap[e.Id] = e.Nombre;
            empAbrevMap[e.Id] = !string.IsNullOrWhiteSpace(e.Abreviatura)
                ? e.Abreviatura.ToUpper()
                : (e.Nombre.Length >= 3 ? e.Nombre.Substring(0, 3).ToUpper() : e.Nombre.ToUpper());
        }
    }

    // "Mi consumo de IA": solo Super Admin y Admin de Empresa (igual que Análisis IA) y solo si la IA está visible.
    bool verConsumoIA = (UsuarioSesionHelper.EsSuperAdmin() || UsuarioSesionHelper.EsAdminEmpresa()) && IAModuloHelper.Visible();
    var empresasConsumo = (empresas ?? new List<bufinscustomers.Models.Empresas>()).OrderBy(e => e.Nombre).ToList();
    int empresaConsumoSel = usuario != null && usuario.IdEmpresa.HasValue && empMap.ContainsKey(usuario.IdEmpresa.Value)
        ? usuario.IdEmpresa.Value
        : (empresasConsumo.Any() ? empresasConsumo.First().Id : 0);

    int hora = DateTime.Now.Hour;
    string saludoHtml = hora >= 5 && hora < 12 ? Resources.Strings.Home_GreetingMorning
                      : hora >= 12 && hora < 19 ? Resources.Strings.Home_GreetingAfternoon
                      : Resources.Strings.Home_GreetingEvening;
    string nombreUsuario = usuario != null ? usuario.Nombre : "usuario";
    string nombreEmpresaActual = usuario != null && usuario.IdEmpresa.HasValue && empMap.ContainsKey(usuario.IdEmpresa.Value) ? empMap[usuario.IdEmpresa.Value] : null;
    string abrevEmpresaActual = usuario != null && usuario.IdEmpresa.HasValue && empAbrevMap.ContainsKey(usuario.IdEmpresa.Value) ? empAbrevMap[usuario.IdEmpresa.Value] : null;

    // Si la empresa principal del usuario pertenece a un grupo empresarial, mostramos las
    // empresas hermanas del grupo para que sepa que también puede consultarlas.
    // (ViewBag.Empresas ya viene filtrado por EmpresaAccesoHelper: para un usuario no Super
    // Admin contiene exactamente su empresa + las del mismo grupo.)
    var empresaPropia = usuario != null && usuario.IdEmpresa.HasValue && empresas != null
        ? empresas.FirstOrDefault(e => e.Id == usuario.IdEmpresa.Value)
        : null;
    string nombreGrupoEmpresarial = empresaPropia != null ? empresaPropia.NombreGrupoEmpresarial : null;
    var empresasGrupo = empresaPropia != null && empresaPropia.IdGrupoEmpresarial.HasValue && empresas != null
        ? empresas.Where(e => e.IdGrupoEmpresarial == empresaPropia.IdGrupoEmpresarial && e.Id != empresaPropia.Id)
                  .OrderBy(e => e.Nombre).ToList()
        : new List<bufinscustomers.Models.Empresas>();
}


<div class="dash-wrapper">

    <div class="dash-header-card">
        <div class="dash-header-main">
            @if (UsuarioSesionHelper.EsSuperAdmin())
            {
                if (empresas != null && empresas.Any())
                {
                    <div class="dash-empresa-row dash-empresa-row-multi">
                        @foreach (var e in empresas.OrderBy(e => e.Nombre))
                        {
                            <span class="dash-empresa-chip-light" title="@e.Nombre">@(empAbrevMap.ContainsKey(e.Id) ? empAbrevMap[e.Id] : e.Nombre)</span>
                        }
                    </div>
                }
            }
            else if (!string.IsNullOrEmpty(nombreEmpresaActual))
            {
                <div class="dash-empresa-row">
                    @if (!string.IsNullOrEmpty(abrevEmpresaActual))
                    {
                        <span class="dash-empresa-chip">@abrevEmpresaActual</span>
                    }
                    <span class="dash-empresa-nombre"><i class="fas fa-building"></i>@nombreEmpresaActual</span>
                </div>

                if (empresasGrupo.Any())
                {
                    <div class="dash-grupo-row">
                        <span class="dash-grupo-label" title="@nombreGrupoEmpresarial">
                            <i class="fas fa-sitemap"></i>
                            @(!string.IsNullOrEmpty(nombreGrupoEmpresarial) ? nombreGrupoEmpresarial : Resources.Strings.Home_GrupoLabel)
                        </span>
                        <span class="dash-grupo-acceso">@string.Format(Resources.Strings.Home_GrupoAcceso, empresasGrupo.Count)</span>
                        <span class="dash-grupo-chips">
                            @foreach (var eg in empresasGrupo)
                            {
                                <span class="dash-empresa-chip-light" title="@eg.Nombre">@(empAbrevMap.ContainsKey(eg.Id) ? empAbrevMap[eg.Id] : eg.Nombre)</span>
                            }
                        </span>
                    </div>
                }
            }
            <div class="dash-greeting-text">
                <span class="dash-hello">@Html.Raw(saludoHtml), <strong>@nombreUsuario</strong></span>
                <span class="dash-date"><i class="fas fa-calendar-alt"></i>@DateTime.Now.ToString(Resources.Strings.Home_DateFormat, System.Globalization.CultureInfo.CurrentCulture)</span>
            </div>
        </div>
        <div class="dash-header-divider"></div>
        <img src="~/Assets/img/Bufins_LogoLogin.png" alt="Bufins" class="dash-greeting-logo">
    </div>

    <!-- Alertas Bufins: las genera sp_ObtenerAlertasHome (se cargan por AJAX) -->
    <div class="dash-section" id="alertas-section">
        <div class="dash-section-label dash-section-toggle" data-target="sec-alertas-body" title="@Resources.Strings.Home_TooltipColapsar">
            <i class="fas fa-shield-alt"></i> @Resources.Strings.Home_SectionAlertas
            <span class="dash-adv-count-badge" id="alertas-badge" style="display:none;"></span>
            <i class="fas fa-chevron-down dash-section-chevron" style="font-size:.62rem;margin-left:.3rem;"></i>
        </div>
        <div id="sec-alertas-body">
            <div class="dash-adv-grid" id="alertas-grid"></div>
        </div>
    </div>

    <div class="dash-section" id="indic-section" style="position:relative;z-index:1;margin-bottom:1.75rem;">
        <div class="dash-section-label dash-section-toggle" data-target="sec-indic-body" title="@Resources.Strings.Home_TooltipColapsar">
            <i class="fas fa-chart-line"></i> @Resources.Strings.Home_SectionIndicadores
            <button id="btn-indic-refresh" class="dash-indic-refreshbtn" title="@Resources.Strings.Home_IndicadoresActualizar">
                <i class="fas fa-sync-alt"></i>
            </button>
            <i class="fas fa-chevron-down dash-section-chevron" style="font-size:.62rem;margin-left:.3rem;"></i>
        </div>
        <div id="sec-indic-body">

        <div id="indic-loading" style="font-size:.78rem;color:#A0A0B8;display:flex;align-items:center;gap:.5rem;padding:.5rem 0;">
            <i class="fas fa-spinner fa-spin"></i> @Resources.Strings.Home_IndicadoresCargando
        </div>

        <div id="indic-content" style="display:none;">
            <div class="dash-indic-grid">

                <!-- Tasa de cambio USD/COP -->
                <div class="dash-indic-trm-card">
                    <div class="dash-kpi-icon" style="background:linear-gradient(135deg,#28A745,#01E1D7)">
                        <i class="fas fa-dollar-sign"></i>
                    </div>
                    <div class="dash-kpi-value" id="trm-valor">—</div>
                    <div class="dash-kpi-label">@Resources.Strings.Home_TRM_Titulo</div>
                    <div class="dash-kpi-etiqueta" id="trm-fecha"></div>
                    <div class="dash-kpi-etiqueta" id="trm-eur"></div>
                    <div class="dash-kpi-empresa">
                        <i class="fas fa-link"></i> @Resources.Strings.Home_TRM_Fuente
                    </div>
                </div>

                <!-- Noticias -->
                <div class="dash-noticias-card">
                    <div class="dash-noticias-hdr">
                        <i class="fas fa-newspaper"></i>
                        <span>@Resources.Strings.Home_Noticias_Titulo</span>
                    </div>
                    <div id="noticias-leyenda" class="dash-noticias-leyenda" style="display:none;"></div>
                    <div id="noticias-container" style="display:none;"></div>
                    <div class="dash-noticias-hint" id="noticias-hint" style="display:none;"></div>
                </div>

            </div>
        </div>
        </div><!-- /sec-indic-body -->
    </div>

    <div class="dash-row@(verConsumoIA ? " dash-row-2" : "")">

        <!-- Accesos rápidos -->
        <div class="dash-section" id="accesos-section">
            <div class="dash-section-label dash-section-toggle" data-target="sec-accesos-body" title="@Resources.Strings.Home_TooltipColapsar">
                <i class="fas fa-bolt"></i> @Resources.Strings.Home_SectionAccesos
                <i class="fas fa-chevron-down dash-section-chevron" style="margin-left:auto;font-size:.62rem;"></i>
            </div>
            <div id="sec-accesos-body">
                <div class="dash-acc-grid" id="accesos-grid"></div>
                <div class="dash-noticias-hint" id="accesos-hint" style="display:none;"></div>
            </div>
        </div>

        @if (verConsumoIA)
        {
            <!-- Consumo de IA -->
            <div class="dash-section" id="ia-section">
                <div class="dash-section-label dash-section-toggle" data-target="sec-ia-body" title="@Resources.Strings.Home_TooltipColapsar">
                    <i class="fas fa-chart-pie"></i> @Resources.Strings.IAConsumo_Titulo
                    <i class="fas fa-chevron-down dash-section-chevron" style="margin-left:auto;font-size:.62rem;"></i>
                </div>
                <div id="sec-ia-body">
                    <div class="dash-ia-card">
                        @if (empresasConsumo.Count > 1)
                        {
                            <select id="ia-empresa" class="form-control form-control-sm dash-ia-select" aria-label="@Resources.Strings.Home_ConsumoIA_Empresa">
                                @foreach (var e in empresasConsumo)
                                {
                                    <option value="@e.Id" @(e.Id == empresaConsumoSel ? "selected" : "")>@e.Nombre</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input type="hidden" id="ia-empresa" value="@empresaConsumoSel" />
                        }
                        <div class="dash-ia-texto" id="ia-texto"><i class="fas fa-spinner fa-spin"></i></div>
                        <div class="dash-ia-track"><div class="dash-ia-fill" id="ia-barra"></div></div>
                        <div class="dash-ia-meta" id="ia-meta"></div>
                        <a class="dash-ia-link" href="@Url.Action("Index", "AnalisisIA")">@Resources.Strings.Home_ConsumoIA_VerDetalle <i class="fas fa-arrow-right"></i></a>
                    </div>
                </div>
            </div>
        }

    </div>


</div>

<style>
    .dash-wrapper { position:relative; min-height:70vh; padding:0 0 2rem; }

    .dash-header-card {
        position:relative; z-index:1; overflow:hidden;
        display:flex; align-items:center; gap:1.5rem;
        background:#fff; border-radius:14px;
        padding:1.15rem 1.5rem;
        margin-bottom:1.75rem;
        border:1px solid rgba(88,58,255,.08);
        box-shadow:0 4px 22px rgba(88,58,255,.07);
    }
    .dash-header-card::before {
        content:''; position:absolute; top:0; left:0; right:0; height:3px;
        background:linear-gradient(90deg,#583AFF 0%,#01E1D7 100%);
    }
    .dash-header-main { flex:1; min-width:0; }

    .dash-empresa-row {
        display:flex; align-items:center; gap:.6rem; margin-bottom:.7rem;
        background:linear-gradient(90deg,rgba(88,58,255,.06),rgba(1,225,215,.06));
        border:1px solid rgba(88,58,255,.12);
        border-radius:10px; padding:.45rem .7rem; width:fit-content; max-width:100%;
    }
    .dash-empresa-chip {
        display:inline-flex; align-items:center; flex-shrink:0;
        font-size:.68rem; font-weight:800; letter-spacing:.05em;
        color:#fff; text-transform:uppercase;
        background:linear-gradient(135deg,#583AFF,#01E1D7);
        padding:.25rem .55rem; border-radius:6px;
        box-shadow:0 2px 6px rgba(88,58,255,.35);
    }
    .dash-empresa-nombre {
        font-size:1.05rem; font-weight:800; color:#160933;
        letter-spacing:-.01em;
        display:inline-flex; align-items:center; gap:.45rem;
        overflow:hidden; text-overflow:ellipsis; white-space:nowrap; min-width:0;
    }
    .dash-empresa-nombre i { font-size:.85rem; color:#583AFF; flex-shrink:0; }

    .dash-empresa-row-multi { flex-wrap:wrap; row-gap:.35rem; }
    .dash-empresa-chip-light {
        display:inline-flex; align-items:center;
        font-size:.56rem; font-weight:700; letter-spacing:.03em;
        color:#583AFF; text-transform:uppercase;
        background:rgba(88,58,255,.07);
        border:1px solid rgba(88,58,255,.15);
        padding:.14rem .35rem; border-radius:4px;
        cursor:default;
    }

    /* Grupo empresarial: empresas hermanas a las que el usuario también tiene acceso */
    .dash-grupo-row {
        display:flex; align-items:center; flex-wrap:wrap; gap:.4rem;
        margin-bottom:.5rem;
    }
    .dash-grupo-label {
        display:inline-flex; align-items:center; gap:.3rem;
        font-size:.6rem; font-weight:800; letter-spacing:.03em;
        color:#583AFF; text-transform:uppercase;
        background:rgba(88,58,255,.07);
        border:1px solid rgba(88,58,255,.15);
        padding:.16rem .45rem; border-radius:5px;
    }
    .dash-grupo-label i { font-size:.6rem; }
    .dash-grupo-acceso { font-size:.66rem; font-weight:600; color:#9691AE; }
    .dash-grupo-chips { display:flex; flex-wrap:wrap; gap:.3rem; }

    .dash-greeting-text { display:flex; flex-direction:column; gap:.2rem; }
    .dash-hello { font-size:1.3rem; font-weight:800; color:#160933; letter-spacing:-.2px; }
    .dash-hello strong { color:#583AFF; }
    .dash-date {
        font-size:.78rem; font-weight:600; color:#9691AE; text-transform:capitalize;
        display:flex; align-items:center; gap:.4rem;
    }
    .dash-date i { font-size:.72rem; color:#B9B4D4; }

    .dash-header-divider {
        width:1px; align-self:stretch;
        background:linear-gradient(to bottom, transparent, rgba(88,58,255,.18), transparent);
        flex-shrink:0;
    }
    .dash-greeting-logo { height:34px; width:auto; opacity:.55; flex-shrink:0; }

    .dash-section { position:relative; z-index:1; margin-bottom:1.75rem; }
    .dash-section-label {
        font-size:.68rem; font-weight:700; color:#583AFF;
        text-transform:uppercase; letter-spacing:1px;
        margin-bottom:.65rem;
        display:flex; align-items:center; gap:.4rem;
    }
    .dash-section-toggle { cursor:pointer; user-select:none; }
    .dash-section-toggle:hover { opacity:.8; }
    .dash-section-chevron { transition:transform .2s ease; opacity:.6; flex-shrink:0; }
    .dash-section-chevron.rotado { transform:rotate(-90deg); }

    .dash-kpi-icon { width:35px; height:35px; border-radius:8px; display:flex; align-items:center; justify-content:center; color:#fff; font-size:.85rem; flex-shrink:0; }
    .dash-kpi-body { min-width:0; flex:1; }
    .dash-kpi-value { font-size:1.1rem; font-weight:700; color:#160933; line-height:1.1; display:flex; align-items:baseline; gap:.3rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .dash-kpi-unit  { font-size:.58rem; font-weight:600; color:#583AFF; }
    .dash-kpi-label { font-size:.60rem; font-weight:600; color:#393F45; text-transform:uppercase; letter-spacing:.5px; margin-top:3px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .dash-kpi-etiqueta { font-size:.60rem; color:#A0A0B8; margin-top:2px; }
    .dash-kpi-empresa  { font-size:.58rem; color:#A0A0B8; margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .dash-kpi-empresa i { font-size:.50rem; }

    /* ---------- Indicadores de Mercado ---------- */
    .dash-indic-refreshbtn {
        margin-left:auto; background:none; border:none; cursor:pointer;
        color:#A0A0B8; font-size:.75rem; padding:2px 4px;
        transition:color .15s;
    }
    .dash-indic-refreshbtn:hover { color:#583AFF; }

    .dash-indic-grid {
        display:grid;
        grid-template-columns:190px 1fr;
        gap:12px;
        align-items:stretch;
    }

    /* TRM — tarjeta oscura destacada, la sección ahora es la protagonista */
    .dash-indic-trm-card {
        min-width:0; background:var(--app-glow-bg);
        border-radius:11px; padding:16px 14px;
        display:flex; flex-direction:column; justify-content:center; gap:4px;
        box-shadow:0 6px 16px rgba(22,9,51,.22);
    }
    .dash-indic-trm-card .dash-kpi-icon {
        width:32px; height:32px; margin-bottom:4px;
    }
    .dash-indic-trm-card .dash-kpi-value    { color:#fff; font-size:1.25rem; }
    .dash-indic-trm-card .dash-kpi-label    { font-size:.64rem; color:rgba(255,255,255,.55); text-transform:uppercase; letter-spacing:.5px; }
    .dash-indic-trm-card .dash-kpi-etiqueta { font-size:.6rem; color:rgba(255,255,255,.4); }
    .dash-indic-trm-card .dash-kpi-empresa  { font-size:.58rem; color:#01E1D7; margin-top:6px; }

    /* Noticias */
    .dash-noticias-card {
        background:#fff;
        border:1px solid rgba(88,58,255,.12);
        border-radius:11px;
        box-shadow:0 4px 14px rgba(22,9,51,.06);
        overflow:hidden;
        display:flex; flex-direction:column;
    }
    .dash-noticias-hdr {
        display:flex; align-items:center; gap:.5rem;
        padding:10px 14px;
        font-size:.78rem; font-weight:800; color:#160933;
        border-bottom:1px solid rgba(88,58,255,.08);
    }
    .dash-noticias-hdr i { color:#583AFF; }

    /* Leyenda de portales — se conserva, tratamiento sutil */
    .dash-noticias-leyenda {
        display:flex; flex-wrap:wrap; gap:.4rem;
        padding:7px 12px;
        background:#FAFAFA;
        border-bottom:1px solid rgba(88,58,255,.07);
    }
    .feed-leyenda-item {
        display:flex; align-items:center; gap:.3rem;
        font-size:.62rem; font-weight:700;
        color:#8A86A8; text-transform:uppercase; letter-spacing:.4px;
        background:#fff; border:1px solid rgba(88,58,255,.08);
        border-radius:99px; padding:2px 8px;
    }
    .feed-leyenda-dot {
        width:7px; height:7px; border-radius:50%; flex-shrink:0;
    }

    /* Lista de noticias — más compacta y con scroll para caber más titulares */
    #noticias-container { max-height:280px; overflow-y:auto; }

    .dash-feed-grupo {
        margin:4px 6px 3px;
        border-left:3px solid #583AFF;
        border-radius:0 7px 7px 0;
        overflow:hidden;
    }
    .dash-feed-grupo:last-child { margin-bottom:6px; }

    .dash-feed-grupo-hdr {
        display:flex; align-items:center; gap:.4rem;
        padding:3px 8px;
        font-size:.62rem; font-weight:800;
        text-transform:uppercase; letter-spacing:.5px;
    }
    .dash-feed-grupo-hdr i { font-size:.56rem; }

    .dash-noticias-list { list-style:none; margin:0; padding:0; }
    .dash-noticia-item { border-bottom:1px solid rgba(88,58,255,.06); }
    .dash-noticia-item:last-child { border-bottom:none; }
    .dash-noticia-item a {
        display:flex; align-items:flex-start; gap:7px;
        padding:5px 10px 5px 8px;
        text-decoration:none;
        transition:background .12s;
    }
    .dash-noticia-item a:hover { background:rgba(88,58,255,.04); }
    .dash-noticia-titulo {
        font-size:.76rem; color:#160933; font-weight:500;
        line-height:1.3; flex:1; min-width:0;
        overflow:hidden; display:-webkit-box;
        -webkit-line-clamp:1; -webkit-box-orient:vertical;
    }
    .dash-noticia-fecha {
        font-size:.62rem; color:#6B6787;
        white-space:nowrap; flex-shrink:0; padding-top:1px;
    }
    .dash-noticias-hint {
        padding:12px 13px;
        font-size:.80rem; color:#A0A0B8; line-height:1.4;
    }
    .dash-trm-nodisp {
        font-size:.80rem; color:#FCA311; font-weight:600;
    }

    @@media (max-width:768px) {
        .dash-indic-grid { grid-template-columns:1fr; }
    }

    /* ---------- Advertencias Bufins ---------- */
    .dash-adv-count-badge {
        background:#ef4444; color:#fff; font-size:.62rem; font-weight:700;
        border-radius:99px; padding:.05rem .48rem; margin-left:.35rem;
    }
    .dash-adv-grid { display:flex; flex-direction:column; gap:.6rem; }
    .dash-adv-card {
        display:flex; align-items:flex-start; gap:.7rem;
        background:#fff; border-radius:10px; padding:.7rem .9rem;
        border:1px solid rgba(22,9,51,.08); border-left:4px solid #A0A0B8;
        box-shadow:0 2px 8px rgba(22,9,51,.05);
    }
    .dash-adv-icon { font-size:1.05rem; line-height:1; margin-top:.1rem; }
    .dash-adv-body { flex:1; min-width:0; }
    .dash-adv-empresa {
        display:inline-flex; align-items:center; gap:.35rem;
        font-size:.68rem; font-weight:800; color:#583AFF;
        text-transform:uppercase; letter-spacing:.03em;
        margin-bottom:.3rem;
    }
    .dash-adv-empresa i { font-size:.62rem; }
    .dash-adv-title { font-size:.82rem; font-weight:700; color:#160933; margin-bottom:.15rem; }
    .dash-adv-msg { font-size:.79rem; color:#393F45; line-height:1.45; }
    .dash-adv-success { border-left-color:#22c55e; }
    .dash-adv-success .dash-adv-icon { color:#22c55e; }
    .dash-adv-warning { border-left-color:#f59e0b; }
    .dash-adv-warning .dash-adv-icon { color:#f59e0b; }
    .dash-adv-error { border-left-color:#ef4444; }
    .dash-adv-error .dash-adv-icon { color:#ef4444; }

    /* ---------- Accesos rápidos + Consumo de IA ---------- */
    .dash-row { position:relative; z-index:1; }
    .dash-row-2 { display:grid; grid-template-columns:1fr 320px; gap:14px; align-items:start; }
    .dash-row-2 > .dash-section { min-width:0; }

    .dash-acc-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(170px,1fr)); gap:9px; }
    .dash-acc-item {
        display:flex; align-items:center; gap:10px;
        background:#fff; border:1px solid rgba(88,58,255,.12); border-radius:10px;
        padding:11px 12px; text-decoration:none !important;
        box-shadow:0 2px 8px rgba(22,9,51,.05);
        transition:transform .15s ease, box-shadow .15s ease, border-color .15s ease;
    }
    .dash-acc-item:hover { transform:translateY(-2px); box-shadow:0 6px 18px rgba(22,9,51,.1); border-color:rgba(88,58,255,.35); }
    .dash-acc-icon {
        width:35px; height:35px; border-radius:8px; flex-shrink:0;
        display:flex; align-items:center; justify-content:center;
        color:#fff; font-size:.85rem;
        background:linear-gradient(135deg,#583AFF,#01E1D7);
        box-shadow:0 4px 10px rgba(88,58,255,.25);
    }
    .dash-acc-nombre {
        font-size:.78rem; font-weight:700; color:#160933; line-height:1.25;
        overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;
    }

    .dash-ia-card {
        background:#fff; border:1px solid rgba(88,58,255,.12); border-radius:11px;
        padding:14px; box-shadow:0 4px 14px rgba(22,9,51,.06);
        display:flex; flex-direction:column; gap:6px;
    }
    .dash-ia-select { margin-bottom:4px; }
    .dash-ia-texto { font-size:.82rem; font-weight:700; color:#160933; }
    .dash-ia-track { height:10px; border-radius:6px; background:#e5e7eb; overflow:hidden; }
    .dash-ia-fill { height:100%; width:0; border-radius:6px; background:var(--content-gradient); transition:width .4s ease; }
    .dash-ia-fill.agotado { background:#ef4444; }
    .dash-ia-fill.alto { background:#f59e0b; }
    .dash-ia-meta { font-size:.68rem; color:#6B6787; line-height:1.4; }
    .dash-ia-link { align-self:flex-start; margin-top:4px; font-size:.72rem; font-weight:700; color:#583AFF; text-decoration:none; }
    .dash-ia-link:hover { text-decoration:underline; }
    .dash-ia-link i { font-size:.6rem; margin-left:.2rem; }

    .dash-adv-info { border-left-color:#3b82f6; }
    .dash-adv-info .dash-adv-icon { color:#3b82f6; }

    /* ---------- Responsive ---------- */
    @@media (max-width:900px) {
        .dash-row-2 { grid-template-columns:1fr; }
    }
    @@media (max-width:576px) {
        .dash-acc-grid { grid-template-columns:1fr 1fr; }
        .dash-header-card { padding:1rem; gap:.5rem; }
        .dash-header-divider { display:none; }
        .dash-greeting-logo { height:22px; margin-left:auto; }
        .dash-hello { font-size:1.1rem; }
        .dash-empresa-row { padding:.35rem .55rem; }
        .dash-empresa-nombre { font-size:.92rem; max-width:150px; }
    }

</style>

@section scripts {
<script>
(function () {
    var _s = {
        vigente:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_TRM_Vigente))',
        noDisp:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_TRM_NoDisponible))',
        eurLabel:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_TRM_EUR))',
        vacias:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_Noticias_Vacias))',
        noConfig:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_Noticias_NoConfig))',
        error:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_Noticias_Error))',
        colapsar:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_Noticias_Colapsar))',
        expandir:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_Noticias_Expandir))',
        irNoticia: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_Noticias_IrNoticia))',
        alertasOk:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_Alertas_SinDatos))',
        alertasError: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_Alertas_Error))',
        accSugeridos: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_Accesos_Sugeridos))',
        accVacio:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_Accesos_Vacio))',
        iaPeriodo:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IAConsumo_Periodo))',
        iaTokens:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IAConsumo_Tokens))',
        iaTokensIlim: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IAConsumo_TokensIlim))',
        iaProyeccion: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IAConsumo_Proyeccion))',
        iaPool:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IAConsumo_Pool))',
        iaApagada:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IAConsumo_Apagada))',
        iaError:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IAConsumo_Error))'
    };

    var _urlNoticias   = '@Url.Action("ObtenerNoticias", "Home")';
    var _urlAlertas    = '@Url.Action("ObtenerAlertas", "Home")';
    var _urlAccesos    = '@Url.Action("ObtenerAccesosRapidos", "Home")';
    var _urlConsumoIA  = '@Url.Action("MiConsumo", "AnalisisIA")';

    function fmtCOP(v) {
        try { return new Intl.NumberFormat('es-CO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(v); }
        catch (e) { return v; }
    }

    function esc(s) {
        if (!s) return '';
        var d = document.createElement('div');
        d.appendChild(document.createTextNode(s));
        return d.innerHTML;
    }

    // Paleta corporativa: púrpura, teal, violeta, azul
    var FEED_COLORS = ['#583AFF', '#00A89E', '#9B5DE5', '#118AB2'];
    var FEED_BGS    = ['rgba(88,58,255,.04)', 'rgba(0,168,158,.05)', 'rgba(155,93,229,.04)', 'rgba(17,138,178,.04)'];

    // Cache TRM en sessionStorage — válido 2 horas, evita fetch extra al volver al dashboard
    var TRM_KEY = 'bufins_trm';
    var TRM_TTL = 7200000;

    function mostrarTRM(cop, fecha, eur) {
        $('#trm-valor').html('$' + fmtCOP(cop));
        $('#trm-fecha').text(_s.vigente + ' ' + fecha);
        $('#trm-eur').text(eur && eur > 0 ? (_s.eurLabel + ' $' + fmtCOP(eur)) : '');
    }

    function mostrarTRMNoDisp() {
        $('#trm-valor').html('<span class="dash-trm-nodisp">' + esc(_s.noDisp) + '</span>');
        $('#trm-fecha').text('');
        $('#trm-eur').text('');
    }

    function renderNoticias(d) {
        var $ley  = $('#noticias-leyenda');
        var $cont = $('#noticias-container');
        var $hint = $('#noticias-hint');
        $ley.empty(); $cont.empty();

        if (!d.rssConfigurado) {
            $ley.hide(); $cont.hide(); $hint.text(_s.noConfig).show();
            return;
        }
        var feeds = d.feeds || [];
        if (!feeds.length) {
            $ley.hide(); $cont.hide(); $hint.text(_s.vacias).show();
            return;
        }

        // — Leyenda —
        feeds.forEach(function (f, i) {
            var color = FEED_COLORS[i % FEED_COLORS.length];
            $ley.append(
                '<span class="feed-leyenda-item">' +
                '<span class="feed-leyenda-dot" style="background:' + color + '"></span>' +
                esc(f.Fuente) +
                '</span>'
            );
        });
        $ley.show();

        // — Grupos por feed —
        feeds.forEach(function (f, i) {
            if (!f.Noticias || !f.Noticias.length) return;
            var color = FEED_COLORS[i % FEED_COLORS.length];
            var bg    = FEED_BGS[i % FEED_BGS.length];

            var $grp = $('<div class="dash-feed-grupo"></div>').css({
                'border-left-color': color,
                'background': bg
            });

            // cabecera del grupo
            $grp.append(
                '<div class="dash-feed-grupo-hdr" style="color:' + color + '">' +
                '<i class="fas fa-circle" style="font-size:.4rem;opacity:.7"></i>' +
                esc(f.Fuente) + '</div>'
            );

            // ítems
            var $ul = $('<ul class="dash-noticias-list"></ul>');
            f.Noticias.forEach(function (n) {
                var fec = n.FechaTexto
                    ? '<span class="dash-noticia-fecha">' + esc(n.FechaTexto) + '</span>'
                    : '';
                $ul.append(
                    $('<li class="dash-noticia-item"></li>').html(
                        '<a href="' + esc(n.Enlace) + '" target="_blank" rel="noopener noreferrer" title="' + esc(_s.irNoticia) + '">' +
                        '<span class="dash-noticia-titulo">' + esc(n.Titulo) + '</span>' +
                        fec + '</a>'
                    )
                );
            });
            $grp.append($ul);
            $cont.append($grp);
        });

        $cont.show(); $hint.hide();
    }

    function cargar(refresh) {
        var $load = $('#indic-loading');
        var $content = $('#indic-content');
        var $btn  = $('#btn-indic-refresh');

        $load.show(); $content.hide();
        $btn.prop('disabled', true).find('i').addClass('fa-spin');

        var pendiente = 2;
        function fin() {
            pendiente--;
            if (pendiente === 0) {
                $load.hide(); $content.show();
                $btn.prop('disabled', false).find('i').removeClass('fa-spin');
            }
        }

        // ── TRM: sessionStorage → fetch (open.er-api.com, CORS habilitado) ──
        (function () {
            if (!refresh) {
                try {
                    var raw = sessionStorage.getItem(TRM_KEY);
                    if (raw) {
                        var obj = JSON.parse(raw);
                        if (Date.now() - obj.ts < TRM_TTL) {
                            mostrarTRM(obj.cop, obj.fecha, obj.eur);
                            fin();
                            return; // usa cache, no hace fetch
                        }
                    }
                } catch (e) {}
            }
            fetch('https://open.er-api.com/v6/latest/USD')
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    var cop = d.rates && d.rates.COP ? parseFloat(d.rates.COP) : 0;
                    var eur = (d.rates && d.rates.COP && d.rates.EUR)
                        ? (parseFloat(d.rates.COP) / parseFloat(d.rates.EUR)) : 0;
                    if (d.result === 'success' && cop > 0) {
                        var utc = d.time_last_update_utc || '';
                        var fechaFmt = '';
                        if (utc) {
                            var dt = new Date(utc);
                            if (!isNaN(dt.getTime())) {
                                fechaFmt = ('0' + dt.getUTCDate()).slice(-2) + '/' +
                                           ('0' + (dt.getUTCMonth() + 1)).slice(-2) + '/' +
                                           dt.getUTCFullYear();
                            }
                        }
                        try { sessionStorage.setItem(TRM_KEY, JSON.stringify({ cop: cop, eur: eur, fecha: fechaFmt, ts: Date.now() })); } catch (e) {}
                        mostrarTRM(cop, fechaFmt, eur);
                    } else {
                        mostrarTRMNoDisp();
                    }
                    fin();
                })
                .catch(function () { mostrarTRMNoDisp(); fin(); });
        })();

        // ── Noticias: desde el servidor (parseo RSS server-side) ──
        $.getJSON(_urlNoticias + (refresh ? '?refresh=true' : ''))
            .done(function (d) { renderNoticias(d); })
            .fail(function () {
                $('#noticias-hint').text(_s.error).show();
                $('#noticias-list').hide();
            })
            .always(function () { fin(); });
    }

    // ── Alertas (sp_ObtenerAlertasHome) ──
    function colapsarSeccion(idSeccion) {
        var $toggle = $('#' + idSeccion).find('.dash-section-toggle').first();
        $('#' + $toggle.data('target')).hide();
        $toggle.find('.dash-section-chevron').addClass('rotado');
        $toggle.attr('title', _s.expandir);
    }

    function cargarAlertas() {
        var $grid = $('#alertas-grid');
        var $badge = $('#alertas-badge');

        function tarjeta(sev, icono, empresa, titulo, mensaje) {
            return '<div class="dash-adv-card dash-adv-' + sev + '">' +
                   '<div class="dash-adv-icon"><i class="fas ' + icono + '"></i></div>' +
                   '<div class="dash-adv-body">' +
                   (empresa ? '<div class="dash-adv-empresa"><i class="fas fa-building"></i>' + esc(empresa) + '</div>' : '') +
                   (titulo ? '<div class="dash-adv-title">' + esc(titulo) + '</div>' : '') +
                   '<div class="dash-adv-msg">' + esc(mensaje) + '</div>' +
                   '</div></div>';
        }

        $.getJSON(_urlAlertas).done(function (d) {
            var alertas = (d && d.ok && d.alertas) ? d.alertas : null;
            if (!alertas) {
                $grid.html(tarjeta('warning', 'fa-exclamation-triangle', '', '', _s.alertasError));
                return;
            }
            if (!alertas.length) {
                $grid.html(tarjeta('success', 'fa-check-circle', '', '', _s.alertasOk));
                colapsarSeccion('alertas-section'); // sin alertas: arranca colapsada
                return;
            }
            var iconos = { Error: ['error', 'fa-times-circle'], Advertencia: ['warning', 'fa-exclamation-triangle'], Info: ['info', 'fa-info-circle'] };
            $grid.html(alertas.map(function (a) {
                var m = iconos[a.severidad] || iconos.Info;
                return tarjeta(m[0], m[1], a.empresa, a.titulo, a.mensaje);
            }).join(''));
            $badge.text(alertas.length).show();
        }).fail(function () {
            $grid.html(tarjeta('warning', 'fa-exclamation-triangle', '', '', _s.alertasError));
        });
    }

    // ── Accesos rápidos (más visitados del usuario) ──
    function cargarAccesos() {
        var $grid = $('#accesos-grid');
        var $hint = $('#accesos-hint');
        $.getJSON(_urlAccesos).done(function (d) {
            var items = (d && d.ok && d.items) ? d.items : [];
            if (!items.length) { $hint.text(_s.accVacio).show(); return; }
            $grid.html(items.map(function (i) {
                return '<a class="dash-acc-item" href="' + esc(i.url) + '">' +
                       '<span class="dash-acc-icon"><i class="' + esc(i.icono || 'fas fa-link') + '"></i></span>' +
                       '<span class="dash-acc-nombre">' + esc(i.nombre) + '</span></a>';
            }).join(''));
            if (d.sugeridos) $hint.text(_s.accSugeridos).show();
        }).fail(function () { $hint.text(_s.accVacio).show(); });
    }

    // ── Consumo de IA (reutiliza AnalisisIA/MiConsumo) ──
    function cargarConsumoIA() {
        var $sel = $('#ia-empresa');
        if (!$sel.length) return;

        function pintar() {
            $('#ia-texto').html('<i class="fas fa-spinner fa-spin"></i>');
            $.getJSON(_urlConsumoIA, { idEmpresa: $sel.val() }).done(function (r) {
                if (!r || !r.ok) { $('#ia-texto').text(_s.iaError); $('#ia-barra').css('width', 0); $('#ia-meta').text(''); return; }
                var consumido = Number(r.consumido).toLocaleString();
                $('#ia-texto').text(r.ilimitado
                    ? _s.iaTokensIlim.replace('{0}', consumido)
                    : _s.iaTokens.replace('{0}', consumido).replace('{1}', Number(r.presupuesto).toLocaleString()).replace('{2}', r.porcentaje));
                $('#ia-barra').css('width', (r.ilimitado ? 0 : Math.min(100, r.porcentaje)) + '%')
                              .toggleClass('agotado', !r.ilimitado && r.porcentaje >= 100)
                              .toggleClass('alto', !r.ilimitado && r.porcentaje >= 80 && r.porcentaje < 100);
                var meta = [_s.iaPeriodo.replace('{0}', r.inicio).replace('{1}', r.fin),
                            _s.iaProyeccion.replace('{0}', Number(r.proyeccion).toLocaleString())];
                if (r.enPool) meta.push(_s.iaPool.replace('{0}', r.empresasEnPool));
                if (!r.habilitada) meta.push(_s.iaApagada);
                $('#ia-meta').text(meta.join(' · '));
            }).fail(function () { $('#ia-texto').text(_s.iaError); });
        }

        pintar();
        $sel.on('change', pintar);
    }

    function initSecciones() {
        // Cada sección se expande/colapsa de forma independiente (excluye el botón de refresh).
        $(document).on('click', '.dash-section-toggle', function (e) {
            if ($(e.target).closest('#btn-indic-refresh').length) return;
            var $lbl  = $(this);
            var $body = $('#' + $lbl.data('target'));
            var $chev = $lbl.find('.dash-section-chevron');
            var abierto = $body.is(':visible');

            if (abierto) {
                $body.slideUp(180);
                $chev.addClass('rotado');
                $lbl.attr('title', _s.expandir);
            } else {
                $body.slideDown(180);
                $chev.removeClass('rotado');
                $lbl.attr('title', _s.colapsar);
            }
        });
    }

    $(document).ready(function () {
        initSecciones();
        cargarAlertas();
        cargarAccesos();
        cargarConsumoIA();
        cargar(false);
        $('#btn-indic-refresh').on('click', function () { cargar(true); });
    });
})();
</script>
}
