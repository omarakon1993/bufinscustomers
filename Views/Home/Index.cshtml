@using bufinscustomers.Helpers
@using System.Globalization
@using System.Web.Script.Serialization
@model List<bufinscustomers.Models.WidgetTarjetaViewModel>
@{
    ViewBag.Title = "Inicio";

    var usuario  = UsuarioSesionHelper.UsuarioActual;
    var empresas = ViewBag.Empresas as List<bufinscustomers.Models.Empresas>;

    var empMap = new Dictionary<int, string>();
    if (empresas != null)
    {
        foreach (var e in empresas)
        {
            empMap[e.Id] = e.Nombre;
        }
    }

    // Item1=Config  Item2=Valor  Item3=Etiqueta  Item4=EmpNombre  Item5=EsVacio
    var kpiRows      = new List<Tuple<bufinscustomers.Models.WidgetTarjeta, string, string, string, bool>>();
    var graficoCards = new List<bufinscustomers.Models.WidgetTarjetaViewModel>();

    if (Model != null)
    {
        foreach (var tv in Model)
        {
            if (tv.Config.Tipo == 1)
            {
                if (tv.KpiResultados == null || tv.KpiResultados.Count == 0)
                {
                    kpiRows.Add(Tuple.Create(tv.Config, "—", (string)null, (string)null, true));
                }
                else
                {
                    foreach (var kpi in tv.KpiResultados)
                    {
                        string empN = kpi.NombreEmpresa;
                        if (string.IsNullOrEmpty(empN) && empMap.ContainsKey(kpi.IdEmpresa))
                        {
                            empN = empMap[kpi.IdEmpresa];
                        }
                        kpiRows.Add(Tuple.Create(tv.Config, kpi.Valor, kpi.Etiqueta, empN, false));
                    }
                }
            }
            else if (tv.Config.Tipo == 2)
            {
                graficoCards.Add(tv);
            }
        }
    }

    bool hayTarjetas = kpiRows.Any() || graficoCards.Any();

    int hora = DateTime.Now.Hour;
    string saludoHtml = hora >= 5 && hora < 12 ? Resources.Strings.Home_GreetingMorning
                      : hora >= 12 && hora < 19 ? Resources.Strings.Home_GreetingAfternoon
                      : Resources.Strings.Home_GreetingEvening;
    string nombreUsuario = usuario != null ? usuario.Nombre : "usuario";

    // Serialización de datos para Chart.js
    var jss = new JavaScriptSerializer { MaxJsonLength = int.MaxValue };
    var graficosJson = jss.Serialize(graficoCards.Select(g => new {
        id          = g.Config.Id,
        nombre      = g.Config.Nombre,
        tipo        = string.IsNullOrWhiteSpace(g.Config.TipoGrafico) ? "bar" : g.Config.TipoGrafico.ToLower(),
        fondoOscuro = g.Config.FondoOscuro,
        color       = string.IsNullOrWhiteSpace(g.Config.ColorIcono) ? "#583AFF" : g.Config.ColorIcono,
        datos       = g.GraficoResultados.Select(d => new {
            idEmpresa     = d.IdEmpresa,
            nombreEmpresa = string.IsNullOrEmpty(d.NombreEmpresa) && empMap.ContainsKey(d.IdEmpresa) ? empMap[d.IdEmpresa] : d.NombreEmpresa,
            etiqueta      = d.Etiqueta,
            serie         = d.Serie,
            valor         = d.Valor
        })
    }));
}

<div class="dash-wrapper">

    @if (hayTarjetas)
    {
        <div class="dash-greeting">
            <div class="dash-greeting-text">
                <span class="dash-hello">@Html.Raw(saludoHtml), <strong>@nombreUsuario</strong></span>
                <span class="dash-date">@DateTime.Now.ToString(Resources.Strings.Home_DateFormat, System.Globalization.CultureInfo.CurrentCulture)</span>
            </div>
            <img src="~/Assets/img/Bufins_LogoLogin.png" alt="Bufins" class="dash-greeting-logo">
        </div>
    }

    @if (kpiRows.Any() || graficoCards.Any())
    {
        <div class="dash-section">
            <div class="dash-section-label dash-section-toggle" data-target="sec-widgets-body" data-key="bufins_sec_widgets" title="@Resources.Strings.Home_TooltipColapsar">
                <i class="fas fa-th-large"></i> @Resources.Strings.Home_SectionWidgets
                <i class="fas fa-chevron-down dash-section-chevron" style="margin-left:auto;font-size:.62rem;"></i>
            </div>
            <div id="sec-widgets-body">
            <div class="dash-widgets-grid">

                @foreach (var row in kpiRows)
                {
                    <div class="dash-kpi-card@(row.Item1.FondoOscuro ? " dash-kpi-dark" : "")@(row.Item5 ? " dash-kpi-empty" : "")">
                        <div class="dash-kpi-icon" style="background:linear-gradient(135deg,@row.Item1.ColorIcono,#01E1D7)">
                            <i class="@row.Item1.Icono"></i>
                        </div>
                        <div class="dash-kpi-body">
                            <div class="dash-kpi-value">
                                @row.Item2
                                @if (!string.IsNullOrEmpty(row.Item1.UnidadValor))
                                {
                                    <span class="dash-kpi-unit">@row.Item1.UnidadValor</span>
                                }
                            </div>
                            <div class="dash-kpi-label">@row.Item1.Nombre</div>
                            @if (!string.IsNullOrEmpty(row.Item3))
                            {
                                <div class="dash-kpi-etiqueta">@row.Item3</div>
                            }
                            @if (!string.IsNullOrEmpty(row.Item4))
                            {
                                <div class="dash-kpi-empresa"><i class="fas fa-building"></i> @row.Item4</div>
                            }
                        </div>
                    </div>
                }

                @foreach (var g in graficoCards)
                {
                    var cfg   = g.Config;
                    var vacio = g.GraficoResultados == null || g.GraficoResultados.Count == 0;
                    <div class="dash-graf-card@(cfg.FondoOscuro ? " dash-graf-dark" : "")@(vacio ? " dash-graf-empty" : "")">
                        <div class="dash-graf-header">
                            <div class="dash-graf-icon" style="background:linear-gradient(135deg,@cfg.ColorIcono,#01E1D7)">
                                <i class="@cfg.Icono"></i>
                            </div>
                            <div class="dash-graf-titles">
                                <div class="dash-graf-title">@cfg.Nombre</div>
                                <div class="dash-graf-sub">@TipoGraficoLabel(cfg.TipoGrafico)</div>
                            </div>
                        </div>
                        <div class="dash-graf-canvas-wrap">
                            @if (vacio)
                            {
                                <div class="dash-graf-empty-msg"><i class="fas fa-chart-line"></i> @Resources.Strings.Home_EmptyChart</div>
                            }
                            else
                            {
                                <canvas id="dashGraf_@cfg.Id"></canvas>
                            }
                        </div>
                    </div>
                }

            </div>
            </div><!-- /sec-widgets-body -->
        </div>
    }


    <div class="dash-section" id="indic-section" style="position:relative;z-index:1;margin-bottom:1.75rem;">
        <div class="dash-section-label dash-section-toggle" data-target="sec-indic-body" data-key="bufins_sec_indic" title="@Resources.Strings.Home_TooltipColapsar">
            <i class="fas fa-chart-line"></i> @Resources.Strings.Home_SectionIndicadores
            <button id="btn-indic-refresh" class="dash-indic-refreshbtn" title="@Resources.Strings.Home_IndicadoresActualizar">
                <i class="fas fa-sync-alt"></i>
            </button>
            <i class="fas fa-chevron-down dash-section-chevron" style="font-size:.62rem;margin-left:.3rem;"></i>
        </div>
        <div id="sec-indic-body">

        <div id="indic-loading" style="font-size:.78rem;color:#A0A0B8;display:flex;align-items:center;gap:.5rem;padding:.5rem 0;">
            <i class="fas fa-spinner fa-spin"></i> @Resources.Strings.Home_IndicadoresCargando
        </div>

        <div id="indic-content" style="display:none;">
            <div class="dash-indic-grid">

                <!-- Tasa de cambio USD/COP -->
                <div class="dash-kpi-card dash-indic-trm-card">
                    <div class="dash-kpi-icon" style="background:linear-gradient(135deg,#28A745,#01E1D7)">
                        <i class="fas fa-dollar-sign"></i>
                    </div>
                    <div class="dash-kpi-body">
                        <div class="dash-kpi-value" id="trm-valor" style="font-size:1.3rem;">—</div>
                        <div class="dash-kpi-label">@Resources.Strings.Home_TRM_Titulo</div>
                        <div class="dash-kpi-etiqueta" id="trm-fecha"></div>
                        <div class="dash-kpi-empresa" style="font-size:.56rem;margin-top:3px;">
                            <i class="fas fa-link"></i> @Resources.Strings.Home_TRM_Fuente
                        </div>
                    </div>
                </div>

                <!-- Noticias -->
                <div class="dash-noticias-card">
                    <div class="dash-noticias-hdr">
                        <i class="fas fa-newspaper"></i>
                        <span>@Resources.Strings.Home_Noticias_Titulo</span>
                    </div>
                    <div id="noticias-leyenda" class="dash-noticias-leyenda" style="display:none;"></div>
                    <div id="noticias-container" style="display:none;"></div>
                    <div class="dash-noticias-hint" id="noticias-hint" style="display:none;"></div>
                </div>

            </div>
        </div>
        </div><!-- /sec-indic-body -->
    </div>

</div>

@functions {
    string TipoGraficoLabel(string t) {
        if (string.IsNullOrEmpty(t)) return Resources.Strings.Home_ChartBar;
        switch (t.ToLower()) {
            case "bar":      return Resources.Strings.Home_ChartBar;
            case "line":     return Resources.Strings.Home_ChartLine;
            case "area":     return Resources.Strings.Home_ChartArea;
            case "doughnut": return Resources.Strings.Home_ChartDoughnut;
            case "pie":      return Resources.Strings.Home_ChartPie;
            default:         return t;
        }
    }
}

<style>
    .dash-wrapper { position:relative; min-height:70vh; padding:0 0 2rem; }

    .dash-greeting {
        position:relative; z-index:1;
        display:flex; align-items:center;
        margin-bottom:1.5rem; padding-bottom:.75rem;
        border-bottom:1px solid rgba(88,58,255,.1);
    }
    .dash-greeting-text { display:flex; flex-direction:column; gap:.15rem; }
    .dash-hello { font-size:1.05rem; color:#160933; font-weight:500; }
    .dash-hello strong { color:#583AFF; }
    .dash-date { font-size:.75rem; color:#A0A0B8; text-transform:capitalize; }
    .dash-greeting-logo { height:30px; width:auto; margin-left:auto; opacity:.55; flex-shrink:0; }

    .dash-section { position:relative; z-index:1; margin-bottom:1.75rem; }
    .dash-section-label {
        font-size:.68rem; font-weight:700; color:#583AFF;
        text-transform:uppercase; letter-spacing:1px;
        margin-bottom:.65rem;
        display:flex; align-items:center; gap:.4rem;
    }
    .dash-section-toggle { cursor:pointer; user-select:none; }
    .dash-section-toggle:hover { opacity:.8; }
    .dash-section-chevron { transition:transform .2s ease; opacity:.6; flex-shrink:0; }
    .dash-section-chevron.rotado { transform:rotate(-90deg); }

    /* ---------- Widgets unificados (KPI + Gráficos en la misma fila) ---------- */
    .dash-widgets-grid {
        display:flex; flex-wrap:wrap; gap:9px; align-items:flex-start;
    }
    /* KPI cards: ancho fijo compacto */
    .dash-widgets-grid .dash-kpi-card {
        flex:0 0 auto; width:182px;
    }
    /* Gráficos: crecen para llenar el espacio */
    .dash-widgets-grid .dash-graf-card {
        flex:1 1 260px; min-width:260px;
    }

    /* ---------- KPI ---------- */
    .dash-kpi-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:9px; }
    .dash-kpi-card {
        position:relative; overflow:hidden;
        background:#fff;
        border:1px solid rgba(88,58,255,.12);
        border-radius:9px; padding:11px 11px;
        display:flex; align-items:center; gap:9px;
        box-shadow:0 2px 8px rgba(22,9,51,.05);
        transition:transform .15s ease,box-shadow .15s ease;
    }
    .dash-kpi-card:hover { transform:translateY(-2px); box-shadow:0 6px 18px rgba(22,9,51,.1); }
    .dash-kpi-empty { opacity:.55; }
    .dash-kpi-icon { width:35px; height:35px; border-radius:8px; display:flex; align-items:center; justify-content:center; color:#fff; font-size:.85rem; flex-shrink:0; }
    .dash-kpi-body { min-width:0; flex:1; }
    .dash-kpi-value { font-size:1.1rem; font-weight:700; color:#160933; line-height:1.1; display:flex; align-items:baseline; gap:.3rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .dash-kpi-unit  { font-size:.58rem; font-weight:600; color:#583AFF; }
    .dash-kpi-label { font-size:.60rem; font-weight:600; color:#393F45; text-transform:uppercase; letter-spacing:.5px; margin-top:3px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .dash-kpi-etiqueta { font-size:.60rem; color:#A0A0B8; margin-top:2px; }
    .dash-kpi-empresa  { font-size:.58rem; color:#A0A0B8; margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .dash-kpi-empresa i { font-size:.50rem; }

    /* KPI - tema oscuro corporativo */
    .dash-kpi-card.dash-kpi-dark {
        background:#160933;
        border-color:rgba(88,58,255,.45);
        box-shadow:0 4px 14px rgba(22,9,51,.4);
    }
    .dash-kpi-card.dash-kpi-dark::before {
        content:""; position:absolute; top:0; left:0; right:0; height:3px;
        background:linear-gradient(90deg,#01E1D7,#9B5DE5);
    }
    .dash-kpi-card.dash-kpi-dark:hover { box-shadow:0 8px 22px rgba(22,9,51,.55); }
    .dash-kpi-card.dash-kpi-dark .dash-kpi-icon    { box-shadow:0 4px 10px rgba(88,58,255,.35); }
    .dash-kpi-card.dash-kpi-dark .dash-kpi-value   { color:#FFFFFF; }
    .dash-kpi-card.dash-kpi-dark .dash-kpi-unit    { color:#01E1D7; }
    .dash-kpi-card.dash-kpi-dark .dash-kpi-label   { color:#A8A4C7; }
    .dash-kpi-card.dash-kpi-dark .dash-kpi-etiqueta{ color:rgba(255,255,255,.6); }
    .dash-kpi-card.dash-kpi-dark .dash-kpi-empresa { color:rgba(255,255,255,.55); }

    /* ---------- Gráficos ---------- */
    .dash-graf-grid {
        display:grid;
        grid-template-columns:repeat(auto-fill, minmax(260px, 1fr));
        gap:8px;
    }
    .dash-graf-card {
        position:relative;
        background:#fff;
        border:1px solid rgba(88,58,255,.14);
        border-radius:10px;
        padding:9px 10px 7px;
        box-shadow:0 2px 10px rgba(22,9,51,.06);
        display:flex; flex-direction:column;
        min-height:180px;
        transition:transform .15s ease, box-shadow .15s ease;
        overflow:hidden;
    }
    .dash-graf-card::before {
        content:""; position:absolute; top:0; left:0; right:0; height:3px;
        background:linear-gradient(90deg,#583AFF,#01E1D7);
        opacity:.85;
    }
    .dash-graf-card:hover { transform:translateY(-2px); box-shadow:0 8px 22px rgba(22,9,51,.12); }

    .dash-graf-card.dash-graf-dark {
        background:#160933;
        border-color:rgba(88,58,255,.45);
        color:#E8E6F4;
        box-shadow:0 4px 16px rgba(22,9,51,.45);
    }
    .dash-graf-card.dash-graf-dark::before {
        background:linear-gradient(90deg,#01E1D7,#9B5DE5);
        opacity:1;
    }

    .dash-graf-header { display:flex; align-items:center; gap:8px; margin-bottom:6px; }
    .dash-graf-icon {
        width:32px; height:32px; border-radius:7px;
        display:flex; align-items:center; justify-content:center;
        color:#fff; font-size:.78rem; flex-shrink:0;
        box-shadow:0 4px 10px rgba(88,58,255,.25);
    }
    .dash-graf-titles { min-width:0; }
    .dash-graf-title  {
        font-size:.78rem; font-weight:700; color:#160933;
        line-height:1.2;
        white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
    }
    .dash-graf-sub {
        font-size:.56rem; color:#A0A0B8;
        text-transform:uppercase; letter-spacing:.6px;
        margin-top:2px; font-weight:600;
    }
    .dash-graf-card.dash-graf-dark .dash-graf-title { color:#FFFFFF; }
    .dash-graf-card.dash-graf-dark .dash-graf-sub   { color:#01E1D7; }

    .dash-graf-canvas-wrap {
        position:relative; flex:1;
        min-height:120px;
        display:flex; align-items:center; justify-content:center;
    }
    .dash-graf-canvas-wrap canvas { width:100% !important; height:100% !important; max-height:145px; }

    .dash-graf-empty .dash-graf-canvas-wrap { opacity:.6; }
    .dash-graf-empty-msg {
        font-size:.78rem; color:#A0A0B8; font-weight:600;
        display:flex; align-items:center; gap:.4rem;
    }
    .dash-graf-card.dash-graf-dark .dash-graf-empty-msg { color:rgba(255,255,255,.55); }

    /* ---------- Responsive ---------- */
    @@media (max-width:768px) {
        .dash-graf-grid { grid-template-columns:1fr; }
        .dash-graf-card { min-height:200px; }
    }
    @@media (max-width:576px) {
        .dash-kpi-grid { grid-template-columns:1fr; }
        .dash-graf-card { padding:10px; min-height:180px; }
        .dash-graf-title { font-size:.82rem; }
        .dash-greeting-logo { height:22px; }
    }

    /* ---------- Indicadores de Mercado ---------- */
    .dash-indic-refreshbtn {
        margin-left:auto; background:none; border:none; cursor:pointer;
        color:#A0A0B8; font-size:.75rem; padding:2px 4px;
        transition:color .15s;
    }
    .dash-indic-refreshbtn:hover { color:#583AFF; }

    .dash-indic-grid {
        display:grid;
        grid-template-columns:180px 1fr;
        gap:9px;
        align-items:start;
    }
    .dash-indic-trm-card { min-width:0; }
    .dash-indic-trm-card .dash-kpi-label    { font-size:.68rem; color:#393F45; }
    .dash-indic-trm-card .dash-kpi-etiqueta { font-size:.68rem; color:#6B6787; }
    .dash-indic-trm-card .dash-kpi-empresa  { font-size:.63rem; color:#6B6787; }

    /* Noticias */
    .dash-noticias-card {
        background:#fff;
        border:1px solid rgba(88,58,255,.12);
        border-radius:9px;
        box-shadow:0 2px 8px rgba(22,9,51,.05);
        overflow:hidden;
    }
    .dash-noticias-hdr {
        display:flex; align-items:center; gap:.5rem;
        padding:9px 13px;
        font-size:.76rem; font-weight:700; color:#6B6787;
        text-transform:uppercase; letter-spacing:.6px;
        border-bottom:1px solid rgba(88,58,255,.08);
    }
    .dash-noticias-hdr i { color:#583AFF; }

    /* Leyenda de fuentes */
    .dash-noticias-leyenda {
        display:flex; flex-wrap:wrap; gap:.5rem;
        padding:7px 13px;
        background:#FAFAFA;
        border-bottom:1px solid rgba(88,58,255,.07);
    }
    .feed-leyenda-item {
        display:flex; align-items:center; gap:.35rem;
        font-size:.68rem; font-weight:700;
        color:#6B6787; text-transform:uppercase; letter-spacing:.5px;
    }
    .feed-leyenda-dot {
        width:9px; height:9px; border-radius:50%; flex-shrink:0;
    }

    /* Grupos por feed */
    .dash-feed-grupo {
        margin:5px 8px 4px;
        border-left:3px solid #583AFF;
        border-radius:0 7px 7px 0;
        overflow:hidden;
    }
    .dash-feed-grupo:last-child { margin-bottom:7px; }

    /* Cabecera del grupo */
    .dash-feed-grupo-hdr {
        display:flex; align-items:center; gap:.4rem;
        padding:4px 9px;
        font-size:.66rem; font-weight:800;
        text-transform:uppercase; letter-spacing:.5px;
    }
    .dash-feed-grupo-hdr i { font-size:.58rem; }

    .dash-noticias-list { list-style:none; margin:0; padding:0; }
    .dash-noticia-item { border-bottom:1px solid rgba(88,58,255,.06); }
    .dash-noticia-item:last-child { border-bottom:none; }
    .dash-noticia-item a {
        display:flex; align-items:flex-start; gap:8px;
        padding:7px 11px 7px 9px;
        text-decoration:none;
        transition:background .12s;
    }
    .dash-noticia-item a:hover { background:rgba(88,58,255,.04); }
    .dash-noticia-titulo {
        font-size:.82rem; color:#160933; font-weight:500;
        line-height:1.35; flex:1; min-width:0;
        overflow:hidden; display:-webkit-box;
        -webkit-line-clamp:2; -webkit-box-orient:vertical;
    }
    .dash-noticia-fecha {
        font-size:.66rem; color:#6B6787;
        white-space:nowrap; flex-shrink:0; padding-top:2px;
    }
    .dash-noticias-hint {
        padding:12px 13px;
        font-size:.80rem; color:#A0A0B8; line-height:1.4;
    }
    .dash-trm-nodisp {
        font-size:.80rem; color:#FCA311; font-weight:600;
    }

    @@media (max-width:768px) {
        .dash-indic-grid { grid-template-columns:1fr; }
    }
</style>

@if (graficoCards.Any())
{
    <script src="~/Assets/js/chart.umd.min.js"></script>
    <script>
    (function () {
        var GRAFICOS = @Html.Raw(graficosJson);
        if (!GRAFICOS || !GRAFICOS.length || typeof Chart === 'undefined') return;

        var PALETA = ['#583AFF', '#01E1D7', '#FF6B9D', '#FFD166', '#06D6A0', '#118AB2', '#9B5DE5', '#F15BB5'];

        function hexToRgba(hex, alpha) {
            var h = (hex || '#583AFF').replace('#', '');
            if (h.length === 3) h = h.split('').map(function (c) { return c + c; }).join('');
            var r = parseInt(h.substring(0, 2), 16);
            var g = parseInt(h.substring(2, 4), 16);
            var b = parseInt(h.substring(4, 6), 16);
            return 'rgba(' + r + ',' + g + ',' + b + ',' + alpha + ')';
        }

        function fmtMoneda(v) {
            if (v === null || v === undefined || isNaN(v)) return v;
            try { return new Intl.NumberFormat('es-CO', { maximumFractionDigits: 2 }).format(v); }
            catch (e) { return v; }
        }

        // Agrupa filas por (Serie || NombreEmpresa || 'Total') y devuelve labels + datasets
        function armarSeries(datos, colorBase, esCircular) {
            var labelsSet = [];
            var seriesMap = {};

            datos.forEach(function (d) {
                var et = (d.etiqueta == null ? '' : String(d.etiqueta));
                if (labelsSet.indexOf(et) === -1) labelsSet.push(et);

                var sk = d.serie && d.serie.length ? d.serie
                       : (d.nombreEmpresa && d.nombreEmpresa.length ? d.nombreEmpresa : 'Total');
                if (!seriesMap[sk]) seriesMap[sk] = {};
                seriesMap[sk][et] = Number(d.valor) || 0;
            });

            var seriesKeys = Object.keys(seriesMap);

            // Para gráficos circulares: una sola serie con todas las etiquetas
            if (esCircular) {
                var valores = labelsSet.map(function (et) {
                    var total = 0;
                    seriesKeys.forEach(function (sk) { total += (seriesMap[sk][et] || 0); });
                    return total;
                });
                var colors = labelsSet.map(function (_, i) { return PALETA[i % PALETA.length]; });
                return {
                    labels: labelsSet,
                    datasets: [{
                        data: valores,
                        backgroundColor: colors,
                        borderColor: '#fff',
                        borderWidth: 2
                    }]
                };
            }

            var datasets = seriesKeys.map(function (sk, idx) {
                var color = idx === 0 ? colorBase : PALETA[idx % PALETA.length];
                return {
                    label: sk,
                    data: labelsSet.map(function (et) { return seriesMap[sk][et] || 0; }),
                    borderColor: color,
                    backgroundColor: color,
                    _color: color
                };
            });

            return { labels: labelsSet, datasets: datasets };
        }

        GRAFICOS.forEach(function (g) {
            var canvas = document.getElementById('dashGraf_' + g.id);
            if (!canvas || !g.datos || !g.datos.length) return;

            var dark = !!g.fondoOscuro;
            var textColor   = dark ? '#E8E6F4'   : '#160933';
            var subColor    = dark ? '#A8A4C7'   : '#6B6787';
            var gridColor   = dark ? 'rgba(255,255,255,.08)' : 'rgba(22,9,51,.07)';
            var tooltipBg   = dark ? '#0E061F'   : '#FFFFFF';
            var tooltipFg   = dark ? '#FFFFFF'   : '#160933';
            var tooltipBd   = dark ? 'rgba(1,225,215,.4)' : 'rgba(88,58,255,.2)';

            var tipo = (g.tipo || 'bar').toLowerCase();
            var esArea = tipo === 'area';
            var esCircular = tipo === 'doughnut' || tipo === 'pie';
            var chartType = esArea ? 'line' : tipo;

            var pack = armarSeries(g.datos, g.color || '#583AFF', esCircular);

            // Estilizado por tipo
            if (!esCircular) {
                pack.datasets.forEach(function (ds) {
                    if (chartType === 'bar') {
                        ds.backgroundColor = hexToRgba(ds._color, .85);
                        ds.borderColor     = ds._color;
                        ds.borderWidth     = 0;
                        ds.borderRadius    = 6;
                        ds.maxBarThickness = 38;
                    } else { // line / area
                        ds.borderColor = ds._color;
                        ds.backgroundColor = esArea ? hexToRgba(ds._color, dark ? .35 : .18) : hexToRgba(ds._color, .15);
                        ds.borderWidth = 2.5;
                        ds.tension     = 0.35;
                        ds.fill        = esArea;
                        ds.pointRadius = 3;
                        ds.pointHoverRadius = 6;
                        ds.pointBackgroundColor = ds._color;
                        ds.pointBorderColor = dark ? '#160933' : '#fff';
                        ds.pointBorderWidth = 2;
                    }
                });
            }

            var opciones = {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: {
                        display: pack.datasets.length > 1 || esCircular,
                        position: esCircular ? 'right' : 'top',
                        labels: {
                            color: textColor,
                            font: { size: 11, weight: '600', family: 'Nunito, sans-serif' },
                            boxWidth: 12, boxHeight: 12, padding: 10, usePointStyle: true
                        }
                    },
                    tooltip: {
                        backgroundColor: tooltipBg,
                        titleColor: tooltipFg,
                        bodyColor: tooltipFg,
                        borderColor: tooltipBd,
                        borderWidth: 1,
                        padding: 10,
                        cornerRadius: 8,
                        titleFont: { weight: '700', family: 'Nunito, sans-serif' },
                        bodyFont:  { family: 'Nunito, sans-serif' },
                        callbacks: {
                            label: function (ctx) {
                                var label = ctx.dataset.label ? (ctx.dataset.label + ': ') : '';
                                return label + fmtMoneda(ctx.parsed.y !== undefined ? ctx.parsed.y : ctx.parsed);
                            }
                        }
                    }
                }
            };

            if (!esCircular) {
                opciones.scales = {
                    x: {
                        ticks:  { color: subColor, font: { size: 10.5, family: 'Nunito, sans-serif' } },
                        grid:   { display: false },
                        border: { color: gridColor }
                    },
                    y: {
                        ticks:  {
                            color: subColor, font: { size: 10.5, family: 'Nunito, sans-serif' },
                            callback: function (v) { return fmtMoneda(v); }
                        },
                        grid:   { color: gridColor, drawBorder: false },
                        border: { display: false },
                        beginAtZero: true
                    }
                };
            }

            try {
                new Chart(canvas.getContext('2d'), {
                    type: chartType,
                    data: pack,
                    options: opciones
                });
            } catch (err) {
                console.error('Widget gráfico ' + g.id + ': ' + err.message);
            }
        });
    })();
    </script>
}

@section scripts {
<script>
(function () {
    var _s = {
        vigente:   '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_TRM_Vigente)',
        noDisp:    '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_TRM_Vigente)',
        vacias:    '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_TRM_Vigente)',
        noConfig:  '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_TRM_Vigente)',
        error:     '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_TRM_Vigente)',
        colapsar:  '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_TRM_Vigente)',
        expandir:  '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_TRM_Vigente)',
        irNoticia: '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_TRM_Vigente)'
    };

    var _urlNoticias = '@Url.Action("ObtenerNoticias", "Home")';

    function fmtCOP(v) {
        try { return new Intl.NumberFormat('es-CO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(v); }
        catch (e) { return v; }
    }

    function esc(s) {
        if (!s) return '';
        var d = document.createElement('div');
        d.appendChild(document.createTextNode(s));
        return d.innerHTML;
    }

    // Paleta corporativa: púrpura, teal, violeta, azul
    var FEED_COLORS = ['#583AFF', '#00A89E', '#9B5DE5', '#118AB2'];
    var FEED_BGS    = ['rgba(88,58,255,.04)', 'rgba(0,168,158,.05)', 'rgba(155,93,229,.04)', 'rgba(17,138,178,.04)'];

    // Cache TRM en sessionStorage — válido 2 horas, evita fetch extra al volver al dashboard
    var TRM_KEY = 'bufins_trm';
    var TRM_TTL = 7200000;

    function mostrarTRM(cop, fecha) {
        $('#trm-valor').html('$' + fmtCOP(cop));
        $('#trm-fecha').text(_s.vigente + ' ' + fecha);
    }

    function mostrarTRMNoDisp() {
        $('#trm-valor').html('<span class="dash-trm-nodisp">' + esc(_s.noDisp) + '</span>');
        $('#trm-fecha').text('');
    }

    function renderNoticias(d) {
        var $ley  = $('#noticias-leyenda');
        var $cont = $('#noticias-container');
        var $hint = $('#noticias-hint');
        $ley.empty(); $cont.empty();

        if (!d.rssConfigurado) {
            $ley.hide(); $cont.hide(); $hint.text(_s.noConfig).show();
            return;
        }
        var feeds = d.feeds || [];
        if (!feeds.length) {
            $ley.hide(); $cont.hide(); $hint.text(_s.vacias).show();
            return;
        }

        // — Leyenda —
        feeds.forEach(function (f, i) {
            var color = FEED_COLORS[i % FEED_COLORS.length];
            $ley.append(
                '<span class="feed-leyenda-item">' +
                '<span class="feed-leyenda-dot" style="background:' + color + '"></span>' +
                esc(f.Fuente) +
                '</span>'
            );
        });
        $ley.show();

        // — Grupos por feed —
        feeds.forEach(function (f, i) {
            if (!f.Noticias || !f.Noticias.length) return;
            var color = FEED_COLORS[i % FEED_COLORS.length];
            var bg    = FEED_BGS[i % FEED_BGS.length];

            var $grp = $('<div class="dash-feed-grupo"></div>').css({
                'border-left-color': color,
                'background': bg
            });

            // cabecera del grupo
            $grp.append(
                '<div class="dash-feed-grupo-hdr" style="color:' + color + '">' +
                '<i class="fas fa-circle" style="font-size:.4rem;opacity:.7"></i>' +
                esc(f.Fuente) + '</div>'
            );

            // ítems
            var $ul = $('<ul class="dash-noticias-list"></ul>');
            f.Noticias.forEach(function (n) {
                var fec = n.FechaTexto
                    ? '<span class="dash-noticia-fecha">' + esc(n.FechaTexto) + '</span>'
                    : '';
                $ul.append(
                    $('<li class="dash-noticia-item"></li>').html(
                        '<a href="' + esc(n.Enlace) + '" target="_blank" rel="noopener noreferrer" title="' + esc(_s.irNoticia) + '">' +
                        '<span class="dash-noticia-titulo">' + esc(n.Titulo) + '</span>' +
                        fec + '</a>'
                    )
                );
            });
            $grp.append($ul);
            $cont.append($grp);
        });

        $cont.show(); $hint.hide();
    }

    function cargar(refresh) {
        var $load = $('#indic-loading');
        var $content = $('#indic-content');
        var $btn  = $('#btn-indic-refresh');

        $load.show(); $content.hide();
        $btn.prop('disabled', true).find('i').addClass('fa-spin');

        var pendiente = 2;
        function fin() {
            pendiente--;
            if (pendiente === 0) {
                $load.hide(); $content.show();
                $btn.prop('disabled', false).find('i').removeClass('fa-spin');
            }
        }

        // ── TRM: sessionStorage → fetch (open.er-api.com, CORS habilitado) ──
        (function () {
            if (!refresh) {
                try {
                    var raw = sessionStorage.getItem(TRM_KEY);
                    if (raw) {
                        var obj = JSON.parse(raw);
                        if (Date.now() - obj.ts < TRM_TTL) {
                            mostrarTRM(obj.cop, obj.fecha);
                            fin();
                            return; // usa cache, no hace fetch
                        }
                    }
                } catch (e) {}
            }
            fetch('https://open.er-api.com/v6/latest/USD')
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    var cop = d.rates && d.rates.COP ? parseFloat(d.rates.COP) : 0;
                    if (d.result === 'success' && cop > 0) {
                        var utc = d.time_last_update_utc || '';
                        var fechaFmt = '';
                        if (utc) {
                            var dt = new Date(utc);
                            if (!isNaN(dt.getTime())) {
                                fechaFmt = ('0' + dt.getUTCDate()).slice(-2) + '/' +
                                           ('0' + (dt.getUTCMonth() + 1)).slice(-2) + '/' +
                                           dt.getUTCFullYear();
                            }
                        }
                        try { sessionStorage.setItem(TRM_KEY, JSON.stringify({ cop: cop, fecha: fechaFmt, ts: Date.now() })); } catch (e) {}
                        mostrarTRM(cop, fechaFmt);
                    } else {
                        mostrarTRMNoDisp();
                    }
                    fin();
                })
                .catch(function () { mostrarTRMNoDisp(); fin(); });
        })();

        // ── Noticias: desde el servidor (parseo RSS server-side) ──
        $.getJSON(_urlNoticias + (refresh ? '?refresh=true' : ''))
            .done(function (d) { renderNoticias(d); })
            .fail(function () {
                $('#noticias-hint').text(_s.error).show();
                $('#noticias-list').hide();
            })
            .always(function () { fin(); });
    }

    function initSecciones() {
        // Restaurar estado guardado en localStorage
        $('.dash-section-toggle').each(function () {
            if (localStorage.getItem($(this).data('key')) === '0') {
                $('#' + $(this).data('target')).hide();
                $(this).find('.dash-section-chevron').addClass('rotado');
                $(this).attr('title', _s.expandir);
            }
        });

        // Toggle al hacer clic en el label (excluye el botón de refresh)
        $(document).on('click', '.dash-section-toggle', function (e) {
            if ($(e.target).closest('#btn-indic-refresh').length) return;
            var $lbl  = $(this);
            var $body = $('#' + $lbl.data('target'));
            var $chev = $lbl.find('.dash-section-chevron');
            var abierto = $body.is(':visible');
            $body[abierto ? 'slideUp' : 'slideDown'](180);
            $chev.toggleClass('rotado', abierto);
            $lbl.attr('title', abierto ? _s.expandir : _s.colapsar);
            localStorage.setItem($lbl.data('key'), abierto ? '0' : '1');
        });
    }

    $(document).ready(function () {
        initSecciones();
        cargar(false);
        $('#btn-indic-refresh').on('click', function () { cargar(true); });
    });
})();
</script>
}
