@using bufinscustomers.Helpers
@{
    ViewBag.Title = "Inicio";

    var usuario  = UsuarioSesionHelper.UsuarioActual;
    var empresas = ViewBag.Empresas as List<bufinscustomers.Models.Empresas>;

    var empMap = new Dictionary<int, string>();
    var empAbrevMap = new Dictionary<int, string>();
    if (empresas != null)
    {
        foreach (var e in empresas)
        {
            empMap[e.Id] = e.Nombre;
            empAbrevMap[e.Id] = !string.IsNullOrWhiteSpace(e.Abreviatura)
                ? e.Abreviatura.ToUpper()
                : (e.Nombre.Length >= 3 ? e.Nombre.Substring(0, 3).ToUpper() : e.Nombre.ToUpper());
        }
    }

    // "Mi consumo de IA": solo Super Admin y Admin de Empresa (igual que Análisis IA) y solo si la IA está visible.
    bool verConsumoIA = (UsuarioSesionHelper.EsSuperAdmin() || UsuarioSesionHelper.EsAdminEmpresa()) && IAModuloHelper.Visible();
    var empresasConsumo = (empresas ?? new List<bufinscustomers.Models.Empresas>()).OrderBy(e => e.Nombre).ToList();
    int empresaConsumoSel = usuario != null && usuario.IdEmpresa.HasValue && empMap.ContainsKey(usuario.IdEmpresa.Value)
        ? usuario.IdEmpresa.Value
        : (empresasConsumo.Any() ? empresasConsumo.First().Id : 0);

    int hora = DateTime.Now.Hour;
    string saludoHtml = hora >= 5 && hora < 12 ? Resources.Strings.Home_GreetingMorning
                      : hora >= 12 && hora < 19 ? Resources.Strings.Home_GreetingAfternoon
                      : Resources.Strings.Home_GreetingEvening;
    string nombreUsuario = usuario != null ? usuario.Nombre : "usuario";
    string nombreEmpresaActual = usuario != null && usuario.IdEmpresa.HasValue && empMap.ContainsKey(usuario.IdEmpresa.Value) ? empMap[usuario.IdEmpresa.Value] : null;
    string abrevEmpresaActual = usuario != null && usuario.IdEmpresa.HasValue && empAbrevMap.ContainsKey(usuario.IdEmpresa.Value) ? empAbrevMap[usuario.IdEmpresa.Value] : null;

    // Si la empresa principal del usuario pertenece a un grupo empresarial, mostramos las
    // empresas hermanas del grupo para que sepa que también puede consultarlas.
    // (ViewBag.Empresas ya viene filtrado por EmpresaAccesoHelper: para un usuario no Super
    // Admin contiene exactamente su empresa + las del mismo grupo.)
    var empresaPropia = usuario != null && usuario.IdEmpresa.HasValue && empresas != null
        ? empresas.FirstOrDefault(e => e.Id == usuario.IdEmpresa.Value)
        : null;
    string nombreGrupoEmpresarial = empresaPropia != null ? empresaPropia.NombreGrupoEmpresarial : null;
    var empresasGrupo = empresaPropia != null && empresaPropia.IdGrupoEmpresarial.HasValue && empresas != null
        ? empresas.Where(e => e.IdGrupoEmpresarial == empresaPropia.IdGrupoEmpresarial && e.Id != empresaPropia.Id)
                  .OrderBy(e => e.Nombre).ToList()
        : new List<bufinscustomers.Models.Empresas>();
}

<div class="dash-wrapper">

    <!-- 1. Header compacto -->
    <div class="dash-header-card">
        <div class="dash-header-main">
            <span class="dash-hello">@Html.Raw(saludoHtml), <strong>@nombreUsuario</strong></span>
            <span class="dash-date"><i class="fas fa-calendar-alt"></i>@DateTime.Now.ToString(Resources.Strings.Home_DateFormat, System.Globalization.CultureInfo.CurrentCulture)</span>
        </div>

        <div class="dash-header-empresas">
            @if (UsuarioSesionHelper.EsSuperAdmin())
            {
                if (empresas != null && empresas.Any())
                {
                    foreach (var e in empresas.OrderBy(e => e.Nombre))
                    {
                        <span class="dash-empresa-chip-light" title="@e.Nombre">@(empAbrevMap.ContainsKey(e.Id) ? empAbrevMap[e.Id] : e.Nombre)</span>
                    }
                }
            }
            else if (!string.IsNullOrEmpty(nombreEmpresaActual))
            {
                if (!string.IsNullOrEmpty(abrevEmpresaActual))
                {
                    <span class="dash-empresa-chip">@abrevEmpresaActual</span>
                }
                <span class="dash-empresa-nombre"><i class="fas fa-building"></i>@nombreEmpresaActual</span>

                if (empresasGrupo.Any())
                {
                    <span class="dash-grupo-label" title="@nombreGrupoEmpresarial">
                        <i class="fas fa-sitemap"></i>
                        @(!string.IsNullOrEmpty(nombreGrupoEmpresarial) ? nombreGrupoEmpresarial : Resources.Strings.Home_GrupoLabel)
                    </span>
                    foreach (var eg in empresasGrupo)
                    {
                        <span class="dash-empresa-chip-light" title="@eg.Nombre">@(empAbrevMap.ContainsKey(eg.Id) ? empAbrevMap[eg.Id] : eg.Nombre)</span>
                    }
                }
            }
        </div>

        <div class="dash-header-divider"></div>
        <img src="~/Assets/img/Bufins_LogoLogin.png" alt="Bufins" class="dash-greeting-logo">
    </div>

    <div class="dash-main">

        <!-- 2. Indicadores y noticias (columna izquierda) -->
        <div class="dash-card dash-card-indic" id="indic-section">
            <div class="dash-card-hdr dash-section-toggle" data-target="sec-indic-body" title="@Resources.Strings.Home_TooltipColapsar">
                <i class="fas fa-chart-line"></i>
                <span class="dash-section-label">@Resources.Strings.Home_SectionIndicadores</span>
                <button id="btn-indic-refresh" class="dash-indic-refreshbtn" title="@Resources.Strings.Home_IndicadoresActualizar">
                    <i class="fas fa-sync-alt"></i>
                </button>
                <i class="fas fa-chevron-down dash-section-chevron"></i>
            </div>

            <div id="sec-indic-body" class="dash-indic-body">

                <div id="indic-loading" class="dash-indic-loading">
                    <i class="fas fa-spinner fa-spin"></i> @Resources.Strings.Home_IndicadoresCargando
                </div>

                <div id="indic-content" class="dash-indic-content" style="display:none;">

                    <!-- Tasas de cambio (franja) -->
                    <div class="dash-trm-strip">
                        <div class="dash-trm-icon"><i class="fas fa-dollar-sign"></i></div>
                        <div class="dash-trm-bloque">
                            <div class="dash-trm-valor" id="trm-valor">—</div>
                            <div class="dash-trm-label">@Resources.Strings.Home_TRM_Titulo</div>
                        </div>
                        <span class="dash-trm-sep" id="trm-sep-eur"></span>
                        <div class="dash-trm-bloque" id="trm-eur-bloque">
                            <div class="dash-trm-valor dash-trm-valor-sm" id="trm-eur">—</div>
                            <div class="dash-trm-label">@Resources.Strings.Home_TRM_EUR</div>
                        </div>
                        <span class="dash-trm-sep"></span>
                        <div class="dash-trm-fecha" id="trm-fecha"></div>
                        <div class="dash-trm-fuente"><i class="fas fa-link"></i> @Resources.Strings.Home_TRM_Fuente</div>
                    </div>

                    <!-- Noticias + filtro por portal -->
                    <div class="dash-news-hdr">
                        <i class="fas fa-newspaper"></i>
                        <span class="dash-news-titulo">@Resources.Strings.Home_Noticias_Titulo</span>
                        <div id="noticias-leyenda" class="dash-news-filtros" style="display:none;"></div>
                    </div>
                    <div id="noticias-container" style="display:none;"></div>
                    <div class="dash-noticias-hint" id="noticias-hint" style="display:none;"></div>
                </div>
            </div>
        </div>

        <!-- Columna derecha -->
        <div class="dash-side">

            <!-- 3. Alertas Bufins (las genera sp_ObtenerAlertasHome por AJAX) -->
            <div class="dash-card" id="alertas-section">
                <div class="dash-card-hdr dash-section-toggle" data-target="sec-alertas-body" title="@Resources.Strings.Home_TooltipColapsar">
                    <i class="fas fa-shield-alt"></i>
                    <span class="dash-section-label">@Resources.Strings.Home_SectionAlertas</span>
                    <span class="dash-adv-count-badge" id="alertas-badge" style="display:none;"></span>
                    <i class="fas fa-chevron-down dash-section-chevron"></i>
                </div>
                <div id="sec-alertas-body">
                    <div class="dash-alert-list" id="alertas-grid"></div>
                </div>
            </div>

            <!-- 4. Accesos rápidos -->
            <div class="dash-card" id="accesos-section">
                <div class="dash-card-hdr dash-card-hdr-sm dash-section-toggle" data-target="sec-accesos-body" title="@Resources.Strings.Home_TooltipColapsar">
                    <i class="fas fa-bolt"></i>
                    <span class="dash-section-label">@Resources.Strings.Home_SectionAccesos</span>
                    <i class="fas fa-chevron-down dash-section-chevron"></i>
                </div>
                <div id="sec-accesos-body">
                    <div class="dash-acc-grid" id="accesos-grid"></div>
                    <div class="dash-acc-hint" id="accesos-hint" style="display:none;"></div>
                </div>
            </div>

            @if (verConsumoIA)
            {
                <!-- 5. Mi consumo de IA -->
                <div class="dash-card dash-ia-card" id="ia-section">
                    <div class="dash-ia-row">
                        <i class="fas fa-chart-pie"></i>
                        <span class="dash-section-label">@Resources.Strings.IAConsumo_Titulo</span>
                        @if (empresasConsumo.Count > 1)
                        {
                            <select id="ia-empresa" class="dash-ia-select" aria-label="@Resources.Strings.Home_ConsumoIA_Empresa">
                                @foreach (var e in empresasConsumo)
                                {
                                    <option value="@e.Id" @(e.Id == empresaConsumoSel ? "selected" : "")>@e.Nombre</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input type="hidden" id="ia-empresa" value="@empresaConsumoSel" />
                        }
                    </div>
                    <div class="dash-ia-texto" id="ia-texto"><i class="fas fa-spinner fa-spin"></i></div>
                    <div class="dash-ia-track"><div class="dash-ia-fill" id="ia-barra"></div></div>
                    <div class="dash-ia-row dash-ia-row-meta">
                        <span class="dash-ia-meta" id="ia-meta"></span>
                        <a class="dash-ia-link" href="@Url.Action("Index", "AnalisisIA")">@Resources.Strings.Home_ConsumoIA_VerDetalle <i class="fas fa-arrow-right"></i></a>
                    </div>
                </div>
            }

        </div>
    </div>

</div>

<style>
    /* ================= Layout: todo visible en 1280×800 sin scroll ================= */
    .dash-wrapper {
        position:relative; z-index:1;
        height:calc(100vh - 70px - 2.5rem); min-height:560px;
        display:flex; flex-direction:column; gap:12px;
    }
    .body-content > .dash-wrapper + hr { display:none; }
    /* Más ancho útil en pantallas grandes (el .container de Bootstrap topa en 1140 px); en 14″ no cambia nada. */
    .container.body-content { max-width:1560px; width:100%; }
    @@media (min-width:1500px) { .dash-main { grid-template-columns:minmax(0,1fr) 340px; } }
    .dash-main {
        display:grid; grid-template-columns:minmax(0,1fr) 300px; gap:12px;
        flex:1; min-height:0;
    }
    .dash-side { display:flex; flex-direction:column; gap:12px; min-height:0; min-width:0; }

    /* ================= 1. Header compacto ================= */
    .dash-header-card {
        position:relative; overflow:hidden; flex-shrink:0;
        display:flex; align-items:center; gap:18px;
        background:#fff; border-radius:12px; padding:12px 18px;
        border:1px solid rgba(88,58,255,.08);
        box-shadow:0 4px 22px rgba(88,58,255,.07);
    }
    .dash-header-card::before {
        content:''; position:absolute; top:0; left:0; right:0; height:3px;
        background:linear-gradient(90deg,#583AFF 0%,#01E1D7 100%);
    }
    .dash-header-main { display:flex; flex-direction:column; gap:2px; min-width:0; }
    .dash-hello { font-size:1.15rem; font-weight:800; color:#160933; letter-spacing:-.2px; }
    .dash-hello strong { color:#583AFF; }
    .dash-date {
        font-size:.74rem; font-weight:600; color:#9691AE; text-transform:capitalize;
        display:flex; align-items:center; gap:.4rem;
    }
    .dash-date i { font-size:.7rem; color:#B9B4D4; }

    .dash-header-empresas {
        margin-left:auto; display:flex; flex-wrap:wrap; align-items:center;
        justify-content:flex-end; gap:5px; max-width:420px;
    }
    .dash-empresa-chip-light {
        display:inline-flex; align-items:center;
        font-size:.58rem; font-weight:700; letter-spacing:.03em; text-transform:uppercase;
        color:#583AFF; background:rgba(88,58,255,.07);
        border:1px solid rgba(88,58,255,.15);
        padding:.16rem .4rem; border-radius:4px; cursor:default;
    }
    .dash-empresa-chip {
        display:inline-flex; align-items:center; flex-shrink:0;
        font-size:.64rem; font-weight:800; letter-spacing:.05em; text-transform:uppercase;
        color:#fff; background:linear-gradient(135deg,#583AFF,#01E1D7);
        padding:.22rem .5rem; border-radius:6px;
    }
    .dash-empresa-nombre {
        font-size:.9rem; font-weight:800; color:#160933; letter-spacing:-.01em;
        display:inline-flex; align-items:center; gap:.4rem;
        overflow:hidden; text-overflow:ellipsis; white-space:nowrap; min-width:0;
    }
    .dash-empresa-nombre i { font-size:.78rem; color:#583AFF; flex-shrink:0; }
    .dash-grupo-label {
        display:inline-flex; align-items:center; gap:.3rem;
        font-size:.58rem; font-weight:800; letter-spacing:.03em; text-transform:uppercase;
        color:#583AFF; background:rgba(88,58,255,.07);
        border:1px solid rgba(88,58,255,.15); padding:.16rem .45rem; border-radius:5px;
    }
    .dash-grupo-label i { font-size:.58rem; }
    .dash-header-divider {
        width:1px; align-self:stretch; flex-shrink:0;
        background:linear-gradient(to bottom, transparent, rgba(88,58,255,.18), transparent);
    }
    .dash-greeting-logo { height:24px; width:auto; opacity:.55; flex-shrink:0; }

    /* ================= Tarjeta genérica ================= */
    .dash-card {
        background:#fff; border:1px solid rgba(88,58,255,.12); border-radius:11px;
        box-shadow:0 4px 14px rgba(22,9,51,.06);
        overflow:hidden; display:flex; flex-direction:column; min-height:0;
    }
    .dash-card-hdr {
        display:flex; align-items:center; gap:.5rem; flex-shrink:0;
        padding:10px 14px; border-bottom:1px solid rgba(88,58,255,.08);
        color:#583AFF; font-size:.8rem;
    }
    .dash-card-hdr-sm { padding:10px 14px 8px; border-bottom:none; }
    .dash-card-hdr > i:first-child { font-size:.78rem; }
    .dash-section-label {
        font-size:.68rem; font-weight:700; color:#583AFF;
        text-transform:uppercase; letter-spacing:1px;
    }
    .dash-section-toggle { cursor:pointer; user-select:none; }
    .dash-section-chevron { margin-left:auto; font-size:.62rem; opacity:.6; transition:transform .2s ease; flex-shrink:0; }
    .dash-section-chevron.rotado { transform:rotate(-90deg); }
    .dash-adv-count-badge {
        background:#ef4444; color:#fff; font-size:.62rem; font-weight:700;
        border-radius:99px; padding:.05rem .48rem;
    }
    .dash-indic-refreshbtn {
        margin-left:auto; background:none; border:none; cursor:pointer;
        color:#A0A0B8; font-size:.75rem; padding:2px 4px; transition:color .15s;
    }
    .dash-indic-refreshbtn:hover { color:#583AFF; }
    .dash-indic-refreshbtn + .dash-section-chevron { margin-left:.2rem; }

    /* ================= 2. Indicadores y noticias ================= */
    .dash-card-indic { min-height:0; }
    .dash-indic-body { display:flex; flex-direction:column; flex:1; min-height:0; }
    .dash-indic-loading {
        font-size:.78rem; color:#A0A0B8; display:flex; align-items:center; gap:.5rem; padding:14px;
    }
    .dash-indic-content { display:flex; flex-direction:column; flex:1; min-height:0; }

    .dash-trm-strip {
        flex-shrink:0; margin:10px 12px 0; padding:10px 14px; border-radius:10px;
        display:flex; align-items:center; gap:16px;
        background:var(--app-glow-bg); box-shadow:0 6px 16px rgba(22,9,51,.22);
    }
    .dash-trm-icon {
        width:32px; height:32px; border-radius:8px; flex-shrink:0;
        display:flex; align-items:center; justify-content:center;
        background:linear-gradient(135deg,#28A745,#01E1D7); color:#fff; font-size:.85rem;
    }
    .dash-trm-valor { font-size:1.25rem; font-weight:700; color:#fff; line-height:1.1; white-space:nowrap; }
    .dash-trm-valor-sm { font-size:.9rem; }
    .dash-trm-label {
        font-size:.6rem; font-weight:600; color:rgba(255,255,255,.55);
        text-transform:uppercase; letter-spacing:.5px;
    }
    .dash-trm-sep { width:1px; height:30px; background:rgba(255,255,255,.12); flex-shrink:0; }
    .dash-trm-fecha { font-size:.66rem; color:rgba(255,255,255,.5); }
    .dash-trm-fuente {
        margin-left:auto; display:flex; align-items:center; gap:4px;
        font-size:.62rem; color:#01E1D7; white-space:nowrap;
    }
    .dash-trm-nodisp { font-size:.8rem; color:#FCA311; font-weight:600; }

    .dash-news-hdr {
        flex-shrink:0; display:flex; align-items:center; gap:.5rem; padding:10px 14px 6px;
        color:#583AFF; font-size:.8rem;
    }
    .dash-news-titulo { font-size:.78rem; font-weight:800; color:#160933; white-space:nowrap; }
    .dash-news-filtros { margin-left:auto; display:flex; flex-wrap:nowrap; gap:.3rem; min-width:0; }
    .feed-leyenda-item {
        display:flex; align-items:center; gap:.3rem; white-space:nowrap;
        font-size:.58rem; font-weight:700; text-transform:uppercase; letter-spacing:.4px;
        border-radius:99px; padding:2px 8px; cursor:pointer; user-select:none;
        background:#fff; color:#8A86A8; border:1px solid rgba(88,58,255,.08);
        transition:all .15s;
    }
    .feed-leyenda-item .feed-n { opacity:.6; }
    .feed-leyenda-item.atenuado { opacity:.6; }
    .feed-leyenda-item.atenuado:hover { opacity:1; }
    .feed-leyenda-dot { width:7px; height:7px; border-radius:50%; flex-shrink:0; }

    #noticias-container { flex:1; min-height:0; overflow-y:auto; padding-bottom:6px; }
    .dash-feed-grupo {
        margin:4px 8px; border-left:3px solid #583AFF; border-radius:0 7px 7px 0; overflow:hidden;
    }
    .dash-feed-grupo-hdr {
        display:flex; align-items:center; gap:.4rem; padding:4px 8px;
        font-size:.62rem; font-weight:800; text-transform:uppercase; letter-spacing:.5px;
    }
    .dash-feed-grupo-hdr i { font-size:.4rem; opacity:.7; }
    .dash-feed-vermas {
        margin-left:auto; display:inline-flex; align-items:center; gap:4px;
        font-size:.58rem; font-weight:700; letter-spacing:.3px; text-decoration:none;
        color:inherit; opacity:.7; transition:opacity .15s;
    }
    .dash-feed-vermas:hover { opacity:1; text-decoration:underline; color:inherit; }
    .dash-feed-vermas i { font-size:.52rem; opacity:1; }
    .dash-noticias-list { list-style:none; margin:0; padding:0; }
    .dash-noticia-item { border-top:1px solid rgba(88,58,255,.06); }
    .dash-noticia-item a {
        display:flex; align-items:flex-start; gap:7px; padding:5px 10px 5px 8px;
        text-decoration:none; transition:background .12s;
    }
    .dash-noticia-item a:hover { background:rgba(88,58,255,.07); }
    .dash-noticia-item a:hover .dash-noticia-titulo { color:#583AFF; text-decoration:underline; }
    .dash-noticia-item a:focus-visible { outline:2px solid #583AFF; outline-offset:-2px; }
    /* Indicador de que la fila abre la noticia en el portal (siempre visible, se resalta al pasar el mouse) */
    .dash-noticia-ext {
        flex-shrink:0; align-self:center; font-size:.6rem; color:#B9B4D4;
        transition:color .15s, transform .15s;
    }
    .dash-noticia-item a:hover .dash-noticia-ext { color:#583AFF; transform:translate(1px,-1px); }
    .dash-noticia-titulo {
        font-size:.76rem; color:#160933; font-weight:500; line-height:1.3; flex:1; min-width:0;
        overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
    }
    .dash-noticia-fecha { font-size:.62rem; color:#6B6787; white-space:nowrap; flex-shrink:0; padding-top:1px; }
    .dash-noticias-hint { padding:12px 14px; font-size:.8rem; color:#A0A0B8; line-height:1.4; }

    /* ================= 3. Alertas ================= */
    .dash-alert-list {
        max-height:200px; overflow-y:auto; padding:8px;
        display:flex; flex-direction:column; gap:6px;
    }
    .dash-alert-item {
        display:flex; gap:8px; padding:7px 9px; border-radius:8px;
        border-left:3px solid #A0A0B8; background:rgba(160,160,184,.06);
    }
    .dash-alert-icon { font-size:.8rem; line-height:1.3; flex-shrink:0; }
    .dash-alert-body { min-width:0; flex:1; }
    .dash-alert-line1 { display:flex; align-items:baseline; gap:6px; min-width:0; }
    .dash-alert-empresa {
        font-size:.56rem; font-weight:800; color:#583AFF; text-transform:uppercase;
        letter-spacing:.04em; flex-shrink:0;
    }
    .dash-alert-titulo {
        font-size:.73rem; font-weight:700; color:#160933;
        overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
    }
    .dash-alert-msg { font-size:.68rem; color:#393F45; line-height:1.35; }
    .dash-alert-error   { border-left-color:#ef4444; background:rgba(239,68,68,.05); }
    .dash-alert-error .dash-alert-icon   { color:#ef4444; }
    .dash-alert-warning { border-left-color:#f59e0b; background:rgba(245,158,11,.06); }
    .dash-alert-warning .dash-alert-icon { color:#f59e0b; }
    .dash-alert-info    { border-left-color:#3b82f6; background:rgba(59,130,246,.05); }
    .dash-alert-info .dash-alert-icon    { color:#3b82f6; }
    .dash-alert-ok {
        display:flex; align-items:center; gap:8px; padding:10px 14px;
        font-size:.74rem; color:#393F45;
    }
    .dash-alert-ok i { color:#22c55e; }

    /* ================= 4. Accesos rápidos ================= */
    .dash-acc-grid { display:grid; grid-template-columns:1fr 1fr; gap:6px; padding:0 10px 10px; }
    .dash-acc-item {
        display:flex; align-items:center; gap:7px; padding:5px 7px; min-width:0;
        border:1px solid rgba(88,58,255,.1); border-radius:8px; text-decoration:none !important;
        transition:all .15s;
    }
    .dash-acc-item:hover { background:rgba(88,58,255,.04); border-color:rgba(88,58,255,.25); }
    .dash-acc-icon {
        width:24px; height:24px; border-radius:6px; flex-shrink:0;
        display:flex; align-items:center; justify-content:center;
        background:var(--app-btn-gradient); color:#fff; font-size:.62rem;
    }
    .dash-acc-nombre {
        font-size:.68rem; font-weight:700; color:#160933;
        overflow:hidden; text-overflow:ellipsis; white-space:nowrap; min-width:0;
    }
    .dash-acc-hint { padding:0 12px 10px; font-size:.62rem; color:#9691AE; line-height:1.35; }

    /* ================= 5. Mi consumo de IA ================= */
    .dash-ia-card { padding:10px 14px; gap:6px; flex-shrink:0; }
    .dash-ia-row { display:flex; align-items:center; gap:.5rem; color:#583AFF; font-size:.78rem; }
    .dash-ia-row .dash-section-label { white-space:nowrap; }
    .dash-ia-select {
        margin-left:auto; max-width:130px; font-size:.68rem; font-weight:700; color:#393F45;
        border:1px solid #E4E1F0; border-radius:6px; padding:2px 6px; background:#fff;
    }
    .dash-ia-texto { font-size:.76rem; font-weight:700; color:#160933; }
    .dash-ia-texto .muted { color:#9691AE; font-weight:600; }
    .dash-ia-track { height:6px; border-radius:99px; background:#ECEAF4; overflow:hidden; }
    .dash-ia-fill { height:100%; width:0; border-radius:99px; background:var(--app-btn-gradient); transition:width .4s ease; }
    .dash-ia-fill.alto { background:#f59e0b; }
    .dash-ia-fill.agotado { background:#ef4444; }
    .dash-ia-row-meta { justify-content:space-between; }
    .dash-ia-meta { font-size:.6rem; color:#9691AE; }
    .dash-ia-link { font-size:.66rem; font-weight:700; color:#583AFF; text-decoration:none; white-space:nowrap; }
    .dash-ia-link:hover { text-decoration:underline; }
    .dash-ia-link i { font-size:.55rem; margin-left:.15rem; }

    /* ================= Responsive ================= */
    @@media (max-width:991px) {
        .dash-wrapper { height:auto; min-height:0; }
        .dash-main { grid-template-columns:1fr; }
        #noticias-container { flex:none; max-height:280px; }
        .dash-news-hdr { flex-wrap:wrap; }
        .dash-news-filtros { margin-left:0; flex-wrap:wrap; }
        .dash-trm-strip { flex-wrap:wrap; gap:10px 16px; }
        .dash-trm-fuente { margin-left:0; }
    }
    @@media (max-width:576px) {
        .dash-header-card { padding:10px 12px; gap:10px; flex-wrap:wrap; }
        .dash-header-empresas { margin-left:0; max-width:100%; justify-content:flex-start; }
        .dash-header-divider { display:none; }
        .dash-greeting-logo { height:20px; margin-left:auto; }
        .dash-hello { font-size:1.05rem; }
    }
</style>

@section scripts {
<script>
(function () {
    var _s = {
        vigente:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_TRM_Vigente))',
        noDisp:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_TRM_NoDisponible))',
        vacias:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_Noticias_Vacias))',
        noConfig:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_Noticias_NoConfig))',
        error:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_Noticias_Error))',
        colapsar:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_Noticias_Colapsar))',
        expandir:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_Noticias_Expandir))',
        irNoticia: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_Noticias_IrNoticia))',
        verMas:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_Noticias_VerMas))',
        todas:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_Noticias_Todas))',
        alertasOk:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_Alertas_SinDatos))',
        alertasError: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_Alertas_Error))',
        accSugeridos: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_Accesos_Sugeridos))',
        accVacio:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_Accesos_Vacio))',
        iaTokens:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IAConsumo_Tokens))',
        iaTokensIlim: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IAConsumo_TokensIlim))',
        iaProyeccion: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Home_ConsumoIA_Proyeccion))',
        iaPool:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IAConsumo_Pool))',
        iaApagada:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IAConsumo_Apagada))',
        iaError:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IAConsumo_Error))'
    };

    var _urlNoticias   = '@Url.Action("ObtenerNoticias", "Home")';
    var _urlAlertas    = '@Url.Action("ObtenerAlertas", "Home")';
    var _urlAccesos    = '@Url.Action("ObtenerAccesosRapidos", "Home")';
    var _urlConsumoIA  = '@Url.Action("MiConsumo", "AnalisisIA")';

    function fmtCOP(v) {
        try { return new Intl.NumberFormat('es-CO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(v); }
        catch (e) { return v; }
    }

    function esc(s) {
        if (!s) return '';
        var d = document.createElement('div');
        d.appendChild(document.createTextNode(s));
        return d.innerHTML;
    }

    // Paleta corporativa: púrpura, teal, violeta, azul
    var FEED_COLORS = ['#583AFF', '#00A89E', '#9B5DE5', '#118AB2'];
    var FEED_BGS    = ['rgba(88,58,255,.04)', 'rgba(0,168,158,.05)', 'rgba(155,93,229,.04)', 'rgba(17,138,178,.04)'];

    // Cache TRM en sessionStorage — válido 2 horas, evita fetch extra al volver al dashboard
    var TRM_KEY = 'bufins_trm';
    var TRM_TTL = 7200000;

    // Filtro de portal de noticias: 'all' o el nombre del feed. Se recuerda en la sesión del navegador.
    var FILTRO_KEY = 'bufins_noticias_filtro';
    var filtroPortal = 'all';
    try { filtroPortal = sessionStorage.getItem(FILTRO_KEY) || 'all'; } catch (e) {}
    var _feeds = [];
    var MAX_NOTICIAS_POR_PORTAL = 6;   // el servidor ya limita a 6; se vuelve a acotar por seguridad

    // ── TRM ──
    function mostrarTRM(cop, fecha, eur) {
        $('#trm-valor').html('$' + fmtCOP(cop));
        $('#trm-fecha').text(_s.vigente + ' ' + fecha);
        var hayEur = eur && eur > 0;
        $('#trm-eur').text(hayEur ? '$' + fmtCOP(eur) : '');
        $('#trm-eur-bloque, #trm-sep-eur').toggle(!!hayEur);
    }

    function mostrarTRMNoDisp() {
        $('#trm-valor').html('<span class="dash-trm-nodisp">' + esc(_s.noDisp) + '</span>');
        $('#trm-fecha').text('');
        $('#trm-eur').text('');
        $('#trm-eur-bloque, #trm-sep-eur').hide();
    }

    // ── Noticias ──
    // "es.investing.com" → "investing", "larepublica.co" → "larepublica" (para que la fila de filtros no haga wrap)
    function etiquetaPortal(nombre) {
        return String(nombre || '').replace(/^es\./i, '').replace(/\.(com|co)(\.[a-z]{2})?$/i, '').toLowerCase();
    }

    function guardarFiltro() {
        try { sessionStorage.setItem(FILTRO_KEY, filtroPortal); } catch (e) {}
    }

    function pintarNoticias() {
        var $ley  = $('#noticias-leyenda');
        var $cont = $('#noticias-container');
        $ley.empty(); $cont.empty();

        var feeds = _feeds;
        // Si el portal recordado ya no existe, se vuelve a "Todas".
        if (filtroPortal !== 'all' && !feeds.some(function (f) { return f.Fuente === filtroPortal; })) filtroPortal = 'all';

        function noticiasDe(f) { return (f.Noticias || []).slice(0, MAX_NOTICIAS_POR_PORTAL); }
        var total = feeds.reduce(function (a, f) { return a + noticiasDe(f).length; }, 0);
        var hayFiltro = filtroPortal !== 'all';

        // — Chips de filtro —
        function chip(clave, etiqueta, titulo, n, color, bgActivo) {
            var activo = clave === 'all' ? !hayFiltro : filtroPortal === clave;
            var estilo = activo ? ' style="background:' + bgActivo + ';color:' + color + ';border-color:' + color + '"' : '';
            var punto = clave === 'all'
                ? 'linear-gradient(135deg,#583AFF,#01E1D7)'
                : color;
            return '<span class="feed-leyenda-item' + (hayFiltro && !activo ? ' atenuado' : '') + '" data-feed="' + esc(clave) + '" title="' + esc(titulo) + '"' + estilo + '>' +
                   '<span class="feed-leyenda-dot" style="background:' + punto + '"></span>' +
                   esc(etiqueta) + ' <span class="feed-n">' + n + '</span></span>';
        }

        $ley.append(chip('all', _s.todas, _s.todas, total, '#583AFF', 'rgba(88,58,255,.08)'));
        feeds.forEach(function (f, i) {
            var color = FEED_COLORS[i % FEED_COLORS.length];
            $ley.append(chip(f.Fuente, etiquetaPortal(f.Fuente), f.Fuente, noticiasDe(f).length,
                             color, hexA(color, .1)));
        });
        $ley.show();

        // — Grupos por feed (solo el filtrado, o todos) —
        feeds.forEach(function (f, i) {
            var noticias = noticiasDe(f);
            if (!noticias.length) return;
            if (hayFiltro && f.Fuente !== filtroPortal) return;
            var color = FEED_COLORS[i % FEED_COLORS.length];
            var bg    = FEED_BGS[i % FEED_BGS.length];

            var $grp = $('<div class="dash-feed-grupo"></div>').attr('data-feed', f.Fuente).css({
                'border-left-color': color,
                'background': bg
            });
            // "Ver más" → portada del portal (origen del enlace de la primera noticia)
            var origen = '';
            try { origen = new URL(noticias[0].Enlace).origin; } catch (e) {}
            $grp.append(
                '<div class="dash-feed-grupo-hdr" style="color:' + color + '">' +
                '<i class="fas fa-circle"></i>' + esc(f.Fuente) +
                (origen ? '<a class="dash-feed-vermas" href="' + esc(origen) + '" target="_blank" rel="noopener noreferrer" title="' + esc(_s.verMas) + '">' +
                          esc(_s.verMas) + ' <i class="fas fa-arrow-up-right-from-square"></i></a>' : '') +
                '</div>'
            );

            var $ul = $('<ul class="dash-noticias-list"></ul>');
            noticias.forEach(function (n) {
                var fec = n.FechaTexto ? '<span class="dash-noticia-fecha">' + esc(n.FechaTexto) + '</span>' : '';
                $ul.append(
                    $('<li class="dash-noticia-item"></li>').html(
                        '<a href="' + esc(n.Enlace) + '" target="_blank" rel="noopener noreferrer" title="' + esc(_s.irNoticia) + '">' +
                        '<span class="dash-noticia-titulo">' + esc(n.Titulo) + '</span>' + fec +
                        '<i class="fas fa-arrow-up-right-from-square dash-noticia-ext" aria-hidden="true"></i></a>'
                    )
                );
            });
            $grp.append($ul);
            $cont.append($grp);
        });

        $cont.show();
        $('#noticias-hint').hide();
    }

    // "#583AFF" + .1 → "rgba(88,58,255,.1)"
    function hexA(hex, a) {
        var h = hex.replace('#', '');
        return 'rgba(' + parseInt(h.substr(0, 2), 16) + ',' + parseInt(h.substr(2, 2), 16) + ',' + parseInt(h.substr(4, 2), 16) + ',' + a + ')';
    }

    function renderNoticias(d) {
        var $ley  = $('#noticias-leyenda');
        var $cont = $('#noticias-container');
        var $hint = $('#noticias-hint');

        if (!d.rssConfigurado) {
            $ley.hide().empty(); $cont.hide().empty(); $hint.text(_s.noConfig).show();
            return;
        }
        _feeds = d.feeds || [];
        if (!_feeds.length) {
            $ley.hide().empty(); $cont.hide().empty(); $hint.text(_s.vacias).show();
            return;
        }
        pintarNoticias();
    }

    // Clic en un chip: filtra; clic en el activo (o en "Todas") → todas. Sin recargar ni volver al servidor.
    $(document).on('click', '#noticias-leyenda .feed-leyenda-item', function () {
        var clave = $(this).attr('data-feed');
        filtroPortal = (clave === 'all' || clave === filtroPortal) ? 'all' : clave;
        guardarFiltro();
        pintarNoticias();
    });

    function cargar(refresh) {
        var $load = $('#indic-loading');
        var $content = $('#indic-content');
        var $btn  = $('#btn-indic-refresh');

        $load.show(); $content.hide();
        $btn.prop('disabled', true).find('i').addClass('fa-spin');

        var pendiente = 2;
        function fin() {
            pendiente--;
            if (pendiente === 0) {
                $load.hide(); $content.show();
                $btn.prop('disabled', false).find('i').removeClass('fa-spin');
            }
        }

        // ── TRM: sessionStorage → fetch (open.er-api.com, CORS habilitado) ──
        (function () {
            if (!refresh) {
                try {
                    var raw = sessionStorage.getItem(TRM_KEY);
                    if (raw) {
                        var obj = JSON.parse(raw);
                        if (Date.now() - obj.ts < TRM_TTL) {
                            mostrarTRM(obj.cop, obj.fecha, obj.eur);
                            fin();
                            return; // usa cache, no hace fetch
                        }
                    }
                } catch (e) {}
            }
            fetch('https://open.er-api.com/v6/latest/USD')
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    var cop = d.rates && d.rates.COP ? parseFloat(d.rates.COP) : 0;
                    var eur = (d.rates && d.rates.COP && d.rates.EUR)
                        ? (parseFloat(d.rates.COP) / parseFloat(d.rates.EUR)) : 0;
                    if (d.result === 'success' && cop > 0) {
                        var utc = d.time_last_update_utc || '';
                        var fechaFmt = '';
                        if (utc) {
                            var dt = new Date(utc);
                            if (!isNaN(dt.getTime())) {
                                fechaFmt = ('0' + dt.getUTCDate()).slice(-2) + '/' +
                                           ('0' + (dt.getUTCMonth() + 1)).slice(-2) + '/' +
                                           dt.getUTCFullYear();
                            }
                        }
                        try { sessionStorage.setItem(TRM_KEY, JSON.stringify({ cop: cop, eur: eur, fecha: fechaFmt, ts: Date.now() })); } catch (e) {}
                        mostrarTRM(cop, fechaFmt, eur);
                    } else {
                        mostrarTRMNoDisp();
                    }
                    fin();
                })
                .catch(function () { mostrarTRMNoDisp(); fin(); });
        })();

        // ── Noticias: desde el servidor (parseo RSS server-side); el filtro activo se conserva ──
        $.getJSON(_urlNoticias + (refresh ? '?refresh=true' : ''))
            .done(function (d) { renderNoticias(d); })
            .fail(function () {
                $('#noticias-leyenda').hide().empty();
                $('#noticias-container').hide().empty();
                $('#noticias-hint').text(_s.error).show();
            })
            .always(function () { fin(); });
    }

    // ── Alertas (sp_ObtenerAlertasHome) ──
    function cargarAlertas() {
        var $grid = $('#alertas-grid');
        var $badge = $('#alertas-badge');

        function aviso(icono, texto) {
            return '<div class="dash-alert-ok"><i class="fas ' + icono + '"></i><span>' + esc(texto) + '</span></div>';
        }

        $.getJSON(_urlAlertas).done(function (d) {
            var alertas = (d && d.ok && d.alertas) ? d.alertas : null;
            if (!alertas) { $grid.html(aviso('fa-exclamation-triangle', _s.alertasError)); return; }
            if (!alertas.length) { $badge.hide(); $grid.html(aviso('fa-check-circle', _s.alertasOk)); return; }

            var iconos = { Error: ['error', 'fa-times-circle'], Advertencia: ['warning', 'fa-exclamation-triangle'], Info: ['info', 'fa-info-circle'] };
            $grid.html(alertas.map(function (a) {
                var m = iconos[a.severidad] || iconos.Info;
                return '<div class="dash-alert-item dash-alert-' + m[0] + '">' +
                       '<i class="fas ' + m[1] + ' dash-alert-icon"></i>' +
                       '<div class="dash-alert-body">' +
                       '<div class="dash-alert-line1">' +
                       (a.empresa ? '<span class="dash-alert-empresa">' + esc(a.empresa) + '</span>' : '') +
                       (a.titulo ? '<span class="dash-alert-titulo">' + esc(a.titulo) + '</span>' : '') +
                       '</div>' +
                       '<div class="dash-alert-msg">' + esc(a.mensaje) + '</div>' +
                       '</div></div>';
            }).join(''));
            $grid.scrollTop(0);
            $badge.text(alertas.length).show();
        }).fail(function () {
            $grid.html(aviso('fa-exclamation-triangle', _s.alertasError));
        });
    }

    // ── Accesos rápidos (más visitados del usuario) ──
    function cargarAccesos() {
        var $grid = $('#accesos-grid');
        var $hint = $('#accesos-hint');
        $.getJSON(_urlAccesos).done(function (d) {
            var items = (d && d.ok && d.items) ? d.items : [];
            if (!items.length) { $hint.text(_s.accVacio).show(); return; }
            $grid.html(items.map(function (i) {
                return '<a class="dash-acc-item" href="' + esc(i.url) + '" title="' + esc(i.nombre) + '">' +
                       '<span class="dash-acc-icon"><i class="' + esc(i.icono || 'fas fa-link') + '"></i></span>' +
                       '<span class="dash-acc-nombre">' + esc(i.nombre) + '</span></a>';
            }).join(''));
            if (d.sugeridos) $hint.text(_s.accSugeridos).show();
        }).fail(function () { $hint.text(_s.accVacio).show(); });
    }

    // ── Consumo de IA (reutiliza AnalisisIA/MiConsumo) ──
    function cargarConsumoIA() {
        var $sel = $('#ia-empresa');
        if (!$sel.length) return;

        function pintar() {
            $('#ia-texto').html('<i class="fas fa-spinner fa-spin"></i>');
            $.getJSON(_urlConsumoIA, { idEmpresa: $sel.val() }).done(function (r) {
                if (!r || !r.ok) { $('#ia-texto').text(_s.iaError); $('#ia-barra').css('width', 0); $('#ia-meta').text(''); return; }
                var consumido = Number(r.consumido).toLocaleString();
                var texto = r.ilimitado
                    ? _s.iaTokensIlim.replace('{0}', consumido)
                    : _s.iaTokens.replace('{0}', consumido).replace('{1}', Number(r.presupuesto).toLocaleString()).replace('{2}', r.porcentaje);
                // El texto entre paréntesis final, atenuado: "0 tokens usados (sin límite)"
                $('#ia-texto').html(esc(texto).replace(/(\([^)]*\))\s*$/, '<span class="muted">$1</span>'));
                $('#ia-barra').css('width', (r.ilimitado ? 0 : Math.min(100, r.porcentaje)) + '%')
                              .toggleClass('agotado', !r.ilimitado && r.porcentaje >= 100)
                              .toggleClass('alto', !r.ilimitado && r.porcentaje >= 80 && r.porcentaje < 100);
                var meta = r.inicio + ' – ' + r.fin + ' · ' + _s.iaProyeccion.replace('{0}', Number(r.proyeccion).toLocaleString());
                if (r.enPool) meta += ' · ' + _s.iaPool.replace('{0}', r.empresasEnPool);
                if (!r.habilitada) meta += ' · ' + _s.iaApagada;
                $('#ia-meta').text(meta).attr('title', meta);
            }).fail(function () { $('#ia-texto').text(_s.iaError); });
        }

        pintar();
        $sel.on('change', pintar);
    }

    function initSecciones() {
        // Cada tarjeta se expande/colapsa de forma independiente (excluye el botón de refresh).
        $(document).on('click', '.dash-section-toggle', function (e) {
            if ($(e.target).closest('#btn-indic-refresh').length) return;
            var $lbl  = $(this);
            var $body = $('#' + $lbl.data('target'));
            var $chev = $lbl.find('.dash-section-chevron');
            var abierto = $body.is(':visible');

            if (abierto) {
                $body.slideUp(180);
                $chev.addClass('rotado');
                $lbl.attr('title', _s.expandir);
            } else {
                $body.slideDown(180);
                $chev.removeClass('rotado');
                $lbl.attr('title', _s.colapsar);
            }
        });
    }

    $(document).ready(function () {
        initSecciones();
        cargarAlertas();
        cargarAccesos();
        cargarConsumoIA();
        cargar(false);
        $('#btn-indic-refresh').on('click', function () { cargar(true); });
    });
})();
</script>
}
