@{
    ViewBag.Title = "Home Page";
}

<div class="container-fluid position-relative" style="min-height: 70vh;">
    <div class="watermark">
        <img src="~/Assets/img/Bufins_LogoLogin.png" alt="Bufins Watermark">
    </div>
</div>

<style>
    .watermark {
        position: absolute;
        top: 50%; /* Más abajo que 50% */
        left: 50%;
        transform: translate(-50%, -50%);
        opacity: 0.15;
        z-index: 1;
        pointer-events: none;
        user-select: none;
    }

    .watermark img {
        max-width: 600px;
        width: 100%;
        height: auto;
        display: block;
    }

    @@media (max-width: 768px) {
        .watermark img {
            max-width: 400px;
        }
    }

    @@media (max-width: 480px) {
        .watermark img {
            max-width: 250px;
        }
    }
</style>
