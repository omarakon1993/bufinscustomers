@{
    ViewBag.Title = "Home Page";
}

<div class="container-fluid position-relative" style="min-height: 70vh;">
    <div class="watermark">
        <img src="~/Assets/img/Bufins_LogoLogin.png" alt="Bufins Watermark">
        <div class="watermark-slogan">BUSINESS FINANCE ALWAYS EVERYWHERE</div>
    </div>
</div>

<style>
    .watermark {
        position: absolute;
        top: 50%; /* Más abajo que 50% */
        left: 50%;
        transform: translate(-50%, -50%);
        opacity: 0.15;
        z-index: 1;
        pointer-events: none;
        user-select: none;
    }

    .watermark img {
        max-width: 600px;
        width: 100%;
        height: auto;
        display: block;
    }

    .watermark-slogan {
        text-align: center;
        font-size: 1.5rem;
        font-weight: 700;
        color: #393F45;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-top: 1.5rem;
        font-family: 'Nunito', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    .watermark-divider {
        margin: 1.5rem auto 0;
        width: 80%;
        border: 0;
        border-top: 2px solid #6B7280;
        opacity: 1;
    }

    @@media (max-width: 768px) {
        .watermark img {
            max-width: 400px;
        }

        .watermark-slogan {
            font-size: 0.7rem;
            letter-spacing: 0.5px;
        }

        .watermark-divider {
            width: 90%;
        }
    }

    @@media (max-width: 480px) {
        .watermark img {
            max-width: 250px;
        }

        .watermark-slogan {
            font-size: 0.55rem;
            letter-spacing: 0.3px;
            margin-top: 1rem;
        }

        .watermark-divider {
            width: 95%;
            margin-top: 1rem;
        }
    }
</style>
