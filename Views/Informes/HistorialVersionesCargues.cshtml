@model bufinscustomers.Models.HistorialVersionesPageViewModel
@using bufinscustomers.Helpers
@using System.Linq

@{
    ViewBag.Title = Resources.Strings.Hist_PageTitle;
    Layout = "~/Views/Shared/_LayoutFragment.cshtml";   // siempre embebida en «Historial de cargues» (HistorialCargues.cshtml)
    var esSuper = UsuarioSesionHelper.EsSuperAdmin();
    var puedeRollback = esSuper || UsuarioSesionHelper.EsAdminEmpresa();
    var anios = Model.Versiones.Select(v => v.Anio).Distinct().OrderByDescending(a => a).ToList();

    // Datos para el render en cliente (Assets/js/historial-versiones.js). Los textos de presentación van como recursos.
    var filas = Model.Versiones.Select(v => new
    {
        id = v.Id,
        empresa = v.NombreEmpresa,
        anio = v.Anio,
        modo = (int)v.Modo,
        modoTexto = v.Modo == 0 ? Resources.Strings.Hist_ModoEjecucion : Resources.Strings.Hist_ModoHistorico,
        esc = v.IdEscenario,
        version = v.VersionDisplay,
        fecha = v.FechaCargue.ToString("dd/MM/yyyy"),
        hora = v.FechaCargue.ToString("HH:mm"),
        ts = v.FechaCargue.Ticks,
        usuario = v.NombreUsuario,
        archivo = v.NombreArchivo,
        filas = v.TotalFilas.ToString("N0"),
        cero = v.TotalFilas == 0,
        estado = v.EstadoDisplay,
        actual = v.EsVersionActual
    }).ToList();
}

<div class="container-fluid px-4 hv-page">

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle mr-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <!-- Filtros: se aplican al cambiar -->
    <div class="hv-card hv-filters" @Html.Raw(esSuper ? "" : "style=\"grid-template-columns:repeat(3,minmax(0,1fr)) auto\"")>
        @if (esSuper)
        {
            <div class="hv-field">
                <label for="filterEmpresa"><i class="fas fa-building"></i>@Resources.Strings.Common_LabelEmpresa</label>
                <select id="filterEmpresa" class="hv-select">
                    <option value="">@Resources.Strings.Common_Todos</option>
                    @foreach (var emp in Model.Empresas)
                    {
                        <option value="@emp.Nombre" @(Model.IdEmpresaFiltro == emp.Id ? "selected" : "")>@emp.Nombre</option>
                    }
                </select>
            </div>
        }
        <div class="hv-field">
            <label for="filterAnio"><i class="fas fa-calendar"></i>@Resources.Strings.Common_LabelAnio</label>
            <select id="filterAnio" class="hv-select">
                <option value="">@Resources.Strings.Common_Todos</option>
                @foreach (var a in anios)
                {
                    <option value="@a" @(Model.AnioFiltro == a ? "selected" : "")>@a</option>
                }
            </select>
        </div>
        <div class="hv-field">
            <label for="filterModo"><i class="fas fa-layer-group"></i>@Resources.Strings.Hist_LabelModo</label>
            <select id="filterModo" class="hv-select">
                <option value="">@Resources.Strings.Common_Todos</option>
                <option value="0" @(Model.ModoFiltro == 0 ? "selected" : "")>@Resources.Strings.Hist_ModoEjecucion</option>
                <option value="1" @(Model.ModoFiltro == 1 ? "selected" : "")>@Resources.Strings.Hist_ModoHistorico</option>
            </select>
        </div>
        <div class="hv-field">
            <label for="filterEscenario"><i class="fas fa-database"></i>@Resources.Strings.Hist_LabelEscenario</label>
            <select id="filterEscenario" class="hv-select">
                <option value="">@Resources.Strings.Common_Todos</option>
                @if (ViewBag.Escenarios != null)
                {
                    foreach (var escenario in ViewBag.Escenarios)
                    {
                        <option value="@escenario.Id" @(Model.EscenarioFiltro == (int)escenario.Id ? "selected" : "")>@escenario.Nombre</option>
                    }
                }
            </select>
        </div>
        <button type="button" id="btnLimpiar" class="hv-btn-ghost">
            <i class="fas fa-eraser"></i>@Resources.Strings.Common_Limpiar
        </button>
    </div>

    <!-- Resultados -->
    <div class="hv-bar">
        <h2>@Resources.Strings.Cg_Versiones_Titulo <span class="hv-count" id="hvCount"></span></h2>
        <div class="hv-segmented" id="hvVista" role="group">
            <button type="button" data-vista="grupo" class="active"><i class="fas fa-layer-group"></i>@Resources.Strings.Hist_VistaGrupo</button>
            <button type="button" data-vista="lista"><i class="fas fa-list"></i>@Resources.Strings.Hist_VistaLista</button>
        </div>
    </div>

    <div id="hvContenido"></div>

    <div class="hv-card hv-empty" id="hvEmpty" style="display:none">
        <div class="hv-empty-icon"><i class="fas fa-inbox"></i></div>
        <h4>@Resources.Strings.Hist_NoData</h4>
        <p>@Resources.Strings.Hist_NoDataDesc</p>
    </div>

    @if (puedeRollback && Model.Respaldos.Any())
    {
        <!-- Red de seguridad: respaldos automáticos tomados antes de cada «Deshacer» (permiten volver atrás) -->
        <details class="hv-card hv-resp">
            <summary>
                <i class="fas fa-life-ring"></i>@Resources.Strings.Hist_Resp_Titulo
                <span class="hv-count">@Model.Respaldos.Count</span>
                <i class="fas fa-chevron-down hv-resp-caret"></i>
            </summary>
            <p class="hv-resp-desc">@Resources.Strings.Hist_Resp_Desc</p>
            <div class="hv-table-wrap">
                <table class="hv-table">
                    <thead><tr>
                        <th>@Resources.Strings.Hist_Resp_ThFecha</th>
                        @if (esSuper) { <th>@Resources.Strings.Hist_ThEmpresa</th> }
                        <th>@Resources.Strings.Hist_ThAnio</th>
                        <th>@Resources.Strings.Hist_ThModo</th>
                        <th>@Resources.Strings.Hist_ThEscenario</th>
                        <th>@Resources.Strings.Hist_ThUsuario</th>
                        <th class="num">@Resources.Strings.Hist_ThFilas</th>
                        <th></th>
                    </tr></thead>
                    <tbody>
                    @foreach (var rp in Model.Respaldos)
                    {
                        <tr class="hv-row">
                            <td><span class="hv-date">@rp.Fecha.ToString("dd/MM/yyyy")</span><span class="hv-time">@rp.Fecha.ToString("HH:mm")</span></td>
                            @if (esSuper) { <td>@rp.NombreEmpresa</td> }
                            <td>@rp.Anio</td>
                            <td><span class="cg-pill @(rp.Modo == 0 ? "cg-pill-ejec" : "cg-pill-hist")"><i class="fas @(rp.Modo == 0 ? "fa-play" : "fa-history")"></i>@(rp.Modo == 0 ? Resources.Strings.Hist_ModoEjecucion : Resources.Strings.Hist_ModoHistorico)</span></td>
                            <td><span class="cg-pill cg-pill-esc"><i class="fas fa-layer-group"></i>@Resources.Strings.Hist_EscCorto @rp.IdEscenario</span></td>
                            <td>@rp.NombreUsuario</td>
                            <td class="num">@rp.TotalFilas.ToString("N0")</td>
                            <td class="hv-actions">
                                <button type="button" class="cg-btn hv-recuperar" data-id="@rp.Id"
                                        data-empresa="@rp.NombreEmpresa" data-anio="@rp.Anio" data-fecha="@rp.Fecha.ToString("dd/MM/yyyy HH:mm")">
                                    <i class="fas fa-undo"></i>@Resources.Strings.Hist_Resp_BtnRecuperar
                                </button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </details>
    }
</div>

<!-- Modal de confirmación -->
<div class="hv-modal-backdrop" id="hvModalBackdrop">
    <div class="hv-modal" role="dialog" aria-modal="true" aria-labelledby="hvModalTitulo">
        <div class="hv-modal-title" id="hvModalTitulo"><i class="fas fa-undo"></i>@Resources.Strings.Hist_JS_ConfirmTitle</div>
        <div class="hv-modal-body">
            <div id="hvModalCuerpo"></div>
            <div class="hv-modal-warn"><i class="fas fa-exclamation-triangle"></i><span>@Resources.Strings.Hist_ModalAviso</span></div>
        </div>
        <div class="hv-modal-foot">
            <button type="button" class="hv-modal-cancel" id="hvModalCancel">@Resources.Strings.Hist_JS_CancelBtn</button>
            <button type="button" class="hv-modal-ok" id="hvModalOk">@Resources.Strings.Hist_JS_ConfirmBtn</button>
        </div>
    </div>
</div>

<div class="hv-toast" id="hvToast" role="status"><i class="fas fa-check-circle"></i><span id="hvToastMsg"></span></div>

@using (Html.BeginForm("RecuperarRespaldo", "HistorialVersionesCargues", FormMethod.Post,
    new { id = "formRecuperar", style = "display:none" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="idRespaldo"      id="inp_idRespaldo" />
    <input type="hidden" name="idEmpresaFiltro" value="@Model.IdEmpresaFiltro" />
    <input type="hidden" name="anioFiltro"      value="@Model.AnioFiltro" />
    <input type="hidden" name="modoFiltro"      value="@Model.ModoFiltro" />
    <input type="hidden" name="escenarioFiltro" value="@Model.EscenarioFiltro" />
}

@using (Html.BeginForm("Restaurar", "HistorialVersionesCargues", FormMethod.Post,
    new { id = "formRestaurar", style = "display:none" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="idHistorial"     id="inp_idHistorial" />
    <input type="hidden" name="idEmpresaFiltro" value="@Model.IdEmpresaFiltro" />
    <input type="hidden" name="anioFiltro"      value="@Model.AnioFiltro" />
    <input type="hidden" name="modoFiltro"      value="@Model.ModoFiltro" />
    <input type="hidden" name="escenarioFiltro" value="@Model.EscenarioFiltro" />
}

@section scripts {
<script>
    var _hv = {
        datos: @Html.Raw(Json.Encode(filas)),
        max: @Model.MaxVersiones,
        esSuper: @(esSuper ? "true" : "false"),
        puedeRollback: @(puedeRollback ? "true" : "false"),
        okMsg: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Convert.ToString(TempData["SuccessMessage"] ?? "")))',
        t: {
            versiones:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_FilasCount))',
            empresa:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_ThEmpresa))',
            anio:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_ThAnio))',
            modo:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_ThModo))',
            escenario:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_ThEscenario))',
            escCorto:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_EscCorto))',
            fecha:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_ThFecha))',
            usuario:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_ThUsuario))',
            archivo:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_ThArchivo))',
            filas:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_ThFilas))',
            estado:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_ThEstado))',
            cargue:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_ThCargue))',
            restaurar:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_BtnRestaurar))',
            deshacerCorto: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_BtnDeshacerCorto))',
            deshacerTip:'@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_DeshacerTip))',
            versionTip: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_VersionTip))',
            filasCopia: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_FilasCopia))',
            est_actual:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_Est_Vigente))',
            est_anterior:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_Est_Anterior))',
            est_revertido: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_Est_Restaurada))',
            slotsDe:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_SlotsDe))',
            slotsLleno: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_SlotsLleno))',
            slotsLibre: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_SlotsLibre))',
            modalCuerpo:'@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_ModalCuerpo))'
        },
        resp: {
            titulo:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_Resp_ConfirmTitle))',
            texto:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_Resp_ConfirmText))',
            boton:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_Resp_BtnRecuperar))',
            cancelar: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Hist_JS_CancelBtn))'
        }
    };
</script>
<script src="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/js/historial-versiones.js")"></script>
<script>
    // Recuperar un respaldo automático (deshace un «Deshacer»): confirmación y envío del formulario.
    $(function () {
        function esc(s) { return $('<div>').text(s == null ? '' : s).html(); }
        $(document).off('click.hvrec').on('click.hvrec', '.hv-recuperar', function () {
            var $b = $(this), id = $b.data('id');
            Swal.fire({
                icon: 'warning',
                title: _hv.resp.titulo,
                html: _hv.resp.texto.replace('{0}', esc($b.data('empresa'))).replace('{1}', esc($b.data('anio'))).replace('{2}', esc($b.data('fecha'))),
                showCancelButton: true,
                confirmButtonText: _hv.resp.boton,
                cancelButtonText: _hv.resp.cancelar
            }).then(function (r) {
                if (r.isConfirmed) { $('#inp_idRespaldo').val(id); $('#formRecuperar').submit(); }
            });
        });
    });
</script>
}
