    // El prompt pide 3 líneas con etiquetas fijas "Fortaleza:", "Riesgo:" y "Prioridad:" (o "Strength:", "Risk:", "Priority:"). Se separan por esas
    // palabras clave al inicio de línea (tolerando viñetas, encabezados markdown y negritas). Si falta alguna, null → markdown completo.
    function separarInsights(texto) {
        var claves = { fortaleza: /^(fortaleza|strength)/i, riesgo: /^(riesgo|risk)/i, prioridad: /^(prioridad|priority)/i };
        var etiqueta = /^(\*\*|__)?\s*(fortaleza|riesgo|prioridad|strength|risk|priority)[^:]*:\s*(\*\*|__)?\s*/i;
        var partes = { fortaleza: [], riesgo: [], prioridad: [] }, actual = null;
        (texto || '').split(/\r?\n/).forEach(function (linea) {
            var conFormato = linea.replace(/^\s*(?:[-•>#]+|\*(?=\s)|\d+[.)])\s*/, '').trim();
            var plano = conFormato.replace(/\*\*|__/g, '').trim();
            if (!plano) return;
            var encontrada = null;
            Object.keys(claves).forEach(function (k) { if (!encontrada && claves[k].test(plano)) encontrada = k; });
            if (encontrada) {
                actual = encontrada;
                var resto = plano.indexOf(':') >= 0 ? conFormato.replace(etiqueta, '').trim() : '';
                if (resto) partes[actual].push(resto);
                return;
            }
            if (actual) partes[actual].push(conFormato);
        });
        if (!partes.fortaleza.length || !partes.riesgo.length || !partes.prioridad.length) return null;
        return { fortaleza: partes.fortaleza.join(' '), riesgo: partes.riesgo.join(' '), prioridad: partes.prioridad.join(' ') };
    }
    function textoConNegritas(t) {
        return escHtml(t).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/__(.+?)__/g, '<strong>$1</strong>').replace(/\*\*|__/g, '');
    }
    function pintarInsights(texto) {
        var t = _ind.t, secciones = separarInsights(texto);
        if (!secciones) {
            var md = (typeof window.bufinsMarkdown === 'function') ? window.bufinsMarkdown(texto) : escHtml(texto).replace(/\n/g, '<br>');
            $('#indInsightsBody').html('<div class="pyg-insights-body">' + md + '</div>');
            return;
        }
        // Clases de color de las tarjetas (compartidas con PYG): logro = verde, alerta = rojo, eficiencia = info.
        var tiles = [
            { cls: 'logro', icono: 'fa-shield-halved', titulo: t.insFortaleza, texto: secciones.fortaleza },
            { cls: 'alerta', icono: 'fa-triangle-exclamation', titulo: t.insRiesgo, texto: secciones.riesgo },
            { cls: 'eficiencia', icono: 'fa-bullseye', titulo: t.insPrioridad, texto: secciones.prioridad }
        ];
        $('#indInsightsBody').html('<div class="pyg2-ins-grid">' + tiles.map(function (x) {
            return '<div class="pyg2-ins-tile ' + x.cls + '"><div class="h"><span class="ic"><i class="fas ' + x.icono + '"></i></span><span class="t">' + escHtml(x.titulo) + '</span></div><p>' + textoConNegritas(x.texto) + '</p></div>';
        }).join('') + '</div>');
    }
