                pdf.splitTextToSize(nombreInd(i), wA - 10).slice(0, 2).forEach(function (ln, li) { pdf.text(ln, x + 5, y + 7 + li * 3.8); });
                fuente('bold', 14, colr); pdf.text(i.Valor === null ? textoSinValor(i) : fmtValor(i.Formato, i.Valor), x + 5, y + 18);
                fuente('bold', 7, colr); pdf.text(nombreNivel(i.Nivel) + (r.HayComparativo && i.Variacion !== null ? '  ' + CH_MIDDOT + '  ' + fmtVariacion(i.Formato, i.Variacion) : ''), x + 5, y + 23.5);
            });
            y += hA + 10;
        } else {
            fuente('italic', 8.5, C.texto2); pdf.text(T.atencionVacio, M, y + 4); y += 12;
        }

        // Insights (IA)
        tituloSeccion(P.insightsTitulo, y, _ind.insightsTexto ? $('#indInsightsMeta').text() : '');
        y += 4;
        var secciones = _ind.insightsTexto ? separarInsights(_ind.insightsTexto) : null;
        if (secciones) {
            var tiles = [
                { titulo: T.insFortaleza, texto: secciones.fortaleza, c: C.bueno },
                { titulo: T.insRiesgo, texto: secciones.riesgo, c: C.malo },
                { titulo: T.insPrioridad, texto: secciones.prioridad, c: C.morado }
            ];
            var gapT = 5, wT = (ANCHO - gapT * 2) / 3;
            fuente('normal', 8.8, C.texto2);
            var lineasT = tiles.map(function (x) { return pdf.splitTextToSize(limpiar(x.texto), wT - 9); });
            var hT = 14 + Math.max.apply(null, lineasT.map(function (l) { return l.length; })) * 4.2 + 3;
            if (y + hT > LIMITE_Y) nuevaPagina(P.resumen);
            tiles.forEach(function (x, i) {
                var xx = M + i * (wT + gapT);
                tarjetaPdf(xx, y, wT, hT);
                rgb('setFillColor', x.c); pdf.rect(xx + 2.5, y, wT - 5, 1.1, 'F');
                fuente('bold', 7.5, x.c); pdf.text(x.titulo.toUpperCase(), xx + 4.5, y + 8.3);
                fuente('normal', 8.8, C.texto2); pdf.text(lineasT[i], xx + 4.5, y + 14.5, { lineHeightFactor: 1.35 });
            });
            y += hT;
        } else if (_ind.insightsTexto) {
            fuente('normal', 8.8, C.texto2);
            var lineas = pdf.splitTextToSize(limpiar(_ind.insightsTexto.replace(/^[\s#>*\-•]+/gm, '')), ANCHO - 10), hTx = lineas.length * 4.2 + 8;
            if (y + hTx > LIMITE_Y) nuevaPagina(P.resumen);
