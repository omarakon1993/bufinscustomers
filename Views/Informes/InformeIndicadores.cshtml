        // ===== Página 2+: tabla de indicadores =====
        nuevaPagina(P.tablaTitulo);
        var cols = [
            { t: T.colIndicador, w: 62, a: 'left' }, { t: T.colValor, w: 26, a: 'right' }, { t: T.colComparativo, w: 26, a: 'right' },
            { t: T.colVariacion, w: 24, a: 'right' }, { t: T.colSemaforo, w: 24, a: 'left' }, { t: T.colReferencia, w: ANCHO - 162, a: 'left' }
        ];
        var hF = 6.4, hG = 8;
        function cabeceraTabla() {
            rgb('setFillColor', C.marca); pdf.rect(M, y, ANCHO, hG, 'F');
            fuente('bold', 7.2, C.blanco);
            var x = M;
            cols.forEach(function (c) { pdf.text(c.t.toUpperCase(), c.a === 'right' ? x + c.w - 2 : x + 2.5, y + 5.3, { align: c.a === 'right' ? 'right' : 'left' }); x += c.w; });
            y += hG;
        }
        cabeceraTabla();
        var lista = visibles(r), idx = 0;
        _ind.familiasOrden.forEach(function (fam) {
            var deFam = lista.filter(function (i) { return i.Familia === fam; });
            if (!deFam.length) return;
            if (y + hF * 2 > LIMITE_Y - 6) { nuevaPagina(P.tablaTitulo); cabeceraTabla(); }
            rgb('setFillColor', C.suave); pdf.rect(M, y, ANCHO, hF, 'F');
            fuente('bold', 7.2, C.morado); pdf.text((T.familias[fam] || fam).toUpperCase(), M + 2.5, y + 4.4);
            y += hF;
            deFam.forEach(function (i) {
                if (y + hF > LIMITE_Y - 6) { nuevaPagina(P.tablaTitulo); cabeceraTabla(); }
                rgb('setFillColor', idx++ % 2 ? C.zebra : C.blanco); pdf.rect(M, y, ANCHO, hF, 'F');
                var x = M, tv = i.Valor !== null && i.Valor !== undefined;
                var celdas = [
                    { t: nombreInd(i), f: 'bold', col: C.texto },
                    { t: tv ? fmtValor(i.Formato, i.Valor) : textoSinValor(i), f: 'bold', col: tv ? PDF_NIVEL[i.Nivel] : C.muted },
                    { t: r.HayComparativo ? fmtValor(i.Formato, i.ValorComp) : CH_MDASH, f: 'normal', col: C.muted },
                    { t: fmtVariacion(i.Formato, i.Variacion), f: 'bold', col: i.Favorable === true ? C.bueno : (i.Favorable === false ? C.malo : C.muted) },
                    { t: nombreNivel(i.Nivel), f: 'bold', col: PDF_NIVEL[i.Nivel] },
                    { t: rangosTexto(i, true), f: 'normal', col: C.muted, tam: 6 }
                ];
                celdas.forEach(function (c, k) {
                    var cw = cols[k].w, tam = c.tam || 7.4;
                    fuente(c.f, tam, c.col);
                    while (tam > 5 && ancho(c.t) > cw - 4) { tam -= 0.3; pdf.setFontSize(tam); }
                    var texto = ancho(c.t) > cw - 4 ? pdf.splitTextToSize(c.t, cw - 4)[0] : c.t;
                    if (k === 4) { rgb('setFillColor', PDF_NIVEL[i.Nivel]); pdf.circle(x + 3, y + 3.2, 1.2, 'F'); pdf.text(texto, x + 6, y + 4.4); }
                    else pdf.text(texto, cols[k].a === 'right' ? x + cw - 2 : x + 2.5, y + 4.4, { align: cols[k].a === 'right' ? 'right' : 'left' });
                    x += cw;
                });
                rgb('setDrawColor', C.lineaSuave); pdf.setLineWidth(0.15); pdf.line(M, y + hF, M + ANCHO, y + hF);
                y += hF;
            });
        });
        y += 5; fuente('italic', 7, C.muted); pdf.text(T.fichaAviso, M, y);

        // Pie de página en todas las páginas
        var totalPags = pdf.internal.getNumberOfPages();
        for (var p = 1; p <= totalPags; p++) {
            pdf.setPage(p);
            rgb('setDrawColor', C.linea); pdf.setLineWidth(0.3); pdf.line(M, H - 10, W - M, H - 10);
            fuente('normal', 7, C.muted);
            pdf.text(P.titulo + '  ' + CH_MIDDOT + '  ' + empresa + '  ' + CH_MIDDOT + '  ' + corte, M, H - 6);
            pdf.text(P.confidencial, W / 2, H - 6, { align: 'center' });
            fuente('bold', 7, C.texto2);
            pdf.text(P.paginaFmt.replace('{0}', p).replace('{1}', totalPags), W - M, H - 6, { align: 'right' });
        }

        pdf.__nombre = 'Indicadores_' + empresa.replace(/[^a-z0-9]+/gi, '_') + '_' + r.AnioHasta + ('0' + r.MesHasta).slice(-2) + '.pdf';
        return pdf;
    }

    $(document).ready(function () {
        $('#indEmpresa, #indEscenario, #indComparar, #indDetalle')
            .select2({ width: '100%', language: s2lang, dropdownAutoWidth: false, minimumResultsForSearch: 10 });

        $('#indEmpresa, #indEscenario').on('change', cargarMeses);
        // "Detalle" no requiere volver a consultar: solo filtra lo ya cargado.
        $('#indDetalle').on('change', function () { if (_ind.reporteActual) { pintarFamilias(_ind.reporteActual); pintarTabla(_ind.reporteActual); } });

        $('#indAtajos button').on('click', function () { aplicarPresetRango($(this).data('preset')); });
        $('#indKnobFrom').on('pointerdown', function (e) { e.stopPropagation(); iniciarArrastreSlider(e, 'from'); });
        $('#indKnobTo').on('pointerdown', function (e) { e.stopPropagation(); iniciarArrastreSlider(e, 'to'); });
        $('#indRangoTrack').on('pointerdown', function (e) { clicEnPista(e); });
        $('#indKnobFrom, #indKnobTo').on('keydown', function (e) { moverKnobConTeclado(e, this.id === 'indKnobFrom' ? 'from' : 'to'); });

        // Ficha y glosario
        $('#indResultado').on('click', '[data-ficha]', function () { abrirFicha($(this).data('ficha')); });
        $('#indBtnGlosario').on('click', abrirGlosario);
        $('#indFichaBody').on('click', '[data-gl]', function () { $(this).closest('.ind-gl-item').toggleClass('open'); });
        $('#indFichaCerrar').on('click', cerrarPanel);
        $('#indFichaOv').on('click', function (e) { if (e.target === this) cerrarPanel(); });
        $(document).on('keydown', function (e) { if (e.key === 'Escape' && $('#indFichaOv').hasClass('open')) cerrarPanel(); });

        DocVisor.init({ boton: '#indDocBtn', url: _ind.urls.documentacion });

        $('#btnConsultarInd').on('click', consultarReporte);
        $('#btnLimpiarInd').on('click', function () {
            $('#indComparar').val('cierreAnterior').trigger('change.select2');
            $('#indDetalle').val('todos').trigger('change.select2');
            if (_ind.esAdmin) elEmpresa.val('').trigger('change.select2');
            cargarMeses();
        });

        $('#btnGenerarInsightsInd').on('click', generarInsights);
        $('#btnIndPreguntar').on('click', preguntarInforme);
        $('#indPregunta').on('keydown', function (e) { if (e.which === 13) { e.preventDefault(); preguntarInforme(); } });

        // Botón Exportar estándar: Excel · PDF · Copiar como imagen · Enviar por correo
        var correo = ExportMenu.correo({
            url: _ind.urls.correo,
            token: function () { return _ind.token; },
            datos: datosExportacion,   // mismos filtros que el Excel: el servidor reconstruye el informe
            pdf: function () { var d = construirPdf(_ind.reporteActual); return d ? d.output('datauristring') : ''; },
            pills: function () { return [$('#indTituloEmpresa').text()].concat($('#indPanelResultado .pyg2-chip').map(function () { return $(this).text(); }).get()); },
            textos: EXP_T
        });
        ExportMenu.init('indExp', {
            acciones: { excel: exportarExcel, pdf: generarPdf, imagen: copiarImagen, correo: function () { if (_ind.reporteActual) correo.abrir(); } },
            textos: EXP_T
        });

        pintarRango();
        cargarMeses();
    });
</script>
}
