@using System.Web
@using System.Web.Script.Serialization
@using bufinscustomers.Models
@using bufinscustomers.Services
@{
    // Informe de indicadores con semáforo (dbo.ModeloPYG + dbo.ModeloBalance + dbo.ModeloFlujoCaja). Cada indicador tiene una ficha
    // con textos en los .resx (Ind_{Codigo}_Nombre/_Pregunta/_Que/_Formula/_Mejorar/_Regla); los rangos del semáforo salen del catálogo
    // del servidor (IndicadoresCatalogo) a través del reporte, así no se duplican aquí.
    var empresas = ViewBag.Empresas as List<Empresas>;
    var esAdmin = (bool)(ViewBag.EsAdmin ?? false);
    var culturaJs = System.Globalization.CultureInfo.CurrentUICulture.Name;
    // T = texto para HTML (Razor lo codifica); J = texto para JS (escapado). Ambos leen de App_GlobalResources/Strings(.en-US).resx.
    Func<string, string> T = k => (System.Web.HttpContext.GetGlobalResourceObject("Strings", k) as string) ?? k;
    Func<string, string> J = k => HttpUtility.JavaScriptStringEncode(T(k));
    ViewBag.Title = T("Ind_PageTitle");

    var jss = new JavaScriptSerializer();
    var fichas = IndicadoresCatalogo.Todos.ToDictionary(d => d.Codigo, d => new Dictionary<string, string>
    {
        { "n", T("Ind_" + d.Codigo + "_Nombre") }, { "p", T("Ind_" + d.Codigo + "_Pregunta") }, { "q", T("Ind_" + d.Codigo + "_Que") },
        { "f", T("Ind_" + d.Codigo + "_Formula") }, { "m", T("Ind_" + d.Codigo + "_Mejorar") }, { "r", T("Ind_" + d.Codigo + "_Regla") }
    });
    var familias = IndicadoresCatalogo.Familias.ToDictionary(f => f, f => T("Ind_Fam_" + f));
    var motivos = new[] { "sin_dato", "ltm_parcial", "divisor_cero", "ebitda_no_positivo", "sin_intereses", "sin_comparativo" }.ToDictionary(m => m, m => T("Ind_Motivo_" + m));
    var niveles = new[] { "verde", "amarillo", "naranja", "rojo", "gris" }.ToDictionary(n => n, n => T("Ind_Nivel_" + n));
}

<link href="~/Assets/css/bufins-components.css" rel="stylesheet" />
<link href="~/Assets/css/informe-linea-tiempo.css" rel="stylesheet" />
<link href="~/Assets/css/informe-pyg.css" rel="stylesheet" />
<link href="~/Assets/css/informe-tesoreria.css" rel="stylesheet" />
<link href="~/Assets/css/informe-indicadores.css" rel="stylesheet" />
<link href="~/Assets/css/doc-visor.css" rel="stylesheet" />
<link href="~/Assets/css/export-menu.css" rel="stylesheet" />
<link href="~/Assets/css/select2/select2.min.css" rel="stylesheet" />

<div class="container-fluid px-4">
<div class="lt-app">

    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas fa-tachometer-alt powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@T("Ind_PageTitle")</h1>
            @Html.Partial("_ModeloBufinsTag")
            <button type="button" class="header-tag-doc" id="indDocBtn" title="@T("Ind_DocumentacionTooltip")"><i class="fas fa-book"></i>@T("Common_DocumentacionTag")</button>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <div class="filter-card">
        <div class="lt-section-title"><span>@T("Common_FiltrosConsulta")</span></div>
        <div class="lt-grid-quever tes-grid-4">
            <div class="lt-field">
                <label class="lt-field-label" for="indEmpresa">@T("Common_LabelEmpresa")</label>
                <select id="indEmpresa" class="lt-field-select">
                    @if (esAdmin) { <option value="">@T("Common_Seleccione")</option> }
                    @if (empresas != null)
                    {
                        foreach (var e in empresas)
                        {
                            <option value="@e.Id">@e.Nombre</option>
                        }
                    }
                </select>
            </div>
            <div class="lt-field">
                <label class="lt-field-label" for="indEscenario">@T("Common_LabelEscenario")</label>
                <select id="indEscenario" class="lt-field-select">
                    @if (ViewBag.Escenarios != null)
                    {
                        foreach (var esc in ViewBag.Escenarios)
                        {
                            <option value="@esc.Id">@esc.Nombre</option>
                        }
                    }
                </select>
            </div>
            <div class="lt-field">
                <label class="lt-field-label" for="indComparar">@T("Ind_LabelComparar") <i class="fas fa-circle-info tes-info" tabindex="0" title="@T("Ind_CompararHint")" aria-label="@T("Ind_CompararHint")"></i></label>
                <select id="indComparar" class="lt-field-select">
                    <option value="cierreAnterior">@T("Ind_Comparar_cierreAnterior")</option>
                    <option value="mesAnterior">@T("Ind_Comparar_mesAnterior")</option>
                    <option value="mismoMesAnioAnterior">@T("Ind_Comparar_mismoMesAnioAnterior")</option>
                </select>
            </div>
            <div class="lt-field">
                <label class="lt-field-label" for="indDetalle">@T("Ind_LabelDetalle")</label>
                <select id="indDetalle" class="lt-field-select">
                    <option value="todos">@T("Ind_DetalleTodos")</option>
                    <option value="alertas">@T("Ind_DetalleAlertas")</option>
                </select>
            </div>
        </div>

        @* Rango: mismo control que PYG/Balance/Flujos (slider continuo + atajos compartidos). El extremo derecho es el mes de corte. *@
        <div class="lt-section-title mt"><span>@T("Ind_FilaCorte")</span></div>
        <div>
            <div class="rango-atajos" id="indAtajos">
                <div class="rango-atajos-grupo">
                    <button type="button" data-preset="todo">@T("Rango_Todo")</button>
                </div>
                <div class="rango-atajos-grupo">
                    <button type="button" data-preset="ytd">@T("Rango_AnioEnCurso")</button>
                    <button type="button" data-preset="6m">@T("Rango_Ultimos6Meses")</button>
                    <button type="button" data-preset="3m">@T("Rango_UltimoTrimestre")</button>
                    <button type="button" data-preset="mesAnterior">@T("Rango_MesAnterior")</button>
                    <button type="button" data-preset="mesActual">@T("Rango_MesActual")</button>
                </div>
            </div>
            <div class="lt-range-card">
                <div class="lt-range-head">
                    <span class="lbl"><span id="indRangoDesdeLbl">&mdash;</span><i class="fas fa-long-arrow-alt-right"></i><span id="indRangoHastaLbl">&mdash;</span></span>
                    <span class="lt-range-badge" id="indRangoBadge">&mdash;</span>
                </div>
                <div class="lt-range-track disabled" id="indRangoTrack">
                    <div class="bg"></div>
                    <div class="sel" id="indRangoSel"></div>
                    <div class="knob from" id="indKnobFrom" tabindex="0" role="slider" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" aria-label="@T("LineaTiempo_LabelRango")"></div>
                    <div class="knob to" id="indKnobTo" tabindex="0" role="slider" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" aria-label="@T("LineaTiempo_LabelRango")"></div>
                </div>
                <div class="lt-range-years" id="indRangoYears"></div>
            </div>
            <p class="lt-help">@T("Ind_RangoHint")</p>
            <p class="lt-help" id="indSinMeses" style="display:none;">@T("Ind_SinMesesDatos")</p>
        </div>

        <div class="btn-group-actions">
            <button type="button" id="btnConsultarInd" class="btn btn-modern-gradient" disabled>
                <i class="fas fa-arrow-right mr-1"></i>@T("LineaTiempo_BtnGenerar")
            </button>
            <button type="button" id="btnLimpiarInd" class="btn btn-modern-secondary">@T("Common_Limpiar")</button>
        </div>
    </div>

    <div id="indEstadoInicial" class="lt-card lt-empty">
        <div class="lt-empty-icon"><i class="fas fa-tachometer-alt"></i></div>
        <h4>@T("Ind_EstadoInicialTitulo")</h4>
        <p>@T("Ind_EstadoInicialDesc")</p>
    </div>

    <div id="indSinDatos" class="lt-card lt-empty" style="display:none;">
        <div class="lt-empty-icon"><i class="fas fa-inbox"></i></div>
        <h4>@T("Ind_SinDatosTitulo")</h4>
        <p id="indSinDatosDesc">@T("Ind_SinDatosDesc")</p>
    </div>

    <div id="indResultado" style="display:none;">

        @* 1. Encabezado: marca + empresa + chips de contexto + exportaciones *@
        <div class="lt-card" id="indPanelResultado">
            <div class="pyg2-letterhead">
                <span class="pyg2-brand"><span class="bm-text">@T("LineaTiempo_BrandMark")</span><span class="bm-sub">@T("Ind_Subtitulo")</span></span>
                <span class="fecha"><span>@T("Flujo_GeneradoEl")</span> <span id="indFechaGenerado">&mdash;</span></span>
            </div>
            <div class="pyg2-head">
                <div class="pyg2-head-l">
                    <h2 id="indTituloEmpresa">&mdash;</h2>
                    <div class="pyg2-chips">
                        <span class="pyg2-chip primary"><i class="fas fa-calendar"></i><span id="indChipCorte">&mdash;</span></span>
                        <span class="pyg2-chip" id="indChipEscenario">&mdash;</span>
                        <span class="pyg2-chip" id="indChipComparado">&mdash;</span>
                    </div>
                </div>
                <div class="pyg2-tools">
                    <button type="button" class="lt-tool-btn ind-btn-glosario" id="indBtnGlosario"><i class="fas fa-book-open"></i><span>@T("Ind_BtnGlosario")</span></button>
                    <span class="sep"></span>
                    @Html.Partial("_ExportMenu", new bufinscustomers.Models.ExportMenuVM
                    {
                        Id = "indExp",
                        ExcelDesc = T("Ind_Exp_ExcelDesc")
                    })
                </div>
            </div>
        </div>
        <form id="frmExportarExcelInd" method="post" action="@Url.Action("ExportarExcel", "InformeIndicadores")">
            @Html.AntiForgeryToken()
            <div id="indExpCampos"></div>@* los llena el botón Excel con los filtros del reporte consultado *@
        </form>

        @* 2. Resumen del semáforo + los que requieren atención *@
        <div class="ind-sem">
            <div class="ind-sem-card">
                <div class="ind-sem-title"><span>@T("Ind_ResumenTitulo")</span><span class="line"></span></div>
                <div class="ind-counts" id="indCounts"></div>
            </div>
            <div class="ind-sem-card">
                <div class="ind-sem-title"><span>@T("Ind_AtencionTitulo")</span><span class="line"></span></div>
                <div class="ind-atencion" id="indAtencion"></div>
            </div>
        </div>
        <p class="lt-help" id="indNotaParcial" style="display:none;"></p>
        <p class="lt-help" id="indNotaSinComp" style="display:none;"></p>
        <p class="lt-help" id="indNotaSinBalance" style="display:none;"></p>

        @* 3. Tarjetas por familia *@
        <div id="indFamilias"></div>

        @* 4. Tabla completa *@
        <div class="pyg2-table-card">
            <div class="pyg2-card-head" style="align-items:center">
                <div>
                    <div class="pyg2-card-title">@T("Ind_TablaTitulo")</div>
                    <div class="pyg2-card-sub" id="indInfoBadge">&mdash;</div>
                </div>
            </div>
            <div class="pyg2-table-wrap">
                <table class="pyg2-table ind-tabla" id="indTabla"><thead id="indTablaHead"></thead><tbody id="indTablaBody"></tbody></table>
            </div>
            <div class="pyg2-table-legend">
                <span><i class="dot" style="background:#16A34A"></i>@T("Ind_LeyendaFavorable")</span>
                <span><i class="dot" style="background:#DC2626"></i>@T("Ind_LeyendaDesfavorable")</span>
                <span><i class="fas fa-circle-info"></i>@T("Ind_NotaReferencia")</span>
            </div>
        </div>

        @* Insights gerenciales (IA): se ocultan si la empresa tiene la IA apagada *@
        @if (bufinscustomers.Helpers.IAModuloHelper.Visible())
        {
        <div class="pyg-insights-card" style="margin-top:16px">
            <div class="pyg-insights-head">
                <div>
                    <span class="pyg-insights-title"><i class="fas fa-wand-magic-sparkles"></i>@T("Ind_InsightsTitulo")</span>
                    <div class="pyg-insights-meta" id="indInsightsMeta">@T("Ind_InsightsSub")</div>
                </div>
                <button type="button" id="btnGenerarInsightsInd" class="pyg2-ins-btn"><i class="fas fa-wand-magic-sparkles"></i><span>@T("Ind_Generar")</span></button>
            </div>
            <div id="indInsightsBody"></div>
            <div id="indInsightsLoading" style="display:none;text-align:center;padding:14px 0;">
                @Html.Partial("_LoaderDots", "dark")
                <p style="margin-top:8px;font-size:12.5px;color:#8B85A0;">@T("Ind_Analizando")</p>
            </div>

            <div class="mt-3">
                <label for="indPregunta" class="mb-1" style="font-weight:700;"><i class="fas fa-comments mr-1"></i>@T("IAInforme_Titulo")</label>
                <div class="d-flex" style="gap:8px;flex-wrap:wrap;">
                    <input type="text" id="indPregunta" class="form-control" maxlength="@bufinscustomers.Helpers.IAModuloHelper.MaxCharsPregunta()" style="flex:1;min-width:240px;"
                           placeholder="@T("IAInforme_Placeholder")" />
                    <button type="button" id="btnIndPreguntar" class="pyg2-ins-btn"><i class="fas fa-paper-plane"></i><span>@T("IAInforme_Btn")</span></button>
                </div>
                <div id="indRespuesta" class="mt-2"></div>
            </div>
        </div>
        }
    </div>

</div>
</div>

@* Ficha / glosario: modal centrado, claro y compacto. Se llena desde JS con los textos del catálogo. *@
<div class="ind-ficha-ov" id="indFichaOv">
    <div class="ind-ficha" id="indFicha" role="dialog" aria-modal="true" aria-labelledby="indFichaTitulo">
        <div class="ind-ficha-rule"></div>
        <div class="ind-ficha-head">
            <h5 id="indFichaTitulo"><i class="fas fa-book-open"></i><span class="tt">@T("Ind_Ficha_Titulo")</span><span class="ind-ficha-fam" id="indFichaFam"></span></h5>
            <button type="button" class="ind-ficha-x" id="indFichaCerrar" title="@T("Common_Cerrar")" aria-label="@T("Common_Cerrar")"><i class="fas fa-times"></i></button>
        </div>
        <div class="ind-ficha-body" id="indFichaBody"></div>
    </div>
</div>

<div id="overlayConsultandoInd" class="overlay-cargando" style="display:none;">
    <div class="overlay-cargando-card">
        @Html.Partial("_LoaderDots", "aqua")
        <h5 class="overlay-cargando-title">@T("Ind_JS_Consultando")</h5>
    </div>
</div>

@Html.Partial("_ExportCorreoModal", new bufinscustomers.Models.ExportCorreoVM())
@Html.Partial("_DocumentacionVisor", T("Ind_Doc_ModalTitulo"))

@section scripts {
<script src="~/Assets/js/select2/select2.min.js"></script>
<script src="~/Assets/js/jspdf.umd.min.js"></script>
<script src="~/Assets/js/html2canvas.min.js"></script>
<script src="~/Assets/js/export-menu.js"></script>
<script src="~/Assets/js/doc-visor.js"></script>
<script src="~/Assets/js/bufins-markdown.js"></script>
<script src="~/Assets/js/rango-atajos.js"></script>

<script>
    // Textos del botón Exportar estándar (ExportMenu) — ver CLAUDE.md, "Botón Exportar desplegable".
    var EXP_T = {
        generando: '@Html.Raw(J("Common_Exp_Generando"))',
        errorGenerar: '@Html.Raw(J("Common_Exp_ErrorGenerar"))',
        listo: '@Html.Raw(J("Common_Exp_Listo"))',
        imagenCopiada: '@Html.Raw(J("Common_Exp_ImagenCopiada"))',
        imagenDescargada: '@Html.Raw(J("Common_Exp_ImagenDescargada"))',
        valDestino: '@Html.Raw(J("RevisarCargue_Correo_ValDestino"))',
        valMaximo: '@Html.Raw(J("RevisarCargue_Correo_ValMaximo"))',
        enviando: '@Html.Raw(J("RevisarCargue_Correo_Enviando"))',
        error: '@Html.Raw(J("Common_ExpCorreo_Error"))',
        exitoTitulo: '@Html.Raw(J("Modelo_Correo_ExitoTitulo"))',
        aceptar: '@Html.Raw(J("Common_Aceptar"))'
    };

    var _ind = {
        urls: {
            meses: '@Url.Action("ObtenerMeses", "InformeIndicadores")',
            reporte: '@Url.Action("ConsultarReporte", "InformeIndicadores")',
            insights: '@Url.Action("GenerarInsightsIA", "InformeIndicadores")',
            preguntar: '@Url.Action("PreguntarInforme", "InformeIndicadores")',
            correo: '@Url.Action("EnviarPorCorreo", "InformeIndicadores")',
            documentacion: '@Url.Action("Ver", "Documentacion", new { clave = "indicadores" })'
        },
        token: $('input[name="__RequestVerificationToken"]').first().val(),
        cultura: '@Html.Raw(HttpUtility.JavaScriptStringEncode(culturaJs))',
        esAdmin: @Html.Raw(esAdmin.ToString().ToLowerInvariant()),
        mesesNombres: [
            '@Html.Raw(J("Common_Mes1"))', '@Html.Raw(J("Common_Mes2"))', '@Html.Raw(J("Common_Mes3"))', '@Html.Raw(J("Common_Mes4"))',
            '@Html.Raw(J("Common_Mes5"))', '@Html.Raw(J("Common_Mes6"))', '@Html.Raw(J("Common_Mes7"))', '@Html.Raw(J("Common_Mes8"))',
            '@Html.Raw(J("Common_Mes9"))', '@Html.Raw(J("Common_Mes10"))', '@Html.Raw(J("Common_Mes11"))', '@Html.Raw(J("Common_Mes12"))'
        ],
        familiasOrden: @Html.Raw(jss.Serialize(IndicadoresCatalogo.Familias)),
        t: {
            fichas: @Html.Raw(jss.Serialize(fichas)),
            familias: @Html.Raw(jss.Serialize(familias)),
            motivos: @Html.Raw(jss.Serialize(motivos)),
            niveles: @Html.Raw(jss.Serialize(niveles)),
            dias: '@Html.Raw(J("Ind_UnidadDias"))',
            sinValor: '@Html.Raw(J("Ind_SinValor"))',
            parcialFmt: '@Html.Raw(J("Ind_ParcialFmt"))',
            motivoParcialFmt: '@Html.Raw(J("Ind_MotivoParcialFmt"))',
            vsFmt: '@Html.Raw(J("Ind_VsFmt"))',
            chipCorteFmt: '@Html.Raw(J("Ind_ChipCorteFmt"))',
            chipComparadoFmt: '@Html.Raw(J("Ind_ChipComparadoFmt"))',
            chipSinComparar: '@Html.Raw(J("Ind_ChipSinComparar"))',
            atencionVacio: '@Html.Raw(J("Ind_AtencionVacio"))',
            notaParcialFmt: '@Html.Raw(J("Ind_NotaParcialFmt"))',
            notaSinComparativo: '@Html.Raw(J("Ind_NotaSinComparativo"))',
            notaSinBalance: '@Html.Raw(J("Ind_NotaSinBalance"))',
            countsAria: '@Html.Raw(J("Ind_CountsAria"))',
            infoBadgeFmt: '@Html.Raw(J("Ind_InfoBadgeFmt"))',
            colFamilia: '@Html.Raw(J("Ind_ColFamilia"))',
            colIndicador: '@Html.Raw(J("Ind_ColIndicador"))',
            colValor: '@Html.Raw(J("Ind_ColValor"))',
            colComparativo: '@Html.Raw(J("Ind_ColComparativo"))',
            colVariacion: '@Html.Raw(J("Ind_ColVariacion"))',
            colSemaforo: '@Html.Raw(J("Ind_ColSemaforo"))',
            colReferencia: '@Html.Raw(J("Ind_ColReferencia"))',
            rangoPositivo: '@Html.Raw(J("Ind_RangoPositivo"))',
            rangoVerde: '@Html.Raw(J("Ind_Rango_Verde"))',
            rangoAmarillo: '@Html.Raw(J("Ind_Rango_Amarillo"))',
            rangoNaranja: '@Html.Raw(J("Ind_Rango_Naranja"))',
            rangoRojo: '@Html.Raw(J("Ind_Rango_Rojo"))',
            fichaPregunta: '@Html.Raw(J("Ind_Ficha_Pregunta"))',
            fichaQue: '@Html.Raw(J("Ind_Ficha_Que"))',
            fichaFormula: '@Html.Raw(J("Ind_Ficha_Formula"))',
            fichaRangos: '@Html.Raw(J("Ind_Ficha_Rangos"))',
            fichaMejorar: '@Html.Raw(J("Ind_Ficha_Mejorar"))',
            fichaRegla: '@Html.Raw(J("Ind_Ficha_Regla"))',
            fichaAhora: '@Html.Raw(J("Ind_Ficha_Ahora"))',
            fichaComparado: '@Html.Raw(J("Ind_Ficha_Comparado"))',
            fichaAviso: '@Html.Raw(J("Ind_NotaReferencia"))',
            fichaTitulo: '@Html.Raw(J("Ind_Ficha_Titulo"))',
            glosarioTitulo: '@Html.Raw(J("Ind_Glosario_Titulo"))',
            favorable: '@Html.Raw(J("Ind_LeyendaFavorable"))',
            desfavorable: '@Html.Raw(J("Ind_LeyendaDesfavorable"))',
            verFicha: '@Html.Raw(J("Ind_VerFicha"))',
            insightsVacio: '@Html.Raw(J("Ind_InsightsVacio"))',
            insightsSub: '@Html.Raw(J("Ind_InsightsSub"))',
            insightsMetaFmt: '@Html.Raw(J("Ind_InsightsMetaFmt"))',
            insightsSinGenerar: '@Html.Raw(J("Ind_InsightsSinGenerar"))',
            generar: '@Html.Raw(J("Ind_Generar"))',
            regenerar: '@Html.Raw(J("Ind_Regenerar"))',
            insFortaleza: '@Html.Raw(J("Ind_InsFortaleza"))',
            insRiesgo: '@Html.Raw(J("Ind_InsRiesgo"))',
            insPrioridad: '@Html.Raw(J("Ind_InsPrioridad"))',
            errorServidor: '@Html.Raw(J("Ind_ErrorServidor"))',
            badgeMes: '@Html.Raw(J("LineaTiempo_BadgeMes"))',
            badgeMeses: '@Html.Raw(J("LineaTiempo_BadgeMeses"))',
            rangoTooltipFmt: '@Html.Raw(J("Rango_TooltipFmt"))',
            rangoSinDatosFmt: '@Html.Raw(J("Rango_SinDatosFmt"))',
            pdf: {
                marca: '@Html.Raw(J("LineaTiempo_BrandMark"))',
                titulo: '@Html.Raw(J("Ind_PageTitle"))',
                subtitulo: '@Html.Raw(J("Ind_Subtitulo"))',
                generadoEl: '@Html.Raw(J("Flujo_GeneradoEl"))',
                confidencial: '@Html.Raw(J("Flujo_Pdf_Confidencial"))',
                paginaFmt: '@Html.Raw(J("Flujo_Pdf_PaginaFmt"))',
                sinInsights: '@Html.Raw(J("Ind_Pdf_SinInsights"))',
                resumen: '@Html.Raw(J("Ind_ResumenTitulo"))',
                atencion: '@Html.Raw(J("Ind_AtencionTitulo"))',
                insightsTitulo: '@Html.Raw(J("Ind_InsightsTitulo"))',
                tablaTitulo: '@Html.Raw(J("Ind_TablaTitulo"))'
            }
        },
        reporteActual: null,
        filtrosConsultados: null,
        insightsTexto: null,
        mesesCache: [],
        rango: [],
        iDesde: 0,
        iHasta: 0,
        hoy: { anio: @DateTime.Now.Year, mes: @DateTime.Now.Month }   // fecha de hoy del SERVIDOR (atajos)
    };
    _ind.mesesCache = _ind.mesesNombres.map(function (nombre, idx) {
        return { mes: idx + 1, nombre: nombre, abrev: nombre.substring(0, 3) };
    });

    var COLOR_NIVEL = { verde: '#16A34A', amarillo: '#EAB308', naranja: '#F97316', rojo: '#DC2626', gris: '#94A3B8' };
    var elEmpresa = $('#indEmpresa'), elEscenario = $('#indEscenario');
