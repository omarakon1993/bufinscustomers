    // Mini-tendencia (SVG): valor del indicador en cada mes del rango; el último punto lleva el color del semáforo.
    function sparkline(i) {
        var pts = (i.Tendencia || []).filter(function (p) { return p.Valor !== null && p.Valor !== undefined; });
        if (pts.length < 2) return '';
        var vals = pts.map(function (p) { return p.Valor; }), mn = Math.min.apply(null, vals), mx = Math.max.apply(null, vals), rg = (mx - mn) || 1;
        var W = 100, H = 28, pad = 3;
        var xy = vals.map(function (v, k) { return [pad + k * (W - pad * 2) / (vals.length - 1), H - pad - (v - mn) / rg * (H - pad * 2)]; });
        var d = xy.map(function (p) { return p[0].toFixed(1) + ',' + p[1].toFixed(1); }).join(' ');
        var ult = xy[xy.length - 1];
