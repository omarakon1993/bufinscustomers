        }
        function encabezadoPagina(seccion) {
            degradado(0, 0, W, 2.4);
            fuente('bold', 10, C.texto); pdf.text(empresa, M, 11);
            fuente('normal', 8, C.muted); pdf.text(P.titulo + '  ' + CH_MIDDOT + '  ' + corte, W - M, 11, { align: 'right' });
            if (seccion) { fuente('bold', 13, C.texto); pdf.text(seccion, M, 21); }
            y = seccion ? 29 : 18;
        }
        function nuevaPagina(seccion) { pdf.addPage(); encabezadoPagina(seccion); }

        // ===== Página 1: resumen =====
        degradado(0, 0, W, 34);
        fuente('bold', 10, C.blanco); pdf.text(P.marca, M, 10);
        var wMarca = ancho(P.marca);
        fuente('normal', 8.5, C.blanco); pdf.text(CH_MIDDOT + '  ' + P.subtitulo, M + wMarca + 2.5, 10);
        fuente('bold', 19, C.blanco); pdf.text(empresa, M, 22);
        fuente('normal', 9.5, C.blanco); pdf.text(P.titulo, M, 29);
        fuente('normal', 8, C.blanco); pdf.text(P.generadoEl + ' ' + ($('#indFechaGenerado').text() || ''), W - M, 10, { align: 'right' });
        fuente('bold', 8, C.blanco); pdf.text(P.confidencial.toUpperCase(), W - M, 29, { align: 'right' });

        y = 43;
        var chips = [{ t: $('#indChipCorte').text(), fg: C.morado, bg: C.totalBg, b: true }, { t: $('#indChipEscenario').text() }, { t: $('#indChipComparado').text() }];
        var xc = M;
        chips.forEach(function (c) {
            if (!c.t) return;
            if (xc + ancho(c.t) + 5 > W - M) { xc = M; y += 7; }
            xc += pildora(c.t, xc, y, c.fg || C.texto2, c.bg || C.suave, !!c.b) + 3;
        });

        // Semáforo: cinco contadores
        y += 10;
        tituloSeccion(P.resumen, y);
        y += 4;
        var cnt = [['verde', r.TotalVerde], ['amarillo', r.TotalAmarillo], ['naranja', r.TotalNaranja], ['rojo', r.TotalRojo], ['gris', r.TotalGris]];
        var gapC = 4, wC = (ANCHO - gapC * 4) / 5, hC = 20;
        cnt.forEach(function (c, i) {
            var x = M + i * (wC + gapC);
            rgb('setFillColor', PDF_NIVEL_BG[c[0]]); rgb('setDrawColor', C.linea); pdf.setLineWidth(0.3);
            pdf.roundedRect(x, y, wC, hC, 2.5, 2.5, 'FD');
            fuente('bold', 18, PDF_NIVEL[c[0]]); pdf.text(String(c[1]), x + wC / 2, y + 10.5, { align: 'center' });
            fuente('bold', 7.5, C.texto2); pdf.text(nombreNivel(c[0]).toUpperCase(), x + wC / 2, y + 16, { align: 'center' });
        });
        y += hC + 10;

        // Requieren atención
        var porCod = {}; (r.Indicadores || []).forEach(function (i) { porCod[i.Codigo] = i; });
        var aten = (r.Atencion || []).map(function (c) { return porCod[c]; }).filter(Boolean);
        tituloSeccion(P.atencion, y);
        y += 4;
        if (aten.length) {
            var gapA = 5, wA = (ANCHO - gapA * (aten.length - 1)) / aten.length, hA = 27;
            aten.forEach(function (i, k) {
                var x = M + k * (wA + gapA), colr = PDF_NIVEL[i.Nivel];
                tarjetaPdf(x, y, wA, hA);
                rgb('setFillColor', colr); pdf.rect(x, y + 4, 1.1, hA - 8, 'F');
