@model IEnumerable<bufinscustomers.Models.AuditoriaCargues>
@using bufinscustomers.Helpers
@using bufinscustomers.Models
@using System.Linq
@using System.Web.Mvc
@using Newtonsoft.Json

@{
    ViewBag.Title = Resources.Strings.Audit_PageTitle;
    Layout = "~/Views/Shared/_LayoutFragment.cshtml";   // siempre embebida en «Historial de cargues» (HistorialCargues.cshtml)
    var esSuperAdmin = UsuarioSesionHelper.EsSuperAdmin();

    var lista = Model.OrderByDescending(x => x.FechaCargue).ToList();
    var nomEsc = EscenarioCacheHelper.ObtenerEscenariosCacheados().ToDictionary(e => e.Id, e => e.Nombre);

    var empresasDist = lista.GroupBy(x => x.IdEmpresa).Select(g => new { Id = g.Key, Nombre = g.First().NombreEmpresa })
                            .OrderBy(x => x.Nombre).ToList();
    var usuariosDist = lista.GroupBy(x => x.IdUsuario).Select(g => new { Id = g.Key, Nombre = g.First().Usuario })
                            .OrderBy(x => x.Nombre).ToList();
    var escDist = lista.Where(x => x.IdEscenario.HasValue).Select(x => x.IdEscenario.Value).Distinct().OrderBy(x => x).ToList();
    bool verEmpresa = esSuperAdmin || empresasDist.Count > 1;
    bool verEscenario = escDist.Count > 0;

    // Panel de filtros UNIFORME (mismo orden en las 4 pestañas): Empresa · Usuario · campos propios (Escenario).
    var vm = new AudFiltrosVM { PlaceholderBusqueda = Resources.Strings.Ax_BuscarCarguesPlaceholder, PeriodoDefecto = "30" };
    if (verEmpresa)
    {
        vm.Campos.Add(new AudCampo
        {
            Id = "fEmpresa", Etiqueta = Resources.Strings.Audit_ThEmpresa, Icono = "fa-building",
            TextoTodos = Resources.Strings.Audit_TodasEmpresas,
            Opciones = empresasDist.Select(x => new SelectListItem { Value = x.Id.ToString(), Text = x.Nombre }).ToList()
        });
    }
    vm.Campos.Add(new AudCampo
    {
        Id = "fUsuario", Etiqueta = Resources.Strings.Audit_ThUsuario, Icono = "fa-user",
        TextoTodos = Resources.Strings.Audit_TodosUsuarios,
        Opciones = usuariosDist.Select(x => new SelectListItem { Value = x.Id.ToString(), Text = x.Nombre }).ToList()
    });
    if (verEscenario)
    {
        vm.Campos.Add(new AudCampo
        {
            Id = "fEscenario", Propio = true, Etiqueta = Resources.Strings.Ax_Escenario, Icono = "fa-layer-group",
            TextoTodos = Resources.Strings.Ax_TodosEscenarios,
            Opciones = escDist.Select(id => new SelectListItem { Value = id.ToString(), Text = nomEsc.ContainsKey(id) ? nomEsc[id] : "#" + id }).ToList()
        });
    }
}

<div class="container-fluid px-4">
    <!-- Mensajes de exito/error -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle mr-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle mr-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div id="axKpis" class="ax-kpis" hidden></div>

    @Html.Partial("_AudFiltros", vm)

    @Html.AntiForgeryToken()

    <div id="axInicial" class="no-data-message">
        <i class="fas fa-clipboard-list"></i>
        <h4>@Resources.Strings.Ax_EstadoInicialTit</h4>
        <p>@Resources.Strings.Ax_EstadoInicialDesc</p>
    </div>

    <!-- Tabla de resultados -->
    <div id="resultadosContainer" style="display:none;">
        <div class="table-container">
            <div class="table-header">
                <h5><i class="fas fa-list mr-2"></i>@Resources.Strings.Common_Resultados</h5>
                <div class="d-flex align-items-center" style="gap:.6rem;flex-wrap:wrap;">
                    <span id="totalRegistros" class="info-badge">0 @Resources.Strings.Audit_TotalCargues</span>
                    <span id="paginaInfoCargues" class="ax-info"></span>
                </div>
                <div class="ax-toolbar">
                    <button type="button" id="btnExportar" class="btn btn-modern-excel"><i class="fas fa-file-excel mr-1"></i>@Resources.Strings.Audit_BtnExportar</button>
                    <button type="button" id="btnImprimir" class="btn btn-modern-secondary"><i class="fas fa-print mr-1"></i>@Resources.Strings.Audit_BtnImprimir</button>
                </div>
            </div>
            <div class="table-wrapper">
                <table id="auditoriaTable" class="data-table">
                    <thead>
                        <tr>
                            <th>@Resources.Strings.Audit_ThFecha</th>
                            @if (verEmpresa) { <th>@Resources.Strings.Audit_ThEmpresa</th> }
                            <th>@Resources.Strings.Audit_ThUsuario</th>
                            <th>@Resources.Strings.Audit_ThArchivo</th>
                            @if (verEscenario) { <th>@Resources.Strings.Ax_Escenario</th> }
                            <th>@Resources.Strings.Audit_Det_ThDetalle</th>
                        </tr>
                    </thead>
                    <tbody id="tbody"></tbody>
                </table>
            </div>
            <div id="paginacionCargues" class="pagination-controls"></div>
        </div>
    </div>

    <div id="noDataMessage" class="no-data-message" style="display:none">
        <i class="fas fa-inbox"></i>
        <h4>@Resources.Strings.Audit_NoData</h4>
        <p>
            @if (esSuperAdmin)
            {
                @Resources.Strings.Audit_NoDataAdmin
            }
            else
            {
                @Resources.Strings.Audit_NoDataUser
            }
        </p>
    </div>
</div>

@section scripts {
<script src="~/Assets/js/auditoria-shared.js"></script>
<script>
$(function () {
    var PAGE_SIZE = 25;
    var VER_EMPRESA = @(verEmpresa ? "true" : "false");
    var VER_ESC = @(verEscenario ? "true" : "false");
    var _filtradas = [];

    var S = {
        total:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_TotalCargues))',
        kCargues:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Ax_K_Cargues))',
        kUsuarios: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Ax_K_Usuarios))',
        kEmpresas: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Ax_K_Empresas))',
        kUltimo:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Ax_K_UltimoCargue))',
        exportOk:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_ExportSuccess))',
        errTit:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Error))',
        error:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_JS_Error))',
        detVer:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Det_BtnVer))',
        detTit:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Det_Titulo))',
        detTabla:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Det_ThTabla))',
        detAntes:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Det_ThAntes))',
        detNuevas: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Det_ThNuevas))',
        detNota:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Det_ThNota))',
        detTotal:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Det_Total))',
        detSin:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Det_SinDetalle))',
        detArch:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Det_ArchivoOriginal))',
        detSinArch:'@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Det_ArchivoNoGuardado))',
        detDesc:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Det_Descargar))',
        detSnap:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Det_Snapshot))',
        detCerrar: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Cerrar))',
        detDif:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Det_ThDif))',
        detStatAntes: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Det_StatAntes))',
        detStatNuevas: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Det_StatNuevas))',
        detStatDif: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Det_StatDif))'
    };
    var URL_DETALLE = '@Url.Action("Detalle", "AuditoriaCargues")';
    var URL_DESCARGA = '@Url.Action("DescargarArchivo", "AuditoriaCargues")';

    // Detalle de un cargue: por tabla, filas que había (y se reemplazaron) vs. filas que quedaron, y el Excel original.
    function verDetalle(id) {
        $.getJSON(URL_DETALLE, { id: id }).done(function (r) {
            if (!r || !r.success) { Swal.fire({ icon: 'error', title: S.errTit, text: (r && r.message) || S.error }); return; }

            function chip(icono, texto) {
                return $('<span class="ax-det-chip">').append($('<i>').addClass('fas ' + icono), document.createTextNode(texto));
            }
            function fmtDif(n) { return (n > 0 ? '+' : '') + AudKit.num(n); }
            function claseDif(n) { return n < 0 ? 'neg' : (n > 0 ? 'pos' : ''); }

            var $w = $('<div class="ax-det">');
            $w.append($('<div class="ax-det-chips">').append(
                chip('fa-building', r.empresa), chip('fa-calendar-alt', r.fecha), chip('fa-user', r.usuario), chip('fa-file-excel', r.archivoCargue)));

            var filas = r.filas || [];
            var sa = 0, sn = 0;
            filas.forEach(function (f) { sa += f.antes; sn += f.nuevas; });
            var dif = sn - sa;

            if (!filas.length) {
                $w.append($('<div class="ax-det-info">').append($('<i class="fas fa-info-circle">'), $('<span>').text(S.detSin)));
            } else {
                $w.append($('<div class="ax-det-stats">').append(
                    $('<div class="ax-det-stat">').append($('<b>').text(AudKit.num(sa)), $('<span>').text(S.detStatAntes)),
                    $('<div class="ax-det-stat">').append($('<b>').text(AudKit.num(sn)), $('<span>').text(S.detStatNuevas)),
                    $('<div class="ax-det-stat ' + claseDif(dif) + '">').append($('<b>').text(fmtDif(dif)), $('<span>').text(S.detStatDif))));

                var $t = $('<table class="ax-det-tabla">');
                $t.append($('<thead>').append($('<tr>').append(
                    $('<th>').text(S.detTabla), $('<th class="num">').text(S.detAntes), $('<th class="num">').text(S.detNuevas),
                    $('<th class="num">').text(S.detDif), $('<th>').text(S.detNota))));
                var $tb2 = $('<tbody>');
                filas.forEach(function (f) {
                    var d = f.nuevas - f.antes;
                    $tb2.append($('<tr>').append(
                        $('<td>').text((f.hoja ? f.hoja + ' → ' : '') + f.tabla),
                        $('<td class="num">').text(AudKit.num(f.antes)),
                        $('<td class="num">').text(AudKit.num(f.nuevas)),
                        $('<td class="num ' + claseDif(d) + '">').text(fmtDif(d)),
                        $('<td class="nota">').text(f.nota || '')));
                });
                $t.append($tb2).append($('<tfoot>').append($('<tr>').append(
                    $('<td>').text(S.detTotal), $('<td class="num">').text(AudKit.num(sa)), $('<td class="num">').text(AudKit.num(sn)),
                    $('<td class="num ' + claseDif(dif) + '">').text(fmtDif(dif)), $('<td>'))));
                $w.append($('<div class="ax-det-tablawrap">').append($t));
            }

            if (r.snapshot)
                $w.append($('<div class="ax-det-info">').append($('<i class="fas fa-life-ring">'), $('<span>').text(S.detSnap.replace('{0}', r.snapshot))));

            var $a = $('<div class="ax-det-arch">');
            if (r.archivo) {
                $a.append($('<div class="ax-det-arch-nombre">').append(
                    $('<i class="fas fa-file-excel">'),
                    $('<div>').append($('<strong>').text(r.archivo.nombre),
                        $('<small>').text(Math.max(1, Math.round(r.archivo.tamano / 1024)) + ' KB · ' + r.archivo.fecha))));
                if (r.puedeDescargar)
                    $a.append($('<a class="btn btn-sm btn-modern-gradient">').attr('href', URL_DESCARGA + '?id=' + encodeURIComponent(r.archivo.id))
                        .append('<i class="fas fa-download mr-1"></i>', document.createTextNode(S.detDesc)));
            } else {
                $a.addClass('vacio').append($('<span>').text(S.detArch + ': ' + S.detSinArch));
            }
            $w.append($a);

            Swal.fire({
                title: S.detTit, html: $w.prop('outerHTML'), width: 840, showCloseButton: true,
                confirmButtonText: S.detCerrar, customClass: { popup: 'swal-det' }
            });
        }).fail(function () {
            Swal.fire({ icon: 'error', title: S.errTit, text: S.error });
        });
    }

    function valores() {
        return {
            empresa: $('#fEmpresa').val() || '',
            usuario: $('#fUsuario').val() || '',
            esc:     $('#fEscenario').val() || '',
            texto:   $.trim($('#fTexto').val()),
            rango:   AudKit.periodo.rango()
        };
    }

    function distintos(campo) {
        var m = {};
        _filtradas.forEach(function (r) { m[r[campo]] = 1; });
        return Object.keys(m).length;
    }

    function pintarKpis() {
        AudKit.kpis.render($('#axKpis'), [
            { label: S.kCargues,  valor: AudKit.num(_filtradas.length) },
            { label: S.kUsuarios, valor: AudKit.num(distintos('IdUsuario')) },
            { label: S.kEmpresas, valor: AudKit.num(distintos('IdEmpresa')) },
            { label: S.kUltimo,   valor: _filtradas.length ? _filtradas[0].Fecha : '—', texto: true }
        ]);
    }

    function renderPagina(pagina) {
        var total = _filtradas.length;
        $('#totalRegistros').text(AudKit.num(total) + ' ' + S.total);

        if (total === 0) {
            $('#axInicial').hide();
            $('#resultadosContainer').hide();
            $('#noDataMessage').show();
            $('#paginacionCargues').empty();
            $('#paginaInfoCargues').text('');
            return;
        }
        $('#noDataMessage').hide();
        $('#axInicial').hide();
        $('#resultadosContainer').show();

        var totalPags = Math.max(1, Math.ceil(total / PAGE_SIZE));
        pagina = Math.min(Math.max(1, pagina), totalPags);
        var ini = (pagina - 1) * PAGE_SIZE;

        var $tb = $('#tbody').empty();
        _filtradas.slice(ini, ini + PAGE_SIZE).forEach(function (r) {
            var p = r.Fecha.split(' ');
            var $tr = $('<tr>');
            $tr.append($('<td>').append($('<strong>').text(p[0]), $('<br>'), $('<small class="text-muted">').text(p[1])));
            if (VER_EMPRESA) $tr.append($('<td>').text(r.Empresa || ''));
            $tr.append($('<td>').text(r.Usuario || ''));
            $tr.append($('<td>').text(r.Archivo || ''));
            if (VER_ESC) $tr.append($('<td>').append(r.Escenario ? $('<span class="cg-pill cg-pill-esc">').append('<i class="fas fa-layer-group"></i>', document.createTextNode(r.Escenario)) : '—'));
            $tr.append($('<td>').append(
                $('<button type="button" class="cg-btn">')
                    .append('<i class="fas fa-search-plus"></i>', document.createTextNode(S.detVer))
                    .on('click', function () { verDetalle(r.Id); })));
            $tb.append($tr);
        });

        $('#paginaInfoCargues').text(AudKit.pager.info(pagina, PAGE_SIZE, total));
        AudKit.pager.render($('#paginacionCargues'), pagina, totalPags, renderPagina);
    }

    // Nada se carga ni se muestra hasta pulsar «Consultar»: los datos se piden al servidor con los filtros elegidos.
    function consultar() {
        var v = valores();
        AudKit.filtros.chips(consultar);
        $.getJSON('@Url.Action("ObtenerCargues", "AuditoriaCargues")', {
            idEmpresa: v.empresa, idUsuario: v.usuario, escenario: v.esc, texto: v.texto,
            fechaDesde: v.rango.desde, fechaHasta: v.rango.hasta
        }).done(function (r) {
            if (!r || !r.success) { Swal.fire({ icon: 'error', title: S.errTit, text: S.error }); return; }
            _filtradas = r.items || [];
            pintarKpis();
            renderPagina(1);
        }).fail(function () {
            Swal.fire({ icon: 'error', title: S.errTit, text: S.error });
        });
    }

    function estadoInicial() {
        _filtradas = [];
        $('#tbody').empty();
        $('#paginacionCargues').empty();
        $('#paginaInfoCargues').text('');
        $('#resultadosContainer').hide();
        $('#noDataMessage').hide();
        AudKit.kpis.render($('#axKpis'), []);
        AudKit.chips.render($('#axChips'), []);
        $('#axInicial').show();
    }

    AudKit.periodo.init();
    AudKit.masFiltros();
    AudKit.enter(consultar);

    $('#btnConsultar').on('click', consultar);
    $('#btnLimpiar').on('click', function () {
        AudKit.filtros.limpiar();
        estadoInicial();
    });
    $('#btnImprimir').on('click', function () { AudKit.imprimir('#resultadosContainer .table-container', document.title); });

    // Exportar: mismos filtros que la pantalla
    $('#btnExportar').on('click', function () {
        var v = valores();
        var form = $('<form>', { method: 'POST', action: '@Url.Action("ExportarAuditoriaExcel", "AuditoriaCargues")', style: 'display:none' });
        form.append($('<input>', { type: 'hidden', name: 'idEmpresa', value: v.empresa }));
        form.append($('<input>', { type: 'hidden', name: 'idUsuario', value: v.usuario }));
        form.append($('<input>', { type: 'hidden', name: 'escenario', value: v.esc }));
        form.append($('<input>', { type: 'hidden', name: 'texto', value: v.texto }));
        form.append($('<input>', { type: 'hidden', name: 'fechaDesde', value: v.rango.desde }));
        form.append($('<input>', { type: 'hidden', name: 'fechaHasta', value: v.rango.hasta }));
        var token = $('input[name="__RequestVerificationToken"]').val();
        if (token) form.append($('<input>', { type: 'hidden', name: '__RequestVerificationToken', value: token }));
        $('body').append(form);
        form.submit();
        form.remove();

        Swal.fire({
            toast: true, position: window.innerWidth <= 768 ? 'top' : 'top-end', icon: 'success',
            title: S.exportOk, showConfirmButton: false, timer: 3000, timerProgressBar: true
        });
    });

    estadoInicial();
});
</script>
}
