﻿@model IEnumerable<bufinscustomers.Models.AuditoriaCargues>
@using bufinscustomers.Helpers

@{
    ViewBag.Title = Resources.Strings.Audit_PageTitle;
    if ((bool)(ViewBag.Embed ?? false)) { Layout = "~/Views/Shared/_LayoutFragment.cshtml"; }
    var esSuperAdmin = UsuarioSesionHelper.EsSuperAdmin();
    var totalCargues = Model.Count();
    var empresas = Model.Select(x => x.NombreEmpresa).Distinct().OrderBy(x => x).ToList();
}

<link href="~/Assets/css/bufins-components.css" rel="stylesheet" />

<div class="container-fluid px-4">
    <!-- Header Power BI -->
    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas fa-clipboard-list powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@Resources.Strings.Audit_HeaderTitle</h1>
        </div>
    </div>

    <!-- Mensajes de exito/error -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle mr-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle mr-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- Card de filtros -->
    <div class="filter-card">
        <h3 class="filter-card-title">
            <i class="fas fa-filter"></i>
            @Resources.Strings.Common_FiltrosConsulta
        </h3>

        <form id="formFiltros">
            <div class="filter-section">
                <div class="row">
                    <!-- Empresa (dropdown) -->
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="filterEmpresa">
                                <i class="fas fa-building"></i>
                                @Resources.Strings.Audit_ThEmpresa
                            </label>
                            <select id="filterEmpresa" class="form-control">
                                <option value="">@Resources.Strings.Common_Todos</option>
                                @foreach (var emp in empresas)
                                {
                                    <option value="@emp">@emp</option>
                                }
                            </select>
                        </div>
                    </div>
                    <!-- Fecha -->
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>
                                <i class="fas fa-calendar-alt"></i>
                                @Resources.Strings.Audit_ThFecha
                            </label>
                            <div class="d-flex gap-2">
                                <input type="date" id="filterDesde" class="form-control"
                                       title="@Resources.Strings.Audit_FilterDesde" />
                                <input type="date" id="filterHasta" class="form-control"
                                       title="@Resources.Strings.Audit_FilterHasta" />
                            </div>
                            <small class="text-muted">
                                @Resources.Strings.Audit_FilterDesde &ndash; @Resources.Strings.Audit_FilterHasta
                            </small>
                        </div>
                    </div>
                    <!-- Usuario (texto) -->
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="filterUsuario">
                                <i class="fas fa-user"></i>
                                @Resources.Strings.Audit_ThUsuario
                            </label>
                            <input type="text" id="filterUsuario" class="form-control"
                                   placeholder="@Resources.Strings.Audit_SearchPlaceholder" autocomplete="off" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Botones de accion -->
            <div class="btn-group-actions">
                <button type="button" id="btnFiltrar" class="btn btn-modern-gradient">
                    <i class="fas fa-search mr-2"></i>@Resources.Strings.Common_Consultar
                </button>
                <button type="button" id="btnLimpiar" class="btn btn-modern-secondary">
                    <i class="fas fa-eraser mr-2"></i>@Resources.Strings.Common_Limpiar
                </button>
                <button type="button" id="btnExportar" class="btn btn-modern-excel">
                    <i class="fas fa-file-excel mr-2"></i>@Resources.Strings.Common_ExportarExcel
                </button>
            </div>
        </form>
    </div>

    <!-- Tabla de resultados -->
    @if (totalCargues > 0)
    {
        <div id="resultadosContainer">
            <div class="table-container">
                <div class="table-header">
                    <h5>
                        <i class="fas fa-list mr-2"></i>@Resources.Strings.Common_Resultados
                    </h5>
                    <div class="d-flex align-items-center" style="gap:.6rem;flex-wrap:wrap;">
                        <span id="totalRegistros" class="info-badge">@totalCargues @Resources.Strings.Audit_TotalCargues</span>
                        <span id="paginaInfoCargues" style="font-size:.77rem;color:#6c757d;"></span>
                    </div>
                </div>
                <div class="table-wrapper">
                    <table id="auditoriaTable" class="data-table">
                        <thead>
                            <tr>
                                <th>@Resources.Strings.Audit_ThFecha</th>
                                <th>@Resources.Strings.Audit_ThEmpresa</th>
                                <th>@Resources.Strings.Audit_ThUsuario</th>
                                <th>@Resources.Strings.Audit_ThArchivo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var auditoria in Model.OrderByDescending(x => x.FechaCargue))
                            {
                                <tr data-fecha="@auditoria.FechaCargue.ToString("yyyy-MM-dd")">
                                    <td>
                                        <strong>@auditoria.FechaCargue.ToString("dd/MM/yyyy")</strong><br />
                                        <small class="text-muted">@auditoria.FechaCargue.ToString("HH:mm:ss")</small>
                                    </td>
                                    <td>@auditoria.NombreEmpresa</td>
                                    <td>@auditoria.Usuario</td>
                                    <td>@auditoria.NombreArchivo</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div id="paginacionCargues" class="pagination-controls"></div>
            </div>
        </div>

        <div id="noDataMessage" class="no-data-message" style="display:none">
            <i class="fas fa-inbox"></i>
            <h4>@Resources.Strings.Audit_NoData</h4>
            <p>@Resources.Strings.Audit_NoDataAdmin</p>
        </div>
    }
    else
    {
        <div id="resultadosContainer" style="display:none"></div>
        <div id="noDataMessage" class="no-data-message">
            <i class="fas fa-inbox"></i>
            <h4>@Resources.Strings.Audit_NoData</h4>
            <p>
                @if (esSuperAdmin)
                {
                    @Resources.Strings.Audit_NoDataAdmin
                }
                else
                {
                    @Resources.Strings.Audit_NoDataUser
                }
            </p>
        </div>
    }
</div>

@section scripts {
    <script>
        var _auditTotal = @totalCargues;
        var PAGE_SIZE = 25;
        var _auditMsg = {
            totalCargues:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_TotalCargues))',
            exportSuccess: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_ExportSuccess))',
            mostrando:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Mostrando))',
            de:            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_De))'
        };

        $(document).ready(function () {

            // Todas las filas se guardan en memoria; el <tbody> solo contiene la página actual.
            var $todasFilas   = $('#auditoriaTable tbody tr').detach();
            var $filtradas    = $todasFilas;
            var _paginaActual = 1;

            function aplicarFiltro() {
                var empresa = $('#filterEmpresa').val();
                var usuario = $('#filterUsuario').val().toLowerCase().trim();
                var desde   = $('#filterDesde').val();
                var hasta   = $('#filterHasta').val();

                $filtradas = $todasFilas.filter(function () {
                    var $tr       = $(this);
                    var tdEmpresa = $tr.find('td:eq(1)').text().trim();
                    var tdUsuario = $tr.find('td:eq(2)').text().toLowerCase();
                    var fechaFila = $tr.attr('data-fecha'); // yyyy-MM-dd

                    var matchEmpresa = !empresa || tdEmpresa === empresa;
                    var matchUsuario = !usuario || tdUsuario.indexOf(usuario) > -1;
                    var matchDesde   = !desde   || fechaFila >= desde;
                    var matchHasta   = !hasta   || fechaFila <= hasta;

                    return matchEmpresa && matchUsuario && matchDesde && matchHasta;
                });

                _paginaActual = 1;
                renderPagina(1);
            }

            function renderPagina(pagina) {
                var total     = $filtradas.length;
                var totalPags = Math.max(1, Math.ceil(total / PAGE_SIZE));
                pagina = Math.min(Math.max(1, pagina), totalPags);
                _paginaActual = pagina;

                $('#totalRegistros').text(total + ' ' + _auditMsg.totalCargues);

                var $tbody = $('#auditoriaTable tbody');
                $todasFilas.detach();
                $tbody.empty();

                if (total === 0) {
                    $('#resultadosContainer').hide();
                    $('#noDataMessage').show();
                    $('#paginacionCargues').empty();
                    $('#paginaInfoCargues').text('');
                    return;
                }

                $('#resultadosContainer').show();
                $('#noDataMessage').hide();

                var inicio = (pagina - 1) * PAGE_SIZE;
                var fin    = Math.min(inicio + PAGE_SIZE, total);
                $tbody.append($filtradas.slice(inicio, fin));

                $('#paginaInfoCargues').text(
                    _auditMsg.mostrando + ' ' + (inicio + 1) + '–' + fin + ' ' + _auditMsg.de + ' ' + total
                );

                renderPaginacion(totalPags, pagina);
            }

            function renderPaginacion(totalPags, actual) {
                var $pag = $('#paginacionCargues').empty();
                if (totalPags <= 1) return;

                function btn(label, dest, activo, disabled) {
                    return $('<button>')
                        .addClass('btn-pagination' + (activo ? ' active' : ''))
                        .prop('disabled', !!disabled)
                        .html(label)
                        .on('click', function () { renderPagina(dest); });
                }

                $pag.append(btn('<i class="fas fa-chevron-left"></i>', actual - 1, false, actual === 1));

                var desde = Math.max(1, actual - 2);
                var hasta = Math.min(totalPags, actual + 2);
                if (desde > 1) {
                    $pag.append(btn('1', 1, false, false));
                    if (desde > 2) $pag.append($('<span class="pagination-dots">').text('…'));
                }
                for (var p = desde; p <= hasta; p++) { $pag.append(btn(p, p, p === actual, false)); }
                if (hasta < totalPags) {
                    if (hasta < totalPags - 1) $pag.append($('<span class="pagination-dots">').text('…'));
                    $pag.append(btn(totalPags, totalPags, false, false));
                }

                $pag.append(btn('<i class="fas fa-chevron-right"></i>', actual + 1, false, actual === totalPags));
            }

            // Render inicial (primera página con todas las filas)
            if (_auditTotal > 0) renderPagina(1);

            // Filtro en tiempo real
            $('#filterEmpresa, #filterUsuario, #filterDesde, #filterHasta').on('change keyup', function () {
                aplicarFiltro();
            });

            // Boton Consultar
            $('#btnFiltrar').on('click', function () {
                aplicarFiltro();
            });

            // Boton Limpiar
            $('#btnLimpiar').on('click', function () {
                $('#filterEmpresa').val('');
                $('#filterUsuario').val('');
                $('#filterDesde').val('');
                $('#filterHasta').val('');
                $filtradas = $todasFilas;
                _paginaActual = 1;
                renderPagina(1);
            });

            // Boton Exportar
            $('#btnExportar').on('click', function () {
                var form = $('<form>', {
                    'method': 'POST',
                    'action': '@Url.Action("ExportarAuditoriaExcel", "AuditoriaCargues")',
                    'style': 'display:none'
                });
                form.append($('<input>', { type: 'hidden', name: 'empresa', value: $('#filterEmpresa').val() }));
                form.append($('<input>', { type: 'hidden', name: 'usuario', value: $('#filterUsuario').val() }));
                form.append($('<input>', { type: 'hidden', name: 'fechaDesde', value: $('#filterDesde').val() }));
                form.append($('<input>', { type: 'hidden', name: 'fechaHasta', value: $('#filterHasta').val() }));
                var token = $('input[name="__RequestVerificationToken"]').val();
                if (token) form.append($('<input>', { type: 'hidden', name: '__RequestVerificationToken', value: token }));
                $('body').append(form);
                form.submit();
                form.remove();

                Swal.fire({
                    toast: true,
                    position: window.innerWidth <= 768 ? 'top' : 'top-end',
                    icon: 'success',
                    title: _auditMsg.exportSuccess,
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true,
                    didOpen: (toast) => {
                        toast.addEventListener('mouseenter', Swal.stopTimer);
                        toast.addEventListener('mouseleave', Swal.resumeTimer);
                    }
                });
            });
        });
    </script>
}
