@{
    ViewBag.Title = Resources.Strings.PUC_PageTitle;
}

<link href="~/Assets/css/bufins-components.css" rel="stylesheet" />
<link href="~/Assets/css/puc-explorer.css" rel="stylesheet" />

<div class="container-fluid px-4">
    @Html.AntiForgeryToken()
    <!-- Header -->
    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas fa-book-open powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@Resources.Strings.PUC_PageTitle</h1>
        </div>
    </div>

    <!-- Mensajes -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert"><span aria-hidden="true">&times;</span></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle mr-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert"><span aria-hidden="true">&times;</span></button>
        </div>
    }

    <div class="puc-layout">
        <div class="puc-main">
            <!-- Barra de exploración: buscador + exportar + breadcrumb -->
            <div class="filter-card">
                <div class="puc-toolbar-row">
                    <div class="puc-search-wrap">
                        <i class="fas fa-search puc-search-icon"></i>
                        <input type="text" id="pucBuscar" class="puc-search-input" autocomplete="off"
                               placeholder="@Resources.Strings.PUC_BuscarPlaceholder" />
                        <div id="pucSearchResults" class="puc-search-results"></div>
                    </div>
                    <button type="button" id="btnExportar" class="btn btn-modern-excel puc-export-btn">
                        <i class="fas fa-file-excel mr-2"></i><span id="btnExportarTexto">@Resources.Strings.PUC_ExportarTodo</span>
                    </button>
                </div>

                <div class="puc-breadcrumb-bar">
                    <div id="pucBreadcrumb" class="puc-breadcrumb"></div>
                    <!-- Etiqueta de nivel actual -->
                    <div id="pucLevelLabel" class="puc-level-label" style="display:none;">
                        <i class="fas fa-layer-group"></i>
                        <span id="pucLevelText"></span>
                        <span id="pucLevelBadge" class="info-badge"></span>
                    </div>
                </div>
            </div>

            <!-- Descripción del nodo actual (se llena progresivamente; se oculta si está vacía) -->
            <div id="pucDescripcionActual" class="puc-descripcion-box" style="display:none;">
                <div class="puc-descripcion-head">
                    <span class="puc-descripcion-label"><i class="fas fa-align-left"></i>@Resources.Strings.PUC_Descripcion</span>
                    <button type="button" id="pucDescripcionToggle" class="puc-descripcion-toggle" style="display:none;"></button>
                </div>
                <div id="pucDescripcionTexto" class="puc-descripcion-text"></div>
            </div>

            <!-- Cuadrícula de nodos -->
            <div id="pucGrid" class="puc-grid"></div>

            <!-- Panel de detalle (cuenta hoja) -->
            <div id="pucDetalle" class="puc-detail-panel" style="display:none;">
                <div id="pucDetalleCodigo" class="puc-detail-code"></div>
                <div id="pucDetalleNombre" class="puc-detail-name"></div>
                <div class="puc-detail-meta">
                    <div class="puc-detail-meta-item">
                        <div class="puc-meta-label">@Resources.Strings.PUC_DetalleNivel</div>
                        <div id="pucDetalleNivel" class="puc-meta-value"></div>
                    </div>
                    <div class="puc-detail-meta-item">
                        <div class="puc-meta-label">@Resources.Strings.PUC_DetalleRuta</div>
                        <div id="pucDetalleRuta" class="puc-meta-value"></div>
                    </div>
                </div>
                <div id="pucDetalleDescripcionWrap" class="puc-descripcion-box" style="display:none;">
                    <div class="puc-descripcion-head">
                        <span class="puc-descripcion-label"><i class="fas fa-align-left"></i>@Resources.Strings.PUC_Descripcion</span>
                        <button type="button" id="pucDetalleDescripcionToggle" class="puc-descripcion-toggle" style="display:none;"></button>
                    </div>
                    <div id="pucDetalleDescripcion" class="puc-descripcion-text"></div>
                </div>
                <div class="puc-detail-actions">
                    <button type="button" id="btnCopiarCodigo" class="btn btn-modern-secondary">
                        <i class="fas fa-copy mr-2"></i><span id="btnCopiarTexto">@Resources.Strings.PUC_CopiarCodigo</span>
                    </button>
                </div>
            </div>

            <!-- Sin datos -->
            <div id="pucVacio" class="no-data-message" style="display:none;">
                <i class="fas fa-inbox"></i>
                <h4 id="pucVacioTitulo"></h4>
                <p id="pucVacioDesc"></p>
            </div>
        </div>

        <!-- Riel lateral permanente: estructura de codificación del PUC -->
        <aside class="puc-rail">
            <div class="puc-rail-header">
                <i class="fas fa-sitemap"></i>
                <span>@Resources.Strings.PUC_EstructuraTitulo</span>
            </div>
            <div class="puc-rail-body">
                <div class="puc-level" data-nivel-largo="1">
                    <span class="puc-level-num">1</span>
                    <span><b>@Resources.Strings.PUC_EstructuraClase</b> &middot; @Resources.Strings.PUC_EstructuraClaseDesc</span>
                    <span class="puc-level-here">@Resources.Strings.PUC_EstructuraAqui</span>
                </div>
                <div class="puc-level" data-nivel-largo="2">
                    <span class="puc-level-num">2</span>
                    <span><b>@Resources.Strings.PUC_EstructuraGrupo</b> &middot; @Resources.Strings.PUC_EstructuraGrupoDesc</span>
                    <span class="puc-level-here">@Resources.Strings.PUC_EstructuraAqui</span>
                </div>
                <div class="puc-level" data-nivel-largo="4">
                    <span class="puc-level-num">4</span>
                    <span><b>@Resources.Strings.PUC_EstructuraCuenta</b> &middot; @Resources.Strings.PUC_EstructuraCuentaDesc</span>
                    <span class="puc-level-here">@Resources.Strings.PUC_EstructuraAqui</span>
                </div>
                <div class="puc-level" data-nivel-largo="6">
                    <span class="puc-level-num">6</span>
                    <span><b>@Resources.Strings.PUC_EstructuraSubcuenta</b> &middot; @Resources.Strings.PUC_EstructuraSubcuentaDesc</span>
                    <span class="puc-level-here">@Resources.Strings.PUC_EstructuraAqui</span>
                </div>
                <div class="puc-rail-sep"></div>
                <div class="puc-rail-note"><span class="puc-rail-dot puc-rail-dot-balance"></span>@Resources.Strings.PUC_EstructuraBalance</div>
                <div class="puc-rail-note"><span class="puc-rail-dot puc-rail-dot-resultados"></span>@Resources.Strings.PUC_EstructuraResultados</div>
                <div class="puc-rail-note"><span class="puc-rail-dot puc-rail-dot-orden"></span>@Resources.Strings.PUC_EstructuraOrden</div>
            </div>
        </aside>
    </div>
</div>

@section scripts {
<script>
    var _pucMsg = {
        inicio:            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PUC_Inicio))',
        exportarRama:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PUC_ExportarRama))',
        exportarTodo:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PUC_ExportarTodo))',
        sinCuentas:        '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PUC_SinCuentas))',
        sinCuentasDesc:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PUC_SinCuentasDesc))',
        sinResultados:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PUC_SinResultadosBusqueda))',
        cuentasEnNivel:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PUC_CuentasEnNivel))',
        copiarCodigo:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PUC_CopiarCodigo))',
        codigoCopiado:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PUC_CodigoCopiado))',
        exportando:        '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_JS_ExportandoExcel))',
        generandoExcel:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_JS_GenerandoExcel))',
        errorConexion:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PUC_JS_ErrorConexion))',
        verMas:            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PUC_VerMas))',
        verMenos:          '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PUC_VerMenos))'
    };
</script>
<script>
    $(document).ready(function () {
        var rutaActual = [];

        cargarNivel();

        function cuentaActual() {
            return rutaActual.length ? rutaActual[rutaActual.length - 1].Cuenta : null;
        }

        function cargarNivel() {
            renderBreadcrumb();
            renderDescripcionActual();
            actualizarRailNivel();
            mostrarSkeleton();

            $.get('@Url.Action("ObtenerHijos", "TablaPUC")', { cuenta: cuentaActual() }, function (r) {
                if (!r.success) { mostrarError(); return; }

                if (r.nodos && r.nodos.length > 0) {
                    renderGrid(r.nodos);
                } else if (cuentaActual()) {
                    mostrarDetalle(rutaActual[rutaActual.length - 1]);
                } else {
                    mostrarVacio(_pucMsg.sinCuentas, _pucMsg.sinCuentasDesc);
                }
            }).fail(mostrarError);
        }

        function renderBreadcrumb() {
            var bc = $('#pucBreadcrumb').empty();

            var inicio = $('<button>').addClass('puc-crumb').attr('type', 'button')
                .append($('<i class="fas fa-home">'))
                .append($('<span>').text(_pucMsg.inicio));
            if (rutaActual.length > 0) {
                inicio.on('click', function () { rutaActual = []; cargarNivel(); });
            } else {
                inicio.addClass('current');
            }
            bc.append(inicio);

            $.each(rutaActual, function (i, nodo) {
                bc.append($('<span>').addClass('puc-crumb-sep').html('<i class="fas fa-chevron-right"></i>'));
                var esUltimo = (i === rutaActual.length - 1);
                var crumb = $('<button>').addClass('puc-crumb').attr('type', 'button')
                    .append($('<span>').addClass('puc-crumb-code').text(nodo.Cuenta))
                    .append($('<span>').addClass('puc-crumb-name').text(nodo.Nombre));
                if (esUltimo) {
                    crumb.addClass('current');
                } else {
                    (function (idx) {
                        crumb.on('click', function () { rutaActual = rutaActual.slice(0, idx + 1); cargarNivel(); });
                    })(i);
                }
                bc.append(crumb);
            });

            $('#btnExportarTexto').text(rutaActual.length ? _pucMsg.exportarRama : _pucMsg.exportarTodo);
        }

        function renderDescripcionActual() {
            var nodo = rutaActual.length ? rutaActual[rutaActual.length - 1] : null;
            if (nodo && nodo.Descripcion) {
                configurarDescripcion($('#pucDescripcionTexto'), $('#pucDescripcionToggle'), nodo.Descripcion);
                $('#pucDescripcionActual').show();
            } else {
                $('#pucDescripcionActual').hide();
            }
        }

        // Muestra el texto recortado a pocas lineas, con un enlace "Ver mas/menos" solo si es largo
        function configurarDescripcion(textoEl, toggleEl, texto) {
            textoEl.text(texto).removeClass('expanded');
            toggleEl.off('click');
            if (texto && texto.length > 220) {
                toggleEl.show().text(_pucMsg.verMas).on('click', function () {
                    var expandido = textoEl.toggleClass('expanded').hasClass('expanded');
                    $(this).text(expandido ? _pucMsg.verMenos : _pucMsg.verMas);
                });
            } else {
                toggleEl.hide();
            }
        }

        // Marca en el riel lateral el nivel del codigo actualmente seleccionado en el breadcrumb
        function actualizarRailNivel() {
            var codigo = cuentaActual();
            var largo = codigo ? String(codigo).length : null;
            $('.puc-level').removeClass('is-active').each(function () {
                if (largo !== null && $(this).data('nivel-largo') === largo) {
                    $(this).addClass('is-active');
                }
            });
        }

        function renderGrid(nodos) {
            $('#pucDetalle').hide();
            $('#pucVacio').hide();

            var grid = $('#pucGrid').empty().show();
            $.each(nodos, function (i, nodo) {
                var card = $('<button>').addClass('puc-node-card').attr('type', 'button');
                if (!nodo.TieneHijos) card.addClass('leaf');
                card.append($('<span>').addClass('puc-node-code').text(nodo.Cuenta));
                card.append($('<span>').addClass('puc-node-body').append($('<span>').addClass('puc-node-name').text(nodo.Nombre)));
                card.append($('<i>').addClass('fas ' + (nodo.TieneHijos ? 'fa-chevron-right' : 'fa-eye') + ' puc-node-chevron'));
                card.on('click', function () {
                    rutaActual.push({ Cuenta: nodo.Cuenta, Nombre: nodo.Nombre, Tipo: nodo.Tipo, Descripcion: nodo.Descripcion });
                    cargarNivel();
                });
                grid.append(card);
            });

            $('#pucLevelLabel').show();
            $('#pucLevelText').text(nodos[0].Tipo + ':');
            $('#pucLevelBadge').text(nodos.length + ' ' + _pucMsg.cuentasEnNivel);
        }

        function mostrarDetalle(nodo) {
            $('#pucGrid').empty().hide();
            $('#pucVacio').hide();
            $('#pucLevelLabel').hide();
            $('#pucDescripcionActual').hide();

            $('#pucDetalleCodigo').text(nodo.Cuenta);
            $('#pucDetalleNombre').text(nodo.Nombre);
            $('#pucDetalleNivel').text(nodo.Tipo || '');
            $('#pucDetalleRuta').text($.map(rutaActual, function (n) { return n.Cuenta + ' ' + n.Nombre; }).join('  >  '));
            if (nodo.Descripcion) {
                configurarDescripcion($('#pucDetalleDescripcion'), $('#pucDetalleDescripcionToggle'), nodo.Descripcion);
                $('#pucDetalleDescripcionWrap').show();
            } else {
                $('#pucDetalleDescripcionWrap').hide();
            }
            $('#btnCopiarTexto').text(_pucMsg.copiarCodigo);
            $('#pucDetalle').show();
        }

        function mostrarVacio(titulo, desc) {
            $('#pucGrid').empty().hide();
            $('#pucDetalle').hide();
            $('#pucLevelLabel').hide();
            $('#pucVacioTitulo').text(titulo);
            $('#pucVacioDesc').text(desc);
            $('#pucVacio').show();
        }

        function mostrarSkeleton() {
            $('#pucDetalle').hide();
            $('#pucVacio').hide();
            $('#pucLevelLabel').hide();
            var grid = $('#pucGrid').empty().show();
            for (var i = 0; i < 6; i++) {
                var card = $('<div>').addClass('puc-skeleton-card');
                card.append($('<div>').addClass('skeleton-bar').css({ width: '54px', height: '22px', flex: '0 0 auto' }));
                card.append($('<div>').addClass('skeleton-bar').css('width', (50 + Math.floor(Math.random() * 35)) + '%'));
                grid.append(card);
            }
        }

        function mostrarError() {
            Swal.fire({ icon: 'error', title: 'Error', text: _pucMsg.errorConexion });
        }

        // Buscador con salto directo
        var buscarTimeout = null;
        $('#pucBuscar').on('input', function () {
            var texto = $(this).val().trim();
            clearTimeout(buscarTimeout);
            if (texto.length < 2) { $('#pucSearchResults').removeClass('show').empty(); return; }
            buscarTimeout = setTimeout(function () { ejecutarBusqueda(texto); }, 300);
        });

        function ejecutarBusqueda(texto) {
            $.get('@Url.Action("Buscar", "TablaPUC")', { texto: texto }, function (r) {
                var cont = $('#pucSearchResults').empty();
                if (!r.success || !r.resultados || r.resultados.length === 0) {
                    cont.append($('<div>').addClass('puc-search-empty').text(_pucMsg.sinResultados));
                } else {
                    $.each(r.resultados, function (i, item) {
                        var row = $('<div>').addClass('puc-search-item')
                            .append($('<span>').addClass('puc-code').text(item.Cuenta))
                            .append($('<span>').addClass('puc-name').text(item.Nombre))
                            .append($('<span>').addClass('puc-level-tag').text(item.Tipo));
                        row.on('click', function () { saltarACuenta(item.Cuenta); });
                        cont.append(row);
                    });
                }
                cont.addClass('show');
            });
        }

        function saltarACuenta(cuenta) {
            $('#pucSearchResults').removeClass('show').empty();
            $('#pucBuscar').val('');
            $.get('@Url.Action("ObtenerRuta", "TablaPUC")', { cuenta: cuenta }, function (r) {
                if (r.success && r.ruta && r.ruta.length) {
                    rutaActual = r.ruta;
                    cargarNivel();
                }
            }).fail(mostrarError);
        }

        $(document).on('click', function (e) {
            if (!$(e.target).closest('.puc-search-wrap').length) {
                $('#pucSearchResults').removeClass('show');
            }
        });

        // Exportar
        $('#btnExportar').on('click', function () {
            var form = $('<form>', { method: 'POST', action: '@Url.Action("ExportarExcel", "TablaPUC")' });
            form.append($('<input>', { type: 'hidden', name: 'cuenta', value: cuentaActual() || '' }));
            form.append($('input[name="__RequestVerificationToken"]').first().clone());
            $('body').append(form);
            form.submit();
            form.remove();
            Swal.fire({ icon: 'success', title: _pucMsg.exportando, text: _pucMsg.generandoExcel, timer: 2000, showConfirmButton: false });
        });

        // Copiar código
        $('#btnCopiarCodigo').on('click', function () {
            var codigo = $('#pucDetalleCodigo').text();
            navigator.clipboard.writeText(codigo).then(function () {
                var original = _pucMsg.copiarCodigo;
                $('#btnCopiarTexto').text(_pucMsg.codigoCopiado);
                setTimeout(function () { $('#btnCopiarTexto').text(original); }, 1800);
            });
        });
    });
</script>
}
