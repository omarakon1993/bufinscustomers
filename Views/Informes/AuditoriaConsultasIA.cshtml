﻿@model dynamic
@using bufinscustomers.Models

@{
    ViewBag.Title = Resources.Strings.AudIA_PageTitle;
    var embed = (bool)(ViewBag.Embed ?? false);
    if (embed) { Layout = "~/Views/Shared/_LayoutFragment.cshtml"; }
    var esAdmin        = (bool)ViewBag.EsAdmin;
    var esAdminEmpresa = (bool)(ViewBag.EsAdminEmpresa ?? false);
    var empresasFiltro = ViewBag.EmpresasFiltro as List<Empresas>;
    // Se muestra la empresa (filtro + columna) al Super Admin y al Admin de Empresa cuyo grupo
    // tenga más de una empresa (el controlador solo puebla empresasFiltro en ese caso).
    var verEmpresa     = esAdmin || (empresasFiltro != null && empresasFiltro.Count > 1);
}

<link href="~/Assets/css/informe-relacionamientos.css" rel="stylesheet" />

<style>
/* Chips de fecha rápida */
.aud-date-chip {
    background: #fff;
    border: 1px solid #d1d5db;
    color: #6b7280;
    border-radius: 99px;
    padding: 4px 14px;
    font-size: .78rem;
    font-weight: 600;
    cursor: pointer;
    transition: all .15s;
    white-space: nowrap;
}
.aud-date-chip:hover  { border-color: #583AFF; color: #583AFF; background: #eef2ff; }
.aud-date-chip.active { background: #583AFF; border-color: #583AFF; color: #fff; }

/* Badges tipo */
.aud-tipo-badge {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: .72rem; font-weight: 700;
    padding: 3px 10px; border-radius: 99px; white-space: nowrap;
}
.aud-tipo-resumen  { background: #ede9fe; color: #583AFF; }
.aud-tipo-pregunta { background: #fce7f3; color: #be185d; }

/* Celda pregunta truncada */
.aud-pregunta-cell {
    max-width: 260px; white-space: nowrap;
    overflow: hidden; text-overflow: ellipsis;
    cursor: default; color: #4b5563; display: block;
}

/* Botón header */
.audit-btn-header {
    background:rgba(255,255,255,.18); border:1.5px solid rgba(255,255,255,.55);
    color:#fff; border-radius:8px; padding:6px 16px; font-size:.87rem;
    font-weight:600; cursor:pointer; transition:background .2s; white-space:nowrap;
    text-decoration:none; display:inline-flex; align-items:center; gap:6px;
}
.audit-btn-header:hover { background:rgba(255,255,255,.30); color:#fff; text-decoration:none; }
.audit-btn-header.audit-btn-danger { background:rgba(220,53,69,.28); border-color:rgba(255,255,255,.55); }
.audit-btn-header.audit-btn-danger:hover { background:rgba(220,53,69,.48); }

/* Contenido del modal "Limpiar auditoría" (dentro de SweetAlert, tema oscuro) */
.aud-limp-wrap { text-align:left; }
.aud-limp-desc {
    font-size:.85rem; line-height:1.5; color:#9ca3af;
    margin:0 0 16px; padding-bottom:12px;
    border-bottom:1px solid rgba(255,255,255,.12);
}
.aud-limp-opt {
    display:flex; align-items:flex-start; gap:10px;
    padding:12px 14px; margin-bottom:10px;
    border:1.5px solid rgba(255,255,255,.16); border-radius:10px;
    cursor:pointer; transition:border-color .15s, background .15s;
}
.aud-limp-opt:last-child { margin-bottom:0; }
.aud-limp-opt:hover { border-color:rgba(139,125,255,.7); }
.aud-limp-opt.is-active { border-color:#8b7dff; background:rgba(88,58,255,.16); }
.aud-limp-opt > input[type=radio] { margin:3px 0 0; accent-color:#8b7dff; flex:0 0 auto; }
.aud-limp-opt-body { flex:1; min-width:0; }
.aud-limp-opt-title { display:block; font-weight:600; font-size:.92rem; color:#f3f4f6; }
.aud-limp-opt-hint  { display:block; font-size:.78rem; color:#9ca3af; margin-top:3px; }
.aud-limp-meses-row { display:flex; align-items:center; gap:8px; margin-top:10px; }
.aud-limp-meses-row label { margin:0; font-size:.8rem; color:#cbd5e1; }
.aud-limp-meses-input {
    width:88px; padding:6px 10px; font-size:.9rem; text-align:center;
    border:1.5px solid rgba(255,255,255,.25); border-radius:8px;
    background:rgba(255,255,255,.06); color:#f3f4f6;
}
.aud-limp-meses-input:focus { outline:none; border-color:#8b7dff; }
.aud-limp-meses-input:disabled { opacity:.4; cursor:not-allowed; }

/* Botón ver */
.aud-btn-ver {
    background: #eef2ff; border: 1px solid #c7d2fe;
    color: #583AFF; border-radius: 6px;
    padding: 4px 12px; font-size: .76rem; font-weight: 600;
    cursor: pointer; transition: background .15s; white-space: nowrap;
}
.aud-btn-ver:hover { background: #e0e7ff; }

/* Bloque pregunta en SweetAlert */
.ia-pregunta-block {
    background: #eef2ff; border-left: 4px solid #583AFF;
    border-radius: 8px; padding: 12px 16px; margin-bottom: 16px;
}
.ia-pregunta-block .ia-pregunta-label {
    font-size: .75rem; font-weight: 700; letter-spacing: .07em;
    text-transform: uppercase; color: #583AFF; margin-bottom: 4px;
}
.ia-pregunta-block .ia-pregunta-texto { color: #1e1b4b; font-weight: 500; font-size: .97rem; }
</style>

<div class="container-fluid px-4">

    @Html.AntiForgeryToken()

    @if (!embed)
    {
        <!-- Header -->
        <div class="powerbi-header" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
            <div class="powerbi-header-content">
                <i class="fas fa-history powerbi-header-icon"></i>
                <h1 class="powerbi-header-title">@Resources.Strings.AudIA_PageTitle</h1>
            </div>
            <div class="d-flex align-items-center" style="gap:8px;flex-wrap:wrap;">
                @if (esAdmin)
                {
                    <button type="button" id="btnLimpiarAuditoria" class="audit-btn-header audit-btn-danger">
                        <i class="fas fa-trash-alt"></i> @Resources.Strings.AudIA_BtnLimpiarAuditoria
                    </button>
                }
            </div>
        </div>
    }
    else if (esAdmin)
    {
        <div class="d-flex justify-content-end" style="margin-bottom:.9rem;">
            <button type="button" id="btnLimpiarAuditoria" class="btn btn-sm btn-danger">
                <i class="fas fa-trash-alt mr-1"></i>@Resources.Strings.AudIA_BtnLimpiarAuditoria
            </button>
        </div>
    }

    <!-- Card de filtros -->
    <div class="filter-card">
        <h3 class="filter-card-title">
            <i class="fas fa-filter"></i>
            @Resources.Strings.Common_FiltrosConsulta
        </h3>

        <div class="filter-section">
            <div class="row">

                @if (verEmpresa)
                {
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="audEmpresa">
                                <i class="fas fa-building"></i>
                                @Resources.Strings.AudIA_LabelEmpresa
                            </label>
                            <select id="audEmpresa" class="form-control">
                                <option value="">@Resources.Strings.AudIA_TodasEmpresas</option>
                                @if (empresasFiltro != null)
                                {
                                    foreach (var e in empresasFiltro)
                                    {
                                        <option value="@e.Id">@e.Nombre</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                }

                @if (esAdmin || esAdminEmpresa)
                {
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="audUsuario">
                                <i class="fas fa-user"></i>
                                @Resources.Strings.AudIA_LabelUsuario
                            </label>
                            <select id="audUsuario" class="form-control">
                                <option value="">@Resources.Strings.AudIA_TodosUsuarios</option>
                            </select>
                        </div>
                    </div>
                }

                <div class="@(esAdmin ? "col-md-4" : (esAdminEmpresa ? "col-md-4" : "col-md-6"))">
                    <div class="form-group">
                        <label for="audTipo">
                            <i class="fas fa-tag"></i>
                            @Resources.Strings.AudIA_LabelTipo
                        </label>
                        <select id="audTipo" class="form-control">
                            <option value="">@Resources.Strings.AudIA_TodosTipos</option>
                            <option value="resumen">&#x2728; @Resources.Strings.AudIA_TipoResumen</option>
                            <option value="pregunta">&#x2753; @Resources.Strings.AudIA_TipoPregunta</option>
                        </select>
                    </div>
                </div>

                <div class="@(esAdmin || esAdminEmpresa ? "col-md-12" : "col-md-6")">
                    <div class="form-group">
                        <label for="audBusquedaTexto">
                            <i class="fas fa-search"></i>
                            @Resources.Strings.AudIA_LabelBuscar
                        </label>
                        <input type="text" id="audBusquedaTexto" class="form-control"
                               placeholder="@Resources.Strings.AudIA_BuscarPlaceholder" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-auto">
                    <div class="form-group">
                        <label for="audDesde">
                            <i class="fas fa-calendar-alt"></i>
                            @Resources.Strings.AudIA_LabelDesde
                        </label>
                        <input type="date" id="audDesde" class="form-control" style="width:170px;" />
                    </div>
                </div>
                <div class="col-sm-auto">
                    <div class="form-group">
                        <label for="audHasta">
                            <i class="fas fa-calendar-alt"></i>
                            @Resources.Strings.AudIA_LabelHasta
                        </label>
                        <input type="date" id="audHasta" class="form-control" style="width:170px;" />
                    </div>
                </div>
                <div class="col d-flex align-items-end pb-2">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span style="font-size:.75rem;color:#9ca3af;white-space:nowrap;">
                            <i class="fas fa-bolt" style="font-size:.65rem;"></i> @Resources.Strings.AudIA_AccesoRapido
                        </span>
                        <button class="aud-date-chip" data-days="0">@Resources.Strings.AudIA_ChipHoy</button>
                        <button class="aud-date-chip" data-days="7">@Resources.Strings.AudIA_Chip7Dias</button>
                        <button class="aud-date-chip" data-days="30">@Resources.Strings.AudIA_Chip30Dias</button>
                        <button class="aud-date-chip" data-month="1">@Resources.Strings.AudIA_ChipEsteMes</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="btn-group-actions">
            <button type="button" id="btnFiltrarAuditoria" class="btn btn-modern-gradient">
                <i class="fas fa-search mr-2"></i>@Resources.Strings.AudIA_BtnBuscar
            </button>
            <button type="button" id="btnLimpiarFiltros" class="btn btn-modern-secondary">
                <i class="fas fa-eraser mr-2"></i>@Resources.Strings.AudIA_BtnLimpiar
            </button>
        </div>
    </div>

    <!-- Tabla de resultados -->
    <div id="audResultadosContainer" style="display:none;">
        <div class="table-container">
            <div class="table-header">
                <h5>
                    <i class="fas fa-list mr-2"></i>@Resources.Strings.AudIA_TitleHistorial
                </h5>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span id="audStatTotal"   class="info-badge" style="background:var(--app-btn-gradient);display:none;">
                        <i class="fas fa-list-ul mr-1"></i><span>0</span> total
                    </span>
                    <span id="audStatResumenes" class="info-badge" style="background:linear-gradient(135deg,#583AFF,#4a2de0);display:none;">
                        <i class="fas fa-magic mr-1"></i><span>0</span> res&uacute;menes
                    </span>
                    <span id="audStatPreguntas" class="info-badge" style="background:linear-gradient(135deg,#be185d,#e879a4);display:none;">
                        <i class="fas fa-question-circle mr-1"></i><span>0</span> preguntas
                    </span>
                    <span id="audPaginaInfo" style="font-size:.77rem;color:#6c757d;"></span>
                </div>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th style="width:150px;">@Resources.Strings.AudIA_ThFecha</th>
                            <th style="min-width:130px;">@Resources.Strings.AudIA_ThUsuario</th>
                            @if (verEmpresa) { <th style="min-width:110px;">@Resources.Strings.AudIA_ThEmpresa</th> }
                            <th style="min-width:160px;">@Resources.Strings.AudIA_ThTablaFiltros</th>
                            <th style="width:110px;">@Resources.Strings.AudIA_ThTipo</th>
                            <th>@Resources.Strings.AudIA_ThPregunta</th>
                            <th style="width:65px;" class="text-center">@Resources.Strings.AudIA_ThFilas</th>
                            <th style="width:80px;" class="text-center">@Resources.Strings.AudIA_ThVer</th>
                        </tr>
                    </thead>
                    <tbody id="audTbody"></tbody>
                </table>
            </div>
            <div id="audPaginacion" class="pagination-controls"></div>
        </div>
    </div>

    <!-- Sin resultados -->
    <div id="audSinResultados" class="no-data-message" style="display:none;">
        <i class="fas fa-robot"></i>
        <h4>@Resources.Strings.AudIA_SinResultados</h4>
        <p>@Resources.Strings.AudIA_SinResultadosTxt</p>
    </div>

</div>

@section scripts {
<script src="~/Assets/js/bufins-markdown.js"></script>
<script>
$(document).ready(function () {

    var esAdminJS        = @(esAdmin ? "true" : "false");
    var esAdminEmpresaJS = @(esAdminEmpresa ? "true" : "false");
    var verEmpresaJS     = @(verEmpresa ? "true" : "false");
    var PAGE_SIZE        = 20;
    var _todosRegistros  = [];
    var _filtrados       = [];
    var _paginaActual    = 1;

    var _strTodosUsuarios  = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_TodosUsuarios))';
    var _strErrorHistorial = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_JS_ErrorHistorial))';
    var _strMostrando      = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_Mostrando))';
    var _strDe             = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_De))';
    var _strBadgeResumen   = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_BadgeResumen))';
    var _strBadgePregunta  = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_BadgePregunta))';
    var _strResumenAuto    = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_ResumenAuto))';
    var _strPreguntaRealiz = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LabelPreguntaRealiz))';
    var _strTipoRG         = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LabelTipoRG))';
    var _strTitleRespuesta = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_TitleRespuesta))';
    var _strVer            = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_ThVer))';
    var _strError          = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Error))';
    var _strExito          = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Exito))';

    var _limp = {
        titulo:          '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarTitulo))',
        desc:            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarDesc))',
        opcionTodo:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarOpcionTodo))',
        opcionTodoHint:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarOpcionTodoHint))',
        opcionConservar:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarOpcionConservar))',
        opcionConservarHint:'@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarOpcionConservarHint))',
        mesesLabel:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarMesesLabel))',
        confirmarBtn:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarConfirmarBtn))',
        cancelarBtn:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarCancelarBtn))',
        mesesInvalido:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarMesesInvalido))',
        confirmTodo:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarConfirmTodo))',
        confirmConservar:'@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarConfirmConservar))',
        exito:           '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarExito))',
        errorMsg:        '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarError))'
    };

    /* ── Carga inicial ── */
    consultarServidor();
    if (esAdminEmpresaJS && !esAdminJS) cargarUsuarios(null);

    /* ── Botones ── */
    $('#btnFiltrarAuditoria').on('click', consultarServidor);
    $('#btnLimpiarFiltros').on('click', function () {
        $('#audEmpresa').val('');
        $('#audUsuario').html('<option value="">' + _strTodosUsuarios + '</option>');
        $('#audTipo').val('');
        $('#audDesde,#audHasta').val('');
        $('#audBusquedaTexto').val('');
        $('.aud-date-chip').removeClass('active');
        consultarServidor();
    });

    /* ── Limpiar auditoría (solo Super Admin) ── */
    $('#btnLimpiarAuditoria').on('click', function () {
        Swal.fire({
            title: _limp.titulo,
            html:
                '<div class="aud-limp-wrap">' +
                  '<p class="aud-limp-desc">' + _limp.desc + '</p>' +
                  '<label class="aud-limp-opt is-active" data-modo="todo">' +
                    '<input type="radio" name="audLimpModo" value="todo" checked>' +
                    '<span class="aud-limp-opt-body">' +
                      '<span class="aud-limp-opt-title">' + _limp.opcionTodo + '</span>' +
                      '<span class="aud-limp-opt-hint">' + _limp.opcionTodoHint + '</span>' +
                    '</span>' +
                  '</label>' +
                  '<label class="aud-limp-opt" data-modo="conservar">' +
                    '<input type="radio" name="audLimpModo" value="conservar">' +
                    '<span class="aud-limp-opt-body">' +
                      '<span class="aud-limp-opt-title">' + _limp.opcionConservar + '</span>' +
                      '<span class="aud-limp-opt-hint">' + _limp.opcionConservarHint + '</span>' +
                      '<span class="aud-limp-meses-row">' +
                        '<label for="audLimpMeses">' + _limp.mesesLabel + '</label>' +
                        '<input type="number" id="audLimpMeses" class="aud-limp-meses-input" min="1" max="120" value="6" disabled>' +
                      '</span>' +
                    '</span>' +
                  '</label>' +
                '</div>',
            focusConfirm: false,
            showCancelButton: true,
            confirmButtonText: _limp.confirmarBtn,
            cancelButtonText: _limp.cancelarBtn,
            confirmButtonColor: '#e74c3c',
            reverseButtons: true,
            didOpen: function () {
                var popup      = Swal.getPopup();
                var mesesInput = popup.querySelector('#audLimpMeses');
                var opciones   = popup.querySelectorAll('.aud-limp-opt');
                var radios     = popup.querySelectorAll('input[name="audLimpModo"]');

                function sincronizar() {
                    var sel = popup.querySelector('input[name="audLimpModo"]:checked');
                    var modo = sel ? sel.value : 'todo';
                    opciones.forEach(function (o) {
                        o.classList.toggle('is-active', o.getAttribute('data-modo') === modo);
                    });
                    mesesInput.disabled = (modo !== 'conservar');
                }

                radios.forEach(function (r) { r.addEventListener('change', sincronizar); });
                // Enfocar el campo de meses activa automáticamente "conservar"
                mesesInput.addEventListener('focus', function () {
                    popup.querySelector('input[name="audLimpModo"][value="conservar"]').checked = true;
                    sincronizar();
                });
                sincronizar();
            },
            preConfirm: function () {
                var sel = document.querySelector('input[name="audLimpModo"]:checked');
                var modo = sel ? sel.value : 'todo';
                if (modo === 'conservar') {
                    var m = parseInt(document.getElementById('audLimpMeses').value, 10);
                    if (isNaN(m) || m < 1 || m > 120) {
                        Swal.showValidationMessage(_limp.mesesInvalido);
                        return false;
                    }
                    return { completo: false, meses: m };
                }
                return { completo: true, meses: null };
            }
        }).then(function (res) {
            if (!res.isConfirmed) return;
            var opts = res.value;
            var texto = opts.completo
                ? _limp.confirmTodo
                : _limp.confirmConservar.replace('{0}', opts.meses);

            Swal.fire({
                title: _limp.titulo,
                text: texto,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: _limp.confirmarBtn,
                cancelButtonText: _limp.cancelarBtn,
                confirmButtonColor: '#e74c3c',
                reverseButtons: true
            }).then(function (c) {
                if (!c.isConfirmed) return;
                var token = $('input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '@Url.Action("LimpiarAuditoria","AuditoriaConsultasIA")',
                    type: 'POST',
                    data: {
                        completo: opts.completo,
                        meses: opts.meses,
                        __RequestVerificationToken: token
                    },
                    success: function (r) {
                        if (r && r.success) {
                            Swal.fire({
                                icon: 'success',
                                title: _strExito,
                                text: _limp.exito.replace('{0}', r.eliminados)
                            });
                            consultarServidor();
                        } else {
                            Swal.fire({ icon: 'error', title: _strError, text: (r && r.message) || _limp.errorMsg });
                        }
                    },
                    error: function () {
                        Swal.fire({ icon: 'error', title: _strError, text: _limp.errorMsg });
                    }
                });
            });
        });
    });

    /* ── Filtros locales ── */
    $('#audTipo').on('change', aplicarFiltrosLocales);
    $('#audBusquedaTexto').on('input', aplicarFiltrosLocales);

    /* ── Empresa cambia → recargar usuarios ── */
    $('#audEmpresa').on('change', function () { cargarUsuarios($(this).val() || null); });

    /* ── Chips de acceso rápido ── */
    $(document).on('click', '.aud-date-chip', function () {
        var $chip = $(this);
        if ($chip.hasClass('active')) {
            $chip.removeClass('active');
            $('#audDesde,#audHasta').val('');
            return;
        }
        $('.aud-date-chip').removeClass('active');
        $chip.addClass('active');

        var today = new Date();
        var pad   = function (n) { return n < 10 ? '0' + n : '' + n; };
        var fmt   = function (d) { return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()); };
        var hasta = fmt(today);
        var days  = $chip.data('days');
        var month = $chip.data('month');
        var desde;

        if (days !== undefined) {
            var d = new Date(today);
            d.setDate(d.getDate() - parseInt(days, 10));
            desde = fmt(d);
        } else if (month) {
            desde = fmt(new Date(today.getFullYear(), today.getMonth(), 1));
        }

        $('#audDesde').val(desde);
        $('#audHasta').val(hasta);
    });

    /* ── Cargar usuarios ── */
    function cargarUsuarios(idEmpresa) {
        var params = {};
        if (idEmpresa) params.idEmpresa = idEmpresa;
        $.get('@Url.Action("ObtenerUsuariosAuditoria","AuditoriaConsultasIA")', params, function (lista) {
            var sel = $('#audUsuario').html('<option value="">' + _strTodosUsuarios + '</option>');
            $.each(lista, function (i, u) { sel.append($('<option>').val(u.Id).text(u.Nombre)); });
        });
    }

    /* ── Consulta al servidor ── */
    function consultarServidor() {
        var params  = {};
        var empresa = $('#audEmpresa').val();
        var usuario = $('#audUsuario').val();
        var desde   = $('#audDesde').val();
        var hasta   = $('#audHasta').val();
        if (empresa) params.idEmpresa = empresa;
        if (usuario) params.idUsuario = usuario;
        if (desde)   params.desde    = desde;
        if (hasta)   params.hasta    = hasta;

        mostrarEsqueleto();

        $.ajax({
            url  : '@Url.Action("ObtenerAuditoria","AuditoriaConsultasIA")',
            type : 'GET',
            data : params,
            success: function (registros) {
                _todosRegistros = registros || [];
                aplicarFiltrosLocales();
                abrirDeepLinkIA();
            },
            error: function () {
                $('#audResultadosContainer').hide();
                Swal.fire({ icon: 'error', title: _strError, text: _strErrorHistorial });
            }
        });
    }

    /* ── Enlace permanente: ?ia=<id> abre esa consulta al cargar ── */
    var _deepLinkIAHecho = false;
    function abrirDeepLinkIA() {
        if (_deepLinkIAHecho) return;
        var m = /[?&]ia=(\d+)/.exec(location.search);
        if (!m) return;
        _deepLinkIAHecho = true;
        for (var i = 0; i < _todosRegistros.length; i++) {
            if (String(_todosRegistros[i].Id) === m[1]) {
                verRespuesta(_todosRegistros[i].Pregunta, _todosRegistros[i].Respuesta, _todosRegistros[i].Filtros);
                return;
            }
        }
    }

    /* ── Filas "esqueleto" mientras se consulta ── */
    function mostrarEsqueleto() {
        var columnas = @(esAdmin ? 8 : 7);
        var tbody = $('#audTbody').empty();

        for (var r = 0; r < 6; r++) {
            var row = $('<tr>').addClass('skeleton-row');
            for (var c = 0; c < columnas; c++) {
                var ancho = 45 + Math.floor(Math.random() * 45);
                row.append($('<td>').append($('<div>').addClass('skeleton-bar').css('width', ancho + '%')));
            }
            tbody.append(row);
        }

        $('#audSinResultados').hide();
        $('#audStatTotal,#audStatResumenes,#audStatPreguntas').hide();
        $('#audPaginaInfo').text('');
        $('#audPaginacion').empty();
        $('#audResultadosContainer').show();
    }

    /* ── Filtros locales: tipo + búsqueda ── */
    function aplicarFiltrosLocales() {
        var tipo  = $('#audTipo').val();
        var texto = ($('#audBusquedaTexto').val() || '').toLowerCase().trim();

        _filtrados = _todosRegistros.filter(function (r) {
            var esResumen = r.Pregunta === '(Resumen Gerencial)';
            if (tipo === 'resumen'  && !esResumen) return false;
            if (tipo === 'pregunta' &&  esResumen) return false;
            if (texto) {
                var match =
                    (r.Pregunta      || '').toLowerCase().indexOf(texto) >= 0 ||
                    (r.NombreTabla   || '').toLowerCase().indexOf(texto) >= 0 ||
                    (r.NombreUsuario || '').toLowerCase().indexOf(texto) >= 0 ||
                    (r.NombreEmpresa || '').toLowerCase().indexOf(texto) >= 0 ||
                    (r.Filtros       || '').toLowerCase().indexOf(texto) >= 0;
                if (!match) return false;
            }
            return true;
        });

        actualizarStats();
        _paginaActual = 1;
        renderPagina(1);
    }

    /* ── Stats ── */
    function actualizarStats() {
        if (_todosRegistros.length === 0) return;
        var total     = _filtrados.length;
        var resumenes = _filtrados.filter(function (r) { return r.Pregunta === '(Resumen Gerencial)'; }).length;
        var preguntas = total - resumenes;

        $('#audStatTotal span').text(total);
        $('#audStatResumenes span').text(resumenes);
        $('#audStatPreguntas span').text(preguntas);
        $('#audStatTotal,#audStatResumenes,#audStatPreguntas').show();
    }

    /* ── Render tabla paginada ── */
    function renderPagina(pagina) {
        var totalPags = Math.max(1, Math.ceil(_filtrados.length / PAGE_SIZE));
        pagina = Math.min(Math.max(1, pagina), totalPags);
        _paginaActual = pagina;

        var inicio = (pagina - 1) * PAGE_SIZE;
        var slice  = _filtrados.slice(inicio, inicio + PAGE_SIZE);

        $('#audPaginaInfo').text(
            _filtrados.length === 0 ? '' :
            _strMostrando + ' ' + (inicio + 1) + '-' + Math.min(inicio + PAGE_SIZE, _filtrados.length) + ' ' + _strDe + ' ' + _filtrados.length
        );

        var tbody = $('#audTbody').empty();

        if (_filtrados.length === 0) {
            $('#audResultadosContainer').hide();
            $('#audSinResultados').show();
            $('#audPaginacion').empty();
            return;
        }

        $('#audSinResultados').hide();
        $('#audResultadosContainer').show();

        $.each(slice, function (i, r) {
            var esResumen = r.Pregunta === '(Resumen Gerencial)';

            var tipoBadge = esResumen
                ? '<span class="aud-tipo-badge aud-tipo-resumen"><i class="fas fa-magic"></i> ' + _strBadgeResumen + '</span>'
                : '<span class="aud-tipo-badge aud-tipo-pregunta"><i class="fas fa-question-circle"></i> ' + _strBadgePregunta + '</span>';

            var preguntaHtml = esResumen
                ? '<em style="color:#9ca3af;font-size:.8rem;">' + _strResumenAuto + '</em>'
                : '<span class="aud-pregunta-cell" title="' + $('<div>').text(r.Pregunta).html() + '">'
                    + $('<div>').text(r.Pregunta).html()
                  + '</span>';

            var btnVer = $('<button class="aud-btn-ver">')
                .html('<i class="fas fa-eye mr-1"></i>' + _strVer)
                .on('click', function () { verRespuesta(r.Pregunta, r.Respuesta, r.Filtros); });

            var tr = $('<tr>');
            tr.append($('<td>').css({ whiteSpace: 'nowrap', fontSize: '.8rem', color: '#6b7280' }).text(r.FechaPregunta));
            tr.append($('<td>').css('font-weight', '600').text(r.NombreUsuario));
            if (verEmpresaJS) tr.append($('<td>').text(r.NombreEmpresa));
            tr.append($('<td>').html(
                '<span style="font-weight:600;">' + $('<div>').text(r.NombreTabla).html() + '</span>'
                + (r.Filtros ? '<br><small style="color:#9ca3af;font-size:.74rem;">' + $('<div>').text(r.Filtros).html() + '</small>' : '')
            ));
            tr.append($('<td>').html(tipoBadge));
            tr.append($('<td>').html(preguntaHtml));
            tr.append($('<td class="text-center">').css({ fontWeight: '700', color: '#583AFF' }).text(r.FilasAnalizadas));
            tr.append($('<td class="text-center">').append(btnVer));
            tbody.append(tr);
        });

        renderPaginacion(totalPags, pagina);
    }

    /* ── Paginación ── */
    function renderPaginacion(totalPags, actual) {
        var $pag = $('#audPaginacion').empty();
        if (totalPags <= 1) return;

        function btn(label, dest, activo, disabled) {
            return $('<button>')
                .addClass('btn-pagination' + (activo ? ' active' : ''))
                .prop('disabled', disabled)
                .html(label)
                .on('click', function () { renderPagina(dest); });
        }

        $pag.append(btn('<i class="fas fa-chevron-left"></i>', actual - 1, false, actual === 1));

        var desde = Math.max(1, actual - 2);
        var hasta = Math.min(totalPags, actual + 2);
        if (desde > 1) {
            $pag.append(btn('1', 1, false, false));
            if (desde > 2) $pag.append($('<span class="pagination-dots">').text('...'));
        }
        for (var p = desde; p <= hasta; p++) { $pag.append(btn(p, p, p === actual, false)); }
        if (hasta < totalPags) {
            if (hasta < totalPags - 1) $pag.append($('<span class="pagination-dots">').text('...'));
            $pag.append(btn(totalPags, totalPags, false, false));
        }

        $pag.append(btn('<i class="fas fa-chevron-right"></i>', actual + 1, false, actual === totalPags));
    }

    /* ── Ver respuesta completa ── */
    function verRespuesta(pregunta, respuesta, filtros) {
        var esResumen = pregunta === '(Resumen Gerencial)';
        var html = '';

        if (!esResumen) {
            html += '<div class="ia-pregunta-block">'
                  + '<div class="ia-pregunta-label"><i class="fas fa-question-circle mr-1"></i>' + _strPreguntaRealiz + '</div>'
                  + '<div class="ia-pregunta-texto">' + $('<div>').text(pregunta).html() + '</div>'
                  + '</div>';
        } else {
            html += '<div class="ia-pregunta-block" style="background:#f8f9fc;border-left-color:#9ca3af;">'
                  + '<div class="ia-pregunta-label" style="color:#6b7280;"><i class="fas fa-magic mr-1"></i>Tipo</div>'
                  + '<div style="color:#2d3748;font-weight:600;">' + _strTipoRG + '</div>'
                  + '</div>';
        }

        if (filtros) {
            html += '<div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:7px;padding:8px 12px;margin-bottom:14px;font-size:.8rem;color:#166534;">'
                  + '<i class="fas fa-filter mr-1"></i><strong>Filtros:</strong> ' + $('<div>').text(filtros).html()
                  + '</div>';
        }

        html += '<div class="ia-response-body" style="max-height:55vh;overflow-y:auto;text-align:left;">'
              + renderMarkdown(respuesta)
              + '</div>';

        Swal.fire({
            title            : _strTitleRespuesta,
            html             : html,
            width            : '820px',
            showCloseButton  : true,
            showConfirmButton: false,
            customClass      : { popup: 'text-start' }
        });
    }

    /* ── Markdown renderer ──
       Lo aporta ~/Assets/js/bufins-markdown.js (window.renderMarkdown). Fallback mínimo
       por si el archivo no cargó. */
    function renderMarkdown(text) {
        if (typeof window.bufinsMarkdown === 'function') return window.bufinsMarkdown(text);
        return text ? $('<div>').text(text).html().replace(/\n/g, '<br>') : '';
    }

});
</script>
}
