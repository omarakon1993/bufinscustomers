@model dynamic
@using bufinscustomers.Models
@using System.Linq
@using System.Web.Mvc

@{
    ViewBag.Title = Resources.Strings.AudIA_PageTitle;
    var embed = (bool)(ViewBag.Embed ?? false);
    if (embed) { Layout = "~/Views/Shared/_LayoutFragment.cshtml"; }
    var esAdmin        = (bool)ViewBag.EsAdmin;
    var esAdminEmpresa = (bool)(ViewBag.EsAdminEmpresa ?? false);
    var empresasFiltro = ViewBag.EmpresasFiltro as List<Empresas>;
    // Se muestra la empresa (filtro + columna) al Super Admin y al Admin de Empresa cuyo grupo
    // tenga más de una empresa (el controlador solo puebla empresasFiltro en ese caso).
    var verEmpresa     = esAdmin || (empresasFiltro != null && empresasFiltro.Count > 1);

    // Panel de filtros UNIFORME (mismo orden en las 4 pestañas): Empresa · Usuario · campos propios (Tabla, Tipo) · avanzados.
    var vm = new AudFiltrosVM { PlaceholderBusqueda = Resources.Strings.AudIA_BuscarPlaceholder, PeriodoDefecto = "30" };
    if (verEmpresa)
    {
        vm.Campos.Add(new AudCampo
        {
            Id = "fEmpresa", Etiqueta = Resources.Strings.AudIA_LabelEmpresa, Icono = "fa-building",
            TextoTodos = Resources.Strings.AudIA_TodasEmpresas,
            Opciones = (empresasFiltro ?? new List<Empresas>()).Select(e => new SelectListItem { Value = e.Id.ToString(), Text = e.Nombre }).ToList()
        });
    }
    if (esAdmin || esAdminEmpresa)
    {
        // Las opciones las carga el JS (dependen de la empresa elegida).
        vm.Campos.Add(new AudCampo
        {
            Id = "fUsuario", Etiqueta = Resources.Strings.AudIA_LabelUsuario, Icono = "fa-user",
            TextoTodos = Resources.Strings.AudIA_TodosUsuarios
        });
    }
    vm.Campos.Add(new AudCampo
    {
        Id = "fTabla", Propio = true, Etiqueta = Resources.Strings.Ax_Tabla, Icono = "fa-table",
        TextoTodos = Resources.Strings.Ax_TodasTablas   // las opciones salen de los registros consultados
    });
    vm.Campos.Add(new AudCampo
    {
        Id = "fTipo", Propio = true, Etiqueta = Resources.Strings.AudIA_LabelTipo, Icono = "fa-tag",
        TextoTodos = Resources.Strings.AudIA_TodosTipos,
        Opciones = new List<SelectListItem>
        {
            new SelectListItem { Value = "resumen", Text = Resources.Strings.AudIA_TipoResumen },
            new SelectListItem { Value = "pregunta", Text = Resources.Strings.AudIA_TipoPregunta }
        }
    });
    vm.Avanzados.Add(new AudCampo
    {
        Id = "fValoracion", Propio = true, Etiqueta = Resources.Strings.Ax_Valoracion, Icono = "fa-thumbs-up",
        TextoTodos = Resources.Strings.Ax_TodasValoraciones,
        Opciones = new List<SelectListItem>
        {
            new SelectListItem { Value = "1", Text = Resources.Strings.Ax_Val_Util },
            new SelectListItem { Value = "0", Text = Resources.Strings.Ax_Val_NoUtil },
            new SelectListItem { Value = "sin", Text = Resources.Strings.Ax_Val_Sin }
        }
    });
}

<link href="~/Assets/css/bufins-components.css" rel="stylesheet" />
<link href="~/Assets/css/auditoria-shared.css" rel="stylesheet" />

<style>
/* Contenido del modal "Limpiar auditoría" (dentro de SweetAlert, tema oscuro) */
.aud-limp-wrap { text-align:left; }
.aud-limp-desc {
    font-size:.85rem; line-height:1.5; color:#9ca3af;
    margin:0 0 16px; padding-bottom:12px;
    border-bottom:1px solid rgba(255,255,255,.12);
}
.aud-limp-opt {
    display:flex; align-items:flex-start; gap:10px;
    padding:12px 14px; margin-bottom:10px;
    border:1.5px solid rgba(255,255,255,.16); border-radius:10px;
    cursor:pointer; transition:border-color .15s, background .15s;
}
.aud-limp-opt:last-child { margin-bottom:0; }
.aud-limp-opt:hover { border-color:rgba(139,125,255,.7); }
.aud-limp-opt.is-active { border-color:#8b7dff; background:rgba(88,58,255,.16); }
.aud-limp-opt > input[type=radio] { margin:3px 0 0; accent-color:#8b7dff; flex:0 0 auto; }
.aud-limp-opt-body { flex:1; min-width:0; }
.aud-limp-opt-title { display:block; font-weight:600; font-size:.92rem; color:#f3f4f6; }
.aud-limp-opt-hint  { display:block; font-size:.78rem; color:#9ca3af; margin-top:3px; }
.aud-limp-meses-row { display:flex; align-items:center; gap:8px; margin-top:10px; }
.aud-limp-meses-row label { margin:0; font-size:.8rem; color:#cbd5e1; }
.aud-limp-meses-input {
    width:88px; padding:6px 10px; font-size:.9rem; text-align:center;
    border:1.5px solid rgba(255,255,255,.25); border-radius:8px;
    background:rgba(255,255,255,.06); color:#f3f4f6;
}
.aud-limp-meses-input:focus { outline:none; border-color:#8b7dff; }
.aud-limp-meses-input:disabled { opacity:.4; cursor:not-allowed; }

/* Badges tipo */
.aud-tipo-badge {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: .72rem; font-weight: 700;
    padding: 3px 10px; border-radius: 99px; white-space: nowrap;
}
.aud-tipo-resumen  { background: #ede9fe; color: #583AFF; }
.aud-tipo-pregunta { background: #fce7f3; color: #be185d; }

/* Celda pregunta truncada */
.aud-pregunta-cell {
    max-width: 260px; white-space: nowrap;
    overflow: hidden; text-overflow: ellipsis;
    cursor: default; color: #4b5563; display: block;
}

/* Botón ver */
.aud-btn-ver {
    background: #eef2ff; border: 1px solid #c7d2fe;
    color: #583AFF; border-radius: 6px;
    padding: 4px 12px; font-size: .76rem; font-weight: 600;
    cursor: pointer; transition: background .15s; white-space: nowrap;
}
.aud-btn-ver:hover { background: #e0e7ff; }

/* ===== Modal "Respuesta del Asistente IA" (SweetAlert2, compacto) ===== */
.ia-resp-popup.swal2-popup { padding: 1rem 1.15rem 1.1rem; border-radius: 16px; }
.ia-resp-popup .swal2-title { font-size: 1rem; font-weight: 700; padding: 0 2rem .1rem 0; margin: 0; text-align: left; }
.ia-resp-popup .swal2-html-container { margin: .7rem 0 0; padding: 0; font-size: .85rem; overflow: visible; }
.ia-resp-popup .swal2-close { top: .5rem; right: .55rem; font-size: 1.5rem; }

.ia-dt { text-align: left; color: #E9E7F6; }
.ia-dt-meta { display: flex; flex-wrap: wrap; gap: .35rem; }
.ia-dt-chip {
    display: inline-flex; align-items: center; gap: .35rem; max-width: 100%;
    font: 500 .72rem/1 -apple-system, "Segoe UI", system-ui, sans-serif; padding: .3rem .6rem; border-radius: 999px;
    background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); color: #cfcbe6;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ia-dt-chip i { font-size: .72rem; opacity: .8; }
.ia-dt-chip.tipo-resumen  { color: #c6bfff; border-color: rgba(139,125,255,.45); background: rgba(139,125,255,.16); font-weight: 700; }
.ia-dt-chip.tipo-pregunta { color: #f9a8d4; border-color: rgba(244,114,182,.45); background: rgba(244,114,182,.14); font-weight: 700; }

.ia-dt-sec { margin-top: .75rem; }
.ia-dt-lbl { font: 700 .66rem/1 inherit; letter-spacing: .07em; text-transform: uppercase; color: #9993bd; margin-bottom: .35rem; display: flex; align-items: center; gap: .4rem; }
.ia-dt-q {
    background: rgba(88,58,255,.14); border-left: 3px solid #8b7dff; border-radius: 0 8px 8px 0;
    padding: .5rem .75rem; color: #fff; font-weight: 500; font-size: .86rem; line-height: 1.45;
    max-height: 4.9rem; overflow: auto; word-break: break-word;
}
.ia-dt-filtros { margin-top: .5rem; font-size: .74rem; color: #9993bd; display: flex; gap: .4rem; align-items: flex-start; }
.ia-dt-filtros i { margin-top: .15rem; }

.ia-dt-resp {
    background: #fff; color: #374151; border-radius: 10px; padding: .75rem .95rem;
    max-height: 46vh; overflow-y: auto; font-size: .84rem; line-height: 1.55;
}
.ia-dt-resp h3, .ia-dt-resp h4, .ia-dt-resp h5, .ia-dt-resp h6 { font-size: .92rem; margin: .7rem 0 .25rem !important; }
.ia-dt-resp h3:first-child, .ia-dt-resp h4:first-child { margin-top: 0 !important; }
.ia-dt-resp p { margin-bottom: .5rem !important; }
.ia-dt-resp strong { color: #1e1b4b; }
.ia-dt-resp table { font-size: .8rem !important; }
.ia-dt-foot { margin-top: .7rem; display: flex; justify-content: flex-end; }
.ia-dt-btn {
    display: inline-flex; align-items: center; gap: .4rem; font: 600 .74rem/1 inherit; padding: .42rem .8rem; border-radius: 7px; cursor: pointer;
    background: rgba(139,125,255,.14); border: 1px solid rgba(139,125,255,.4); color: #c6bfff; transition: background .15s;
}
.ia-dt-btn:hover { background: rgba(139,125,255,.26); }
</style>

<div class="container-fluid px-4">

    @Html.AntiForgeryToken()

    @if (!embed)
    {
        <!-- Header -->
        <div class="powerbi-header">
            <div class="powerbi-header-content">
                <i class="fas fa-history powerbi-header-icon"></i>
                <h1 class="powerbi-header-title">@Resources.Strings.AudIA_PageTitle</h1>
            </div>
        </div>
    }

    <div id="axKpis" class="ax-kpis" hidden></div>

    @Html.Partial("_AudFiltros", vm)

    <div id="axInicial" class="no-data-message">
        <i class="fas fa-robot"></i>
        <h4>@Resources.Strings.Ax_EstadoInicialTit</h4>
        <p>@Resources.Strings.Ax_EstadoInicialDesc</p>
    </div>

    <!-- Tabla de resultados -->
    <div id="audResultadosContainer" style="display:none;">
        <div class="table-container">
            <div class="table-header">
                <h5><i class="fas fa-list mr-2"></i>@Resources.Strings.AudIA_TitleHistorial</h5>
                <div class="d-flex align-items-center" style="gap:.6rem;flex-wrap:wrap;">
                    <span id="audStatTotal" class="info-badge">0</span>
                    <span id="audPaginaInfo" class="ax-info"></span>
                </div>
                <div class="ax-toolbar">
                    <button type="button" id="btnExportar" class="btn btn-modern-excel"><i class="fas fa-file-excel mr-1"></i>@Resources.Strings.Audit_BtnExportar</button>
                    <button type="button" id="btnImprimir" class="btn btn-modern-secondary"><i class="fas fa-print mr-1"></i>@Resources.Strings.Audit_BtnImprimir</button>
                    @if (esAdmin)
                    {
                        <button type="button" id="btnLimpiarAuditoria" class="btn btn-danger">
                            <i class="fas fa-trash-alt mr-1"></i>@Resources.Strings.AudIA_BtnLimpiarAuditoria
                        </button>
                    }
                </div>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th style="width:150px;">@Resources.Strings.AudIA_ThFecha</th>
                            <th style="min-width:130px;">@Resources.Strings.AudIA_ThUsuario</th>
                            @if (verEmpresa) { <th style="min-width:110px;">@Resources.Strings.AudIA_ThEmpresa</th> }
                            <th style="min-width:160px;">@Resources.Strings.AudIA_ThTablaFiltros</th>
                            <th style="width:110px;">@Resources.Strings.AudIA_ThTipo</th>
                            <th>@Resources.Strings.AudIA_ThPregunta</th>
                            <th style="width:65px;" class="text-center">@Resources.Strings.AudIA_ThFilas</th>
                            <th style="width:80px;" class="text-center">@Resources.Strings.AudIA_ThTokens</th>
                            <th style="width:70px;" class="text-center">@Resources.Strings.AudIA_ThValoracion</th>
                            <th style="width:80px;" class="text-center">@Resources.Strings.AudIA_ThVer</th>
                        </tr>
                    </thead>
                    <tbody id="audTbody"></tbody>
                </table>
            </div>
            <div id="audPaginacion" class="pagination-controls"></div>
        </div>
    </div>

    <!-- Sin resultados -->
    <div id="audSinResultados" class="no-data-message" style="display:none;">
        <i class="fas fa-robot"></i>
        <h4>@Resources.Strings.AudIA_SinResultados</h4>
        <p>@Resources.Strings.AudIA_SinResultadosTxt</p>
    </div>

</div>

@section scripts {
<script src="~/Assets/js/bufins-markdown.js"></script>
<script src="~/Assets/js/auditoria-shared.js"></script>
<script>
$(document).ready(function () {

    var esAdminJS        = @(esAdmin ? "true" : "false");
    var esAdminEmpresaJS = @(esAdminEmpresa ? "true" : "false");
    var verEmpresaJS     = @(verEmpresa ? "true" : "false");
    var PAGE_SIZE        = 25;
    var RESUMEN          = '(Resumen Gerencial)';
    var _todosRegistros  = [];
    var _filtrados       = [];

    var _strTodosUsuarios  = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_TodosUsuarios))';
    var _strErrorHistorial = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_JS_ErrorHistorial))';
    var _strBadgeResumen   = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_BadgeResumen))';
    var _strBadgePregunta  = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_BadgePregunta))';
    var _strResumenAuto    = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_ResumenAuto))';
    var _strPreguntaRealiz = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LabelPreguntaRealiz))';
    var _strTipoRG         = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LabelTipoRG))';
    var _strTitleRespuesta = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_TitleRespuesta))';
    var _strVer            = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_ThVer))';
    var _strError          = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Error))';
    var _strExito          = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Exito))';
    var _strTotal          = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_TotalRegistros))';
    var _strTipo           = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LabelTipo))';
    var _strTabla          = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Ax_Tabla))';
    var _strThFecha        = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_ThFecha))';
    var _strThUsuario      = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_ThUsuario))';
    var _strThEmpresa      = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_ThEmpresa))';
    var _strThTokens       = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_ThTokens))';
    var _strThFilas        = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_ThFilas))';
    var _strCopiar         = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Copiar))';
    var _strCopiado        = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Copiado))';
    var _strFiltros        = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Ax_Filtros))';
    var _strKConsultas     = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Ax_K_Consultas))';
    var _strKUsuarios      = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Ax_K_Usuarios))';
    var _strKTokens        = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Ax_K_Tokens))';
    var _strKUtiles        = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Ax_K_Utiles))';
    var _strTodasTablas    = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Ax_TodasTablas))';

    var _limp = {
        titulo:          '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarTitulo))',
        desc:            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarDesc))',
        opcionTodo:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarOpcionTodo))',
        opcionTodoHint:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarOpcionTodoHint))',
        opcionConservar:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarOpcionConservar))',
        opcionConservarHint:'@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarOpcionConservarHint))',
        mesesLabel:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarMesesLabel))',
        confirmarBtn:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarConfirmarBtn))',
        cancelarBtn:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarCancelarBtn))',
        mesesInvalido:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarMesesInvalido))',
        confirmTodo:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarConfirmTodo))',
        confirmConservar:'@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarConfirmConservar))',
        exito:           '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarExito))',
        errorMsg:        '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.AudIA_LimpiarError))'
    };

    function esc(s) { return $('<div>').text(s == null ? '' : s).html(); }

    /* ── Controles ── */
    AudKit.periodo.init();
    AudKit.masFiltros();
    AudKit.enter(consultarServidor);

    /* ── Estado inicial: no se consulta ni se muestra nada hasta pulsar «Consultar» ──
       (solo se cargan las opciones del selector de usuarios; no son datos de auditoría). */
    estadoInicial();
    if (esAdminEmpresaJS || esAdminJS) cargarUsuarios(null);

    // Excepción: el enlace permanente ?ia=<id> (p. ej. desde una notificación) abre esa consulta. Puede ser anterior al
    // período por defecto, así que se busca sin límite de fechas.
    if (/[?&]ia=(\d+)/.test(location.search)) {
        $('#fPeriodo .ax-chip-per[data-range="custom"]').trigger('click');
        consultarServidor();
    }

    $('#btnConsultar').on('click', consultarServidor);
    $('#btnLimpiar').on('click', function () {
        AudKit.filtros.limpiar();
        if (esAdminJS || esAdminEmpresaJS) cargarUsuarios(null);
        estadoInicial();
    });
    $('#btnImprimir').on('click', function () { AudKit.imprimir('#audResultadosContainer .table-container', document.title); });
    $('#btnExportar').on('click', function () {
        var r = AudKit.periodo.rango();
        window.location = '@Url.Action("ExportarExcel", "AuditoriaConsultasIA")' + '?' + $.param({
            idEmpresa: $('#fEmpresa').val() || '', idUsuario: $('#fUsuario').val() || '',
            desde: r.desde, hasta: r.hasta,
            tipo: $('#fTipo').val() || '', tabla: $('#fTabla').val() || '',
            valoracion: $('#fValoracion').val() || '', texto: $.trim($('#fTexto').val())
        });
    });

    /* ── Empresa cambia → recargar usuarios ── */
    $('#fEmpresa').on('change', function () { cargarUsuarios($(this).val() || null); });

    /* ── Limpiar auditoría (solo Super Admin) ── */
    $('#btnLimpiarAuditoria').on('click', function () {
        Swal.fire({
            title: _limp.titulo,
            html:
                '<div class="aud-limp-wrap">' +
                  '<p class="aud-limp-desc">' + _limp.desc + '</p>' +
                  '<label class="aud-limp-opt is-active" data-modo="todo">' +
                    '<input type="radio" name="audLimpModo" value="todo" checked>' +
                    '<span class="aud-limp-opt-body">' +
                      '<span class="aud-limp-opt-title">' + _limp.opcionTodo + '</span>' +
                      '<span class="aud-limp-opt-hint">' + _limp.opcionTodoHint + '</span>' +
                    '</span>' +
                  '</label>' +
                  '<label class="aud-limp-opt" data-modo="conservar">' +
                    '<input type="radio" name="audLimpModo" value="conservar">' +
                    '<span class="aud-limp-opt-body">' +
                      '<span class="aud-limp-opt-title">' + _limp.opcionConservar + '</span>' +
                      '<span class="aud-limp-opt-hint">' + _limp.opcionConservarHint + '</span>' +
                      '<span class="aud-limp-meses-row">' +
                        '<label for="audLimpMeses">' + _limp.mesesLabel + '</label>' +
                        '<input type="number" id="audLimpMeses" class="aud-limp-meses-input" min="1" max="120" value="6" disabled>' +
                      '</span>' +
                    '</span>' +
                  '</label>' +
                '</div>',
            focusConfirm: false,
            showCancelButton: true,
            confirmButtonText: _limp.confirmarBtn,
            cancelButtonText: _limp.cancelarBtn,
            confirmButtonColor: '#e74c3c',
            reverseButtons: true,
            didOpen: function () {
                var popup      = Swal.getPopup();
                var mesesInput = popup.querySelector('#audLimpMeses');
                var opciones   = popup.querySelectorAll('.aud-limp-opt');
                var radios     = popup.querySelectorAll('input[name="audLimpModo"]');

                function sincronizar() {
                    var sel = popup.querySelector('input[name="audLimpModo"]:checked');
                    var modo = sel ? sel.value : 'todo';
                    opciones.forEach(function (o) {
                        o.classList.toggle('is-active', o.getAttribute('data-modo') === modo);
                    });
                    mesesInput.disabled = (modo !== 'conservar');
                }

                radios.forEach(function (r) { r.addEventListener('change', sincronizar); });
                // Enfocar el campo de meses activa automáticamente "conservar"
                mesesInput.addEventListener('focus', function () {
                    popup.querySelector('input[name="audLimpModo"][value="conservar"]').checked = true;
                    sincronizar();
                });
                sincronizar();
            },
            preConfirm: function () {
                var sel = document.querySelector('input[name="audLimpModo"]:checked');
                var modo = sel ? sel.value : 'todo';
                if (modo === 'conservar') {
                    var m = parseInt(document.getElementById('audLimpMeses').value, 10);
                    if (isNaN(m) || m < 1 || m > 120) {
                        Swal.showValidationMessage(_limp.mesesInvalido);
                        return false;
                    }
                    return { completo: false, meses: m };
                }
                return { completo: true, meses: null };
            }
        }).then(function (res) {
            if (!res.isConfirmed) return;
            var opts = res.value;
            var texto = opts.completo
                ? _limp.confirmTodo
                : _limp.confirmConservar.replace('{0}', opts.meses);

            Swal.fire({
                title: _limp.titulo,
                text: texto,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: _limp.confirmarBtn,
                cancelButtonText: _limp.cancelarBtn,
                confirmButtonColor: '#e74c3c',
                reverseButtons: true
            }).then(function (c) {
                if (!c.isConfirmed) return;
                var token = $('input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '@Url.Action("LimpiarAuditoria","AuditoriaConsultasIA")',
                    type: 'POST',
                    data: {
                        completo: opts.completo,
                        meses: opts.meses,
                        __RequestVerificationToken: token
                    },
                    success: function (r) {
                        if (r && r.success) {
                            Swal.fire({
                                icon: 'success',
                                title: _strExito,
                                text: _limp.exito.replace('{0}', r.eliminados)
                            });
                            estadoInicial();
                        } else {
                            Swal.fire({ icon: 'error', title: _strError, text: (r && r.message) || _limp.errorMsg });
                        }
                    },
                    error: function () {
                        Swal.fire({ icon: 'error', title: _strError, text: _limp.errorMsg });
                    }
                });
            });
        });
    });

    /* ── Cargar usuarios ── */
    function cargarUsuarios(idEmpresa) {
        var params = {};
        if (idEmpresa) params.idEmpresa = idEmpresa;
        $.get('@Url.Action("ObtenerUsuariosAuditoria","AuditoriaConsultasIA")', params, function (lista) {
            var sel = $('#fUsuario').html('<option value="">' + _strTodosUsuarios + '</option>');
            $.each(lista, function (i, u) { sel.append($('<option>').val(u.Id).text(u.Nombre)); });
        });
    }

    /* ── Consulta al servidor (empresa, usuario, período) + filtros locales (tabla, tipo, valoración, texto) ── */
    function consultarServidor() {
        var params  = {};
        var empresa = $('#fEmpresa').val();
        var usuario = $('#fUsuario').val();
        var r       = AudKit.periodo.rango();
        if (empresa) params.idEmpresa = empresa;
        if (usuario) params.idUsuario = usuario;
        if (r.desde) params.desde     = r.desde;
        if (r.hasta) params.hasta     = r.hasta;

        mostrarEsqueleto();

        $.ajax({
            url  : '@Url.Action("ObtenerAuditoria","AuditoriaConsultasIA")',
            type : 'GET',
            data : params,
            success: function (registros) {
                _todosRegistros = registros || [];
                poblarTablas();
                aplicarFiltrosLocales();
                abrirDeepLinkIA();
            },
            error: function () {
                $('#audResultadosContainer').hide();
                Swal.fire({ icon: 'error', title: _strError, text: _strErrorHistorial });
            }
        });
    }

    /* Las tablas analizadas disponibles salen de los registros consultados; se conserva la selección si sigue existiendo. */
    function poblarTablas() {
        var $s = $('#fTabla');
        var actual = $s.val() || '';
        var nombres = {};
        _todosRegistros.forEach(function (r) { if (r.NombreTabla) nombres[r.NombreTabla] = 1; });
        $s.empty().append($('<option value="">').text(_strTodasTablas));
        Object.keys(nombres).sort().forEach(function (n) { $s.append($('<option>').val(n).text(n)); });
        if (actual && nombres[actual]) $s.val(actual);
    }

    /* ── Enlace permanente: ?ia=<id> abre esa consulta al cargar ── */
    var _deepLinkIAHecho = false;
    function abrirDeepLinkIA() {
        if (_deepLinkIAHecho) return;
        var m = /[?&]ia=(\d+)/.exec(location.search);
        if (!m) return;
        _deepLinkIAHecho = true;
        for (var i = 0; i < _todosRegistros.length; i++) {
            if (String(_todosRegistros[i].Id) === m[1]) {
                verRespuesta(_todosRegistros[i]);
                return;
            }
        }
    }

    function estadoInicial() {
        _todosRegistros = []; _filtrados = [];
        $('#audTbody').empty();
        $('#audPaginacion').empty();
        $('#audPaginaInfo').text('');
        $('#audResultadosContainer').hide();
        $('#audSinResultados').hide();
        AudKit.kpis.render($('#axKpis'), []);
        AudKit.chips.render($('#axChips'), []);
        $('#axInicial').show();
    }

    /* ── Filas "esqueleto" mientras se consulta ── */
    function mostrarEsqueleto() {
        AudKit.esqueleto($('#audTbody'), @(verEmpresa ? 10 : 9), 6);
        $('#axInicial').hide();
        $('#audSinResultados').hide();
        $('#audPaginaInfo').text('');
        $('#audPaginacion').empty();
        $('#audResultadosContainer').show();
    }

    /* ── Filtros locales ── */
    function aplicarFiltrosLocales() {
        var tipo  = $('#fTipo').val();
        var tabla = $('#fTabla').val();
        var val   = $('#fValoracion').val();
        var texto = ($.trim($('#fTexto').val()) || '').toLowerCase();

        _filtrados = _todosRegistros.filter(function (r) {
            var esResumen = r.Pregunta === RESUMEN;
            if (tipo === 'resumen'  && !esResumen) return false;
            if (tipo === 'pregunta' &&  esResumen) return false;
            if (tabla && r.NombreTabla !== tabla) return false;
            if (val === '1'   && r.Valoracion !== 1) return false;
            if (val === '0'   && r.Valoracion !== 0) return false;
            if (val === 'sin' && r.Valoracion !== null && r.Valoracion !== undefined) return false;
            if (texto) {
                var match =
                    (r.Pregunta      || '').toLowerCase().indexOf(texto) >= 0 ||
                    (r.NombreTabla   || '').toLowerCase().indexOf(texto) >= 0 ||
                    (r.NombreUsuario || '').toLowerCase().indexOf(texto) >= 0 ||
                    (r.NombreEmpresa || '').toLowerCase().indexOf(texto) >= 0 ||
                    (r.Filtros       || '').toLowerCase().indexOf(texto) >= 0;
                if (!match) return false;
            }
            return true;
        });

        AudKit.filtros.chips(consultarServidor);
        pintarKpis();
        renderPagina(1);
    }

    /* ── Tarjetas de resumen ── */
    function pintarKpis() {
        var usuarios = {}, tokens = 0, valoradas = 0, utiles = 0;
        _filtrados.forEach(function (r) {
            usuarios[r.NombreUsuario] = 1;
            tokens += Number(r.TokensTotal || 0);
            if (r.Valoracion === 1 || r.Valoracion === 0) { valoradas++; if (r.Valoracion === 1) utiles++; }
        });
        AudKit.kpis.render($('#axKpis'), [
            { label: _strKConsultas, valor: AudKit.num(_filtrados.length) },
            { label: _strKUsuarios,  valor: AudKit.num(Object.keys(usuarios).length) },
            { label: _strKTokens,    valor: AudKit.num(tokens) },
            { label: _strKUtiles,    valor: valoradas ? Math.round(utiles * 100 / valoradas) + ' %' : '—' }
        ]);
    }

    /* ── Render tabla paginada ── */
    function renderPagina(pagina) {
        var totalPags = Math.max(1, Math.ceil(_filtrados.length / PAGE_SIZE));
        pagina = Math.min(Math.max(1, pagina), totalPags);

        var inicio = (pagina - 1) * PAGE_SIZE;
        var slice  = _filtrados.slice(inicio, inicio + PAGE_SIZE);

        $('#audStatTotal').text(AudKit.num(_filtrados.length) + ' ' + _strTotal);
        $('#audPaginaInfo').text(AudKit.pager.info(pagina, PAGE_SIZE, _filtrados.length));

        var tbody = $('#audTbody').empty();

        if (_filtrados.length === 0) {
            $('#audResultadosContainer').hide();
            $('#audSinResultados').show();
            $('#audPaginacion').empty();
            return;
        }

        $('#audSinResultados').hide();
        $('#audResultadosContainer').show();

        $.each(slice, function (i, r) {
            var esResumen = r.Pregunta === RESUMEN;

            var tipoBadge = esResumen
                ? '<span class="aud-tipo-badge aud-tipo-resumen"><i class="fas fa-magic"></i> ' + _strBadgeResumen + '</span>'
                : '<span class="aud-tipo-badge aud-tipo-pregunta"><i class="fas fa-question-circle"></i> ' + _strBadgePregunta + '</span>';

            var preguntaHtml = esResumen
                ? '<em style="color:#6b7280;font-size:.8rem;">' + _strResumenAuto + '</em>'
                : '<span class="aud-pregunta-cell" title="' + esc(r.Pregunta) + '">' + esc(r.Pregunta) + '</span>';

            var btnVer = $('<button type="button" class="aud-btn-ver">')
                .html('<i class="fas fa-eye mr-1"></i>' + _strVer)
                .on('click', function () { verRespuesta(r); });

            var tr = $('<tr>');
            tr.append($('<td>').css({ whiteSpace: 'nowrap', fontSize: '.8rem', color: '#6b7280' }).text(r.FechaPregunta));
            tr.append($('<td>').css('font-weight', '600').text(r.NombreUsuario));
            if (verEmpresaJS) tr.append($('<td>').text(r.NombreEmpresa));
            tr.append($('<td>').html(
                '<span style="font-weight:600;">' + esc(r.NombreTabla) + '</span>'
                + (r.Filtros ? '<br><small style="color:#6b7280;font-size:.74rem;">' + esc(r.Filtros) + '</small>' : '')
            ));
            tr.append($('<td>').html(tipoBadge));
            tr.append($('<td>').html(preguntaHtml));
            tr.append($('<td class="text-center">').css({ fontWeight: '700', color: '#583AFF' }).text(r.FilasAnalizadas));
            tr.append($('<td class="text-center">').css({ fontSize: '.8rem', color: '#6b7280' }).text(r.TokensTotal ? Number(r.TokensTotal).toLocaleString() : '—'));
            tr.append($('<td class="text-center">').html(
                r.Valoracion === 1 ? '<i class="fas fa-thumbs-up" style="color:#22c55e;"></i>'
                : (r.Valoracion === 0 ? '<i class="fas fa-thumbs-down" style="color:#ef4444;"></i>' : '<span style="color:#9ca3af;">—</span>')));
            tr.append($('<td class="text-center">').append(btnVer));
            tbody.append(tr);
        });

        AudKit.pager.render($('#audPaginacion'), pagina, totalPags, renderPagina);
    }

    /* ── Ver respuesta completa (modal compacto) ── */
    function verRespuesta(r) {
        var esResumen = r.Pregunta === RESUMEN;

        function chip(ico, txt, titulo, cls) {
            return txt ? '<span class="ia-dt-chip ' + (cls || '') + '" title="' + esc(titulo || '') + '"><i class="fas ' + ico + '"></i>' + esc(txt) + '</span>' : '';
        }
        var val = r.Valoracion === 1 ? '<span class="ia-dt-chip" style="color:#86efac;border-color:rgba(134,239,172,.4);"><i class="fas fa-thumbs-up"></i></span>'
                : (r.Valoracion === 0 ? '<span class="ia-dt-chip" style="color:#fca5a5;border-color:rgba(252,165,165,.4);"><i class="fas fa-thumbs-down"></i></span>' : '');

        var html = '<div class="ia-dt">'
            + '<div class="ia-dt-meta">'
            +   (esResumen ? chip('fa-magic', _strBadgeResumen, _strTipo, 'tipo-resumen') : chip('fa-question-circle', _strBadgePregunta, _strTipo, 'tipo-pregunta'))
            +   chip('fa-table', r.NombreTabla, _strTabla)
            +   chip('fa-user', r.NombreUsuario, _strThUsuario)
            +   (verEmpresaJS ? chip('fa-building', r.NombreEmpresa, _strThEmpresa) : '')
            +   chip('fa-calendar-alt', r.FechaPregunta, _strThFecha)
            +   (r.TokensTotal ? chip('fa-coins', Number(r.TokensTotal).toLocaleString(), _strThTokens) : '')
            +   (r.FilasAnalizadas ? chip('fa-stream', Number(r.FilasAnalizadas).toLocaleString(), _strThFilas) : '')
            +   val
            + '</div>';

        if (!esResumen) {
            html += '<div class="ia-dt-sec"><div class="ia-dt-lbl"><i class="fas fa-question-circle"></i>' + _strPreguntaRealiz + '</div>'
                  + '<div class="ia-dt-q">' + esc(r.Pregunta) + '</div></div>';
        }
        if (r.Filtros) {
            html += '<div class="ia-dt-filtros"><i class="fas fa-filter"></i><span>' + esc(r.Filtros) + '</span></div>';
        }

        html += '<div class="ia-dt-sec"><div class="ia-dt-resp">' + renderMarkdown(r.Respuesta) + '</div></div>'
              + '<div class="ia-dt-foot"><button type="button" class="ia-dt-btn" id="iaCopiarResp"><i class="far fa-copy"></i>' + _strCopiar + '</button></div>'
              + '</div>';

        Swal.fire({
            title            : _strTitleRespuesta,
            html             : html,
            width            : '640px',
            showCloseButton  : true,
            showConfirmButton: false,
            customClass      : { popup: 'ia-resp-popup' },
            didOpen          : function (popup) {
                var btn = popup.querySelector('#iaCopiarResp');
                if (!btn) return;
                btn.addEventListener('click', function () {
                    var texto = r.Respuesta || '';
                    var ok = function () {
                        var prev = btn.innerHTML;
                        btn.innerHTML = '<i class="fas fa-check"></i>' + _strCopiado;
                        setTimeout(function () { btn.innerHTML = prev; }, 1300);
                    };
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(texto).then(ok, function () {});
                    } else {
                        var ta = document.createElement('textarea');
                        ta.value = texto; document.body.appendChild(ta); ta.select();
                        try { document.execCommand('copy'); ok(); } catch (e) {}
                        document.body.removeChild(ta);
                    }
                });
            }
        });
    }

    /* ── Markdown renderer ──
       Lo aporta ~/Assets/js/bufins-markdown.js (window.renderMarkdown). Fallback mínimo
       por si el archivo no cargó. */
    function renderMarkdown(text) {
        if (typeof window.bufinsMarkdown === 'function') return window.bufinsMarkdown(text);
        return text ? $('<div>').text(text).html().replace(/\n/g, '<br>') : '';
    }

});
</script>
}
