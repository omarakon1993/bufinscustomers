    // Construidos con fromCharCode (no como literales en el archivo) para no depender de
    // como el compilador de Razor decida leer bytes no-ASCII en este .cshtml.
    var CH_UP = String.fromCharCode(0x25B2), CH_DOWN = String.fromCharCode(0x25BC),
        CH_MDASH = String.fromCharCode(0x2014), CH_NDASH = String.fromCharCode(0x2013),
