@model dynamic
@using System.Web
@using bufinscustomers.Models
@{
    ViewBag.Title = Resources.Strings.LineaTiempo_PageTitle;
    var tablas   = ViewBag.Tablas as List<TablaDatos>;
    var empresas = ViewBag.Empresas as List<Empresas>;
    var esAdmin  = (bool)ViewBag.EsAdmin;
    var culturaJs = System.Globalization.CultureInfo.CurrentUICulture.Name;
}

<link href="~/Assets/css/bufins-components.css" rel="stylesheet" />
<link href="~/Assets/css/informe-linea-tiempo.css" rel="stylesheet" />
<link href="~/Assets/css/select2/select2.min.css" rel="stylesheet" />

<style>
    .lt-app {
        --lt-bg: #F4F4FA;
        --lt-surface: #FFFFFF;
        --lt-surface-2: #F4F3FB;
        --lt-text: #16121F;
        --lt-text-2: #5B5570;
        --lt-text-muted: #8B85A0;
        --lt-line: #E4E1F0;
        --lt-brand-gradient: linear-gradient(90deg,#6366F1 0%,#3B82F6 35%,#06B6D4 70%,#01E1D7 100%);
        --lt-series-1: #6366F1;
        --lt-series-2: #D97706;
        --lt-good: #16A34A;
        --lt-good-bg: #ECFDF3;
        --lt-bad: #DC2626;
        --lt-bad-bg: #FEF2F2;
        --lt-shadow: 0 1px 2px rgba(22,9,51,.05), 0 10px 28px -10px rgba(22,9,51,.14);
        max-width: 1080px;
        margin: 0 0 40px;
        color: var(--lt-text);
        font-size: 15px;
    }


    .lt-card { background: var(--lt-surface); border: 1px solid var(--lt-line); border-radius: 14px; padding: 16px 20px; margin-bottom: 16px; box-shadow: var(--lt-shadow); }

    .lt-btn { font-size: 12.5px; font-weight: 700; border-radius: 8px; padding: 8px 16px; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
    .lt-btn:disabled { opacity: .5; cursor: not-allowed; }
    .lt-btn-excel { background: #217346; color: #fff; }
    .lt-btn-pdf { background: #B91C1C; color: #fff; }
    .lt-btn-icon { padding: 9px 11px; font-size: 13px; }

    .lt-kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-bottom: 16px; }
    .lt-stat-tile { background: var(--lt-surface); border: 1px solid var(--lt-line); border-radius: 14px; padding: 16px 18px; box-shadow: var(--lt-shadow); }
    .lt-stat-label { font-size: 12px; font-weight: 600; color: var(--lt-text-muted); text-transform: uppercase; letter-spacing: .03em; }
    .lt-stat-value { font-size: 26px; font-weight: 800; margin: 6px 0 4px; letter-spacing: -.01em; }
    .lt-stat-delta { font-size: 12.5px; font-weight: 700; display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 999px; }
    .lt-stat-delta.up { color: var(--lt-good); background: var(--lt-good-bg); }
    .lt-stat-delta.down { color: var(--lt-bad); background: var(--lt-bad-bg); }

    .lt-letterhead { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding-bottom: 10px; margin-bottom: 10px; border-bottom: 1px solid var(--lt-line); }
    .lt-brand-mark { display: inline-flex; align-items: center; gap: 6px; }
    .lt-brand-mark .bm-icon { width: 20px; height: 20px; border-radius: 6px; background: var(--lt-brand-gradient); color: #fff; font-weight: 800; font-size: 11px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .lt-brand-mark .bm-text { font-size: 12.5px; font-weight: 800; letter-spacing: .01em; background: var(--lt-brand-gradient); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .lt-letterhead .fecha { font-size: 11px; color: var(--lt-text-muted); }

    .lt-chart-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 6px; flex-wrap: wrap; }
    .lt-chart-head h2 { margin: 0; font-size: 16.5px; font-weight: 800; }
    .lt-muted { color: var(--lt-text-muted); font-size: 12.5px; margin: 3px 0 0; }
    .lt-toggles { display: flex; gap: 8px; flex-shrink: 0; flex-wrap: wrap; }

    .lt-seg-toggle { display: flex; background: var(--lt-surface-2); border: 1px solid var(--lt-line); border-radius: 9px; padding: 3px; }
    .lt-seg-toggle button { font-size: 12.5px; font-weight: 700; color: var(--lt-text-2); background: transparent; border: none; border-radius: 7px; padding: 6px 13px; cursor: pointer; }
    .lt-seg-toggle button.active { background: var(--lt-brand-gradient); color: #fff; }
    .lt-seg-toggle button:disabled { opacity: .4; cursor: not-allowed; }

    /* Altura fija: evita que el gráfico "colapse" al cambiar entre línea/barra o unidad */
    .lt-chart-canvas-wrap { position: relative; height: 380px; }
    .lt-chart-canvas-wrap canvas { width: 100% !important; height: 100% !important; }
    @@media (max-width: 640px) { .lt-chart-canvas-wrap { height: 300px; } }

    .lt-table-wrap { overflow-x: auto; border: 1px solid var(--lt-line); border-radius: 10px; }
    .lt-table-wrap table { width: 100%; border-collapse: collapse; min-width: 480px; }
    .lt-table-wrap thead th { background: var(--lt-brand-gradient); color: #fff; text-align: left; font-size: 12px; font-weight: 700; padding: 10px 14px; white-space: nowrap; }
    .lt-table-wrap tbody td { padding: 9px 14px; font-size: 13px; border-top: 1px solid var(--lt-line); font-variant-numeric: tabular-nums; }
    .lt-table-wrap tbody tr:nth-child(even) { background: var(--lt-surface-2); }
    .lt-table-wrap td.num { text-align: right; }
    .lt-var-chip { display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; font-weight: 700; padding: 2px 8px; border-radius: 999px; }
    .lt-var-chip.up { color: var(--lt-good); background: var(--lt-good-bg); }
    .lt-var-chip.down { color: var(--lt-bad); background: var(--lt-bad-bg); }

    .lt-empty { text-align: center; padding: 3rem 1.5rem; color: var(--lt-text-muted); }
    .lt-empty .lt-empty-icon {
        width: 64px; height: 64px; margin: 0 auto 1.1rem; border-radius: 50%;
        background: linear-gradient(135deg, rgba(99,102,241,.14), rgba(1,225,215,.14));
        display: flex; align-items: center; justify-content: center;
    }
    .lt-empty .lt-empty-icon i { font-size: 1.7rem; background: var(--lt-brand-gradient); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .lt-empty h4 { color: var(--lt-text); font-size: 16px; font-weight: 800; margin: 0 0 .4rem; }
    .lt-empty p { font-size: 13px; max-width: 420px; margin: 0 auto; line-height: 1.5; }

    @@media (max-width: 640px) {
        .lt-kpis { grid-template-columns: 1fr; }
        .lt-chart-head { flex-direction: column; }
    }
</style>

<div class="container-fluid px-4">
<div class="lt-app">

    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas fa-chart-line powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@Resources.Strings.LineaTiempo_PageTitle</h1>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <div class="filter-card">
        <div class="lt-section-title"><span>@Resources.Strings.LineaTiempo_FilaQueVer</span></div>
        <div class="lt-grid-5" id="ltGridRow1">
            <div class="lt-field"><label class="lt-field-label" for="ltEmpresa">@Resources.Strings.LineaTiempo_LabelEmpresa</label>
                <select id="ltEmpresa" class="lt-field-select">
                    @if (esAdmin) { <option value="">@Resources.Strings.Common_Seleccione</option> }
                    @if (empresas != null)
                    {
                        foreach (var e in empresas)
                        {
                            <option value="@e.Id">@e.Nombre</option>
                        }
                    }
                </select>
            </div>
            <div class="lt-field"><label class="lt-field-label" for="ltTabla">@Resources.Strings.LineaTiempo_LabelTabla</label>
                <select id="ltTabla" class="lt-field-select">
                    <option value="">@Resources.Strings.Common_Seleccione</option>
                    @if (tablas != null)
                    {
                        foreach (var t in tablas)
                        {
                            <option value="@t.NombreTabla">@t.NombreAmigable</option>
                        }
                    }
                </select>
            </div>
            <div class="lt-field"><label class="lt-field-label" for="ltIndicador">@Resources.Strings.LineaTiempo_LabelIndicador</label>
                <select id="ltIndicador" class="lt-field-select" disabled>
                    <option value="">@Resources.Strings.Common_Seleccione</option>
                </select>
            </div>
            <div class="lt-field" id="ltCampoWrap" style="display:none;"><label class="lt-field-label" for="ltCampo">@Resources.Strings.LineaTiempo_LabelCampo</label>
                <select id="ltCampo" class="lt-field-select"></select>
            </div>
            <div class="lt-field"><label class="lt-field-label" for="ltEscenario">@Resources.Strings.LineaTiempo_LabelEscenario</label>
                <select id="ltEscenario" class="lt-field-select">
                    @if (ViewBag.Escenarios != null)
                    {
                        foreach (var esc in ViewBag.Escenarios)
                        {
                            <option value="@esc.Id">@esc.Nombre</option>
                        }
                    }
                </select>
            </div>
        </div>

        <div class="lt-tabla-banner" id="ltTablaDescBox" style="display:none;">
            <i class="ic" id="ltTablaDescIcon"></i>
            <div><b id="ltTablaDescNombre"></b> &mdash; <span id="ltTablaDescTexto"></span></div>
        </div>

        <div class="lt-tabla-banner warning" id="ltSinDatosModeloBox" style="display:none;" title="@Resources.Strings.LineaTiempo_SinDatosModelo">
            <i class="ic fas fa-exclamation-triangle"></i>
            <div>@Resources.Strings.LineaTiempo_SinDatosModelo</div>
        </div>

        <div class="lt-section-title mt"><span>@Resources.Strings.LineaTiempo_FilaCuando</span></div>
        <div class="lt-grid-rango">
            <div>
                <label class="lt-field-label">@Resources.Strings.LineaTiempo_LabelVerPor</label>
                <div class="lt-seg" id="ltSegVerPor">
                    <button type="button" class="active" data-modo="Mes" title="@Resources.Strings.LineaTiempo_Agrupar_MesAyuda" aria-pressed="true">
                        <i class="fas fa-calendar-day"></i><span>@Resources.Strings.LineaTiempo_VerPorMes</span>
                    </button>
                    <button type="button" data-modo="Trimestre" title="@Resources.Strings.LineaTiempo_Agrupar_TrimestreAyuda" aria-pressed="false">
                        <i class="fas fa-calendar-week"></i><span>@Resources.Strings.LineaTiempo_VerPorTrimestre</span>
                    </button>
                    <button type="button" data-modo="Anio" title="@Resources.Strings.LineaTiempo_Agrupar_AnioAyuda" aria-pressed="false">
                        <i class="fas fa-calendar"></i><span>@Resources.Strings.LineaTiempo_VerPorAnio</span>
                    </button>
                </div>
                <p class="lt-seg-hint" id="ltAgruparHint">@Resources.Strings.LineaTiempo_Agrupar_MesAyuda</p>
            </div>
            <div>
                <div class="lt-rango-head-row">
                    <label class="lt-field-label">@Resources.Strings.LineaTiempo_LabelRango</label>
                    <div class="lt-atajos" id="ltAtajos">
                        <button type="button" class="lt-chip" data-preset="todo">@Resources.Strings.LineaTiempo_RangoTodo</button>
                        <button type="button" class="lt-chip" data-preset="12m">@Resources.Strings.LineaTiempo_RangoUltimoAnio</button>
                        <button type="button" class="lt-chip" data-preset="6m">@Resources.Strings.LineaTiempo_RangoUltimos6Meses</button>
                    </div>
                </div>
                <div class="lt-range-card">
                    <div class="lt-range-head">
                        <span class="lbl"><span id="ltRangoDesdeLbl">&mdash;</span><i class="fas fa-long-arrow-alt-right"></i><span id="ltRangoHastaLbl">&mdash;</span></span>
                        <span class="lt-range-badge" id="ltRangoBadge">&mdash;</span>
                    </div>
                    <div class="lt-range-track disabled" id="ltRangoTrack">
                        <div class="bg"></div>
                        <div class="sel" id="ltRangoSel"></div>
                        <div class="knob from" id="ltKnobFrom" tabindex="0" role="slider" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" aria-label="@Resources.Strings.LineaTiempo_RangoTodo"></div>
                        <div class="knob to" id="ltKnobTo" tabindex="0" role="slider" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" aria-label="@Resources.Strings.LineaTiempo_RangoTodo"></div>
                    </div>
                    <div class="lt-range-years" id="ltRangoYears"></div>
                </div>
                <p class="lt-help">@Resources.Strings.LineaTiempo_FilaCuandoHint</p>
            </div>
        </div>

        <div class="lt-actions-bar">
            <button type="button" class="lt-comparar-toggle" id="ltBtnToggleComparar">
                <i class="fas fa-chevron-right chev"></i>
                @Resources.Strings.LineaTiempo_ComparaEscenario
            </button>
            <div class="lt-comparar-panel" id="ltCompararPanel" hidden>
                <div class="lt-field"><label class="lt-field-label" for="ltEscenarioComparar">@Resources.Strings.LineaTiempo_LabelEscenarioComparar</label>
                    <select id="ltEscenarioComparar" class="lt-field-select">
                        <option value="">@Resources.Strings.LineaTiempo_CompararNinguna</option>
                        @if (ViewBag.Escenarios != null)
                        {
                            foreach (var esc in ViewBag.Escenarios)
                            {
                                <option value="@esc.Id">@esc.Nombre</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="btn-group-actions">
                <button type="button" id="btnGenerarLT" class="btn btn-modern-gradient" disabled>
                    <i class="fas fa-arrow-right mr-1"></i>@Resources.Strings.LineaTiempo_BtnGenerar
                </button>
                <button type="button" id="btnLimpiarLT" class="btn btn-modern-secondary">@Resources.Strings.Common_Limpiar</button>
            </div>
        </div>
    </div>

    <div id="ltEstadoInicial" class="lt-card lt-empty">
        <div class="lt-empty-icon"><i class="fas fa-chart-line"></i></div>
        <h4>@Resources.Strings.LineaTiempo_EstadoInicialTitulo</h4>
        <p>@Resources.Strings.LineaTiempo_EstadoInicialDesc</p>
    </div>

    <div id="ltLoading" class="lt-card lt-empty" style="display:none;">
        <div class="spinner-border text-primary" style="width:2.5rem;height:2.5rem;" role="status"></div>
        <p class="mt-3">@Resources.Strings.LineaTiempo_JS_Consultando</p>
    </div>

    <div id="ltSinDatos" class="lt-card lt-empty" style="display:none;">
        <div class="lt-empty-icon"><i class="fas fa-inbox"></i></div>
        <h4>@Resources.Strings.LineaTiempo_SinDatosTitulo</h4>
        <p>@Resources.Strings.LineaTiempo_SinDatosDesc</p>
    </div>

    <div id="ltResultado" style="display:none;">

        <section class="lt-kpis" id="ltKpiRow"></section>

        <section class="lt-card">
            <div class="lt-letterhead">
                <div class="lt-brand-mark"><span class="bm-icon">B</span><span class="bm-text">@Resources.Strings.LineaTiempo_BrandMark</span></div>
                <span class="fecha" id="ltFechaGenerado"></span>
            </div>
            <div class="lt-chart-head">
                <div>
                    <h2 id="ltChartTitle">&mdash;</h2>
                    <p class="lt-muted" id="ltChartSubtitle">&mdash;</p>
                </div>
                <div class="lt-toggles">
                    <div class="lt-seg-toggle" id="ltSegUnidad" title="@Resources.Strings.LineaTiempo_LabelUnidad">
                        <button type="button" class="active" data-unidad="pesos">@Resources.Strings.LineaTiempo_UnidadPesos</button>
                        <button type="button" data-unidad="miles">@Resources.Strings.LineaTiempo_UnidadMiles</button>
                        <button type="button" data-unidad="millones">@Resources.Strings.LineaTiempo_UnidadMillones</button>
                    </div>
                    <div class="lt-seg-toggle" id="ltSegTipoGrafico">
                        <button type="button" class="active" data-tipo="line">@Resources.Strings.LineaTiempo_SegLineas</button>
                        <button type="button" data-tipo="bar">@Resources.Strings.LineaTiempo_SegBarras</button>
                    </div>
                    <div class="lt-seg-toggle" id="ltSegVista">
                        <button type="button" class="active" data-view="chart">@Resources.Strings.LineaTiempo_SegGrafico</button>
                        <button type="button" data-view="table">@Resources.Strings.LineaTiempo_SegTabla</button>
                    </div>
                    <button type="button" id="btnExportarLT" class="lt-btn lt-btn-excel lt-btn-icon" title="@Resources.Strings.Common_ExportarExcel">
                        <i class="fas fa-file-excel"></i>
                    </button>
                    <button type="button" id="btnExportarPDF" class="lt-btn lt-btn-pdf lt-btn-icon" data-toggle="modal" data-target="#ltPdfModal" title="@Resources.Strings.LineaTiempo_BtnExportarPdf">
                        <i class="fas fa-file-pdf"></i>
                    </button>
                </div>
            </div>

            <div id="ltViewChart" class="lt-chart-canvas-wrap"><canvas id="ltChart"></canvas></div>

            <div id="ltViewTable" hidden>
                <div class="lt-table-wrap">
                    <table><thead><tr id="ltTablaHead"></tr></thead><tbody id="ltTablaBody"></tbody></table>
                </div>
            </div>
        </section>
    </div>

    <div class="modal fade modal-confirm" id="ltPdfModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-file-pdf mr-2"></i>@Resources.Strings.LineaTiempo_PdfModalTitulo</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body d-flex flex-column" style="gap:10px;">
                    <button type="button" class="opt primary" id="ltPdfOpcionGrafico" data-modo="grafico">
                        <div class="ic"><i class="fas fa-chart-line"></i></div>
                        <div class="txt">
                            <span class="t">@Resources.Strings.LineaTiempo_PdfSoloGrafico</span>
                            <span class="s">@Resources.Strings.LineaTiempo_PdfSoloGraficoDesc</span>
                        </div>
                        <i class="fas fa-arrow-right go"></i>
                    </button>
                    <button type="button" class="opt secondary" id="ltPdfOpcionDatos" data-modo="datos">
                        <div class="ic"><i class="fas fa-table"></i></div>
                        <div class="txt">
                            <span class="t">@Resources.Strings.LineaTiempo_PdfGraficoDatos</span>
                            <span class="s">@Resources.Strings.LineaTiempo_PdfGraficoDatosDesc</span>
                        </div>
                        <i class="fas fa-arrow-right go"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>
</div>

@section scripts {
<script src="~/Assets/js/chart.umd.min.js"></script>
<script src="~/Assets/js/select2/select2.min.js"></script>
<script src="~/Assets/js/jspdf.umd.min.js"></script>
<script>
(function () {
    var CATALOGO_TABLAS = {
@if (tablas != null)
{
    for (int i = 0; i < tablas.Count; i++)
    {
        var t = tablas[i];
        <text>'@t.NombreTabla': { nombre: '@Html.Raw(HttpUtility.JavaScriptStringEncode(t.NombreAmigable))', icono: '@Html.Raw(HttpUtility.JavaScriptStringEncode(t.Icono ?? "fas fa-table"))', descripcion: '@Html.Raw(HttpUtility.JavaScriptStringEncode(t.Descripcion ?? ""))' }@(i < tablas.Count - 1 ? "," : "")</text>
    }
}
    };

    var _lt = {
        urls: {
            indicadores: '@Url.Action("ObtenerIndicadores", "InformeLineaTiempo")',
            campos:      '@Url.Action("ObtenerCampos", "InformeLineaTiempo")',
            meses:       '@Url.Action("ObtenerRangoMeses", "InformeLineaTiempo")',
            serie:       '@Url.Action("ObtenerSerie", "InformeLineaTiempo")',
            exportar:    '@Url.Action("ExportarExcel", "InformeLineaTiempo")'
        },
        token: $('input[name="__RequestVerificationToken"]').val(),
        textos: {
            colValor:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_ColValor))',
            colComparacion: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_ColComparacion))',
            colPeriodo:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_ColPeriodo))',
            colVariacion:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_ColVariacion))',
            kpiUltimo:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_KpiUltimo))',
            kpiPromedio:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_KpiPromedio))',
            kpiPeriodos:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_KpiPeriodos))',
            statDeltaSufijo:'@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_StatDeltaSufijo))',
            generadoElFmt:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_GeneradoElFmt))',
            unidadSufijoMiles:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_UnidadSufijoMiles))',
            unidadSufijoMillones: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_UnidadSufijoMillones))',
            pdfGenerando:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_PdfGenerando))',
            pdfErrorGeneral:'@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_JS_ErrorPdf))',
            pdfFooter:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_PdfFooter))',
            badgeMes:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_BadgeMes))',
            badgeMeses:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_BadgeMeses))',
            agruparAyuda: {
                Mes:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_Agrupar_MesAyuda))',
                Trimestre: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_Agrupar_TrimestreAyuda))',
                Anio:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_Agrupar_AnioAyuda))'
            }
        },
        cultura: '@Html.Raw(HttpUtility.JavaScriptStringEncode(culturaJs))',
        esAdmin: @Html.Raw(esAdmin.ToString().ToLowerInvariant()),
        campoUnico: null,
        agrupar: 'Mes',
        unidad: 'pesos',
        tipoGrafico: 'line',
        chart: null,
        ultimaRespuesta: null,
        mesesCache: [],
        iDesde: 0,
        iHasta: 0
    };

    var elEmpresa = $('#ltEmpresa'), elTabla = $('#ltTabla'), elIndicador = $('#ltIndicador'),
        elCampo = $('#ltCampo'), elEscenario = $('#ltEscenario'),
        elEscenarioComparar = $('#ltEscenarioComparar');

    // Construidos con fromCharCode (no como literales en el archivo) para no depender de
    // como el compilador de Razor decida leer bytes no-ASCII en este .cshtml.
    var CH_UP = String.fromCharCode(0x25B2), CH_DOWN = String.fromCharCode(0x25BC),
        CH_MDASH = String.fromCharCode(0x2014), CH_NDASH = String.fromCharCode(0x2013),
        CH_MIDDOT = String.fromCharCode(0xB7);

    // Chart.js no trae etiquetas de dato por defecto (habría que sumar el plugin oficial
    // chartjs-plugin-datalabels, no vendorizado en el proyecto) — este plugin liviano dibuja
    // el valor encima de cada barra/punto usando el mismo formato compacto del resto de la vista.
    var ltDataLabelsPlugin = {
        id: 'ltDataLabels',
        afterDatasetsDraw: function (chart) {
            var ctx = chart.ctx;
            ctx.save();
            ctx.font = '600 10.5px ' + (ctx.font.split(' ').pop() || 'sans-serif');
            ctx.textAlign = 'center';
            ctx.textBaseline = 'bottom';
            chart.data.datasets.forEach(function (dataset, i) {
                var meta = chart.getDatasetMeta(i);
                if (!meta || meta.hidden) return;
                ctx.fillStyle = dataset.borderColor || '#333';
                meta.data.forEach(function (el, idx) {
                    var valor = dataset.data[idx];
                    if (valor === null || valor === undefined) return;
                    var pos = el.tooltipPosition ? el.tooltipPosition() : { x: el.x, y: el.y };
                    ctx.fillText(fmtCompacto(valor), pos.x, pos.y - 6);
                });
            });
            ctx.restore();
        }
    };

    var s2lang = {
        noResults: function () { return '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Select2NoResults))'; },
        searching: function () { return '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Select2Searching))'; }
    };

    $(document).ready(function () {
        $('#ltEmpresa, #ltTabla, #ltIndicador, #ltCampo, #ltEscenario, #ltEscenarioComparar')
            .select2({ width: '100%', language: s2lang, dropdownAutoWidth: false });

        $('#ltEmpresa, #ltTabla, #ltEscenario').on('change', recargarCascada);

        $('#ltSegVerPor button').on('click', function () {
            var modo = $(this).data('modo');
            $('#ltSegVerPor button').removeClass('active').attr('aria-pressed', 'false');
            $(this).addClass('active').attr('aria-pressed', 'true');
            _lt.agrupar = modo;
            $('#ltAgruparHint').text(_lt.textos.agruparAyuda[modo] || '');
        });

        $('#ltBtnToggleComparar').on('click', function () {
            var abierto = !$('#ltCompararPanel').prop('hidden');
            $('#ltCompararPanel').prop('hidden', abierto);
            $(this).toggleClass('open', !abierto);
        });

        $('#ltIndicador').on('change', actualizarBotonGenerar);
        $('#ltAtajos button').on('click', function () { aplicarPresetRango($(this).data('preset')); });
        $('#ltKnobFrom').on('pointerdown', function (e) { e.stopPropagation(); iniciarArrastreSlider(e, 'from'); });
        $('#ltKnobTo').on('pointerdown', function (e) { e.stopPropagation(); iniciarArrastreSlider(e, 'to'); });
        $('#ltRangoTrack').on('pointerdown', function (e) { clicEnPista(e); });
        $('#ltKnobFrom, #ltKnobTo').on('keydown', function (e) { moverKnobConTeclado(e, this.id === 'ltKnobFrom' ? 'from' : 'to'); });
        $('#btnGenerarLT').on('click', generar);
        $('#btnLimpiarLT').on('click', limpiar);
        $('#btnExportarLT').on('click', exportar);
        $('#ltPdfOpcionGrafico, #ltPdfOpcionDatos').on('click', function () {
            $('#ltPdfModal').modal('hide');
            generarPdf($(this).data('modo'));
        });

        $('#ltSegUnidad button').on('click', function () {
            $('#ltSegUnidad button').removeClass('active');
            $(this).addClass('active');
            _lt.unidad = $(this).data('unidad');
            if (_lt.ultimaRespuesta) {
                pintarKpis(_lt.ultimaRespuesta);
                pintarGrafico(_lt.ultimaRespuesta);
                pintarTabla(_lt.ultimaRespuesta);
            }
        });

        $('#ltSegTipoGrafico button').on('click', function () {
            $('#ltSegTipoGrafico button').removeClass('active');
            $(this).addClass('active');
            _lt.tipoGrafico = $(this).data('tipo');
            if (_lt.ultimaRespuesta) pintarGrafico(_lt.ultimaRespuesta);
        });

        $('#ltSegVista button').on('click', function () {
            $('#ltSegVista button').removeClass('active');
            $(this).addClass('active');
            var vista = $(this).data('view');
            $('#ltViewChart').prop('hidden', vista !== 'chart');
            $('#ltViewTable').prop('hidden', vista !== 'table');
        });

        recargarCascada();
    });

    function empresaSeleccionada() {
        var v = elEmpresa.val();
        return v ? parseInt(v, 10) : null;
    }

    function actualizarBotonGenerar() {
        var listo = !!elTabla.val() && !!elIndicador.val() && _lt.mesesCache.length > 0
            && (!_lt.esAdmin || !!empresaSeleccionada());
        $('#btnGenerarLT').prop('disabled', !listo);
    }

    function recargarCascada() {
        var nombreTabla = elTabla.val();
        var idEmpresa   = empresaSeleccionada();
        var idEscenario = elEscenario.val();

        elIndicador.empty().append('<option value="">@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Seleccione))</option>').val('').prop('disabled', true).trigger('change.select2');
        _lt.mesesCache = [];
        _lt.iDesde = 0;
        _lt.iHasta = 0;
        pintarRango();
        $('#ltCampoWrap').hide();
        $('#ltResultado, #ltSinDatos').hide();
        $('#ltEstadoInicial').show();
        ocultarBanners();
        actualizarBotonGenerar();

        if (!nombreTabla || (_lt.esAdmin && !idEmpresa)) return;

        $.post(_lt.urls.indicadores, { nombreTabla: nombreTabla, idEmpresa: idEmpresa, idEscenario: idEscenario, __RequestVerificationToken: _lt.token }, function (resp) {
            if (!resp.success) return;
            var indicadores = resp.indicadores || [];
            indicadores.forEach(function (v) {
                elIndicador.append($('<option>').val(v).text(v));
            });
            if (indicadores.length > 0) elIndicador.val(indicadores[0]);
            elIndicador.prop('disabled', indicadores.length === 0).trigger('change.select2');
            actualizarBannerTabla(indicadores.length > 0);
            actualizarBotonGenerar();
        });

        $.post(_lt.urls.campos, { nombreTabla: nombreTabla, __RequestVerificationToken: _lt.token }, function (resp) {
            if (!resp.success) return;
            var campos = resp.campos || [];
            if (campos.length > 1) {
                elCampo.empty();
                campos.forEach(function (c) { elCampo.append($('<option>').val(c.nombreTecnico).text(c.nombreAmigable)); });
                elCampo.val(campos[0].nombreTecnico).trigger('change.select2');
                _lt.campoUnico = null;
                $('#ltCampoWrap').show();
            } else {
                _lt.campoUnico = campos.length === 1 ? campos[0].nombreTecnico : null;
                $('#ltCampoWrap').hide();
            }
        });

        $('#ltAtajos button').prop('disabled', true);

        $.post(_lt.urls.meses, { nombreTabla: nombreTabla, idEmpresa: idEmpresa, idEscenario: idEscenario, __RequestVerificationToken: _lt.token }, function (resp) {
            if (!resp.success) return;
            var meses = resp.meses || [];
            _lt.mesesCache = meses;
            $('#ltAtajos button').prop('disabled', meses.length === 0);
            if (meses.length > 0) aplicarPresetRango('12m'); else pintarRango();
            actualizarBotonGenerar();
        });
    }

    function ocultarBanners() {
        $('#ltTablaDescBox, #ltSinDatosModeloBox').hide();
    }

    function actualizarBannerTabla(hayDatos) {
        var t = CATALOGO_TABLAS[elTabla.val()];
        $('#ltSinDatosModeloBox').toggle(!hayDatos);
        $('#ltSegVerPor button').prop('disabled', !hayDatos);
        if (hayDatos && t && t.descripcion) {
            $('#ltTablaDescIcon').attr('class', 'ic ' + t.icono);
            $('#ltTablaDescNombre').text(t.nombre);
            $('#ltTablaDescTexto').text(t.descripcion);
            $('#ltTablaDescBox').show();
        } else {
            $('#ltTablaDescBox').hide();
        }
    }

    // ===== Slider de rango de meses =====

    function aplicarPresetRango(preset) {
        var n = _lt.mesesCache.length;
        if (!n) return;
        var desdeIdx = 0;
        if (preset === '12m') desdeIdx = Math.max(0, n - 12);
        else if (preset === '6m') desdeIdx = Math.max(0, n - 6);
        _lt.iDesde = desdeIdx;
        _lt.iHasta = n - 1;
        pintarRango();
    }

    function pctIndice(i, n) {
        return n > 1 ? (i / (n - 1) * 100) : 0;
    }

    function pintarRango() {
        var meses = _lt.mesesCache, n = meses.length;
        var track = $('#ltRangoTrack');

        if (n === 0) {
            track.addClass('disabled');
            $('#ltRangoDesdeLbl, #ltRangoHastaLbl').text(CH_MDASH);
            $('#ltRangoBadge').text(CH_MDASH);
            $('#ltRangoYears').empty();
            $('#ltAtajos button').removeClass('active');
            return;
        }

        track.removeClass('disabled');
        var pctDesde = pctIndice(_lt.iDesde, n), pctHasta = pctIndice(_lt.iHasta, n);

        $('#ltKnobFrom').css('left', pctDesde + '%')
            .attr({ 'aria-valuemin': 0, 'aria-valuemax': n - 1, 'aria-valuenow': _lt.iDesde, 'aria-valuetext': meses[_lt.iDesde].etiqueta });
        $('#ltKnobTo').css('left', pctHasta + '%')
            .attr({ 'aria-valuemin': 0, 'aria-valuemax': n - 1, 'aria-valuenow': _lt.iHasta, 'aria-valuetext': meses[_lt.iHasta].etiqueta });
        $('#ltRangoSel').css({ left: pctDesde + '%', width: (pctHasta - pctDesde) + '%' });

        $('#ltRangoDesdeLbl').text(meses[_lt.iDesde].etiqueta);
        $('#ltRangoHastaLbl').text(meses[_lt.iHasta].etiqueta);

        var totalMeses = _lt.iHasta - _lt.iDesde + 1;
        $('#ltRangoBadge').text(totalMeses + ' ' + (totalMeses === 1 ? _lt.textos.badgeMes : _lt.textos.badgeMeses));

        var anios = [];
        meses.forEach(function (m) { if (anios.indexOf(m.anio) === -1) anios.push(m.anio); });
        $('#ltRangoYears').html(anios.map(function (a) { return '<span>' + a + '</span>'; }).join(''));

        actualizarAtajoActivo();
        actualizarBotonGenerar();
    }

    function actualizarAtajoActivo() {
        var n = _lt.mesesCache.length;
        $('#ltAtajos button').removeClass('active');
        if (!n) return;
        if (_lt.iDesde === 0 && _lt.iHasta === n - 1) $('#ltAtajos button[data-preset="todo"]').addClass('active');
        else if (_lt.iDesde === Math.max(0, n - 12) && _lt.iHasta === n - 1) $('#ltAtajos button[data-preset="12m"]').addClass('active');
        else if (_lt.iDesde === Math.max(0, n - 6) && _lt.iHasta === n - 1) $('#ltAtajos button[data-preset="6m"]').addClass('active');
    }

    function indiceDesdeClientX(clientX) {
        var track = document.getElementById('ltRangoTrack');
        var rect = track.getBoundingClientRect();
        var n = _lt.mesesCache.length;
        var frac = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
        return Math.round(frac * (n - 1));
    }

    function moverExtremo(cual, idx) {
        var n = _lt.mesesCache.length;
        idx = Math.min(n - 1, Math.max(0, idx));
        if (cual === 'from') {
            _lt.iDesde = idx;
            if (_lt.iDesde > _lt.iHasta) _lt.iHasta = _lt.iDesde;
        } else {
            _lt.iHasta = idx;
            if (_lt.iHasta < _lt.iDesde) _lt.iDesde = _lt.iHasta;
        }
        pintarRango();
    }

    function iniciarArrastreSlider(e, cual) {
        if (_lt.mesesCache.length < 2) return;
        e.preventDefault();
        var track = $('#ltRangoTrack').addClass('dragging');

        function onMove(ev) { moverExtremo(cual, indiceDesdeClientX(ev.clientX)); }
        function onUp() {
            track.removeClass('dragging');
            window.removeEventListener('pointermove', onMove);
            window.removeEventListener('pointerup', onUp);
        }
        window.addEventListener('pointermove', onMove);
        window.addEventListener('pointerup', onUp);
    }

    function clicEnPista(e) {
        if ($(e.target).hasClass('knob') || _lt.mesesCache.length < 2) return;
        var idx = indiceDesdeClientX(e.clientX);
        var cual = Math.abs(idx - _lt.iDesde) <= Math.abs(idx - _lt.iHasta) ? 'from' : 'to';
        moverExtremo(cual, idx);
        iniciarArrastreSlider(e, cual);
    }

    function moverKnobConTeclado(e, cual) {
        var n = _lt.mesesCache.length;
        if (n < 2) return;
        var idx = cual === 'from' ? _lt.iDesde : _lt.iHasta;
        if (e.key === 'ArrowLeft') idx -= 1;
        else if (e.key === 'ArrowRight') idx += 1;
        else if (e.key === 'Home') idx = 0;
        else if (e.key === 'End') idx = n - 1;
        else return;
        e.preventDefault();
        moverExtremo(cual, idx);
    }

    function campoSeleccionado() {
        return $('#ltCampoWrap').is(':visible') ? elCampo.val() : _lt.campoUnico;
    }

    function armarFiltros() {
        var n = _lt.mesesCache.length;
        var desde = n ? _lt.mesesCache[_lt.iDesde] : null;
        var hasta = n ? _lt.mesesCache[_lt.iHasta] : null;

        return {
            NombreTabla: elTabla.val(),
            IdEmpresa: empresaSeleccionada(),
            IdEscenario: elEscenario.val(),
            IdEscenarioComparar: $('#ltEscenarioComparar').val() || null,
            Indicador: elIndicador.val(),
            Campo: campoSeleccionado(),
            AnioDesde: desde ? desde.anio : null,
            MesDesde: desde ? desde.mes : null,
            AnioHasta: hasta ? hasta.anio : null,
            MesHasta: hasta ? hasta.mes : null,
            Agrupar: _lt.agrupar,
            __RequestVerificationToken: _lt.token
        };
    }

    function generar() {
        var filtros = armarFiltros();
        if (!filtros.Campo) return;

        $('#ltEstadoInicial, #ltSinDatos, #ltResultado').hide();
        $('#ltLoading').show();

        $.post(_lt.urls.serie, filtros, function (resp) {
            $('#ltLoading').hide();
            if (!resp.success || !resp.principal || resp.principal.length === 0) {
                $('#ltSinDatos').show();
                return;
            }
            _lt.ultimaRespuesta = resp;
            pintarKpis(resp);
            pintarLetterhead(resp);
            pintarGrafico(resp);
            pintarTabla(resp);
            $('#ltResultado').show();
        }).fail(function () {
            $('#ltLoading').hide();
            $('#ltSinDatos').show();
        });
    }

    function limpiar() {
        elTabla.val('').trigger('change.select2');
        if (_lt.esAdmin) elEmpresa.prop('selectedIndex', 0).trigger('change.select2');
        elEscenario.prop('selectedIndex', 0).trigger('change.select2');
        elEscenarioComparar.val('').trigger('change.select2');
        $('#ltCompararPanel').prop('hidden', true);
        $('#ltBtnToggleComparar').removeClass('open');
        _lt.agrupar = 'Mes';
        $('#ltSegVerPor button').removeClass('active').attr('aria-pressed', 'false');
        $('#ltSegVerPor button[data-modo="Mes"]').addClass('active').attr('aria-pressed', 'true');
        $('#ltAgruparHint').text(_lt.textos.agruparAyuda.Mes);
        _lt.unidad = 'pesos';
        $('#ltSegUnidad button').removeClass('active');
        $('#ltSegUnidad button[data-unidad="pesos"]').addClass('active');
        recargarCascada();
    }

    function escalarValor(v) {
        if (_lt.unidad === 'miles') return v / 1000;
        if (_lt.unidad === 'millones') return v / 1000000;
        return v;
    }

    function sufijoUnidad() {
        if (_lt.unidad === 'miles') return ' ' + _lt.textos.unidadSufijoMiles;
        if (_lt.unidad === 'millones') return ' ' + _lt.textos.unidadSufijoMillones;
        return '';
    }

    function fmtCompacto(v) {
        var escalado = escalarValor(v);
        var decimales = _lt.unidad === 'pesos' ? 0 : 1;
        try { return new Intl.NumberFormat(_lt.cultura, { minimumFractionDigits: decimales, maximumFractionDigits: decimales }).format(escalado) + sufijoUnidad(); }
        catch (e) { return escalado + sufijoUnidad(); }
    }

    function fmtDecimal(v) {
        var escalado = escalarValor(v);
        var decimales = _lt.unidad === 'pesos' ? 2 : 1;
        try { return new Intl.NumberFormat(_lt.cultura, { minimumFractionDigits: decimales, maximumFractionDigits: decimales }).format(escalado) + sufijoUnidad(); }
        catch (e) { return escalado + sufijoUnidad(); }
    }

    function statTile(label, value, delta) {
        var deltaHtml = '';
        if (delta !== null && delta !== undefined && !isNaN(delta)) {
            var cls = delta >= 0 ? 'up' : 'down', flecha = delta >= 0 ? CH_UP : CH_DOWN;
            deltaHtml = '<span class="lt-stat-delta ' + cls + '">' + flecha + ' ' + Math.abs(delta).toFixed(1) + '% ' + _lt.textos.statDeltaSufijo + '</span>';
        }
        return '<div class="lt-stat-tile"><div class="lt-stat-label">' + $('<span>').text(label).html() + '</div>' +
            '<div class="lt-stat-value">' + $('<span>').text(value).html() + '</div>' + deltaHtml + '</div>';
    }

    function pintarKpis(resp) {
        var pts = resp.principal;
        var ultimo = pts[pts.length - 1].valor;
        var previo = pts.length > 1 ? pts[pts.length - 2].valor : ultimo;
        var variacion = previo ? ((ultimo - previo) / Math.abs(previo)) * 100 : null;
        var promedio = pts.reduce(function (a, p) { return a + p.valor; }, 0) / pts.length;

        $('#ltKpiRow').html(
            statTile(_lt.textos.kpiUltimo, fmtCompacto(ultimo), pts.length > 1 ? variacion : null) +
            statTile(_lt.textos.kpiPromedio, fmtCompacto(promedio), null) +
            statTile(_lt.textos.kpiPeriodos, String(pts.length), null)
        );
    }

    function pintarLetterhead(resp) {
        var titulo = elIndicador.val();
        var tablaInfo = CATALOGO_TABLAS[elTabla.val()] || {};
        var empresaTexto = elEmpresa.find(':selected').text();
        var escenarioTexto = resp.nombreEscenarioPrincipal || elEscenario.find(':selected').text();
        var rango = resp.principal.length ? (resp.principal[0].etiqueta + (resp.principal.length > 1 ? (' ' + CH_NDASH + ' ' + resp.principal[resp.principal.length - 1].etiqueta) : '')) : '';
        var subtitulo = (tablaInfo.nombre || '') + ' ' + CH_MIDDOT + ' ' + empresaTexto + ' ' + CH_MIDDOT + ' ' + escenarioTexto +
            (resp.comparacion && resp.comparacion.length ? (' vs. ' + (resp.nombreEscenarioComparacion || '')) : '') +
            (rango ? (' ' + CH_MIDDOT + ' ' + rango) : '');

        $('#ltChartTitle').text(titulo);
        $('#ltChartSubtitle').text(subtitulo);

        try {
            $('#ltFechaGenerado').text(_lt.textos.generadoElFmt.replace('{0}',
                new Date().toLocaleDateString(_lt.cultura, { day: 'numeric', month: 'long', year: 'numeric' })));
        } catch (e) { $('#ltFechaGenerado').text(''); }
    }

    function pintarGrafico(resp) {
        var labels = resp.principal.map(function (p) { return p.etiqueta; });
        var esBarra = _lt.tipoGrafico === 'bar';

        var datasets = [{
            label: resp.nombreEscenarioPrincipal || _lt.textos.colValor,
            data: resp.principal.map(function (p) { return p.valor; }),
            borderColor: '#6366F1',
            backgroundColor: esBarra ? 'rgba(99,102,241,.85)' : 'rgba(99,102,241,.16)',
            borderWidth: esBarra ? 0 : 2.5,
            borderRadius: esBarra ? 6 : 0,
            maxBarThickness: 38,
            minBarLength: esBarra ? 30 : undefined,
            tension: 0.35,
            fill: !esBarra,
            pointRadius: 3,
            pointHoverRadius: 6,
            pointBackgroundColor: '#6366F1'
        }];

        if (resp.comparacion && resp.comparacion.length > 0) {
            datasets.push({
                label: resp.nombreEscenarioComparacion || _lt.textos.colComparacion,
                data: resp.comparacion.map(function (p) { return p.valor; }),
                borderColor: '#D97706',
                backgroundColor: esBarra ? 'rgba(217,119,6,.85)' : 'rgba(217,119,6,.16)',
                borderWidth: esBarra ? 0 : 2.5,
                borderRadius: esBarra ? 6 : 0,
                maxBarThickness: 38,
                minBarLength: esBarra ? 30 : undefined,
                tension: 0.35,
                fill: !esBarra,
                pointRadius: 3,
                pointHoverRadius: 6,
                pointBackgroundColor: '#D97706'
            });
        }

        if (_lt.chart) { _lt.chart.destroy(); }
        _lt.chart = new Chart(document.getElementById('ltChart').getContext('2d'), {
            type: esBarra ? 'bar' : 'line',
            data: { labels: labels, datasets: datasets },
            plugins: [ltDataLabelsPlugin],
            options: {
                responsive: true,
                maintainAspectRatio: false,
                layout: { padding: { top: 20 } },
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { display: datasets.length > 1, position: 'top', align: 'end', labels: { usePointStyle: true, boxWidth: 12, boxHeight: 12 } },
                    tooltip: { mode: 'index', intersect: false, callbacks: { label: function (ctx) { return ctx.dataset.label + ': ' + fmtCompacto(ctx.parsed.y); } } }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: { beginAtZero: false, ticks: { callback: function (v) { return fmtCompacto(v); } } }
                }
            }
        });
    }

    function pintarTabla(resp) {
        var conComparacion = resp.comparacion && resp.comparacion.length > 0;
        var head = '<th>' + _lt.textos.colPeriodo + '</th><th style="text-align:right;">' + $('<span>').text(resp.nombreEscenarioPrincipal || _lt.textos.colValor).html() + '</th>';
        if (conComparacion) head += '<th style="text-align:right;">' + $('<span>').text(resp.nombreEscenarioComparacion || _lt.textos.colComparacion).html() + '</th><th style="text-align:right;">' + _lt.textos.colVariacion + '</th>';
        $('#ltTablaHead').html(head);

        var comparacionPorClave = {};
        if (conComparacion) {
            resp.comparacion.forEach(function (p) { comparacionPorClave[p.anio + '-' + p.mes] = p.valor; });
        }

        var filas = resp.principal.map(function (p) {
            var fila = '<tr><td>' + $('<span>').text(p.etiqueta).html() + '</td><td class="num">' + fmtDecimal(p.valor) + '</td>';
            if (conComparacion) {
                var b = comparacionPorClave[p.anio + '-' + p.mes];
                if (b !== undefined) {
                    var delta = b ? ((p.valor - b) / Math.abs(b)) * 100 : 0;
                    var cls = delta >= 0 ? 'up' : 'down', flecha = delta >= 0 ? CH_UP : CH_DOWN;
                    fila += '<td class="num">' + fmtDecimal(b) + '</td><td class="num"><span class="lt-var-chip ' + cls + '">' + flecha + ' ' + Math.abs(delta).toFixed(1) + '%</span></td>';
                } else {
                    fila += '<td class="num">' + CH_MDASH + '</td><td class="num">' + CH_MDASH + '</td>';
                }
            }
            return fila + '</tr>';
        }).join('');
        $('#ltTablaBody').html(filas);
    }

    function exportar() {
        var filtros = armarFiltros();
        if (!filtros.Campo) return;

        var form = document.createElement('form');
        form.method = 'POST';
        form.action = _lt.urls.exportar;

        Object.keys(filtros).forEach(function (k) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = k;
            input.value = filtros[k] == null ? '' : filtros[k];
            form.appendChild(input);
        });

        document.body.appendChild(form);
        form.submit();
        document.body.removeChild(form);
    }

    function generarPdf(modo) {
        if (!_lt.ultimaRespuesta || !_lt.chart) return;
        var btn = document.getElementById('btnExportarPDF');
        var htmlOriginal = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ' + _lt.textos.pdfGenerando;

        try {
            var resp = _lt.ultimaRespuesta;
            var jsPDFCtor = window.jspdf.jsPDF;
            var pdf = new jsPDFCtor('p', 'mm', 'a4');
            var pageW = pdf.internal.pageSize.getWidth();
            var pageH = pdf.internal.pageSize.getHeight();
            var margin = 14;
            var y;

            function dibujarPiePagina() {
                var num = pdf.internal.getNumberOfPages();
                pdf.setFontSize(7.5);
                pdf.setTextColor(150, 145, 165);
                pdf.text(_lt.textos.pdfFooter, margin, pageH - 8);
                pdf.text(String(num), pageW - margin, pageH - 8, { align: 'right' });
            }

            function nuevaPagina() {
                pdf.addPage();
                y = margin;
                dibujarPiePagina();
            }

            // Encabezado tipo carta
            pdf.setFillColor(99, 102, 241);
            pdf.rect(0, 0, pageW, 24, 'F');
            pdf.setTextColor(255, 255, 255);
            pdf.setFont(undefined, 'bold');
            pdf.setFontSize(15);
            pdf.text('BUFINS', margin, 15);

            var titulo = elIndicador.val() || '';
            var tablaInfo = CATALOGO_TABLAS[elTabla.val()] || {};
            var empresaTexto = elEmpresa.find(':selected').text();
            var escenarioTexto = resp.nombreEscenarioPrincipal || elEscenario.find(':selected').text();
            var subtitulo = (tablaInfo.nombre || '') + '  ' + CH_MIDDOT + '  ' + empresaTexto + '  ' + CH_MIDDOT + '  ' + escenarioTexto;

            pdf.setFont(undefined, 'normal');
            pdf.setFontSize(9);
            pdf.text(titulo, pageW - margin, 10, { align: 'right' });
            pdf.setFontSize(8);
            pdf.text(subtitulo, pageW - margin, 16, { align: 'right' });

            y = 32;
            pdf.setTextColor(30, 20, 50);

            // KPIs (mismos que en pantalla)
            var pts = resp.principal;
            var ultimo = pts[pts.length - 1].valor;
            var previo = pts.length > 1 ? pts[pts.length - 2].valor : ultimo;
            var promedio = pts.reduce(function (a, p) { return a + p.valor; }, 0) / pts.length;

            var kpis = [
                { label: _lt.textos.kpiUltimo, valor: fmtCompacto(ultimo) },
                { label: _lt.textos.kpiPromedio, valor: fmtCompacto(promedio) },
                { label: _lt.textos.kpiPeriodos, valor: String(pts.length) }
            ];
            var kpiW = (pageW - margin * 2 - 12) / 3;
            kpis.forEach(function (k, i) {
                var x = margin + i * (kpiW + 6);
                pdf.setDrawColor(228, 225, 240);
                pdf.setFillColor(244, 243, 251);
                pdf.roundedRect(x, y, kpiW, 18, 2, 2, 'FD');
                pdf.setFontSize(7.5);
                pdf.setTextColor(120, 115, 140);
                pdf.text(k.label, x + 4, y + 7);
                pdf.setFontSize(12);
                pdf.setFont(undefined, 'bold');
                pdf.setTextColor(30, 20, 50);
                pdf.text(k.valor, x + 4, y + 14);
                pdf.setFont(undefined, 'normal');
            });
            y += 24;

            // Gráfico (imagen nativa de Chart.js, sin html2canvas)
            var imgData = _lt.chart.toBase64Image('image/png', 1.0);
            var imgProps = pdf.getImageProperties(imgData);
            var imgW = pageW - margin * 2;
            var imgH = Math.min(imgW * imgProps.height / imgProps.width, 110);
            pdf.addImage(imgData, 'PNG', margin, y, imgW, imgH);
            y += imgH + 10;

            if (modo === 'datos') {
                var conComparacion = resp.comparacion && resp.comparacion.length > 0;
                var headers = [_lt.textos.colPeriodo, resp.nombreEscenarioPrincipal || _lt.textos.colValor];
                if (conComparacion) headers.push(resp.nombreEscenarioComparacion || _lt.textos.colComparacion, _lt.textos.colVariacion);

                var comparacionPorClave = {};
                if (conComparacion) resp.comparacion.forEach(function (p) { comparacionPorClave[p.anio + '-' + p.mes] = p.valor; });

                var filas = pts.map(function (p) {
                    var fila = [p.etiqueta, fmtDecimal(p.valor)];
                    if (conComparacion) {
                        var b = comparacionPorClave[p.anio + '-' + p.mes];
                        if (b !== undefined) {
                            var delta = b ? ((p.valor - b) / Math.abs(b)) * 100 : 0;
                            fila.push(fmtDecimal(b), (delta >= 0 ? '+' : '') + delta.toFixed(1) + '%');
                        } else {
                            fila.push(CH_MDASH, CH_MDASH);
                        }
                    }
                    return fila;
                });

                var colW = (pageW - margin * 2) / headers.length;
                var rowH = 7;

                if (y + rowH * 2 > pageH - margin - 10) nuevaPagina();

                var cabeceraTabla = function () {
                    pdf.setFillColor(99, 102, 241);
                    pdf.setTextColor(255, 255, 255);
                    pdf.setFont(undefined, 'bold');
                    pdf.setFontSize(8.5);
                    headers.forEach(function (h, i) {
                        pdf.rect(margin + i * colW, y, colW, rowH, 'F');
                        pdf.text(String(h), margin + i * colW + 3, y + 4.8);
                    });
                    y += rowH;
                    pdf.setFont(undefined, 'normal');
                    pdf.setTextColor(30, 20, 50);
                    pdf.setFontSize(8);
                };
                cabeceraTabla();

                filas.forEach(function (fila, idx) {
                    if (y + rowH > pageH - margin - 10) { nuevaPagina(); cabeceraTabla(); }
                    if (idx % 2 === 1) { pdf.setFillColor(244, 243, 251); pdf.rect(margin, y, pageW - margin * 2, rowH, 'F'); }
                    fila.forEach(function (val, i) { pdf.text(String(val), margin + i * colW + 3, y + 4.8); });
                    y += rowH;
                });
            }

            dibujarPiePagina();

            var fecha = new Date().toISOString().slice(0, 10).replace(/-/g, '');
            var nombreArchivo = ('LineaTiempo_' + (titulo || 'Indicador')).replace(/[^a-zA-Z0-9_\-]+/g, '_') + '_' + fecha + '.pdf';
            pdf.save(nombreArchivo);
        } catch (e) {
            console.error(e);
            Swal.fire({ icon: 'error', title: _lt.textos.pdfErrorGeneral });
        } finally {
            btn.disabled = false;
            btn.innerHTML = htmlOriginal;
        }
    }
})();
</script>
}
