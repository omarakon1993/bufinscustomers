    function ltCerrarModal() {
        $('#ltIndModal').removeClass('open');
        $('#ltIndicadorBtn').attr('aria-expanded', 'false').focus();
    }

    function ltPintarLista() {
        var q = ($('#ltIndBuscar').val() || '').toLowerCase().trim();
        var lleno = _lt.seleccion.length >= LT_MAX_VARIABLES;
        var grupos = [];
        _lt.indicadores.forEach(function (ind) {
            if (q && ind.nombre.toLowerCase().indexOf(q) === -1) return;
            var g = null;
            grupos.forEach(function (x) { if (x.nombre === (ind.grupo || '')) g = x; });
            if (!g) { g = { nombre: ind.grupo || '', items: [] }; grupos.push(g); }
            g.items.push(ind);
        });

        var html = grupos.map(function (g) {
            var items = g.items.map(function (ind) {
                var on = _lt.seleccion.indexOf(ind.nombre) !== -1;
                return '<button type="button" class="lt-opt' + (on ? ' on' : (lleno ? ' bloqueado' : '')) +
                       '" data-ind="' + $('<span>').text(ind.nombre).html() + '" role="checkbox" aria-checked="' + on + '">' +
                       '<span class="box"><i class="fas fa-check"></i></span>' +
                       '<span class="nm">' + $('<span>').text(ind.nombre).html() + '</span></button>';
            }).join('');
            return '<div class="lt-group">' + (g.nombre ? '<div class="gt">' + $('<span>').text(g.nombre).html() + '</div>' : '') +
                   '<div class="items">' + items + '</div></div>';
        }).join('');

        $('#ltIndLista').html(html);
        $('#ltIndContador').text(_lt.seleccion.length + ' de ' + LT_MAX_VARIABLES);
        $('#ltIndFootN').text(_lt.textos.indSeleccionadas.replace('{0}', _lt.seleccion.length));
    }

    function ltPintarFavoritos() {
        var $c = $('#ltIndFavs').find('.lt-fav').remove().end();
        _lt.favoritos.forEach(function (f) {
            $c.append($('<button type="button" class="lt-fav">')
                .append('<i class="fas fa-star"></i>')
                .append($('<span>').text(f.nombre))
                .on('click', function () {
                    _lt.seleccion = f.items.slice(0, LT_MAX_VARIABLES);
                    ltPintarLista(); ltPintarSeleccion();
                }));
        });
    }

    function ltPintarSeleccion() {
        var n = _lt.seleccion.length;
        $('#ltIndicadorBtn').toggleClass('vacio', n === 0)
            .find('.txt').text(n ? _lt.textos.indSeleccionadas.replace('{0}', n) : _lt.textos.indElegir);

        var chips = _lt.seleccion.map(function (nombre, i) {
            return '<span class="lt-series-chip"><span class="dot" style="background:' +
                   ltColorSerie(i) + '"></span>' +
                   $('<span>').text(nombre).html() +
                   '<i class="fas fa-times x" data-ind="' + $('<span>').text(nombre).html() + '"></i></span>';
        }).join('');
        $('#ltSeriesChips').html(chips);
        $('#ltSeriesBar').toggle(n > 0);
        actualizarBotonGenerar();
        actualizarDisponibilidadComparar();
    }

    function ltToggleIndicador(nombre) {
        var i = _lt.seleccion.indexOf(nombre);
        if (i !== -1) _lt.seleccion.splice(i, 1);
        else if (_lt.seleccion.length < LT_MAX_VARIABLES) _lt.seleccion.push(nombre);
        ltPintarLista(); ltPintarSeleccion();
    }

    // ===== Resultados: cabecera consolidada (opción 3a) — tira de series, escala real/paneles =====

    // Tira de series: reemplaza las tarjetas KPI sueltas y la leyenda de Chart.js — cada celda es
    // a la vez la leyenda (color + nombre) y el interruptor para ocultar/mostrar esa serie.
    function ltPintarStrip(resp) {
        var series = resp.series || [];
        var $s = $('#ltSeriesStrip').css('--n', Math.min(series.length, 4)).empty();

        series.forEach(function (s, i) {
            var uv = ultimoYVariacion(s.puntos);
            var off = !!_lt.ocultas[s.indicador];
            var $c = $('<button type="button" class="lt-serie-cell">').toggleClass('off', off).attr('data-ind', s.indicador)
                .attr('title', off ? _lt.textos.mostrarSerie : _lt.textos.ocultarSerie);
            $c.append($('<span class="top">')
                .append($('<span class="dot">').css('background', ltColorSerie(i)))
                .append($('<span class="nm">').text(s.indicador))
                .append($('<span class="eye">')
                    .append($('<i class="fas fa-eye eye-on">').attr('title', _lt.textos.ocultarSerie))
                    .append($('<i class="fas fa-eye-slash eye-off">').attr('title', _lt.textos.mostrarSerie))));
            $c.append($('<span class="val">').text(fmtCompacto(uv.ultimo)));
            if (uv.variacion !== null) {
                var cls = uv.variacion >= 0 ? 'up' : 'down', flecha = uv.variacion >= 0 ? CH_UP : CH_DOWN;
                $c.append($('<span class="delta">').addClass(cls)
                    .append($('<span>').text(flecha + ' ' + Math.abs(uv.variacion).toFixed(1) + '%'))
                    .append($('<span class="ref">').text(_lt.textos.statDeltaVsFmt.replace('{0}', uv.etiquetaAnterior))));
            }
            $s.append($c);
        });
    }

    // Aplica el estado de _lt.ocultas al gráfico activo (real u paneles) sin volver a pedir datos.
    function ltAplicarVisibilidad() {
        if (!_lt.ultimaRespuesta) return;
        var visibles = (_lt.ultimaRespuesta.series || []).filter(function (s) { return !_lt.ocultas[s.indicador]; });
        $('#ltChartEmpty').toggle(visibles.length === 0);
        $('#ltChartWrap').toggle(visibles.length > 0 && _lt.escala === 'real');
        $('#ltPanels').toggle(visibles.length > 0 && _lt.escala === 'panel');
        if (!visibles.length) return;
        if (_lt.escala === 'panel') { pintarPaneles(_lt.ultimaRespuesta); return; }
        (_lt.ultimaRespuesta.series || []).forEach(function (s, i) {
            if (_lt.chart) _lt.chart.setDatasetVisibility(i, !_lt.ocultas[s.indicador]);
        });
        if (_lt.chart) _lt.chart.update();
    }

    // Conmutador de escala: visible siempre que haya más de una variable, sin importar qué tan
    // parecidas sean sus magnitudes (antes solo aparecía si la más grande superaba 20x a la más chica).
    function ltEvaluarEscala(resp) {
        var masDeUnaVariable = (resp.series || []).length > 1;
        $('#ltScaleBar').toggle(masDeUnaVariable);
        $('#ltScaleHint').toggle(masDeUnaVariable).text(_lt.escala === 'panel' ? _lt.textos.hintPaneles : _lt.textos.hintReal);
        if (!masDeUnaVariable && _lt.escala === 'panel') { _lt.escala = 'real'; $('#ltScaleSeg button').removeClass('active'); $('#ltScaleSeg button[data-scale="real"]').addClass('active'); }
    }

    function destruirPaneles() {
        _lt.panelCharts.forEach(function (c) { c.destroy(); });
        _lt.panelCharts = [];
        _lt.panelMeta = [];
        $('#ltPanels').empty();
    }

    // Vista "Paneles": una mini-gráfica por serie visible, cada una con su propia escala — para que
    // una variable chica (ej. 602) no quede pegada al cero al lado de una grande (ej. 644.616).
    function pintarPaneles(resp) {
        destruirPaneles();
        var todasLasSeries = resp.series || [];
        var visibles = todasLasSeries.filter(function (s) { return !_lt.ocultas[s.indicador]; });
        visibles.forEach(function (s) {
            var i = todasLasSeries.indexOf(s);
            var color = ltColorSerie(i);
            var max = Math.max.apply(null, s.puntos.map(function (p) { return p.valor; }));
            var $row = $('<div class="lt-panel">')
                .append($('<div class="meta">')
                    .append($('<span class="nm">').text(s.indicador))
                    .append($('<span class="mx">').text(_lt.textos.maxAbrev + ' ' + fmtCompacto(max))))
                .append($('<div class="cv">').append('<canvas></canvas>'));
            $('#ltPanels').append($row);
            var ctx = $row.find('canvas')[0].getContext('2d');
            var esUltimo = visibles.indexOf(s) === visibles.length - 1;
            _lt.panelMeta.push({ nombre: s.indicador, max: max });
            _lt.panelCharts.push(new Chart(ctx, {
                type: 'line',
                data: {
                    labels: s.puntos.map(function (p) { return p.etiqueta; }),
                    datasets: [{
                        data: s.puntos.map(function (p) { return p.valor; }),
                        borderColor: color, backgroundColor: ltColorConAlfa(color, .09), borderWidth: 2.5,
                        fill: true, tension: .35, pointRadius: 3.5,
                        pointBackgroundColor: '#fff', pointBorderColor: color, pointBorderWidth: 2.2
                    }]
                },
                plugins: _lt.etiquetas ? [ltDataLabelsPlugin] : [],
                options: {
                    responsive: true, maintainAspectRatio: false,
                    layout: { padding: { top: 14, bottom: 2 } },
                    plugins: { legend: { display: false }, tooltip: { callbacks: { label: function (c) { return fmtCompacto(c.parsed.y); } } } },
                    scales: {
                        y: { display: false, beginAtZero: true, suggestedMax: max * 1.15 },
                        x: {
                            display: esUltimo, grid: { display: false },
                            ticks: { font: { size: 11, weight: '700' }, color: '#5B5570' }
                        }
                    }
                }
            }));
        });
    }

    // Imagen del gráfico activo para "Copiar imagen"/PDF, respetando la escala elegida (real o
    // paneles) en vez de asumir siempre el gráfico real. En 'panel' devuelve una imagen por serie
    // (cada canvas ya trae su propia escala); en 'real' devuelve la única imagen de siempre.
    function ltCapturarImagenGrafico() {
        if (_lt.escala === 'panel' && _lt.panelCharts.length) {
            return {
                tipo: 'panel',
                paneles: _lt.panelCharts.map(function (c, i) {
                    return {
                        nombre: _lt.panelMeta[i].nombre,
                        max: _lt.panelMeta[i].max,
                        dataUrl: c.toBase64Image('image/png', 1.0),
                        width: c.width,
                        height: c.height
                    };
                })
            };
        }
        if (!_lt.chart) return null;
        return { tipo: 'real', dataUrl: _lt.chart.toBase64Image('image/png', 1.0), width: _lt.chart.width, height: _lt.chart.height };
    }

    // Junta los canvases de la vista "Paneles" en uno solo (con su etiqueta y "máx" a la izquierda,
    // igual que en pantalla) para que "Copiar imagen" pueda copiar un único PNG al portapapeles.
    function ltComponerCanvasPaneles() {
        if (!_lt.panelCharts.length) return null;
        var dpr = window.devicePixelRatio || 1;
        var metaW = Math.round(150 * dpr), gap = Math.round(10 * dpr);
        var canvases = _lt.panelCharts.map(function (c) { return c.canvas; });
        var chartW = Math.max.apply(null, canvases.map(function (c) { return c.width; }));
        var totalH = canvases.reduce(function (acc, c) { return acc + c.height; }, 0) + gap * (canvases.length - 1);
        var out = document.createElement('canvas');
        out.width = metaW + gap + chartW;
        out.height = totalH;
        var ctx = out.getContext('2d');
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, out.width, out.height);
        var y = 0;
        canvases.forEach(function (c, i) {
            var meta = _lt.panelMeta[i];
            ctx.fillStyle = '#2d3748';
            ctx.font = '700 ' + Math.round(12 * dpr) + 'px Arial, sans-serif';
            ctx.fillText(meta.nombre, Math.round(14 * dpr), y + Math.round(20 * dpr));
            ctx.fillStyle = '#b9b4c9';
            ctx.font = '700 ' + Math.round(10.5 * dpr) + 'px Arial, sans-serif';
            ctx.fillText(_lt.textos.maxAbrev + ' ' + fmtCompacto(meta.max), Math.round(14 * dpr), y + Math.round(36 * dpr));
            ctx.drawImage(c, metaW + gap, y);
            y += c.height + gap;
        });
        return out;
    }

    function empresaSeleccionada() {
        var v = elEmpresa.val();
        return v ? parseInt(v, 10) : null;
    }

    function indicadoresSeleccionados() {
        return _lt.seleccion;
    }

    function actualizarBotonGenerar() {
        var listo = !!elTabla.val() && indicadoresSeleccionados().length > 0 && _lt.mesesCache.length > 0
            && (!_lt.esAdmin || !!empresaSeleccionada());
        $('#btnGenerarLT').prop('disabled', !listo);
    }

    // Comparar contra otro escenario solo tiene sentido con una única variable en pantalla
    // (con varias, la gráfica ya distingue cada una por color/leyenda) — se deshabilita el panel
    // y se limpia la selección para que no viaje "fantasma" en el siguiente Generar.
    function actualizarDisponibilidadComparar() {
        var multi = indicadoresSeleccionados().length > 1;
        $('#ltBtnToggleComparar').prop('disabled', multi);
        $('#ltCompararHintMulti').prop('hidden', !multi);
        if (multi) {
            $('#ltCompararPanel').prop('hidden', true);
            $('#ltBtnToggleComparar').removeClass('open');
            elEscenarioComparar.val('').trigger('change.select2');
        }
    }

    function recargarCascada() {
        var nombreTabla = elTabla.val();
        var idEmpresa   = empresaSeleccionada();
        var idEscenario = elEscenario.val();

        _lt.indicadores = [];
        _lt.seleccion = [];
        $('#ltIndicadorBtn').prop('disabled', true);
        ltPintarSeleccion();
        _lt.mesesCache = [];
        _lt.iDesde = 0;
        _lt.iHasta = 0;
        pintarRango();
        $('#ltCampoWrap').hide();
        $('#ltResultado, #ltSinDatos').hide();
        $('#ltEstadoInicial').show();
        ocultarBanners();
        actualizarBotonGenerar();

        if (!nombreTabla || (_lt.esAdmin && !idEmpresa)) return;

        $.post(_lt.urls.indicadores, { nombreTabla: nombreTabla, idEmpresa: idEmpresa, idEscenario: idEscenario, __RequestVerificationToken: _lt.token }, function (resp) {
            if (!resp.success) return;
            _lt.indicadores = (resp.indicadores || []).map(function (v) {
                return typeof v === 'string' ? { nombre: v, grupo: '' } : v;
            });
            $('#ltIndicadorBtn').prop('disabled', _lt.indicadores.length === 0);
            actualizarBannerTabla(_lt.indicadores.length > 0);
            ltPintarSeleccion();
        });

        $.post(_lt.urls.campos, { nombreTabla: nombreTabla, __RequestVerificationToken: _lt.token }, function (resp) {
            if (!resp.success) return;
            var campos = resp.campos || [];
            if (campos.length > 1) {
                elCampo.empty();
                campos.forEach(function (c) { elCampo.append($('<option>').val(c.nombreTecnico).text(c.nombreAmigable)); });
                elCampo.val(campos[0].nombreTecnico).trigger('change.select2');
                _lt.campoUnico = null;
                $('#ltCampoWrap').show();
            } else {
                _lt.campoUnico = campos.length === 1 ? campos[0].nombreTecnico : null;
                _lt.campoUnicoTexto = campos.length === 1 ? campos[0].nombreAmigable : null;
                $('#ltCampoWrap').hide();
            }
        });

        $('#ltAtajos button').prop('disabled', true);

        $.post(_lt.urls.meses, { nombreTabla: nombreTabla, idEmpresa: idEmpresa, idEscenario: idEscenario, __RequestVerificationToken: _lt.token }, function (resp) {
            if (!resp.success) return;
            var meses = resp.meses || [];
            _lt.mesesCache = meses;
            $('#ltAtajos button').prop('disabled', meses.length === 0);
            // Por defecto "Año en curso" (según la fecha de hoy); si el año de hoy no tiene datos, "Todo".
            var inicial = RangoAtajos.porDefecto('ytd', meses, _lt.hoy);
            if (inicial) { _lt.iDesde = inicial.d; _lt.iHasta = inicial.h; }
            pintarRango();
            actualizarBotonGenerar();
        });
    }

    function ocultarBanners() {
        $('#ltTablaDescBox, #ltSinDatosModeloBox').hide();
    }

    function actualizarBannerTabla(hayDatos) {
        var t = CATALOGO_TABLAS[elTabla.val()];
        $('#ltSinDatosModeloBox').toggle(!hayDatos);
        $('#ltSegVerPor button').prop('disabled', !hayDatos);
        if (hayDatos && t && t.descripcion) {
            $('#ltTablaDescIcon').attr('class', 'ic ' + t.icono);
            $('#ltTablaDescNombre').text(t.nombre);
            $('#ltTablaDescTexto').text(t.descripcion);
            $('#ltTablaDescBox').show();
        } else {
            $('#ltTablaDescBox').hide();
        }
    }

    // ===== Slider de rango de meses =====

    // Atajos: lógica compartida con el Informe PYG (Assets/js/rango-atajos.js). Relativos a la fecha de
    // hoy del SERVIDOR (_lt.hoy); cada ventana se intersecta con los meses que tienen datos.
    function aplicarPresetRango(preset) {
        var p = RangoAtajos.indices(preset, _lt.mesesCache, _lt.hoy);
        if (!p) return;   // atajo sin datos (.no-disponible): el clic no hace nada, el tooltip explica
        _lt.iDesde = p.d;
        _lt.iHasta = p.h;
        pintarRango();
    }

    function pctIndice(i, n) {
        return n > 1 ? (i / (n - 1) * 100) : 0;
    }

    function pintarRango() {
        var meses = _lt.mesesCache, n = meses.length;
        var track = $('#ltRangoTrack');

        if (n === 0) {
            track.addClass('disabled');
            $('#ltRangoDesdeLbl, #ltRangoHastaLbl').text(CH_MDASH);
            $('#ltRangoHastaLbl').show();
            $('#ltRangoDesdeLbl').next('i').show();
            $('#ltRangoBadge').text(CH_MDASH);
            $('#ltRangoYears').empty();
            $('#ltAtajos button').removeClass('active no-disponible').attr('title', '');
            return;
        }

        track.removeClass('disabled');
        var pctDesde = pctIndice(_lt.iDesde, n), pctHasta = pctIndice(_lt.iHasta, n);

        $('#ltKnobFrom').css('left', pctDesde + '%')
            .attr({ 'aria-valuemin': 0, 'aria-valuemax': n - 1, 'aria-valuenow': _lt.iDesde, 'aria-valuetext': meses[_lt.iDesde].etiqueta });
        $('#ltKnobTo').css('left', pctHasta + '%')
            .attr({ 'aria-valuemin': 0, 'aria-valuemax': n - 1, 'aria-valuenow': _lt.iHasta, 'aria-valuetext': meses[_lt.iHasta].etiqueta });
        $('#ltRangoSel').css({ left: pctDesde + '%', width: (pctHasta - pctDesde) + '%' });

        // Un solo mes (p. ej. "Mes actual"): se muestra "Ago 2026" en vez de "Ago 2026 → Ago 2026".
        var unMes = _lt.iDesde === _lt.iHasta;
        $('#ltRangoDesdeLbl').text(meses[_lt.iDesde].etiqueta);
        $('#ltRangoHastaLbl').text(unMes ? '' : meses[_lt.iHasta].etiqueta).toggle(!unMes);
        $('#ltRangoDesdeLbl').next('i').toggle(!unMes);

        var totalMeses = _lt.iHasta - _lt.iDesde + 1;
        $('#ltRangoBadge').text(totalMeses + ' ' + (totalMeses === 1 ? _lt.textos.badgeMes : _lt.textos.badgeMeses));

        var anios = [];
        meses.forEach(function (m) { if (anios.indexOf(m.anio) === -1) anios.push(m.anio); });
        $('#ltRangoYears').html(anios.map(function (a) { return '<span>' + a + '</span>'; }).join(''));

        actualizarAtajoActivo();
        actualizarBotonGenerar();
    }

    function actualizarAtajoActivo() {
        RangoAtajos.pintarBotones($('#ltAtajos button'), _lt.mesesCache, _lt.hoy, _lt.iDesde, _lt.iHasta,
            _lt.mesesAbrev, { tooltipFmt: _lt.textos.rangoTooltipFmt, sinDatosFmt: _lt.textos.rangoSinDatosFmt });
    }

    function indiceDesdeClientX(clientX) {
        var track = document.getElementById('ltRangoTrack');
        var rect = track.getBoundingClientRect();
        var n = _lt.mesesCache.length;
        var frac = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
        return Math.round(frac * (n - 1));
    }

    function moverExtremo(cual, idx) {
        var n = _lt.mesesCache.length;
        idx = Math.min(n - 1, Math.max(0, idx));
        if (cual === 'from') {
            _lt.iDesde = idx;
            if (_lt.iDesde > _lt.iHasta) _lt.iHasta = _lt.iDesde;
        } else {
            _lt.iHasta = idx;
            if (_lt.iHasta < _lt.iDesde) _lt.iDesde = _lt.iHasta;
        }
        pintarRango();
    }

    function iniciarArrastreSlider(e, cual) {
        if (_lt.mesesCache.length < 2) return;
        e.preventDefault();
        var track = $('#ltRangoTrack').addClass('dragging');

        function onMove(ev) { moverExtremo(cual, indiceDesdeClientX(ev.clientX)); }
        function onUp() {
            track.removeClass('dragging');
            window.removeEventListener('pointermove', onMove);
            window.removeEventListener('pointerup', onUp);
        }
        window.addEventListener('pointermove', onMove);
        window.addEventListener('pointerup', onUp);
    }

    function clicEnPista(e) {
        if ($(e.target).hasClass('knob') || _lt.mesesCache.length < 2) return;
        var idx = indiceDesdeClientX(e.clientX);
        var cual = Math.abs(idx - _lt.iDesde) <= Math.abs(idx - _lt.iHasta) ? 'from' : 'to';
        moverExtremo(cual, idx);
        iniciarArrastreSlider(e, cual);
    }

    function moverKnobConTeclado(e, cual) {
        var n = _lt.mesesCache.length;
        if (n < 2) return;
        var idx = cual === 'from' ? _lt.iDesde : _lt.iHasta;
        if (e.key === 'ArrowLeft') idx -= 1;
        else if (e.key === 'ArrowRight') idx += 1;
        else if (e.key === 'Home') idx = 0;
        else if (e.key === 'End') idx = n - 1;
        else return;
        e.preventDefault();
        moverExtremo(cual, idx);
    }

    function campoSeleccionado() {
        return $('#ltCampoWrap').is(':visible') ? elCampo.val() : _lt.campoUnico;
    }

    // Nombre amigable del Campo activo (Valor, Valor Presupuesto, Valor Futuro, etc.) — usado como
    // encabezado dinámico de la columna de valor en la tabla y en el PDF.
    function campoSeleccionadoTexto() {
        return $('#ltCampoWrap').is(':visible') ? elCampo.find(':selected').text() : (_lt.campoUnicoTexto || '');
    }

    // Encabezado de la columna de valor (tabla en pantalla y PDF): prioriza el nombre amigable del
    // Campo elegido; si no hay ninguno (no debería pasar), cae al nombre del escenario o del indicador.
    function ltEtiquetaColumnaValor(resp, indicadorUnico) {
        return campoSeleccionadoTexto() || resp.nombreEscenarioPrincipal || indicadorUnico || _lt.textos.colValor;
    }

    function armarFiltros() {
        var n = _lt.mesesCache.length;
        var desde = n ? _lt.mesesCache[_lt.iDesde] : null;
        var hasta = n ? _lt.mesesCache[_lt.iHasta] : null;
        var indicadores = indicadoresSeleccionados();

        var filtros = {
            NombreTabla: elTabla.val(),
            IdEmpresa: empresaSeleccionada(),
            IdEscenario: elEscenario.val(),
            Indicadores: indicadores,
            Campo: campoSeleccionado(),
            AnioDesde: desde ? desde.anio : null,
            MesDesde: desde ? desde.mes : null,
            AnioHasta: hasta ? hasta.anio : null,
            MesHasta: hasta ? hasta.mes : null,
            Agrupar: _lt.agrupar,
            __RequestVerificationToken: _lt.token
        };
        // Comparar escenario solo aplica con una única variable seleccionada (ver actualizarDisponibilidadComparar)
        if (indicadores.length === 1) {
            filtros.IdEscenarioComparar = $('#ltEscenarioComparar').val() || null;
        }
        return filtros;
    }

    function generar() {
        var filtros = armarFiltros();
        if (!filtros.Indicadores.length || !filtros.Campo) return;

        $('#ltEstadoInicial, #ltSinDatos, #ltResultado').hide();
        $('#ltLoading').show();

        // traditional:true para que jQuery serialice Indicadores como "Indicadores=A&Indicadores=B"
        // (lo que el model binder de MVC espera para List<string>), en vez del formato "Indicadores[]=A".
        $.ajax({ url: _lt.urls.serie, type: 'POST', data: filtros, traditional: true })
            .done(function (resp) {
                $('#ltLoading').hide();
                var totalPuntos = (resp.series || []).reduce(function (a, s) { return a + s.puntos.length; }, 0);
                if (!resp.success || totalPuntos === 0) {
                    $('#ltSinDatos').show();
                    return;
                }
                _lt.ultimaRespuesta = resp;
                _lt.ocultas = {}; // cada "Generar" nuevo arranca con todas las series visibles
                ltPintarStrip(resp);
                ltEvaluarEscala(resp);
                pintarLetterhead(resp);
                pintarGrafico(resp);
                pintarTabla(resp);
                ltAplicarVisibilidad();
                $('#ltResultado').show();
            })
            .fail(function () {
                $('#ltLoading').hide();
                $('#ltSinDatos').show();
            });
    }

    function limpiar() {
        elTabla.val('').trigger('change.select2');
        if (_lt.esAdmin) elEmpresa.prop('selectedIndex', 0).trigger('change.select2');
        elEscenario.prop('selectedIndex', 0).trigger('change.select2');
        elEscenarioComparar.val('').trigger('change.select2');
        $('#ltCompararPanel').prop('hidden', true);
        $('#ltBtnToggleComparar').removeClass('open');
        _lt.agrupar = 'Mes';
        $('#ltSegVerPor button').removeClass('active').attr('aria-pressed', 'false');
        $('#ltSegVerPor button[data-modo="Mes"]').addClass('active').attr('aria-pressed', 'true');
        $('#ltAgruparHint').text(_lt.textos.agruparAyuda.Mes);
        _lt.unidad = 'pesos';
        $('#ltUnidadLbl').text(_lt.textos.unidades.pesos);
        _lt.etiquetas = true;
        $('#ltBtnEtiquetas').addClass('on');
        _lt.escala = 'real';
        $('#ltScaleSeg button').removeClass('active');
        $('#ltScaleSeg button[data-scale="real"]').addClass('active');
        $('#ltScaleBar, #ltScaleHint').hide();
        _lt.ocultas = {};
        destruirPaneles();
        recargarCascada();
    }

    function escalarValor(v) {
        if (_lt.unidad === 'miles') return v / 1000;
        if (_lt.unidad === 'millones') return v / 1000000;
        return v;
    }

    function sufijoUnidad() {
        if (_lt.unidad === 'miles') return ' ' + _lt.textos.unidadSufijoMiles;
        if (_lt.unidad === 'millones') return ' ' + _lt.textos.unidadSufijoMillones;
        return '';
    }

    function fmtCompacto(v) {
        var escalado = escalarValor(v);
        var decimales = _lt.unidad === 'pesos' ? 0 : 1;
        try { return new Intl.NumberFormat(_lt.cultura, { minimumFractionDigits: decimales, maximumFractionDigits: decimales }).format(escalado) + sufijoUnidad(); }
        catch (e) { return escalado + sufijoUnidad(); }
    }

    function fmtDecimal(v) {
        var escalado = escalarValor(v);
        var decimales = _lt.unidad === 'pesos' ? 2 : 1;
        try { return new Intl.NumberFormat(_lt.cultura, { minimumFractionDigits: decimales, maximumFractionDigits: decimales }).format(escalado) + sufijoUnidad(); }
        catch (e) { return escalado + sufijoUnidad(); }
    }

    function ultimoYVariacion(pts) {
        if (!pts.length) return { ultimo: null, variacion: null, etiquetaAnterior: null };
        var ultimo = pts[pts.length - 1].valor;
        var previo = pts.length > 1 ? pts[pts.length - 2].valor : ultimo;
        var etiquetaAnterior = pts.length > 1 ? pts[pts.length - 2].etiqueta : null;
        var variacion = (pts.length > 1 && previo) ? ((ultimo - previo) / Math.abs(previo)) * 100 : null;
        return { ultimo: ultimo, variacion: variacion, etiquetaAnterior: etiquetaAnterior };
    }

    // Cabecera consolidada: el título lleva la tabla + la(s) variable(s) ("PYG · Ingresos" o
    // "PYG · 3 variables comparadas"); el resto de contexto (empresa, escenario, rango, agrupación)
    // vive en el subtítulo.
    function pintarLetterhead(resp) {
        var series = resp.series || [];
        var tablaInfo = CATALOGO_TABLAS[elTabla.val()] || {};
        var tituloVariable = series.length === 1
            ? (series[0].indicador || '')
            : _lt.textos.tituloMultiplesVariables.replace('{0}', series.length);
        var titulo = (tablaInfo.nombre || '') + (tituloVariable ? (' ' + CH_MIDDOT + ' ' + tituloVariable) : '');

        var empresaTexto = elEmpresa.find(':selected').text();
        var escenarioTexto = resp.nombreEscenarioPrincipal || elEscenario.find(':selected').text();
        var puntosRango = series.length ? series[0].puntos : [];
        var rango = puntosRango.length ? (puntosRango[0].etiqueta + (puntosRango.length > 1 ? (' ' + CH_NDASH + ' ' + puntosRango[puntosRango.length - 1].etiqueta) : '')) : '';
        var agruparTexto = $('#ltSegVerPor button.active span').text().toLowerCase();

        var subtitulo = empresaTexto + ' ' + CH_MIDDOT + ' ' + escenarioTexto +
            (resp.comparacion && resp.comparacion.length ? (' vs. ' + (resp.nombreEscenarioComparacion || '')) : '') +
            (rango ? (' ' + CH_MIDDOT + ' ' + rango) : '') +
            (agruparTexto ? (' ' + CH_MIDDOT + ' ' + _lt.textos.porAgrupacion.replace('{0}', agruparTexto)) : '');

        $('#ltChartTitle').text(titulo);
        $('#ltChartSubtitle').text(subtitulo);

        try {
            $('#ltFechaGenerado').text(_lt.textos.generadoElFmt.replace('{0}',
                new Date().toLocaleDateString(_lt.cultura, { day: 'numeric', month: 'long', year: 'numeric' })));
        } catch (e) { $('#ltFechaGenerado').text(''); }
    }

    function datasetSerie(label, puntos, color, esBarra, conRelleno) {
        return {
            label: label,
            data: puntos.map(function (p) { return p.valor; }),
            borderColor: color,
            backgroundColor: esBarra ? ltColorConAlfa(color, .85) : ltColorConAlfa(color, .16),
            borderWidth: esBarra ? 0 : 2.5,
            borderRadius: esBarra ? 6 : 0,
            maxBarThickness: 34,
            minBarLength: esBarra ? 30 : undefined,
            tension: 0.35,
            fill: !esBarra && conRelleno,
            pointRadius: 4,
            pointHoverRadius: 6,
            pointBackgroundColor: color
        };
    }

    function pintarGrafico(resp) {
        var series = resp.series || [];
        var esBarra = _lt.tipoGrafico === 'bar';
        var labels = series.length ? series[0].puntos.map(function (p) { return p.etiqueta; }) : [];

        // Con una sola variable: comportamiento clásico (línea/barra índigo, +opcional comparación
        // de escenario en ámbar). Con varias variables: una serie por variable, cada una con su
        // propio color de LT_PALETTE — sin relleno de área para que no se solapen entre sí.
        var datasets = series.length === 1
            ? [datasetSerie(resp.nombreEscenarioPrincipal || series[0].indicador, series[0].puntos, ltColorSerie(0), esBarra, true)]
            : series.map(function (s, i) { return datasetSerie(s.indicador, s.puntos, ltColorSerie(i), esBarra, false); });

        if (series.length === 1 && resp.comparacion && resp.comparacion.length > 0) {
            datasets.push(datasetSerie(resp.nombreEscenarioComparacion || _lt.textos.colComparacion, resp.comparacion, '#D97706', esBarra, true));
        }

        // El interruptor "Etiquetas" decide si se dibuja el valor encima de cada punto/barra. La
        // leyenda de Chart.js queda siempre apagada — la tira de series (#ltSeriesStrip) cumple esa
        // función (color + nombre + interruptor de visibilidad, todo en una sola pieza).
        var plugins = _lt.etiquetas ? [ltDataLabelsPlugin] : [];

        if (_lt.chart) { _lt.chart.destroy(); }
        _lt.chart = new Chart(document.getElementById('ltChart').getContext('2d'), {
            type: esBarra ? 'bar' : 'line',
            data: { labels: labels, datasets: datasets },
            plugins: plugins,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                layout: { padding: { top: 20 } },
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { display: false },
                    tooltip: { mode: 'index', intersect: false, callbacks: { label: function (ctx) { return ctx.dataset.label + ': ' + fmtCompacto(ctx.parsed.y); } } }
                },
                scales: {
                    x: { grid: { display: false }, ticks: { font: { weight: '700' }, color: '#5B5570' } },
                    y: { beginAtZero: false, grid: { color: '#EEF0F6' }, ticks: { color: '#b9b4c9', font: { weight: '600' }, callback: function (v) { return fmtCompacto(v); } } }
                }
            }
        });
    }

    // Unión ordenada de todos los períodos presentes en cualquiera de las series (normalmente
    // coinciden, pero cada serie se consulta por separado) — clave "anio-mes" -> {anio, mes, etiqueta}.
    function ltClavesPeriodo(series) {
        var vistos = {}, claves = [];
        series.forEach(function (s) {
            s.puntos.forEach(function (p) {
                var k = p.anio + '-' + p.mes;
                if (!vistos[k]) { vistos[k] = { anio: p.anio, mes: p.mes, etiqueta: p.etiqueta }; claves.push(k); }
            });
        });
        claves.sort(function (a, b) { return vistos[a].anio - vistos[b].anio || vistos[a].mes - vistos[b].mes; });
        return { claves: claves, porClave: vistos };
    }

    function ltMapaValores(puntos) {
        var m = {};
        puntos.forEach(function (p) { m[p.anio + '-' + p.mes] = p.valor; });
        return m;
    }

    function pintarTabla(resp) {
        var series = resp.series || [];
        var conComparacion = series.length === 1 && resp.comparacion && resp.comparacion.length > 0;

        var head = '<th>' + _lt.textos.colPeriodo + '</th>';
        if (series.length === 1) {
            head += '<th style="text-align:right;">' + $('<span>').text(ltEtiquetaColumnaValor(resp, series[0].indicador)).html() + '</th>';
            if (conComparacion) head += '<th style="text-align:right;">' + $('<span>').text(resp.nombreEscenarioComparacion || _lt.textos.colComparacion).html() + '</th><th style="text-align:right;">' + _lt.textos.colVariacion + '</th>';
        } else {
            series.forEach(function (s, i) {
                head += '<th style="text-align:right;"><span class="lt-th-swatch" style="background:' + ltColorSerie(i) + '"></span>' + $('<span>').text(s.indicador).html() + '</th>';
            });
        }
        $('#ltTablaHead').html(head);

        var periodos = ltClavesPeriodo(series);
        var mapasPorSerie = series.map(function (s) { return ltMapaValores(s.puntos); });
        var comparacionPorClave = conComparacion ? ltMapaValores(resp.comparacion) : {};

        var filas = periodos.claves.map(function (k) {
            var periodo = periodos.porClave[k];
            var fila = '<tr><td>' + $('<span>').text(periodo.etiqueta).html() + '</td>';
            if (series.length === 1) {
                var v = mapasPorSerie[0][k];
                fila += '<td class="num">' + (v !== undefined ? fmtDecimal(v) : CH_MDASH) + '</td>';
                if (conComparacion) {
                    var b = comparacionPorClave[k];
                    if (b !== undefined) {
                        var delta = b ? (((v || 0) - b) / Math.abs(b)) * 100 : 0;
                        var cls = delta >= 0 ? 'up' : 'down', flecha = delta >= 0 ? CH_UP : CH_DOWN;
                        fila += '<td class="num">' + fmtDecimal(b) + '</td><td class="num"><span class="lt-var-chip ' + cls + '">' + flecha + ' ' + Math.abs(delta).toFixed(1) + '%</span></td>';
                    } else {
                        fila += '<td class="num">' + CH_MDASH + '</td><td class="num">' + CH_MDASH + '</td>';
                    }
                }
            } else {
                mapasPorSerie.forEach(function (mapa) {
                    var v = mapa[k];
                    fila += '<td class="num">' + (v !== undefined ? fmtDecimal(v) : CH_MDASH) + '</td>';
                });
            }
            return fila + '</tr>';
        }).join('');
        $('#ltTablaBody').html(filas);
    }

    function exportar() {
        var filtros = armarFiltros();
        if (!filtros.Indicadores.length || !filtros.Campo) return;

        var form = document.createElement('form');
        form.method = 'POST';
        form.action = _lt.urls.exportar;

        function addInput(nombre, valor) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = nombre;
            input.value = valor == null ? '' : valor;
            form.appendChild(input);
        }

        Object.keys(filtros).forEach(function (k) {
            var val = filtros[k];
            if (Array.isArray(val)) { val.forEach(function (item) { addInput(k, item); }); return; }
            addInput(k, val);
        });

        // Estado visual de la pantalla, para que el Excel (tabla + gráfico nativo) salga igual a lo
        // que el usuario está viendo: tipo de gráfico, unidad, series ocultas y títulos.
        addInput('TipoGrafico', _lt.tipoGrafico);
        addInput('Unidad', _lt.unidad);
        addInput('Titulo', $('#ltChartTitle').text());
        addInput('Subtitulo', $('#ltChartSubtitle').text());
        addInput('CampoTexto', campoSeleccionadoTexto());
        Object.keys(_lt.ocultas).forEach(function (nombre) {
            if (_lt.ocultas[nombre]) addInput('SeriesOcultas', nombre);
        });

        document.body.appendChild(form);
        form.submit();
        document.body.removeChild(form);
    }

    function generarPdf(modo) {
        if (!_lt.ultimaRespuesta || !_lt.chart) return;
        var btn = document.getElementById('btnExportarPDF');
        var htmlOriginal = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ' + _lt.textos.pdfGenerando;

        try {
            var resp = _lt.ultimaRespuesta;
            var jsPDFCtor = window.jspdf.jsPDF;
            var pdf = new jsPDFCtor('p', 'mm', 'a4');
            var pageW = pdf.internal.pageSize.getWidth();
            var pageH = pdf.internal.pageSize.getHeight();
            var margin = 14;
            var y;

            function dibujarPiePagina() {
                var num = pdf.internal.getNumberOfPages();
                pdf.setFontSize(7.5);
                pdf.setTextColor(150, 145, 165);
                pdf.text(_lt.textos.pdfFooter, margin, pageH - 8);
                pdf.text(String(num), pageW - margin, pageH - 8, { align: 'right' });
            }

            function nuevaPagina() {
                pdf.addPage();
                y = margin;
                dibujarPiePagina();
            }

            // Encabezado tipo carta
            pdf.setFillColor(99, 102, 241);
            pdf.rect(0, 0, pageW, 24, 'F');
            pdf.setTextColor(255, 255, 255);
            pdf.setFont(undefined, 'bold');
            pdf.setFontSize(15);
            pdf.text('BUFINS', margin, 15);

            var series = resp.series || [];
            // En el encabezado (una sola línea, ancho limitado) se muestra el conteo cuando hay
            // varias variables — los nombres completos igual quedan en las tarjetas KPI y la tabla.
            var titulo = series.length === 1 ? (series[0].indicador || '') : _lt.textos.tituloMultiplesVariables.replace('{0}', series.length);
            var tablaInfo = CATALOGO_TABLAS[elTabla.val()] || {};
            var empresaTexto = elEmpresa.find(':selected').text();
            var escenarioTexto = resp.nombreEscenarioPrincipal || elEscenario.find(':selected').text();
            var subtitulo = (tablaInfo.nombre || '') + '  ' + CH_MIDDOT + '  ' + empresaTexto + '  ' + CH_MIDDOT + '  ' + escenarioTexto;

            pdf.setFont(undefined, 'normal');
            pdf.setFontSize(9);
            pdf.text(titulo, pageW - margin, 10, { align: 'right' });
            pdf.setFontSize(8);
            pdf.text(subtitulo, pageW - margin, 16, { align: 'right' });

            y = 32;
            pdf.setTextColor(30, 20, 50);

            // Resumen del PDF (propio de esta exportación, independiente de la tira de series en
            // pantalla): con 1 variable, Último/Promedio/Períodos; con varias, una tarjeta por
            // variable (mismo color que su línea/barra) con su último valor.
            var kpis;
            if (series.length <= 1) {
                var pts = series.length ? series[0].puntos : [];
                var ultimo = pts.length ? pts[pts.length - 1].valor : 0;
                var promedio = pts.length ? pts.reduce(function (a, p) { return a + p.valor; }, 0) / pts.length : 0;
                kpis = [
                    { label: _lt.textos.kpiUltimo, valor: fmtCompacto(ultimo) },
                    { label: _lt.textos.kpiPromedio, valor: fmtCompacto(promedio) },
                    { label: _lt.textos.kpiPeriodos, valor: String(pts.length) }
                ];
            } else {
                kpis = series.map(function (s, i) {
                    var pts = s.puntos;
                    var ultimo = pts.length ? pts[pts.length - 1].valor : 0;
                    return { label: s.indicador, valor: fmtCompacto(ultimo), color: ltColorSerie(i) };
                });
            }

            var columnas = Math.min(kpis.length, 4) || 1;
            var kpiW = (pageW - margin * 2 - (columnas - 1) * 6) / columnas;
            kpis.forEach(function (k, i) {
                var col = i % columnas, filaKpi = Math.floor(i / columnas);
                var x = margin + col * (kpiW + 6);
                var yBox = y + filaKpi * 24;
                pdf.setDrawColor(228, 225, 240);
                pdf.setFillColor(244, 243, 251);
                pdf.roundedRect(x, yBox, kpiW, 18, 2, 2, 'FD');
                if (k.color) {
                    var rgb = ltHexARgb(k.color);
                    pdf.setFillColor(rgb.r, rgb.g, rgb.b);
                    pdf.circle(x + 5, yBox + 5.2, 1.3, 'F');
                }
                pdf.setFontSize(7.5);
                pdf.setTextColor(120, 115, 140);
                pdf.text(String(k.label), x + (k.color ? 8 : 4), yBox + 7, { maxWidth: kpiW - (k.color ? 12 : 8) });
                pdf.setFontSize(12);
                pdf.setFont(undefined, 'bold');
                pdf.setTextColor(30, 20, 50);
                pdf.text(k.valor, x + 4, yBox + 14);
                pdf.setFont(undefined, 'normal');
            });
            y += Math.ceil(kpis.length / columnas) * 24;

            // Unidad en la que se exportaron las cifras (el toggle Pesos/Miles/Millones no queda
            // capturado en la imagen del gráfico, así que se deja explícito como texto aparte) +
            // Campo consultado (Valor, Valor Presupuesto, Valor Futuro, etc.) — aplica a todas las
            // series del PDF, así que se muestra una sola vez aquí en vez de repetirlo por columna.
            var unidadTexto = $('#ltUnidadLbl').text().trim();
            var campoTextoPdf = campoSeleccionadoTexto();
            pdf.setFontSize(8.5);
            pdf.setTextColor(140, 135, 160);
            pdf.text(_lt.textos.pdfUnidadPrefijo + ' ' + unidadTexto + (campoTextoPdf ? ('  ' + CH_MIDDOT + '  ' + campoTextoPdf) : ''), margin, y);
            pdf.setTextColor(30, 20, 50);
            y += 7;

            // Gráfico (imagen nativa de Chart.js, sin html2canvas) — respeta la escala activa
            // (real: una sola imagen; paneles: una imagen por serie, cada una con su etiqueta)
            var imagenGrafico = ltCapturarImagenGrafico();
            if (imagenGrafico && imagenGrafico.tipo === 'panel') {
                imagenGrafico.paneles.forEach(function (p) {
                    var imgWp = pageW - margin * 2;
                    var imgHp = Math.min(imgWp * p.height / p.width, 55);
                    if (y + 6 + imgHp > pageH - margin - 10) nuevaPagina();
                    pdf.setFontSize(8.5);
                    pdf.setFont(undefined, 'bold');
                    pdf.setTextColor(30, 20, 50);
                    pdf.text(p.nombre, margin, y + 4);
                    pdf.setFont(undefined, 'normal');
                    pdf.setTextColor(140, 135, 160);
                    pdf.text(_lt.textos.maxAbrev + ' ' + fmtCompacto(p.max), pageW - margin, y + 4, { align: 'right' });
                    pdf.setTextColor(30, 20, 50);
                    y += 7;
                    pdf.addImage(p.dataUrl, 'PNG', margin, y, imgWp, imgHp);
                    y += imgHp + 6;
                });
                y += 4;
            } else if (imagenGrafico) {
                var imgW = pageW - margin * 2;
                var imgH = Math.min(imgW * imagenGrafico.height / imagenGrafico.width, 110);
                pdf.addImage(imagenGrafico.dataUrl, 'PNG', margin, y, imgW, imgH);
                y += imgH + 10;
            }

            if (modo === 'datos') {
                var conComparacionPdf = series.length === 1 && resp.comparacion && resp.comparacion.length > 0;
                var headers = [_lt.textos.colPeriodo];
                if (series.length === 1) {
                    headers.push(ltEtiquetaColumnaValor(resp, series[0].indicador));
                    if (conComparacionPdf) headers.push(resp.nombreEscenarioComparacion || _lt.textos.colComparacion, _lt.textos.colVariacion);
                } else {
                    series.forEach(function (s) { headers.push(s.indicador); });
                }

                var periodosPdf = ltClavesPeriodo(series);
                var mapasPorSeriePdf = series.map(function (s) { return ltMapaValores(s.puntos); });
                var comparacionPorClave = conComparacionPdf ? ltMapaValores(resp.comparacion) : {};

                var filas = periodosPdf.claves.map(function (k) {
                    var periodo = periodosPdf.porClave[k];
                    var fila = [periodo.etiqueta];
                    if (series.length === 1) {
                        var v = mapasPorSeriePdf[0][k];
                        fila.push(v !== undefined ? fmtDecimal(v) : CH_MDASH);
                        if (conComparacionPdf) {
                            var b = comparacionPorClave[k];
                            if (b !== undefined) {
                                var delta = b ? (((v || 0) - b) / Math.abs(b)) * 100 : 0;
                                fila.push(fmtDecimal(b), (delta >= 0 ? '+' : '') + delta.toFixed(1) + '%');
                            } else {
                                fila.push(CH_MDASH, CH_MDASH);
                            }
                        }
                    } else {
                        mapasPorSeriePdf.forEach(function (mapa) {
                            var v = mapa[k];
                            fila.push(v !== undefined ? fmtDecimal(v) : CH_MDASH);
                        });
                    }
                    return fila;
                });

                var colW = (pageW - margin * 2) / headers.length;
                var rowH = 7;

                if (y + rowH * 2 > pageH - margin - 10) nuevaPagina();

                var cabeceraTabla = function () {
                    pdf.setFillColor(99, 102, 241);
                    pdf.setTextColor(255, 255, 255);
                    pdf.setFont(undefined, 'bold');
                    pdf.setFontSize(8.5);
                    headers.forEach(function (h, i) {
                        pdf.rect(margin + i * colW, y, colW, rowH, 'F');
                        pdf.text(String(h), margin + i * colW + 3, y + 4.8);
                    });
                    y += rowH;
                    pdf.setFont(undefined, 'normal');
                    pdf.setTextColor(30, 20, 50);
                    pdf.setFontSize(8);
                };
                cabeceraTabla();

                filas.forEach(function (fila, idx) {
                    if (y + rowH > pageH - margin - 10) { nuevaPagina(); cabeceraTabla(); }
                    if (idx % 2 === 1) { pdf.setFillColor(244, 243, 251); pdf.rect(margin, y, pageW - margin * 2, rowH, 'F'); }
                    fila.forEach(function (val, i) { pdf.text(String(val), margin + i * colW + 3, y + 4.8); });
                    y += rowH;
                });
            }

            dibujarPiePagina();

            var fecha = new Date().toISOString().slice(0, 10).replace(/-/g, '');
            var nombreArchivo = ('LineaTiempo_' + (titulo || 'Indicador')).replace(/[^a-zA-Z0-9_\-]+/g, '_') + '_' + fecha + '.pdf';
            pdf.save(nombreArchivo);
        } catch (e) {
            console.error(e);
            Swal.fire({ icon: 'error', title: _lt.textos.pdfErrorGeneral });
        } finally {
            btn.disabled = false;
            btn.innerHTML = htmlOriginal;
        }
    }
})();
</script>
}
