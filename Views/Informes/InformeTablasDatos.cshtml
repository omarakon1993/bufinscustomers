@model dynamic
@using bufinscustomers.Models

@{
    ViewBag.Title = Resources.Strings.Tablas_PageTitle;
    var tablas = ViewBag.Tablas as List<TablaDatos>;
    var empresas = ViewBag.Empresas as List<Empresas>;
    var esAdmin = (bool)ViewBag.EsAdmin;
}

<link href="~/Assets/css/informe-tablas-datos.css" rel="stylesheet" />
<!-- Select2 CSS Local -->
<link href="~/Assets/css/select2/select2.min.css" rel="stylesheet" />

<div class="container-fluid px-4">
    <!-- Header Power BI -->
    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas fa-chart-line powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@Resources.Strings.Tablas_PageTitle</h1>
        </div>
    </div>

    <!-- Mensajes de exito/error -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle mr-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle mr-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="fas fa-info-circle mr-2"></i>
            @TempData["InfoMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- Card de filtros -->
    <div class="filter-card">
        <h3 class="filter-card-title">
            <i class="fas fa-filter"></i>
            @Resources.Strings.Common_FiltrosConsulta
        </h3>

        <form id="formFiltros">
            <!-- Filtros Principales -->
            <div class="filter-section">
                <div class="row">
                    <!-- Selector de Tabla -->
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="selectTabla">
                                <i class="fas fa-table"></i>
                                @Resources.Strings.Common_LabelTabla <span class="required">*</span>
                            </label>
                            <select id="selectTabla" name="NombreTabla" class="form-control" required>
                                <option value="">@Resources.Strings.Common_Seleccione</option>
                                @if (tablas != null)
                                {
                                    foreach (var tabla in tablas)
                                    {
                                        <option value="@tabla.NombreTabla" title="@tabla.Descripcion">
                                            @tabla.NombreAmigable
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Selector de Empresa -->
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="selectEmpresa">
                                <i class="fas fa-building"></i>
                                @Resources.Strings.Common_LabelEmpresa @if (esAdmin) { <span class="required">*</span> }
                            </label>
                            <select id="selectEmpresa" name="IdEmpresa" class="form-control" @(esAdmin ? "required" : "")>
                                @if (esAdmin)
                                {
                                    <option value="">@Resources.Strings.Common_Seleccione</option>
                                }
                                @if (empresas != null)
                                {
                                    foreach (var empresa in empresas)
                                    {
                                        <option value="@empresa.Id">@empresa.Nombre</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <!-- Selector de Anio -->
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="selectAnio">
                                <i class="fas fa-calendar-alt"></i>
                                @Resources.Strings.Common_LabelAnio
                            </label>
                            <select id="selectAnio" name="Anio" class="form-control">
                                <option value="">@Resources.Strings.Common_Todos</option>
                            </select>
                        </div>
                    </div>

                    <!-- Selector de Mes -->
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="selectMes">
                                <i class="fas fa-calendar-day"></i>
                                @Resources.Strings.Common_LabelMes
                            </label>
                            <select id="selectMes" name="Mes" class="form-control">
                                <option value="">@Resources.Strings.Common_Todos</option>
                                <option value="1">@Resources.Strings.Common_Mes1</option>
                                <option value="2">@Resources.Strings.Common_Mes2</option>
                                <option value="3">@Resources.Strings.Common_Mes3</option>
                                <option value="4">@Resources.Strings.Common_Mes4</option>
                                <option value="5">@Resources.Strings.Common_Mes5</option>
                                <option value="6">@Resources.Strings.Common_Mes6</option>
                                <option value="7">@Resources.Strings.Common_Mes7</option>
                                <option value="8">@Resources.Strings.Common_Mes8</option>
                                <option value="9">@Resources.Strings.Common_Mes9</option>
                                <option value="10">@Resources.Strings.Common_Mes10</option>
                                <option value="11">@Resources.Strings.Common_Mes11</option>
                                <option value="12">@Resources.Strings.Common_Mes12</option>
                            </select>
                        </div>
                    </div>

                    <!-- Selector de Variable -->
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="selectVariable">
                                <i class="fas fa-tag"></i>
                                @Resources.Strings.Common_LabelVariable
                            </label>
                            <select id="selectVariable" name="Variable" class="form-control">
                                <option value="">@Resources.Strings.Common_Todas</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Botones de accion -->
            <div class="btn-group-actions">
                <button type="button" id="btnConsultar" class="btn btn-modern-gradient">
                    <i class="fas fa-search mr-2"></i>@Resources.Strings.Common_Consultar
                </button>
                <button type="button" id="btnLimpiar" class="btn btn-modern-secondary">
                    <i class="fas fa-eraser mr-2"></i>@Resources.Strings.Common_Limpiar
                </button>
                <button type="button" id="btnExportar" class="btn btn-modern-success" style="display: none;">
                    <i class="fas fa-file-excel mr-2"></i>@Resources.Strings.Common_ExportarExcel
                </button>
            </div>
        </form>
    </div>

    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="loading-spinner">
        <i class="fas fa-spinner"></i>
        <p>@Resources.Strings.Common_ConsultandoDatos</p>
    </div>

    <!-- Tabla de resultados -->
    <div id="resultadosContainer" style="display: none;">
        <div class="table-container">
            <div class="table-header">
                <h5>
                    <i class="fas fa-list mr-2"></i>@Resources.Strings.Common_Resultados
                </h5>
                <span id="totalRegistros" class="info-badge"></span>
            </div>
            <div class="table-wrapper">
                <table id="tablaResultados" class="data-table">
                    <thead id="tablaHeader"></thead>
                    <tbody id="tablaBody"></tbody>
                </table>
            </div>
            <div id="paginacion" class="pagination-controls"></div>
        </div>
    </div>

    <!-- Mensaje cuando no hay datos -->
    <div id="noDataMessage" class="no-data-message" style="display: none;">
        <i class="fas fa-inbox"></i>
        <h4>@Resources.Strings.Common_NoData</h4>
        <p>@Resources.Strings.Common_NoDataFiltros</p>
    </div>
</div>

@section scripts {
    <script>
        var _tablasMsg = {
            errorAnios:        '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Tablas_JS_ErrorAnios)',
            errorVariables:    '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Tablas_JS_ErrorAnios)',
            errorConexion:     '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Tablas_JS_ErrorAnios)',
            tablaRequerida:    '@Resources.Strings.Common_JS_TablaRequerida',
            tablaSeleccionar:  '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Tablas_JS_ErrorAnios)',
            empresaRequerida:  '@Resources.Strings.Common_JS_EmpresaRequerida',
            empresaSeleccionar:'@HttpUtility.JavaScriptStringEncode(Resources.Strings.Tablas_JS_ErrorAnios)',
            sinDatos:          '@Resources.Strings.Common_JS_SinDatos',
            sinDatosExportar:  '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Tablas_JS_ErrorAnios)',
            exportando:        '@Resources.Strings.Common_JS_ExportandoExcel',
            generandoExcel:    '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Tablas_JS_ErrorAnios)',
            todos:             '@Resources.Strings.Common_Todos',
            todas:             '@Resources.Strings.Common_Todas',
            registrosPag:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_RegistrosPag))',
            noResultados:      '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Tablas_JS_ErrorAnios)',
            buscando:          '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Tablas_JS_ErrorAnios)',
            error:             '@Resources.Strings.Common_Error'
        };

        $(document).ready(function () {
            var datosActuales = null;
            var filtrosActuales = null;
            var paginaActual = 1;
            var registrosPorPagina = 50;

            // Evento: cambio de tabla
            $('#selectTabla').on('change', function () {
                var nombreTabla = $(this).val();
                var idEmpresa = $('#selectEmpresa').val();

                if (nombreTabla) {
                    cargarAnios(nombreTabla, idEmpresa);
                    cargarVariables(nombreTabla, idEmpresa);
                } else {
                    $('#selectAnio').html('<option value="">' + _tablasMsg.todos + '</option>');
                    $('#selectVariable').html('<option value="">' + _tablasMsg.todas + '</option>');
                }

                ocultarResultados();
            });

            // Evento: cambio de empresa
            $('#selectEmpresa').on('change', function () {
                var nombreTabla = $('#selectTabla').val();
                var idEmpresa = $(this).val();

                if (nombreTabla) {
                    cargarAnios(nombreTabla, idEmpresa);
                    cargarVariables(nombreTabla, idEmpresa);
                }

                ocultarResultados();
            });

            // Funcion: cargar anos disponibles
            function cargarAnios(nombreTabla, idEmpresa) {
                $.ajax({
                    url: '@Url.Action("ObtenerAnios", "InformeTablasDatos")',
                    type: 'GET',
                    data: {
                        nombreTabla: nombreTabla,
                        idEmpresa: idEmpresa || null
                    },
                    success: function (response) {
                        if (response.success) {
                            var select = $('#selectAnio');
                            select.html('<option value="">' + _tablasMsg.todos + '</option>');

                            if (response.anios && response.anios.length > 0) {
                                $.each(response.anios, function (i, anio) {
                                    select.append($('<option>').val(anio).text(anio));
                                });
                            }

                            select.trigger('change');
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: _tablasMsg.error,
                                text: response.message || _tablasMsg.errorAnios
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: _tablasMsg.error,
                            text: _tablasMsg.errorAnios
                        });
                    }
                });
            }

            // Funcion: cargar variables disponibles
            function cargarVariables(nombreTabla, idEmpresa) {
                $.ajax({
                    url: '@Url.Action("ObtenerVariables", "InformeTablasDatos")',
                    type: 'GET',
                    data: {
                        nombreTabla: nombreTabla,
                        idEmpresa: idEmpresa || null
                    },
                    success: function (response) {
                        if (response.success) {
                            var select = $('#selectVariable');
                            select.html('<option value="">' + _tablasMsg.todas + '</option>');

                            if (response.variables && response.variables.length > 0) {
                                $.each(response.variables, function (i, variable) {
                                    select.append($('<option>').val(variable).text(variable));
                                });
                            }

                            select.trigger('change');
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: _tablasMsg.error,
                            text: _tablasMsg.errorVariables
                        });
                    }
                });
            }

            // Evento: boton consultar
            $('#btnConsultar').on('click', function () {
                var nombreTabla = $('#selectTabla').val();

                if (!nombreTabla) {
                    Swal.fire({
                        icon: 'warning',
                        title: _tablasMsg.tablaRequerida,
                        text: _tablasMsg.tablaSeleccionar
                    });
                    return;
                }

                @if (esAdmin)
                {
                    <text>
                    var idEmpresa = $('#selectEmpresa').val();
                    if (!idEmpresa) {
                        Swal.fire({
                            icon: 'warning',
                            title: _tablasMsg.empresaRequerida,
                            text: _tablasMsg.empresaSeleccionar
                        });
                        return;
                    }
                    </text>
                }

                consultarDatos();
            });

            // Funcion: consultar datos
            function consultarDatos() {
                var formData = {
                    NombreTabla: $('#selectTabla').val(),
                    IdEmpresa: $('#selectEmpresa').val() || null,
                    Anio: $('#selectAnio').val() || null,
                    Mes: $('#selectMes').val() || null,
                    Variable: $('#selectVariable').val() || null
                };

                filtrosActuales = formData;
                $('#loadingSpinner').show();
                ocultarResultados();

                $.ajax({
                    url: '@Url.Action("ConsultarDatos", "InformeTablasDatos")',
                    type: 'POST',
                    data: formData,
                    success: function (response) {
                        $('#loadingSpinner').hide();

                        if (response.success) {
                            datosActuales = response;
                            paginaActual = 1;

                            if (response.totalRegistros > 0) {
                                mostrarResultados(response);
                            } else {
                                $('#noDataMessage').show();
                            }
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: _tablasMsg.error,
                                text: response.message || _tablasMsg.errorConexion
                            });
                        }
                    },
                    error: function () {
                        $('#loadingSpinner').hide();
                        Swal.fire({
                            icon: 'error',
                            title: _tablasMsg.error,
                            text: _tablasMsg.errorConexion
                        });
                    }
                });
            }

            // Funcion: mostrar resultados con paginacion
            function mostrarResultados(response) {
                $('#tablaHeader').empty();
                $('#tablaBody').empty();

                // Crear encabezados
                var headerRow = $('<tr>');
                $.each(response.columnas, function (i, col) {
                    headerRow.append($('<th>').text(col.nombreAmigable));
                });
                $('#tablaHeader').append(headerRow);

                // Calcular paginacion
                var totalPaginas = Math.ceil(response.datos.length / registrosPorPagina);
                var inicio = (paginaActual - 1) * registrosPorPagina;
                var fin = Math.min(inicio + registrosPorPagina, response.datos.length);

                // Crear filas de datos para la pagina actual
                for (var i = inicio; i < fin; i++) {
                    var fila = response.datos[i];
                    var row = $('<tr>');
                    $.each(response.columnas, function (j, col) {
                        var valor = fila[col.nombreTecnico];
                        row.append($('<td>').text(valor || ''));
                    });
                    $('#tablaBody').append(row);
                }

                // Actualizar informacion de registros
                $('#totalRegistros').text(response.totalRegistros + ' ' + _tablasMsg.registrosPag + ' ' + paginaActual + '/' + totalPaginas);

                // Crear controles de paginacion
                crearPaginacion(totalPaginas);

                // Mostrar contenedor de resultados
                $('#resultadosContainer').show();
                $('#btnExportar').show();
            }

            // Funcion: crear controles de paginacion
            function crearPaginacion(totalPaginas) {
                var paginacion = $('#paginacion');
                paginacion.empty();

                if (totalPaginas <= 1) return;

                // Boton anterior
                var btnAnterior = $('<button>')
                    .addClass('btn-pagination')
                    .html('<i class="fas fa-chevron-left"></i>')
                    .prop('disabled', paginaActual === 1)
                    .on('click', function () {
                        if (paginaActual > 1) {
                            paginaActual--;
                            mostrarResultados(datosActuales);
                        }
                    });
                paginacion.append(btnAnterior);

                // Botones de paginas
                var inicio = Math.max(1, paginaActual - 2);
                var fin = Math.min(totalPaginas, paginaActual + 2);

                if (inicio > 1) {
                    paginacion.append($('<button>').addClass('btn-pagination').text('1').on('click', function () {
                        paginaActual = 1;
                        mostrarResultados(datosActuales);
                    }));
                    if (inicio > 2) {
                        paginacion.append($('<span>').addClass('pagination-dots').text('...'));
                    }
                }

                for (var i = inicio; i <= fin; i++) {
                    var btnPagina = $('<button>')
                        .addClass('btn-pagination')
                        .text(i)
                        .data('pagina', i);

                    if (i === paginaActual) {
                        btnPagina.addClass('active');
                    }

                    btnPagina.on('click', function () {
                        paginaActual = $(this).data('pagina');
                        mostrarResultados(datosActuales);
                    });

                    paginacion.append(btnPagina);
                }

                if (fin < totalPaginas) {
                    if (fin < totalPaginas - 1) {
                        paginacion.append($('<span>').addClass('pagination-dots').text('...'));
                    }
                    paginacion.append($('<button>').addClass('btn-pagination').text(totalPaginas).on('click', function () {
                        paginaActual = totalPaginas;
                        mostrarResultados(datosActuales);
                    }));
                }

                // Boton siguiente
                var btnSiguiente = $('<button>')
                    .addClass('btn-pagination')
                    .html('<i class="fas fa-chevron-right"></i>')
                    .prop('disabled', paginaActual === totalPaginas)
                    .on('click', function () {
                        if (paginaActual < totalPaginas) {
                            paginaActual++;
                            mostrarResultados(datosActuales);
                        }
                    });
                paginacion.append(btnSiguiente);
            }

            // Funcion: ocultar resultados
            function ocultarResultados() {
                $('#resultadosContainer').hide();
                $('#noDataMessage').hide();
                $('#btnExportar').hide();
                datosActuales = null;
            }

            // Evento: boton limpiar
            $('#btnLimpiar').on('click', function () {
                $('#selectTabla').val('').trigger('change');
                $('#selectEmpresa').val($('#selectEmpresa option:first').val()).trigger('change');
                $('#selectMes').val('').trigger('change');

                $('#selectAnio').html('<option value="">' + _tablasMsg.todos + '</option>').trigger('change');
                $('#selectVariable').html('<option value="">' + _tablasMsg.todas + '</option>').trigger('change');

                ocultarResultados();
            });

            // Evento: boton exportar
            $('#btnExportar').on('click', function () {
                if (!filtrosActuales) {
                    Swal.fire({
                        icon: 'warning',
                        title: _tablasMsg.sinDatos,
                        text: _tablasMsg.sinDatosExportar
                    });
                    return;
                }

                var form = $('<form>', {
                    'method': 'POST',
                    'action': '@Url.Action("ExportarExcel", "InformeTablasDatos")'
                });

                $.each(filtrosActuales, function (key, value) {
                    if (value) {
                        form.append($('<input>', {
                            'type': 'hidden',
                            'name': key,
                            'value': value
                        }));
                    }
                });

                $('body').append(form);
                form.submit();
                form.remove();

                Swal.fire({
                    icon: 'success',
                    title: _tablasMsg.exportando,
                    text: _tablasMsg.generandoExcel,
                    timer: 2000,
                    showConfirmButton: false
                });
            });

            // Inicializar Select2
            var s2lang = {
                noResults: function() { return _tablasMsg.noResultados; },
                searching: function() { return _tablasMsg.buscando; }
            };

            $('#selectTabla').select2({ placeholder: _tablasMsg.todos, allowClear: false, width: '100%', language: s2lang });
            $('#selectEmpresa').select2({ placeholder: _tablasMsg.todos, allowClear: false, width: '100%', language: s2lang });
            $('#selectAnio').select2({ placeholder: _tablasMsg.todos, allowClear: true, width: '100%', language: s2lang });
            $('#selectMes').select2({ placeholder: _tablasMsg.todos, allowClear: true, width: '100%', minimumResultsForSearch: -1, language: { noResults: function() { return _tablasMsg.noResultados; } } });
            $('#selectVariable').select2({ placeholder: _tablasMsg.todas, allowClear: true, width: '100%', language: s2lang });
        });
    </script>
    <!-- Select2 JS Local -->
    <script src="~/Assets/js/select2/select2.min.js"></script>
}
