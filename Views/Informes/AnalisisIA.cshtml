        preguntaLabel:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IA_JS_PreguntaLabel))',
        generandoPDF:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IA_JS_GenerandoPDF))',
        errorPDF:           '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IA_JS_ErrorPDF))',
        filasInfo:          '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IA_FilasInfo))',
        noResultados:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IA_JS_SinResultados))',
        buscando:           '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IA_JS_Buscando))',
        error:              '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Error))',
        pdfTitle:           '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IA_PDF_Title))',
        pdfSubtitle:        '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IA_PDF_Subtitle))',
        pdfFiltros:         '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IA_PDF_Filtros))',
        pdfFooter:          '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IA_PDF_Footer))',
        labelTabla:         '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_LabelTabla))',
        labelEmpresa:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_LabelEmpresa))',
        labelAnio:          '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_LabelAnio))',
        labelMes:           '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_LabelMes))',
        labelVariable:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_LabelVariable))',
        btnExportarPDF:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IA_BtnExportarPDF))',
        mesTextoTodos:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Todos))',
        respuestaHeader:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IA_RespuestaHeader))',
        preguntaLarga:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IA_JS_PreguntaLarga))',
        preguntaLargaTexto: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IA_JS_PreguntaLargaTexto))',
