@model dynamic
@using bufinscustomers.Models

@{
    ViewBag.Title = "Análisis IA";
    var tablas         = ViewBag.Tablas  as List<TablaDatos>;
    var empresas       = ViewBag.Empresas as List<Empresas>;
    var esAdmin        = (bool)ViewBag.EsAdmin;
    var esAdminEmpresa = (bool)(ViewBag.EsAdminEmpresa ?? false);
}

<link href="~/Assets/css/informe-tablas-datos.css" rel="stylesheet" />
<link href="~/Assets/css/select2/select2.min.css"  rel="stylesheet" />
<link href="~/Assets/css/analisis-ia.css"           rel="stylesheet" />

<style>
/* ── Bloque pregunta en respuesta ── */
.ia-pregunta-block {
    background: linear-gradient(135deg,#ede9fe 0%,#ddd6fe 100%);
    border-left: 4px solid #7c3aed;
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 16px;
}
.ia-pregunta-block .ia-pregunta-label {
    font-size:.75rem; font-weight:700; letter-spacing:.07em;
    text-transform:uppercase; color:#6d28d9; margin-bottom:4px;
}
.ia-pregunta-block .ia-pregunta-texto { color:#3b0764; font-weight:500; font-size:.97rem; }

/* ── Boton historial ── */
.audit-btn-header {
    background:rgba(255,255,255,.18); border:1.5px solid rgba(255,255,255,.55);
    color:#fff; border-radius:8px; padding:6px 16px; font-size:.87rem;
    font-weight:600; cursor:pointer; transition:background .2s; white-space:nowrap;
}
.audit-btn-header:hover { background:rgba(255,255,255,.30); color:#fff; }

</style>

<div class="container-fluid px-4">

    <!-- Header -->
    <div class="powerbi-header" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
        <div class="powerbi-header-content">
            <i class="fas fa-robot powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">
                An&aacute;lisis IA
                <span class="ia-header-badge">
                    <i class="fas fa-circle" style="font-size:6px;"></i> OpenAI GPT
                </span>
            </h1>
        </div>
        <a href="@Url.Action("Index","AuditoriaConsultasIA")" class="audit-btn-header">
            <i class="fas fa-history"></i> Auditor&iacute;a Consultas
        </a>
    </div>

    <!-- Filtros -->
    <div class="filter-card">
        <h3 class="filter-card-title">
            <i class="fas fa-filter"></i> Selecciona los datos a analizar
        </h3>
        <div class="filter-section">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="selectTabla"><i class="fas fa-table"></i> Tabla <span class="required">*</span></label>
                        <select id="selectTabla" class="form-control" required>
                            <option value="">-- Seleccione --</option>
                            @if (tablas != null)
                            {
                                foreach (var t in tablas)
                                {
                                    <option value="@t.NombreTabla" data-nombre="@t.NombreAmigable">@t.NombreAmigable</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="selectEmpresa">
                            <i class="fas fa-building"></i>
                            Empresa @if (esAdmin) { <span class="required">*</span> }
                        </label>
                        <select id="selectEmpresa" class="form-control" @(esAdmin ? "required" : "")>
                            @if (esAdmin) { <option value="">-- Seleccione --</option> }
                            @if (empresas != null)
                            {
                                foreach (var e in empresas)
                                {
                                    <option value="@e.Id">@e.Nombre</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="selectAnio"><i class="fas fa-calendar-alt"></i> A&ntilde;o <span class="required">*</span></label>
                        <select id="selectAnio" class="form-control" required>
                            <option value="">-- Seleccione --</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="selectMes"><i class="fas fa-calendar-day"></i> Mes</label>
                        <select id="selectMes" class="form-control">
                            <option value="">-- Todos --</option>
                            <option value="1">Enero</option>  <option value="2">Febrero</option>
                            <option value="3">Marzo</option>  <option value="4">Abril</option>
                            <option value="5">Mayo</option>   <option value="6">Junio</option>
                            <option value="7">Julio</option>  <option value="8">Agosto</option>
                            <option value="9">Septiembre</option><option value="10">Octubre</option>
                            <option value="11">Noviembre</option><option value="12">Diciembre</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="selectVariable"><i class="fas fa-tag"></i> Variable</label>
                        <select id="selectVariable" class="form-control">
                            <option value="">-- Todas --</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="btn-group-actions">
            <button type="button" id="btnAnalizar" class="btn-ia-analizar">
                <i class="fas fa-robot"></i> Analizar
            </button>
            <button type="button" id="btnLimpiar" class="btn btn-modern-secondary">
                <i class="fas fa-eraser mr-2"></i> Limpiar
            </button>
        </div>
    </div>

    <!-- Placeholder -->
    <div id="placeholderIA" class="ia-placeholder">
        <div class="ia-placeholder-icon"><i class="fas fa-robot"></i></div>
        <h4>Selecciona los filtros y haz clic en Analizar</h4>
        <p>La IA generar&aacute; autom&aacute;ticamente un resumen gerencial de los datos seleccionados.</p>
    </div>

    <!-- Loading inicial -->
    <div id="loadingAnalisis" style="display:none;" class="ia-placeholder">
        <div class="ia-loading-wrap" style="padding:20px 0;">
            <div class="ia-loading-inner">
                <div class="ia-dots"><span></span><span></span><span></span></div>
                <p>Consultando datos y analizando con IA&hellip;</p>
            </div>
        </div>
    </div>

    <!-- Panel IA -->
    <div id="panelIA" style="display:none;" class="ia-panel">
        <div class="ia-panel-header">
            <div class="ia-panel-header-left">
                <div class="ia-panel-icon"><i class="fas fa-robot"></i></div>
                <div>
                    <div class="ia-panel-title">Asistente IA &mdash; An&aacute;lisis Financiero</div>
                    <div id="iaContexto" class="ia-panel-context"></div>
                </div>
            </div>
            <button type="button" id="btnNuevaConsulta" class="btn-nueva-consulta">
                <i class="fas fa-redo-alt"></i> Nueva consulta
            </button>
        </div>
        <div class="ia-actions-bar">
            <button type="button" id="btnResumenIA" class="btn-generar-resumen">
                <i class="fas fa-magic"></i> Generar Resumen Gerencial
            </button>
            <button type="button" id="btnExportarPDF" class="btn-exportar-pdf" onclick="exportarAnalisisPDF()" style="display:none;">
                <i class="fas fa-file-pdf"></i> Exportar PDF
            </button>
            <span class="ia-hint">o escribe una pregunta espec&iacute;fica abajo</span>
        </div>
        <div id="loadingIA" style="display:none;" class="ia-loading-wrap">
            <div class="ia-loading-inner">
                <div class="ia-dots"><span></span><span></span><span></span></div>
                <p>Analizando datos financieros&hellip;</p>
            </div>
        </div>
        <div id="respuestaIA" style="display:none;" class="ia-response-wrap">
            <div class="ia-response-header"><i class="fas fa-stars"></i> Respuesta del asistente</div>
            <div id="respuestaIATexto" class="ia-response-body"></div>
        </div>
        <div class="ia-input-section">
            <div class="ia-input-row">
                <input type="text" id="txtPreguntaIA" class="ia-text-input"
                       placeholder="Ej: &iquest;Cu&aacute;les son los 3 valores m&aacute;s altos? &iquest;C&oacute;mo fue el mes de marzo?" />
                <button type="button" id="btnPreguntarIA" class="btn-enviar" title="Enviar pregunta">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
            <div class="ia-branding">
                <i class="fas fa-lock"></i> Powered by OpenAI &nbsp;&middot;&nbsp;
                <i class="fas fa-database"></i> <span id="txtFilasInfo">An&aacute;lisis completo por a&ntilde;o seleccionado</span>
            </div>
        </div>
    </div>

</div>

<!-- PDF preview oculto -->
<div id="pdfPreview" class="pdf-preview-wrap">
    <div class="pdf-header">
        <img id="pdfLogo" src="@Url.Content("~/Assets/img/Bufins_LogoLogin.png")" class="pdf-logo" crossorigin="anonymous" />
        <div class="pdf-title-block">
            <div class="pdf-title">An&aacute;lisis Gerencial IA</div>
            <div class="pdf-subtitle">Generado por <strong>IA BUFINS</strong> &nbsp;&middot;&nbsp; <span id="pdfFecha"></span></div>
        </div>
    </div>
    <div class="pdf-filtros-block">
        <div class="pdf-filtros-title"><i class="fas fa-filter"></i> Filtros aplicados</div>
        <div id="pdfFiltros" class="pdf-filtros-grid"></div>
    </div>
    <div class="pdf-divider"></div>
    <div id="pdfContenido" class="pdf-contenido"></div>
    <div class="pdf-footer">
        <span>BUFINS &nbsp;&middot;&nbsp; Plataforma de An&aacute;lisis Financiero</span>
        <span id="pdfPage"></span>
    </div>
</div>

@section scripts {
<script src="~/Assets/js/select2/select2.min.js"></script>
<script src="~/Assets/js/html2canvas.min.js"></script>
<script src="~/Assets/js/jspdf.umd.min.js"></script>

<script>
    /* ── renderMarkdown global ── */
    function renderMarkdown(text) {
        if (!text) return '';
        return text
            .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
            .replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>')
            .replace(/\*(.+?)\*/g,'<em>$1</em>')
            .replace(/^### (.+)$/gm,'<h6 style="color:#4f46e5;font-weight:700;margin-top:12px;">$1</h6>')
            .replace(/^## (.+)$/gm, '<h5 style="color:#4f46e5;font-weight:700;margin-top:14px;">$1</h5>')
            .replace(/^# (.+)$/gm,  '<h4 style="color:#312e81;font-weight:700;margin-top:16px;">$1</h4>')
            .replace(/^[-*] (.+)$/gm,'<li>$1</li>')
            .replace(/(<li>[\s\S]+?<\/li>)/g,'<ul style="padding-left:18px;margin-bottom:8px;">$1</ul>')
            .replace(/\n\n/g,'</p><p style="margin-bottom:8px;">')
            .replace(/\n/g,'<br>');
    }
</script>

<script>
$(document).ready(function () {

    var filtrosActuales      = null;
    window._preguntaActualIA = null;

    // ── Filtros de datos ──────────────────────────────────
    $('#selectTabla').on('change', function () {
        var tabla   = $(this).val(), empresa = $('#selectEmpresa').val();
        $('#selectAnio').html('<option value="">-- Seleccione --</option>').trigger('change');
        $('#selectVariable').html('<option value="">-- Todas --</option>').trigger('change');
        if (tabla) { cargarAnios(tabla, empresa); cargarVariables(tabla, empresa); }
    });
    $('#selectEmpresa').on('change', function () {
        var tabla = $('#selectTabla').val(), empresa = $(this).val();
        if (tabla) { cargarAnios(tabla, empresa); cargarVariables(tabla, empresa); }
    });
    function cargarAnios(tabla, empresa) {
        $.get('@Url.Action("ObtenerAnios","InformeTablasDatos")', { nombreTabla:tabla, idEmpresa:empresa||null }, function(r) {
            if (r.success) {
                var s = $('#selectAnio').html('<option value="">-- Seleccione --</option>');
                $.each(r.anios, function(i,a){ s.append($('<option>').val(a).text(a)); });
                s.trigger('change');
            }
        });
    }
    function cargarVariables(tabla, empresa) {
        $.get('@Url.Action("ObtenerVariables","InformeTablasDatos")', { nombreTabla:tabla, idEmpresa:empresa||null }, function(r) {
            if (r.success) {
                var s = $('#selectVariable').html('<option value="">-- Todas --</option>');
                $.each(r.variables, function(i,v){ s.append($('<option>').val(v).text(v)); });
                s.trigger('change');
            }
        });
    }

    // ── Botón Analizar ────────────────────────────────────
    $('#btnAnalizar').on('click', function () {
        var tabla = $('#selectTabla').val(), empresa = $('#selectEmpresa').val();
        if (!tabla) { Swal.fire({icon:'warning',title:'Tabla requerida',text:'Por favor seleccione una tabla.'}); return; }
        @if (esAdmin) {
            <text>
            if (!empresa) { Swal.fire({icon:'warning',title:'Empresa requerida',text:'Por favor seleccione una empresa.'}); return; }
            </text>
        }
        if (!$('#selectAnio').val()) { Swal.fire({icon:'warning',title:'A\u00f1o requerido',text:'Debe seleccionar un a\u00f1o para el an\u00e1lisis IA.'}); return; }

        filtrosActuales = {
            NombreTabla : tabla,
            IdEmpresa   : empresa || null,
            Anio        : $('#selectAnio').val()     || null,
            Mes         : $('#selectMes').val()      || null,
            Variable    : $('#selectVariable').val() || null
        };
        window._filtrosActualesPDF = filtrosActuales;
        window._preguntaActualIA   = null;

        var nombreTabla = $('#selectTabla option:selected').data('nombre') || tabla;
        var partes = [nombreTabla];
        if ($('#selectEmpresa option:selected').text() && empresa) partes.push($('#selectEmpresa option:selected').text());
        if ($('#selectAnio').val()) partes.push('A\u00f1o ' + $('#selectAnio').val());
        if ($('#selectMes option:selected').text() && $('#selectMes').val()) partes.push($('#selectMes option:selected').text());
        if ($('#selectVariable').val()) partes.push($('#selectVariable').val());
        $('#iaContexto').text(partes.join(' \u00b7 '));

        $('#placeholderIA,#loadingAnalisis,#respuestaIA,#loadingIA').hide();
        $('#panelIA').show();
    });

    $('#btnNuevaConsulta').on('click', resetPanel);
    $('#btnLimpiar').on('click', function () {
        $('#selectTabla').val('').trigger('change');
        $('#selectEmpresa').val($('#selectEmpresa option:first').val()).trigger('change');
        $('#selectMes,#selectAnio').val('').trigger('change');
        $('#selectAnio').html('<option value="">-- Seleccione --</option>').trigger('change');
        $('#selectVariable').html('<option value="">-- Todas --</option>').trigger('change');
        resetPanel();
    });

    function resetPanel() {
        $('#panelIA,#respuestaIA,#loadingIA').hide();
        $('#txtPreguntaIA').val('');
        $('#txtFilasInfo').text('An\u00e1lisis completo por a\u00f1o seleccionado');
        document.getElementById('btnExportarPDF').style.display = 'none';
        filtrosActuales = null;
        window._preguntaActualIA = null;
        $('#placeholderIA').show();
    }

    // ── Consultar IA ──────────────────────────────────────
    function consultarIA(pregunta) {
        if (!filtrosActuales) return;
        window._preguntaActualIA = pregunta || null;
        $('#btnResumenIA').prop('disabled', true);
        $('#loadingIA').show();
        $('#respuestaIA').hide();

        var data = $.extend({}, filtrosActuales);
        if (pregunta) data.pregunta = pregunta;

        $.ajax({
            url  : '@Url.Action("ConsultarConIA","InformeTablasDatos")',
            type : 'POST',
            data : data,
            success: function (resp) {
                $('#loadingIA').hide();
                $('#btnResumenIA').prop('disabled', false);
                if (resp.Exitoso) {
                    if (resp.TotalFilas > 0) {
                        $('#txtFilasInfo').text(
                            resp.FilasEnviadas < resp.TotalFilas
                                ? resp.FilasEnviadas + ' de ' + resp.TotalFilas + ' registros analizados'
                                : resp.TotalFilas + ' registros analizados'
                        );
                    }
                    var html = '';
                    if (pregunta) {
                        html += '<div class="ia-pregunta-block">'
                              + '<div class="ia-pregunta-label"><i class="fas fa-question-circle"></i> Pregunta realizada</div>'
                              + '<div class="ia-pregunta-texto">' + $('<div>').text(pregunta).html() + '</div>'
                              + '</div>';
                    }
                    html += renderMarkdown(resp.Respuesta);
                    $('#respuestaIATexto').html(html);
                    $('#respuestaIA').show();
                    document.getElementById('btnExportarPDF').style.display = 'inline-flex';
                } else {
                    Swal.fire({icon:'warning',title:'Asistente IA',text:resp.Error||'Error al obtener respuesta.'});
                }
            },
            error: function () {
                $('#loadingIA').hide();
                $('#btnResumenIA').prop('disabled', false);
                Swal.fire({icon:'error',title:'Error de conexi\u00f3n',text:'No se pudo contactar al servicio de IA.'});
            }
        });
    }

    $('#btnResumenIA').on('click', function () { consultarIA(null); });
    $('#btnPreguntarIA').on('click', function () {
        var p = $('#txtPreguntaIA').val().trim();
        if (!p) { Swal.fire({icon:'warning',title:'Pregunta vac\u00eda',text:'Escribe una pregunta antes de enviar.'}); return; }
        consultarIA(p);
        $('#txtPreguntaIA').val('');
    });
    $('#txtPreguntaIA').on('keydown', function(e){ if(e.key==='Enter') $('#btnPreguntarIA').trigger('click'); });

    // ── Select2 ───────────────────────────────────────────
    var s2 = { width:'100%', language:{ noResults:function(){return'Sin resultados';}, searching:function(){return'Buscando...';} } };
    $('#selectTabla').select2($.extend({placeholder:'-- Seleccione --',allowClear:false},s2));
    $('#selectEmpresa').select2($.extend({placeholder:'-- Seleccione --',allowClear:false},s2));
    $('#selectAnio').select2($.extend({placeholder:'-- Seleccione --',allowClear:false},s2));
    $('#selectMes').select2($.extend({placeholder:'-- Todos --',allowClear:true,minimumResultsForSearch:-1},s2));
    $('#selectVariable').select2($.extend({placeholder:'-- Todas --',allowClear:true},s2));



}); // end document.ready
</script>

<script>
async function exportarAnalisisPDF() {
    var btn = document.getElementById('btnExportarPDF');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generando...';
    try {
        var ahora = new Date();
        document.getElementById('pdfFecha').textContent =
            ahora.toLocaleDateString('es-CO',{year:'numeric',month:'long',day:'numeric'}) +
            ' ' + ahora.toLocaleTimeString('es-CO',{hour:'2-digit',minute:'2-digit'});

        var filtros       = window._filtrosActualesPDF || {};
        var nombreEmpresa = $('#selectEmpresa option:selected').text().trim() || filtros.IdEmpresa || '—';
        var mesTexto      = $('#selectMes option:selected').text().trim();
        if (!mesTexto || mesTexto === '-- Todos --') mesTexto = 'Todos';
        var tablaTexto    = $('#selectTabla option:selected').data('nombre') || filtros.NombreTabla || '—';

        var filtrosData = [
            {label:'Tabla',    valor:tablaTexto},
            {label:'Empresa',  valor:nombreEmpresa},
            {label:'A\u00f1o', valor:filtros.Anio||'\u2014'},
            {label:'Mes',      valor:mesTexto},
            {label:'Variable', valor:filtros.Variable||'Todas'}
        ];
        var fHtml = '';
        filtrosData.forEach(function(f){
            fHtml += '<div class="pdf-filtro-item"><span class="pdf-filtro-label">'+f.label+'</span>'
                   + '<span class="pdf-filtro-valor">'+f.valor+'</span></div>';
        });
        document.getElementById('pdfFiltros').innerHTML = fHtml;
        document.getElementById('pdfContenido').innerHTML = document.getElementById('respuestaIATexto').innerHTML;

        var preview = document.getElementById('pdfPreview');
        preview.style.left = '-9999px'; preview.style.display = 'block';
        var canvas = await html2canvas(preview,{scale:2,useCORS:true,logging:false});
        preview.style.display = 'none'; preview.style.left = '-9999px';

        var jsPDF = window.jspdf.jsPDF;
        var pdf   = new jsPDF('p','mm','a4');
        var pageW = pdf.internal.pageSize.getWidth();
        var pageH = pdf.internal.pageSize.getHeight();
        var imgH  = (canvas.height * pageW) / canvas.width;
        var imgData = canvas.toDataURL('image/png');

        var y = 0, remaining = imgH;
        while (remaining > 0) {
            if (y > 0) pdf.addPage();
            pdf.addImage(imgData,'PNG',0,-y,pageW,imgH);
            y += pageH; remaining -= pageH;
        }
        pdf.save('AnalisisIA_BUFINS_' + ahora.toISOString().slice(0,10).replace(/-/g,'') + '.pdf');
    } catch(e) {
        console.error(e);
        Swal.fire({icon:'error',title:'Error',text:'No se pudo generar el PDF.'});
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-file-pdf"></i> Exportar PDF';
    }
}
</script>
}
