@model dynamic
@using bufinscustomers.Models

@{
    ViewBag.Title = Resources.Strings.IA_PageTitle;
    var tablas         = ViewBag.Tablas  as List<TablaDatos>;
    var empresas       = ViewBag.Empresas as List<Empresas>;
    var esAdmin        = (bool)ViewBag.EsAdmin;
    var esAdminEmpresa = (bool)(ViewBag.EsAdminEmpresa ?? false);
}

<link href="~/Assets/css/informe-tablas-datos.css" rel="stylesheet" />
<link href="~/Assets/css/select2/select2.min.css"  rel="stylesheet" />
<link href="~/Assets/css/analisis-ia.css"           rel="stylesheet" />

<style>
/* ── Botón historial auditoría ── */
.audit-btn-header {
    background:rgba(255,255,255,.18); border:1.5px solid rgba(255,255,255,.55);
    color:#fff; border-radius:8px; padding:6px 16px; font-size:.87rem;
    font-weight:600; cursor:pointer; transition:background .2s; white-space:nowrap;
}
.audit-btn-header:hover { background:rgba(255,255,255,.30); color:#fff; }

</style>

<div class="container-fluid px-4">

    <!-- Header -->
    <div class="powerbi-header" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
        <div class="powerbi-header-content">
            <i class="fas fa-robot powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">
                @Resources.Strings.IA_PageTitle
                <span class="ia-header-badge">
                    <i class="fas fa-circle" style="font-size:6px;"></i> @(ViewBag.ModeloIA ?? "OpenAI")
                </span>
            </h1>
        </div>
        <a href="@Url.Action("Index","AuditoriaConsultasIA")" class="audit-btn-header">
            <i class="fas fa-history"></i> @Resources.Strings.IA_AuditoriaLink
        </a>
    </div>

    <!-- Filtros -->
    <div class="filter-card">
        <h3 class="filter-card-title">
            <i class="fas fa-filter"></i> @Resources.Strings.IA_FilterTitle
        </h3>
        <div class="filter-section">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="selectTabla"><i class="fas fa-table"></i> @Resources.Strings.Common_LabelTabla <span class="required">*</span></label>
                        <select id="selectTabla" class="form-control" required>
                            <option value="">@Resources.Strings.Common_Seleccione</option>
                            @if (tablas != null)
                            {
                                foreach (var t in tablas)
                                {
                                    <option value="@t.NombreTabla" data-nombre="@t.NombreAmigable">@t.NombreAmigable</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="selectEmpresa">
                            <i class="fas fa-building"></i>
                            @Resources.Strings.Common_LabelEmpresa @if (esAdmin) { <span class="required">*</span> }
                        </label>
                        <select id="selectEmpresa" class="form-control" @(esAdmin ? "required" : "")>
                            @if (esAdmin) { <option value="">@Resources.Strings.Common_Seleccione</option> }
                            @if (empresas != null)
                            {
                                foreach (var e in empresas)
                                {
                                    <option value="@e.Id">@e.Nombre</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="selectAnio"><i class="fas fa-calendar-alt"></i> @Resources.Strings.Common_LabelAnio <span class="required">*</span></label>
                        <select id="selectAnio" class="form-control" required>
                            <option value="">@Resources.Strings.Common_Seleccione</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="selectMes"><i class="fas fa-calendar-day"></i> @Resources.Strings.Common_LabelMes</label>
                        <select id="selectMes" class="form-control">
                            <option value="">@Resources.Strings.Common_Todos</option>
                            <option value="1">@Resources.Strings.Common_Mes1</option>
                            <option value="2">@Resources.Strings.Common_Mes2</option>
                            <option value="3">@Resources.Strings.Common_Mes3</option>
                            <option value="4">@Resources.Strings.Common_Mes4</option>
                            <option value="5">@Resources.Strings.Common_Mes5</option>
                            <option value="6">@Resources.Strings.Common_Mes6</option>
                            <option value="7">@Resources.Strings.Common_Mes7</option>
                            <option value="8">@Resources.Strings.Common_Mes8</option>
                            <option value="9">@Resources.Strings.Common_Mes9</option>
                            <option value="10">@Resources.Strings.Common_Mes10</option>
                            <option value="11">@Resources.Strings.Common_Mes11</option>
                            <option value="12">@Resources.Strings.Common_Mes12</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="selectVariable"><i class="fas fa-tag"></i> @Resources.Strings.Common_LabelVariable</label>
                        <select id="selectVariable" class="form-control">
                            <option value="">@Resources.Strings.Common_Todas</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="btn-group-actions">
            <button type="button" id="btnAnalizar" class="btn-ia-analizar">
                <i class="fas fa-robot"></i> @Resources.Strings.IA_BtnAnalizar
            </button>
            <button type="button" id="btnLimpiar" class="btn btn-modern-secondary">
                <i class="fas fa-eraser mr-2"></i> @Resources.Strings.Common_Limpiar
            </button>
        </div>
    </div>

    <!-- Placeholder -->
    <div id="placeholderIA" class="ia-placeholder">
        <div class="ia-placeholder-icon"><i class="fas fa-robot"></i></div>
        <h4>@Resources.Strings.IA_PlaceholderTitle</h4>
        <p>@Resources.Strings.IA_PlaceholderDesc</p>
    </div>

    <!-- Panel IA -->
    <div id="panelIA" style="display:none;" class="ia-panel">
        <div class="ia-panel-header">
            <div class="ia-panel-header-left">
                <div class="ia-panel-icon"><i class="fas fa-robot"></i></div>
                <div>
                    <div class="ia-panel-title">@Resources.Strings.IA_PanelTitle</div>
                    <div id="iaContexto" class="ia-panel-context"></div>
                </div>
            </div>
            <button type="button" id="btnNuevaConsulta" class="btn-nueva-consulta">
                <i class="fas fa-redo-alt"></i> @Resources.Strings.IA_BtnNuevaConsulta
            </button>
        </div>
        <div class="ia-actions-bar">
            <button type="button" id="btnResumenIA" class="btn-generar-resumen">
                <i class="fas fa-magic"></i> @Resources.Strings.IA_BtnGenerarResumen
            </button>
            <button type="button" id="btnExportarPDF" class="btn-exportar-pdf" onclick="exportarAnalisisPDF()" style="display:none;">
                <i class="fas fa-file-pdf"></i> @Resources.Strings.IA_BtnExportarPDF
            </button>
            <button type="button" id="btnExportarExcel" class="btn-exportar-excel" onclick="exportarExcelConIA()" style="display:none;">
                <i class="fas fa-file-excel"></i> @Resources.Strings.IA_BtnExportarExcel
            </button>
            <span class="ia-hint">@Resources.Strings.IA_PreguntaHint</span>
        </div>

        <!-- Área de chat multi-turn -->
        <div id="iaChatArea" class="ia-chat-area" style="display:none;">
            <div id="iaChatMessages" class="ia-chat-messages"></div>
            <div id="iaChatLoading" style="display:none;" class="ia-loading-wrap">
                <div class="ia-loading-inner">
                    <div class="ia-dots"><span></span><span></span><span></span></div>
                    <p>@Resources.Strings.IA_LoadingAnalizando</p>
                </div>
            </div>
        </div>

        <div class="ia-input-section">
            <div class="ia-input-row">
                <input type="text" id="txtPreguntaIA" class="ia-text-input" maxlength="500"
                       placeholder="@Resources.Strings.IA_InputPlaceholder" />
                <button type="button" id="btnPreguntarIA" class="btn-enviar">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
            <div class="ia-input-footer">
                <div class="ia-branding">
                    <i class="fas fa-lock"></i> Powered by OpenAI &nbsp;&middot;&nbsp;
                    <i class="fas fa-database"></i> <span id="txtFilasInfo">@Resources.Strings.IA_FilasInfo</span>
                </div>
                <div class="ia-char-count"><span id="iaCharCount">500</span> <span class="ia-char-label">@Resources.Strings.IA_CharRestantes</span></div>
            </div>
        </div>
    </div>

</div>

<!-- PDF preview oculto -->
<div id="pdfPreview" class="pdf-preview-wrap">
    <div class="pdf-header">
        <img id="pdfLogo" src="@Url.Content("~/Assets/img/Bufins_LogoLogin.png")" class="pdf-logo" crossorigin="anonymous" />
        <div class="pdf-title-block">
            <div class="pdf-title">@Resources.Strings.IA_PDF_Title</div>
            <div class="pdf-subtitle">@Resources.Strings.IA_PDF_Subtitle &nbsp;&middot;&nbsp; <span id="pdfFecha"></span></div>
        </div>
    </div>
    <div class="pdf-filtros-block">
        <div class="pdf-filtros-title"><i class="fas fa-filter"></i> @Resources.Strings.IA_PDF_Filtros</div>
        <div id="pdfFiltros" class="pdf-filtros-grid"></div>
    </div>
    <div class="pdf-divider"></div>
    <div id="pdfContenido" class="pdf-contenido"></div>
    <div class="pdf-footer">
        <span>@Resources.Strings.IA_PDF_Footer</span>
        <span id="pdfPage"></span>
    </div>
</div>

@section scripts {
<script src="~/Assets/js/select2/select2.min.js"></script>
<script src="~/Assets/js/html2canvas.min.js"></script>
<script src="~/Assets/js/jspdf.umd.min.js"></script>

<script>
    var _iaMsg = {
        seleccione:         '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Seleccione)',
        todos:              '@Resources.Strings.Common_Todos',
        todas:              '@Resources.Strings.Common_Todas',
        tablaRequerida:     '@Resources.Strings.Common_JS_TablaRequerida',
        tablaSeleccionar:   '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Seleccione)',
        empresaRequerida:   '@Resources.Strings.Common_JS_EmpresaRequerida',
        empresaSeleccionar: '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Seleccione)',
        anioRequerido:      '@Resources.Strings.IA_JS_AnioRequerido',
        anioSeleccionar:    '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Seleccione)',
        preguntaVacia:      '@Resources.Strings.IA_JS_PreguntaVacia',
        preguntaEscribir:   '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Seleccione)',
        asistenteError:     '@Resources.Strings.IA_JS_AsistenteError',
        conexionError:      '@Resources.Strings.IA_JS_ConexionError',
        servicioIA:         '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Seleccione)',
        preguntaLabel:      '@Resources.Strings.IA_JS_PreguntaLabel',
        generandoPDF:       '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Seleccione)',
        errorPDF:           '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Seleccione)',
        filasInfo:          '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Seleccione)',
        noResultados:       '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Seleccione)',
        buscando:           '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Seleccione)',
        error:              '@Resources.Strings.Common_Error',
        pdfTitle:           '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Seleccione)',
        pdfSubtitle:        '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Seleccione)',
        pdfFiltros:         '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Seleccione)',
        pdfFooter:          '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Seleccione)',
        labelTabla:         '@Resources.Strings.Common_LabelTabla',
        labelEmpresa:       '@Resources.Strings.Common_LabelEmpresa',
        labelAnio:          '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Seleccione)',
        labelMes:           '@Resources.Strings.Common_LabelMes',
        labelVariable:      '@Resources.Strings.Common_LabelVariable',
        btnExportarPDF:     '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Seleccione)',
        mesTextoTodos:      '@Resources.Strings.Common_Todos',
        respuestaHeader:    '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Seleccione)',
        preguntaLarga:      '@Resources.Strings.IA_JS_PreguntaLarga',
        preguntaLargaTexto: '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Seleccione)',
        btnExcelConIA:      '@HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Seleccione)',
    };

    // Global so exportarExcelConIA() (outside document.ready) can read it
    var _chatHistorial = [];
</script>

<script>
    /* ── renderMarkdown global ── */
    function renderMarkdown(text) {
        if (!text) return '';
        return text
            .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
            .replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>')
            .replace(/\*(.+?)\*/g,'<em>$1</em>')
            .replace(/^### (.+)$/gm,'<h6 style="color:#4f46e5;font-weight:700;margin-top:12px;">$1</h6>')
            .replace(/^## (.+)$/gm, '<h5 style="color:#4f46e5;font-weight:700;margin-top:14px;">$1</h5>')
            .replace(/^# (.+)$/gm,  '<h4 style="color:#312e81;font-weight:700;margin-top:16px;">$1</h4>')
            .replace(/^[-*] (.+)$/gm,'<li>$1</li>')
            .replace(/(<li>[\s\S]+?<\/li>)/g,'<ul style="padding-left:18px;margin-bottom:8px;">$1</ul>')
            .replace(/\n\n/g,'</p><p style="margin-bottom:8px;">')
            .replace(/\n/g,'<br>');
    }
</script>

<script>
$(document).ready(function () {

    var filtrosActuales = null;
    // _chatHistorial is declared globally above document.ready for cross-script access

    var s2lang = {
        noResults: function () { return _iaMsg.noResultados; },
        searching: function () { return _iaMsg.buscando; }
    };

    // ── Filtros de datos ──────────────────────────────────
    $('#selectTabla').on('change', function () {
        var tabla   = $(this).val(), empresa = $('#selectEmpresa').val();
        $('#selectAnio').html('<option value="">' + _iaMsg.seleccione + '</option>').trigger('change');
        $('#selectVariable').html('<option value="">' + _iaMsg.todas + '</option>').trigger('change');
        if (tabla) { cargarAnios(tabla, empresa); cargarVariables(tabla, empresa); }
    });
    $('#selectEmpresa').on('change', function () {
        var tabla = $('#selectTabla').val(), empresa = $(this).val();
        if (tabla) { cargarAnios(tabla, empresa); cargarVariables(tabla, empresa); }
    });
    function cargarAnios(tabla, empresa) {
        $.get('@Url.Action("ObtenerAnios","InformeTablasDatos")', { nombreTabla:tabla, idEmpresa:empresa||null }, function(r) {
            if (r.success) {
                var s = $('#selectAnio').html('<option value="">' + _iaMsg.seleccione + '</option>');
                $.each(r.anios, function(i,a){ s.append($('<option>').val(a).text(a)); });
                s.trigger('change');
            }
        });
    }
    function cargarVariables(tabla, empresa) {
        $.get('@Url.Action("ObtenerVariables","InformeTablasDatos")', { nombreTabla:tabla, idEmpresa:empresa||null }, function(r) {
            if (r.success) {
                var s = $('#selectVariable').html('<option value="">' + _iaMsg.todas + '</option>');
                $.each(r.variables, function(i,v){ s.append($('<option>').val(v).text(v)); });
                s.trigger('change');
            }
        });
    }

    // ── Botón Analizar ────────────────────────────────────
    $('#btnAnalizar').on('click', function () {
        var tabla = $('#selectTabla').val(), empresa = $('#selectEmpresa').val();
        if (!tabla) { Swal.fire({icon:'warning',title:_iaMsg.tablaRequerida,text:_iaMsg.tablaSeleccionar}); return; }
        @if (esAdmin) {
            <text>
            if (!empresa) { Swal.fire({icon:'warning',title:_iaMsg.empresaRequerida,text:_iaMsg.empresaSeleccionar}); return; }
            </text>
        }
        if (!$('#selectAnio').val()) { Swal.fire({icon:'warning',title:_iaMsg.anioRequerido,text:_iaMsg.anioSeleccionar}); return; }

        filtrosActuales = {
            NombreTabla : tabla,
            IdEmpresa   : empresa || null,
            Anio        : $('#selectAnio').val()     || null,
            Mes         : $('#selectMes').val()      || null,
            Variable    : $('#selectVariable').val() || null
        };
        window._filtrosActualesPDF = filtrosActuales;

        var nombreTabla = $('#selectTabla option:selected').data('nombre') || tabla;
        var partes = [nombreTabla];
        if ($('#selectEmpresa option:selected').text() && empresa) partes.push($('#selectEmpresa option:selected').text());
        if ($('#selectAnio').val()) partes.push(_iaMsg.labelAnio + ' ' + $('#selectAnio').val());
        if ($('#selectMes option:selected').text() && $('#selectMes').val()) partes.push($('#selectMes option:selected').text());
        if ($('#selectVariable').val()) partes.push($('#selectVariable').val());
        $('#iaContexto').text(partes.join(' \u00B7 '));

        $('#placeholderIA').hide();
        $('#panelIA').show();
    });

    $('#btnNuevaConsulta').on('click', resetPanel);
    $('#btnLimpiar').on('click', function () {
        $('#selectTabla').val('').trigger('change');
        $('#selectEmpresa').val($('#selectEmpresa option:first').val()).trigger('change');
        $('#selectMes,#selectAnio').val('').trigger('change');
        $('#selectAnio').html('<option value="">' + _iaMsg.seleccione + '</option>').trigger('change');
        $('#selectVariable').html('<option value="">' + _iaMsg.todas + '</option>').trigger('change');
        resetPanel();
    });

    function resetPanel() {
        $('#panelIA').hide();
        $('#iaChatArea').hide();
        $('#iaChatMessages').empty();
        $('#iaChatLoading').hide();
        $('#txtPreguntaIA').val('');
        $('#iaCharCount').text('500').closest('.ia-char-count').removeClass('ia-char-warn');
        $('#txtFilasInfo').text(_iaMsg.filasInfo);
        document.getElementById('btnExportarPDF').style.display   = 'none';
        document.getElementById('btnExportarExcel').style.display = 'none';
        filtrosActuales = null;
        _chatHistorial  = [];
        $('#placeholderIA').show();
    }

    // ── Chat helpers ──────────────────────────────────────
    function appendUserBubble(pregunta) {
        var html = '<div class="ia-chat-user-wrap">'
                 +   '<div class="ia-chat-user-bubble">'
                 +     '<div class="ia-chat-user-meta"><i class="fas fa-comment-alt"></i> ' + _iaMsg.preguntaLabel + '</div>'
                 +     '<div class="ia-chat-user-texto">' + $('<div>').text(pregunta).html() + '</div>'
                 +   '</div>'
                 +   '<div class="ia-chat-avatar ia-chat-avatar-user"><i class="fas fa-user"></i></div>'
                 + '</div>';
        $('#iaChatMessages').append(html);
        scrollChat();
    }

    // Versión con efecto reveal párrafo a párrafo (#6 streaming)
    function appendAssistantBubble(respuesta) {
        var $wrap = $('<div class="ia-chat-assistant-wrap">'
            + '<div class="ia-chat-avatar ia-chat-avatar-bot"><i class="fas fa-robot"></i></div>'
            + '<div class="ia-chat-assistant-inner">'
            +   '<div class="ia-response-header"><i class="fas fa-stars"></i> ' + _iaMsg.respuestaHeader + '</div>'
            +   '<div class="ia-response-body"></div>'
            + '</div></div>');
        $('#iaChatMessages').append($wrap);
        scrollChat();

        var bodyEl   = $wrap.find('.ia-response-body')[0];
        var segments = respuesta.split('\n\n').filter(function(s){ return s.trim().length > 0; });
        var idx      = 0;

        function revealNext() {
            if (idx < segments.length) {
                var partial = segments.slice(0, idx + 1).join('\n\n');
                bodyEl.innerHTML = renderMarkdown(partial)
                    + (idx < segments.length - 1 ? '<span class="ia-cursor"> ▋</span>' : '');
                idx++;
                scrollChat();
                setTimeout(revealNext, 190);
            } else {
                bodyEl.innerHTML = renderMarkdown(respuesta);
                scrollChat();
            }
        }
        revealNext();
    }

    function scrollChat() {
        var el = document.getElementById('iaChatMessages');
        if (el) el.scrollTop = el.scrollHeight;
    }

    // ── Consultar IA ──────────────────────────────────────
    // esFrescaConversacion=true → resetea historial y genera resumen desde cero
    function consultarIA(pregunta, esFrescaConversacion) {
        if (!filtrosActuales) return;

        if (esFrescaConversacion) {
            _chatHistorial = [];
            $('#iaChatMessages').empty();
            document.getElementById('btnExportarPDF').style.display = 'none';
        }

        if (pregunta) appendUserBubble(pregunta);

        $('#iaChatArea').show();
        $('#iaChatLoading').show();
        scrollChat();
        $('#btnResumenIA,#btnPreguntarIA').prop('disabled', true);

        var data = $.extend({}, filtrosActuales);
        if (pregunta) data.pregunta = pregunta;
        if (_chatHistorial.length > 0) data.historialJson = JSON.stringify(_chatHistorial);

        $.ajax({
            url  : '@Url.Action("ConsultarConIA","InformeTablasDatos")',
            type : 'POST',
            data : data,
            success: function (resp) {
                $('#iaChatLoading').hide();
                $('#btnResumenIA,#btnPreguntarIA').prop('disabled', false);
                if (resp.Exitoso) {
                    if (resp.TotalFilas > 0) {
                        $('#txtFilasInfo').text(
                            resp.FilasEnviadas < resp.TotalFilas
                                ? resp.FilasEnviadas + ' de ' + resp.TotalFilas + ' registros analizados'
                                : resp.TotalFilas + ' registros analizados'
                        );
                    }
                    appendAssistantBubble(resp.Respuesta);
                    // Actualizar historial multi-turn
                    if (_chatHistorial.length === 0 && resp.PromptContextoInicial) {
                        _chatHistorial.push({ Rol: 'user', Contenido: resp.PromptContextoInicial });
                    } else if (pregunta) {
                        _chatHistorial.push({ Rol: 'user', Contenido: pregunta });
                    }
                    _chatHistorial.push({ Rol: 'assistant', Contenido: resp.Respuesta });
                    document.getElementById('btnExportarPDF').style.display   = 'inline-flex';
                    document.getElementById('btnExportarExcel').style.display = 'inline-flex';
                } else {
                    Swal.fire({icon:'warning',title:_iaMsg.asistenteError,text:resp.Error||_iaMsg.servicioIA});
                }
            },
            error: function () {
                $('#iaChatLoading').hide();
                $('#btnResumenIA,#btnPreguntarIA').prop('disabled', false);
                Swal.fire({icon:'error',title:_iaMsg.conexionError,text:_iaMsg.servicioIA});
            }
        });
    }

    // Generar Resumen = conversación fresca
    $('#btnResumenIA').on('click', function () { consultarIA(null, true); });
    $('#btnPreguntarIA').on('click', function () {
        var p = $('#txtPreguntaIA').val().trim();
        if (!p) { Swal.fire({icon:'warning',title:_iaMsg.preguntaVacia,text:_iaMsg.preguntaEscribir}); return; }
        if (p.length > 500) { Swal.fire({icon:'warning',title:_iaMsg.preguntaLarga,text:_iaMsg.preguntaLargaTexto}); return; }
        consultarIA(p, false);
        $('#txtPreguntaIA').val('').trigger('input');
    });
    $('#txtPreguntaIA').on('keydown', function(e){ if(e.key==='Enter') $('#btnPreguntarIA').trigger('click'); });
    $('#txtPreguntaIA').on('input', function () {
        var remaining = 500 - $(this).val().length;
        var $c = $('#iaCharCount');
        $c.text(remaining);
        $c.closest('.ia-char-count').toggleClass('ia-char-warn', remaining < 50);
    });

    // ── Select2 ───────────────────────────────────────────
    $('#selectTabla').select2($.extend({placeholder:_iaMsg.seleccione,allowClear:false},{width:'100%',language:s2lang}));
    $('#selectEmpresa').select2($.extend({placeholder:_iaMsg.seleccione,allowClear:false},{width:'100%',language:s2lang}));
    $('#selectAnio').select2($.extend({placeholder:_iaMsg.seleccione,allowClear:false},{width:'100%',language:s2lang}));
    $('#selectMes').select2($.extend({placeholder:_iaMsg.todos,allowClear:true,minimumResultsForSearch:-1},{width:'100%',language:s2lang}));
    $('#selectVariable').select2($.extend({placeholder:_iaMsg.todas,allowClear:true},{width:'100%',language:s2lang}));

}); // end document.ready
</script>

<script>
async function exportarAnalisisPDF() {
    var btn = document.getElementById('btnExportarPDF');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ' + _iaMsg.generandoPDF;
    try {
        var ahora = new Date();
        var fechaTexto = ahora.toLocaleDateString('es-CO',{year:'numeric',month:'long',day:'numeric'})
                       + ' · ' + ahora.toLocaleTimeString('es-CO',{hour:'2-digit',minute:'2-digit'});
        document.getElementById('pdfFecha').textContent = fechaTexto;

        var filtros       = window._filtrosActualesPDF || {};
        var nombreEmpresa = $('#selectEmpresa option:selected').text().trim() || filtros.IdEmpresa || '—';
        var mesTexto      = $('#selectMes option:selected').text().trim();
        if (!mesTexto || mesTexto === _iaMsg.mesTextoTodos) mesTexto = _iaMsg.todos;
        var tablaTexto    = $('#selectTabla option:selected').data('nombre') || filtros.NombreTabla || '—';
        var contextoLabel = ($('#iaContexto').text() || '').trim();

        // Filtros
        var filtrosData = [
            {label:_iaMsg.labelTabla,    valor:tablaTexto},
            {label:_iaMsg.labelEmpresa,  valor:nombreEmpresa},
            {label:_iaMsg.labelAnio,     valor:filtros.Anio||'—'},
            {label:_iaMsg.labelMes,      valor:mesTexto},
            {label:_iaMsg.labelVariable, valor:filtros.Variable||_iaMsg.todas}
        ];
        var fHtml = '';
        filtrosData.forEach(function(f){
            fHtml += '<div class="pdf-filtro-item">'
                   + '<span class="pdf-filtro-label">'+f.label+'</span>'
                   + '<span class="pdf-filtro-valor">'+f.valor+'</span></div>';
        });
        document.getElementById('pdfFiltros').innerHTML = fHtml;

        // Contar secciones
        var totalSecciones = _chatHistorial.filter(function(m){ return m.Rol === 'assistant'; }).length;

        // Banner de resumen
        var bannerHtml = '<div class="pdf-resumen-banner">'
            + 'Este informe contiene <strong>' + totalSecciones
            + ' an&aacute;lisis</strong> generado' + (totalSecciones !== 1 ? 's' : '')
            + ' por inteligencia artificial a partir de los datos seleccionados.'
            + '</div>';

        // Construir secciones del informe
        var contenidoHtml = '';
        var seccionNum = 0;
        for (var i = 0; i < _chatHistorial.length; i++) {
            if (_chatHistorial[i].Rol !== 'assistant') continue;
            seccionNum++;
            var esInicial = (seccionNum === 1);

            // Pregunta: para sección 1 usamos el contexto de filtros; para las demás el texto del usuario
            var preguntaTexto = null;
            if (esInicial) {
                preguntaTexto = contextoLabel || tablaTexto;
            } else if (i > 0 && _chatHistorial[i - 1].Rol === 'user') {
                preguntaTexto = _chatHistorial[i - 1].Contenido;
            }

            var labelSeccion = esInicial ? 'An&aacute;lisis Ejecutivo' : 'Consulta Adicional';
            var numBadge = '<span class="pdf-seccion-num">' + seccionNum + '</span>';

            contenidoHtml += '<div class="pdf-seccion">';
            contenidoHtml += '<div class="pdf-seccion-titulo">' + numBadge + ' ' + labelSeccion + '</div>';

            if (preguntaTexto) {
                var labelPregunta = esInicial ? 'Contexto analizado:' : 'Pregunta:';
                contenidoHtml += '<div class="pdf-seccion-pregunta">'
                               + '<span class="pdf-pregunta-label">' + labelPregunta + '</span>&nbsp;'
                               + $('<div>').text(preguntaTexto).html()
                               + '</div>';
            }

            contenidoHtml += '<div class="pdf-seccion-body">'
                           + renderMarkdown(_chatHistorial[i].Contenido)
                           + '</div>';
            contenidoHtml += '</div>';
        }

        document.getElementById('pdfContenido').innerHTML = bannerHtml + contenidoHtml;

        // Renderizar y exportar
        var preview = document.getElementById('pdfPreview');
        preview.style.left = '-9999px'; preview.style.display = 'block';
        var canvas = await html2canvas(preview, {scale:2, useCORS:true, logging:false,
            windowWidth: 794, windowHeight: preview.scrollHeight});
        preview.style.display = 'none'; preview.style.left = '-9999px';

        var jsPDF   = window.jspdf.jsPDF;
        var pdf     = new jsPDF('p','mm','a4');
        var pageW   = pdf.internal.pageSize.getWidth();
        var pageH   = pdf.internal.pageSize.getHeight();
        var imgH    = (canvas.height * pageW) / canvas.width;
        var imgData = canvas.toDataURL('image/jpeg', 0.95);

        var pageNum = 0, y = 0, rem = imgH;
        while (rem > 0) {
            if (pageNum > 0) pdf.addPage();
            pdf.addImage(imgData, 'JPEG', 0, -y, pageW, imgH);
            // Numero de pagina (solo ASCII: jsPDF/Helvetica no soporta Latin Extended)
            pdf.setFontSize(7);
            pdf.setTextColor(180, 180, 180);
            pdf.text('- ' + (pageNum + 1) + ' -', pageW / 2, pageH - 4, {align:'center'});
            pageNum++; y += pageH; rem -= pageH;
        }
        pdf.save('AnalisisIA_BUFINS_' + ahora.toISOString().slice(0,10).replace(/-/g,'') + '.pdf');
    } catch (e) {
        console.error(e);
        Swal.fire({icon:'error', title:_iaMsg.error, text:_iaMsg.errorPDF});
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-file-pdf"></i> ' + _iaMsg.btnExportarPDF;
    }
}
</script>

<script>
function exportarExcelConIA() {
    var btn = document.getElementById('btnExportarExcel');
    var textoAnalisis = _chatHistorial
        .filter(function(m){ return m.Rol === 'assistant'; })
        .map(function(m){ return m.Contenido; })
        .join('\n\n---\n\n');

    if (!textoAnalisis || !window._filtrosActualesPDF) {
        return;
    }

    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ' + _iaMsg.btnExcelConIA;

    var form = document.createElement('form');
    form.method = 'POST';
    form.action = '@Url.Action("ExportarExcelConIA","InformeTablasDatos")';

    var campos = Object.assign({}, window._filtrosActualesPDF, { textoAnalisis: textoAnalisis });
    Object.keys(campos).forEach(function(k) {
        if (campos[k] !== null && campos[k] !== undefined) {
            var input = document.createElement('input');
            input.type  = 'hidden';
            input.name  = k;
            input.value = campos[k];
            form.appendChild(input);
        }
    });

    // Add CSRF token if present
    var token = $('input[name="__RequestVerificationToken"]').val();
    if (token) {
        var csrf = document.createElement('input');
        csrf.type  = 'hidden';
        csrf.name  = '__RequestVerificationToken';
        csrf.value = token;
        form.appendChild(csrf);
    }

    document.body.appendChild(form);
    form.submit();
    document.body.removeChild(form);

    setTimeout(function() {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-file-excel"></i> ' + _iaMsg.btnExcelConIA;
    }, 3000);
}

</script>
}
