        metaFilas:          '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IA_MetaFilas))',
        btnGenerar:         '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IA_BtnGenerar))',
