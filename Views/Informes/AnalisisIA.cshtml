        todas:              '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Todas))',
        tablaRequerida:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_JS_TablaRequerida))',
        tablaSeleccionar:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IA_JS_TablaSeleccionar))',
        empresaRequerida:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_JS_EmpresaRequerida))',
        empresaSeleccionar: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IA_JS_EmpresaSeleccionar))',
