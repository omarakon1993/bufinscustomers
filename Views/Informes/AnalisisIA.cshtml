<script>
    // renderMarkdown lo aporta ~/Assets/js/bufins-markdown.js (window.renderMarkdown).
    // Fallback mínimo por si el archivo no cargó, para no romper el chat.
    if (typeof window.renderMarkdown !== 'function') {
        window.renderMarkdown = function (t) {
            return t ? $('<div>').text(t).html().replace(/\n/g, '<br>') : '';
        };
    }
    // En Análisis IA además se colorean las cifras (num-pos/num-neg) — estilo "Consola clara".
    window.renderMD = function (t) {
        return (typeof window.bufinsMarkdown === 'function')
            ? window.bufinsMarkdown(t, { numeros: true })
            : window.renderMarkdown(t);
    };
</script>

<script>
$(document).ready(function () {

    var filtrosActuales = null;
    var esAdminJS       = @(esAdmin ? "true" : "false");
    var _ultimaConsulta = null;   // {pregunta, fresca} para "Reintentar"
    var _t0 = 0, _timerInt = null;
    // _chatHistorial is declared globally above document.ready for cross-script access

    var s2lang = {
        noResults: function () { return _iaMsg.noResultados; },
        searching: function () { return _iaMsg.buscando; }
    };

    // ── Habilita "Analizar" solo con tabla + (empresa si es admin) + año ──
    function estadoBotonAnalizar() {
        var faltan = [];
        if (!$('#selectTabla').val())                    faltan.push(_iaMsg.labelTabla);
        if (esAdminJS && !$('#selectEmpresa').val())      faltan.push(_iaMsg.labelEmpresa);
        if (!$('#selectAnio').val())                      faltan.push(_iaMsg.labelAnio);
        var ok = faltan.length === 0;
        $('#btnAnalizar').prop('disabled', !ok);
        if (ok) { $('#analizarHint').removeClass('show'); }
        else {
            $('#analizarHintTexto').text(_iaMsg.filtrosFaltan + ' ' + faltan.join(', '));
            $('#analizarHint').addClass('show');
        }
    }
    $('#selectTabla, #selectEmpresa, #selectAnio').on('change', estadoBotonAnalizar);

    // ── Filtros de datos ──────────────────────────────────
    $('#selectTabla').on('change', function () {
        var tabla   = $(this).val(), empresa = $('#selectEmpresa').val();
        $('#selectAnio').html('<option value="">' + _iaMsg.seleccione + '</option>').trigger('change');
        $('#selectVariable').html('<option value="">' + _iaMsg.todas + '</option>').trigger('change');
        if (tabla) { cargarAnios(tabla, empresa); cargarVariables(tabla, empresa); }
    });
    $('#selectEmpresa').on('change', function () {
        var tabla = $('#selectTabla').val(), empresa = $(this).val();
        if (tabla) { cargarAnios(tabla, empresa); cargarVariables(tabla, empresa); }
    });
    function cargarAnios(tabla, empresa) {
        $.get('@Url.Action("ObtenerAnios","InformeTablasDatos")', { nombreTabla:tabla, idEmpresa:empresa||null }, function(r) {
            if (r.success) {
                var s = $('#selectAnio').html('<option value="">' + _iaMsg.seleccione + '</option>');
                $.each(r.anios, function(i,a){ s.append($('<option>').val(a).text(a)); });
                s.trigger('change');
            }
        });
    }
    function cargarVariables(tabla, empresa) {
        $.get('@Url.Action("ObtenerVariables","InformeTablasDatos")', { nombreTabla:tabla, idEmpresa:empresa||null }, function(r) {
            if (r.success) {
                var s = $('#selectVariable').html('<option value="">' + _iaMsg.todas + '</option>');
                $.each(r.variables, function(i,v){ s.append($('<option>').val(v).text(v)); });
                s.trigger('change');
            }
        });
    }

    // ── Botón Analizar ────────────────────────────────────
    $('#btnAnalizar').on('click', function () {
        var tabla = $('#selectTabla').val(), empresa = $('#selectEmpresa').val();
        if (!tabla) { Swal.fire({icon:'warning',title:_iaMsg.tablaRequerida,text:_iaMsg.tablaSeleccionar}); return; }
        @if (esAdmin) {
            <text>
            if (!empresa) { Swal.fire({icon:'warning',title:_iaMsg.empresaRequerida,text:_iaMsg.empresaSeleccionar}); return; }
            </text>
        }
        if (!$('#selectAnio').val()) { Swal.fire({icon:'warning',title:_iaMsg.anioRequerido,text:_iaMsg.anioSeleccionar}); return; }

        filtrosActuales = {
            NombreTabla : tabla,
            IdEmpresa   : empresa || null,
            Anio        : $('#selectAnio').val()     || null,
            Mes         : $('#selectMes').val()      || null,
            Variable    : $('#selectVariable').val() || null
        };
        window._filtrosActualesPDF = filtrosActuales;

        var nombreTabla = $('#selectTabla option:selected').data('nombre') || tabla;
        var partes = [nombreTabla];
        if ($('#selectEmpresa option:selected').text() && empresa) partes.push($('#selectEmpresa option:selected').text());
        if ($('#selectAnio').val()) partes.push(_iaMsg.labelAnio + ' ' + $('#selectAnio').val());
        if ($('#selectMes option:selected').text() && $('#selectMes').val()) partes.push($('#selectMes option:selected').text());
        if ($('#selectVariable').val()) partes.push($('#selectVariable').val());
        $('#iaContexto').text(partes.join(' \u00B7 '));

        $('#placeholderIA').hide();
        $('#panelIA').show();
    });

    $('#btnNuevaConsulta').on('click', resetPanel);
    $('#btnLimpiar').on('click', function () {
        $('#selectTabla').val('').trigger('change');
        $('#selectEmpresa').val($('#selectEmpresa option:first').val()).trigger('change');
        $('#selectMes,#selectAnio').val('').trigger('change');
        $('#selectAnio').html('<option value="">' + _iaMsg.seleccione + '</option>').trigger('change');
        $('#selectVariable').html('<option value="">' + _iaMsg.todas + '</option>').trigger('change');
        resetPanel();
    });

    function resetPanel() {
        $('#panelIA').hide();
        $('#iaChatArea').hide();
        $('#iaChatMessages').empty();
        $('#iaChatLoading').hide();
        pararTimer();
        var ta = document.getElementById('txtPreguntaIA');
        ta.value = ''; ta.style.height = 'auto';
        $('#iaCharCount').text(_maxCharsPregunta).closest('.ia-char-count').removeClass('ia-char-warn');
        $('#txtFilasInfo').text(_iaMsg.filasInfo);
        document.getElementById('btnExportarPDF').style.display   = 'none';
        document.getElementById('btnExportarExcel').style.display = 'none';
        filtrosActuales = null;
        _chatHistorial  = [];
        _ultimaConsulta = null;
        $('#placeholderIA').show();
    }

    function pararTimer() {
        if (_timerInt) { clearInterval(_timerInt); _timerInt = null; }
        $('#iaLoadingTimer').text('');
    }

    // ── Chat helpers ──────────────────────────────────────
    var _iaEnCurso = false;
    function esc(s) { return $('<div>').text(s == null ? '' : s).html(); }

    function appendUserBubble(pregunta) {
        var html = '<div class="ia-chat-user-wrap">'
                 +   '<div class="ia-chat-user-bubble">'
                 +     '<div class="ia-chat-user-meta"><i class="fas fa-comment-alt"></i> ' + _iaMsg.preguntaLabel + '</div>'
                 +     '<div class="ia-chat-user-texto">' + $('<div>').text(pregunta).html() + '</div>'
                 +   '</div>'
                 +   '<div class="ia-chat-avatar ia-chat-avatar-user"><i class="fas fa-user"></i></div>'
                 + '</div>';
        $('#iaChatMessages').append(html);
        scrollChat();
    }

    // Reveal párrafo a párrafo. Estructura "Consola clara": cabecera con franja de metadatos a la
    // derecha, cuerpo, y barra de acciones (chips + votos + Detalles) bajo el cuerpo.
    function appendAssistantBubble(respuesta, meta, segTranscurridos) {
        meta = meta || {};

        var metaHeader = [];
        var filasTot = meta.TotalFilas || 0, filasEnv = meta.FilasEnviadas || 0;
        if (filasEnv || filasTot) {
            metaHeader.push((filasTot && filasEnv && filasEnv < filasTot)
                ? filasEnv.toLocaleString() + '/' + filasTot.toLocaleString() + ' ' + _iaMsg.metaFilas
                : (filasEnv || filasTot).toLocaleString() + ' ' + _iaMsg.metaFilas);
        }
        if (segTranscurridos != null) metaHeader.push(segTranscurridos + ' ' + _iaMsg.loadingSeg);
        if (meta.DesdeCache) metaHeader.push(_iaMsg.metaDesdeCache);

        var $wrap = $('<div class="ia-chat-assistant-wrap">'
            + '<div class="ia-chat-assistant-inner">'
            +   '<div class="ia-response-header">'
            +     '<span><i class="fas fa-stream"></i> ' + esc(_iaMsg.respuestaHeader) + '</span>'
            +     '<span class="ia-response-meta"></span>'
            +   '</div>'
            +   '<div class="ia-response-body"></div>'
            + '</div></div>');
        $wrap.find('.ia-response-meta').text(metaHeader.join(' · '));
        $('#iaChatMessages').append($wrap);
        scrollChat();

        var bodyEl     = $wrap.find('.ia-response-body')[0];
        var textoFinal = (respuesta || '').trim() || '(Sin respuesta del modelo)';
        var segments   = textoFinal.split('\n\n').filter(function (s) { return s.trim().length > 0; });
        var idx        = 0;
        var $cursor    = $('<span class="ia-cursor"> ▋</span>');
        $(bodyEl).append($cursor);

        function revealNext() {
            if (idx < segments.length) {
                var frag = document.createElement('div');
                frag.innerHTML = renderMD(segments[idx]);
                while (frag.firstChild) bodyEl.insertBefore(frag.firstChild, $cursor[0]);
                idx++;
                scrollChat();
                setTimeout(revealNext, 190);
            } else {
                bodyEl.innerHTML = renderMD(textoFinal);
                renderMetaFooter($wrap, meta);
                scrollChat();
            }
        }
        revealNext();
    }

    function renderMetaFooter($wrap, meta) {
        meta = meta || {};
        var $inner = $wrap.find('.ia-chat-assistant-inner');

        // Los chips y el panel de detalles solo viven en la última respuesta.
        $('#iaChatMessages .ia-response-actions, #iaChatMessages .ia-detalles-panel').remove();

        var $bar = $('<div class="ia-response-actions"></div>');

        // N03 — chips Regenerar / Más corto / En inglés
        [{ act:'regenerar', ic:'fa-redo-alt',     t:_iaMsg.accRegenerar },
         { act:'corto',     ic:'fa-compress-alt', t:_iaMsg.accCorto },
         { act:'ingles',    ic:'fa-language',     t:_iaMsg.accIngles }].forEach(function (a) {
            $('<button type="button" class="ia-chip">')
                .attr('data-act', a.act)
                .html('<i class="fas ' + a.ic + '"></i> ' + esc(a.t))
                .appendTo($bar);
        });

        $('<span class="spacer"></span>').appendTo($bar);

        // N02 — votos 👍/👎 + enlace permanente (necesitan la fila de auditoría)
        if (meta.IdAuditoria) {
            var $g = $('<span class="ia-fb"></span>').attr('data-id', meta.IdAuditoria);
            $('<button type="button" class="ia-vote" data-v="1"><i class="far fa-thumbs-up"></i></button>')
                .attr('title', _iaMsg.feedbackUtil).attr('aria-label', _iaMsg.feedbackUtil).appendTo($g);
            $('<button type="button" class="ia-vote" data-v="0"><i class="far fa-thumbs-down"></i></button>')
                .attr('title', _iaMsg.feedbackNoUtil).attr('aria-label', _iaMsg.feedbackNoUtil).appendTo($g);
            $g.appendTo($bar);
            $('<button type="button" class="ia-vote ia-link-btn"><i class="fas fa-link"></i></button>')
                .attr('data-id', meta.IdAuditoria)
                .attr('title', _iaMsg.accEnlace).attr('aria-label', _iaMsg.accEnlace)
                .appendTo($bar);
        }

        // N14 — "Detalles" colapsable: modelo · tokens (prompt + respuesta) · coste estimado
        var partes = [];
        if (meta.Modelo) partes.push(esc(meta.Modelo));
        if (meta.TokensTotal) {
            partes.push(Number(meta.TokensTotal).toLocaleString() + ' ' + esc(_iaMsg.metaTokens)
                + ' (' + Number(meta.TokensPrompt || 0).toLocaleString()
                + ' + ' + Number(meta.TokensRespuesta || 0).toLocaleString() + ')');
        }
        if (meta.CostoEstimadoUSD && Number(meta.CostoEstimadoUSD) > 0)
            partes.push('~US$' + Number(meta.CostoEstimadoUSD).toFixed(4));

        $inner.append($bar);

        if (partes.length) {
            var $tog = $('<span class="ia-detalles">' + esc(_iaMsg.metaDetalles) + ' <i class="fas fa-chevron-down"></i></span>');
            var $pan = $('<div class="ia-detalles-panel" hidden></div>').text(partes.join('   ·   '));
            $tog.on('click', function () {
                var mostrar = $pan.prop('hidden');
                $pan.prop('hidden', !mostrar);
                $tog.find('i').toggleClass('fa-chevron-down', !mostrar).toggleClass('fa-chevron-up', mostrar);
            });
            $tog.appendTo($bar);
            $pan.appendTo($inner);
        }
    }

    function scrollChat() {
        var el = document.getElementById('iaChatMessages');
        if (el) el.scrollTop = el.scrollHeight;
    }

    // ── Consultar IA ──────────────────────────────────────
    // esFrescaConversacion=true → resetea historial y genera desde cero
    // sinBurbujaUsuario=true → no vuelve a pintar la burbuja del usuario (usado al "Reintentar")
    function consultarIA(pregunta, esFrescaConversacion, sinBurbujaUsuario) {
        if (!filtrosActuales) return;
        _ultimaConsulta = { pregunta: pregunta || null, fresca: !!esFrescaConversacion };

        if (esFrescaConversacion) {
            _chatHistorial = [];
            $('#iaChatMessages').empty();
            document.getElementById('btnExportarPDF').style.display = 'none';
        }

        if (pregunta && !sinBurbujaUsuario) appendUserBubble(pregunta);

        $('#iaChatArea').show();
        $('#iaChatLoading').show();
        scrollChat();
        _iaEnCurso = true;
        $('#btnResumenIA,#btnPreguntarIA').prop('disabled', true);
        $('#iaChatMessages .ia-chip, #iaChatMessages .ia-vote').prop('disabled', true);

        // Cronómetro de la llamada
        _t0 = Date.now();
        pararTimer();
        _timerInt = setInterval(function () {
            $('#iaLoadingTimer').text('(' + Math.round((Date.now() - _t0) / 1000) + _iaMsg.loadingSeg + ')');
        }, 1000);

        var data = $.extend({}, filtrosActuales);
        if (pregunta) data.pregunta = pregunta;
        data.modo = modoActual();
        if (_chatHistorial.length > 0) data.historialJson = JSON.stringify(_chatHistorial);

        function terminar() {
            $('#iaChatLoading').hide();
            pararTimer();
            _iaEnCurso = false;
            $('#btnResumenIA,#btnPreguntarIA').prop('disabled', false);
            $('#iaChatMessages .ia-chip, #iaChatMessages .ia-vote:not(.is-active)').prop('disabled', false);
        }
        function reintentar() { consultarIA(_ultimaConsulta.pregunta, _ultimaConsulta.fresca, true); }

        $.ajax({
            url  : '@Url.Action("ConsultarConIA","InformeTablasDatos")',
            type : 'POST',
            data : data,
            success: function (resp) {
                terminar();
                if (resp.Exitoso) {
                    if (resp.TotalFilas > 0) {
                        $('#txtFilasInfo').text(
                            resp.FilasEnviadas < resp.TotalFilas
                                ? resp.FilasEnviadas + ' de ' + resp.TotalFilas + ' registros analizados'
                                : resp.TotalFilas + ' registros analizados'
                        );
                    }
                    var textoRespuesta = (resp.Respuesta || '').trim() || '(Sin respuesta del modelo)';
                    var seg = ((Date.now() - _t0) / 1000).toFixed(1).replace('.', ',');
                    appendAssistantBubble(textoRespuesta, resp, seg);
                    if (_chatHistorial.length === 0 && resp.PromptContextoInicial) {
                        _chatHistorial.push({ Rol: 'user', Contenido: resp.PromptContextoInicial });
                    } else if (pregunta) {
                        _chatHistorial.push({ Rol: 'user', Contenido: pregunta });
                    }
                    _chatHistorial.push({ Rol: 'assistant', Contenido: textoRespuesta });
                    document.getElementById('btnExportarPDF').style.display   = 'inline-flex';
                    document.getElementById('btnExportarExcel').style.display = 'inline-flex';
                    $('#txtPreguntaIA').focus();
                } else {
                    appendErrorBubble(resp.Error, reintentar);
                }
            },
            error: function () {
                terminar();
                appendErrorBubble(_iaMsg.servicioIA, reintentar);
            }
        });
    }

    function appendErrorBubble(texto, reintentarFn) {
        var $w = $('<div class="ia-chat-error-wrap">'
            + '<div class="ia-chat-avatar ia-chat-avatar-bot" style="background:#e05252;"><i class="fas fa-exclamation-triangle"></i></div>'
            + '<div class="ia-chat-error-inner"><div class="ia-err-txt"></div>'
            +   '<button type="button" class="ia-retry-btn"><i class="fas fa-rotate-right"></i> ' + esc(_iaMsg.retryBtn) + '</button>'
            + '</div></div>');
        $w.find('.ia-err-txt').text(texto || _iaMsg.servicioIA);
        $w.find('.ia-retry-btn').on('click', function () {
            if (_iaEnCurso) return;
            $w.remove();
            reintentarFn();
        });
        $('#iaChatMessages').append($w);
        scrollChat();
    }

    // N02 — valoración 👍/👎 de una respuesta
    $('#iaChatMessages').on('click', '.ia-vote[data-v]', function () {
        if (_iaEnCurso) return;
        var $b = $(this), $fb = $b.closest('.ia-fb');
        var id = $fb.data('id'), v = $b.data('v');
        if (!id) return;
        $fb.find('.ia-vote').prop('disabled', true).removeClass('is-active');
        $b.addClass('is-active');
        $.post(_iaMsg.valorarUrl, { id: id, valor: v }).fail(function () {
            $fb.find('.ia-vote').prop('disabled', false);
            $b.removeClass('is-active');
        });
    });

    // N03 — acciones rápidas sobre la última respuesta
    $('#iaChatMessages').on('click', '.ia-chip[data-act]', function () {
        if (_iaEnCurso || !filtrosActuales) return;
        var act = $(this).data('act');
        var instr = act === 'corto'  ? _iaMsg.instrCorto
                  : act === 'ingles' ? _iaMsg.instrIngles
                  :                    _iaMsg.instrRegenerar;
        consultarIA(instr, false);
    });

    // Enlace permanente al análisis (copia al portapapeles)
    $('#iaChatMessages').on('click', '.ia-link-btn', function () {
        var id = $(this).data('id');
        if (!id) return;
        var url = location.origin + _iaMsg.auditoriaIaUrl + '?ia=' + id;
        function aviso() {
            Swal.fire({ toast:true, position:'top-end', icon:'success', title:_iaMsg.enlaceCopiado,
                        showConfirmButton:false, timer:2000 });
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(aviso).catch(function () { window.prompt(_iaMsg.accEnlace, url); });
        } else {
            window.prompt(_iaMsg.accEnlace, url);
        }
    });

    // Segmented control de tipo de análisis ("Consola clara")
    function modoActual() { return $('#iaTipoAnalisis button.is-active').data('tipo') || 'resumen'; }
    function actualizarTituloGenerar() {
        $('#btnResumenIA').attr('title', _iaMsg.btnGenerar + ' · ' + $('#iaTipoAnalisis button.is-active').text());
    }
    $('#iaTipoAnalisis button').on('click', function () {
        $('#iaTipoAnalisis button').removeClass('is-active');
        $(this).addClass('is-active');
        actualizarTituloGenerar();
    });
    actualizarTituloGenerar();

    // Generar = conversación fresca con el modo seleccionado en el segmented
    $('#btnResumenIA').on('click', function () { consultarIA(null, true); });
    $('#btnPreguntarIA').on('click', function () {
        if (_iaEnCurso) return;
        var p = $('#txtPreguntaIA').val().trim();
        if (!p) { Swal.fire({icon:'warning',title:_iaMsg.preguntaVacia,text:_iaMsg.preguntaEscribir}); return; }
        if (p.length > _maxCharsPregunta) { Swal.fire({icon:'warning',title:_iaMsg.preguntaLarga,text:_iaMsg.preguntaLargaTexto}); return; }
        consultarIA(p, false);
        $('#txtPreguntaIA').val('').trigger('input');
    });
    // Enter = enviar · Shift+Enter = salto de línea
    $('#txtPreguntaIA').on('keydown', function (e) {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); $('#btnPreguntarIA').trigger('click'); }
    });
    // Contador + autoexpandir
    $('#txtPreguntaIA').on('input', function () {
        var remaining = _maxCharsPregunta - this.value.length;
        $('#iaCharCount').text(remaining).closest('.ia-char-count').toggleClass('ia-char-warn', remaining < 50);
        this.style.height = 'auto';
        this.style.height = Math.min(this.scrollHeight, 130) + 'px';
    });

    // Estado inicial del botón Analizar (habilitado solo con filtros completos)
    estadoBotonAnalizar();

    // ── Select2 ───────────────────────────────────────────
    $('#selectTabla').select2($.extend({placeholder:_iaMsg.seleccione,allowClear:false},{width:'100%',language:s2lang}));
    $('#selectEmpresa').select2($.extend({placeholder:_iaMsg.seleccione,allowClear:false},{width:'100%',language:s2lang}));
    $('#selectAnio').select2($.extend({placeholder:_iaMsg.seleccione,allowClear:false},{width:'100%',language:s2lang}));
    $('#selectMes').select2($.extend({placeholder:_iaMsg.todos,allowClear:true,minimumResultsForSearch:-1},{width:'100%',language:s2lang}));
    $('#selectVariable').select2($.extend({placeholder:_iaMsg.todas,allowClear:true},{width:'100%',language:s2lang}));

}); // end document.ready
</script>

<script>
async function exportarAnalisisPDF() {
    var btn = document.getElementById('btnExportarPDF');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
    btn.title = _iaMsg.generandoPDF;
    try {
        var ahora = new Date();
        var fechaTexto = ahora.toLocaleDateString('es-CO',{year:'numeric',month:'long',day:'numeric'})
                       + ' · ' + ahora.toLocaleTimeString('es-CO',{hour:'2-digit',minute:'2-digit'});
        document.getElementById('pdfFecha').textContent = fechaTexto;

        var filtros       = window._filtrosActualesPDF || {};
        var nombreEmpresa = $('#selectEmpresa option:selected').text().trim() || filtros.IdEmpresa || '—';
        var mesTexto      = $('#selectMes option:selected').text().trim();
        if (!mesTexto || mesTexto === _iaMsg.mesTextoTodos) mesTexto = _iaMsg.todos;
        var tablaTexto    = $('#selectTabla option:selected').data('nombre') || filtros.NombreTabla || '—';
        var contextoLabel = ($('#iaContexto').text() || '').trim();

        // Filtros
        var filtrosData = [
            {label:_iaMsg.labelTabla,    valor:tablaTexto},
            {label:_iaMsg.labelEmpresa,  valor:nombreEmpresa},
            {label:_iaMsg.labelAnio,     valor:filtros.Anio||'—'},
            {label:_iaMsg.labelMes,      valor:mesTexto},
            {label:_iaMsg.labelVariable, valor:filtros.Variable||_iaMsg.todas}
        ];
        var fHtml = '';
        filtrosData.forEach(function(f){
            fHtml += '<div class="pdf-filtro-item">'
                   + '<span class="pdf-filtro-label">'+f.label+'</span>'
                   + '<span class="pdf-filtro-valor">'+f.valor+'</span></div>';
        });
        document.getElementById('pdfFiltros').innerHTML = fHtml;

        // Contar secciones
        var totalSecciones = _chatHistorial.filter(function(m){ return m.Rol === 'assistant'; }).length;

        // Banner de resumen
        var bannerHtml = '<div class="pdf-resumen-banner">'
            + 'Este informe contiene <strong>' + totalSecciones
            + ' an&aacute;lisis</strong> generado' + (totalSecciones !== 1 ? 's' : '')
            + ' por inteligencia artificial a partir de los datos seleccionados.'
            + '</div>';

        // Construir secciones del informe
        var contenidoHtml = '';
        var seccionNum = 0;
        for (var i = 0; i < _chatHistorial.length; i++) {
            if (_chatHistorial[i].Rol !== 'assistant') continue;
            seccionNum++;
            var esInicial = (seccionNum === 1);

            // Pregunta: para sección 1 usamos el contexto de filtros; para las demás el texto del usuario
            var preguntaTexto = null;
            if (esInicial) {
                preguntaTexto = contextoLabel || tablaTexto;
            } else if (i > 0 && _chatHistorial[i - 1].Rol === 'user') {
                preguntaTexto = _chatHistorial[i - 1].Contenido;
            }

            var labelSeccion = esInicial ? 'An&aacute;lisis Ejecutivo' : 'Consulta Adicional';
            var numBadge = '<span class="pdf-seccion-num">' + seccionNum + '</span>';

            contenidoHtml += '<div class="pdf-seccion">';
            contenidoHtml += '<div class="pdf-seccion-titulo">' + numBadge + ' ' + labelSeccion + '</div>';

            if (preguntaTexto) {
                var labelPregunta = esInicial ? 'Contexto analizado:' : 'Pregunta:';
                contenidoHtml += '<div class="pdf-seccion-pregunta">'
                               + '<span class="pdf-pregunta-label">' + labelPregunta + '</span>&nbsp;'
                               + $('<div>').text(preguntaTexto).html()
                               + '</div>';
            }

            contenidoHtml += '<div class="pdf-seccion-body">'
                           + renderMD(_chatHistorial[i].Contenido)
                           + '</div>';
            contenidoHtml += '</div>';
        }

        document.getElementById('pdfContenido').innerHTML = bannerHtml + contenidoHtml;

        // Renderizar y exportar: un solo canvas -> JPEG, reutilizado en cada página con distinto
        // desplazamiento (jsPDF deduplica la imagen, así el PDF queda ligero).
        var preview = document.getElementById('pdfPreview');
        preview.style.left = '-9999px'; preview.style.display = 'block';
        var canvas = await html2canvas(preview, {
            scale: 2, useCORS: true, logging: false, backgroundColor: '#ffffff',
            windowWidth: 794, windowHeight: preview.scrollHeight
        });
        preview.style.display = 'none'; preview.style.left = '-9999px';

        var jsPDF = window.jspdf.jsPDF;
        var pdf   = new jsPDF('p', 'mm', 'a4');
        var pageW = pdf.internal.pageSize.getWidth();
        var pageH = pdf.internal.pageSize.getHeight();

        var pxPerMm    = canvas.width / pageW;              // px de origen por mm de PDF
        var fullPagePx = Math.floor(pageH * pxPerMm);       // px que caben en una página
        var backoffPx  = Math.floor(fullPagePx * 0.14);     // margen para buscar un hueco (~14% de página)
        var ctx        = canvas.getContext('2d');

        // Corta cada página en la fila-hueco (casi toda del color de fondo) más baja dentro del
        // margen de retroceso, para no partir una línea de texto entre páginas. Si no hay hueco
        // —o el canvas no es legible— cae a un corte duro, como antes.
        var slice  = document.createElement('canvas');
        slice.width = canvas.width;
        var sctx   = slice.getContext('2d');

        var srcY = 0, pageNum = 0;
        while (srcY < canvas.height) {
            var sliceH = Math.min(fullPagePx, canvas.height - srcY);

            if (srcY + sliceH < canvas.height) {
                var winTop = srcY + sliceH - backoffPx;
                var found  = -1;
                try {
                    var win = ctx.getImageData(0, winTop, canvas.width, backoffPx).data;
                    var rowBytes = canvas.width * 4;
                    for (var row = backoffPx - 1; row >= 0 && found < 0; row--) {
                        var base = row * rowBytes, blank = true;
                        for (var px = 0; px < rowBytes; px += 64) {   // muestreo 1 de cada 16 px
                            if (win[base + px] < 245 || win[base + px + 1] < 245 || win[base + px + 2] < 245) { blank = false; break; }
                        }
                        if (blank) found = row;
                    }
                } catch (e) { found = -1; }
                if (found >= 0) sliceH = (winTop + found) - srcY;
            }

            slice.height = sliceH;
            sctx.fillStyle = '#ffffff';
            sctx.fillRect(0, 0, slice.width, sliceH);
            sctx.drawImage(canvas, 0, srcY, canvas.width, sliceH, 0, 0, canvas.width, sliceH);

            if (pageNum > 0) pdf.addPage();
            pdf.addImage(slice.toDataURL('image/jpeg', 0.92), 'JPEG', 0, 0, pageW, sliceH / pxPerMm, undefined, 'FAST');
            // Número de página (solo ASCII: Helvetica de jsPDF no soporta Latin Extended)
            pdf.setFontSize(7);
            pdf.setTextColor(180, 180, 180);
            pdf.text('- ' + (pageNum + 1) + ' -', pageW / 2, pageH - 4, { align: 'center' });

            srcY += sliceH;
            pageNum++;
        }
        pdf.save('AnalisisIA_BUFINS_' + ahora.toISOString().slice(0, 10).replace(/-/g, '') + '.pdf');
    } catch (e) {
        console.error(e);
        Swal.fire({icon:'error', title:_iaMsg.error, text:_iaMsg.errorPDF});
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-file-pdf"></i><span class="btn-label">' + _iaMsg.btnExportarPDF + '</span>';
        btn.title = _iaMsg.btnExportarPDF;
    }
}
</script>

<script>
function exportarExcelConIA() {
    var btn = document.getElementById('btnExportarExcel');
    var textoAnalisis = _chatHistorial
        .filter(function(m){ return m.Rol === 'assistant'; })
        .map(function(m){ return m.Contenido; })
        .join('\n\n---\n\n');

    if (!textoAnalisis || !window._filtrosActualesPDF) {
        return;
    }

    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

    var form = document.createElement('form');
    form.method = 'POST';
    form.action = '@Url.Action("ExportarExcelConIA","InformeTablasDatos")';

    var campos = Object.assign({}, window._filtrosActualesPDF, { textoAnalisis: textoAnalisis });
    Object.keys(campos).forEach(function(k) {
        if (campos[k] !== null && campos[k] !== undefined) {
            var input = document.createElement('input');
            input.type  = 'hidden';
            input.name  = k;
            input.value = campos[k];
            form.appendChild(input);
        }
    });

    // Add CSRF token if present
    var token = $('input[name="__RequestVerificationToken"]').val();
    if (token) {
        var csrf = document.createElement('input');
        csrf.type  = 'hidden';
        csrf.name  = '__RequestVerificationToken';
        csrf.value = token;
        form.appendChild(csrf);
    }

    document.body.appendChild(form);
    form.submit();
    document.body.removeChild(form);

    setTimeout(function() {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-file-excel"></i><span class="btn-label">' + _iaMsg.btnExcelConIA + '</span>';
    }, 3000);
}

</script>
}
