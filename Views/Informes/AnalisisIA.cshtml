        asistenteError:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IA_JS_AsistenteError))',
        conexionError:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IA_JS_ConexionError))',
