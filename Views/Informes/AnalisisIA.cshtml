        loadingSeg:         '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IA_LoadingSeg))',
        retryBtn:           '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.IA_RetryBtn))',
