        catch (e) { return escalarLN(v) + sufijoLN(); }
    }
    function fmtNumVarLN(v) {
        if (v === null || v === undefined) return CH_MDASH_LN;
        try { return new Intl.NumberFormat(_ln.cultura, { minimumFractionDigits: decLN(), maximumFractionDigits: decLN(), signDisplay: 'exceptZero' }).format(escalarLN(v)) + sufijoLN(); }
        catch (e) { var n = escalarLN(v); return (n >= 0 ? '+' : '') + n + sufijoLN(); }
