        aceptar: '@Html.Raw(J(Resources.Strings.Common_Aceptar))'
    };

    var _ln = {
        urls: {
            meses: '@Url.Action("ObtenerMeses", "InformeLineasNegocio")',
            reporte: '@Url.Action("ConsultarReporte", "InformeLineasNegocio")',
