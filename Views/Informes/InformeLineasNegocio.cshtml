            y += hF;
        });

        var tot = pdf.internal.getNumberOfPages();
        for (var p = 1; p <= tot; p++) {
            pdf.setPage(p); rgb('setDrawColor', C.linea); pdf.setLineWidth(0.3); pdf.line(M, H - 10, W - M, H - 10);
            fuente('normal', 7, C.muted); pdf.text(P.pie + '  ' + CH_MIDDOT_LN + '  ' + empresa + '  ' + CH_MIDDOT_LN + '  ' + periodo, M, H - 6);
            pdf.text(P.confidencial, W / 2, H - 6, { align: 'center' });
            fuente('bold', 7, C.texto2); pdf.text(P.paginaFmt.replace('{0}', p).replace('{1}', tot), W - M, H - 6, { align: 'right' });
        }
        pdf.__nombre = 'LineasNegocio_' + empresa.replace(/[^a-z0-9]+/gi, '_') + '_' + r.AnioHasta + ('0' + r.MesHasta).slice(-2) + '.pdf';
        return pdf;
    }

    $(document).ready(function () {
        $('#lnEmpresa, #lnEscenario').select2({ width: '100%', language: s2langLN, dropdownAutoWidth: false, minimumResultsForSearch: 10 });
        $('#lnEmpresa, #lnEscenario').on('change', cargarMesesLN);

        $('#lnAtajos button').on('click', function () { aplicarPresetLN($(this).data('preset')); });
        $('#lnKnobFrom').on('pointerdown', function (e) { e.stopPropagation(); arrastreLN(e, 'from'); });
        $('#lnKnobTo').on('pointerdown', function (e) { e.stopPropagation(); arrastreLN(e, 'to'); });
        $('#lnRangoTrack').on('pointerdown', clicPistaLN);
        $('#lnKnobFrom, #lnKnobTo').on('keydown', function (e) { tecladoKnobLN(e, this.id === 'lnKnobFrom' ? 'from' : 'to'); });

        $('#lnBtnUnidad').on('click', function (e) {
            e.stopPropagation();
            $(this).attr('aria-expanded', $('#lnMenuUnidad').toggleClass('open').hasClass('open') ? 'true' : 'false');
        });
        $('#lnMenuUnidad button').on('click', function (e) {
            e.stopPropagation();
            _ln.unidad = $(this).data('unidad');
            $('#lnMenuUnidad').removeClass('open'); $('#lnBtnUnidad').attr('aria-expanded', 'false');
            guardarPrefsLN(); repintarLN();
        });
        $(document).on('click', function () { $('#lnMenuUnidad').removeClass('open'); $('#lnBtnUnidad').attr('aria-expanded', 'false'); });

        function exportarExcelLN() {
            if (!_ln.filtrosConsultados) return;
            var $c = $('#lnExpCampos').empty();
            Object.keys(_ln.filtrosConsultados).forEach(function (k) { $c.append($('<input type="hidden">').attr('name', k).val(_ln.filtrosConsultados[k] == null ? '' : _ln.filtrosConsultados[k])); });
            $('#frmExportarExcelLN').submit();
        }

        $('#btnConsultarLN').on('click', consultarLN);
        InformeTema.montar({ selector: '#lnTema', empresa: '#lnEmpresa' });
        $('#btnLimpiarLN').on('click', function () {
            InformeTema.reset();
            if (_ln.esAdmin) elEmpresaLN.val('').trigger('change.select2');
            cargarMesesLN();
        });
        $('#btnGenerarInsightsLN').on('click', generarInsightsLN);
        $('#btnLnPreguntar').on('click', preguntarLN);
        $('#lnPregunta').on('keydown', function (e) { if (e.which === 13) { e.preventDefault(); preguntarLN(); } });

        ComentariosGestion.montar({ raiz: '#lnComentarios', informe: 'LineasNegocio' });

        var correoLN = ExportMenu.correo({
            url: '@Url.Action("EnviarPorCorreo", "InformeLineasNegocio")',
            token: function () { return _ln.token; },
            datos: function () { return $.extend({}, _ln.filtrosConsultados); },
            pdf: function () { var d = construirPdfLN(_ln.reporteActual); return d ? d.output('datauristring') : ''; },
            pills: function () { return [$('#lnTituloEmpresa').text()].concat($('#lnPanelResultado .pyg2-chip').map(function () { return $(this).text(); }).get()); },
            textos: EXP_T
        });
        ExportMenu.init('lnExp', {
            acciones: { excel: exportarExcelLN, pdf: generarPdfLN, imagen: copiarImagenLN, correo: function () { if (_ln.reporteActual) correoLN.abrir(); } },
            textos: EXP_T
        });

        DocVisor.init({ boton: '#lnDocBtn', url: '@Url.Action("Ver", "Documentacion", new { clave = "lineas-negocio" })' });
        cargarPrefsLN(); pintarRangoLN(); cargarMesesLN();
    });
</script>
}
