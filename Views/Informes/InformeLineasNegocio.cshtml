    // ===== Formatos =====
    function escalarLN(v) { return _ln.unidad === 'miles' ? v / 1000 : (_ln.unidad === 'millones' ? v / 1000000 : v); }
    function sufijoLN() { return _ln.unidad === 'miles' ? ' ' + _ln.t.unidadSufijoMiles : (_ln.unidad === 'millones' ? ' ' + _ln.t.unidadSufijoMillones : ''); }
    function decLN() { return _ln.unidad === 'pesos' ? 0 : 1; }
