    function separarInsightsLN(texto) {
        var claves = { rentabilidad: /^(rentabilidad|profitability)/i, concentracion: /^(concentraci[oó]n|concentration)/i, accion: /^(acci[oó]n recomendada|recommended action|acci[oó]n)/i };
        var etiqueta = /^(\*\*|__)?\s*(rentabilidad|concentraci[oó]n|acci[oó]n recomendada|acci[oó]n|profitability|concentration|recommended action)[^:]*:\s*(\*\*|__)?\s*/i;
        var partes = { rentabilidad: [], concentracion: [], accion: [] }, actual = null;
        (texto || '').split(/\r?\n/).forEach(function (linea) {
            var conFormato = linea.replace(/^\s*(?:[-•>#]+|\*(?=\s)|\d+[.)])\s*/, '').trim(), plano = conFormato.replace(/\*\*|__/g, '').trim();
            if (!plano) return;
            var enc = null; Object.keys(claves).forEach(function (k) { if (!enc && claves[k].test(plano)) enc = k; });
            if (enc) { actual = enc; var resto = plano.indexOf(':') >= 0 ? conFormato.replace(etiqueta, '').trim() : ''; if (resto) partes[actual].push(resto); return; }
            if (actual) partes[actual].push(conFormato);
        });
        if (!partes.rentabilidad.length || !partes.concentracion.length || !partes.accion.length) return null;
        return { rentabilidad: partes.rentabilidad.join(' '), concentracion: partes.concentracion.join(' '), accion: partes.accion.join(' ') };
    }
