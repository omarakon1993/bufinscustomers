        } else {
            rgb('setFillColor', C.suave2); rgb('setDrawColor', C.linea); pdf.setLineDashPattern([1.2, 1], 0); pdf.roundedRect(M, y, ANCHO, 12, 2, 2, 'FD'); pdf.setLineDashPattern([], 0);
            fuente('italic', 8.5, C.texto2); pdf.text(pdf.splitTextToSize(_ln.insightsTexto ? limpiar(_ln.insightsTexto) : P.sinInsights, ANCHO - 10)[0], M + 5, y + 7.5);
            y += 12;
