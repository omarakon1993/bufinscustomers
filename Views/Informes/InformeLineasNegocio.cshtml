        }
        function encabezadoPagina(seccion) {
            degradado(0, 0, W, 2.4);
            fuente('bold', 10, C.texto); pdf.text(empresa, M, 11);
            fuente('normal', 8, C.muted); pdf.text(P.titulo + '  ' + CH_MIDDOT_LN + '  ' + periodo, W - M, 11, { align: 'right' });
            if (seccion) { fuente('bold', 13, C.texto); pdf.text(seccion, M, 21); }
            y = seccion ? 29 : 18;
        }
        function nuevaPagina(seccion) { pdf.addPage(); encabezadoPagina(seccion); }

        // ===== Página 1: resumen =====
        degradado(0, 0, W, 34);
        fuente('bold', 10, C.blanco);
        var wMarca = window.BufinsPdfMarca ? BufinsPdfMarca(pdf, M, 10) : 0;
        if (!wMarca) { pdf.text(P.marca, M, 10); wMarca = ancho(P.marca); }
        fuente('normal', 8.5, C.blanco); pdf.text(CH_MIDDOT_LN + '  ' + P.subtitulo, M + wMarca + 2.5, 10);
        fuente('bold', 19, C.blanco); pdf.text(empresa, M, 22);
        fuente('normal', 9.5, C.blanco); pdf.text(P.titulo, M, 29);
        fuente('normal', 8, C.blanco); pdf.text(P.generadoEl + ' ' + ($('#lnFechaGenerado').text() || ''), W - M, 10, { align: 'right' });
        fuente('bold', 8, C.blanco); pdf.text(P.confidencial.toUpperCase(), W - M, 29, { align: 'right' });
        EmpresaLogo.pdf(pdf, { xDerecha: W - M, y: 12.5, alto: 14 });

        y = 43;
        var xc = M;
        [{ t: $('#lnChipPeriodo').text(), fg: C.morado, bg: C.totalBg, b: true }, { t: $('#lnChipEscenario').text() }, { t: $('#lnChipLineas').text() }, { t: T.unidadBadge[_ln.unidad] }].forEach(function (c) {
            if (!c.t) return;
            fuente(c.b ? 'bold' : 'normal', 7.5, C.texto2);
            if (xc + ancho(c.t) + 5 > W - M) { xc = M; y += 7; }
            xc += pildora(c.t, xc, y, c.fg || C.texto2, c.bg || C.suave, !!c.b) + 3;
        });

        y += 11;
        if (r.HayComparacionPYG) {
            var xb = M;
            [{ ok: r.CuadraIngresosPYG, txt: r.CuadraIngresosPYG ? T.cuadreIngresosOk : T.cuadreIngresosErrorFmt.replace('{0}', fmtNumVarLN(r.DiferenciaIngresosPYG)) },
             { ok: r.CuadraUtilidadPYG, txt: r.CuadraUtilidadPYG ? T.cuadreUtilidadOk : T.cuadreUtilidadErrorFmt.replace('{0}', fmtNumVarLN(r.DiferenciaUtilidadPYG)) }].forEach(function (b) {
