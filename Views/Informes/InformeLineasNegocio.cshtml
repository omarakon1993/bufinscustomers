            badgeMes: '@Html.Raw(J(Resources.Strings.LineaTiempo_BadgeMes))',
            badgeMeses: '@Html.Raw(J(Resources.Strings.LineaTiempo_BadgeMeses))',
            unidades: { pesos: '@Html.Raw(J(Resources.Strings.LineaTiempo_UnidadPesos))', miles: '@Html.Raw(J(Resources.Strings.LineaTiempo_UnidadMiles))', millones: '@Html.Raw(J(Resources.Strings.LineaTiempo_UnidadMillones))' },
            unidadSufijoMiles: '@Html.Raw(J(Resources.Strings.LineaTiempo_UnidadSufijoMiles))',
            unidadSufijoMillones: '@Html.Raw(J(Resources.Strings.LineaTiempo_UnidadSufijoMillones))',
            unidadBadge: { pesos: '@Html.Raw(J(Resources.Strings.BAL_UnidadPesosCop))', miles: '@Html.Raw(J(Resources.Strings.BAL_UnidadMilesCop))', millones: '@Html.Raw(J(Resources.Strings.BAL_UnidadMillones))' },
            rangoTooltipFmt: '@Html.Raw(J(Resources.Strings.Rango_TooltipFmt))',
            rangoSinDatosFmt: '@Html.Raw(J(Resources.Strings.Rango_SinDatosFmt))',
            generar: '@Html.Raw(J(Resources.Strings.BAL_Generar))',
            regenerar: '@Html.Raw(J(Resources.Strings.BAL_Regenerar))',
            insightsVacio: '@Html.Raw(J(Resources.Strings.LN_InsightsVacio))',
            insightsSub: '@Html.Raw(J(Resources.Strings.LN_InsightsSub))',
            insightsMetaFmt: '@Html.Raw(J(Resources.Strings.LN_InsightsMetaFmt))',
            rentabilidad: '@Html.Raw(J(Resources.Strings.LN_InsRentabilidad))',
            concentracion: '@Html.Raw(J(Resources.Strings.LN_InsConcentracion))',
            accion: '@Html.Raw(J(Resources.Strings.LN_InsAccion))',
            periodoFmt: '@Html.Raw(J(Resources.Strings.LN_PeriodoFmt))',
            lineasFmt: '@Html.Raw(J(Resources.Strings.LN_LineasFmt))',
            mezclaSubFmt: '@Html.Raw(J(Resources.Strings.LN_MezclaSubFmt))',
            resumenSubFmt: '@Html.Raw(J(Resources.Strings.LN_ResumenSubFmt))',
            vsAnterior: '@Html.Raw(J(Resources.Strings.LN_VsAnterior))',
            deLosIngresos: '@Html.Raw(J(Resources.Strings.LN_DeLosIngresos))',
            margenOpCorto: '@Html.Raw(J(Resources.Strings.LN_MargenOpCorto))',
            sinDestacados: '@Html.Raw(J(Resources.Strings.BAL_SinDestacados))',
            favorable: '@Html.Raw(J(Resources.Strings.BAL_Favorable))',
            desfavorableCorto: '@Html.Raw(J(Resources.Strings.BAL_DesfavorableCorto))',
            cuadreIngresosOk: '@Html.Raw(J(Resources.Strings.LN_CuadreIngresosOk))',
            cuadreIngresosErrorFmt: '@Html.Raw(J(Resources.Strings.LN_CuadreIngresosErrorFmt))',
            cuadreUtilidadOk: '@Html.Raw(J(Resources.Strings.LN_CuadreUtilidadOk))',
            cuadreUtilidadErrorFmt: '@Html.Raw(J(Resources.Strings.LN_CuadreUtilidadErrorFmt))',
            kpi: {
                Ingresos: '@Html.Raw(J(Resources.Strings.LN_Kpi_Ingresos))', UtilOperacional: '@Html.Raw(J(Resources.Strings.LN_Kpi_UtilOperacional))',
                MargenOperacional: '@Html.Raw(J(Resources.Strings.LN_Kpi_MargenOperacional))', LineaLider: '@Html.Raw(J(Resources.Strings.LN_Kpi_LineaLider))'
            },
            col: {
                concepto: '@Html.Raw(J(Resources.Strings.LN_Col_Concepto))', linea: '@Html.Raw(J(Resources.Strings.LN_Col_Linea))', total: '@Html.Raw(J(Resources.Strings.LN_Col_Total))',
                ingresos: '@Html.Raw(J(Resources.Strings.LN_Col_Ingresos))', pctIngresos: '@Html.Raw(J(Resources.Strings.LN_Col_PctIngresos))',
                margenBruto: '@Html.Raw(J(Resources.Strings.LN_Col_MargenBruto))', margenOperacional: '@Html.Raw(J(Resources.Strings.LN_Col_MargenOperacional))',
                margenEbitda: '@Html.Raw(J(Resources.Strings.LN_Col_MargenEbitda))', margenNeto: '@Html.Raw(J(Resources.Strings.LN_Col_MargenNeto))',
                utilOperacional: '@Html.Raw(J(Resources.Strings.LN_Col_UtilOperacional))', pctUtilOperacional: '@Html.Raw(J(Resources.Strings.LN_Col_PctUtilOperacional))',
                varIngresos: '@Html.Raw(J(Resources.Strings.LN_Col_VarIngresos))', varUtilOperacional: '@Html.Raw(J(Resources.Strings.LN_Col_VarUtilOperacional))'
            },
            fila: {
                Ingresos: '@Html.Raw(J(Resources.Strings.LN_Fila_Ingresos))', CostoVentas: '@Html.Raw(J(Resources.Strings.LN_Fila_CostoVentas))',
                UtilidadBruta: '@Html.Raw(J(Resources.Strings.LN_Fila_UtilidadBruta))', GastosOperacionales: '@Html.Raw(J(Resources.Strings.LN_Fila_GastosOperacionales))',
                UtilidadOperacional: '@Html.Raw(J(Resources.Strings.LN_Fila_UtilidadOperacional))', Ebitda: '@Html.Raw(J(Resources.Strings.LN_Fila_Ebitda))',
                ResultadoNoOperacional: '@Html.Raw(J(Resources.Strings.LN_Fila_ResultadoNoOperacional))', UtilidadAntesImpuestos: '@Html.Raw(J(Resources.Strings.LN_Fila_UtilidadAntesImpuestos))',
                Impuesto: '@Html.Raw(J(Resources.Strings.LN_Fila_Impuesto))', UtilidadNeta: '@Html.Raw(J(Resources.Strings.LN_Fila_UtilidadNeta))',
                MargenBruto: '@Html.Raw(J(Resources.Strings.LN_Col_MargenBruto))', MargenOperacional: '@Html.Raw(J(Resources.Strings.LN_Col_MargenOperacional))',
                MargenEbitda: '@Html.Raw(J(Resources.Strings.LN_Col_MargenEbitda))', MargenNeto: '@Html.Raw(J(Resources.Strings.LN_Col_MargenNeto))'
            },
            pdf: {
                marca: '@Html.Raw(J(Resources.Strings.LineaTiempo_BrandMark))', titulo: '@Html.Raw(J(Resources.Strings.LN_PageTitle))',
                subtitulo: '@Html.Raw(J(Resources.Strings.LN_V2_Subtitulo))', generadoEl: '@Html.Raw(J(Resources.Strings.BAL_V2_GeneradoEl))',
                confidencial: '@Html.Raw(J(Resources.Strings.BAL_Pdf_Confidencial))', paginaFmt: '@Html.Raw(J(Resources.Strings.BAL_Pdf_PaginaFmt))',
                sinInsights: '@Html.Raw(J(Resources.Strings.BAL_Pdf_SinInsights))', resumen: '@Html.Raw(J(Resources.Strings.BAL_Pdf_Resumen))',
