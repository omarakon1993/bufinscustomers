        $('#lnKnobFrom').css('left', pD + '%').attr({ 'aria-valuemin': 0, 'aria-valuemax': n - 1, 'aria-valuenow': _ln.iDesde, 'aria-valuetext': meses[_ln.iDesde].etiqueta });
        $('#lnKnobTo').css('left', pH + '%').attr({ 'aria-valuemin': 0, 'aria-valuemax': n - 1, 'aria-valuenow': _ln.iHasta, 'aria-valuetext': meses[_ln.iHasta].etiqueta });
        $('#lnRangoSel').css({ left: pD + '%', width: (pH - pD) + '%' });
        var unMes = _ln.iDesde === _ln.iHasta;
        $('#lnRangoDesdeLbl').text(meses[_ln.iDesde].etiqueta);
        $('#lnRangoHastaLbl').text(unMes ? '' : meses[_ln.iHasta].etiqueta).toggle(!unMes);
        $('#lnRangoDesdeLbl').next('i').toggle(!unMes);
        var total = _ln.iHasta - _ln.iDesde + 1;
        $('#lnRangoBadge').text(total + ' ' + (total === 1 ? _ln.t.badgeMes : _ln.t.badgeMeses));
        var anios = [];
        meses.forEach(function (m) { if (anios.indexOf(m.anio) === -1) anios.push(m.anio); });
        $('#lnRangoYears').html(anios.map(function (a) { return '<span>' + a + '</span>'; }).join(''));
        RangoAtajos.pintarBotones($('#lnAtajos button'), _ln.rango, _ln.hoy, _ln.iDesde, _ln.iHasta,
            _ln.mesesNombres.map(function (x) { return x.substring(0, 3); }), { tooltipFmt: _ln.t.rangoTooltipFmt, sinDatosFmt: _ln.t.rangoSinDatosFmt });
    }
    function aplicarPresetLN(preset) {
        var p = RangoAtajos.indices(preset, _ln.rango, _ln.hoy);
