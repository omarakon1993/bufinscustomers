            { icono: 'fa-percent', nombre: T.kpi.MargenOperacional, valor: fmtPctLN(t.MargenOperacional), d: null },
            { icono: 'fa-crown', nombre: T.kpi.LineaLider, valor: lider.Nombre, d: null, ref: lider.PctIngresos != null ? fmtPctLN(lider.PctIngresos) + ' ' + T.deLosIngresos : '' }
