@using System.Web
@using bufinscustomers.Models
@functions {
    static string J(string s) { return System.Web.HttpUtility.JavaScriptStringEncode(s ?? ""); }
}
@{
    ViewBag.Title = Resources.Strings.LN_PageTitle;
    var empresas = ViewBag.Empresas as List<Empresas>;
    var esAdmin = (bool)(ViewBag.EsAdmin ?? false);
    var culturaJs = System.Globalization.CultureInfo.CurrentUICulture.Name;
}

<link href="~/Assets/css/bufins-components.css" rel="stylesheet" />
<link href="~/Assets/css/informe-linea-tiempo.css" rel="stylesheet" />
<link href="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/css/informe-pyg.css")" rel="stylesheet" />
<link href="~/Assets/css/informe-balance.css" rel="stylesheet" />
<link href="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/css/informe-lineas-negocio.css")" rel="stylesheet" />
<link href="~/Assets/css/export-menu.css" rel="stylesheet" />
<link href="~/Assets/css/doc-visor.css" rel="stylesheet" />
<link href="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/css/empresa-logo.css")" rel="stylesheet" />
<link href="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/css/tema-informe.css")" rel="stylesheet" />
<link href="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/css/comentarios-gestion.css")" rel="stylesheet" />
<link href="~/Assets/css/select2/select2.min.css" rel="stylesheet" />

<div class="container-fluid px-4">
<div class="lt-app">

    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas fa-sitemap powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@Resources.Strings.LN_PageTitle</h1>
            @Html.Partial("_ModeloBufinsTag")
            <button type="button" class="header-tag-doc" id="lnDocBtn" title="@Resources.Strings.LN_DocumentacionTooltip"><i class="fas fa-book"></i>@Resources.Strings.Common_DocumentacionTag</button>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <div class="filter-card">
        <div class="lt-section-title"><span>@Resources.Strings.Common_FiltrosConsulta</span></div>
        <div class="lt-grid-quever">
            <div class="lt-field">
                <label class="lt-field-label" for="lnEmpresa">@Resources.Strings.Common_LabelEmpresa</label>
                <select id="lnEmpresa" class="lt-field-select">
                    @if (esAdmin) { <option value="">@Resources.Strings.Common_Seleccione</option> }
                    @if (empresas != null)
                    {
                        foreach (var e in empresas)
                        {
                            <option value="@e.Id">@e.Nombre</option>
                        }
                    }
                </select>
            </div>
            <div class="lt-field">
                <label class="lt-field-label" for="lnEscenario">@Resources.Strings.Common_LabelEscenario</label>
                <select id="lnEscenario" class="lt-field-select">
                    @if (ViewBag.Escenarios != null)
                    {
                        foreach (var esc in ViewBag.Escenarios)
                        {
                            <option value="@esc.Id">@esc.Nombre</option>
                        }
                    }
                </select>
            </div>
        </div>

        <div class="lt-section-title mt"><span>@Resources.Strings.LineaTiempo_FilaCuando</span></div>
        <div class="lt-grid-rango" style="grid-template-columns:1fr">
            <div>
                <label class="lt-field-label">@Resources.Strings.LineaTiempo_LabelRango</label>
                <div class="rango-atajos" id="lnAtajos">
                    <div class="rango-atajos-grupo">
                        <button type="button" data-preset="todo">@Resources.Strings.Rango_Todo</button>
                    </div>
                    <div class="rango-atajos-grupo">
                        <button type="button" data-preset="ytd">@Resources.Strings.Rango_AnioEnCurso</button>
                        <button type="button" data-preset="6m">@Resources.Strings.Rango_Ultimos6Meses</button>
                        <button type="button" data-preset="3m">@Resources.Strings.Rango_UltimoTrimestre</button>
                        <button type="button" data-preset="mesAnterior">@Resources.Strings.Rango_MesAnterior</button>
                        <button type="button" data-preset="mesActual">@Resources.Strings.Rango_MesActual</button>
                    </div>
                </div>
                <div class="lt-range-card">
                    <div class="lt-range-head">
                        <span class="lbl"><span id="lnRangoDesdeLbl">&mdash;</span><i class="fas fa-long-arrow-alt-right"></i><span id="lnRangoHastaLbl">&mdash;</span></span>
                        <span class="lt-range-badge" id="lnRangoBadge">&mdash;</span>
                    </div>
                    <div class="lt-range-track disabled" id="lnRangoTrack">
                        <div class="bg"></div>
                        <div class="sel" id="lnRangoSel"></div>
                        <div class="knob from" id="lnKnobFrom" tabindex="0" role="slider" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" aria-label="@Resources.Strings.LineaTiempo_LabelRango"></div>
                        <div class="knob to" id="lnKnobTo" tabindex="0" role="slider" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" aria-label="@Resources.Strings.LineaTiempo_LabelRango"></div>
                    </div>
                    <div class="lt-range-years" id="lnRangoYears"></div>
                </div>
                <p class="lt-help">@Resources.Strings.LN_RangoHint</p>
                <p class="lt-help" id="lnSinMeses" style="display:none;">@Resources.Strings.LN_SinMesesDatos</p>
            </div>
        </div>

        @Html.Partial("_TemaInformeSelector", "lnTema")

        <div class="btn-group-actions">
            <button type="button" id="btnConsultarLN" class="btn btn-modern-gradient" disabled>
                <i class="fas fa-arrow-right mr-1"></i>@Resources.Strings.LineaTiempo_BtnGenerar
            </button>
            <button type="button" id="btnLimpiarLN" class="btn btn-modern-secondary">@Resources.Strings.Common_Limpiar</button>
        </div>
    </div>

    <div id="lnEstadoInicial" class="lt-card lt-empty">
        <div class="lt-empty-icon"><i class="fas fa-sitemap"></i></div>
        <h4>@Resources.Strings.LN_EstadoInicialTitulo</h4>
        <p>@Resources.Strings.LN_EstadoInicialDesc</p>
    </div>

    <div id="lnSinDatos" class="lt-card lt-empty" style="display:none;">
        <div class="lt-empty-icon"><i class="fas fa-inbox"></i></div>
        <h4>@Resources.Strings.LN_SinDatosTitulo</h4>
        <p>@Resources.Strings.LN_SinDatosDesc</p>
    </div>

    <div id="lnResultado" style="display:none;">

        <div class="lt-card" id="lnPanelResultado">
            <div class="pyg2-letterhead">
                <span class="pyg2-brand"><img class="bm-logo" src="~/Assets/img/Bufins_Wordmark_Purple.png" alt="Bufins" height="14"><span class="bm-sub">@Resources.Strings.LN_V2_Subtitulo</span></span>
                <span class="fecha"><span>@Resources.Strings.BAL_V2_GeneradoEl</span> <span id="lnFechaGenerado">&mdash;</span></span>
            </div>
            <div class="pyg2-head">
                <div class="pyg2-head-l">
                    <span class="emp-logo-plate" id="lnLogo" hidden><img alt="@Resources.Strings.Common_LogoEmpresaAlt"></span>
                    <div class="emp-logo-texto">
                        <h2 id="lnTituloEmpresa">&mdash;</h2>
                        <div class="pyg2-chips">
                            <span class="pyg2-chip primary"><i class="fas fa-calendar"></i><span id="lnChipPeriodo">&mdash;</span></span>
                            <span class="pyg2-chip" id="lnChipEscenario">&mdash;</span>
                            <span class="pyg2-chip" id="lnChipLineas">&mdash;</span>
                        </div>
                    </div>
                </div>
                <div class="pyg2-tools">
                    <button type="button" class="lt-tool-btn" id="lnBtnUnidad" aria-haspopup="menu" aria-expanded="false">
                        <span class="lbl-muted">@Resources.Strings.BAL_V2_Unidad</span><span id="lnUnidadLbl">@Resources.Strings.LineaTiempo_UnidadMillones</span><i class="fas fa-chevron-down chev"></i>
                    </button>
                    <div class="lt-menu" id="lnMenuUnidad" role="menu">
                        <button type="button" data-unidad="pesos" role="menuitemradio">@Resources.Strings.LineaTiempo_UnidadPesos<i class="fas fa-check"></i></button>
                        <button type="button" data-unidad="miles" role="menuitemradio">@Resources.Strings.LineaTiempo_UnidadMiles<i class="fas fa-check"></i></button>
                        <button type="button" data-unidad="millones" role="menuitemradio">@Resources.Strings.LineaTiempo_UnidadMillones<i class="fas fa-check"></i></button>
                    </div>
                    <span class="sep"></span>
                    @Html.Partial("_ExportMenu", new bufinscustomers.Models.ExportMenuVM { Id = "lnExp", ExcelDesc = Resources.Strings.LN_Exp_ExcelDesc })
                </div>
            </div>
        </div>
        <form id="frmExportarExcelLN" method="post" action="@Url.Action("ExportarExcel", "InformeLineasNegocio")">
            @Html.AntiForgeryToken()
            <div id="lnExpCampos"></div>
        </form>

        <div class="bal-cuadre-strip" id="lnCuadreStrip"></div>

        <div class="pyg2-section">
            <div class="pyg2-section-title"><span class="t">@Resources.Strings.LN_IndicadoresClave</span><span class="line"></span></div>
            <div class="pyg2-kpis" id="lnKpiStrip"></div>
        </div>

        <div class="pyg2-analysis">
            <div class="pyg2-card">
                <div class="pyg2-card-head">
                    <div>
                        <div class="pyg2-card-title">@Resources.Strings.LN_MezclaTitulo</div>
                        <div class="pyg2-card-sub" id="lnMezclaSub">&mdash;</div>
                    </div>
                    <span class="pyg2-legend" id="lnMezclaLeyenda"></span>
                </div>
                <div class="pyg2-waterfall-wrap"><canvas id="lnChartMezcla"></canvas></div>
            </div>
            <div class="pyg2-card" style="gap:12px">
                <div>
                    <div class="pyg2-card-title"><i class="fas fa-bolt"></i>@Resources.Strings.LN_RelevanteTitulo</div>
                    <div class="pyg2-card-sub">@Resources.Strings.LN_RelevanteSub</div>
                </div>
                <div class="pyg2-hl-list" id="lnHighlightsList"></div>
            </div>
        </div>

        <div class="pyg2-section">
            <div class="pyg2-section-title"><span class="t">@Resources.Strings.LN_MargenesTitulo</span><span class="line"></span>
                <span class="pyg2-legend" id="lnMargenesLeyenda"></span>
            </div>
            <div class="pyg2-card ln-margenes-card"><div class="ln-margenes-wrap"><canvas id="lnChartMargenes"></canvas></div></div>
        </div>

        <div class="pyg2-table-card">
            <div class="pyg2-card-head" style="align-items:center">
                <div>
                    <div class="pyg2-card-title">@Resources.Strings.LN_EstadoTitulo</div>
                    <div class="pyg2-card-sub" id="lnInfoBadge">&mdash;</div>
                </div>
            </div>
            <div class="pyg2-table-wrap">
                <table class="pyg2-table ln-matriz" id="lnTablaEstado"><thead id="lnEstadoHead"></thead><tbody id="lnEstadoBody"></tbody></table>
            </div>
        </div>

        <div class="pyg2-table-card" style="margin-top:14px">
            <div class="pyg2-card-head" style="align-items:center">
                <div>
                    <div class="pyg2-card-title">@Resources.Strings.LN_ResumenTitulo</div>
                    <div class="pyg2-card-sub" id="lnResumenSub">&mdash;</div>
                </div>
            </div>
            <div class="pyg2-table-wrap">
                <table class="pyg2-table" id="lnTablaResumen"><thead id="lnResumenHead"></thead><tbody id="lnResumenBody"></tbody></table>
            </div>
            <div class="pyg2-table-legend">
                <span><i class="dot" style="background:#16A34A"></i>@Resources.Strings.BAL_Favorable</span>
                <span><i class="dot" style="background:#DC2626"></i>@Resources.Strings.BAL_LeyendaDesfavorable</span>
            </div>
        </div>
        <p class="lt-help" id="lnNotaSinAnterior" style="display:none;">@Resources.Strings.LN_SinAnioAnteriorNota</p>
        <p class="lt-help">@Resources.Strings.LN_NotaMetodo</p>

        @Html.Partial("_ComentariosGestion", "lnComentarios")

        @if (bufinscustomers.Helpers.IAModuloHelper.Visible())
        {
        <div class="pyg-insights-card">
            <div class="pyg-insights-head">
                <div>
                    <span class="pyg-insights-title"><i class="fas fa-wand-magic-sparkles"></i>@Resources.Strings.LN_InsightsTitulo</span>
                    <div class="pyg-insights-meta" id="lnInsightsMeta">@Resources.Strings.LN_InsightsSub</div>
                </div>
                <button type="button" id="btnGenerarInsightsLN" class="pyg2-ins-btn"><i class="fas fa-wand-magic-sparkles"></i><span>@Resources.Strings.BAL_Generar</span></button>
            </div>
            <div id="lnInsightsBody"></div>
            <div id="lnInsightsLoading" style="display:none;text-align:center;padding:14px 0;">
                @Html.Partial("_LoaderDots", "dark")
                <p style="margin-top:8px;font-size:12.5px;color:#8B85A0;">@Resources.Strings.BAL_Analizando</p>
            </div>
            <div class="mt-3">
                <label for="lnPregunta" class="mb-1" style="font-weight:700;"><i class="fas fa-comments mr-1"></i>@Resources.Strings.IAInforme_Titulo</label>
                <div class="d-flex" style="gap:8px;flex-wrap:wrap;">
                    <input type="text" id="lnPregunta" class="form-control" maxlength="@bufinscustomers.Helpers.IAModuloHelper.MaxCharsPregunta()" style="flex:1;min-width:240px;"
                           placeholder="@Resources.Strings.IAInforme_Placeholder" />
                    <button type="button" id="btnLnPreguntar" class="pyg2-ins-btn"><i class="fas fa-paper-plane"></i><span>@Resources.Strings.IAInforme_Btn</span></button>
                </div>
                <div id="lnRespuesta" class="mt-2"></div>
            </div>
        </div>
        }
    </div>

</div>
</div>

<div id="overlayConsultandoLN" class="overlay-cargando" style="display:none;">
    <div class="overlay-cargando-card">
        @Html.Partial("_LoaderDots", "aqua")
        <h5 class="overlay-cargando-title">@Resources.Strings.BAL_JS_Consultando</h5>
    </div>
</div>

@Html.Partial("_ExportCorreoModal", new bufinscustomers.Models.ExportCorreoVM())
@Html.Partial("_DocumentacionVisor", Resources.Strings.LN_Doc_ModalTitulo)

@section scripts {
<script src="~/Assets/js/select2/select2.min.js"></script>
<script src="~/Assets/js/chart.umd.min.js"></script>
<script src="~/Assets/js/jspdf.umd.min.js"></script>
<script src="~/Assets/js/bufins-pdf-marca.js"></script>
<script src="~/Assets/js/html2canvas.min.js"></script>
<script src="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/js/empresa-logo.js")"></script>
<script src="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/js/informe-tema.js")"></script>
<script src="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/js/comentarios-gestion.js")"></script>
<script src="~/Assets/js/export-menu.js"></script>
<script src="~/Assets/js/doc-visor.js"></script>
<script src="~/Assets/js/bufins-markdown.js"></script>
<script src="~/Assets/js/rango-atajos.js"></script>

<script>
    var EXP_T = {
        generando: '@Html.Raw(J(Resources.Strings.Common_Exp_Generando))',
        errorGenerar: '@Html.Raw(J(Resources.Strings.Common_Exp_ErrorGenerar))',
        listo: '@Html.Raw(J(Resources.Strings.Common_Exp_Listo))',
        imagenCopiada: '@Html.Raw(J(Resources.Strings.Common_Exp_ImagenCopiada))',
        imagenDescargada: '@Html.Raw(J(Resources.Strings.Common_Exp_ImagenDescargada))',
        valDestino: '@Html.Raw(J(Resources.Strings.RevisarCargue_Correo_ValDestino))',
        valMaximo: '@Html.Raw(J(Resources.Strings.RevisarCargue_Correo_ValMaximo))',
        enviando: '@Html.Raw(J(Resources.Strings.RevisarCargue_Correo_Enviando))',
        error: '@Html.Raw(J(Resources.Strings.Common_ExpCorreo_Error))',
