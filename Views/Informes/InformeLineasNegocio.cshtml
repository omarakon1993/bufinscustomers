    }
    function indiceDesdeXLN(clientX) {
        var rect = document.getElementById('lnRangoTrack').getBoundingClientRect();
        return Math.round(Math.min(1, Math.max(0, (clientX - rect.left) / rect.width)) * (_ln.rango.length - 1));
    }
    function moverExtremoLN(cual, idx) {
        idx = Math.min(_ln.rango.length - 1, Math.max(0, idx));
        if (cual === 'from') { _ln.iDesde = idx; if (_ln.iDesde > _ln.iHasta) _ln.iHasta = _ln.iDesde; }
        else { _ln.iHasta = idx; if (_ln.iHasta < _ln.iDesde) _ln.iDesde = _ln.iHasta; }
        pintarRangoLN();
    }
    function arrastreLN(e, cual) {
        if (_ln.rango.length < 2) return;
        e.preventDefault();
        var track = $('#lnRangoTrack').addClass('dragging');
        function onMove(ev) { moverExtremoLN(cual, indiceDesdeXLN(ev.clientX)); }
        function onUp() { track.removeClass('dragging'); window.removeEventListener('pointermove', onMove); window.removeEventListener('pointerup', onUp); }
        window.addEventListener('pointermove', onMove); window.addEventListener('pointerup', onUp);
    }
    function clicPistaLN(e) {
        if ($(e.target).hasClass('knob') || _ln.rango.length < 2) return;
        var idx = indiceDesdeXLN(e.clientX);
        var cual = Math.abs(idx - _ln.iDesde) <= Math.abs(idx - _ln.iHasta) ? 'from' : 'to';
        moverExtremoLN(cual, idx); arrastreLN(e, cual);
    }
    function tecladoKnobLN(e, cual) {
        var n = _ln.rango.length; if (n < 2) return;
        var idx = cual === 'from' ? _ln.iDesde : _ln.iHasta;
        if (e.key === 'ArrowLeft') idx -= 1; else if (e.key === 'ArrowRight') idx += 1; else if (e.key === 'Home') idx = 0; else if (e.key === 'End') idx = n - 1; else return;
        e.preventDefault(); moverExtremoLN(cual, idx);
    }

    // ===== Consulta =====
    function etiquetaPeriodo(r) {
        var d = _ln.mesesNombres[r.MesDesde - 1] + ' ' + r.AnioDesde, h = _ln.mesesNombres[r.MesHasta - 1] + ' ' + r.AnioHasta;
