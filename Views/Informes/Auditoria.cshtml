@using bufinscustomers.Models
@using System.Linq
@{
    ViewBag.Title = Resources.Strings.Audit_PageTitle;
    if ((bool)(ViewBag.Embed ?? false)) { Layout = "~/Views/Shared/_LayoutFragment.cshtml"; }
    var tipos = ViewBag.Tipos as System.Collections.Generic.List<string> ?? new System.Collections.Generic.List<string>();
    var empresas = ViewBag.Empresas as System.Collections.Generic.List<Empresas> ?? new System.Collections.Generic.List<Empresas>();
    var esSuper = (bool)(ViewBag.EsSuperAdmin ?? false);
}

<link href="~/Assets/css/bufins-components.css" rel="stylesheet" />

<style>
    /* Modal "Detalle de auditoría" (dentro de SweetAlert, tema oscuro) */
    .aud-dt { text-align: left; color: #ECEAF6; }
    .aud-dt-fecha { font-size: 1rem; font-weight: 600; margin-bottom: .55rem; letter-spacing: .01em; }
    .aud-dt-chips { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: .7rem; }
    .aud-dt-chip {
        font: 600 .72rem/1 "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
        letter-spacing: .03em; padding: .34em .58em; border-radius: 5px;
        border: 1px solid rgba(255,255,255,.16); background: rgba(255,255,255,.05); white-space: nowrap;
    }
    .aud-dt-chip.tipo { color: #c3bcff; border-color: rgba(139,125,255,.55); background: rgba(139,125,255,.15); }
    .aud-dt-desc { font-size: .9rem; line-height: 1.55; opacity: .92; margin: 0 0 .55rem; }
    .aud-dt-meta {
        display: flex; flex-wrap: wrap; gap: .3rem 1.15rem; font-size: .78rem; opacity: .6;
        padding-top: .6rem; border-top: 1px solid rgba(255,255,255,.1);
    }
    .aud-dt-meta b { font-weight: 600; opacity: .85; }
    .aud-dt-block { margin-top: 1.05rem; }
    .aud-dt-block-hdr { display: flex; align-items: center; justify-content: space-between; margin-bottom: .35rem; }
    .aud-dt-block-lbl {
        font: 600 .68rem/1 "IBM Plex Mono", monospace; letter-spacing: .1em; text-transform: uppercase; opacity: .62;
    }
    .aud-dt-copy {
        font: 600 .64rem/1 "IBM Plex Mono", monospace; letter-spacing: .06em; text-transform: uppercase;
        background: transparent; border: 1px solid rgba(255,255,255,.22); color: inherit;
        border-radius: 5px; padding: .32em .55em; cursor: pointer; opacity: .7; transition: opacity .15s, border-color .15s;
    }
    .aud-dt-copy:hover { opacity: 1; border-color: rgba(255,255,255,.45); }
    .aud-dt-pre {
        margin: 0; padding: 12px 14px; border-radius: 9px; color: #EDEBFA;
        background: rgba(0,0,0,.34); border: 1px solid rgba(255,255,255,.12);
        font: 400 .78rem/1.55 "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
        white-space: pre-wrap; word-break: break-word; max-height: 38vh; overflow: auto;
    }
    .aud-dt-pre .j-key { color: #b0a8ff; }
    .aud-dt-pre .j-str { color: #7ee0b0; }
    .aud-dt-pre .j-num { color: #f2b45f; }
    .aud-dt-pre .j-kw  { color: #ff8f8a; }

    /* Modal "Limpiar auditoría" (dentro de SweetAlert, tema oscuro) — mismo estilo que Auditoría IA */
    .aud-limp-wrap { text-align:left; }
    .aud-limp-desc {
        font-size:.85rem; line-height:1.5; color:#9ca3af;
        margin:0 0 16px; padding-bottom:12px; border-bottom:1px solid rgba(255,255,255,.12);
    }
    .aud-limp-opt {
        display:flex; align-items:flex-start; gap:10px;
        padding:12px 14px; margin-bottom:10px;
        border:1.5px solid rgba(255,255,255,.16); border-radius:10px;
        cursor:pointer; transition:border-color .15s, background .15s;
    }
    .aud-limp-opt:last-child { margin-bottom:0; }
    .aud-limp-opt:hover { border-color:rgba(139,125,255,.7); }
    .aud-limp-opt.is-active { border-color:#8b7dff; background:rgba(88,58,255,.16); }
    .aud-limp-opt > input[type=radio] { margin:3px 0 0; accent-color:#8b7dff; flex:0 0 auto; }
    .aud-limp-opt-body { flex:1; min-width:0; }
    .aud-limp-opt-title { display:block; font-weight:600; font-size:.92rem; color:#f3f4f6; }
    .aud-limp-opt-hint  { display:block; font-size:.78rem; color:#9ca3af; margin-top:3px; }
    .aud-limp-meses-row { display:flex; align-items:center; gap:8px; margin-top:10px; }
    .aud-limp-meses-row label { margin:0; font-size:.8rem; color:#cbd5e1; }
    .aud-limp-meses-input {
        width:88px; padding:6px 10px; font-size:.9rem; text-align:center;
        border:1.5px solid rgba(255,255,255,.25); border-radius:8px;
        background:rgba(255,255,255,.06); color:#f3f4f6;
    }
    .aud-limp-meses-input:focus { outline:none; border-color:#8b7dff; }
    .aud-limp-meses-input:disabled { opacity:.4; cursor:not-allowed; }
    .aud-limp-sep { margin:14px 0 10px; font-size:.72rem; font-weight:700; letter-spacing:.06em;
        text-transform:uppercase; color:#9ca3af; }
    .aud-limp-emp-select {
        margin-top:8px; width:100%; padding:7px 10px; font-size:.88rem;
        border:1.5px solid rgba(255,255,255,.25); border-radius:8px;
        background:rgba(255,255,255,.06); color:#f3f4f6;
    }
    .aud-limp-emp-select:focus { outline:none; border-color:#8b7dff; }
    .aud-limp-emp-select:disabled { opacity:.4; cursor:not-allowed; }

    /* ---- Fase 2/3: severidad, diff, historial por entidad, línea de tiempo ---- */
    .sev-dot { display:inline-block; width:9px; height:9px; border-radius:50%; margin-right:.45rem; vertical-align:middle; }
    .sev-Info { background:#3b82f6; } .sev-Advertencia { background:#f59e0b; } .sev-Critico { background:#ef4444; }
    tr.row-Critico > td:first-child { box-shadow: inset 3px 0 0 #ef4444; }
    tr.row-Advertencia > td:first-child { box-shadow: inset 3px 0 0 #f59e0b; }
    .ent-nombre { font-weight:600; } .ent-ruta { font-size:.74rem; color:#8890a0; }
    .btn-hist { border:1px solid #d1d5db; background:#fff; color:#6b7280; border-radius:6px; padding:.12rem .4rem; cursor:pointer; font-size:.78rem; margin-left:.35rem; }
    .btn-hist:hover { border-color:#8b7dff; color:#583AFF; }

    .aud-chips { display:flex; flex-wrap:wrap; gap:.5rem; margin-bottom:.75rem; }
    .aud-chip { display:inline-flex; align-items:center; gap:.5rem; padding:.3rem .7rem; background:#eef2ff; border:1px solid #c7d2fe; border-radius:999px; font-size:.8rem; color:#4338ca; }
    .aud-chip button { background:none; border:none; color:inherit; cursor:pointer; font-size:1rem; line-height:1; padding:0; }

    .view-toggle { display:inline-flex; border:1px solid #e3e6eb; border-radius:8px; overflow:hidden; }
    .view-toggle button { background:#fff; border:none; padding:.35rem .8rem; font-size:.8rem; color:#556074; cursor:pointer; }
    .view-toggle button.is-active { background:linear-gradient(90deg,#6366F1,#3B82F6,#06B6D4); color:#fff; }

    .aud-tl { list-style:none; margin:0; padding:4px 2px; }
    .aud-tl li { display:flex; gap:.8rem; padding:.7rem .2rem; border-bottom:1px solid #eef0f4; }
    .aud-tl li:last-child { border-bottom:0; }
    .aud-tl .tl-dot { flex:0 0 auto; width:10px; height:10px; border-radius:50%; margin-top:.4rem; }
    .aud-tl .tl-body { flex:1; min-width:0; font-size:.9rem; line-height:1.5; }
    .aud-tl .tl-meta { font-size:.76rem; color:#8890a0; margin-top:.15rem; }
    .aud-tl-ver { background:none; border:none; color:#583AFF; cursor:pointer; font-size:.78rem; padding:0; margin-left:.4rem; }

    .aud-diff { margin-top:1.05rem; }
    .aud-diff-lbl { font:600 .68rem/1 "IBM Plex Mono", monospace; letter-spacing:.1em; text-transform:uppercase; opacity:.62; margin-bottom:.5rem; }
    .aud-diff-tbl { width:100%; border-collapse:collapse; font-size:.8rem; }
    .aud-diff-tbl td { padding:.35rem .55rem; border-bottom:1px solid rgba(255,255,255,.07); vertical-align:top; word-break:break-word; }
    .aud-diff-tbl td.k { font-family:"IBM Plex Mono", monospace; color:#b0a8ff; white-space:nowrap; }
    .aud-diff-old { color:#ff9d97; text-decoration:line-through; opacity:.85; }
    .aud-diff-arrow { opacity:.5; margin:0 .35rem; }
    .aud-diff-new { color:#7ee0b0; }
    .aud-diff-none { font-size:.82rem; opacity:.6; font-style:italic; }
    details.aud-raw > summary { cursor:pointer; font:600 .66rem/1 "IBM Plex Mono", monospace; letter-spacing:.08em; text-transform:uppercase; opacity:.5; margin-top:1rem; list-style:revert; }
</style>

<div class="container-fluid px-4">

    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas fa-shield-alt powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@Resources.Strings.Audit_HeaderTitle</h1>
        </div>
    </div>

    @if (!esSuper)
    {
        <div class="alert alert-info d-flex align-items-center" role="alert" style="border-left:4px solid #583AFF;">
            <i class="fas fa-info-circle mr-2"></i>@Resources.Strings.Audit_AlcanceEmpresa
        </div>
    }

    <div class="filter-card">
        <h3 class="filter-card-title"><i class="fas fa-filter"></i> @Resources.Strings.Common_FiltrosConsulta</h3>
        <div class="filter-section">
            <div class="row">
                @if (esSuper)
                {
                    <div class="col-md-3">
                        <div class="form-group">
                            <label><i class="fas fa-tag mr-1"></i>@Resources.Strings.Audit_LabelTipo</label>
                            <select id="fTipo" class="form-control">
                                <option value="">@Resources.Strings.Common_Todos</option>
                                @foreach (var t in tipos)
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </div>
                    </div>
                }
                <div class="col-md-3">
                    <div class="form-group">
                        <label><i class="fas fa-bolt mr-1"></i>@Resources.Strings.Audit_LabelAccion</label>
                        <select id="fAccion" class="form-control">
                            <option value="">@Resources.Strings.Common_Todos</option>
                            @if (esSuper)
                            {
                                <option value="Crear">@Resources.Strings.Audit_Acc_Crear</option>
                                <option value="Editar">@Resources.Strings.Audit_Acc_Editar</option>
                                <option value="Eliminar">@Resources.Strings.Audit_Acc_Eliminar</option>
                                <option value="Asignar">@Resources.Strings.Audit_Acc_Asignar</option>
                            }
                            <option value="Login">@Resources.Strings.Audit_Acc_Login</option>
                            <option value="LoginFallido">@Resources.Strings.Audit_Acc_LoginFallido</option>
                            <option value="Bloqueo">@Resources.Strings.Audit_Acc_Bloqueo</option>
                        </select>
                    </div>
                </div>
                @if (esSuper)
                {
                    <div class="col-md-3">
                        <div class="form-group">
                            <label><i class="fas fa-signal mr-1"></i>@Resources.Strings.Audit_LabelSeveridad</label>
                            <select id="fSeveridad" class="form-control">
                                <option value="">@Resources.Strings.Common_Todos</option>
                                <option value="Critico">@Resources.Strings.Audit_Sev_Critico</option>
                                <option value="Advertencia">@Resources.Strings.Audit_Sev_Advertencia</option>
                                <option value="Info">@Resources.Strings.Audit_Sev_Info</option>
                            </select>
                        </div>
                    </div>
                }
                <div class="col-md-3">
                    <div class="form-group">
                        <label><i class="fas fa-building mr-1"></i>@Resources.Strings.Audit_LabelEmpresa</label>
                        <select id="fEmpresa" class="form-control">
                            <option value="">@Resources.Strings.Common_Todos</option>
                            @foreach (var e in empresas)
                            {
                                <option value="@e.Id">@e.Nombre</option>
                            }
                        </select>
                    </div>
                </div>
                @if (esSuper)
                {
                    <div class="col-md-3">
                        <div class="form-group">
                            <label><i class="fas fa-cube mr-1"></i>@Resources.Strings.Audit_LabelEntidad</label>
                            <input type="text" id="fEntidad" class="form-control" placeholder="Empresas, MenuOpciones…" />
                        </div>
                    </div>
                }
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label><i class="fas fa-calendar mr-1"></i>@Resources.Strings.Audit_LabelDesde</label>
                        <input type="date" id="fDesde" class="form-control" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label><i class="fas fa-calendar mr-1"></i>@Resources.Strings.Audit_LabelHasta</label>
                        <input type="date" id="fHasta" class="form-control" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label><i class="fas fa-search mr-1"></i>@Resources.Strings.Audit_LabelBuscar</label>
                        <input type="text" id="fTexto" class="form-control" placeholder="@Resources.Strings.Audit_BuscarPlaceholder" />
                    </div>
                </div>
            </div>
            <div class="btn-group-actions">
                <button type="button" id="btnConsultar" class="btn btn-modern-gradient">
                    <i class="fas fa-search mr-1"></i>@Resources.Strings.Common_Consultar
                </button>
                <button type="button" id="btnLimpiar" class="btn btn-modern-secondary">
                    <i class="fas fa-eraser mr-2"></i>@Resources.Strings.Common_Limpiar
                </button>
                <button type="button" id="btnExportar" class="btn btn-modern-excel">
                    <i class="fas fa-file-excel mr-1"></i>@Resources.Strings.Audit_BtnExportar
                </button>
                <button type="button" id="btnImprimir" class="btn btn-modern-secondary">
                    <i class="fas fa-print mr-1"></i>@Resources.Strings.Audit_BtnImprimir
                </button>
                @if (esSuper)
                {
                    <button type="button" id="btnLimpiarAuditoria" class="btn btn-danger ml-auto">
                        <i class="fas fa-trash-alt mr-1"></i>@Resources.Strings.Audit_BtnLimpiarAuditoria
                    </button>
                }
            </div>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <div id="chipsFiltro" class="aud-chips" style="display:none;"></div>

    <div id="resultadosContainer" style="display:none;">
        <div class="table-container">
            <div class="table-header">
                <h5><i class="fas fa-list mr-2"></i>@Resources.Strings.Common_Resultados</h5>
                <div class="d-flex align-items-center" style="gap:.6rem;flex-wrap:wrap;">
                    <span id="totalBadge" class="info-badge">0 @Resources.Strings.Audit_TotalRegistros</span>
                    <span id="paginaInfo" style="font-size:.77rem;color:#6c757d;"></span>
                    <span class="view-toggle" role="group">
                        <button type="button" id="vwTabla" class="is-active"><i class="fas fa-table mr-1"></i>@Resources.Strings.Audit_VistaTabla</button>
                        <button type="button" id="vwTimeline"><i class="fas fa-stream mr-1"></i>@Resources.Strings.Audit_VistaTimeline</button>
                    </span>
                </div>
            </div>
            <div id="vistaTabla" class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th style="width:150px;">@Resources.Strings.Audit_ThFecha</th>
                            <th style="width:120px;">@Resources.Strings.Audit_ThTipo</th>
                            <th style="width:110px;">@Resources.Strings.Audit_ThAccion</th>
                            <th style="width:170px;">@Resources.Strings.Audit_ThEntidad</th>
                            <th>@Resources.Strings.Audit_ThDescripcion</th>
                            <th style="width:150px;">@Resources.Strings.Audit_ThUsuario</th>
                            <th style="width:120px;">@Resources.Strings.Audit_ThEmpresa</th>
                            <th style="width:110px;">@Resources.Strings.Audit_ThIp</th>
                            <th style="width:70px;" class="text-center">@Resources.Strings.Audit_ThDetalle</th>
                        </tr>
                    </thead>
                    <tbody id="tbody"></tbody>
                </table>
            </div>
            <ul id="vistaTimeline" class="aud-tl" style="display:none;"></ul>
            <div id="paginacion" class="pagination-controls"></div>
        </div>
    </div>

    <div id="sinResultados" class="no-data-message" style="display:none;">
        <i class="fas fa-shield-alt"></i>
        <h4>@Resources.Strings.Audit_SinResultados</h4>
        <p>@Resources.Strings.Audit_SinResultadosDesc</p>
    </div>

</div>

@section scripts {
<script>
$(function () {
    var PAGE_SIZE = 25;
    var _pagina = 1;

    var S = {
        error:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_JS_Error))',
        total:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_TotalRegistros))',
        mostrando: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Mostrando))',
        de:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_De))',
        errTit:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Error))',
        exitoTit:'@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Exito))',
        modal:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_ModalTitulo))',
        vAnt:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_ValorAnterior))',
        vNue:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_ValorNuevo))',
        mUsuario: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_ThUsuario))',
        mEmpresa: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_ThEmpresa))',
        mIp:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_ThIp))',
        copiar:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Copiar))',
        copiado:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Copiado))',
        sevInfo:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Sev_Info))',
        sevAdv:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Sev_Advertencia))',
        sevCrit:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Sev_Critico))',
        diffTit:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_DiffTitulo))',
        diffSin:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_DiffSinCambios))',
        rawJson:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_VerJsonCrudo))',
        histDe:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_HistorialDe))',
        histTip:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_HistorialTooltip))',
        opLabel:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Operacion))',
        opVer:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_VerOperacion))',
        verDet:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_ThDetalle))',
        refLbl:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_LabelEntidad))'
    };
    var SEV = { Info: S.sevInfo, Advertencia: S.sevAdv, Critico: S.sevCrit };
    var ACC = {
        Crear:        '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Acc_Crear))',
        Editar:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Acc_Editar))',
        Eliminar:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Acc_Eliminar))',
        Asignar:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Acc_Asignar))',
        Login:        '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Acc_Login))',
        LoginFallido: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Acc_LoginFallido))',
        Bloqueo:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Acc_Bloqueo))'
    };

    @if (esSuper)
    {
        <text>
    var _empresasLimp = [
        @Html.Raw(string.Join(",", empresas.Select(e =>
            "{id:" + e.Id + ",n:'" + HttpUtility.JavaScriptStringEncode(e.Nombre ?? "") + "'}")))
    ];
    var _limp = {
        titulo:              '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_LimpiarTitulo))',
        desc:                '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_LimpiarDesc))',
        opcionTodo:          '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_LimpiarOpcionTodo))',
        opcionTodoHint:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_LimpiarOpcionTodoHint))',
        opcionConservar:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_LimpiarOpcionConservar))',
        opcionConservarHint: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_LimpiarOpcionConservarHint))',
        mesesLabel:          '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_LimpiarMesesLabel))',
        alcanceTodas:        '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_LimpiarAlcanceTodas))',
        alcanceUna:          '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_LimpiarAlcanceUna))',
        alcanceUnaHint:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_LimpiarAlcanceUnaHint))',
        confirmarBtn:        '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_LimpiarConfirmarBtn))',
        cancelarBtn:         '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_LimpiarCancelarBtn))',
        mesesInvalido:       '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_LimpiarMesesInvalido))',
        empresaInvalida:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_LimpiarEmpresaInvalida))',
        confirmTodo:         '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_LimpiarConfirmTodo))',
        confirmConservar:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_LimpiarConfirmConservar))',
        scopeEmpresa:        '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_LimpiarConfirmScopeEmpresa))',
        exito:               '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_LimpiarExito))',
        errorMsg:            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_LimpiarError))'
    };
        </text>
    }

    function esc(s) { return $('<div>').text(s == null ? '' : s).html(); }
    function accionLabel(a) { return ACC[a] || a || ''; }
    function sevLabel(s) { return SEV[s] || s || ''; }

    var _vista = 'tabla';          // 'tabla' | 'timeline'
    var _ultimos = [];             // últimos items para re-render al cambiar de vista
    var _histEnt = null;           // { entidad, entidadId } filtro "historial de un registro"
    var _opId = null;              // operacionId filtro "ver operación completa"

    function paramsFiltro() {
        return {
            tipo:       $('#fTipo').val(),
            accion:     $('#fAccion').val(),
            severidad:  $('#fSeveridad').val() || '',
            idEmpresa:  $('#fEmpresa').val() || '',
            entidad:    _histEnt ? _histEnt.entidad : $('#fEntidad').val(),
            entidadId:  _histEnt ? _histEnt.entidadId : '',
            operacionId:_opId || '',
            texto:      $('#fTexto').val(),
            desde:      $('#fDesde').val(),
            hasta:      $('#fHasta').val()
        };
    }

    function consultar(pagina) {
        _pagina = pagina || 1;
        var p = paramsFiltro();
        p.pagina = _pagina; p.tam = PAGE_SIZE;
        $.getJSON('@Url.Action("Consultar", "Auditoria")', p).done(render).fail(function () {
            Swal.fire({ icon: 'error', title: S.errTit, text: S.error });
        });
    }

    function pintarChips() {
        var $c = $('#chipsFiltro').empty();
        if (_histEnt) {
            $c.append(
                $('<span class="aud-chip">').append(
                    document.createTextNode(S.histDe + ' ' + _histEnt.entidad + ' #' + _histEnt.entidadId + '  '),
                    $('<button title="x">').html('&times;').on('click', function () { _histEnt = null; pintarChips(); consultar(1); })
                )
            );
        }
        if (_opId) {
            $c.append(
                $('<span class="aud-chip">').append(
                    document.createTextNode(S.opLabel + '  '),
                    $('<button title="x">').html('&times;').on('click', function () { _opId = null; pintarChips(); consultar(1); })
                )
            );
        }
        $c.toggle(!!(_histEnt || _opId));
    }

    function render(r) {
        if (!r || !r.success) { Swal.fire({ icon: 'error', title: S.errTit, text: S.error }); return; }

        $('#totalBadge').text(r.total.toLocaleString() + ' ' + S.total);
        _ultimos = r.items || [];
        _paginaActual = r.pagina; _totalPaginas = r.totalPaginas;

        if (!_ultimos.length) {
            $('#tbody').empty(); $('#vistaTimeline').empty();
            $('#paginaInfo').text('');
            $('#paginacion').empty();
            $('#resultadosContainer').hide();
            $('#sinResultados').show();
            return;
        }

        var ini = (r.pagina - 1) * PAGE_SIZE + 1;
        var fin = Math.min(r.pagina * PAGE_SIZE, r.total);
        $('#paginaInfo').text(S.mostrando + ' ' + ini + '–' + fin + ' ' + S.de + ' ' + r.total.toLocaleString());
        $('#sinResultados').hide();
        $('#resultadosContainer').show();

        pintarVista();
        renderPaginacion(r.pagina, r.totalPaginas);
    }

    var _paginaActual = 1, _totalPaginas = 1;

    function pintarVista() {
        $('#vwTabla').toggleClass('is-active', _vista === 'tabla');
        $('#vwTimeline').toggleClass('is-active', _vista === 'timeline');
        $('#vistaTabla').toggle(_vista === 'tabla');
        $('#vistaTimeline').toggle(_vista === 'timeline');
        if (_vista === 'tabla') renderTabla(_ultimos); else renderTimeline(_ultimos);
    }

    function entidadCelda(a) {
        var nombre = a.EntidadNombre || a.Entidad || '';
        var ruta   = (a.Entidad || '') + (a.EntidadId ? ' #' + a.EntidadId : '');
        var $td = $('<td>');
        $td.append($('<span class="ent-nombre">').text(nombre));
        if (nombre !== ruta && ruta) $td.append($('<div class="ent-ruta">').text(ruta));
        if (a.EntidadId) {
            $('<button class="btn-hist" title="' + esc(S.histTip) + '">')
                .html('<i class="fas fa-history"></i>')
                .on('click', function () {
                    _histEnt = { entidad: a.Entidad, entidadId: a.EntidadId };
                    _opId = null; pintarChips(); consultar(1);
                }).appendTo($td);
        }
        return $td;
    }

    function renderTabla(items) {
        var tbody = $('#tbody').empty();
        items.forEach(function (a) {
            var tr = $('<tr class="row-' + (a.Severidad || 'Info') + '">');
            tr.append($('<td>').css('white-space', 'nowrap')
                .html('<span class="sev-dot sev-' + (a.Severidad || 'Info') + '" title="' + esc(sevLabel(a.Severidad)) + '"></span>' + esc(a.Fecha)));
            tr.append($('<td>').html('<span class="badge badge-info">' + esc(a.Tipo) + '</span>'));
            tr.append($('<td>').text(accionLabel(a.Accion)));
            tr.append(entidadCelda(a));
            tr.append($('<td>').text(a.Descripcion || ''));
            tr.append($('<td>').text(a.NombreUsuario || ''));
            tr.append($('<td>').text(a.Empresa || ''));
            tr.append($('<td>').css('font-family', 'monospace').text(a.IpAddress || ''));

            var celdaVer = $('<td class="text-center">');
            if (a.TieneDetalle) {
                $('<button class="btn btn-sm btn-primary">')
                    .html('<i class="fas fa-eye"></i>')
                    .on('click', function () { verDetalle(a.Id); })
                    .appendTo(celdaVer);
            } else {
                celdaVer.html('<span class="text-muted">—</span>');
            }
            tr.append(celdaVer);
            tbody.append(tr);
        });
    }

    function renderTimeline(items) {
        var $ul = $('#vistaTimeline').empty();
        items.forEach(function (a) {
            var nombre = a.EntidadNombre || a.Entidad || '';
            var $li = $('<li>');
            $li.append($('<span class="tl-dot sev-' + (a.Severidad || 'Info') + '">'));
            var $body = $('<div class="tl-body">');
            $body.append(
                $('<span>').append(
                    $('<b>').text(a.NombreUsuario || '—'),
                    document.createTextNode(' · ' + accionLabel(a.Accion) + ' '),
                    $('<b>').text(nombre)
                )
            );
            if (a.Descripcion) $body.append($('<div>').css({ fontSize: '.85rem', opacity: .85 }).text(a.Descripcion));
            var meta = a.Fecha + '  ·  ' + a.Tipo + (a.Empresa ? '  ·  ' + a.Empresa : '');
            var $meta = $('<div class="tl-meta">').text(meta);
            if (a.TieneDetalle) {
                $('<button class="aud-tl-ver">').text(S.verDet).on('click', function () { verDetalle(a.Id); }).appendTo($meta);
            }
            $body.append($meta);
            $li.append($body);
            $ul.append($li);
        });
    }

    function renderPaginacion(actual, totalPags) {
        var $p = $('#paginacion').empty();
        if (totalPags <= 1) return;

        function btn(label, dest, disabled, activo) {
            return $('<button>')
                .addClass('btn-pagination' + (activo ? ' active' : ''))
                .prop('disabled', !!disabled)
                .html(label)
                .on('click', function () { consultar(dest); });
        }

        $p.append(btn('<i class="fas fa-chevron-left"></i>', actual - 1, actual === 1));

        var desde = Math.max(1, actual - 2);
        var hasta = Math.min(totalPags, actual + 2);
        if (desde > 1) {
            $p.append(btn('1', 1, false, false));
            if (desde > 2) $p.append($('<span class="pagination-dots">').text('…'));
        }
        for (var i = desde; i <= hasta; i++) $p.append(btn(i, i, false, i === actual));
        if (hasta < totalPags) {
            if (hasta < totalPags - 1) $p.append($('<span class="pagination-dots">').text('…'));
            $p.append(btn(totalPags, totalPags, false, false));
        }
        $p.append(btn('<i class="fas fa-chevron-right"></i>', actual + 1, actual === totalPags));
    }

    function dtChip(txt, cls) {
        return txt ? '<span class="aud-dt-chip ' + (cls || '') + '">' + esc(txt) + '</span>' : '';
    }
    // Colorea un JSON YA escapado (entidades HTML) para el <pre> del modal.
    function jsonHighlight(s) {
        return s.replace(
            /("(?:\\.|[^"\\])*")(\s*:)?|\b(true|false|null)\b|(-?\d+(?:\.\d+)?(?:[eE][+\-]?\d+)?)/g,
            function (m, str, colon, kw, num) {
                if (str) return '<span class="' + (colon ? 'j-key' : 'j-str') + '">' + str + '</span>' + (colon || '');
                if (kw)  return '<span class="j-kw">' + kw + '</span>';
                if (num) return '<span class="j-num">' + num + '</span>';
                return m;
            }
        );
    }
    function dtMeta(lbl, val) {
        return val ? '<span><b>' + esc(lbl) + ':</b> ' + esc(val) + '</span>' : '';
    }
    function bloque(titulo, contenido) {
        if (!contenido) return '';
        var pid = 'audjson_' + Math.random().toString(36).slice(2);
        return '<div class="aud-dt-block">'
             + '<div class="aud-dt-block-hdr">'
             +   '<span class="aud-dt-block-lbl">' + esc(titulo) + '</span>'
             +   '<button type="button" class="aud-dt-copy" data-target="' + pid + '">' + esc(S.copiar) + '</button>'
             + '</div>'
             + '<pre class="aud-dt-pre" id="' + pid + '">' + jsonHighlight(esc(contenido)) + '</pre>'
             + '</div>';
    }

    function parseSafe(s) { try { return s ? JSON.parse(s) : null; } catch (e) { return undefined; } }
    function fmtVal(v) {
        if (v === null) return '∅';
        if (v === undefined) return '';
        if (typeof v === 'object') { try { return JSON.stringify(v); } catch (e) { return String(v); } }
        return String(v);
    }

    // Diff campo a campo entre dos objetos JSON. Devuelve null si no se puede (no son objetos).
    function renderDiff(antStr, nueStr) {
        var a = parseSafe(antStr), n = parseSafe(nueStr);
        if (a === undefined || n === undefined) return '';
        var esObj = function (x) { return x && typeof x === 'object' && !Array.isArray(x); };
        var ao = esObj(a) ? a : (a == null ? {} : null);
        var no = esObj(n) ? n : (n == null ? {} : null);
        if (ao === null || no === null) return '';        // valores no-objeto: se deja el JSON crudo

        var keys = {}; Object.keys(ao).forEach(function (k) { keys[k] = 1; }); Object.keys(no).forEach(function (k) { keys[k] = 1; });
        var filas = '';
        Object.keys(keys).sort().forEach(function (k) {
            var av = ao[k], nv = no[k];
            if (JSON.stringify(av) === JSON.stringify(nv)) return;
            var cell;
            if (!(k in ao))      cell = '<span class="aud-diff-new">' + esc(fmtVal(nv)) + '</span>';
            else if (!(k in no)) cell = '<span class="aud-diff-old">' + esc(fmtVal(av)) + '</span>';
            else cell = '<span class="aud-diff-old">' + esc(fmtVal(av)) + '</span>'
                      + '<span class="aud-diff-arrow">→</span>'
                      + '<span class="aud-diff-new">' + esc(fmtVal(nv)) + '</span>';
            filas += '<tr><td class="k">' + esc(k) + '</td><td>' + cell + '</td></tr>';
        });

        var cuerpo = filas
            ? '<table class="aud-diff-tbl">' + filas + '</table>'
            : '<div class="aud-diff-none">' + esc(S.diffSin) + '</div>';
        return '<div class="aud-diff"><div class="aud-diff-lbl">' + esc(S.diffTit) + '</div>' + cuerpo + '</div>';
    }

    function verDetalle(id) {
        $.getJSON('@Url.Action("Detalle", "Auditoria")', { id: id }).done(function (d) {
            if (!d || !d.success) { Swal.fire({ icon: 'error', title: S.errTit, text: S.error }); return; }

            var entidadTxt = d.entidadNombre || d.entidad || '';
            var entidadRuta = (d.entidad || '') + (d.entidadId ? ' #' + d.entidadId : '');
            var diffHtml = renderDiff(d.valorAnterior, d.valorNuevo);
            var opBtn = d.operacionId
                ? '<button type="button" id="audVerOp" class="aud-dt-copy" style="margin-top:.4rem;">' + esc(S.opVer) + '</button>'
                : '';
            var rawHtml = (d.valorAnterior || d.valorNuevo)
                ? '<details class="aud-raw"' + (diffHtml ? '' : ' open') + '><summary>' + esc(S.rawJson) + '</summary>'
                    + bloque(S.vAnt, d.valorAnterior) + bloque(S.vNue, d.valorNuevo) + '</details>'
                : '';

            var html = '<div class="aud-dt">'
                + '<div class="aud-dt-fecha">' + esc(d.fecha) + '</div>'
                + '<div class="aud-dt-chips">'
                +   '<span class="aud-dt-chip"><span class="sev-dot sev-' + (d.severidad || 'Info') + '"></span>' + esc(sevLabel(d.severidad)) + '</span>'
                +   dtChip(d.tipo, 'tipo') + dtChip(accionLabel(d.accion)) + dtChip(entidadTxt)
                + '</div>'
                + (d.descripcion ? '<p class="aud-dt-desc">' + esc(d.descripcion) + '</p>' : '')
                + '<div class="aud-dt-meta">'
                +   dtMeta(S.mUsuario, d.nombreUsuario) + dtMeta(S.mEmpresa, d.empresa) + dtMeta(S.mIp, d.ipAddress)
                +   (entidadRuta && entidadRuta !== entidadTxt ? dtMeta(S.refLbl, entidadRuta) : '')
                + '</div>'
                + diffHtml
                + opBtn
                + rawHtml
                + '</div>';

            Swal.fire({
                title: S.modal,
                html: html,
                width: '720px',
                showConfirmButton: false,
                showCloseButton: true,
                didOpen: function (popup) {
                    var vo = popup.querySelector('#audVerOp');
                    if (vo) vo.addEventListener('click', function () {
                        _opId = d.operacionId; _histEnt = null;
                        Swal.close(); pintarChips(); consultar(1);
                    });
                    popup.querySelectorAll('.aud-dt-copy').forEach(function (btn) {
                        if (btn.id === 'audVerOp') return;
                        btn.addEventListener('click', function () {
                            var pre = popup.querySelector('#' + btn.getAttribute('data-target'));
                            if (!pre) return;
                            var texto = pre.textContent;
                            var ok = function () {
                                var prev = btn.textContent;
                                btn.textContent = S.copiado;
                                setTimeout(function () { btn.textContent = prev; }, 1300);
                            };
                            if (navigator.clipboard && navigator.clipboard.writeText) {
                                navigator.clipboard.writeText(texto).then(ok, function () {});
                            } else {
                                var ta = document.createElement('textarea');
                                ta.value = texto; document.body.appendChild(ta); ta.select();
                                try { document.execCommand('copy'); ok(); } catch (e) {}
                                document.body.removeChild(ta);
                            }
                        });
                    });
                }
            });
        }).fail(function () {
            Swal.fire({ icon: 'error', title: S.errTit, text: S.error });
        });
    }

    function estadoInicial() {
        $('#tbody').empty();
        $('#vistaTimeline').empty();
        $('#paginacion').empty();
        $('#paginaInfo').text('');
        $('#totalBadge').text('0 ' + S.total);
        $('#resultadosContainer').hide();
        $('#sinResultados').show();
    }

    $('#btnConsultar').on('click', function () { consultar(1); });
    $('#btnLimpiar').on('click', function () {
        $('#fTipo, #fAccion, #fSeveridad, #fEmpresa').val('');
        $('#fEntidad, #fTexto, #fDesde, #fHasta').val('');
        _histEnt = null; _opId = null; pintarChips();
        // Igual que al entrar: no consulta, vuelve al estado vacío.
        estadoInicial();
    });
    $('#btnExportar').on('click', function () {
        window.location = '@Url.Action("ExportarExcel", "Auditoria")' + '?' + $.param(paramsFiltro());
    });

    $('#vwTabla').on('click', function () { if (_vista === 'tabla') return; _vista = 'tabla'; pintarVista(); });
    $('#vwTimeline').on('click', function () { if (_vista === 'timeline') return; _vista = 'timeline'; pintarVista(); });
    $('#btnImprimir').on('click', function () {
        var cont = document.querySelector('#resultadosContainer .table-container');
        if (!cont) return;
        var w = window.open('', '_blank');
        if (!w) return;
        w.document.write(
            '<!doctype html><html><head><meta charset="utf-8"><title>' + document.title + '</title>' +
            '<style>body{font:12px system-ui,-apple-system,sans-serif;padding:22px;color:#111;}' +
            'h1{font-size:15px;margin:0 0 12px;}table{border-collapse:collapse;width:100%;}' +
            'th,td{border:1px solid #bbb;padding:5px 7px;text-align:left;font-size:10.5px;vertical-align:top;}' +
            'th{background:#eee;} .info-badge,button,.btn{display:none!important;}</style></head><body>' +
            '<h1>' + document.title + '</h1>' + cont.outerHTML + '</body></html>');
        w.document.close();
        w.focus();
        w.setTimeout(function () { w.print(); }, 300);
    });

    @if (esSuper)
    {
        <text>
    $('#btnLimpiarAuditoria').on('click', function () {
        var opciones =
            _empresasLimp.map(function (e) {
                return '<option value="' + e.id + '">' + esc(e.n) + '</option>';
            }).join('');

        Swal.fire({
            title: _limp.titulo,
            html:
                '<div class="aud-limp-wrap">' +
                  '<p class="aud-limp-desc">' + _limp.desc + '</p>' +
                  '<label class="aud-limp-opt is-active" data-modo="todo">' +
                    '<input type="radio" name="audLimpModo" value="todo" checked>' +
                    '<span class="aud-limp-opt-body">' +
                      '<span class="aud-limp-opt-title">' + _limp.opcionTodo + '</span>' +
                      '<span class="aud-limp-opt-hint">' + _limp.opcionTodoHint + '</span>' +
                    '</span>' +
                  '</label>' +
                  '<label class="aud-limp-opt" data-modo="conservar">' +
                    '<input type="radio" name="audLimpModo" value="conservar">' +
                    '<span class="aud-limp-opt-body">' +
                      '<span class="aud-limp-opt-title">' + _limp.opcionConservar + '</span>' +
                      '<span class="aud-limp-opt-hint">' + _limp.opcionConservarHint + '</span>' +
                      '<span class="aud-limp-meses-row">' +
                        '<label for="audLimpMeses">' + _limp.mesesLabel + '</label>' +
                        '<input type="number" id="audLimpMeses" class="aud-limp-meses-input" min="1" max="120" value="6" disabled>' +
                      '</span>' +
                    '</span>' +
                  '</label>' +
                  '<div class="aud-limp-sep">' + _limp.alcanceTodas.toUpperCase() + ' / ' + _limp.alcanceUna.toUpperCase() + '</div>' +
                  '<label class="aud-limp-opt is-active" data-alc="todas">' +
                    '<input type="radio" name="audLimpAlc" value="todas" checked>' +
                    '<span class="aud-limp-opt-body">' +
                      '<span class="aud-limp-opt-title">' + _limp.alcanceTodas + '</span>' +
                    '</span>' +
                  '</label>' +
                  '<label class="aud-limp-opt" data-alc="una">' +
                    '<input type="radio" name="audLimpAlc" value="una">' +
                    '<span class="aud-limp-opt-body">' +
                      '<span class="aud-limp-opt-title">' + _limp.alcanceUna + '</span>' +
                      '<span class="aud-limp-opt-hint">' + _limp.alcanceUnaHint + '</span>' +
                      '<select id="audLimpEmpresa" class="aud-limp-emp-select" disabled>' +
                        '<option value="">—</option>' + opciones +
                      '</select>' +
                    '</span>' +
                  '</label>' +
                '</div>',
            focusConfirm: false,
            showCancelButton: true,
            confirmButtonText: _limp.confirmarBtn,
            cancelButtonText: _limp.cancelarBtn,
            confirmButtonColor: '#e74c3c',
            reverseButtons: true,
            didOpen: function () {
                var popup    = Swal.getPopup();
                var meses    = popup.querySelector('#audLimpMeses');
                var emp      = popup.querySelector('#audLimpEmpresa');
                var optsModo = popup.querySelectorAll('.aud-limp-opt[data-modo]');
                var optsAlc  = popup.querySelectorAll('.aud-limp-opt[data-alc]');

                function sinc() {
                    var m = (popup.querySelector('input[name="audLimpModo"]:checked') || {}).value || 'todo';
                    var a = (popup.querySelector('input[name="audLimpAlc"]:checked') || {}).value || 'todas';
                    optsModo.forEach(function (o) { o.classList.toggle('is-active', o.getAttribute('data-modo') === m); });
                    optsAlc.forEach(function (o) { o.classList.toggle('is-active', o.getAttribute('data-alc') === a); });
                    meses.disabled = (m !== 'conservar');
                    emp.disabled   = (a !== 'una');
                }
                popup.querySelectorAll('input[name="audLimpModo"],input[name="audLimpAlc"]')
                     .forEach(function (r) { r.addEventListener('change', sinc); });
                meses.addEventListener('focus', function () {
                    popup.querySelector('input[name="audLimpModo"][value="conservar"]').checked = true; sinc();
                });
                emp.addEventListener('focus', function () {
                    popup.querySelector('input[name="audLimpAlc"][value="una"]').checked = true; sinc();
                });
                sinc();
            },
            preConfirm: function () {
                var m = (document.querySelector('input[name="audLimpModo"]:checked') || {}).value || 'todo';
                var a = (document.querySelector('input[name="audLimpAlc"]:checked') || {}).value || 'todas';
                var out = { completo: m !== 'conservar', meses: null, idEmpresa: null };

                if (m === 'conservar') {
                    var n = parseInt(document.getElementById('audLimpMeses').value, 10);
                    if (isNaN(n) || n < 1 || n > 120) { Swal.showValidationMessage(_limp.mesesInvalido); return false; }
                    out.meses = n;
                }
                if (a === 'una') {
                    var ide = parseInt(document.getElementById('audLimpEmpresa').value, 10);
                    if (isNaN(ide) || ide <= 0) { Swal.showValidationMessage(_limp.empresaInvalida); return false; }
                    out.idEmpresa = ide;
                }
                return out;
            }
        }).then(function (res) {
            if (!res.isConfirmed) return;
            var o = res.value;
            var scope = o.idEmpresa ? _limp.scopeEmpresa : '';
            var texto = o.completo
                ? _limp.confirmTodo.replace('{0}', scope)
                : _limp.confirmConservar.replace('{0}', scope).replace('{1}', o.meses);

            Swal.fire({
                title: _limp.titulo, text: texto, icon: 'warning',
                showCancelButton: true,
                confirmButtonText: _limp.confirmarBtn, cancelButtonText: _limp.cancelarBtn,
                confirmButtonColor: '#e74c3c', reverseButtons: true
            }).then(function (c) {
                if (!c.isConfirmed) return;
                var token = $('input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '@Url.Action("Limpiar", "Auditoria")',
                    type: 'POST',
                    data: { completo: o.completo, meses: o.meses, idEmpresa: o.idEmpresa, __RequestVerificationToken: token },
                    success: function (r) {
                        if (r && r.success) {
                            Swal.fire({ icon: 'success', title: S.exitoTit,
                                text: _limp.exito.replace('{0}', r.eliminados) });
                            estadoInicial();
                        } else {
                            Swal.fire({ icon: 'error', title: S.errTit, text: (r && r.message) || _limp.errorMsg });
                        }
                    },
                    error: function () { Swal.fire({ icon: 'error', title: S.errTit, text: _limp.errorMsg }); }
                });
            });
        });
    });
        </text>
    }

    // No se carga nada al entrar: solo al pulsar «Consultar».
    estadoInicial();
});
</script>
}
