    var _vista = 'tabla';          // 'tabla' | 'timeline'
    var _ultimos = [];             // últimos items para re-render al cambiar de vista
    var _histEnt = null;           // { entidad, entidadId } filtro "historial de un registro"
    var _opId = null;              // operacionId filtro "ver operación completa"

    function paramsFiltro() {
        var rango = AudKit.periodo.rango();
        var p = {
            accion:      $('#fAccion').val() || '',
            severidad:   $('#fSeveridad').val() || '',
            idEmpresa:   $('#fEmpresa').val() || '',
            idUsuario:   $('#fUsuario').val() || '',
            entidad:     _histEnt ? _histEnt.entidad : '',
            entidadId:   _histEnt ? _histEnt.entidadId : '',
            operacionId: _opId || '',
            texto:       $('#fTexto').val() || '',
            desde:       rango.desde || '',
            hasta:       rango.hasta || ''
        };
        if (_histEnt || _opId) return p;        // el historial / la operación mandan solos

        if (_modo === 'login') {
            p.tipo = 'SEGURIDAD';
        } else {
            var area = $('#fArea').val();
            if (area) p.tipo = area;
            else p.excluirTipo = 'SEGURIDAD';
        }
        return p;
    }

    function consultar(pagina) {
        _pagina = pagina || 1;
        pintarChips();
        var p = paramsFiltro();
        p.pagina = _pagina; p.tam = PAGE_SIZE;
        $.getJSON('@Url.Action("Consultar", "Auditoria")', p).done(render).fail(function () {
            Swal.fire({ icon: 'error', title: S.errTit, text: S.error });
        });
    }

    // Chips de filtros activos (compartidos) + los propios de esta pestaña: historial de un registro / operación.
    function pintarChips() {
        var extras = [];
        if (_histEnt) extras.push({
            label: S.histDe, texto: _histEnt.entidad + ' #' + _histEnt.entidadId,
            quitar: function () { _histEnt = null; consultar(1); }
        });
        if (_opId) extras.push({
            label: S.opLabel, texto: String(_opId).slice(0, 8),
            quitar: function () { _opId = null; consultar(1); }
        });
        AudKit.filtros.chips(function () { consultar(1); }, extras);
    }

    function render(r) {
        if (!r || !r.success) { Swal.fire({ icon: 'error', title: S.errTit, text: S.error }); return; }

        $('#totalBadge').text(r.total.toLocaleString() + ' ' + S.total);
        $('#axInicial').hide();
        var rs = r.resumen || {};
        AudKit.kpis.render($('#axKpis'), [
            { label: S.kEventos, valor: AudKit.num(r.total) },
            { label: S.kUsuarios, valor: AudKit.num(rs.usuarios) },
            { label: S.kAlta, valor: AudKit.num(rs.relevanciaAlta), alerta: (rs.relevanciaAlta || 0) > 0 },
            { label: S.kUltimo, valor: rs.ultimo ? tiempoRelativo(rs.ultimo).rel : '—', texto: true }
        ]);
        _ultimos = r.items || [];
        _paginaActual = r.pagina; _totalPaginas = r.totalPaginas;

        if (!_ultimos.length) {
            $('#tbody').empty(); $('#vistaTimeline').empty();
            $('#paginaInfo').text('');
            $('#paginacion').empty();
            $('#resultadosContainer').hide();
            $('#sinResultados').show();
            return;
        }

        $('#paginaInfo').text(AudKit.pager.info(r.pagina, PAGE_SIZE, r.total));
        $('#sinResultados').hide();
        $('#resultadosContainer').show();

        pintarVista();
        renderPaginacion(r.pagina, r.totalPaginas);
    }

    var _paginaActual = 1, _totalPaginas = 1;

    function pintarVista() {
        $('#vwTabla').toggleClass('is-active', _vista === 'tabla');
        $('#vwTimeline').toggleClass('is-active', _vista === 'timeline');
        $('#vistaTabla').toggle(_vista === 'tabla');
        $('#vistaTimeline').toggle(_vista === 'timeline');
        if (_vista === 'tabla') renderTabla(_ultimos); else renderTimeline(_ultimos);
    }

    function entidadCelda(a) {
        var nombre = a.EntidadNombre || a.Entidad || '';
        var ruta   = (a.Entidad || '') + (a.EntidadId ? ' #' + a.EntidadId : '');
        var $td = $('<td>').attr('title', nombre + (ruta && ruta !== nombre ? '  ·  ' + ruta : ''));
        $td.append($('<span class="ent-nombre">').text(nombre));
        if (nombre !== ruta && ruta) $td.append($('<div class="ent-ruta">').text(ruta));
        if (a.EntidadId) {
            $('<button class="btn-hist" title="' + esc(S.histTip) + '">')
                .html('<i class="fas fa-history"></i>')
                .on('click', function () {
                    _histEnt = { entidad: a.Entidad, entidadId: a.EntidadId };
                    _opId = null; pintarChips(); consultar(1);
                }).appendTo($td);
        }
        return $td;
    }

    function renderTabla(items) {
        var tbody = $('#tbody').empty();
        items.forEach(function (a) {
            var sev = a.Severidad || 'Info';
            var tr = $('<tr class="row-' + sev + '">');

            // 1 · Cuándo
            var t = tiempoRelativo(a.Fecha);
            tr.append($('<td class="cel-when">').attr('title', a.Fecha)
                .html('<span class="rel">' + esc(t.rel) + '</span><span class="abs">' + esc(t.abs) + '</span>'));

            // 2 · Actividad
            var nombre = a.EntidadNombre || '';
            var $line = $('<div class="act-line">');
            $line.append($('<span class="sev-dot sev-' + sev + '" title="' + esc(relLabel(sev)) + '">'));
            $line.append(document.createTextNode(fraseLabel(a.Accion) + (nombre ? ' ' + nombre : '')));
            $line.append($('<span class="area-chip">').text(areaLabel(a.Tipo)));
            if (a.EntidadId) {
                $('<button class="btn-hist" title="' + esc(S.histTip) + '">')
                    .html('<i class="fas fa-history"></i>')
                    .on('click', function () {
                        _histEnt = { entidad: a.Entidad, entidadId: a.EntidadId };
                        _opId = null; pintarChips(); consultar(1);
                    }).appendTo($line);
            }
            var $act = $('<td>').append($line);
            if (a.Descripcion) $act.append($('<div class="act-desc">').attr('title', a.Descripcion).text(a.Descripcion));
            tr.append($act);

            // 3-4 · Usuario / Empresa
            tr.append($('<td>').attr('title', a.NombreUsuario || '').text(a.NombreUsuario || '—'));
            tr.append($('<td>').attr('title', a.Empresa || '').text(a.Empresa || '—'));

            // 5 · Detalle
            var celdaVer = $('<td class="text-center">');
            if (a.TieneDetalle) {
                $('<button class="btn btn-sm btn-primary">')
                    .html('<i class="fas fa-eye"></i>')
                    .on('click', function () { verDetalle(a.Id); })
                    .appendTo(celdaVer);
            } else {
                celdaVer.html('<span class="text-muted">—</span>');
            }
            tr.append(celdaVer);
            tbody.append(tr);
        });
    }

    function renderTimeline(items) {
        var $ul = $('#vistaTimeline').empty();
        items.forEach(function (a) {
            var nombre = a.EntidadNombre || a.Entidad || '';
            var $li = $('<li>');
            $li.append($('<span class="tl-dot sev-' + (a.Severidad || 'Info') + '">'));
            var $body = $('<div class="tl-body">');
            $body.append(
                $('<span>').append(
                    $('<b>').text(a.NombreUsuario || '—'),
                    document.createTextNode(' · ' + fraseLabel(a.Accion) + ' '),
                    $('<b>').text(nombre)
                )
            );
            if (a.Descripcion) $body.append($('<div>').css({ fontSize: '.85rem', opacity: .85 }).text(a.Descripcion));
            var meta = a.Fecha + '  ·  ' + areaLabel(a.Tipo) + (a.Empresa ? '  ·  ' + a.Empresa : '');
            var $meta = $('<div class="tl-meta">').text(meta);
            if (a.TieneDetalle) {
                $('<button class="aud-tl-ver">').text(S.verDet).on('click', function () { verDetalle(a.Id); }).appendTo($meta);
            }
            $body.append($meta);
            $li.append($body);
            $ul.append($li);
        });
    }

