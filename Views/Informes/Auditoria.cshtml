@using bufinscustomers.Models
@using System.Linq
@using System.Web.Mvc
@{
    ViewBag.Title = Resources.Strings.Audit_PageTitle;
    if ((bool)(ViewBag.Embed ?? false)) { Layout = "~/Views/Shared/_LayoutFragment.cshtml"; }
    var tipos = ViewBag.Tipos as System.Collections.Generic.List<string> ?? new System.Collections.Generic.List<string>();
    var empresas = ViewBag.Empresas as System.Collections.Generic.List<Empresas> ?? new System.Collections.Generic.List<Empresas>();
    var usuariosFiltro = ViewBag.Usuarios as System.Collections.Generic.List<System.Collections.Generic.KeyValuePair<int, string>>
        ?? new System.Collections.Generic.List<System.Collections.Generic.KeyValuePair<int, string>>();
    var esSuper = (bool)(ViewBag.EsSuperAdmin ?? false);
    var esNormal = (bool)(ViewBag.EsUsuarioNormal ?? false);

    // Panel de filtros UNIFORME (mismo orden en las 4 pestañas): Empresa · Usuario · campos propios (Área, Qué ocurrió) · avanzados.
    var vm = new AudFiltrosVM { PlaceholderBusqueda = Resources.Strings.Audit_BuscarPlaceholder2, PeriodoDefecto = "30" };
    vm.Campos.Add(new AudCampo
    {
        Id = "fEmpresa", Etiqueta = Resources.Strings.Audit_LabelEmpresa, Icono = "fa-building",
        TextoTodos = Resources.Strings.Audit_TodasEmpresas,
        Opciones = empresas.Select(e => new SelectListItem { Value = e.Id.ToString(), Text = e.Nombre }).ToList()
    });
    if (!esNormal)
    {
        vm.Campos.Add(new AudCampo
        {
            Id = "fUsuario", Etiqueta = Resources.Strings.Audit_ThUsuario, Icono = "fa-user",
            TextoTodos = Resources.Strings.Audit_TodosUsuarios,
            Opciones = usuariosFiltro.Select(u => new SelectListItem { Value = u.Key.ToString(), Text = u.Value }).ToList()
        });
    }
    vm.Campos.Add(new AudCampo
    {
        Id = "fArea", WrapId = "wrapArea", Propio = true, Etiqueta = Resources.Strings.Audit_LabelArea, Icono = "fa-layer-group",
        TextoTodos = Resources.Strings.Audit_TodasAreas,
        Opciones = tipos.Where(x => !string.Equals(x, "SEGURIDAD", StringComparison.OrdinalIgnoreCase))
                        .Select(t => new SelectListItem { Value = t, Text = t }).ToList()
    });
    vm.Campos.Add(new AudCampo
    {
        Id = "fAccion", Propio = true, Etiqueta = Resources.Strings.Audit_LabelQueOcurrio, Icono = "fa-bolt",
        TextoTodos = Resources.Strings.Audit_CualquierCambio   // el JS reemplaza las opciones según el modo (cambios / inicios de sesión)
    });
    vm.Avanzados.Add(new AudCampo
    {
        Id = "fSeveridad", Propio = true, Etiqueta = Resources.Strings.Audit_LabelRelevancia, Icono = "fa-signal",
        TextoTodos = Resources.Strings.Common_Todos,
        Opciones = new System.Collections.Generic.List<SelectListItem>
        {
            new SelectListItem { Value = "Critico", Text = Resources.Strings.Audit_Rel_Alta },
            new SelectListItem { Value = "Advertencia", Text = Resources.Strings.Audit_Rel_Media },
            new SelectListItem { Value = "Info", Text = Resources.Strings.Audit_Rel_Normal }
        }
    });
}

<link href="~/Assets/css/bufins-components.css" rel="stylesheet" />
<link href="~/Assets/css/auditoria-shared.css" rel="stylesheet" />

<style>
    /* ===== Modal "Detalle de auditoría" (SweetAlert2, tema oscuro) ===== */
    .aud-dt-popup.swal2-popup { padding: 1.1rem 1.25rem 1.35rem; border-radius: 14px; }
    .aud-dt-popup .swal2-title { font-size: 1.02rem; font-weight: 600; padding: .1rem 2rem .2rem 0; margin: 0; text-align: left; }
    .aud-dt-popup .swal2-html-container { font-size: .875rem; margin: .85rem 0 0; max-height: 72vh; overflow: auto; }
    .aud-dt-popup .swal2-close { top: .55rem; right: .6rem; font-size: 1.6rem; }

    .aud-dt { text-align: left; color: #E9E7F6; --dt-accent: #8b7dff; --dt-badge-bg: rgba(139,125,255,.16); --dt-badge-bd: rgba(139,125,255,.4); }
    .aud-dt.dt-sev-Info        { --dt-accent: #5b9bff; --dt-badge-bg: rgba(91,155,255,.16);  --dt-badge-bd: rgba(91,155,255,.4); }
    .aud-dt.dt-sev-Advertencia { --dt-accent: #f5b345; --dt-badge-bg: rgba(245,179,69,.16);  --dt-badge-bd: rgba(245,179,69,.42); }
    .aud-dt.dt-sev-Critico     { --dt-accent: #ff6b64; --dt-badge-bg: rgba(255,107,100,.16); --dt-badge-bd: rgba(255,107,100,.42); }

    .aud-dt-head { display: flex; align-items: center; gap: .6rem; }
    .aud-dt-ico {
        flex: 0 0 auto; width: 30px; height: 30px; border-radius: 8px;
        display: flex; align-items: center; justify-content: center; font-size: .82rem;
        background: var(--dt-badge-bg); border: 1px solid var(--dt-badge-bd); color: var(--dt-accent);
    }
    .aud-dt-htxt { min-width: 0; flex: 1; }
    .aud-dt-title { display: block; font-size: .92rem; font-weight: 600; line-height: 1.3; color: #fff; }
    .aud-dt-sub { display: block; font-size: .76rem; color: #a9a4c8; margin-top: .1rem; }

    .aud-dt-chips { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .7rem; }
    .aud-dt-chip {
        display: inline-flex; align-items: center; gap: .35rem;
        font: 500 .72rem/1 -apple-system, "Segoe UI", system-ui, sans-serif;
        padding: .28rem .55rem; border-radius: 999px;
        background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); color: #cfcbe6; white-space: nowrap;
    }
    .aud-dt-chip.tipo { color: #c6bfff; border-color: rgba(139,125,255,.4); background: rgba(139,125,255,.14); }
    .aud-dt-chip .sev-dot { margin: 0; width: 7px; height: 7px; }

    .aud-dt-desc {
        font-size: .82rem; line-height: 1.5; color: #cfcbe4; margin: .7rem 0 0;
        padding: .5rem .7rem; border-left: 2px solid var(--dt-accent);
        background: rgba(255,255,255,.03); border-radius: 0 6px 6px 0;
    }

    .aud-dt-sec { margin-top: .9rem; }
    .aud-dt-sec-lbl {
        font: 600 .7rem/1 inherit; letter-spacing: .02em; text-transform: none;
        color: #9993bd; margin-bottom: .4rem;
    }
    .aud-dt-panel { background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.09); border-radius: 8px; overflow: hidden; }
    .aud-kv { width: 100%; border-collapse: collapse; font-size: .8rem; }
    .aud-kv tr + tr td { border-top: 1px solid rgba(255,255,255,.06); }
    .aud-kv td { padding: .42rem .6rem; vertical-align: top; }
    .aud-kv td.k { width: 32%; color: #a29dc4; font-weight: 500; font-size: .76rem; white-space: nowrap; }
    .aud-kv td.v { color: #ECE9FA; word-break: break-word; }
    .aud-kv .o { color: #ff9d97; text-decoration: line-through; opacity: .8; }
    .aud-kv .arw { color: #6f6a90; margin: 0 .35rem; }
    .aud-kv .n { color: #7ee0b0; }
    .aud-dt-none { padding: .55rem .65rem; font-size: .8rem; font-style: italic; color: #8f8ab0; }

    .aud-dt-meta {
        display: flex; flex-wrap: wrap; gap: .3rem .9rem; font-size: .72rem; color: #837e9f;
        margin-top: .8rem; padding-top: .6rem; border-top: 1px solid rgba(255,255,255,.08);
    }
    .aud-dt-meta span { display: inline-flex; align-items: center; gap: .35rem; }
    .aud-dt-meta i { font-size: .78em; opacity: .8; }

    .aud-dt-btn {
        display: inline-flex; align-items: center; gap: .4rem; margin-top: .8rem;
        font: 600 .75rem/1 inherit; padding: .42rem .75rem; border-radius: 7px; cursor: pointer;
        background: rgba(139,125,255,.14); border: 1px solid rgba(139,125,255,.4); color: #c6bfff; transition: background .15s;
    }
    .aud-dt-btn:hover { background: rgba(139,125,255,.24); }

    details.aud-raw { margin-top: .8rem; }
    details.aud-raw > summary {
        cursor: pointer; list-style: none; display: inline-flex; align-items: center; gap: .4rem;
        font: 600 .72rem/1 inherit; letter-spacing: .02em; text-transform: none;
        color: #837e9f; padding: .25rem 0;
    }
    details.aud-raw > summary:hover { color: #b7b2d4; }
    details.aud-raw > summary::-webkit-details-marker { display: none; }
    details.aud-raw > summary::before { content: "\25B8"; font-size: .85em; transition: transform .15s; }
    details.aud-raw[open] > summary::before { transform: rotate(90deg); }
    .aud-dt-block { margin-top: .6rem; }
    .aud-dt-block-hdr { display: flex; align-items: center; justify-content: space-between; margin-bottom: .3rem; }
    .aud-dt-block-lbl { font: 600 .7rem/1 inherit; letter-spacing: .02em; text-transform: none; color: #8b86a8; }
    .aud-dt-copy {
        font: 600 .68rem/1 inherit; letter-spacing: 0;
        background: transparent; border: 1px solid rgba(255,255,255,.2); color: #9d98bd;
        border-radius: 5px; padding: .22em .55em; cursor: pointer; transition: color .15s, border-color .15s;
    }
    .aud-dt-copy:hover { color: #fff; border-color: rgba(255,255,255,.45); }
    .aud-dt-pre {
        margin: 0; padding: 9px 11px; border-radius: 7px; color: #E6E2FA;
        background: rgba(0,0,0,.32); border: 1px solid rgba(255,255,255,.1);
        font: 400 .72rem/1.5 "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
        white-space: pre-wrap; word-break: break-word; max-height: 24vh; overflow: auto;
    }
    .aud-dt-pre .j-key { color: #b0a8ff; }
    .aud-dt-pre .j-str { color: #7ee0b0; }
    .aud-dt-pre .j-num { color: #f2b45f; }
    .aud-dt-pre .j-kw  { color: #ff8f8a; }

    /* Modal "Limpiar auditoría" (dentro de SweetAlert, tema oscuro) — mismo estilo que Auditoría IA */
    .aud-limp-wrap { text-align:left; }
    .aud-limp-desc {
        font-size:.85rem; line-height:1.5; color:#9ca3af;
        margin:0 0 16px; padding-bottom:12px; border-bottom:1px solid rgba(255,255,255,.12);
    }
    .aud-limp-opt {
        display:flex; align-items:flex-start; gap:10px;
        padding:12px 14px; margin-bottom:10px;
        border:1.5px solid rgba(255,255,255,.16); border-radius:10px;
        cursor:pointer; transition:border-color .15s, background .15s;
    }
    .aud-limp-opt:last-child { margin-bottom:0; }
    .aud-limp-opt:hover { border-color:rgba(139,125,255,.7); }
    .aud-limp-opt.is-active { border-color:#8b7dff; background:rgba(88,58,255,.16); }
    .aud-limp-opt > input[type=radio] { margin:3px 0 0; accent-color:#8b7dff; flex:0 0 auto; }
    .aud-limp-opt-body { flex:1; min-width:0; }
    .aud-limp-opt-title { display:block; font-weight:600; font-size:.92rem; color:#f3f4f6; }
    .aud-limp-opt-hint  { display:block; font-size:.78rem; color:#9ca3af; margin-top:3px; }
    .aud-limp-meses-row { display:flex; align-items:center; gap:8px; margin-top:10px; }
    .aud-limp-meses-row label { margin:0; font-size:.8rem; color:#cbd5e1; }
    .aud-limp-meses-input {
        width:88px; padding:6px 10px; font-size:.9rem; text-align:center;
        border:1.5px solid rgba(255,255,255,.25); border-radius:8px;
        background:rgba(255,255,255,.06); color:#f3f4f6;
    }
    .aud-limp-meses-input:focus { outline:none; border-color:#8b7dff; }
    .aud-limp-meses-input:disabled { opacity:.4; cursor:not-allowed; }
    .aud-limp-sep { margin:14px 0 10px; font-size:.72rem; font-weight:700; letter-spacing:.06em;
        text-transform:uppercase; color:#9ca3af; }
    .aud-limp-emp-select {
        margin-top:8px; width:100%; padding:7px 10px; font-size:.88rem;
        border:1.5px solid rgba(255,255,255,.25); border-radius:8px;
        background:rgba(255,255,255,.06); color:#f3f4f6;
    }
    .aud-limp-emp-select:focus { outline:none; border-color:#8b7dff; }
    .aud-limp-emp-select:disabled { opacity:.4; cursor:not-allowed; }

    /* ---- Fase 2/3: severidad, diff, historial por entidad, línea de tiempo ---- */
    .sev-dot { display:inline-block; width:9px; height:9px; border-radius:50%; margin-right:.45rem; vertical-align:middle; }
    .sev-Info { background:#3b82f6; } .sev-Advertencia { background:#f59e0b; } .sev-Critico { background:#ef4444; }
    tr.row-Critico > td:first-child { box-shadow: inset 3px 0 0 #ef4444; }
    tr.row-Advertencia > td:first-child { box-shadow: inset 3px 0 0 #f59e0b; }
    .ent-nombre { font-weight:600; } .ent-ruta { font-size:.74rem; color:#8890a0; }
    .btn-hist { border:1px solid #d1d5db; background:#fff; color:#6b7280; border-radius:6px; padding:.12rem .4rem; cursor:pointer; font-size:.78rem; margin-left:.35rem; }
    .btn-hist:hover { border-color:#8b7dff; color:#583AFF; }

    .aud-tl { list-style:none; margin:0; padding:4px 2px; }
    .aud-tl li { display:flex; gap:.8rem; padding:.7rem .2rem; border-bottom:1px solid #eef0f4; }
    .aud-tl li:last-child { border-bottom:0; }
    .aud-tl .tl-dot { flex:0 0 auto; width:10px; height:10px; border-radius:50%; margin-top:.4rem; }
    .aud-tl .tl-body { flex:1; min-width:0; font-size:.9rem; line-height:1.5; }
    .aud-tl .tl-meta { font-size:.76rem; color:#8890a0; margin-top:.15rem; }
    .aud-tl-ver { background:none; border:none; color:#583AFF; cursor:pointer; font-size:.78rem; padding:0; margin-left:.4rem; }

    /* ---- Tabla legible: 5 columnas (Cuándo · Actividad · Usuario · Empresa · ojo) ---- */
    #resultadosContainer .data-table { table-layout: fixed; width: 100%; }
    #resultadosContainer .data-table th { white-space: nowrap; }
    #resultadosContainer .data-table td { overflow: hidden; text-overflow: ellipsis; }
    #resultadosContainer .data-table tr > :nth-child(1) { width: 15%; white-space: nowrap; }
    #resultadosContainer .data-table tr > :nth-child(2) { width: 52%; white-space: normal; }
    #resultadosContainer .data-table tr > :nth-child(3) { width: 16%; white-space: nowrap; }
    #resultadosContainer .data-table tr > :nth-child(4) { width: 15%; white-space: nowrap; }
    #resultadosContainer .data-table tr > :nth-child(5) { width: 52px; }

    /* Columna "ver detalle" fija a la derecha: el ojo siempre visible */
    #resultadosContainer .data-table tr > :nth-child(5) {
        position: sticky; right: 0; background: #fff; text-align: center;
        box-shadow: -7px 0 8px -6px rgba(20,25,35,.13);
    }
    #resultadosContainer .data-table thead th:nth-child(5) {
        background: linear-gradient(90deg,#6366F1,#3B82F6,#06B6D4,#01E1D7); z-index: 12;
    }

    /* Celda "Cuándo": tiempo relativo + fecha exacta debajo */
    .cel-when .rel { font-weight: 600; }
    .cel-when .abs { display: block; color: #8890a0; font-size: .74rem; }

    /* Celda "Actividad": verbo + chip de área + descripción */
    .act-line { display: flex; align-items: center; gap: .4rem; flex-wrap: wrap; font-weight: 600; color: #2d3748; }
    .act-desc { color: #6b7280; font-size: .85rem; margin-top: .12rem; white-space: normal; }
    .area-chip {
        font: 600 .66rem/1 "IBM Plex Mono", ui-monospace, Menlo, monospace; letter-spacing: .03em;
        text-transform: uppercase; padding: .16em .5em; border-radius: 5px;
        background: #eef0f7; color: #55607a; white-space: nowrap;
    }

    /* Responsive: se ocultan columnas de menor prioridad (layout fijo ⇒ nunca hay scroll horizontal) */
    @@media (max-width: 1080px) { #resultadosContainer .data-table tr > :nth-child(4) { display: none; } } /* Empresa */
    @@media (max-width: 760px)  { #resultadosContainer .data-table tr > :nth-child(3) { display: none; } } /* Usuario */
</style>

<div class="container-fluid px-4">

    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas fa-shield-alt powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@Resources.Strings.Audit_HeaderTitle</h1>
        </div>
    </div>

    @if (esNormal)
    {
        <div class="alert alert-info d-flex align-items-center" role="alert" style="border-left:4px solid #583AFF;">
            <i class="fas fa-info-circle mr-2"></i>@Resources.Strings.Audit_AlcancePropio
        </div>
    }
    else if (!esSuper)
    {
        <div class="alert alert-info d-flex align-items-center" role="alert" style="border-left:4px solid #583AFF;">
            <i class="fas fa-info-circle mr-2"></i>@Resources.Strings.Audit_AlcanceEmpresa
        </div>
    }

    <div class="ax-vista ax-modo" role="group" aria-label="@Resources.Strings.Audit_ModoCambios">
        <button type="button" id="modoCambios" class="is-active"><i class="fas fa-exchange-alt"></i>@Resources.Strings.Audit_ModoCambios</button>
        <button type="button" id="modoLogin"><i class="fas fa-sign-in-alt"></i>@Resources.Strings.Audit_ModoLogin</button>
    </div>

    <div id="axKpis" class="ax-kpis" hidden></div>

    @Html.Partial("_AudFiltros", vm)

    @Html.AntiForgeryToken()

    <div id="axInicial" class="no-data-message">
        <i class="fas fa-shield-alt"></i>
        <h4>@Resources.Strings.Ax_EstadoInicialTit</h4>
        <p>@Resources.Strings.Ax_EstadoInicialDesc</p>
    </div>

    <div id="resultadosContainer" style="display:none;">
        <div class="table-container">
            <div class="table-header">
                <h5><i class="fas fa-list mr-2"></i>@Resources.Strings.Common_Resultados</h5>
                <div class="d-flex align-items-center" style="gap:.6rem;flex-wrap:wrap;">
                    <span id="totalBadge" class="info-badge">0 @Resources.Strings.Audit_TotalRegistros</span>
                    <span id="paginaInfo" class="ax-info"></span>
                </div>
                <div class="ax-toolbar">
                    <span class="ax-vista" role="group">
                        <button type="button" id="vwTabla" class="is-active"><i class="fas fa-table"></i>@Resources.Strings.Audit_VistaTabla</button>
                        <button type="button" id="vwTimeline"><i class="fas fa-stream"></i>@Resources.Strings.Audit_VistaTimeline</button>
                    </span>
                    <button type="button" id="btnExportar" class="btn btn-modern-excel"><i class="fas fa-file-excel mr-1"></i>@Resources.Strings.Audit_BtnExportar</button>
                    <button type="button" id="btnImprimir" class="btn btn-modern-secondary"><i class="fas fa-print mr-1"></i>@Resources.Strings.Audit_BtnImprimir</button>
                    @if (esSuper)
                    {
                        <button type="button" id="btnLimpiarAuditoria" class="btn btn-danger"><i class="fas fa-trash-alt mr-1"></i>@Resources.Strings.Audit_BtnLimpiarAuditoria</button>
                    }
                </div>
            </div>
            <div id="vistaTabla" class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@Resources.Strings.Audit_ThCuando</th>
                            <th>@Resources.Strings.Audit_ThActividad</th>
                            <th>@Resources.Strings.Audit_ThUsuario</th>
                            <th>@Resources.Strings.Audit_ThEmpresa</th>
                            <th class="text-center">@Resources.Strings.Audit_ThDetalle</th>
                        </tr>
                    </thead>
                    <tbody id="tbody"></tbody>
                </table>
            </div>
            <ul id="vistaTimeline" class="aud-tl" style="display:none;"></ul>
            <div id="paginacion" class="pagination-controls"></div>
        </div>
    </div>

    <div id="sinResultados" class="no-data-message" style="display:none;">
        <i class="fas fa-shield-alt"></i>
        <h4>@Resources.Strings.Audit_SinResultados</h4>
        <p>@Resources.Strings.Audit_SinResultadosDesc</p>
    </div>

</div>

@section scripts {
<script src="~/Assets/js/auditoria-shared.js"></script>
<script>
$(function () {
    var PAGE_SIZE = 25;
    var _pagina = 1;

    var S = {
        error:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_JS_Error))',
        total:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_TotalRegistros))',
        mostrando: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Mostrando))',
        de:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_De))',
        errTit:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Error))',
        exitoTit:'@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Exito))',
        modal:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_ModalTitulo))',
        vAnt:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_ValorAnterior))',
        vNue:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_ValorNuevo))',
        mUsuario: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_ThUsuario))',
        mEmpresa: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_ThEmpresa))',
        mIp:      '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_ThIp))',
        copiar:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Copiar))',
        copiado:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Copiado))',
        sevInfo:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Sev_Info))',
        sevAdv:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Sev_Advertencia))',
        sevCrit:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Sev_Critico))',
        diffTit:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_DiffTitulo))',
        diffSin:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_DiffSinCambios))',
        rawJson:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_VerJsonCrudo))',
        histDe:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_HistorialDe))',
        histTip:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_HistorialTooltip))',
        opLabel:  '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_Operacion))',
