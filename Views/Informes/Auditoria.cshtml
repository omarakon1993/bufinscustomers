    // "dd/MM/yyyy HH:mm:ss" -> Date
    function parseFecha(f) {
        var m = /(\d{2})\/(\d{2})\/(\d{4})\s+(\d{2}):(\d{2}):(\d{2})/.exec(f || '');
        if (!m) return null;
        return new Date(+m[3], +m[2] - 1, +m[1], +m[4], +m[5], +m[6]);
    }
    function hhmm(d) { return ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2); }
    function fechaCorta(d) { return d.getDate() + ' ' + (MESES[d.getMonth()] || ''); }
    function tiempoRelativo(f) {
        var d = parseFecha(f);
        if (!d) return { rel: f || '', abs: '' };
        var ahora = new Date();
        var difMin = Math.floor((ahora - d) / 60000);
        var abs = ('0' + d.getDate()).slice(-2) + '/' + ('0' + (d.getMonth() + 1)).slice(-2) + ' ' + hhmm(d);
        var rel;
        if (difMin < 1)        rel = S.trAhora;
        else if (difMin < 60)  rel = S.trMin.replace('{0}', difMin);
        else if (difMin < 60 * 8) rel = S.trHoras.replace('{0}', Math.floor(difMin / 60));
        else {
            var hoy0 = new Date(ahora.getFullYear(), ahora.getMonth(), ahora.getDate());
            var dia0 = new Date(d.getFullYear(), d.getMonth(), d.getDate());
            var difDia = Math.round((hoy0 - dia0) / 86400000);
            if (difDia === 0)      rel = S.trHoy.replace('{0}', hhmm(d));
            else if (difDia === 1) rel = S.trAyer.replace('{0}', hhmm(d));
            else if (d.getFullYear() === ahora.getFullYear()) rel = fechaCorta(d);
            else rel = fechaCorta(d) + ' ' + d.getFullYear();
        }
        return { rel: rel, abs: abs };
    }

