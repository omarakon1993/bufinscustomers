@using System.Web
@using bufinscustomers.Models
@{
    ViewBag.Title = Resources.Strings.BAL_PageTitle;
    var empresas = ViewBag.Empresas as List<Empresas>;
    var esAdmin = (bool)(ViewBag.EsAdmin ?? false);
    var culturaJs = System.Globalization.CultureInfo.CurrentUICulture.Name;
}

<link href="~/Assets/css/bufins-components.css" rel="stylesheet" />
<link href="~/Assets/css/informe-linea-tiempo.css" rel="stylesheet" />
<link href="~/Assets/css/informe-pyg.css" rel="stylesheet" />
<link href="~/Assets/css/informe-balance.css" rel="stylesheet" />
<link href="~/Assets/css/select2/select2.min.css" rel="stylesheet" />

<div class="container-fluid px-4">
<div class="lt-app">

    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas fa-scale-balanced powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@Resources.Strings.BAL_PageTitle</h1>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <div class="filter-card">
        <div class="lt-section-title"><span>@Resources.Strings.Common_FiltrosConsulta</span></div>
        <div class="lt-grid-quever">
            <div class="lt-field">
                <label class="lt-field-label" for="balEmpresa">@Resources.Strings.Common_LabelEmpresa</label>
                <select id="balEmpresa" class="lt-field-select">
                    @if (esAdmin) { <option value="">@Resources.Strings.Common_Seleccione</option> }
                    @if (empresas != null)
                    {
                        foreach (var e in empresas)
                        {
                            <option value="@e.Id">@e.Nombre</option>
                        }
                    }
                </select>
            </div>
            <div class="lt-field">
                <label class="lt-field-label" for="balEscenario">@Resources.Strings.Common_LabelEscenario</label>
                <select id="balEscenario" class="lt-field-select">
                    @if (ViewBag.Escenarios != null)
                    {
                        foreach (var esc in ViewBag.Escenarios)
                        {
                            <option value="@esc.Id">@esc.Nombre</option>
                        }
                    }
                </select>
            </div>
            <div class="lt-field">
                <label class="lt-field-label" for="balNivelDetalle">@Resources.Strings.BAL_NivelDetalle</label>
                <select id="balNivelDetalle" class="lt-field-select">
                    <option value="todas">@Resources.Strings.BAL_NivelTodas</option>
                    <option value="subtotales">@Resources.Strings.BAL_NivelSubtotales</option>
                </select>
            </div>
        </div>

        <details class="rpt-adv">
            <summary><span>@Resources.Strings.BAL_SeccionComparaciones</span><span class="line"></span></summary>
            <div class="rpt-adv-body">
                <div class="lt-grid-quever">
                    <div class="lt-field">
                        <label class="lt-field-label" for="balComparar">@Resources.Strings.BAL_Comparar_Label</label>
                        <select id="balComparar" class="lt-field-select">
                            <option value="cierreAnterior">@Resources.Strings.BAL_Comp_cierreAnterior</option>
                            <option value="mesAnterior">@Resources.Strings.BAL_Comp_mesAnterior</option>
                            <option value="mismoMesAnioAnterior">@Resources.Strings.BAL_Comp_mismoMesAnioAnterior</option>
                        </select>
                    </div>
                    <div class="lt-field">
                        <label class="lt-field-label" for="balEscenarioComparar">@Resources.Strings.BAL_EscenarioComparar</label>
                        @* Opciones armadas por JS (actualizarOpcionesEscenarioComparar): todos los escenarios menos
                           el principal; los que no tienen datos para la empresa quedan deshabilitados con tooltip. *@
                        <select id="balEscenarioComparar" class="lt-field-select">
                            <option value="">@Resources.Strings.BAL_EscenarioCompararNinguno</option>
                        </select>
                        <p class="lt-seg-hint" id="balEscenarioSinDatosHint" style="display:none;"><i class="fas fa-circle-info mr-1"></i>@Resources.Strings.BAL_EscenarioSinDatosHint</p>
                    </div>
                </div>
            </div>
        </details>

        @* Rango: mismo control que PYG/Línea de Tiempo, pero el balance no acumula meses — el corte para
           KPIs/tabla/cuadre es siempre el extremo derecho (Hasta); el rango completo solo alimenta las
           3 tendencias. "Agrupar por" también aplica solo a las tendencias. *@
        <div class="lt-section-title mt"><span>@Resources.Strings.LineaTiempo_FilaCuando</span></div>
        <div class="lt-grid-rango">
            <div>
                <label class="lt-field-label">@Resources.Strings.LineaTiempo_LabelVerPor</label>
                <div class="lt-seg" id="balSegVerPor">
                    <button type="button" class="active" data-modo="Mes" title="@Resources.Strings.LineaTiempo_Agrupar_MesAyuda" aria-pressed="true">
                        <i class="fas fa-calendar-day"></i><span>@Resources.Strings.LineaTiempo_VerPorMes</span>
                    </button>
                    <button type="button" data-modo="Trimestre" title="@Resources.Strings.LineaTiempo_Agrupar_TrimestreAyuda" aria-pressed="false">
                        <i class="fas fa-calendar-week"></i><span>@Resources.Strings.LineaTiempo_VerPorTrimestre</span>
                    </button>
                    <button type="button" data-modo="Anio" title="@Resources.Strings.LineaTiempo_Agrupar_AnioAyuda" aria-pressed="false">
                        <i class="fas fa-calendar"></i><span>@Resources.Strings.LineaTiempo_VerPorAnio</span>
                    </button>
                </div>
                <p class="lt-seg-hint"><span id="balAgruparHint">@Resources.Strings.LineaTiempo_Agrupar_MesAyuda</span>. @Resources.Strings.BAL_AgruparNota.</p>
            </div>
            <div>
                <label class="lt-field-label">@Resources.Strings.LineaTiempo_LabelRango</label>
                <div class="rango-atajos" id="balAtajos">
                    <div class="rango-atajos-grupo">
                        <button type="button" data-preset="todo">@Resources.Strings.Rango_Todo</button>
                    </div>
                    <div class="rango-atajos-grupo">
                        <button type="button" data-preset="ytd">@Resources.Strings.Rango_AnioEnCurso</button>
                        <button type="button" data-preset="6m">@Resources.Strings.Rango_Ultimos6Meses</button>
                        <button type="button" data-preset="3m">@Resources.Strings.Rango_UltimoTrimestre</button>
                        <button type="button" data-preset="mesAnterior">@Resources.Strings.Rango_MesAnterior</button>
                        <button type="button" data-preset="mesActual">@Resources.Strings.Rango_MesActual</button>
                    </div>
                </div>
                <div class="lt-range-card">
                    <div class="lt-range-head">
                        <span class="lbl"><span id="balRangoDesdeLbl">&mdash;</span><i class="fas fa-long-arrow-alt-right"></i><span id="balRangoHastaLbl">&mdash;</span></span>
                        <span class="lt-range-badge" id="balRangoBadge">&mdash;</span>
                    </div>
                    <div class="lt-range-track disabled" id="balRangoTrack">
                        <div class="bg"></div>
                        <div class="sel" id="balRangoSel"></div>
                        <div class="knob from" id="balKnobFrom" tabindex="0" role="slider" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" aria-label="@Resources.Strings.LineaTiempo_LabelRango"></div>
                        <div class="knob to" id="balKnobTo" tabindex="0" role="slider" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" aria-label="@Resources.Strings.LineaTiempo_LabelRango"></div>
                    </div>
                    <div class="lt-range-years" id="balRangoYears"></div>
                </div>
                <p class="lt-help">@Resources.Strings.BAL_RangoCorteHint</p>
                <p class="lt-help" id="balSinMeses" style="display:none;">@Resources.Strings.BAL_SinMesesDatos</p>
            </div>
        </div>

        <div class="btn-group-actions">
            <button type="button" id="btnConsultarBAL" class="btn btn-modern-gradient" disabled>
                <i class="fas fa-arrow-right mr-1"></i>@Resources.Strings.LineaTiempo_BtnGenerar
            </button>
            <button type="button" id="btnLimpiarBAL" class="btn btn-modern-secondary">@Resources.Strings.Common_Limpiar</button>
        </div>
    </div>

    <div id="balEstadoInicial" class="lt-card lt-empty">
        <div class="lt-empty-icon"><i class="fas fa-scale-balanced"></i></div>
        <h4>@Resources.Strings.BAL_EstadoInicialTitulo</h4>
        <p>@Resources.Strings.BAL_EstadoInicialDesc</p>
    </div>

    <div id="balSinDatos" class="lt-card lt-empty" style="display:none;">
        <div class="lt-empty-icon"><i class="fas fa-inbox"></i></div>
        <h4>@Resources.Strings.BAL_SinDatosTitulo</h4>
        <p id="balSinDatosDesc">@Resources.Strings.BAL_SinDatosDesc</p>
    </div>

    <div id="balResultado" style="display:none;">

        @* 1. Encabezado: marca + empresa + chips de contexto + unidad/exportaciones *@
        <div class="lt-card" id="balPanelResultado">
            <div class="pyg2-letterhead">
                <span class="pyg2-brand"><span class="bm-text">@Resources.Strings.LineaTiempo_BrandMark</span><span class="bm-sub">@Resources.Strings.BAL_V2_Subtitulo</span></span>
                <span class="fecha"><span>@Resources.Strings.BAL_V2_GeneradoEl</span> <span id="balFechaGenerado">&mdash;</span></span>
            </div>
            <div class="pyg2-head">
                <div class="pyg2-head-l">
                    <h2 id="balTituloEmpresa">&mdash;</h2>
                    <div class="pyg2-chips">
                        <span class="pyg2-chip primary"><i class="fas fa-calendar"></i><span id="balChipCorte">&mdash;</span></span>
                        <span class="pyg2-chip" id="balChipEscenario">&mdash;</span>
                        <span class="pyg2-chip" id="balChipComparado">&mdash;</span>
                    </div>
                </div>
                <div class="pyg2-tools">
                    <button type="button" class="lt-tool-btn" id="balBtnUnidad" aria-haspopup="menu" aria-expanded="false">
                        <span class="lbl-muted">@Resources.Strings.BAL_V2_Unidad</span><span id="balUnidadLbl">@Resources.Strings.LineaTiempo_UnidadMillones</span><i class="fas fa-chevron-down chev"></i>
                    </button>
                    <div class="lt-menu" id="balMenuUnidad" role="menu">
                        <button type="button" data-unidad="pesos" role="menuitemradio">@Resources.Strings.LineaTiempo_UnidadPesos<i class="fas fa-check"></i></button>
                        <button type="button" data-unidad="miles" role="menuitemradio">@Resources.Strings.LineaTiempo_UnidadMiles<i class="fas fa-check"></i></button>
                        <button type="button" data-unidad="millones" role="menuitemradio">@Resources.Strings.LineaTiempo_UnidadMillones<i class="fas fa-check"></i></button>
                    </div>
                    <span class="sep"></span>
                    <button type="button" class="lt-tool-btn" id="btnExportarExcelBAL" title="@Resources.Strings.Common_ExportarExcel"><i class="fas fa-file-excel"></i>@Resources.Strings.BAL_V2_Excel</button>
                    <button type="button" class="lt-tool-btn" id="btnExportarPdfBAL" title="@Resources.Strings.BAL_BtnExportarPdf"><i class="fas fa-file-pdf"></i>@Resources.Strings.BAL_V2_Pdf</button>
                </div>
            </div>
        </div>
        <form id="frmExportarExcelBAL" method="post" action="@Url.Action("ExportarExcel", "InformeBalance")">
            @Html.AntiForgeryToken()
            <div id="balExpCampos"></div>@* los llena el botón Excel con los filtros del reporte consultado *@
        </form>

        @* 2. Chequeo de cuadre *@
        <div class="bal-cuadre-strip" id="balCuadreStrip"></div>

        @* 3. KPIs *@
        <div class="pyg2-section">
            <div class="pyg2-section-title">
                <span class="t">@Resources.Strings.BAL_V2_IndicadoresClave</span><span class="line"></span>
            </div>
            <div class="pyg2-kpis" id="balKpiStrip"></div>
        </div>

        @* 4. Estructura + Lo más relevante *@
        <div class="pyg2-analysis">
            <div class="pyg2-card">
                <div class="pyg2-card-head">
                    <div>
                        <div class="pyg2-card-title">@Resources.Strings.BAL_EstructuraTitulo</div>
                        <div class="pyg2-card-sub" id="balEstructuraSub">&mdash;</div>
                    </div>
                    <span class="pyg2-legend" id="balEstructuraLeyenda"></span>
                </div>
                <div class="pyg2-waterfall-wrap"><canvas id="balChartEstructura"></canvas></div>
            </div>
            <div class="pyg2-card" id="balHighlights" style="gap:12px">
                <div>
                    <div class="pyg2-card-title"><i class="fas fa-bolt"></i>@Resources.Strings.BAL_RelevanteTitulo</div>
                    <div class="pyg2-card-sub" id="balRelevanteSub">&mdash;</div>
                </div>
                <div class="pyg2-hl-list" id="balHighlightsList"></div>
            </div>
        </div>

        @* 5. Tendencias *@
        <div class="pyg2-section">
            <div class="pyg2-section-title">
                <span class="t"><span id="balTendTitulo">@Resources.Strings.BAL_TendenciaTitulo</span> <span id="balTendAnio"></span></span><span class="line"></span>
                <span class="pyg2-legend">
                    <span><i class="sw" style="background:#6366F1"></i><span id="balLeyendaReal">@Resources.Strings.PYG_V2_Real</span></span>
                    <span id="balLeyendaEsc" style="display:none;"><i class="sw" style="background:#0EA5E9"></i><span id="balLeyendaEscNombre"></span></span>
                    <span><i class="sq" style="background:#EEF2FF;width:10px;height:10px;border-radius:2px"></i>@Resources.Strings.BAL_PeriodoSeleccionado</span>
                </span>
            </div>
            <div class="pyg2-trends">
                <div class="pyg2-trend">
                    <div class="pyg2-trend-head">
                        <div><div class="nm">@Resources.Strings.BAL_KpiCapitalTrabajo</div><div class="v" id="balTrendValCapitalTrabajo">&mdash;</div></div>
                        <span class="pyg2-dchip" id="balTrendChipCapitalTrabajo"></span>
                    </div>
                    <div class="pyg2-trend-canvas"><canvas id="balChartCapitalTrabajo"></canvas></div>
                </div>
                <div class="pyg2-trend">
                    <div class="pyg2-trend-head">
                        <div><div class="nm">@Resources.Strings.BAL_KpiRazonCorriente</div><div class="v" id="balTrendValRazonCorriente">&mdash;</div></div>
                        <span class="pyg2-dchip" id="balTrendChipRazonCorriente"></span>
                    </div>
                    <div class="pyg2-trend-canvas"><canvas id="balChartRazonCorriente"></canvas></div>
                </div>
                <div class="pyg2-trend">
                    <div class="pyg2-trend-head">
                        <div><div class="nm">@Resources.Strings.BAL_KpiEndeudamiento</div><div class="v" id="balTrendValEndeudamiento">&mdash;</div></div>
                        <span class="pyg2-dchip" id="balTrendChipEndeudamiento"></span>
                    </div>
                    <div class="pyg2-trend-canvas"><canvas id="balChartEndeudamiento"></canvas></div>
                </div>
            </div>
        </div>

        @* 6. Tabla detallada *@
        <div class="pyg2-table-card">
            <div class="pyg2-card-head" style="align-items:center">
                <div>
                    <div class="pyg2-card-title">@Resources.Strings.BAL_TablaTitulo</div>
                    <div class="pyg2-card-sub" id="balInfoBadge">@Resources.Strings.BAL_UnidadMillones</div>
                </div>
            </div>
            <div class="pyg2-table-wrap">
                <table class="pyg2-table" id="balTabla"><thead id="balTablaHead"></thead><tbody id="balTablaBody"></tbody></table>
            </div>
            <div class="pyg2-table-legend">
                <span><i class="dot" style="background:#16A34A"></i>@Resources.Strings.BAL_Favorable</span>
                <span><i class="dot" style="background:#DC2626"></i>@Resources.Strings.BAL_LeyendaDesfavorable</span>
                <span><i class="fas fa-circle-exclamation"></i>@Resources.Strings.BAL_LeyendaCritico</span>
            </div>
        </div>
        <p class="lt-help" id="balNotaSinComparativo" style="display:none;"></p>
        <p class="lt-help" id="balNotaEscenario" style="display:none;"></p>

        @* Insights gerenciales (IA): se ocultan si la empresa tiene la IA apagada *@
        @if (bufinscustomers.Helpers.IAModuloHelper.Visible())
        {
        <div class="pyg-insights-card">
            <div class="pyg-insights-head">
                <div>
                    <span class="pyg-insights-title"><i class="fas fa-wand-magic-sparkles"></i>@Resources.Strings.BAL_InsightsTitulo</span>
                    <div class="pyg-insights-meta" id="balInsightsMeta">@Resources.Strings.BAL_InsightsSub</div>
                </div>
                <button type="button" id="btnGenerarInsightsBAL" class="pyg2-ins-btn"><i class="fas fa-wand-magic-sparkles"></i><span>@Resources.Strings.BAL_Generar</span></button>
            </div>
            <div id="balInsightsBody"></div>
            <div id="balInsightsLoading" style="display:none;text-align:center;padding:14px 0;">
                @Html.Partial("_LoaderDots", "dark")
                <p style="margin-top:8px;font-size:12.5px;color:#8B85A0;">@Resources.Strings.BAL_Analizando</p>
            </div>

            <div class="mt-3">
                <label for="balPregunta" class="mb-1" style="font-weight:700;"><i class="fas fa-comments mr-1"></i>@Resources.Strings.IAInforme_Titulo</label>
                <div class="d-flex" style="gap:8px;flex-wrap:wrap;">
                    <input type="text" id="balPregunta" class="form-control" maxlength="@bufinscustomers.Helpers.IAModuloHelper.MaxCharsPregunta()" style="flex:1;min-width:240px;"
                           placeholder="@Resources.Strings.IAInforme_Placeholder" />
                    <button type="button" id="btnBalPreguntar" class="pyg2-ins-btn"><i class="fas fa-paper-plane"></i><span>@Resources.Strings.IAInforme_Btn</span></button>
                </div>
                <div id="balRespuesta" class="mt-2"></div>
            </div>
        </div>
        }
    </div>

</div>
</div>

<div id="overlayConsultandoBAL" class="overlay-cargando" style="display:none;">
    <div class="overlay-cargando-card">
        @Html.Partial("_LoaderDots", "aqua")
        <h5 class="overlay-cargando-title">@Resources.Strings.BAL_JS_Consultando</h5>
    </div>
</div>

@section scripts {
<script src="~/Assets/js/select2/select2.min.js"></script>
<script src="~/Assets/js/chart.umd.min.js"></script>
<script src="~/Assets/js/jspdf.umd.min.js"></script>
<script src="~/Assets/js/bufins-markdown.js"></script>
<script src="~/Assets/js/rango-atajos.js"></script>

<script>
    var _bal = {
        urls: {
            meses: '@Url.Action("ObtenerMeses", "InformeBalance")',
            reporte: '@Url.Action("ConsultarReporte", "InformeBalance")',
            insights: '@Url.Action("GenerarInsightsIA", "InformeBalance")',
            preguntar: '@Url.Action("PreguntarInforme", "InformeBalance")'
        },
        token: $('input[name="__RequestVerificationToken"]').first().val(),
        cultura: '@Html.Raw(HttpUtility.JavaScriptStringEncode(culturaJs))',
        esAdmin: @Html.Raw(esAdmin.ToString().ToLowerInvariant()),
        mesesNombres: [
            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Mes1))',
            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Mes2))',
            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Mes3))',
            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Mes4))',
            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Mes5))',
            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Mes6))',
            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Mes7))',
            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Mes8))',
            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Mes9))',
            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Mes10))',
            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Mes11))',
            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Mes12))'
        ],
        textos: {
            colCuenta: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_ColCuenta))',
            colSaldoCorte: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_ColSaldoCorte))',
            colPctVertical: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_ColPctVertical))',
            colVarAbs: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_ColVarAbs))',
            colVarPct: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_ColVarPct))',
            colCorteGrupoFmt: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_ColCorteGrupoFmt))',
            errorServidor: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_ErrorServidor))',
            badgeMes: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_BadgeMes))',
            badgeMeses: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_BadgeMeses))',
            unidades: {
                pesos: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_UnidadPesos))',
                miles: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_UnidadMiles))',
                millones: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_UnidadMillones))'
            },
            unidadSufijoMiles: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_UnidadSufijoMiles))',
            unidadSufijoMillones: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.LineaTiempo_UnidadSufijoMillones))',
            unidadBadge: {
                pesos: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_UnidadPesosCop))',
                miles: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_UnidadMilesCop))',
                millones: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_UnidadMillones))'
            },
            v2: {
                generar: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_Generar))',
                regenerar: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_Regenerar))',
                insightsVacio: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_InsightsVacio))',
                insightsSub: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_InsightsSub))',
                insightsMetaFmt: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_InsightsMetaFmt))',
                liquidez: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_Liquidez))',
                solvencia: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_Solvencia))',
                capitalTrabajo: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_KpiCapitalTrabajo))',
                comparadoConFmt: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_V2_ComparadoConFmt))',
                corteFmt: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_V2_CorteFmt))',
                vsFmt: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_V2_VsFmt))',
                favorable: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_Favorable))',
                desfavorableCorto: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_DesfavorableCorto))',
                sinDestacados: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_SinDestacados))',
                relevanteSubFmt: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_RelevanteSubFmt))',
                estructuraSubFmt: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_EstructuraSubFmt))',
                noAplica: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_KpiNoAplica))',
                sinComparativoNotaFmt: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.BAL_SinComparativoNota))',
