    function separarInsightsGM(texto) {
        var claves = { resultado: /^(resultado|result)/i, caja: /^(caja y balance|cash and balance|caja)/i, foco: /^(foco del mes|focus of the month|foco)/i };
        var etiqueta = /^(\*\*|__)?\s*(resultado|result|caja y balance|cash and balance|caja|foco del mes|focus of the month|foco)[^:]*:\s*(\*\*|__)?\s*/i;
        var partes = { resultado: [], caja: [], foco: [] }, actual = null;
        (texto || '').split(/\r?\n/).forEach(function (linea) {
            var conFormato = linea.replace(/^\s*(?:[-•>#]+|\*(?=\s)|\d+[.)])\s*/, '').trim(), plano = conFormato.replace(/\*\*|__/g, '').trim();
            if (!plano) return;
            var enc = null; Object.keys(claves).forEach(function (k) { if (!enc && claves[k].test(plano)) enc = k; });
            if (enc) { actual = enc; var resto = plano.indexOf(':') >= 0 ? conFormato.replace(etiqueta, '').trim() : ''; if (resto) partes[actual].push(resto); return; }
            if (actual) partes[actual].push(conFormato);
        });
        if (!partes.resultado.length || !partes.caja.length || !partes.foco.length) return null;
        return { resultado: partes.resultado.join(' '), caja: partes.caja.join(' '), foco: partes.foco.join(' ') };
    }
    function negritasGM(t) { return escHtmlGM(t).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/__(.+?)__/g, '<strong>$1</strong>').replace(/\*\*|__/g, ''); }
    function pintarInsightsGM(texto) {
        var s = separarInsightsGM(texto);
        if (!s) { var md = (typeof window.bufinsMarkdown === 'function') ? window.bufinsMarkdown(texto) : escHtmlGM(texto).replace(/\n/g, '<br>'); $('#gmInsightsBody').html('<div class="pyg-insights-body">' + md + '</div>'); return; }
        var tiles = [
            { cls: 'logro', icono: 'fa-chart-line', titulo: _gm.t.insResultado, texto: s.resultado },
            { cls: 'alerta', icono: 'fa-money-bill-wave', titulo: _gm.t.insCaja, texto: s.caja },
            { cls: 'eficiencia', icono: 'fa-bullseye', titulo: _gm.t.insFoco, texto: s.foco }
        ];
        $('#gmInsightsBody').html('<div class="pyg2-ins-grid">' + tiles.map(function (t) {
