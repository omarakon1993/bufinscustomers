@using System.Web
@using System.Linq
@using bufinscustomers.Models
@functions {
    static string J(string s) { return System.Web.HttpUtility.JavaScriptStringEncode(s ?? ""); }
}
@{
    ViewBag.Title = Resources.Strings.GM_PageTitle;
    var empresas = ViewBag.Empresas as List<Empresas>;
    var esAdmin = (bool)(ViewBag.EsAdmin ?? false);
    var culturaJs = System.Globalization.CultureInfo.CurrentUICulture.Name;
}

<link href="~/Assets/css/bufins-components.css" rel="stylesheet" />
<link href="~/Assets/css/informe-linea-tiempo.css" rel="stylesheet" />
<link href="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/css/informe-pyg.css")" rel="stylesheet" />
<link href="~/Assets/css/informe-balance.css" rel="stylesheet" />
<link href="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/css/informe-gerencia-mensual.css")" rel="stylesheet" />
<link href="~/Assets/css/export-menu.css" rel="stylesheet" />
<link href="~/Assets/css/doc-visor.css" rel="stylesheet" />
<link href="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/css/empresa-logo.css")" rel="stylesheet" />
<link href="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/css/tema-informe.css")" rel="stylesheet" />
<link href="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/css/comentarios-gestion.css")" rel="stylesheet" />
<link href="~/Assets/css/select2/select2.min.css" rel="stylesheet" />

<div class="container-fluid px-4">
<div class="lt-app">

    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas fa-file-lines powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@Resources.Strings.GM_PageTitle</h1>
            @Html.Partial("_ModeloBufinsTag")
            <button type="button" class="header-tag-doc" id="gmDocBtn" title="@Resources.Strings.GM_DocumentacionTooltip"><i class="fas fa-book"></i>@Resources.Strings.Common_DocumentacionTag</button>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <div class="filter-card">
        <div class="lt-section-title"><span>@Resources.Strings.Common_FiltrosConsulta</span></div>
        <div class="lt-grid-quever">
            <div class="lt-field">
                <label class="lt-field-label" for="gmEmpresa">@Resources.Strings.Common_LabelEmpresa</label>
                <select id="gmEmpresa" class="lt-field-select">
                    @if (esAdmin) { <option value="">@Resources.Strings.Common_Seleccione</option> }
                    @if (empresas != null)
                    {
                        foreach (var e in empresas) { <option value="@e.Id">@e.Nombre</option> }
                    }
                </select>
            </div>
            <div class="lt-field">
                <label class="lt-field-label" for="gmEscenario">@Resources.Strings.Common_LabelEscenario</label>
                <select id="gmEscenario" class="lt-field-select">
                    @if (ViewBag.Escenarios != null)
                    {
                        foreach (var esc in ViewBag.Escenarios) { <option value="@esc.Id">@esc.Nombre</option> }
                    }
                </select>
            </div>
            <div class="lt-field">
                <label class="lt-field-label" for="gmMes">@Resources.Strings.GM_MesCierre</label>
                <select id="gmMes" class="lt-field-select" disabled></select>
            </div>
        </div>
        <p class="lt-help" id="gmSinMeses" style="display:none;">@Resources.Strings.GM_SinMesesDatos</p>

        @Html.Partial("_TemaInformeSelector", "gmTema")

        <div class="btn-group-actions">
            <button type="button" id="btnConsultarGM" class="btn btn-modern-gradient" disabled>
                <i class="fas fa-arrow-right mr-1"></i>@Resources.Strings.LineaTiempo_BtnGenerar
            </button>
            <button type="button" id="btnLimpiarGM" class="btn btn-modern-secondary">@Resources.Strings.Common_Limpiar</button>
        </div>
    </div>

    <div id="gmEstadoInicial" class="lt-card lt-empty">
        <div class="lt-empty-icon"><i class="fas fa-file-lines"></i></div>
        <h4>@Resources.Strings.GM_EstadoInicialTitulo</h4>
        <p>@Resources.Strings.GM_EstadoInicialDesc</p>
    </div>

    <div id="gmSinDatos" class="lt-card lt-empty" style="display:none;">
        <div class="lt-empty-icon"><i class="fas fa-inbox"></i></div>
        <h4>@Resources.Strings.GM_SinDatosTitulo</h4>
        <p>@Resources.Strings.GM_SinDatosDesc</p>
    </div>

    <div id="gmResultado" style="display:none;">

        <div class="lt-card" id="gmPanelResultado">
            <div class="pyg2-letterhead">
                <span class="pyg2-brand"><img class="bm-logo" src="~/Assets/img/Bufins_Wordmark_Purple.png" alt="Bufins" height="14"><span class="bm-sub">@Resources.Strings.GM_V2_Subtitulo</span></span>
                <span class="fecha"><span>@Resources.Strings.BAL_V2_GeneradoEl</span> <span id="gmFechaGenerado">&mdash;</span></span>
            </div>
            <div class="pyg2-head">
                <div class="pyg2-head-l">
                    <span class="emp-logo-plate" id="gmLogo" hidden><img alt="@Resources.Strings.Common_LogoEmpresaAlt"></span>
                    <div class="emp-logo-texto">
                        <h2 id="gmTituloEmpresa">&mdash;</h2>
                        <div class="pyg2-chips">
                            <span class="pyg2-chip primary"><i class="fas fa-calendar"></i><span id="gmChipCierre">&mdash;</span></span>
                            <span class="pyg2-chip" id="gmChipEscenario">&mdash;</span>
                        </div>
                    </div>
                </div>
                <div class="pyg2-tools">
                    <button type="button" class="lt-tool-btn" id="gmBtnUnidad" aria-haspopup="menu" aria-expanded="false">
                        <span class="lbl-muted">@Resources.Strings.BAL_V2_Unidad</span><span id="gmUnidadLbl">@Resources.Strings.LineaTiempo_UnidadMillones</span><i class="fas fa-chevron-down chev"></i>
                    </button>
                    <div class="lt-menu" id="gmMenuUnidad" role="menu">
                        <button type="button" data-unidad="pesos" role="menuitemradio">@Resources.Strings.LineaTiempo_UnidadPesos<i class="fas fa-check"></i></button>
                        <button type="button" data-unidad="miles" role="menuitemradio">@Resources.Strings.LineaTiempo_UnidadMiles<i class="fas fa-check"></i></button>
                        <button type="button" data-unidad="millones" role="menuitemradio">@Resources.Strings.LineaTiempo_UnidadMillones<i class="fas fa-check"></i></button>
                    </div>
                    <span class="sep"></span>
                    @Html.Partial("_ExportMenu", new bufinscustomers.Models.ExportMenuVM { Id = "gmExp", ExcelDesc = Resources.Strings.GM_Exp_ExcelDesc })
                </div>
            </div>
        </div>
        <form id="frmExportarExcelGM" method="post" action="@Url.Action("ExportarExcel", "InformeGerenciaMensual")">
            @Html.AntiForgeryToken()
            <div id="gmExpCampos"></div>
        </form>

        @if (bufinscustomers.Helpers.IAModuloHelper.Visible())
        {
        <div class="pyg-insights-card">
            <div class="pyg-insights-head">
                <div>
                    <span class="pyg-insights-title"><i class="fas fa-wand-magic-sparkles"></i>@Resources.Strings.GM_InsightsTitulo</span>
                    <div class="pyg-insights-meta" id="gmInsightsMeta">@Resources.Strings.GM_InsightsSub</div>
                </div>
                <button type="button" id="btnGenerarInsightsGM" class="pyg2-ins-btn"><i class="fas fa-wand-magic-sparkles"></i><span>@Resources.Strings.BAL_Generar</span></button>
            </div>
            <div id="gmInsightsBody"></div>
            <div id="gmInsightsLoading" style="display:none;text-align:center;padding:14px 0;">
                @Html.Partial("_LoaderDots", "dark")
                <p style="margin-top:8px;font-size:12.5px;color:#8B85A0;">@Resources.Strings.BAL_Analizando</p>
            </div>
            <div class="mt-3">
                <label for="gmPregunta" class="mb-1" style="font-weight:700;"><i class="fas fa-comments mr-1"></i>@Resources.Strings.IAInforme_Titulo</label>
                <div class="d-flex" style="gap:8px;flex-wrap:wrap;">
                    <input type="text" id="gmPregunta" class="form-control" maxlength="@bufinscustomers.Helpers.IAModuloHelper.MaxCharsPregunta()" style="flex:1;min-width:240px;"
                           placeholder="@Resources.Strings.IAInforme_Placeholder" />
                    <button type="button" id="btnGmPreguntar" class="pyg2-ins-btn"><i class="fas fa-paper-plane"></i><span>@Resources.Strings.IAInforme_Btn</span></button>
                </div>
                <div id="gmRespuesta" class="mt-2"></div>
            </div>
        </div>
        }

        <div class="pyg2-section" id="gmSecResultados">
            <div class="pyg2-section-title"><span class="t">@Resources.Strings.GM_SecResultados</span><span class="line"></span></div>
            <div class="gm-grid3" id="gmResultadosGrid"></div>
        </div>

        <div class="gm-grid2">
            <div class="pyg2-card" id="gmSecBalance">
                <div class="pyg2-card-head"><div><div class="pyg2-card-title"><i class="fas fa-scale-balanced"></i>@Resources.Strings.GM_SecBalance</div>
                    <div class="pyg2-card-sub" id="gmBalanceSub">&mdash;</div></div></div>
                <div id="gmBalanceBody"></div>
            </div>
            <div class="pyg2-card" id="gmSecCaja">
                <div class="pyg2-card-head"><div><div class="pyg2-card-title"><i class="fas fa-money-bill-wave"></i>@Resources.Strings.GM_SecCaja</div>
                    <div class="pyg2-card-sub" id="gmCajaSub">&mdash;</div></div></div>
                <div id="gmCajaBody"></div>
            </div>
        </div>

        <div class="gm-grid2">
            <div class="pyg2-card" id="gmSecIndicadores">
                <div class="pyg2-card-head"><div><div class="pyg2-card-title"><i class="fas fa-traffic-light"></i>@Resources.Strings.GM_AtencionTitulo</div>
                    <div class="pyg2-card-sub">@Resources.Strings.GM_AtencionSub</div></div></div>
                <div class="gm-semaforo" id="gmSemaforo"></div>
                <div id="gmAtencionBody"></div>
            </div>
            <div class="pyg2-card" id="gmSecLineas">
                <div class="pyg2-card-head"><div><div class="pyg2-card-title"><i class="fas fa-sitemap"></i>@Resources.Strings.GM_LineasTitulo</div>
                    <div class="pyg2-card-sub">@Resources.Strings.GM_LineasSub</div></div></div>
                <div class="pyg2-table-wrap"><table class="pyg2-table" id="gmTablaLineas"><thead id="gmLineasHead"></thead><tbody id="gmLineasBody"></tbody></table></div>
            </div>
        </div>

        @Html.Partial("_ComentariosGestion", "gmComentarios")
    </div>

</div>
</div>

<div id="overlayConsultandoGM" class="overlay-cargando" style="display:none;">
    <div class="overlay-cargando-card">
        @Html.Partial("_LoaderDots", "aqua")
        <h5 class="overlay-cargando-title">@Resources.Strings.BAL_JS_Consultando</h5>
    </div>
</div>

@Html.Partial("_ExportCorreoModal", new bufinscustomers.Models.ExportCorreoVM())
@Html.Partial("_DocumentacionVisor", Resources.Strings.GM_Doc_ModalTitulo)

@section scripts {
<script src="~/Assets/js/select2/select2.min.js"></script>
<script src="~/Assets/js/jspdf.umd.min.js"></script>
<script src="~/Assets/js/bufins-pdf-marca.js"></script>
<script src="~/Assets/js/html2canvas.min.js"></script>
<script src="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/js/empresa-logo.js")"></script>
<script src="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/js/informe-tema.js")"></script>
<script src="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/js/comentarios-gestion.js")"></script>
<script src="~/Assets/js/export-menu.js"></script>
<script src="~/Assets/js/doc-visor.js"></script>
<script src="~/Assets/js/bufins-markdown.js"></script>

<script>
    var EXP_T = {
        generando: '@Html.Raw(J(Resources.Strings.Common_Exp_Generando))', errorGenerar: '@Html.Raw(J(Resources.Strings.Common_Exp_ErrorGenerar))',
        listo: '@Html.Raw(J(Resources.Strings.Common_Exp_Listo))', imagenCopiada: '@Html.Raw(J(Resources.Strings.Common_Exp_ImagenCopiada))',
        imagenDescargada: '@Html.Raw(J(Resources.Strings.Common_Exp_ImagenDescargada))', valDestino: '@Html.Raw(J(Resources.Strings.RevisarCargue_Correo_ValDestino))',
        valMaximo: '@Html.Raw(J(Resources.Strings.RevisarCargue_Correo_ValMaximo))', enviando: '@Html.Raw(J(Resources.Strings.RevisarCargue_Correo_Enviando))',
        error: '@Html.Raw(J(Resources.Strings.Common_ExpCorreo_Error))', exitoTitulo: '@Html.Raw(J(Resources.Strings.Modelo_Correo_ExitoTitulo))', aceptar: '@Html.Raw(J(Resources.Strings.Common_Aceptar))'
    };

    var _gm = {
        urls: {
            meses: '@Url.Action("ObtenerMeses", "InformeGerenciaMensual")', reporte: '@Url.Action("ConsultarReporte", "InformeGerenciaMensual")',
            insights: '@Url.Action("GenerarInsightsIA", "InformeGerenciaMensual")', preguntar: '@Url.Action("PreguntarInforme", "InformeGerenciaMensual")'
        },
        token: $('input[name="__RequestVerificationToken"]').first().val(),
        cultura: '@Html.Raw(J(culturaJs))',
        esAdmin: @Html.Raw(esAdmin.ToString().ToLowerInvariant()),
        mesesNombres: [
            '@Html.Raw(J(Resources.Strings.Common_Mes1))', '@Html.Raw(J(Resources.Strings.Common_Mes2))', '@Html.Raw(J(Resources.Strings.Common_Mes3))', '@Html.Raw(J(Resources.Strings.Common_Mes4))',
            '@Html.Raw(J(Resources.Strings.Common_Mes5))', '@Html.Raw(J(Resources.Strings.Common_Mes6))', '@Html.Raw(J(Resources.Strings.Common_Mes7))', '@Html.Raw(J(Resources.Strings.Common_Mes8))',
            '@Html.Raw(J(Resources.Strings.Common_Mes9))', '@Html.Raw(J(Resources.Strings.Common_Mes10))', '@Html.Raw(J(Resources.Strings.Common_Mes11))', '@Html.Raw(J(Resources.Strings.Common_Mes12))'
        ],
        t: {
            errorServidor: '@Html.Raw(J(Resources.Strings.BAL_ErrorServidor))',
            unidades: { pesos: '@Html.Raw(J(Resources.Strings.LineaTiempo_UnidadPesos))', miles: '@Html.Raw(J(Resources.Strings.LineaTiempo_UnidadMiles))', millones: '@Html.Raw(J(Resources.Strings.LineaTiempo_UnidadMillones))' },
            unidadSufijoMiles: '@Html.Raw(J(Resources.Strings.LineaTiempo_UnidadSufijoMiles))', unidadSufijoMillones: '@Html.Raw(J(Resources.Strings.LineaTiempo_UnidadSufijoMillones))',
            unidadBadge: { pesos: '@Html.Raw(J(Resources.Strings.BAL_UnidadPesosCop))', miles: '@Html.Raw(J(Resources.Strings.BAL_UnidadMilesCop))', millones: '@Html.Raw(J(Resources.Strings.BAL_UnidadMillones))' },
            generar: '@Html.Raw(J(Resources.Strings.BAL_Generar))', regenerar: '@Html.Raw(J(Resources.Strings.BAL_Regenerar))',
            insightsVacio: '@Html.Raw(J(Resources.Strings.GM_InsightsVacio))', insightsSub: '@Html.Raw(J(Resources.Strings.GM_InsightsSub))', insightsMetaFmt: '@Html.Raw(J(Resources.Strings.GM_InsightsMetaFmt))',
            insResultado: '@Html.Raw(J(Resources.Strings.GM_InsResultado))', insCaja: '@Html.Raw(J(Resources.Strings.GM_InsCaja))', insFoco: '@Html.Raw(J(Resources.Strings.GM_InsFoco))',
            cierreFmt: '@Html.Raw(J(Resources.Strings.GM_CierreFmt))', sinSeccion: '@Html.Raw(J(Resources.Strings.GM_SinSeccion))',
            real: '@Html.Raw(J(Resources.Strings.GM_Col_Real))', presupuesto: '@Html.Raw(J(Resources.Strings.GM_Col_Presupuesto))', vsPpto: '@Html.Raw(J(Resources.Strings.GM_VsPpto))',
            vsAnio: '@Html.Raw(J(Resources.Strings.GM_VsAnio))', acumulado: '@Html.Raw(J(Resources.Strings.GM_Acumulado))', vsCierre: '@Html.Raw(J(Resources.Strings.GM_VsCierre))',
            cajaInicial: '@Html.Raw(J(Resources.Strings.GM_CajaInicial))', flujoNeto: '@Html.Raw(J(Resources.Strings.GM_FlujoNeto))', flujoNetoPpto: '@Html.Raw(J(Resources.Strings.GM_FlujoNetoPpto))',
            fcl: '@Html.Raw(J(Resources.Strings.GM_Fcl))', cajaFinal: '@Html.Raw(J(Resources.Strings.GM_CajaFinal))',
            cajaCuadra: '@Html.Raw(J(Resources.Strings.GM_CajaCuadra))', cajaNoCuadra: '@Html.Raw(J(Resources.Strings.GM_CajaNoCuadra))',
            balCuadra: '@Html.Raw(J(Resources.Strings.BAL_CuadreOk))', balNoCuadra: '@Html.Raw(J(Resources.Strings.GM_BalanceNoCuadra))',
            noAplica: '@Html.Raw(J(Resources.Strings.BAL_KpiNoAplica))', sinAtencion: '@Html.Raw(J(Resources.Strings.GM_SinAtencion))',
            colIndicador: '@Html.Raw(J(Resources.Strings.GM_Col_Indicador))', colValor: '@Html.Raw(J(Resources.Strings.GM_Col_Valor))', colSemaforo: '@Html.Raw(J(Resources.Strings.GM_Col_Semaforo))',
            colLinea: '@Html.Raw(J(Resources.Strings.LN_Col_Linea))', colIngresos: '@Html.Raw(J(Resources.Strings.LN_Col_Ingresos))', colPct: '@Html.Raw(J(Resources.Strings.LN_Col_PctIngresos))', colMargen: '@Html.Raw(J(Resources.Strings.LN_Col_MargenOperacional))',
            res: { Ingresos: '@Html.Raw(J(Resources.Strings.GM_Res_Ingresos))', Ebitda: '@Html.Raw(J(Resources.Strings.GM_Res_Ebitda))', UtilidadNeta: '@Html.Raw(J(Resources.Strings.GM_Res_UtilidadNeta))' },
            bal: { ActivoTotal: '@Html.Raw(J(Resources.Strings.BAL_KpiActivoTotal))', CapitalTrabajo: '@Html.Raw(J(Resources.Strings.BAL_KpiCapitalTrabajo))', RazonCorriente: '@Html.Raw(J(Resources.Strings.BAL_KpiRazonCorriente))', Endeudamiento: '@Html.Raw(J(Resources.Strings.BAL_KpiEndeudamiento))' },
            nivel: { verde: '@Html.Raw(J(Resources.Strings.GM_Nivel_verde))', amarillo: '@Html.Raw(J(Resources.Strings.GM_Nivel_amarillo))', naranja: '@Html.Raw(J(Resources.Strings.GM_Nivel_naranja))', rojo: '@Html.Raw(J(Resources.Strings.GM_Nivel_rojo))', gris: '@Html.Raw(J(Resources.Strings.GM_Nivel_gris))' },
            indNombres: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
                bufinscustomers.Services.IndicadoresCatalogo.Todos.ToDictionary(d => d.Codigo, d => (string)System.Web.HttpContext.GetGlobalResourceObject("Strings", "Ind_" + d.Codigo + "_Nombre")))),
            pdf: {
                marca: '@Html.Raw(J(Resources.Strings.LineaTiempo_BrandMark))', titulo: '@Html.Raw(J(Resources.Strings.GM_PageTitle))', subtitulo: '@Html.Raw(J(Resources.Strings.GM_V2_Subtitulo))',
                generadoEl: '@Html.Raw(J(Resources.Strings.BAL_V2_GeneradoEl))', confidencial: '@Html.Raw(J(Resources.Strings.BAL_Pdf_Confidencial))', paginaFmt: '@Html.Raw(J(Resources.Strings.BAL_Pdf_PaginaFmt))',
                sinInsights: '@Html.Raw(J(Resources.Strings.BAL_Pdf_SinInsights))', insights: '@Html.Raw(J(Resources.Strings.GM_InsightsTitulo))', comentarios: '@Html.Raw(J(Resources.Strings.Com_Titulo))',
                atencion: '@Html.Raw(J(Resources.Strings.GM_AtencionTitulo))', lineas: '@Html.Raw(J(Resources.Strings.GM_LineasTitulo))', pie: '@Html.Raw(J(Resources.Strings.GM_PdfFooter))'
            }
        },
        reporteActual: null, filtrosConsultados: null, insightsTexto: null, unidad: 'millones', meses: []
    };

    var elEmpresaGM = $('#gmEmpresa'), elEscenarioGM = $('#gmEscenario');
    var CH_MDASH_GM = String.fromCharCode(0x2014), CH_MIDDOT_GM = String.fromCharCode(0xB7);
    var s2langGM = {
        noResults: function () { return '@Html.Raw(J(Resources.Strings.Common_Select2NoResults))'; },
        searching: function () { return '@Html.Raw(J(Resources.Strings.Common_Select2Searching))'; }
    };

    function cargarPrefsGM() { try { var p = JSON.parse(localStorage.getItem('gm.prefs') || '{}'); if (['pesos', 'miles', 'millones'].indexOf(p.unidad) >= 0) _gm.unidad = p.unidad; } catch (e) { } }
    function guardarPrefsGM() { try { localStorage.setItem('gm.prefs', JSON.stringify({ unidad: _gm.unidad })); } catch (e) { } }
    function escHtmlGM(t) { return $('<span>').text(t == null ? '' : String(t)).html(); }
    function empresaGM() { var v = elEmpresaGM.val(); return v ? parseInt(v, 10) : null; }
    function escenarioGM() { var v = elEscenarioGM.val(); return v ? parseInt(v, 10) : 1; }

    function escalarGM(v) { return _gm.unidad === 'miles' ? v / 1000 : (_gm.unidad === 'millones' ? v / 1000000 : v); }
    function sufijoGM() { return _gm.unidad === 'miles' ? ' ' + _gm.t.unidadSufijoMiles : (_gm.unidad === 'millones' ? ' ' + _gm.t.unidadSufijoMillones : ''); }
    function decGM() { return _gm.unidad === 'pesos' ? 0 : 1; }
    function fmtNumGM(v) {
        if (v === null || v === undefined) return CH_MDASH_GM;
        try { return new Intl.NumberFormat(_gm.cultura, { minimumFractionDigits: decGM(), maximumFractionDigits: decGM() }).format(escalarGM(v)) + sufijoGM(); } catch (e) { return escalarGM(v) + sufijoGM(); }
    }
    function fmtPctGM(v) { if (v === null || v === undefined) return CH_MDASH_GM; try { return new Intl.NumberFormat(_gm.cultura, { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(v * 100) + '%'; } catch (e) { return (Math.round(v * 1000) / 10) + '%'; } }
    function fmtPctVarGM(v) {
        if (v === null || v === undefined) return CH_MDASH_GM;
        try { return new Intl.NumberFormat(_gm.cultura, { minimumFractionDigits: 1, maximumFractionDigits: 1, signDisplay: 'exceptZero' }).format(v * 100) + '%'; } catch (e) { var n = Math.round(v * 1000) / 10; return (n >= 0 ? '+' : '') + n + '%'; }
    }
    function fmtRatioGM(v) { if (v === null || v === undefined) return CH_MDASH_GM; try { return new Intl.NumberFormat(_gm.cultura, { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(v) + 'x'; } catch (e) { return (Math.round(v * 100) / 100) + 'x'; } }
    function fmtIndicadorGM(a) {
        if (a.Valor === null || a.Valor === undefined) return CH_MDASH_GM;
        if (a.Formato === 'pct') return fmtPctGM(a.Valor);
        if (a.Formato === 'x') return fmtRatioGM(a.Valor);
        if (a.Formato === 'dias') return Math.round(a.Valor) + ' d';
        return fmtNumGM(a.Valor);
    }
    function chipGM(valor, favorable) {
        if (valor === null || valor === undefined || isNaN(valor)) return '<span class="pyg2-dchip">' + CH_MDASH_GM + '</span>';
        return '<span class="pyg2-dchip ' + (favorable ? 'up' : 'down') + '"><i class="fas fa-caret-' + (valor >= 0 ? 'up' : 'down') + '"></i>' + escHtmlGM(fmtPctVarGM(valor)) + '</span>';
    }
    function mostrarErrorGM(m) { console.error('[InformeGerenciaMensual]', m); if (typeof Swal !== 'undefined') Swal.fire({ icon: 'error', title: '@Html.Raw(J(Resources.Strings.Common_Error))', text: m }); else alert(m); }
    function etiquetaCierre(r) { return _gm.mesesNombres[r.Mes - 1] + ' ' + r.Anio; }

    function actualizarBotonGM() { $('#btnConsultarGM').prop('disabled', !((!_gm.esAdmin || !!empresaGM()) && !!elEscenarioGM.val() && _gm.meses.length > 0)); }

    function cargarMesesGM() {
        _gm.meses = []; $('#gmMes').empty().prop('disabled', true); $('#gmSinMeses').hide();
