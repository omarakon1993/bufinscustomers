    // ===== PDF (A4 horizontal, jsPDF puro, 2 páginas) =====
    var PDF_COL_GM = {
        marca: [99, 102, 241], morado: [88, 58, 255], texto: [22, 18, 31], texto2: [91, 85, 112], muted: [139, 133, 160],
        linea: [228, 225, 240], suave: [244, 243, 251], suave2: [248, 247, 253], totalBg: [238, 242, 255],
        bueno: [22, 163, 74], buenoBg: [236, 253, 243], malo: [220, 38, 38], maloBg: [254, 242, 242], blanco: [255, 255, 255]
    };
    function generarPdfGM() {
        var r = _gm.reporteActual; if (!r) return Promise.resolve();
        return new Promise(function (ok, ko) {
            setTimeout(function () {
                try { var doc = construirPdfGM(r); doc.save(doc.__nombre); ExportMenu.aviso('success', EXP_T.listo); ok(); }
                catch (e) { console.error('[InformeGerenciaMensual] PDF', e); ko(e); }
            }, 30);
        });
    }
    function copiarImagenGM() {
        var empresa = ($('#gmTituloEmpresa').text() || 'GerenciaMensual').replace(/[^A-Za-z0-9]+/g, '_');
        return ExportMenu.copiarImagen(document.getElementById('gmResultado'), 'GerenciaMensual_' + empresa + '_' + new Date().toISOString().slice(0, 10) + '.png',
            { imagenCopiada: EXP_T.imagenCopiada, imagenDescargada: EXP_T.imagenDescargada });
    }

    function construirPdfGM(r) {
        var T = _gm.t, P = T.pdf, C = InformeTema.pdf(PDF_COL_GM), DEG = InformeTema.pdfDegradado();
        var pdf = new window.jspdf.jsPDF('l', 'mm', 'a4');
        var W = pdf.internal.pageSize.getWidth(), H = pdf.internal.pageSize.getHeight();
        var M = 12, ANCHO = W - M * 2, LIMITE_Y = H - 15, y = 0;
        var empresa = $('#gmTituloEmpresa').text() || '', cierre = etiquetaCierre(r);

        function rgb(fn, c) { pdf[fn](c[0], c[1], c[2]); }
        function fuente(est, tam, c) { pdf.setFont('helvetica', est); pdf.setFontSize(tam); rgb('setTextColor', c || C.texto); }
        function limpiar(t) { return String(t == null ? '' : t).replace(/\*\*|__/g, '').replace(/\s+/g, ' ').trim(); }
        function ancho(t) { return pdf.getTextWidth(String(t)); }
        function degradado(x, yy, w, h) {
            var pasos = 90, n = DEG.length - 1;
            for (var i = 0; i < pasos; i++) {
                var t = i / (pasos - 1), seg = Math.min(n - 1, Math.floor(t * n)), f = t * n - seg, a = DEG[seg], b = DEG[seg + 1];
                pdf.setFillColor(Math.round(a[0] + (b[0] - a[0]) * f), Math.round(a[1] + (b[1] - a[1]) * f), Math.round(a[2] + (b[2] - a[2]) * f));
                pdf.rect(x + (w * i) / pasos, yy, w / pasos + 0.15, h, 'F');
            }
        }
        function pildora(texto, x, yy, fg, bg, negrita, tam, der) {
            fuente(negrita ? 'bold' : 'normal', tam || 7.5, fg);
            var w = ancho(texto) + 5, h = (tam || 7.5) * 0.62 + 1, x0 = der ? x - w : x;
            rgb('setFillColor', bg); pdf.roundedRect(x0, yy - h + 1.4, w, h, h / 2, h / 2, 'F'); pdf.text(texto, x0 + 2.5, yy); return w;
        }
        function tituloSeccion(texto, yy, x0, w) {
            x0 = x0 === undefined ? M : x0; w = w === undefined ? ANCHO : w;
            var t = String(texto).toUpperCase();
            fuente('bold', 8.5, C.morado); pdf.text(t, x0, yy);
            rgb('setDrawColor', C.linea); pdf.setLineWidth(0.3); pdf.line(x0 + ancho(t) + 3, yy - 1.1, x0 + w, yy - 1.1);
        }
        function tarjeta(x, yy, w, h) { rgb('setDrawColor', C.linea); rgb('setFillColor', C.blanco); pdf.setLineWidth(0.3); pdf.roundedRect(x, yy, w, h, 2.5, 2.5, 'FD'); }
        function encabezadoPagina() {
            degradado(0, 0, W, 2.4); fuente('bold', 10, C.texto); pdf.text(empresa, M, 11);
            fuente('normal', 8, C.muted); pdf.text(P.titulo + '  ' + CH_MIDDOT_GM + '  ' + cierre, W - M, 11, { align: 'right' }); y = 20;
        }

        // Banda de portada
        degradado(0, 0, W, 34);
        fuente('bold', 10, C.blanco);
        var wMarca = window.BufinsPdfMarca ? BufinsPdfMarca(pdf, M, 10) : 0;
        if (!wMarca) { pdf.text(P.marca, M, 10); wMarca = ancho(P.marca); }
        fuente('normal', 8.5, C.blanco); pdf.text(CH_MIDDOT_GM + '  ' + P.subtitulo, M + wMarca + 2.5, 10);
        fuente('bold', 19, C.blanco); pdf.text(empresa, M, 22);
        fuente('normal', 9.5, C.blanco); pdf.text(P.titulo, M, 29);
        fuente('normal', 8, C.blanco); pdf.text(P.generadoEl + ' ' + ($('#gmFechaGenerado').text() || ''), W - M, 10, { align: 'right' });
        fuente('bold', 8, C.blanco); pdf.text(P.confidencial.toUpperCase(), W - M, 29, { align: 'right' });
        EmpresaLogo.pdf(pdf, { xDerecha: W - M, y: 12.5, alto: 14 });

        y = 43;
        var xc = M;
        [{ t: $('#gmChipCierre').text(), fg: C.morado, bg: C.totalBg, b: true }, { t: $('#gmChipEscenario').text() }, { t: T.unidadBadge[_gm.unidad] }].forEach(function (c) {
            if (!c.t) return; xc += pildora(c.t, xc, y, c.fg || C.texto2, c.bg || C.suave, !!c.b) + 3;
        });
        y += 10;

        // Resumen con IA
        tituloSeccion(P.insights, y); y += 4;
        var sec = _gm.insightsTexto ? separarInsightsGM(_gm.insightsTexto) : null;
        if (sec) {
            var tiles = [{ titulo: T.insResultado, texto: sec.resultado, c: C.bueno }, { titulo: T.insCaja, texto: sec.caja, c: C.malo }, { titulo: T.insFoco, texto: sec.foco, c: C.morado }];
            var gapT = 5, wT = (ANCHO - gapT * 2) / 3;
            fuente('normal', 8.8, C.texto2);
            var lin = tiles.map(function (t) { return pdf.splitTextToSize(limpiar(t.texto), wT - 9); });
            var hT = 14 + Math.max.apply(null, lin.map(function (l) { return l.length; })) * 4.2 + 3;
            tiles.forEach(function (t, i) {
                var x = M + i * (wT + gapT);
                tarjeta(x, y, wT, hT); rgb('setFillColor', t.c); pdf.rect(x + 2.5, y, wT - 5, 1.1, 'F');
                fuente('bold', 7.5, t.c); pdf.text(t.titulo.toUpperCase(), x + 4.5, y + 8.3);
                fuente('normal', 8.8, C.texto2); pdf.text(lin[i], x + 4.5, y + 15.5, { lineHeightFactor: 1.35 });
            });
            y += hT + 8;
        } else {
            fuente('italic', 8.5, C.texto2); pdf.text(_gm.insightsTexto ? pdf.splitTextToSize(limpiar(_gm.insightsTexto), ANCHO)[0] : P.sinInsights, M, y + 3); y += 10;
        }

        // Resultados
        if (r.HayResultados) {
            tituloSeccion($('#gmSecResultados .t').text(), y); y += 4;
            var nR = r.Resultados.length, gapR = 5, wR = (ANCHO - gapR * (nR - 1)) / nR, hR = 38;
            r.Resultados.forEach(function (c, i) {
                var x = M + i * (wR + gapR);
                tarjeta(x, y, wR, hR); degradado(x + 3, y, wR - 6, 1);
                fuente('bold', 7.5, C.texto2); pdf.text((T.res[c.Codigo] || c.Codigo).toUpperCase(), x + 4.5, y + 8);
                fuente('bold', 16, C.texto); pdf.text(fmtNumGM(c.Real), x + 4.5, y + 17);
                fuente('normal', 7, C.muted); pdf.text(T.vsPpto + ' ' + fmtNumGM(c.Presupuesto), x + 4.5, y + 24);
                pildora(fmtPctVarGM(c.VarPresupuesto), x + wR - 4.5, y + 24.5, c.VarPresupuesto >= 0 ? C.bueno : C.malo, c.VarPresupuesto >= 0 ? C.buenoBg : C.maloBg, true, 7, true);
                fuente('normal', 7, C.muted); pdf.text(T.acumulado + ' ' + fmtNumGM(c.AcumReal), x + 4.5, y + 31);
                pildora(fmtPctVarGM(c.AcumVarPresupuesto), x + wR - 4.5, y + 31.5, c.AcumVarPresupuesto >= 0 ? C.bueno : C.malo, c.AcumVarPresupuesto >= 0 ? C.buenoBg : C.maloBg, true, 7, true);
            });
            y += hR + 9;
        }

        // Balance y caja lado a lado
        var mitad = (ANCHO - 6) / 2;
        function bloque(x, titulo, filas) {
            tituloSeccion(titulo, y, x, mitad);
            var yy = y + 5;
            filas.forEach(function (f) {
                fuente('normal', 8.5, C.texto2); pdf.text(f[0], x + 1, yy);
                fuente('bold', 8.5, C.texto); pdf.text(f[1], x + mitad - 1, yy, { align: 'right' });
                rgb('setDrawColor', C.linea); pdf.setLineWidth(0.15); pdf.line(x, yy + 1.8, x + mitad, yy + 1.8);
                yy += 6;
            });
            return yy;
        }
        var filasBal = r.HayBalance ? r.Balance.map(function (k) {
            return [T.bal[k.Codigo] || k.Codigo, k.NoAplica ? T.noAplica : (k.Codigo === 'RazonCorriente' ? fmtRatioGM(k.Valor) : (k.Codigo === 'Endeudamiento' ? fmtPctGM(k.Valor) : fmtNumGM(k.Valor)))];
        }) : [[T.sinSeccion, '']];
        var filasCaja = [];
        if (r.HayCaja) {
            if (r.HayCajaInicial) filasCaja.push([T.cajaInicial, fmtNumGM(r.CajaInicial)]);
            filasCaja.push([T.flujoNeto, fmtNumGM(r.FlujoNeto)], [T.flujoNetoPpto, fmtNumGM(r.FlujoNetoPresupuesto)], [T.fcl, fmtNumGM(r.FclOperativo)]);
            if (r.HayCajaFinal) filasCaja.push([T.cajaFinal, fmtNumGM(r.CajaFinal)]);
        } else filasCaja.push([T.sinSeccion, '']);
        var y1 = bloque(M, $('#gmSecBalance .pyg2-card-title').text(), filasBal);
        var y2 = bloque(M + mitad + 6, $('#gmSecCaja .pyg2-card-title').text(), filasCaja);
        y = Math.max(y1, y2) + 4;

        // Página 2: indicadores, líneas, comentarios
        pdf.addPage(); encabezadoPagina();
        tituloSeccion(P.atencion, y); y += 6;
        if (r.HayIndicadores) {
            var xs = M;
            ['verde', 'amarillo', 'naranja', 'rojo'].forEach(function (n) {
                var cant = r['Total' + n.charAt(0).toUpperCase() + n.slice(1)];
                var col = n === 'verde' ? C.bueno : (n === 'rojo' ? C.malo : C.texto2);
                xs += pildora(cant + ' ' + T.nivel[n], xs, y, col, n === 'verde' ? C.buenoBg : (n === 'rojo' ? C.maloBg : C.suave), true, 7.5) + 3;
            });
            y += 7;
            r.Atencion.forEach(function (a) {
                fuente('normal', 8.5, C.texto2); pdf.text(nombreIndicadorGM(a.Codigo), M + 1, y);
                fuente('bold', 8.5, C.texto); pdf.text(fmtIndicadorGM(a) + '   ' + (T.nivel[a.Nivel] || a.Nivel), W - M - 1, y, { align: 'right' });
                rgb('setDrawColor', C.linea); pdf.setLineWidth(0.15); pdf.line(M, y + 1.8, W - M, y + 1.8); y += 6;
            });
            if (!r.Atencion.length) { fuente('italic', 8.5, C.texto2); pdf.text(T.sinAtencion, M + 1, y); y += 6; }
        } else { fuente('italic', 8.5, C.texto2); pdf.text(T.sinSeccion, M + 1, y); y += 6; }
        y += 6;

        if (r.HayLineas) {
            tituloSeccion(P.lineas, y); y += 6;
            fuente('bold', 7.5, C.blanco); rgb('setFillColor', C.marca); pdf.rect(M, y - 4.3, ANCHO, 6.3, 'F');
            pdf.text(T.colLinea.toUpperCase(), M + 3, y);
            pdf.text(T.colIngresos.toUpperCase(), M + 95, y, { align: 'right' }); pdf.text(T.colPct.toUpperCase(), M + 130, y, { align: 'right' }); pdf.text(T.colMargen.toUpperCase(), M + 170, y, { align: 'right' });
            y += 6;
            r.Lineas.forEach(function (l) {
                fuente('normal', 8.3, C.texto2); pdf.text(l.Nombre, M + 3, y);
                pdf.text(fmtNumGM(l.Ingresos), M + 95, y, { align: 'right' }); pdf.text(fmtPctGM(l.PctIngresos), M + 130, y, { align: 'right' }); pdf.text(fmtPctGM(l.MargenOperacional), M + 170, y, { align: 'right' });
                rgb('setDrawColor', C.linea); pdf.setLineWidth(0.15); pdf.line(M, y + 1.8, W - M, y + 1.8); y += 6;
            });
            y += 6;
        }

        var coms = window.ComentariosGestion ? ComentariosGestion.ultimos() : [];
        if (coms.length) {
            tituloSeccion(P.comentarios, y); y += 5;
            coms.slice(0, 6).forEach(function (c) {
                fuente('normal', 8.2, C.texto2);
                var lineas = pdf.splitTextToSize(limpiar(((c.Clave ? c.Clave + ': ' : '') + c.Texto) + '  — ' + c.NombreUsuario), ANCHO - 10).slice(0, 3);
                var hC = lineas.length * 4 + 5;
                if (y + hC > LIMITE_Y) { pdf.addPage(); encabezadoPagina(); }
                tarjeta(M, y, ANCHO, hC); pdf.text(lineas, M + 5, y + 6, { lineHeightFactor: 1.3 }); y += hC + 2;
            });
        }

        var tot = pdf.internal.getNumberOfPages();
        for (var p = 1; p <= tot; p++) {
            pdf.setPage(p); rgb('setDrawColor', C.linea); pdf.setLineWidth(0.3); pdf.line(M, H - 10, W - M, H - 10);
            fuente('normal', 7, C.muted); pdf.text(P.pie + '  ' + CH_MIDDOT_GM + '  ' + empresa + '  ' + CH_MIDDOT_GM + '  ' + cierre, M, H - 6);
            pdf.text(P.confidencial, W / 2, H - 6, { align: 'center' });
            fuente('bold', 7, C.texto2); pdf.text(P.paginaFmt.replace('{0}', p).replace('{1}', tot), W - M, H - 6, { align: 'right' });
        }
        pdf.__nombre = 'GerenciaMensual_' + empresa.replace(/[^a-z0-9]+/gi, '_') + '_' + r.Anio + ('0' + r.Mes).slice(-2) + '.pdf';
        return pdf;
    }

    $(document).ready(function () {
        $('#gmEmpresa, #gmEscenario, #gmMes').select2({ width: '100%', language: s2langGM, dropdownAutoWidth: false, minimumResultsForSearch: 10 });
        $('#gmEmpresa, #gmEscenario').on('change', cargarMesesGM);

        $('#gmBtnUnidad').on('click', function (e) { e.stopPropagation(); $(this).attr('aria-expanded', $('#gmMenuUnidad').toggleClass('open').hasClass('open') ? 'true' : 'false'); });
        $('#gmMenuUnidad button').on('click', function (e) {
            e.stopPropagation(); _gm.unidad = $(this).data('unidad');
            $('#gmMenuUnidad').removeClass('open'); $('#gmBtnUnidad').attr('aria-expanded', 'false'); guardarPrefsGM(); repintarGM();
        });
        $(document).on('click', function () { $('#gmMenuUnidad').removeClass('open'); $('#gmBtnUnidad').attr('aria-expanded', 'false'); });

        function exportarExcelGM() {
            if (!_gm.filtrosConsultados) return;
            var $c = $('#gmExpCampos').empty();
            Object.keys(_gm.filtrosConsultados).forEach(function (k) { $c.append($('<input type="hidden">').attr('name', k).val(_gm.filtrosConsultados[k] == null ? '' : _gm.filtrosConsultados[k])); });
            $('#frmExportarExcelGM').submit();
        }

        $('#btnConsultarGM').on('click', consultarGM);
        InformeTema.montar({ selector: '#gmTema', empresa: '#gmEmpresa' });
        $('#btnLimpiarGM').on('click', function () { InformeTema.reset(); if (_gm.esAdmin) elEmpresaGM.val('').trigger('change.select2'); cargarMesesGM(); });
        $('#btnGenerarInsightsGM').on('click', generarInsightsGM);
        $('#btnGmPreguntar').on('click', preguntarGM);
        $('#gmPregunta').on('keydown', function (e) { if (e.which === 13) { e.preventDefault(); preguntarGM(); } });

        // En este informe se listan los comentarios de TODOS los informes del cierre; los nuevos quedan como «Informe mensual de gerencia».
        ComentariosGestion.montar({ raiz: '#gmComentarios', informe: 'GerenciaMensual', todos: true });

        var correoGM = ExportMenu.correo({
            url: '@Url.Action("EnviarPorCorreo", "InformeGerenciaMensual")',
            token: function () { return _gm.token; },
            datos: function () { return $.extend({}, _gm.filtrosConsultados); },
            pdf: function () { var d = construirPdfGM(_gm.reporteActual); return d ? d.output('datauristring') : ''; },
            pills: function () { return [$('#gmTituloEmpresa').text()].concat($('#gmPanelResultado .pyg2-chip').map(function () { return $(this).text(); }).get()); },
            textos: EXP_T
        });
        ExportMenu.init('gmExp', {
            acciones: { excel: exportarExcelGM, pdf: generarPdfGM, imagen: copiarImagenGM, correo: function () { if (_gm.reporteActual) correoGM.abrir(); } },
            textos: EXP_T
        });

        DocVisor.init({ boton: '#gmDocBtn', url: '@Url.Action("Ver", "Documentacion", new { clave = "gerencia-mensual" })' });
        cargarPrefsGM(); cargarMesesGM();
    });
</script>
}
