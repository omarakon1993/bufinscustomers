                '<div class="pyg2-kpi-val"><span class="v">' + escHtml(valorTxt) + '</span><span class="p">' + escHtml(refs.comp + ' ' + pptoTxt) + '</span></div>' +
                '<div class="pyg2-kpi-bar"><i class="' + (real >= ppto ? 'good' : '') + '" style="width:' + ancho.toFixed(1) + '%"></i></div>' +
                '<div class="pyg2-kpi-deltas">' + filas + '</div>' +
            '</div>';
        return $(html);
    }

    function destruirCharts() {
        Object.keys(_pyg.charts).forEach(function (k) { if (_pyg.charts[k]) _pyg.charts[k].destroy(); });
        _pyg.charts = {};
    }

    function pintarCharts(r) {
        destruirCharts();
        pintarCascada(r);
