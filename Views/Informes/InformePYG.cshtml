    // Imagen nítida de una gráfica: se re-renderiza temporalmente a 3x — y, si se pide, a la proporción
    // exacta de su caja en el PDF (anchoPx x altoPx CSS) para que no queden huecos — y se exporta como
    // JPEG sobre fondo blanco (jsPDF incrusta los PNG sin comprimir: con PNG a 3x el PDF pasaba de 10 MB).
    // Al final se restaura el tamaño/resolución de pantalla.
    function capturarChartPdf(chart, anchoPx, altoPx) {
        if (!chart) return null;
        var dprOriginal = chart.options.devicePixelRatio;
        chart.options.devicePixelRatio = 3;
        if (anchoPx && altoPx) chart.resize(anchoPx, altoPx); else chart.resize();
        chart.update('none');
        var lienzo = document.createElement('canvas');
        lienzo.width = chart.canvas.width;
        lienzo.height = chart.canvas.height;
        var ctx = lienzo.getContext('2d');
        ctx.fillStyle = '#FFFFFF';
        ctx.fillRect(0, 0, lienzo.width, lienzo.height);
        ctx.drawImage(chart.canvas, 0, 0);
        var img = { data: lienzo.toDataURL('image/jpeg', 0.9), w: chart.width, h: chart.height };
        chart.options.devicePixelRatio = dprOriginal;
        chart.resize();
        chart.update('none');
        return img;
    }

    function construirPdfPYG(r) {
