    // ===== PDF gerencial (A4 horizontal, jsPDF puro — sin html2canvas) =====
    //  Pág. 1  Resumen ejecutivo: banda de marca, contexto (chips), 4 KPIs e insights de IA en 3 tarjetas.
    //  Pág. 2  Análisis del período: cascada + "Lo más relevante" + 3 tendencias (gráficas nativas de
    //          Chart.js re-renderizadas a 3x para que salgan nítidas).
    //  Pág. 3+ Estado de resultados detallado: misma vista/columnas/nivel de detalle que la tabla en
    //          pantalla, con encabezado repetido en cada página.
    //  Pie en todas: empresa · período · confidencialidad · "Página X de Y".
    var PDF_COL = {
        marca: [99, 102, 241], morado: [88, 58, 255], texto: [22, 18, 31], texto2: [91, 85, 112], muted: [139, 133, 160],
        linea: [228, 225, 240], lineaSuave: [238, 240, 246], suave: [244, 243, 251], suave2: [248, 247, 253], zebra: [252, 252, 254],
        totalBg: [238, 242, 255], totalTx: [59, 47, 191], bueno: [22, 163, 74], buenoBg: [236, 253, 243],
        malo: [220, 38, 38], maloBg: [254, 242, 242], restaBar: [248, 113, 113], ambar: [217, 119, 6], cian: [14, 165, 233], blanco: [255, 255, 255]
    };
    var PDF_DEGRADADO = [[99, 102, 241], [59, 130, 246], [6, 182, 212], [1, 225, 215]];

    function generarPdf() {
