    var elEmpresa = $('#pygEmpresa'), elEscenario = $('#pygEscenario');

    var CH_MDASH = String.fromCharCode(0x2014), CH_NDASH = String.fromCharCode(0x2013), CH_MIDDOT = String.fromCharCode(0xB7);

    function cargarPrefsPYG() {
        try {
            var p = JSON.parse(localStorage.getItem('pyg.prefs') || '{}');
            if (p.kpiVista === 'periodo' || p.kpiVista === 'acum') _pyg.kpiVista = p.kpiVista;
            if (['periodo', 'acum', 'ambos'].indexOf(p.vistaTabla) >= 0) _pyg.vistaTabla = p.vistaTabla;
            if (typeof p.mostrarYoY === 'boolean') _pyg.mostrarYoY = p.mostrarYoY;
            if (['pesos', 'miles', 'millones'].indexOf(p.unidad) >= 0) _pyg.unidad = p.unidad;
        } catch (e) { }
    }
    function guardarPrefsPYG() {
        try {
            localStorage.setItem('pyg.prefs', JSON.stringify({
                kpiVista: _pyg.kpiVista, vistaTabla: _pyg.vistaTabla, mostrarYoY: _pyg.mostrarYoY, unidad: _pyg.unidad
            }));
        } catch (e) { }
    }
    function escHtml(t) { return $('<span>').text(t == null ? '' : String(t)).html(); }

    var s2lang = {
        noResults: function () { return '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Select2NoResults))'; },
        searching: function () { return '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Select2Searching))'; }
    };

    function empresaSeleccionada() {
        var v = elEmpresa.val();
        return v ? parseInt(v, 10) : null;
    }

    function escenarioSeleccionado() {
        var v = elEscenario.val();
        return v ? parseInt(v, 10) : 1;
    }

    // ===== Unidad (Pesos/Miles/Millones) — mismo patrón que InformeLineaTiempo =====
    function escalarValor(v) {
        if (_pyg.unidad === 'miles') return v / 1000;
        if (_pyg.unidad === 'millones') return v / 1000000;
        return v;
    }
    function sufijoUnidad() {
        if (_pyg.unidad === 'miles') return ' ' + _pyg.textos.unidadSufijoMiles;
        if (_pyg.unidad === 'millones') return ' ' + _pyg.textos.unidadSufijoMillones;
        return '';
    }
    function fmtNum(v) {
        var escalado = escalarValor(v);
        var decimales = _pyg.unidad === 'pesos' ? 0 : 1;
        try { return new Intl.NumberFormat(_pyg.cultura, { minimumFractionDigits: decimales, maximumFractionDigits: decimales }).format(escalado) + sufijoUnidad(); }
        catch (e) { return escalado + sufijoUnidad(); }
    }
    function fmtNumVar(v) {
        var escalado = escalarValor(v);
        var decimales = _pyg.unidad === 'pesos' ? 0 : 1;
        try { return new Intl.NumberFormat(_pyg.cultura, { minimumFractionDigits: decimales, maximumFractionDigits: decimales, signDisplay: 'exceptZero' }).format(escalado) + sufijoUnidad(); }
        catch (e) { var n = escalado; return (n >= 0 ? '+' : '') + n + sufijoUnidad(); }
    }
    function fmtPct(v) {
        if (v === null || v === undefined) return CH_MDASH;
        try { return new Intl.NumberFormat(_pyg.cultura, { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(v * 100) + '%'; }
        catch (e) { return (Math.round(v * 1000) / 10) + '%'; }
    }
    function fmtPctVar(v) {
        if (v === null || v === undefined) return CH_MDASH;
        try { return new Intl.NumberFormat(_pyg.cultura, { minimumFractionDigits: 1, maximumFractionDigits: 1, signDisplay: 'exceptZero' }).format(v * 100) + '%'; }
        catch (e) { var n = Math.round(v * 1000) / 10; return (n >= 0 ? '+' : '') + n + '%'; }
    }
    function fmtPuntos(v) {
        try { return new Intl.NumberFormat(_pyg.cultura, { minimumFractionDigits: 1, maximumFractionDigits: 1, signDisplay: 'exceptZero' }).format(v * 100); }
        catch (e) { var n = Math.round(v * 1000) / 10; return (n >= 0 ? '+' : '') + n; }
    }

    // Muestra un error visible (antes fallaba en silencio: si el POST devolvía success:false o el
    // servidor tiraba una excepción/anti-forgery inválido, el usuario no veía nada).
    function mostrarErrorPYG(mensaje) {
        console.error('[InformePYG]', mensaje);
        if (typeof Swal !== 'undefined') {
            Swal.fire({ icon: 'error', title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Error))', text: mensaje });
        } else {
            alert(mensaje);
        }
    }

    function actualizarBotonConsultar() {
        var listo = (!_pyg.esAdmin || !!empresaSeleccionada()) && !!elEscenario.val() && _pyg.rango.length > 0;
        $('#btnConsultarPYG').prop('disabled', !listo);
    }

    function ocultarResultados() {
        $('#pygResultado, #pygSinDatos').hide();
        $('#pygEstadoInicial').show();
    }

    // "Comparar con escenario": todos los escenarios MENOS el principal (no tiene sentido compararlo
    // consigo mismo). Los que no tienen datos para la empresa (_pyg.escenariosConDatos, que llega con
    // ObtenerMeses) quedan deshabilitados con etiqueta "Sin datos" y tooltip. Por defecto: Ninguno.
    function actualizarOpcionesEscenarioComparar() {
        var principal = String(elEscenario.val() || '');
        var conDatos = _pyg.escenariosConDatos;   // null = aún no se sabe (se habilitan todos)
        var $sel = $('#pygEscenarioComparar');
        var actual = String($sel.val() || '');
        var hayDeshabilitados = false;

        $sel.find('option[value!=""]').remove();
        _pyg.escenarios.forEach(function (e) {
            if (String(e.id) === principal) return;
            var tieneDatos = !conDatos || conDatos.indexOf(e.id) >= 0;
            if (!tieneDatos) hayDeshabilitados = true;
            var texto = tieneDatos ? e.nombre : (e.nombre + ' (' + _pyg.textos.escenarioSinDatosEtiqueta + ')');
            $sel.append($('<option>').val(e.id).text(texto).prop('disabled', !tieneDatos)
                .attr('title', tieneDatos ? '' : _pyg.textos.escenarioSinDatosTooltip));
        });

        var opcionActual = $sel.find('option[value="' + actual + '"]');
        if (!actual || !opcionActual.length || opcionActual.prop('disabled')) $sel.val('');
        $sel.trigger('change.select2');
        $('#pygEscenarioSinDatosHint').toggle(hayDeshabilitados);
    }

    // Meses con datos (año+mes, cronológicos) de la empresa/escenario: alimentan el slider continuo,
    // igual que el Informe de Línea de Tiempo (el rango puede cruzar años).
    function cargarMeses() {
        _pyg.rango = [];
        _pyg.iDesde = 0;
        _pyg.iHasta = 0;
        _pyg.escenariosConDatos = null;
        $('#pygSinMeses').hide();
        ocultarResultados();
        actualizarOpcionesEscenarioComparar();
        pintarRangoPYG();
        actualizarBotonConsultar();

        var idEmpresa = empresaSeleccionada();
        if (_pyg.esAdmin && !idEmpresa) return;

        $.post(_pyg.urls.meses, {
            idEmpresa: idEmpresa,
            idEscenario: escenarioSeleccionado(),
            __RequestVerificationToken: _pyg.token
        }, function (resp) {
            if (!resp || !resp.success) {
                mostrarErrorPYG((resp && resp.message) || _pyg.textos.errorServidor);
                return;
            }
            _pyg.rango = resp.meses || [];
            _pyg.escenariosConDatos = (resp.escenariosConDatos || []).map(Number);
            actualizarOpcionesEscenarioComparar();
            $('#pygSinMeses').toggle(!_pyg.rango.length);
            // Por defecto el año en curso (enero hasta el último mes cargado), como antes el año completo.
            // Por defecto "Año en curso" (según la fecha de hoy); si el año de hoy no tiene datos, "Todo".
            var inicial = RangoAtajos.porDefecto('ytd', _pyg.rango, _pyg.hoy);
            if (inicial) { _pyg.iDesde = inicial.d; _pyg.iHasta = inicial.h; }
            pintarRangoPYG();
            actualizarBotonConsultar();
        }).fail(function (xhr) {
            mostrarErrorPYG(_pyg.textos.errorServidor + ' (HTTP ' + xhr.status + ')');
        });
    }

    // ===== Slider de rango continuo (mismo control que InformeLineaTiempo) =====

    function pctIndicePYG(i) {
        var n = _pyg.rango.length;
        return n > 1 ? (i / (n - 1) * 100) : 0;
    }

    function pintarRangoPYG() {
        var meses = _pyg.rango, n = meses.length;
        var track = $('#pygRangoTrack');

        if (n === 0) {
            track.addClass('disabled');
            $('#pygRangoDesdeLbl, #pygRangoHastaLbl, #pygRangoBadge').text(CH_MDASH);
            $('#pygRangoHastaLbl').show();
            $('#pygRangoDesdeLbl').next('i').show();
            $('#pygRangoYears').empty();
            $('#pygAtajos button').removeClass('active no-disponible').prop('disabled', true).attr('title', '');
            return;
        }

        track.removeClass('disabled');
        var pctDesde = pctIndicePYG(_pyg.iDesde), pctHasta = pctIndicePYG(_pyg.iHasta);

        $('#pygKnobFrom').css('left', pctDesde + '%')
            .attr({ 'aria-valuemin': 0, 'aria-valuemax': n - 1, 'aria-valuenow': _pyg.iDesde, 'aria-valuetext': meses[_pyg.iDesde].etiqueta });
        $('#pygKnobTo').css('left', pctHasta + '%')
            .attr({ 'aria-valuemin': 0, 'aria-valuemax': n - 1, 'aria-valuenow': _pyg.iHasta, 'aria-valuetext': meses[_pyg.iHasta].etiqueta });
        $('#pygRangoSel').css({ left: pctDesde + '%', width: (pctHasta - pctDesde) + '%' });

        // Un solo mes (p. ej. "Mes actual"): se muestra "Ago 2026" en vez de "Ago 2026 → Ago 2026".
        var unMes = _pyg.iDesde === _pyg.iHasta;
        $('#pygRangoDesdeLbl').text(meses[_pyg.iDesde].etiqueta);
        $('#pygRangoHastaLbl').text(unMes ? '' : meses[_pyg.iHasta].etiqueta).toggle(!unMes);
        $('#pygRangoDesdeLbl').next('i').toggle(!unMes);

        var totalMeses = _pyg.iHasta - _pyg.iDesde + 1;
        $('#pygRangoBadge').text(totalMeses + ' ' + (totalMeses === 1 ? _pyg.textos.badgeMes : _pyg.textos.badgeMeses));

        var anios = [];
        meses.forEach(function (m) { if (anios.indexOf(m.anio) === -1) anios.push(m.anio); });
        $('#pygRangoYears').html(anios.map(function (a) { return '<span>' + a + '</span>'; }).join(''));

        actualizarAtajoActivoPYG();
    }

    // ===== Atajos del rango: lógica compartida con Línea de Tiempo (Assets/js/rango-atajos.js) =====
    // Relativos a la fecha de hoy del SERVIDOR (_pyg.hoy); cada ventana se intersecta con los meses
