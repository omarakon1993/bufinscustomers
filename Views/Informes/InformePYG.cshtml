@using System.Web
@using bufinscustomers.Models
@{
    ViewBag.Title = Resources.Strings.PYG_PageTitle;
    var empresas = ViewBag.Empresas as List<Empresas>;
    var esAdmin = (bool)(ViewBag.EsAdmin ?? false);
    var culturaJs = System.Globalization.CultureInfo.CurrentUICulture.Name;
}

<link href="~/Assets/css/bufins-components.css" rel="stylesheet" />
<link href="~/Assets/css/informe-linea-tiempo.css" rel="stylesheet" />
<link href="~/Assets/css/informe-pyg.css" rel="stylesheet" />
<link href="~/Assets/css/select2/select2.min.css" rel="stylesheet" />

<div class="container-fluid px-4">
<div class="lt-app">

    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas fa-chart-line powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@Resources.Strings.PYG_PageTitle</h1>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <div class="filter-card">
        <div class="lt-section-title"><span>@Resources.Strings.Common_FiltrosConsulta</span></div>
        <div class="lt-grid-quever">
            <div class="lt-field">
                <label class="lt-field-label" for="pygEmpresa">@Resources.Strings.Common_LabelEmpresa</label>
                <select id="pygEmpresa" class="lt-field-select">
                    @if (esAdmin) { <option value="">@Resources.Strings.Common_Seleccione</option> }
                    @if (empresas != null)
                    {
                        foreach (var e in empresas)
                        {
                            <option value="@e.Id">@e.Nombre</option>
                        }
                    }
                </select>
            </div>
            <div class="lt-field">
                <label class="lt-field-label" for="pygEscenario">@Resources.Strings.Common_LabelEscenario</label>
                <select id="pygEscenario" class="lt-field-select">
                    @if (ViewBag.Escenarios != null)
                    {
                        foreach (var esc in ViewBag.Escenarios)
                        {
                            <option value="@esc.Id">@esc.Nombre</option>
                        }
                    }
                </select>
            </div>
            <div class="lt-field">
                <label class="lt-field-label" for="pygNivelDetalle">@Resources.Strings.PYG_NivelDetalle</label>
                <select id="pygNivelDetalle" class="lt-field-select">
                    <option value="todas">@Resources.Strings.PYG_NivelTodas</option>
                    <option value="subtotales">@Resources.Strings.PYG_NivelSubtotales</option>
                </select>
            </div>
        </div>

        <details class="rpt-adv">
            <summary><span>@Resources.Strings.PYG_SeccionComparaciones</span><span class="line"></span></summary>
            <div class="rpt-adv-body">
                <div class="lt-grid-quever">
                    <div class="lt-field">
                        <label class="lt-field-label" for="pygComparar">@Resources.Strings.PYG_Comparar_Label</label>
                        <select id="pygComparar" class="lt-field-select">
                            <option value="ppto">@Resources.Strings.PYG_Comp_ppto</option>
                            <option value="pptoAjuste">@Resources.Strings.PYG_Comp_pptoAjuste</option>
                            <option value="forecast">@Resources.Strings.PYG_Comp_forecast</option>
                        </select>
                    </div>
                    <div class="lt-field">
                        <label class="lt-field-label" for="pygEscenarioComparar">@Resources.Strings.PYG_EscenarioComparar</label>
                        @* Opciones armadas por JS (actualizarOpcionesEscenarioComparar): todos los escenarios menos
                           el principal; los que no tienen datos para la empresa quedan deshabilitados con tooltip. *@
                        <select id="pygEscenarioComparar" class="lt-field-select">
                            <option value="">@Resources.Strings.PYG_EscenarioCompararNinguno</option>
                        </select>
                        <p class="lt-seg-hint" id="pygEscenarioSinDatosHint" style="display:none;"><i class="fas fa-circle-info mr-1"></i>@Resources.Strings.PYG_EscenarioSinDatosHint</p>
                    </div>
                </div>
            </div>
        </details>

        @* Rango y agrupación: mismo control que el Informe de Línea de Tiempo (rango continuo que puede
           cruzar años, con los años debajo del slider). "Agrupar por" solo afecta las tendencias. *@
        <div class="lt-section-title mt"><span>@Resources.Strings.LineaTiempo_FilaCuando</span></div>
        <div class="lt-grid-rango">
            <div>
                <label class="lt-field-label">@Resources.Strings.LineaTiempo_LabelVerPor</label>
                <div class="lt-seg" id="pygSegVerPor">
                    <button type="button" class="active" data-modo="Mes" title="@Resources.Strings.LineaTiempo_Agrupar_MesAyuda" aria-pressed="true">
                        <i class="fas fa-calendar-day"></i><span>@Resources.Strings.LineaTiempo_VerPorMes</span>
                    </button>
                    <button type="button" data-modo="Trimestre" title="@Resources.Strings.LineaTiempo_Agrupar_TrimestreAyuda" aria-pressed="false">
                        <i class="fas fa-calendar-week"></i><span>@Resources.Strings.LineaTiempo_VerPorTrimestre</span>
                    </button>
                    <button type="button" data-modo="Anio" title="@Resources.Strings.LineaTiempo_Agrupar_AnioAyuda" aria-pressed="false">
                        <i class="fas fa-calendar"></i><span>@Resources.Strings.LineaTiempo_VerPorAnio</span>
                    </button>
                </div>
                <p class="lt-seg-hint"><span id="pygAgruparHint">@Resources.Strings.LineaTiempo_Agrupar_MesAyuda</span>. @Resources.Strings.PYG_AgruparNota.</p>
            </div>
            <div>
                @* Atajos compartidos con Línea de Tiempo (Assets/js/rango-atajos.js): [Todo] | [relativos a
                   la fecha de hoy del servidor]. Barra compacta en su propia fila, cabe en pantallas de 14". *@
                <label class="lt-field-label">@Resources.Strings.LineaTiempo_LabelRango</label>
                <div class="rango-atajos" id="pygAtajos">
                    <div class="rango-atajos-grupo">
                        <button type="button" data-preset="todo">@Resources.Strings.Rango_Todo</button>
                    </div>
                    <div class="rango-atajos-grupo">
                        <button type="button" data-preset="ytd">@Resources.Strings.Rango_AnioEnCurso</button>
                        <button type="button" data-preset="6m">@Resources.Strings.Rango_Ultimos6Meses</button>
                        <button type="button" data-preset="3m">@Resources.Strings.Rango_UltimoTrimestre</button>
                        <button type="button" data-preset="mesAnterior">@Resources.Strings.Rango_MesAnterior</button>
                        <button type="button" data-preset="mesActual">@Resources.Strings.Rango_MesActual</button>
                    </div>
                </div>
                <div class="lt-range-card">
                    <div class="lt-range-head">
                        <span class="lbl"><span id="pygRangoDesdeLbl">&mdash;</span><i class="fas fa-long-arrow-alt-right"></i><span id="pygRangoHastaLbl">&mdash;</span></span>
                        <span class="lt-range-badge" id="pygRangoBadge">&mdash;</span>
                    </div>
                    <div class="lt-range-track disabled" id="pygRangoTrack">
                        <div class="bg"></div>
                        <div class="sel" id="pygRangoSel"></div>
                        <div class="knob from" id="pygKnobFrom" tabindex="0" role="slider" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" aria-label="@Resources.Strings.LineaTiempo_LabelRango"></div>
                        <div class="knob to" id="pygKnobTo" tabindex="0" role="slider" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" aria-label="@Resources.Strings.LineaTiempo_LabelRango"></div>
                    </div>
                    <div class="lt-range-years" id="pygRangoYears"></div>
                </div>
                <p class="lt-help">@Resources.Strings.LineaTiempo_FilaCuandoHint</p>
                <p class="lt-help" id="pygSinMeses" style="display:none;">@Resources.Strings.PYG_SinMesesDatos</p>
            </div>
        </div>

        <div class="btn-group-actions">
            <button type="button" id="btnConsultarPYG" class="btn btn-modern-gradient" disabled>
                <i class="fas fa-arrow-right mr-1"></i>@Resources.Strings.LineaTiempo_BtnGenerar
            </button>
            <button type="button" id="btnLimpiarPYG" class="btn btn-modern-secondary">@Resources.Strings.Common_Limpiar</button>
        </div>
    </div>

    <div id="pygEstadoInicial" class="lt-card lt-empty">
        <div class="lt-empty-icon"><i class="fas fa-chart-line"></i></div>
        <h4>@Resources.Strings.PYG_EstadoInicialTitulo</h4>
        <p>@Resources.Strings.PYG_EstadoInicialDesc</p>
    </div>

    <div id="pygSinDatos" class="lt-card lt-empty" style="display:none;">
        <div class="lt-empty-icon"><i class="fas fa-inbox"></i></div>
        <h4>@Resources.Strings.PYG_SinDatosTitulo</h4>
        <p id="pygSinDatosDesc">@Resources.Strings.PYG_SinDatosDesc</p>
    </div>

    <div id="pygResultado" style="display:none;">

        @* 1. Encabezado: marca + empresa + chips de contexto + unidad/exportaciones *@
        <div class="lt-card" id="pygPanelResultado">
            <div class="pyg2-letterhead">
                <span class="pyg2-brand"><span class="bm-text">@Resources.Strings.LineaTiempo_BrandMark</span><span class="bm-sub">@Resources.Strings.PYG_V2_Subtitulo</span></span>
                <span class="fecha"><span>@Resources.Strings.PYG_V2_GeneradoEl</span> <span id="pygFechaGenerado">&mdash;</span></span>
            </div>
            <div class="pyg2-head">
                <div class="pyg2-head-l">
                    <h2 id="pygTituloEmpresa">&mdash;</h2>
                    <div class="pyg2-chips">
                        <span class="pyg2-chip primary"><i class="fas fa-calendar"></i><span id="pygChipPeriodo">&mdash;</span></span>
                        <span class="pyg2-chip" id="pygChipEscenario">&mdash;</span>
                        <span class="pyg2-chip" id="pygChipAcum">&mdash;</span>
                        <span class="pyg2-chip" id="pygChipComparado">&mdash;</span>
                    </div>
                </div>
                <div class="pyg2-tools">
                    <button type="button" class="lt-tool-btn" id="pygBtnUnidad" aria-haspopup="menu" aria-expanded="false">
                        <span class="lbl-muted">@Resources.Strings.PYG_V2_Unidad</span><span id="pygUnidadLbl">@Resources.Strings.LineaTiempo_UnidadMillones</span><i class="fas fa-chevron-down chev"></i>
                    </button>
                    <div class="lt-menu" id="pygMenuUnidad" role="menu">
                        <button type="button" data-unidad="pesos" role="menuitemradio">@Resources.Strings.LineaTiempo_UnidadPesos<i class="fas fa-check"></i></button>
                        <button type="button" data-unidad="miles" role="menuitemradio">@Resources.Strings.LineaTiempo_UnidadMiles<i class="fas fa-check"></i></button>
                        <button type="button" data-unidad="millones" role="menuitemradio">@Resources.Strings.LineaTiempo_UnidadMillones<i class="fas fa-check"></i></button>
                    </div>
                    <span class="sep"></span>
                    <button type="button" class="lt-tool-btn" id="btnExportarExcelPYG" title="@Resources.Strings.Common_ExportarExcel"><i class="fas fa-file-excel"></i>@Resources.Strings.PYG_V2_Excel</button>
                    <button type="button" class="lt-tool-btn" id="btnExportarPdfPYG" title="@Resources.Strings.PYG_BtnExportarPdf"><i class="fas fa-file-pdf"></i>@Resources.Strings.PYG_V2_Pdf</button>
                </div>
            </div>
        </div>
        <form id="frmExportarExcelPYG" method="post" action="@Url.Action("ExportarExcel", "InformePYG")">
            @Html.AntiForgeryToken()
            <div id="pygExpCampos"></div>@* los llena el botón Excel con los filtros del reporte consultado *@
        </form>

        @* 2. KPIs *@
        <div class="pyg2-section">
            <div class="pyg2-section-title">
                <span class="t">@Resources.Strings.PYG_V2_IndicadoresClave</span><span class="line"></span>
                <div class="pyg2-seg" id="pygSegKpi">
                    <button type="button" data-v="periodo" class="active">@Resources.Strings.PYG_V2_Periodo</button>
                    <button type="button" data-v="acum">@Resources.Strings.PYG_V2_Acumulado</button>
                </div>
            </div>
            <div class="pyg2-kpis" id="pygKpiStrip"></div>
        </div>

        @* 3. Cascada + Lo más relevante *@
        <div class="pyg2-analysis">
            <div class="pyg2-card">
                <div class="pyg2-card-head">
                    <div>
                        <div class="pyg2-card-title">@Resources.Strings.PYG_V2_CascadaTitulo</div>
                        <div class="pyg2-card-sub" id="pygCascadaSub">&mdash;</div>
                    </div>
                    <span class="pyg2-legend">
                        <span><i class="sq" style="background:#6366F1"></i>@Resources.Strings.PYG_V2_Total</span>
                        <span><i class="sq" style="background:#F87171"></i>@Resources.Strings.PYG_V2_Resta</span>
                        <span id="pygLeyendaSuma" style="display:none;"><i class="sq pos"></i>@Resources.Strings.PYG_V2_Suma</span>
                        <span><i class="dash"></i><span id="pygMetaLbl">@Resources.Strings.PYG_V2_MetaPpto</span> <b id="pygMetaPpto" style="font-weight:700">&mdash;</b></span>
                    </span>
                </div>
                <div class="pyg2-waterfall-wrap"><canvas id="pygChartCascada"></canvas></div>
            </div>
            <div class="pyg2-card" id="pygHighlights" style="gap:12px">
                <div>
                    <div class="pyg2-card-title"><i class="fas fa-bolt"></i>@Resources.Strings.PYG_V2_RelevanteTitulo</div>
                    <div class="pyg2-card-sub" id="pygRelevanteSub">@Resources.Strings.PYG_V2_RelevanteSub</div>
                </div>
                <div class="pyg2-hl-list" id="pygHighlightsList"></div>
            </div>
        </div>

        @* 4. Tendencias *@
        <div class="pyg2-section">
            <div class="pyg2-section-title">
                <span class="t"><span id="pygTendTitulo">@Resources.Strings.PYG_V2_TendenciaTitulo</span> <span id="pygTendAnio"></span></span><span class="line"></span>
                <span class="pyg2-legend">
                    <span><i class="sw" style="background:#6366F1"></i>@Resources.Strings.PYG_V2_Real</span>
                    <span><i class="dash"></i><span id="pygLeyendaComp">@Resources.Strings.PYG_V2_Presupuesto</span></span>
                    <span id="pygLeyendaEsc" style="display:none;"><i class="sw" style="background:#0EA5E9"></i><span id="pygLeyendaEscNombre"></span></span>
                    <span><i class="sq" style="background:#EEF2FF;width:10px;height:10px;border-radius:2px"></i>@Resources.Strings.PYG_V2_PeriodoSeleccionado</span>
                </span>
            </div>
            <div class="pyg2-trends">
                <div class="pyg2-trend">
                    <div class="pyg2-trend-head">
                        <div><div class="nm">@Resources.Strings.PYG_V2_Ingresos</div><div class="v" id="pygTrendValIngresos">&mdash;</div></div>
                        <span class="pyg2-dchip" id="pygTrendChipIngresos"></span>
                    </div>
                    <div class="pyg2-trend-canvas"><canvas id="pygChartIngresos"></canvas></div>
                </div>
                <div class="pyg2-trend">
                    <div class="pyg2-trend-head">
                        <div><div class="nm">@Resources.Strings.PYG_KpiEbitda</div><div class="v" id="pygTrendValEbitda">&mdash;</div></div>
                        <span class="pyg2-dchip" id="pygTrendChipEbitda"></span>
                    </div>
                    <div class="pyg2-trend-canvas"><canvas id="pygChartEbitda"></canvas></div>
                </div>
                <div class="pyg2-trend">
                    <div class="pyg2-trend-head">
                        <div><div class="nm">@Resources.Strings.PYG_V2_UtilidadNeta</div><div class="v" id="pygTrendValUtilidadNeta">&mdash;</div></div>
                        <span class="pyg2-dchip" id="pygTrendChipUtilidadNeta"></span>
                    </div>
                    <div class="pyg2-trend-canvas"><canvas id="pygChartUtilidadNeta"></canvas></div>
                </div>
            </div>
        </div>

        @* 5. Tabla detallada *@
        <div class="pyg2-table-card">
            <div class="pyg2-card-head" style="align-items:center">
                <div>
                    <div class="pyg2-card-title">@Resources.Strings.PYG_V2_TablaTitulo</div>
                    <div class="pyg2-card-sub" id="pygInfoBadge">@Resources.Strings.PYG_UnidadMillones</div>
                </div>
                <div class="pyg2-table-tools">
                    <div class="pyg2-seg soft" id="pygSegTabla">
                        <button type="button" data-v="periodo">@Resources.Strings.PYG_V2_Periodo</button>
                        <button type="button" data-v="acum">@Resources.Strings.PYG_V2_Acumulado</button>
                        <button type="button" data-v="ambos" class="active">@Resources.Strings.PYG_V2_Ambos</button>
                    </div>
                    <button type="button" class="pyg2-yoy-btn on" id="pygBtnYoY" aria-pressed="true"><i class="fas fa-square-check"></i>@Resources.Strings.PYG_V2_VsAnioAnterior</button>
                </div>
            </div>
            <div class="pyg2-table-wrap">
                <table class="pyg2-table" id="pygTabla"><thead id="pygTablaHead"></thead><tbody id="pygTablaBody"></tbody></table>
            </div>
            <div class="pyg2-table-legend">
                <span><i class="dot" style="background:#16A34A"></i>@Resources.Strings.PYG_V2_Favorable</span>
                <span><i class="dot" style="background:#DC2626"></i>@Resources.Strings.PYG_V2_LeyendaDesfavorable</span>
                <span><i class="fas fa-circle-exclamation"></i>@Resources.Strings.PYG_V2_LeyendaCritico</span>
            </div>
        </div>
        <p class="lt-help" id="pygNotaSinAnterior" style="display:none;"></p>
        <p class="lt-help" id="pygNotaEscenario" style="display:none;"></p>

        @* Insights gerenciales (IA): se ocultan si la empresa tiene la IA apagada *@
        @if (bufinscustomers.Helpers.IAModuloHelper.Visible())
        {
        <div class="pyg-insights-card">
            <div class="pyg-insights-head">
                <div>
                    <span class="pyg-insights-title"><i class="fas fa-wand-magic-sparkles"></i>@Resources.Strings.PYG_InsightsTitulo</span>
                    <div class="pyg-insights-meta" id="pygInsightsMeta">@Resources.Strings.PYG_V2_InsightsSub</div>
                </div>
                <button type="button" id="btnGenerarInsightsPYG" class="pyg2-ins-btn"><i class="fas fa-wand-magic-sparkles"></i><span>@Resources.Strings.PYG_V2_Generar</span></button>
            </div>
            <div id="pygInsightsBody"></div>
            <div id="pygInsightsLoading" style="display:none;text-align:center;padding:14px 0;">
                @Html.Partial("_LoaderDots", "dark")
                <p style="margin-top:8px;font-size:12.5px;color:#8B85A0;">@Resources.Strings.PYG_V2_Analizando</p>
            </div>

            <div class="mt-3">
                <label for="pygPregunta" class="mb-1" style="font-weight:700;"><i class="fas fa-comments mr-1"></i>@Resources.Strings.IAInforme_Titulo</label>
                <div class="d-flex" style="gap:8px;flex-wrap:wrap;">
                    <input type="text" id="pygPregunta" class="form-control" maxlength="@bufinscustomers.Helpers.IAModuloHelper.MaxCharsPregunta()" style="flex:1;min-width:240px;"
                           placeholder="@Resources.Strings.IAInforme_Placeholder" />
                    <button type="button" id="btnPygPreguntar" class="pyg2-ins-btn"><i class="fas fa-paper-plane"></i><span>@Resources.Strings.IAInforme_Btn</span></button>
                </div>
                <div id="pygRespuesta" class="mt-2"></div>
            </div>
        </div>
        }
    </div>

</div>
</div>

<div id="overlayConsultandoPYG" class="overlay-cargando" style="display:none;">
    <div class="overlay-cargando-card">
        @Html.Partial("_LoaderDots", "aqua")
        <h5 class="overlay-cargando-title">@Resources.Strings.PYG_JS_Consultando</h5>
    </div>
</div>

@section scripts {
<script src="~/Assets/js/select2/select2.min.js"></script>
<script src="~/Assets/js/chart.umd.min.js"></script>
<script src="~/Assets/js/jspdf.umd.min.js"></script>
<script src="~/Assets/js/bufins-markdown.js"></script>
<script src="~/Assets/js/rango-atajos.js"></script>

<script>
    var _pyg = {
        urls: {
            meses: '@Url.Action("ObtenerMeses", "InformePYG")',
            reporte: '@Url.Action("ConsultarReporte", "InformePYG")',
            insights: '@Url.Action("GenerarInsightsIA", "InformePYG")',
            preguntar: '@Url.Action("PreguntarInforme", "InformePYG")'
        },
        token: $('input[name="__RequestVerificationToken"]').first().val(),
        cultura: '@Html.Raw(HttpUtility.JavaScriptStringEncode(culturaJs))',
        esAdmin: @Html.Raw(esAdmin.ToString().ToLowerInvariant()),
        mesesNombres: [
            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Mes1))',
            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Mes2))',
            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Mes3))',
            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Mes4))',
            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Mes5))',
            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Mes6))',
            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Mes7))',
            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Mes8))',
            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Mes9))',
            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Mes10))',
            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Mes11))',
            '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Common_Mes12))'
        ],
        textos: {
            colEstructura: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PYG_ColEstructura))',
            colReal: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PYG_ColReal))',
            colPresupuesto: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PYG_ColPresupuesto))',
            colVarAbs: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PYG_ColVarAbs))',
            colVarPct: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PYG_ColVarPct))',
            colMargen: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PYG_ColMargen))',
            colMesGrupoFmt: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PYG_ColMesGrupoFmt))',
            colAcumGrupoFmt: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PYG_ColAcumGrupoFmt))',
            colVarYoy: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PYG_ColVarYoY))',
            colVarYoyTooltip: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PYG_ColVarYoYTooltip))',
            kpiMargenBruto: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PYG_KpiMargenBruto))',
            kpiEbitda: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PYG_KpiEbitda))',
            kpiMargenNeto: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PYG_KpiMargenNeto))',
            kpiPeriodoMes: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PYG_KpiPeriodoMes))',
            kpiPeriodoAcum: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PYG_KpiPeriodoAcum))',
            kpiVsPresupuesto: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.PYG_KpiVsPresupuesto))',
