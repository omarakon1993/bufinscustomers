                        grid: { display: false }, border: { display: false },
                        ticks: {
                            font: { family: "'Nunito', sans-serif", size: 10, weight: '700' },
                            color: function (c) { var p = puntos[c.index]; return p && enRango(p) ? '#583AFF' : '#8B85A0'; }
                        }
