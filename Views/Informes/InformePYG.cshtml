    // ===== Utilidades comunes de la v2 =====

    // En líneas de costo/gasto/impuesto (valores en magnitud positiva) gastar/crecer más de lo
    // comparado es DESFAVORABLE aunque el número sea positivo — se invierte el color.
    function esFavorable(esGastoOCosto, valor) {
        return esGastoOCosto ? valor <= 0 : valor >= 0;
    }

    // 'good' | 'bad' | 'neu' (cero o sin dato).
    function claseVariacion(esGastoOCosto, valor) {
        if (valor === null || valor === undefined || valor === 0) return 'neu';
        return esFavorable(esGastoOCosto, valor) ? 'good' : 'bad';
    }

    // Umbral a partir del cual una variación % se marca como "crítica" (ícono) para que el ojo vaya
    // directo a lo que más importa, sin perder el detalle de las demás líneas.
    var PYG_UMBRAL_CRITICO = 0.15;

    // Chip de variación (KPIs / tendencias / tabla). "favorable" decide el color (verde/rojo) y el
    // caret sigue el signo real del número.
    function chipVariacion(texto, valor, favorable, conCritico) {
        if (valor === null || valor === undefined || isNaN(valor)) return '<span class="pyg2-dchip">' + CH_MDASH + '</span>';
        var icono = (conCritico && Math.abs(valor) >= PYG_UMBRAL_CRITICO)
            ? '<i class="fas fa-circle-exclamation"></i>'
            : '<i class="fas fa-caret-' + (valor >= 0 ? 'up' : 'down') + '"></i>';
        return '<span class="pyg2-dchip ' + (favorable ? 'up' : 'down') + '">' + icono + escHtml(texto) + '</span>';
    }

    function variacionRelativa(real, base) {
        if (base === null || base === undefined || base === 0) return null;
        return (real - base) / Math.abs(base);
    }

    // Etiqueta de subtotal en formato oración ("UTILIDAD BRUTA" / "Utilidad Bruta" → "Utilidad bruta"),
    // respetando acrónimos (EBITDA…).
    var PYG_ACRONIMOS = ['EBITDA', 'EBIT', 'EBT', 'PUC', 'IVA', 'ICA', 'COP', 'AIU', 'GMF'];
    function etiquetaCuenta(desc, esSubtotal) {
        if (!esSubtotal || !desc) return desc || '';
        return desc.split(' ').map(function (w, i) {
            if (PYG_ACRONIMOS.indexOf(w.toUpperCase()) >= 0) return w.toUpperCase();
            var min = w.toLowerCase();
            return i === 0 ? min.charAt(0).toUpperCase() + min.slice(1) : min;
        }).join(' ');
    }

    // ===== KPIs: Ingresos + 3 márgenes, en vista Período o Acumulado =====
    function pintarKpis(r) {
        var $s = $('#pygKpiStrip').empty();
        var datos = datosKpisPYG(r, _pyg.kpiVista === 'acum');
        datos.tarjetas.forEach(function (t) {
            $s.append(tarjetaKpi(t.icono, t.nombre, t.valorTxt, t.pptoTxt, t.real, t.ppto, datos.refs, t.deltas));
        });
    }

    // Datos de las 4 tarjetas KPI (Ingresos + 3 márgenes) en vista Período o Acumulado — los usan tanto
    // la pantalla (pintarKpis) como el PDF (generarPdf), para que muestren exactamente las mismas cifras.
    // deltas: [{ref, d, txt}] con d === undefined → la comparación no aplica; d === null → sin base ("—").
    function datosKpisPYG(r, acum) {
        var v2 = _pyg.textos.v2, tarjetas = [];
        var refs = {
            comp: compNombre(r),
            vsComp: v2.vsAnioFmt.replace('{0}', compNombreFrase(r)),
            vsAnt: v2.vsAnioFmt.replace('{0}', anioAnteriorTexto(r)),
            vsEsc: v2.vsAnioFmt.replace('{0}', escenarioCompNombre(r))
        };

        var ing = r.IngresosFila;
        if (ing) {
            var real = acum ? ing.AcumReal : ing.PeriodoReal;
            var ppto = acum ? ing.AcumPresupuesto : ing.PeriodoPresupuesto;
            var ant = acum ? ing.AcumRealAnioAnterior : ing.PeriodoRealAnioAnterior;
            var esc = acum ? ing.AcumRealEscenario : ing.PeriodoRealEscenario;
            var dPpto = variacionRelativa(real, ppto);
            var dAnt = r.HayAnioAnterior ? variacionRelativa(real, ant) : undefined;
            var dEsc = r.HayEscenarioComparar ? variacionRelativa(real, esc) : undefined;
            var fmtRel = function (d) { return (d === null || d === undefined) ? null : fmtPctVar(d); };
            tarjetas.push({
                icono: 'fa-sack-dollar', nombre: v2.ingresos, valorTxt: fmtNum(real), pptoTxt: fmtNum(ppto), real: real, ppto: ppto,
                deltas: [
                    { ref: refs.vsComp, d: dPpto, txt: fmtRel(dPpto) },
                    { ref: refs.vsAnt, d: dAnt, txt: fmtRel(dAnt) },
                    { ref: refs.vsEsc, d: dEsc, txt: fmtRel(dEsc) }
                ]
            });
        }

        (r.Kpis || []).forEach(function (k) {
            var real = acum ? k.AcumRealPct : k.PeriodoRealPct;
            var ppto = acum ? k.AcumPresupuestoPct : k.PeriodoPresupuestoPct;
            var ant = acum ? k.AcumRealPctAnioAnterior : k.PeriodoRealPctAnioAnterior;
            var esc = acum ? k.AcumRealPctEscenario : k.PeriodoRealPctEscenario;
            var pp = function (base, hay) {
                if (!hay) return { d: undefined, txt: null };
                if (base === null || base === undefined) return { d: null, txt: null };
                return { d: real - base, txt: fmtPuntos(real - base) + ' pp' };
            };
            var vAnt = pp(ant, r.HayAnioAnterior), vEsc = pp(esc, r.HayEscenarioComparar);
            tarjetas.push({
                icono: _pyg.kpiIconos[k.Codigo] || 'fa-chart-pie', nombre: _pyg.kpiNombres[k.Codigo] || k.Codigo,
                valorTxt: fmtPct(real), pptoTxt: fmtPct(ppto), real: real, ppto: ppto,
                deltas: [
                    { ref: refs.vsComp, d: real - ppto, txt: fmtPuntos(real - ppto) + ' pp' },
                    { ref: refs.vsAnt, d: vAnt.d, txt: vAnt.txt },
                    { ref: refs.vsEsc, d: vEsc.d, txt: vEsc.txt }
                ]
            });
        });

        return { refs: refs, tarjetas: tarjetas };
    }

    // deltas: [{ref, d, txt}] — d === undefined → esa comparación no aplica (no se pinta la fila);
    // d === null → aplica pero no hay base (se pinta "—").
    function tarjetaKpi(icono, nombre, valorTxt, pptoTxt, real, ppto, refs, deltas) {
        var ancho = ppto > 0 ? Math.max(0, Math.min(100, real / ppto * 100)) : (real >= ppto ? 100 : 0);
        var filas = deltas.filter(function (x) { return x.d !== undefined; }).map(function (x) {
            return '<div class="row"><span class="ref">' + escHtml(x.ref) + '</span>' + chipVariacion(x.txt, x.d, x.d >= 0, false) + '</div>';
        }).join('');
