                        case 'Real': txt = fmtNum(v); col = (esSub || esTotal) ? C.texto : C.texto2; estilo = (esSub || esTotal) ? 'bold' : 'normal'; break;
                        case 'Presupuesto': txt = fmtNum(v); col = C.muted; break;
                        case 'VariacionAbsoluta': txt = fmtNumVar(v); estilo = 'bold'; col = claseVariacion(f.EsGastoOCosto, v) === 'good' ? C.bueno : (claseVariacion(f.EsGastoOCosto, v) === 'bad' ? C.malo : C.muted); break;
                        case 'Margen': txt = fmtPct(v); break;
                        default:
                            txt = fmtPctVar(v); estilo = 'bold';
                            var cl = claseVariacion(f.EsGastoOCosto, v);
                            col = cl === 'good' ? C.bueno : (cl === 'bad' ? C.malo : C.muted);
                            if (c.k === 'VariacionPorcentual' && v !== null && v !== undefined && Math.abs(v) >= PYG_UMBRAL_CRITICO) {
                                fuente('bold', tamFuente, col);
                                rgb('setFillColor', C.malo);
                                pdf.circle(xr - ancho(txt) - 1.8, y + 3.2, 0.8, 'F');
                            }
                    }
                    fuente(estilo, tamFuente, col);
                    pdf.text(String(txt), xr, y + 4.3, { align: 'right' });
                });
                if (bi > 0) {
                    rgb('setDrawColor', C.linea);
                    pdf.setLineWidth(0.5);
                    pdf.line(x0, y, x0, y + hF);
                }
            });
            rgb('setDrawColor', C.lineaSuave);
            pdf.setLineWidth(0.15);
            pdf.line(M, y + hF, M + ANCHO, y + hF);
            y += hF;
        });

        // Leyenda de la tabla
        y += 5;
        if (y > LIMITE_Y - 2) nuevaPagina(P.tablaTitulo);
        var xLey = M;
        [{ t: v2.favorable, c: C.bueno }, { t: P.leyendaDesfavorable, c: C.malo }, { t: P.leyendaCritico, c: C.malo }].forEach(function (l) {
            rgb('setFillColor', l.c);
            pdf.circle(xLey + 1, y - 1, 0.9, 'F');
            fuente('bold', 7, C.muted);
            pdf.text(l.t, xLey + 3, y);
            xLey += ancho(l.t) + 9;
        });

        // Pie de página en todas las páginas (se agrega al final para conocer el total)
        var totalPags = pdf.internal.getNumberOfPages();
        for (var p = 1; p <= totalPags; p++) {
            pdf.setPage(p);
            rgb('setDrawColor', C.linea);
            pdf.setLineWidth(0.3);
            pdf.line(M, H - 10, W - M, H - 10);
            fuente('normal', 7, C.muted);
            pdf.text(T.pdfFooter + '  ' + CH_MIDDOT + '  ' + empresa + '  ' + CH_MIDDOT + '  ' + periodo, M, H - 6);
            pdf.text(P.confidencial, W / 2, H - 6, { align: 'center' });
            fuente('bold', 7, C.texto2);
            pdf.text(P.paginaFmt.replace('{0}', p).replace('{1}', totalPags), W - M, H - 6, { align: 'right' });
        }

        var nombreArchivo = 'PYG_' + empresa.replace(/[^a-z0-9]+/gi, '_') + '_' +
            r.AnioDesde + ('0' + r.MesDesde).slice(-2) + '-' + r.AnioHasta + ('0' + r.MesHasta).slice(-2) + '.pdf';
        pdf.save(nombreArchivo);
    }

    $(document).ready(function () {
        _pyg.escenarios = $('#pygEscenario option').map(function () {
            return { id: Number(this.value), nombre: $(this).text() };
        }).get().filter(function (e) { return e.id > 0; });

        $('#pygEmpresa, #pygEscenario, #pygComparar, #pygEscenarioComparar, #pygNivelDetalle')
            .select2({ width: '100%', language: s2lang, dropdownAutoWidth: false, minimumResultsForSearch: 10 });

        $('#pygEmpresa, #pygEscenario').on('change', cargarMeses);

        // "Detalle de la tabla" no requiere volver a consultar: solo filtra las filas ya cargadas.
        $('#pygNivelDetalle').on('change', function () {
            if (_pyg.reporteActual) pintarTabla(_pyg.reporteActual);
        });

        $('#pygSegVerPor button').on('click', function () {
            var modo = $(this).data('modo');
            $('#pygSegVerPor button').removeClass('active').attr('aria-pressed', 'false');
            $(this).addClass('active').attr('aria-pressed', 'true');
            _pyg.agrupar = modo;
            $('#pygAgruparHint').text(_pyg.textos.agruparAyuda[modo] || '');
        });

        $('#pygAtajos button').on('click', function () { aplicarPresetRangoPYG($(this).data('preset')); });
        $('#pygKnobFrom').on('pointerdown', function (e) { e.stopPropagation(); iniciarArrastreSliderPYG(e, 'from'); });
        $('#pygKnobTo').on('pointerdown', function (e) { e.stopPropagation(); iniciarArrastreSliderPYG(e, 'to'); });
        $('#pygRangoTrack').on('pointerdown', function (e) { clicEnPistaPYG(e); });
        $('#pygKnobFrom, #pygKnobTo').on('keydown', function (e) { moverKnobConTecladoPYG(e, this.id === 'pygKnobFrom' ? 'from' : 'to'); });

        // Menú de unidad (Pesos/Miles/Millones): abre con el botón, se cierra al elegir o con clic afuera.
        $('#pygBtnUnidad').on('click', function (e) {
            e.stopPropagation();
            var abierto = $('#pygMenuUnidad').toggleClass('open').hasClass('open');
            $(this).attr('aria-expanded', abierto ? 'true' : 'false');
        });
        $('#pygMenuUnidad button').on('click', function (e) {
            e.stopPropagation();
            _pyg.unidad = $(this).data('unidad');
            $('#pygMenuUnidad').removeClass('open');
            $('#pygBtnUnidad').attr('aria-expanded', 'false');
            guardarPrefsPYG();
            repintarConUnidadActual();
        });
        $(document).on('click', function () {
            $('#pygMenuUnidad').removeClass('open');
            $('#pygBtnUnidad').attr('aria-expanded', 'false');
        });

        $('#pygSegKpi button').on('click', function () {
            _pyg.kpiVista = $(this).data('v');
            $('#pygSegKpi button').removeClass('active');
            $(this).addClass('active');
            guardarPrefsPYG();
            if (_pyg.reporteActual) pintarKpis(_pyg.reporteActual);
        });
        $('#pygSegTabla button').on('click', function () {
            _pyg.vistaTabla = $(this).data('v');
            $('#pygSegTabla button').removeClass('active');
            $(this).addClass('active');
            guardarPrefsPYG();
            if (_pyg.reporteActual) pintarTabla(_pyg.reporteActual);
        });
        $('#pygBtnYoY').on('click', function () {
            _pyg.mostrarYoY = !_pyg.mostrarYoY;
            guardarPrefsPYG();
            actualizarBotonYoY();
            if (_pyg.reporteActual) pintarTabla(_pyg.reporteActual);
        });
        // Excel con los mismos filtros del reporte en pantalla (no los del panel, que pudieron cambiar).
        $('#btnExportarExcelPYG').on('click', function () {
            if (!_pyg.filtrosConsultados) return;
            var campos = $.extend({}, _pyg.filtrosConsultados, { soloSubtotales: $('#pygNivelDetalle').val() === 'subtotales' });
            var $c = $('#pygExpCampos').empty();
            Object.keys(campos).forEach(function (k) {
                $c.append($('<input type="hidden">').attr('name', k).val(campos[k] == null ? '' : campos[k]));
            });
            $('#frmExportarExcelPYG').submit();
        });

        $('#btnConsultarPYG').on('click', consultarReporte);
        $('#btnLimpiarPYG').on('click', function () {
            $('#pygComparar').val('ppto').trigger('change.select2');
            $('#pygEscenarioComparar').val('').trigger('change.select2');
            $('#pygNivelDetalle').val('todas').trigger('change.select2');
            $('#pygSegVerPor button[data-modo="Mes"]').trigger('click');
            if (_pyg.esAdmin) elEmpresa.val('').trigger('change.select2');
            cargarMeses();
        });

        $('#btnGenerarInsightsPYG').on('click', generarInsights);
        $('#btnPygPreguntar').on('click', preguntarInforme_pyg);
        $('#pygPregunta').on('keydown', function (e) { if (e.which === 13) { e.preventDefault(); preguntarInforme_pyg(); } });
        $('#btnExportarPdfPYG').on('click', generarPdf);

        cargarPrefsPYG();
        pintarRangoPYG();
        cargarMeses();
    });
</script>
