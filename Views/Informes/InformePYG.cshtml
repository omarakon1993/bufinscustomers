    // El prompt del PYG (RESUMEN_PYG_GERENCIAL en GestorPrompts, o PromptResumenPygPorDefecto en el
    // controlador) pide 3 líneas fijas "Logro:", "Alerta:" y "Eficiencia:". Se separan por esas palabras
    // clave al inicio de línea (tolerando viñetas, encabezados markdown y la etiqueta en negrita, p. ej.
    // "- **Logro del periodo:** …") para pintarlas como 3 tarjetas; las **negritas** del contenido se
    // conservan (resaltan la cifra clave). Si falta alguna, null → se muestra el markdown completo.
    function separarInsights(texto) {
        var claves = { logro: /^(logro|achievement)/i, alerta: /^(alerta|alert)/i, eficiencia: /^(eficiencia|efficiency)/i };
        var etiqueta = /^(\*\*|__)?\s*(logro|alerta|eficiencia|achievement|alert|efficiency)[^:]*:\s*(\*\*|__)?\s*/i;
        var partes = { logro: [], alerta: [], eficiencia: [] }, actual = null;
        (texto || '').split(/\r?\n/).forEach(function (linea) {
            var conFormato = linea.replace(/^\s*(?:[-•>#]+|\*(?=\s)|\d+[.)])\s*/, '').trim();
            var plano = conFormato.replace(/\*\*|__/g, '').trim();
            if (!plano) return;
            var encontrada = null;
            Object.keys(claves).forEach(function (k) { if (!encontrada && claves[k].test(plano)) encontrada = k; });
            if (encontrada) {
                actual = encontrada;
                // Sin ":" la línea es solo un título ("### Logro") y el contenido viene en las siguientes.
                var resto = plano.indexOf(':') >= 0 ? conFormato.replace(etiqueta, '').trim() : '';
                if (resto) partes[actual].push(resto);
                return;
            }
            if (actual) partes[actual].push(conFormato);
        });
        if (!partes.logro.length || !partes.alerta.length || !partes.eficiencia.length) return null;
        return { logro: partes.logro.join(' '), alerta: partes.alerta.join(' '), eficiencia: partes.eficiencia.join(' ') };
    }

    function pintarInsights(texto) {
        var v2 = _pyg.textos.v2;
        var secciones = separarInsights(texto);
        if (!secciones) {
            var md = (typeof window.bufinsMarkdown === 'function') ? window.bufinsMarkdown(texto) : escHtml(texto).replace(/\n/g, '<br>');
            $('#pygInsightsBody').html('<div class="pyg-insights-body">' + md + '</div>');
            return;
        }
        var tiles = [
            { cls: 'logro', icono: 'fa-trophy', titulo: v2.logro, texto: secciones.logro },
            { cls: 'alerta', icono: 'fa-triangle-exclamation', titulo: v2.alerta, texto: secciones.alerta },
            { cls: 'eficiencia', icono: 'fa-gauge-high', titulo: v2.eficiencia, texto: secciones.eficiencia }
        ];
        $('#pygInsightsBody').html('<div class="pyg2-ins-grid">' + tiles.map(function (t) {
            return '<div class="pyg2-ins-tile ' + t.cls + '">' +
                '<div class="h"><span class="ic"><i class="fas ' + t.icono + '"></i></span><span class="t">' + escHtml(t.titulo) + '</span></div>' +
                '<p>' + textoConNegritas(t.texto) + '</p></div>';
