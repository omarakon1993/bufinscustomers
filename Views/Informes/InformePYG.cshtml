        pintarUnChart('Ebitda', r.TendenciaEbitda || [], r);
        pintarUnChart('UtilidadNeta', r.TendenciaUtilidadNeta || [], r);
    }

    // Waterfall Ingresos -> Utilidad Neta (Real) del período seleccionado. Cada tramo intermedio ya
    // viene calculado por el servicio como la diferencia exacta entre dos subtotales consecutivos del
    // modelo, así que las barras SIEMPRE cuadran con Ingresos-Utilidad Neta reales (ver ArmarCascada).
    function pintarCascada(r) {
        var barras = r.CascadaPeriodo || [];
        if (!barras.length) return;
        var etiquetas = barras.map(function (b) { return _pyg.cascadaNombres[b.Etiqueta] || b.Etiqueta; });
        var datos = barras.map(function (b) { return [escalarValor(b.Desde), escalarValor(b.Hasta)]; });
        var colores = barras.map(function (b) {
            if (b.Tipo === 'total') return '#6366F1';
            return b.Tipo === 'positivo' ? '#16A34A' : '#F87171';
        });
        $('#pygLeyendaSuma').toggle(barras.some(function (b) { return b.Tipo === 'positivo'; }));
        var meta = escalarValor(r.CascadaPresupuestoUtilidadNeta || 0);
        var maxBarras = Math.max.apply(null, barras.map(function (b) { return escalarValor(b.Hasta); }).concat([meta, 0]));

        // Valor sobre cada barra + conectores punteados entre tramos (sin librerías de etiquetas).
        var etiquetasPlugin = {
            id: 'pygCascadaEtiquetas',
            afterDatasetsDraw: function (chart) {
                var ctx = chart.ctx, metaBarras = chart.getDatasetMeta(0), escalaY = chart.scales.y;
                if (!metaBarras || !metaBarras.data.length) return;
                var yMeta = escalaY.getPixelForValue(meta);
                ctx.save();
                ctx.font = '800 12px Nunito, sans-serif';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'bottom';
                metaBarras.data.forEach(function (el, i) {
                    var b = barras[i], tope = Math.min(el.y, el.base);
                    var y = (i === barras.length - 1 ? Math.min(tope, yMeta) : tope) - 7;
                    ctx.fillStyle = b.Tipo === 'total' ? '#16121F' : (b.Tipo === 'positivo' ? '#16A34A' : '#DC2626');
                    ctx.fillText(b.Tipo === 'total' ? fmtNum(b.Hasta) : fmtNumVar(b.Delta || 0), el.x, y);
                });
                ctx.strokeStyle = '#C7C2E6';
                ctx.lineWidth = 1;
                ctx.setLineDash([3, 3]);
                for (var i = 0; i < metaBarras.data.length - 1; i++) {
                    var el = metaBarras.data[i], sig = metaBarras.data[i + 1], b = barras[i];
                    // Nivel donde termina el tramo: totales y sumas en "Hasta"; restas en "Desde" (su valor bajo).
                    var nivel = b.Tipo === 'negativo' ? b.Desde : b.Hasta;
                    var y = Math.round(escalaY.getPixelForValue(escalarValor(nivel))) + 0.5;
                    ctx.beginPath();
                    ctx.moveTo(el.x + el.width / 2, y);
                    ctx.lineTo(sig.x - sig.width / 2, y);
                    ctx.stroke();
                }
                ctx.restore();
            }
        };

        _pyg.charts['pygChartCascada'] = new Chart(document.getElementById('pygChartCascada').getContext('2d'), {
            type: 'bar',
            data: {
                labels: etiquetas,
                datasets: [
                    {
                        label: _pyg.textos.colReal, data: datos, backgroundColor: colores,
                        borderRadius: 6, borderSkipped: false, barPercentage: 0.7, categoryPercentage: 0.8, maxBarThickness: 78
                    },
                    {
                        type: 'line', label: _pyg.textos.cascadaPresupuestoNeta,
                        data: etiquetas.map(function () { return meta; }),
