        var sombreadoPlugin = {
            id: 'pygPeriodoSombreado',
            beforeDatasetsDraw: function (chart) {
                var idx = [];
                puntos.forEach(function (p, i) { if (enRango(p)) idx.push(i); });
                if (!idx.length) return;
                var x = chart.scales.x, area = chart.chartArea;
                var paso = n > 1 ? (x.getPixelForValue(1) - x.getPixelForValue(0)) : area.width;
                var x0 = Math.max(area.left, x.getPixelForValue(idx[0]) - paso / 2);
                var x1 = Math.min(area.right, x.getPixelForValue(idx[idx.length - 1]) + paso / 2);
                var ctx = chart.ctx;
                ctx.save();
                ctx.fillStyle = '#EEF2FF';
                ctx.beginPath();
                if (ctx.roundRect) ctx.roundRect(x0, area.top, x1 - x0, area.bottom - area.top, 6);
                else ctx.rect(x0, area.top, x1 - x0, area.bottom - area.top);
                ctx.fill();
                ctx.restore();
            }
        };

        _pyg.charts[canvasId] = new Chart(document.getElementById(canvasId).getContext('2d'), {
            type: 'line',
            data: {
