    // ===== Gráficos =====
    function destruirCharts() {
        Object.keys(_fl.charts).forEach(function (k) { if (_fl.charts[k]) _fl.charts[k].destroy(); });
        _fl.charts = {};
    }

    // Etiquetas de valor: Chart.js no las trae. Plugin liviano con anti-superposición (se ordenan por importancia: último,
    // máx./mín., primero, resto; las que chocan con una ya dibujada se omiten — el valor sigue en el tooltip y en la tabla).
    // El formateador va FUERA de las opciones de Chart.js (una función ahí se trataría como opción "scriptable").
    var ETQ_ALTO = 12, ETQ_SEP = 6, ETQ_PAD = 3;
    var flEtiquetas = {
        id: 'flEtiquetas',
        afterDatasetsDraw: function (chart) {
            var cfg = (chart.options.plugins && chart.options.plugins.flEtiquetas) || {};
            if (!_fl.etiquetas[cfg.clave]) return;
            var ctx = chart.ctx, area = chart.chartArea, cand = [];
            ctx.save();
            ctx.font = '600 10.5px ' + (ctx.font.split(' ').pop() || 'sans-serif');
            chart.data.datasets.forEach(function (ds, i) {
                if (ds.sinEtiqueta) return;
                var meta = chart.getDatasetMeta(i);
                if (!meta || !chart.isDatasetVisible(i)) return;
                var vals = ds.data, n = meta.data.length, iMax = -1, iMin = -1, esBarra = meta.type === 'bar';
                vals.forEach(function (v, k) {
                    if (v === null || v === undefined) return;
                    if (iMax < 0 || v > vals[iMax]) iMax = k;
                    if (iMin < 0 || v < vals[iMin]) iMin = k;
                });
                meta.data.forEach(function (el, idx) {
                    var v = vals[idx];
                    if (v === null || v === undefined || isNaN(el.x) || isNaN(el.y)) return;
                    var txt = fmtNumSolo(aPesos(v));
                    cand.push({ x: el.x, y: el.y, txt: txt, w: ctx.measureText(txt).width, neg: v < 0, barra: esBarra,
                        color: ds.etqColor || '#334155',
                        prio: idx === n - 1 ? 0 : (idx === iMax || idx === iMin) ? 1 : idx === 0 ? 2 : 3, ord: cand.length });
                });
            });
            cand.sort(function (a, b) { return a.prio - b.prio || a.ord - b.ord; });
            var puestas = [];
            cand.forEach(function (c) {
                var m = c.w / 2 + ETQ_PAD, cx = Math.min(Math.max(c.x, area.left + m), area.right - m);
                var arriba = c.y - ETQ_SEP - ETQ_ALTO, abajo = c.y + ETQ_SEP;
                var ops = c.barra ? [c.neg ? abajo : arriba] : (c.neg ? [abajo, arriba] : [arriba, abajo]);
                for (var k = 0; k < ops.length; k++) {
                    var b = { x1: cx - m, x2: cx + m, y1: ops[k], y2: ops[k] + ETQ_ALTO, cx: cx, c: c };
                    if (b.y1 < 0 || b.y2 > chart.height) continue;
                    if (puestas.some(function (o) { return b.x1 < o.x2 && b.x2 > o.x1 && b.y1 < o.y2 && b.y2 > o.y1; })) continue;
                    puestas.push(b); return;
                }
            });
            ctx.textAlign = 'center'; ctx.textBaseline = 'top'; ctx.lineJoin = 'round'; ctx.lineWidth = 3;
            ctx.strokeStyle = 'rgba(255,255,255,.92)';
            puestas.forEach(function (b) {
                ctx.strokeText(b.c.txt, b.cx, b.y1 + 1);
                ctx.fillStyle = b.c.color; ctx.fillText(b.c.txt, b.cx, b.y1 + 1);
            });
            ctx.restore();
        }
    };

    // Fondo blanco (el PDF/imagen exporta el canvas como JPEG).
    var flFondo = {
        id: 'flFondo',
        beforeDraw: function (chart) {
