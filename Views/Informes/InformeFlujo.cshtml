    var PDF_DEGRADADO = [[99, 102, 241], [59, 130, 246], [6, 182, 212], [1, 225, 215]];

    // PDF gerencial (A4 horizontal, jsPDF puro): pág. 1 resumen (estado, KPIs, insights, lo más relevante); pág. 2 gráficos (flujo mensual +
