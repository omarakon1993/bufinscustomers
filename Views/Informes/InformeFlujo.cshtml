    // ===== Utilidades =====
    function variacionRelativa(real, base) {
        if (base === null || base === undefined || base === 0) return null;
        return (real - base) / Math.abs(base);
    }
    var FL_UMBRAL_CRITICO = 0.15;
    function esFavorable(esGastoOCosto, valor) { return esGastoOCosto ? valor <= 0 : valor >= 0; }
    function claseVariacion(esGastoOCosto, valor) {
        if (valor === null || valor === undefined || valor === 0) return 'neu';
        return esFavorable(esGastoOCosto, valor) ? 'good' : 'bad';
    }
    function chipVariacion(texto, valor, favorable, conCritico) {
        if (valor === null || valor === undefined || isNaN(valor)) return '<span class="pyg2-dchip">' + CH_MDASH + '</span>';
        var icono = (conCritico && Math.abs(valor) >= FL_UMBRAL_CRITICO)
            ? '<i class="fas fa-circle-exclamation"></i>' : '<i class="fas fa-caret-' + (valor >= 0 ? 'up' : 'down') + '"></i>';
        return '<span class="pyg2-dchip ' + (favorable ? 'up' : 'down') + '">' + icono + escHtml(texto) + '</span>';
    }
    function kpiDe(r, codigo) { return (r.Kpis || []).filter(function (k) { return k.Codigo === codigo; })[0]; }
    function nombreLinea(f) { return f.Codigo ? (_fl.t.fila[f.Codigo] || f.Codigo) : f.Descripcion; }

    // ===== Estado (semáforo simple) =====
    function datosEstado(r) {
        var prim = kpiDe(r, _fl.kpiPrimario), neto = kpiDe(r, _fl.kpiNeto);
        if (!prim || !neto) return null;
        var t = _fl.t, nPrim = t.kpi[_fl.kpiPrimario], nNeto = t.kpi[_fl.kpiNeto];
        var args = function (fmt) { return fmt.replace('{0}', nPrim).replace('{1}', fmtNum(prim.Valor)).replace('{2}', nNeto).replace('{3}', fmtNum(neto.Valor)); };
        if (prim.Valor <= 0) return { cls: 'mal', icono: 'fa-triangle-exclamation', titulo: t.estadoMalTitulo, desc: args(t.estadoMalFmt) };
        if (neto.Valor < 0) return { cls: 'aviso', icono: 'fa-circle-exclamation', titulo: t.estadoAvisoTitulo, desc: args(t.estadoAvisoFmt) };
        return { cls: 'ok', icono: 'fa-circle-check', titulo: t.estadoOkTitulo, desc: args(t.estadoOkFmt) };
    }
    function pintarEstado(r) {
        var d = datosEstado(r), $e = $('#flEstado');
        if (!d) { $e.hide(); return; }
        $e.show().removeClass('ok mal aviso').addClass(d.cls);
        $e.find('.ic i').attr('class', 'fas ' + d.icono);
        $('#flEstadoTitulo').text(d.titulo);
        $('#flEstadoDesc').text(d.desc);
    }

    // ===== KPIs =====
    var KPI_ICONOS = {
        BrutoDespuesImpuestos: 'fa-hand-holding-dollar', CapitalTrabajo: 'fa-boxes-stacked', FclOperativo: 'fa-money-bill-trend-up', FlujoNeto: 'fa-scale-balanced', ConversionCaja: 'fa-percent',
        EfectivoOperacion: 'fa-hand-holding-dollar', FlujoOperacion: 'fa-gears', FlujoInversion: 'fa-industry', DeudaNeta: 'fa-landmark', AumentoNeto: 'fa-scale-balanced'
    };

    // Datos de las tarjetas (pantalla y PDF muestran exactamente lo mismo).
    function datosKpis(r) {
        var t = _fl.t;
        return (r.Kpis || []).map(function (k) {
            var pct = k.Formato === 'pct';
            var fmtV = function (v) { return pct ? fmtPct(v) : fmtNum(v); };
            var chipTxt = function (d) { return d === null || d === undefined ? null : (pct ? fmtPuntos(d) : fmtPctVar(d)); };
            var refs = [];
            if (!k.NoAplica) {
                if (r.HayPresupuesto) refs.push({ ref: t.vsPpto, val: fmtV(k.ValorPpto), chip: chipTxt(k.VariacionPptoPorcentual), d: k.VariacionPptoPorcentual });
                if (r.HayAnioAnterior) refs.push({ ref: t.vsAnio, val: fmtV(k.ValorAnt), chip: chipTxt(k.VariacionAnioPorcentual), d: k.VariacionAnioPorcentual });
                if (r.HayEscenarioComparar) refs.push({ ref: t.vsFmt.replace('{0}', nombreEscenarioComp(r)), val: fmtV(k.ValorEsc), chip: chipTxt(k.VariacionEscenarioPorcentual), d: k.VariacionEscenarioPorcentual });
            }
            var sano = k.Neutral ? null : (k.NoAplica ? null : k.Valor >= 0);
            return { codigo: k.Codigo, icono: KPI_ICONOS[k.Codigo] || 'fa-chart-pie', nombre: t.kpi[k.Codigo] || k.Codigo,
                valorTxt: k.NoAplica ? t.kpiNoAplica : fmtV(k.Valor), sano: sano, neutral: !!k.Neutral, refs: refs };
        });
    }

    function pintarKpis(r) {
        var $s = $('#flKpiStrip').empty();
        datosKpis(r).forEach(function (k) {
            var filas = k.refs.map(function (x) {
                var chip = x.chip ? '<span class="pyg2-dchip ' + (k.neutral ? '' : (x.d >= 0 ? 'up' : 'down')) + '">' + escHtml(x.chip) + '</span>' : '';
                return '<div class="row"><span class="ref">' + escHtml(x.ref) + '</span><span class="tes-kpi-nota">' + escHtml(x.val) + '</span>' + chip + '</div>';
            }).join('');
            var cls = k.sano === null ? '' : (k.sano ? 'tes-kpi-bueno' : 'tes-kpi-malo');
            $s.append(
                '<div class="pyg2-kpi ' + cls + '">' +
                    '<div class="pyg2-kpi-head"><span class="ic"><i class="fas ' + k.icono + '"></i></span><span class="nm">' + escHtml(k.nombre) + '</span></div>' +
                    '<div class="pyg2-kpi-val"><span class="v">' + escHtml(k.valorTxt) + '</span></div>' +
                    '<div class="pyg2-kpi-deltas">' + filas + '</div>' +
