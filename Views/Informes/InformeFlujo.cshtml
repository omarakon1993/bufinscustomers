            return;
        }
        // Clases de color de las tarjetas (compartidas con PYG): logro = verde, alerta = rojo, eficiencia = info.
        var tiles = [
            { cls: 'logro', icono: 'fa-seedling', titulo: t.insGeneracion, texto: secciones.generacion },
            { cls: 'eficiencia', icono: 'fa-route', titulo: t.insUso, texto: secciones.uso },
