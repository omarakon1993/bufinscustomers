    // El prompt (RESUMEN_FLUJO_*_GERENCIAL en GestorPrompts, o el por defecto del controlador) pide 3 líneas con etiquetas fijas
    // "Generación de caja:", "Uso del efectivo:" y "Acción recomendada:" (o sus equivalentes en inglés). Se separan por esas palabras
    // clave al inicio de línea (tolerando viñetas, encabezados markdown y negritas). Si falta alguna, null → markdown completo.
    function separarInsights(texto) {
        var claves = { generacion: /^(generaci[oó]n|cash generation)/i, uso: /^(uso\b|use of cash)/i, accion: /^(acci[oó]n|recommended action)/i };
        var etiqueta = /^(\*\*|__)?\s*(generaci[oó]n|uso|acci[oó]n|cash generation|use of cash|recommended action)[^:]*:\s*(\*\*|__)?\s*/i;
        var partes = { generacion: [], uso: [], accion: [] }, actual = null;
        (texto || '').split(/\r?\n/).forEach(function (linea) {
            var conFormato = linea.replace(/^\s*(?:[-•>#]+|\*(?=\s)|\d+[.)])\s*/, '').trim();
            var plano = conFormato.replace(/\*\*|__/g, '').trim();
            if (!plano) return;
            var encontrada = null;
            Object.keys(claves).forEach(function (k) { if (!encontrada && claves[k].test(plano)) encontrada = k; });
            if (encontrada) {
                actual = encontrada;
                var resto = plano.indexOf(':') >= 0 ? conFormato.replace(etiqueta, '').trim() : '';
                if (resto) partes[actual].push(resto);
                return;
            }
            if (actual) partes[actual].push(conFormato);
        });
        if (!partes.generacion.length || !partes.uso.length || !partes.accion.length) return null;
        return { generacion: partes.generacion.join(' '), uso: partes.uso.join(' '), accion: partes.accion.join(' ') };
    }
    function textoConNegritas(t) {
        return escHtml(t).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/__(.+?)__/g, '<strong>$1</strong>').replace(/\*\*|__/g, '');
    }
    function pintarInsights(texto) {
        var t = _fl.t, secciones = separarInsights(texto);
