        $('#flChipPeriodo').text(etiquetaPeriodoChip(r));
        $('#flChipEscenario').text(elEscenario.find(':selected').text() || '');
        $('#flChipMedida').text(_fl.t.medida[r.Medida] || r.Medida);
        $('#flChipComparado').text(comparados.length ? _fl.t.chipComparadoFmt.replace('{0}', comparados.join(', ')) : _fl.t.chipSinComparar);
