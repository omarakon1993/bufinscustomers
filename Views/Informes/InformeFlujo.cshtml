    // Imagen nítida de una gráfica: se re-renderiza temporalmente a 3x (y a la proporción exacta de su caja en el PDF) y se
    // exporta como JPEG sobre blanco (jsPDF incrusta los PNG sin comprimir). Al final se restaura el tamaño de pantalla.
    function capturarChartPdf(chart, anchoPx, altoPx) {
        if (!chart) return null;
        var dprOriginal = chart.options.devicePixelRatio;
        chart.options.devicePixelRatio = 3;
        if (anchoPx && altoPx) chart.resize(anchoPx, altoPx); else chart.resize();
        chart.update('none');
        var lienzo = document.createElement('canvas');
        lienzo.width = chart.canvas.width; lienzo.height = chart.canvas.height;
        var ctx = lienzo.getContext('2d');
        ctx.fillStyle = '#FFFFFF'; ctx.fillRect(0, 0, lienzo.width, lienzo.height);
        ctx.drawImage(chart.canvas, 0, 0);
        var img = { data: lienzo.toDataURL('image/jpeg', 0.9), w: chart.width, h: chart.height };
        chart.options.devicePixelRatio = dprOriginal;
        chart.resize();
        chart.update('none');
        return img;
    }

    var PDF_COL = {
        marca: [99, 102, 241], morado: [88, 58, 255], texto: [22, 18, 31], texto2: [91, 85, 112], muted: [139, 133, 160],
        linea: [228, 225, 240], lineaSuave: [238, 240, 246], suave: [244, 243, 251], suave2: [248, 247, 253], zebra: [252, 252, 254],
        totalBg: [238, 242, 255], totalTx: [59, 47, 191], bueno: [22, 163, 74], buenoBg: [236, 253, 243],
        malo: [220, 38, 38], maloBg: [254, 242, 242], ambar: [217, 119, 6], blanco: [255, 255, 255]
