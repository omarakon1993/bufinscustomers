    }

    // ===== Etiquetas de período (siempre a partir del reporte consultado, no del slider) =====
    function etiquetaRango(aD, mD, aH, mH) {
        var M = _fl.mesesCache;
        if (aD === aH && mD === mH) return M[mD - 1].nombre + ' ' + aH;
        if (aD === aH) return M[mD - 1].abrev + ' ' + CH_NDASH + ' ' + M[mH - 1].abrev + ' ' + aH;
        return M[mD - 1].abrev + ' ' + aD + ' ' + CH_NDASH + ' ' + M[mH - 1].abrev + ' ' + aH;
    }
    function etiquetaPeriodo(r) { return etiquetaRango(r.AnioDesde, r.MesDesde, r.AnioHasta, r.MesHasta); }
    function etiquetaPeriodoChip(r) {
        var n = r.MesesRango.length;
        return etiquetaPeriodo(r) + ' ' + CH_MIDDOT + ' ' + n + ' ' + (n === 1 ? _fl.t.badgeMes : _fl.t.badgeMeses);
    }
    function nombreEscenarioComp(r) {
        if (!r.HayEscenarioComparar) return '';
        var e = _fl.escenarios.filter(function (x) { return x.id === r.IdEscenarioComparar; })[0];
        return e ? e.nombre : ('#' + r.IdEscenarioComparar);
    }
    function abrevMes(mes, anio, conAnio, proy) { var a = _fl.mesesCache[mes - 1].abrev; return (conAnio ? (a + ' ' + String(anio).slice(-2)) : a) + (proy ? '*' : ''); }
    function nombreMes(mes) { return _fl.mesesCache[mes - 1].nombre; }

    function filtrosDelSlider() {
        var d = _fl.rango[_fl.iDesde], h = _fl.rango[_fl.iHasta];
        return {
            IdEmpresa: empresaSeleccionada() || '',
