        $('#flMenuUnidad button').on('click', function (e) {
            e.stopPropagation();
            _fl.unidad = $(this).data('unidad');
            $('#flMenuUnidad').removeClass('open');
            $('#flBtnUnidad').attr('aria-expanded', 'false');
            guardarPrefs();
            repintar();
        });
        $(document).on('click', function () { $('#flMenuUnidad').removeClass('open'); $('#flBtnUnidad').attr('aria-expanded', 'false'); });

        $('#flSegTabla button').on('click', function () {
            _fl.vistaTabla = $(this).data('v');
            $('#flSegTabla button').removeClass('active'); $(this).addClass('active');
            guardarPrefs();
            if (_fl.reporteActual) pintarTabla(_fl.reporteActual);
        });

        // Etiquetas de valor: un botón independiente por gráfico
        $('#flResultado').on('click', '.tes-btn-etq', function () {
            var k = $(this).data('chart');
            _fl.etiquetas[k] = !_fl.etiquetas[k];
            $(this).toggleClass('on', _fl.etiquetas[k]);
            if (_fl.charts[k]) _fl.charts[k].update('none');
        });

        $('#btnConsultarFl').on('click', consultarReporte);
        InformeTema.montar({ selector: '#flTema', empresa: '#flEmpresa' });
        $('#btnLimpiarFl').on('click', function () {
            InformeTema.reset();
            $('#flMedida').val('real').trigger('change.select2');
            $('#flEscenarioComparar').val('').trigger('change.select2');
            $('#flNivelDetalle').val('todas').trigger('change.select2');
            if (_fl.esAdmin) elEmpresa.val('').trigger('change.select2');
            cargarMeses();
        });

        $('#btnGenerarInsightsFl').on('click', generarInsights);
        $('#btnFlPreguntar').on('click', preguntarInforme);
        $('#flPregunta').on('keydown', function (e) { if (e.which === 13) { e.preventDefault(); preguntarInforme(); } });

        // Botón Exportar estándar: Excel · PDF · Copiar como imagen · Enviar por correo
        var correo = ExportMenu.correo({
            url: _fl.urls.correo,
            token: function () { return _fl.token; },
            datos: datosExportacion,   // mismos filtros que el Excel: el servidor reconstruye el informe
            pdf: function () { var d = construirPdf(_fl.reporteActual); return d ? d.output('datauristring') : ''; },
            pills: function () { return [$('#flTituloEmpresa').text()].concat($('#flPanelResultado .pyg2-chip').map(function () { return $(this).text(); }).get()); },
            textos: EXP_T
        });
        ExportMenu.init('flExp', {
            acciones: { excel: exportarExcel, pdf: generarPdf, imagen: copiarImagen, correo: function () { if (_fl.reporteActual) correo.abrir(); } },
            textos: EXP_T
        });

        cargarPrefs();
        pintarRango();
        cargarMeses();
    });
</script>
}
