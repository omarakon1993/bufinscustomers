            ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, chart.width, chart.height); ctx.restore();
        }
    };

    function pintarCharts(r) {
        destruirCharts();
        pintarPrincipal(r);
        pintarPuente(r.Cascada || [], 'flChartCascada', 'cascada', _fl.t.casc);
        pintarCajaCascada(r);
        $('#flGraficoSub').text(_fl.t.graficoSubFmt.replace('{0}', _fl.t.medida[r.Medida] || r.Medida));
        $('#flCascadaSub').text(_fl.t.cascadaSubFmt.replace('{0}', etiquetaPeriodo(r)));
    }

    // Flujo neto mensual (barras verde/rojo; claras los meses proyectados) + acumulado del rango (línea); presupuesto y escenario, como
    // líneas del acumulado.
    function pintarPrincipal(r) {
        var meses = r.Meses || [], variosAnios = meses.length && meses[0].Anio !== meses[meses.length - 1].Anio;
        var etiquetas = meses.map(function (m) { return abrevMes(m.Mes, m.Anio, variosAnios, m.Proyectado); });
        var alfa = function (hex, proy) { return proy ? hex + '66' : hex; };
        var datasets = [
            { type: 'bar', label: _fl.t.flujoNeto, data: meses.map(function (m) { return escalarValor(m.Neto); }), order: 4,
              backgroundColor: meses.map(function (m) { return alfa(m.Neto >= 0 ? '#16A34A' : '#F87171', m.Proyectado); }), borderRadius: 4, maxBarThickness: 36 },
            { type: 'line', label: _fl.t.netoAcum, data: meses.map(function (m) { return escalarValor(m.NetoAcum); }), order: 1,
              borderColor: InformeTema.actual.p, backgroundColor: InformeTema.actual.p, borderWidth: 2.5, tension: .25, pointRadius: 3, pointHoverRadius: 5, etqColor: InformeTema.actual.strong }
        ];
        if (r.HayPresupuesto) datasets.push({ type: 'line', label: _fl.t.medida.ppto + ' (' + _fl.t.netoAcum.toLowerCase() + ')', sinEtiqueta: true, order: 2,
            data: meses.map(function (m) { return escalarValor(m.NetoPptoAcum); }), borderColor: InformeTema.actual.comp, backgroundColor: 'transparent',
            borderWidth: 2, borderDash: [6, 4], tension: .25, pointRadius: 0, pointHoverRadius: 4 });
        // (El año anterior no se dibuja aquí: su escala suele aplastar el año en curso; va en los indicadores y en la tabla.)
        if (r.HayEscenarioComparar) datasets.push({ type: 'line', label: nombreEscenarioComp(r), sinEtiqueta: true, order: 3,
            data: meses.map(function (m) { return escalarValor(m.NetoEscAcum); }), borderColor: InformeTema.actual.tercero, backgroundColor: 'transparent',
            borderWidth: 2, tension: .25, pointRadius: 0, pointHoverRadius: 4 });

        _fl.charts.principal = new Chart(document.getElementById('flChartPrincipal').getContext('2d'), {
            type: 'bar',
            data: { labels: etiquetas, datasets: datasets },
            plugins: [flFondo, flEtiquetas],
            options: {
                responsive: true, maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                layout: { padding: { top: 14 } },
                plugins: {
                    legend: { display: false },
                    flEtiquetas: { clave: 'principal' },
                    tooltip: { callbacks: { label: function (c) { return c.dataset.label + ': ' + fmtNum(aPesos(c.parsed.y)); } } }
                },
                scales: {
                    x: { grid: { display: false }, ticks: { font: { size: 11 } } },
                    y: { ticks: { font: { size: 11 } }, grid: { color: function (c) { return c.tick && c.tick.value === 0 ? '#94A3B8' : '#EEF0F6'; } } }
                }
            }
        });
    }

    // Puente: cada tramo ya viene del servidor como diferencia exacta entre subtotales del modelo, así que SIEMPRE cuadra con el flujo
    // neto del rango.
    function colorBarraPuente(b) {
        if (b.Etiqueta === 'SinConciliar') return '#D97706';
        return b.Tipo === 'total' ? InformeTema.actual.p : (b.Tipo === 'positivo' ? '#16A34A' : '#F87171');
    }
    function pintarPuente(barras, canvasId, claveEtq, nombres) {
        if (!barras.length) return;
        var etiquetas = barras.map(function (b) { return nombres[b.Etiqueta] || b.Etiqueta; });
        var datos = barras.map(function (b) { return [escalarValor(b.Desde), escalarValor(b.Hasta)]; });
        var colores = barras.map(colorBarraPuente);

        var etiquetasPlugin = {
            id: 'flPuenteEtiquetas_' + claveEtq,
            afterDatasetsDraw: function (chart) {
                if (!_fl.etiquetas[claveEtq]) return;
                var ctx = chart.ctx, meta = chart.getDatasetMeta(0), escalaY = chart.scales.y;
                if (!meta || !meta.data.length) return;
                ctx.save();
                ctx.font = '800 12px Nunito, sans-serif';
                ctx.textAlign = 'center';
                meta.data.forEach(function (el, i) {
                    var b = barras[i], arriba = Math.min(el.y, el.base), abajoDe = Math.max(el.y, el.base);
                    var negativoTotal = b.Tipo === 'total' && b.Hasta < 0;
                    ctx.fillStyle = b.Tipo === 'total' ? '#16121F' : (b.Etiqueta === 'SinConciliar' ? '#B45309' : (b.Tipo === 'positivo' ? '#16A34A' : '#DC2626'));
                    ctx.textBaseline = negativoTotal ? 'top' : 'bottom';
                    ctx.fillText(b.Tipo === 'total' ? fmtNum(b.Hasta) : fmtNumVar(b.Delta || 0), el.x, negativoTotal ? abajoDe + 6 : arriba - 6);
                });
                ctx.strokeStyle = '#C7C2E6'; ctx.lineWidth = 1; ctx.setLineDash([3, 3]);
                for (var i = 0; i < meta.data.length - 1; i++) {
                    var el = meta.data[i], sig = meta.data[i + 1], b = barras[i];
                    var nivel = b.Tipo === 'negativo' ? b.Desde : b.Hasta;
                    var y = Math.round(escalaY.getPixelForValue(escalarValor(nivel))) + 0.5;
                    ctx.beginPath(); ctx.moveTo(el.x + el.width / 2, y); ctx.lineTo(sig.x - sig.width / 2, y); ctx.stroke();
                }
                ctx.restore();
            }
        };
        var niveles = [0];
        barras.forEach(function (b) { niveles.push(escalarValor(b.Desde), escalarValor(b.Hasta)); });
        var maxN = Math.max.apply(null, niveles), minN = Math.min.apply(null, niveles), margen = (maxN - minN) * 0.12 || 1;

        _fl.charts[claveEtq] = new Chart(document.getElementById(canvasId).getContext('2d'), {
            type: 'bar',
            data: { labels: etiquetas, datasets: [{ label: _fl.t.flujoNeto, data: datos, backgroundColor: colores, borderRadius: 6, borderSkipped: false, barPercentage: 0.7, categoryPercentage: 0.8, maxBarThickness: 78 }] },
            plugins: [flFondo, etiquetasPlugin],
            options: {
                responsive: true, maintainAspectRatio: false,
                layout: { padding: { top: 22, bottom: 14 } },
