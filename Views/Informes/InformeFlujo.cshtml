            medida: { real: '@Html.Raw(J("Flujo_Medida_real"))', proy: '@Html.Raw(J("Flujo_Medida_proy"))', ppto: '@Html.Raw(J("Flujo_Medida_ppto"))' },
            netoAcum: '@Html.Raw(J("Flujo_NetoAcumulado"))',
            flujoNeto: '@Html.Raw(J(P + "FlujoNeto"))',
            anioAnterior: '@Html.Raw(J("Flujo_ColAnioAnterior"))',
            colLinea: '@Html.Raw(J("Flujo_ColLinea"))',
            colTotal: '@Html.Raw(J("Flujo_ColTotal"))',
            colSaldoFin: '@Html.Raw(J("Flujo_ColSaldoFin"))',
            colVarAbs: '@Html.Raw(J("Flujo_ColVarAbs"))',
            colVarPct: '@Html.Raw(J("Flujo_ColVarPct"))',
            colVsEscenarioFmt: '@Html.Raw(J("Flujo_ColVsEscenarioFmt"))',
            estadoOkTitulo: '@Html.Raw(J(P + "EstadoOkTitulo"))',
            estadoAvisoTitulo: '@Html.Raw(J(P + "EstadoAvisoTitulo"))',
            estadoMalTitulo: '@Html.Raw(J(P + "EstadoMalTitulo"))',
            estadoOkFmt: '@Html.Raw(J("Flujo_EstadoOkFmt"))',
            estadoAvisoFmt: '@Html.Raw(J("Flujo_EstadoAvisoFmt"))',
            estadoMalFmt: '@Html.Raw(J("Flujo_EstadoMalFmt"))',
            graficoSubFmt: '@Html.Raw(J("Flujo_GraficoSubFmt"))',
            cascadaSubFmt: '@Html.Raw(J("Flujo_CascadaSubFmt"))',
            relevanteSubPpto: '@Html.Raw(J("Flujo_RelevanteSubPpto"))',
            relevanteSubAnio: '@Html.Raw(J("Flujo_RelevanteSubAnio"))',
            relevanteSubPeso: '@Html.Raw(J("Flujo_RelevanteSubPeso"))',
            sinDestacados: '@Html.Raw(J("Flujo_SinDestacados"))',
            favorable: '@Html.Raw(J("Flujo_Favorable"))',
            desfavorableCorto: '@Html.Raw(J("Flujo_DesfavorableCorto"))',
            mayorPeso: '@Html.Raw(J("Flujo_MayorPeso"))',
            vsPpto: '@Html.Raw(J("Flujo_VsPpto"))',
            vsAnio: '@Html.Raw(J("Flujo_VsAnioAnterior"))',
            vsFmt: '@Html.Raw(J("Flujo_VsFmt"))',
            chipComparadoFmt: '@Html.Raw(J("Flujo_ChipComparadoFmt"))',
            chipSinComparar: '@Html.Raw(J("Flujo_ChipSinComparar"))',
            chipPresupuesto: '@Html.Raw(J("Flujo_ChipPresupuesto"))',
            notaSinPresupuesto: '@Html.Raw(J("Flujo_NotaSinPresupuesto"))',
            notaProyectadoFmt: '@Html.Raw(J("Flujo_NotaProyectadoFmt"))',
            notaMesProyectado: '@Html.Raw(J("Flujo_NotaMesProyectado"))',
            escenarioSinDatosNota: '@Html.Raw(J("Flujo_EscenarioSinDatosNota"))',
            insightsVacio: '@Html.Raw(J("Flujo_InsightsVacio"))',
            insightsSub: '@Html.Raw(J("Flujo_InsightsSub"))',
            insightsMetaFmt: '@Html.Raw(J("Flujo_InsightsMetaFmt"))',
            insightsSinGenerar: '@Html.Raw(J("Flujo_InsightsSinGenerar"))',
            generar: '@Html.Raw(J("Flujo_Generar"))',
            regenerar: '@Html.Raw(J("Flujo_Regenerar"))',
            insGeneracion: '@Html.Raw(J("Flujo_InsGeneracion"))',
            insUso: '@Html.Raw(J("Flujo_InsUso"))',
            insAccion: '@Html.Raw(J("Flujo_InsAccion"))',
            errorServidor: '@Html.Raw(J("Flujo_ErrorServidor"))',
            kpiNoAplica: '@Html.Raw(J("Flujo_KpiNoAplica"))',
            badgeMes: '@Html.Raw(J("LineaTiempo_BadgeMes"))',
            badgeMeses: '@Html.Raw(J("LineaTiempo_BadgeMeses"))',
            unidades: { pesos: '@Html.Raw(J("LineaTiempo_UnidadPesos"))', miles: '@Html.Raw(J("LineaTiempo_UnidadMiles"))', millones: '@Html.Raw(J("LineaTiempo_UnidadMillones"))' },
            unidadSufijoMiles: '@Html.Raw(J("LineaTiempo_UnidadSufijoMiles"))',
            unidadSufijoMillones: '@Html.Raw(J("LineaTiempo_UnidadSufijoMillones"))',
            unidadBadge: { pesos: '@Html.Raw(J("Flujo_UnidadPesosCop"))', miles: '@Html.Raw(J("Flujo_UnidadMilesCop"))', millones: '@Html.Raw(J("Flujo_UnidadMillonesCop"))' },
            rangoTooltipFmt: '@Html.Raw(J("Rango_TooltipFmt"))',
            rangoSinDatosFmt: '@Html.Raw(J("Rango_SinDatosFmt"))',
            escenarioSinDatosEtiqueta: '@Html.Raw(J("Flujo_EscenarioSinDatosEtiqueta"))',
            escenarioSinDatosTooltip: '@Html.Raw(J("Flujo_EscenarioSinDatosTooltip"))',
            pdf: {
                marca: '@Html.Raw(J("LineaTiempo_BrandMark"))',
                titulo: '@Html.Raw(J(P + "PageTitle"))',
                subtitulo: '@Html.Raw(J(P + "Subtitulo"))',
                generadoEl: '@Html.Raw(J("Flujo_GeneradoEl"))',
                confidencial: '@Html.Raw(J("Flujo_Pdf_Confidencial"))',
                paginaFmt: '@Html.Raw(J("Flujo_Pdf_PaginaFmt"))',
                sinInsights: '@Html.Raw(J("Flujo_Pdf_SinInsights"))',
                resumen: '@Html.Raw(J("Flujo_Pdf_Resumen"))',
                analisis: '@Html.Raw(J("Flujo_Pdf_Analisis"))',
                indicadores: '@Html.Raw(J("Flujo_IndicadoresClave"))',
                insightsTitulo: '@Html.Raw(J("Flujo_InsightsTitulo"))',
                relevanteTitulo: '@Html.Raw(J("Flujo_RelevanteTitulo"))',
                tablaTitulo: '@Html.Raw(J(P + "TablaTitulo"))',
                graficoTitulo: '@Html.Raw(J("Flujo_GraficoTitulo"))',
                cascadaTitulo: '@Html.Raw(J(P + "CascadaTitulo"))',
                caja: '@Html.Raw(J("Flujo_Pdf_Caja"))',
                cajaTitulo: '@Html.Raw(J("Flujo_CajaCascadaTitulo"))',
                fuTitulo: '@Html.Raw(J("Flujo_FuentesUsosTitulo"))'
            }
        },
        reporteActual: null,
        filtrosConsultados: null,
        insightsTexto: null,
        vistaTabla: 'mensual',      // 'mensual' | 'acum'
        unidad: 'millones',
        etiquetas: { principal: true, cascada: true, caja: true },   // etiquetas de valor, una por gráfico
        charts: {},
        mesesCache: [],
        rango: [],
        ultimoReal: null,           // {anio, mes}: último mes ejecutado del modelo (para el rango por defecto)
        iDesde: 0,
        iHasta: 0,
        hoy: { anio: @DateTime.Now.Year, mes: @DateTime.Now.Month },   // fecha de hoy del SERVIDOR (atajos)
        escenarios: [],
        escenariosConDatos: null
    };
    _fl.mesesCache = _fl.mesesNombres.map(function (nombre, idx) {
        return { mes: idx + 1, nombre: nombre, abrev: nombre.substring(0, 3) };
    });

    var elEmpresa = $('#flEmpresa'), elEscenario = $('#flEscenario');
    var CH_MDASH = String.fromCharCode(0x2014), CH_NDASH = String.fromCharCode(0x2013), CH_MIDDOT = String.fromCharCode(0xB7);

    function cargarPrefs() {
        try {
            var p = JSON.parse(localStorage.getItem('flujo.prefs') || '{}');
            if (p.vistaTabla === 'mensual' || p.vistaTabla === 'acum') _fl.vistaTabla = p.vistaTabla;
            if (['pesos', 'miles', 'millones'].indexOf(p.unidad) >= 0) _fl.unidad = p.unidad;
        } catch (e) { }
    }
    function guardarPrefs() {
        try { localStorage.setItem('flujo.prefs', JSON.stringify({ vistaTabla: _fl.vistaTabla, unidad: _fl.unidad })); } catch (e) { }
    }
    function escHtml(t) { return $('<span>').text(t == null ? '' : String(t)).html(); }

    var s2lang = {
        noResults: function () { return '@Html.Raw(J("Common_Select2NoResults"))'; },
        searching: function () { return '@Html.Raw(J("Common_Select2Searching"))'; }
    };

    function empresaSeleccionada() { var v = elEmpresa.val(); return v ? parseInt(v, 10) : null; }
    function escenarioSeleccionado() { var v = elEscenario.val(); return v ? parseInt(v, 10) : 1; }

    // ===== Unidad (Pesos/Miles/Millones) — mismo patrón que PYG/Línea de Tiempo =====
    function escalarValor(v) {
        if (_fl.unidad === 'miles') return v / 1000;
        if (_fl.unidad === 'millones') return v / 1000000;
        return v;
    }
    // Los gráficos trabajan con valores ya escalados a la unidad elegida: esto los devuelve a pesos para formatear/etiquetar.
    function aPesos(v) { return _fl.unidad === 'miles' ? v * 1000 : (_fl.unidad === 'millones' ? v * 1000000 : v); }
    function sufijoUnidad() {
        if (_fl.unidad === 'miles') return ' ' + _fl.t.unidadSufijoMiles;
        if (_fl.unidad === 'millones') return ' ' + _fl.t.unidadSufijoMillones;
        return '';
    }
    // Millones con 2 decimales (las líneas pequeñas no se pierden como "0,0"); pesos y miles sin decimales.
    function decimalesUnidad() { return _fl.unidad === 'millones' ? 2 : 0; }
    function fmtNumSolo(v) {
        var d = decimalesUnidad(), n = escalarValor(v);
        if (Math.abs(n) < Math.pow(10, -d) / 2) n = 0;   // evita "-0,00" cuando el valor es menor que la precisión mostrada
        try { return new Intl.NumberFormat(_fl.cultura, { minimumFractionDigits: d, maximumFractionDigits: d }).format(n); }
        catch (e) { return String(n); }
    }
    function fmtNum(v) { return fmtNumSolo(v) + sufijoUnidad(); }
    function fmtNumVar(v) {
        var d = decimalesUnidad(), n = escalarValor(v);
        try { return new Intl.NumberFormat(_fl.cultura, { minimumFractionDigits: d, maximumFractionDigits: d, signDisplay: 'exceptZero' }).format(n) + sufijoUnidad(); }
        catch (e) { return (n >= 0 ? '+' : '') + n + sufijoUnidad(); }
    }
    function fmtPct(v) {
        if (v === null || v === undefined) return CH_MDASH;
        try { return new Intl.NumberFormat(_fl.cultura, { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(v * 100) + '%'; }
        catch (e) { return (Math.round(v * 1000) / 10) + '%'; }
    }
    function fmtPctVar(v) {
        if (v === null || v === undefined) return CH_MDASH;
        if (v > 9.99) return '>+999%';          // base casi cero: la variación no es significativa
        if (v < -9.99) return '<-999%';
        try { return new Intl.NumberFormat(_fl.cultura, { minimumFractionDigits: 1, maximumFractionDigits: 1, signDisplay: 'exceptZero' }).format(v * 100) + '%'; }
        catch (e) { var n = Math.round(v * 1000) / 10; return (n >= 0 ? '+' : '') + n + '%'; }
    }
    function fmtPuntos(v) {
        try { return new Intl.NumberFormat(_fl.cultura, { minimumFractionDigits: 1, maximumFractionDigits: 1, signDisplay: 'exceptZero' }).format(v * 100) + ' pp'; }
        catch (e) { var n = Math.round(v * 1000) / 10; return (n >= 0 ? '+' : '') + n + ' pp'; }
    }

    function mostrarError(mensaje) {
        console.error('[InformeFlujo]', mensaje);
        if (typeof Swal !== 'undefined') Swal.fire({ icon: 'error', title: '@Html.Raw(J("Common_Error"))', text: mensaje });
        else alert(mensaje);
    }

    function actualizarBotonConsultar() {
        var listo = (!_fl.esAdmin || !!empresaSeleccionada()) && !!elEscenario.val() && _fl.rango.length > 0;
        $('#btnConsultarFl').prop('disabled', !listo);
    }
    function ocultarResultados() { $('#flResultado, #flSinDatos').hide(); $('#flEstadoInicial').show(); }

    // "Comparar con escenario": todos los escenarios MENOS el principal; los que no tienen datos quedan deshabilitados.
    function actualizarOpcionesEscenarioComparar() {
        var principal = String(elEscenario.val() || ''), conDatos = _fl.escenariosConDatos;
        var $sel = $('#flEscenarioComparar'), actual = String($sel.val() || ''), hayDeshabilitados = false;
        $sel.find('option[value!=""]').remove();
        _fl.escenarios.forEach(function (e) {
            if (String(e.id) === principal) return;
            var tieneDatos = !conDatos || conDatos.indexOf(e.id) >= 0;
            if (!tieneDatos) hayDeshabilitados = true;
            var texto = tieneDatos ? e.nombre : (e.nombre + ' (' + _fl.t.escenarioSinDatosEtiqueta + ')');
            $sel.append($('<option>').val(e.id).text(texto).prop('disabled', !tieneDatos).attr('title', tieneDatos ? '' : _fl.t.escenarioSinDatosTooltip));
        });
        var opcionActual = $sel.find('option[value="' + actual + '"]');
        if (!actual || !opcionActual.length || opcionActual.prop('disabled')) $sel.val('');
        $sel.trigger('change.select2');
        $('#flEscenarioSinDatosHint').toggle(hayDeshabilitados);
    }

    // Rango por defecto: desde enero del año del último mes ejecutado hasta ese mes (lo realmente ejecutado); si no se conoce, "Todo".
    function rangoPorDefecto() {
        var n = _fl.rango.length;
        if (!n) return null;
        var u = _fl.ultimoReal;
        if (u) {
            var iH = -1, iD = -1;
            _fl.rango.forEach(function (m, i) {
                if (m.anio === u.anio && m.mes === u.mes) iH = i;
                if (m.anio === u.anio && iD < 0) iD = i;
            });
            if (iH >= 0 && iD >= 0) return { d: iD, h: iH };
        }
        return { d: 0, h: n - 1 };
    }

    function cargarMeses() {
        _fl.rango = []; _fl.iDesde = 0; _fl.iHasta = 0; _fl.escenariosConDatos = null; _fl.ultimoReal = null;
        $('#flSinMeses').hide();
        ocultarResultados();
        actualizarOpcionesEscenarioComparar();
        pintarRango();
        actualizarBotonConsultar();

        var idEmpresa = empresaSeleccionada();
        if (_fl.esAdmin && !idEmpresa) return;

        $.post(_fl.urls.meses, { idEmpresa: idEmpresa, idEscenario: escenarioSeleccionado(), __RequestVerificationToken: _fl.token }, function (resp) {
            if (!resp || !resp.success) { mostrarError((resp && resp.message) || _fl.t.errorServidor); return; }
            _fl.rango = resp.meses || [];
            _fl.ultimoReal = resp.ultimoReal || null;
            _fl.escenariosConDatos = (resp.escenariosConDatos || []).map(Number);
            actualizarOpcionesEscenarioComparar();
            $('#flSinMeses').toggle(!_fl.rango.length);
            var inicial = rangoPorDefecto();
            if (inicial) { _fl.iDesde = inicial.d; _fl.iHasta = inicial.h; }
            pintarRango();
            actualizarBotonConsultar();
        }).fail(function (xhr) { mostrarError(_fl.t.errorServidor + ' (HTTP ' + xhr.status + ')'); });
    }

    // ===== Slider de rango continuo (mismo control que PYG/Línea de Tiempo) =====
    function pctIndice(i) { var n = _fl.rango.length; return n > 1 ? (i / (n - 1) * 100) : 0; }

    function pintarRango() {
        var meses = _fl.rango, n = meses.length, track = $('#flRangoTrack');
        if (n === 0) {
            track.addClass('disabled');
            $('#flRangoDesdeLbl, #flRangoHastaLbl, #flRangoBadge').text(CH_MDASH);
            $('#flRangoHastaLbl').show(); $('#flRangoDesdeLbl').next('i').show();
            $('#flRangoYears').empty();
            $('#flAtajos button').removeClass('active no-disponible').prop('disabled', true).attr('title', '');
            return;
        }
        track.removeClass('disabled');
        var pD = pctIndice(_fl.iDesde), pH = pctIndice(_fl.iHasta);
        $('#flKnobFrom').css('left', pD + '%').attr({ 'aria-valuemin': 0, 'aria-valuemax': n - 1, 'aria-valuenow': _fl.iDesde, 'aria-valuetext': meses[_fl.iDesde].etiqueta });
        $('#flKnobTo').css('left', pH + '%').attr({ 'aria-valuemin': 0, 'aria-valuemax': n - 1, 'aria-valuenow': _fl.iHasta, 'aria-valuetext': meses[_fl.iHasta].etiqueta });
        $('#flRangoSel').css({ left: pD + '%', width: (pH - pD) + '%' });

        var unMes = _fl.iDesde === _fl.iHasta;
        $('#flRangoDesdeLbl').text(meses[_fl.iDesde].etiqueta);
        $('#flRangoHastaLbl').text(unMes ? '' : meses[_fl.iHasta].etiqueta).toggle(!unMes);
        $('#flRangoDesdeLbl').next('i').toggle(!unMes);
        var total = _fl.iHasta - _fl.iDesde + 1;
        $('#flRangoBadge').text(total + ' ' + (total === 1 ? _fl.t.badgeMes : _fl.t.badgeMeses));

        var anios = [];
        meses.forEach(function (m) { if (anios.indexOf(m.anio) === -1) anios.push(m.anio); });
        $('#flRangoYears').html(anios.map(function (a) { return '<span>' + a + '</span>'; }).join(''));
        RangoAtajos.pintarBotones($('#flAtajos button'), _fl.rango, _fl.hoy, _fl.iDesde, _fl.iHasta,
            _fl.mesesCache.map(function (m) { return m.abrev; }), { tooltipFmt: _fl.t.rangoTooltipFmt, sinDatosFmt: _fl.t.rangoSinDatosFmt });
    }

    function aplicarPresetRango(preset) {
        var p = RangoAtajos.indices(preset, _fl.rango, _fl.hoy);
        if (!p) return;   // atajo sin datos (.no-disponible)
        _fl.iDesde = p.d; _fl.iHasta = p.h;
        pintarRango();
    }
    function indiceDesdeClientX(clientX) {
        var rect = document.getElementById('flRangoTrack').getBoundingClientRect();
        var frac = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
        return Math.round(frac * (_fl.rango.length - 1));
    }
    function moverExtremo(cual, idx) {
        idx = Math.min(_fl.rango.length - 1, Math.max(0, idx));
        if (cual === 'from') { _fl.iDesde = idx; if (_fl.iDesde > _fl.iHasta) _fl.iHasta = _fl.iDesde; }
        else { _fl.iHasta = idx; if (_fl.iHasta < _fl.iDesde) _fl.iDesde = _fl.iHasta; }
        pintarRango();
    }
    function iniciarArrastreSlider(e, cual) {
        if (_fl.rango.length < 2) return;
        e.preventDefault();
        var track = $('#flRangoTrack').addClass('dragging');
        function onMove(ev) { moverExtremo(cual, indiceDesdeClientX(ev.clientX)); }
        function onUp() { track.removeClass('dragging'); window.removeEventListener('pointermove', onMove); window.removeEventListener('pointerup', onUp); }
        window.addEventListener('pointermove', onMove);
        window.addEventListener('pointerup', onUp);
    }
    function clicEnPista(e) {
        if ($(e.target).hasClass('knob') || _fl.rango.length < 2) return;
        var idx = indiceDesdeClientX(e.clientX);
        var cual = Math.abs(idx - _fl.iDesde) <= Math.abs(idx - _fl.iHasta) ? 'from' : 'to';
        moverExtremo(cual, idx);
        iniciarArrastreSlider(e, cual);
    }
    function moverKnobConTeclado(e, cual) {
        var n = _fl.rango.length;
        if (n < 2) return;
        var idx = cual === 'from' ? _fl.iDesde : _fl.iHasta;
        if (e.key === 'ArrowLeft') idx -= 1; else if (e.key === 'ArrowRight') idx += 1;
        else if (e.key === 'Home') idx = 0; else if (e.key === 'End') idx = n - 1; else return;
