            concMalTitulo: '@Html.Raw(J("Flujo_ConcMalTitulo"))',
            concMalFmt: '@Html.Raw(J("Flujo_ConcMalFmt"))',
            concMesesFmt: '@Html.Raw(J("Flujo_ConcMesesFmt"))',
            concProyFmt: '@Html.Raw(J("Flujo_ConcProyFmt"))',
            concEneroHint: '@Html.Raw(J("Flujo_ConcEneroHint"))',
            fuSubFmt: '@Html.Raw(J("Flujo_FuentesUsosSubFmt"))',
            fuFuentes: '@Html.Raw(J("Flujo_Fuentes"))',
