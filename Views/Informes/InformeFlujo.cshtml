        $('#flNotaPpto').text(_fl.t.notaSinPresupuesto).toggle(!r.HayPresupuesto);
        var ultTxt = r.UltimoMesReal ? (nombreMes(r.UltimoMesReal) + ' ' + r.AnioHasta) : CH_MDASH;
        $('#flNotaProyectado').text(_fl.t.notaProyectadoFmt.replace('{0}', ultTxt)).toggle(!!r.HayMesesProyectados);
        $('#flNotaEscenario').text(_fl.t.escenarioSinDatosNota).toggle(!!r.IdEscenarioComparar && !r.HayEscenarioComparar);

        $('#flEstadoInicial, #flSinDatos').hide();
        InformeTema.aplicar(document.getElementById('flResultado'));           // variables CSS + colores de gráficos/PDF
        $.extend(_fl.filtrosConsultados, InformeTema.parametros());      // Excel y correo re-resuelven el tema en el servidor
        $('#flResultado').show();   // visible ANTES de crear los charts: Chart.js mide el contenedor
        repintar();
    }

    // Repinta lo que depende de la unidad / de la vista de la tabla, sin volver a consultar.
    function repintar() {
        var r = _fl.reporteActual;
        if (!r) return;
        $('#flUnidadLbl').text(_fl.t.unidades[_fl.unidad]);
        $('#flMenuUnidad button').each(function () {
