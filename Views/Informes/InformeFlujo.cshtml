@using System.Web
@using System.Web.Script.Serialization
@using bufinscustomers.Models
@{
    // Vista COMPARTIDA por el Informe de flujo de caja (dbo.ModeloFlujoCaja) y el de flujo de efectivo (dbo.ModeloFlujoEfectivo):
    // el controlador fija ViewBag.Tipo ("Caja" | "Efectivo") y ViewBag.Controlador; los textos propios de cada informe salen de las
    // claves FlujoCaja_* / FlujoEfectivo_* y los comunes de Flujo_*.
    var tipo = (string)(ViewBag.Tipo ?? "Caja");
    var ctrl = (string)(ViewBag.Controlador ?? "InformeFlujoCaja");
    var P = "Flujo" + tipo + "_";
    var empresas = ViewBag.Empresas as List<Empresas>;
    var esAdmin = (bool)(ViewBag.EsAdmin ?? false);
    var culturaJs = System.Globalization.CultureInfo.CurrentUICulture.Name;
    // T = texto para HTML (Razor lo codifica); J = texto para JS (escapado). Ambos leen de App_GlobalResources/Strings(.en-US).resx.
    Func<string, string> T = k => (System.Web.HttpContext.GetGlobalResourceObject("Strings", k) as string) ?? k;
    Func<string, string> J = k => HttpUtility.JavaScriptStringEncode(T(k));
    ViewBag.Title = T(P + "PageTitle");

    string[] kpiCodigos = tipo == "Caja"
        ? new[] { "BrutoDespuesImpuestos", "CapitalTrabajo", "FclOperativo", "FlujoNeto", "ConversionCaja" }
        : new[] { "EfectivoOperacion", "FlujoOperacion", "FlujoInversion", "DeudaNeta", "AumentoNeto" };
    string[] cascCodigos = tipo == "Caja"
        ? new[] { "Inicio", "AjustesNoMonetarios", "Impuestos", "CapitalTrabajo", "Inversion", "Financiero", "NoOperacional", "Final" }
        : new[] { "Inicio", "AjustesNoMonetarios", "CapitalTrabajo", "Inversion", "DeudaNeta", "Final" };
    var jss = new JavaScriptSerializer();
    var kpiNombres = kpiCodigos.ToDictionary(c => c, c => T(P + "Kpi_" + c));
    var cascNombres = cascCodigos.ToDictionary(c => c, c => T(P + "Casc_" + c));
    var filaNombres = new Dictionary<string, string> { { "FlujoNeto", T(P + "Fila_FlujoNeto") } };
    // Caja inicial → caja final: etiquetas de las barras y de las fuentes/usos (por actividad; GeneracionOperativa es propia de cada informe).
    var cajaCascNombres = new Dictionary<string, string>
    {
        { "CajaInicial", T("Flujo_CajaCascada_CajaInicial") }, { "CajaFinal", T("Flujo_CajaCascada_CajaFinal") },
        { "CajaFinalProy", T("Flujo_CajaCascada_CajaFinalProy") }, { "SinConciliar", T("Flujo_CajaCascada_SinConciliar") },
        { "Otros", T("Flujo_CajaCascada_Otros") }, { "GeneracionOperativa", T(P + "FU_GeneracionOperativa") }
    };
    foreach (var c in (tipo == "Caja" ? new[] { "CapitalTrabajo", "Inversion", "Financiero", "NoOperacional" } : new[] { "CapitalTrabajo", "Inversion", "DeudaNeta" }))
    {
        cajaCascNombres[c] = T(P + "Casc_" + c);
    }
    string kpiPrimario = tipo == "Caja" ? "FclOperativo" : "FlujoOperacion";
    string kpiNeto = tipo == "Caja" ? "FlujoNeto" : "AumentoNeto";
}

<link href="~/Assets/css/bufins-components.css" rel="stylesheet" />
<link href="~/Assets/css/informe-linea-tiempo.css" rel="stylesheet" />
<link href="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/css/informe-pyg.css")" rel="stylesheet" />
<link href="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/css/informe-tesoreria.css")" rel="stylesheet" />
<link href="~/Assets/css/export-menu.css" rel="stylesheet" />
<link href="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/css/empresa-logo.css")" rel="stylesheet" />
<link href="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/css/tema-informe.css")" rel="stylesheet" />
<link href="~/Assets/css/select2/select2.min.css" rel="stylesheet" />

<div class="container-fluid px-4">
<div class="lt-app">

    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas @(tipo == "Caja" ? "fa-money-bill-wave" : "fa-arrow-right-arrow-left") powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@T(P + "PageTitle")</h1>
            @Html.Partial("_ModeloBufinsTag")
        </div>
    </div>

    @Html.AntiForgeryToken()

    <div class="filter-card">
        <div class="lt-section-title"><span>@T("Common_FiltrosConsulta")</span></div>
        <div class="lt-grid-quever tes-grid-4">
            <div class="lt-field">
                <label class="lt-field-label" for="flEmpresa">@T("Common_LabelEmpresa")</label>
                <select id="flEmpresa" class="lt-field-select">
                    @if (esAdmin) { <option value="">@T("Common_Seleccione")</option> }
                    @if (empresas != null)
                    {
                        foreach (var e in empresas)
                        {
                            <option value="@e.Id">@e.Nombre</option>
                        }
                    }
                </select>
            </div>
            <div class="lt-field">
                <label class="lt-field-label" for="flEscenario">@T("Common_LabelEscenario")</label>
                <select id="flEscenario" class="lt-field-select">
                    @if (ViewBag.Escenarios != null)
                    {
                        foreach (var esc in ViewBag.Escenarios)
                        {
                            <option value="@esc.Id">@esc.Nombre</option>
                        }
                    }
                </select>
            </div>
            <div class="lt-field">
                <label class="lt-field-label" for="flMedida">@T("Flujo_LabelMedida") <i class="fas fa-circle-info tes-info" tabindex="0" title="@T("Flujo_MedidaHint")" aria-label="@T("Flujo_MedidaHint")"></i></label>
                <select id="flMedida" class="lt-field-select">
                    <option value="real">@T("Flujo_Medida_real")</option>
                    <option value="proy">@T("Flujo_Medida_proy")</option>
                </select>
            </div>
            <div class="lt-field">
                <label class="lt-field-label" for="flNivelDetalle">@T("Flujo_NivelDetalle")</label>
                <select id="flNivelDetalle" class="lt-field-select">
                    <option value="todas">@T("Flujo_NivelTodas")</option>
                    <option value="subtotales">@T("Flujo_NivelSubtotales")</option>
                </select>
            </div>
        </div>

        <details class="rpt-adv">
            <summary><span>@T("Flujo_SeccionComparaciones")</span><span class="line"></span></summary>
            <div class="rpt-adv-body">
                <div class="lt-grid-quever">
                    <div class="lt-field">
                        <label class="lt-field-label" for="flEscenarioComparar">@T("Flujo_EscenarioComparar")</label>
                        @* Opciones armadas por JS (actualizarOpcionesEscenarioComparar): todos los escenarios menos el
                           principal; los que no tienen datos para la empresa quedan deshabilitados con tooltip. *@
                        <select id="flEscenarioComparar" class="lt-field-select">
                            <option value="">@T("Flujo_EscenarioCompararNinguno")</option>
                        </select>
                        <p class="lt-seg-hint" id="flEscenarioSinDatosHint" style="display:none;"><i class="fas fa-circle-info mr-1"></i>@T("Flujo_EscenarioSinDatosHint")</p>
                    </div>
                    <div class="lt-field">
                        <p class="lt-seg-hint" style="margin-top:22px"><i class="fas fa-circle-info mr-1"></i>@T("Flujo_ComparacionesNota")</p>
                    </div>
                </div>
            </div>
        </details>

        @* Rango: mismo control que PYG/Balance/Línea de Tiempo (slider continuo + atajos compartidos de rango-atajos.js). *@
        <div class="lt-section-title mt"><span>@T("LineaTiempo_FilaCuando")</span></div>
        <div>
            <div class="rango-atajos" id="flAtajos">
                <div class="rango-atajos-grupo">
                    <button type="button" data-preset="todo">@T("Rango_Todo")</button>
                </div>
                <div class="rango-atajos-grupo">
                    <button type="button" data-preset="ytd">@T("Rango_AnioEnCurso")</button>
                    <button type="button" data-preset="6m">@T("Rango_Ultimos6Meses")</button>
                    <button type="button" data-preset="3m">@T("Rango_UltimoTrimestre")</button>
                    <button type="button" data-preset="mesAnterior">@T("Rango_MesAnterior")</button>
                    <button type="button" data-preset="mesActual">@T("Rango_MesActual")</button>
                </div>
            </div>
            <div class="lt-range-card">
                <div class="lt-range-head">
                    <span class="lbl"><span id="flRangoDesdeLbl">&mdash;</span><i class="fas fa-long-arrow-alt-right"></i><span id="flRangoHastaLbl">&mdash;</span></span>
                    <span class="lt-range-badge" id="flRangoBadge">&mdash;</span>
                </div>
                <div class="lt-range-track disabled" id="flRangoTrack">
                    <div class="bg"></div>
                    <div class="sel" id="flRangoSel"></div>
                    <div class="knob from" id="flKnobFrom" tabindex="0" role="slider" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" aria-label="@T("LineaTiempo_LabelRango")"></div>
                    <div class="knob to" id="flKnobTo" tabindex="0" role="slider" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" aria-label="@T("LineaTiempo_LabelRango")"></div>
                </div>
                <div class="lt-range-years" id="flRangoYears"></div>
            </div>
            <p class="lt-help">@T("Flujo_RangoHint")</p>
            <p class="lt-help" id="flSinMeses" style="display:none;">@T(P + "SinMesesDatos")</p>
        </div>

        @Html.Partial("_TemaInformeSelector", "flTema")

        <div class="btn-group-actions">
            <button type="button" id="btnConsultarFl" class="btn btn-modern-gradient" disabled>
                <i class="fas fa-arrow-right mr-1"></i>@T("LineaTiempo_BtnGenerar")
            </button>
            <button type="button" id="btnLimpiarFl" class="btn btn-modern-secondary">@T("Common_Limpiar")</button>
        </div>
    </div>

    <div id="flEstadoInicial" class="lt-card lt-empty">
        <div class="lt-empty-icon"><i class="fas @(tipo == "Caja" ? "fa-money-bill-wave" : "fa-arrow-right-arrow-left")"></i></div>
        <h4>@T(P + "EstadoInicialTitulo")</h4>
        <p>@T(P + "EstadoInicialDesc")</p>
    </div>

    <div id="flSinDatos" class="lt-card lt-empty" style="display:none;">
        <div class="lt-empty-icon"><i class="fas fa-inbox"></i></div>
        <h4>@T(P + "SinDatosTitulo")</h4>
        <p id="flSinDatosDesc">@T(P + "SinDatosDesc")</p>
    </div>

    <div id="flResultado" style="display:none;">

        @* 1. Encabezado: marca + empresa + chips de contexto + unidad/exportaciones *@
        <div class="lt-card" id="flPanelResultado">
            <div class="pyg2-letterhead">
                <span class="pyg2-brand"><img class="bm-logo" src="~/Assets/img/Bufins_Wordmark_Purple.png" alt="Bufins" height="14"><span class="bm-sub">@T(P + "Subtitulo")</span></span>
                <span class="fecha"><span>@T("Flujo_GeneradoEl")</span> <span id="flFechaGenerado">&mdash;</span></span>
            </div>
            <div class="pyg2-head">
                <div class="pyg2-head-l">
                    <span class="emp-logo-plate" id="flLogo" hidden><img alt="@Resources.Strings.Common_LogoEmpresaAlt"></span>
                    <div class="emp-logo-texto">
                    <h2 id="flTituloEmpresa">&mdash;</h2>
                    <div class="pyg2-chips">
                        <span class="pyg2-chip primary"><i class="fas fa-calendar"></i><span id="flChipPeriodo">&mdash;</span></span>
                        <span class="pyg2-chip" id="flChipEscenario">&mdash;</span>
                        <span class="pyg2-chip" id="flChipMedida">&mdash;</span>
                        <span class="pyg2-chip" id="flChipComparado">&mdash;</span>
                    </div>
                    </div>
                </div>
                <div class="pyg2-tools">
                    <button type="button" class="lt-tool-btn" id="flBtnUnidad" aria-haspopup="menu" aria-expanded="false">
                        <span class="lbl-muted">@T("Flujo_Unidad")</span><span id="flUnidadLbl">@T("LineaTiempo_UnidadMillones")</span><i class="fas fa-chevron-down chev"></i>
                    </button>
                    <div class="lt-menu" id="flMenuUnidad" role="menu">
                        <button type="button" data-unidad="pesos" role="menuitemradio">@T("LineaTiempo_UnidadPesos")<i class="fas fa-check"></i></button>
                        <button type="button" data-unidad="miles" role="menuitemradio">@T("LineaTiempo_UnidadMiles")<i class="fas fa-check"></i></button>
                        <button type="button" data-unidad="millones" role="menuitemradio">@T("LineaTiempo_UnidadMillones")<i class="fas fa-check"></i></button>
                    </div>
                    <span class="sep"></span>
                    @Html.Partial("_ExportMenu", new bufinscustomers.Models.ExportMenuVM
                    {
                        Id = "flExp",
                        ExcelDesc = T(P + "Exp_ExcelDesc")
                    })
                </div>
            </div>
        </div>
        <form id="frmExportarExcelFl" method="post" action="@Url.Action("ExportarExcel", ctrl)">
            @Html.AntiForgeryToken()
            <div id="flExpCampos"></div>@* los llena el botón Excel con los filtros del reporte consultado *@
        </form>

        @* 2. Estado + KPIs *@
        <div class="tes-estado" id="flEstado">
            <span class="ic"><i class="fas fa-circle-check"></i></span>
            <div class="tx"><span class="t" id="flEstadoTitulo">&mdash;</span><span class="s" id="flEstadoDesc">&mdash;</span></div>
        </div>

        <div class="pyg2-section">
            <div class="pyg2-section-title">
                <span class="t">@T("Flujo_IndicadoresClave")</span><span class="line"></span>
            </div>
            <div class="tes-kpis" id="flKpiStrip"></div>
        </div>

        @* 3. Flujo mensual (barras + acumulado) + Lo más relevante *@
        <div class="pyg2-analysis">
            <div class="pyg2-card">
                <div class="pyg2-card-head">
                    <div>
                        <div class="pyg2-card-title">@T("Flujo_GraficoTitulo")</div>
                        <div class="pyg2-card-sub" id="flGraficoSub">&mdash;</div>
                    </div>
                    <span class="pyg2-legend">
                        <span><i class="sq" style="background:#16A34A"></i>@T("Flujo_LeyendaPositivo")</span>
                        <span><i class="sq" style="background:#F87171"></i>@T("Flujo_LeyendaNegativo")</span>
                        <span><i class="sw" style="background:var(--tm-p,#6366F1)"></i>@T("Flujo_NetoAcumulado")</span>
                        <span id="flLeyendaPpto"><i class="dash"></i>@T("Flujo_LeyendaPptoAcum")</span>
                        <span id="flLeyendaEsc" style="display:none;"><i class="sw" style="background:var(--tm-c,#0EA5E9)"></i><span id="flLeyendaEscNombre"></span></span>
                    </span>
                    <button type="button" class="lt-tool-btn square on tes-btn-etq" data-chart="principal" title="@T("LineaTiempo_Etiquetas")" aria-label="@T("LineaTiempo_Etiquetas")"><i class="fas fa-tag"></i></button>
                </div>
                <div class="tes-chart-lg"><canvas id="flChartPrincipal"></canvas></div>
            </div>
            <div class="pyg2-card" style="gap:12px">
                <div>
                    <div class="pyg2-card-title"><i class="fas fa-bolt"></i>@T("Flujo_RelevanteTitulo")</div>
                    <div class="pyg2-card-sub" id="flRelevanteSub">&mdash;</div>
                </div>
                <div class="pyg2-hl-list" id="flHighlightsList"></div>
            </div>
        </div>

        @* 3b. Caja: con cuánta se arrancó y con cuánta se terminó (validada contra el balance) + fuentes y usos *@
        <div class="pyg2-section">
            <div class="pyg2-section-title">
                <span class="t">@T("Flujo_CajaSeccion")</span><span class="line"></span>
            </div>
        </div>
        <div class="tes-estado" id="flConc" style="display:none;">
            <span class="ic"><i class="fas fa-scale-balanced"></i></span>
            <div class="tx"><span class="t" id="flConcTitulo">&mdash;</span><span class="s" id="flConcDesc">&mdash;</span><span class="fu-conc-meses" id="flConcMeses" style="display:none;"></span></div>
        </div>
        <div class="pyg2-analysis">
            <div class="pyg2-card">
                <div class="pyg2-card-head">
                    <div>
                        <div class="pyg2-card-title">@T("Flujo_CajaCascadaTitulo")</div>
                        <div class="pyg2-card-sub" id="flCajaSub">&mdash;</div>
                    </div>
                    <span class="pyg2-legend">
                        <span><i class="sq" style="background:var(--tm-p,#6366F1)"></i>@T("Flujo_LeyendaTotal")</span>
                        <span><i class="sq" style="background:#16A34A"></i>@T("Flujo_Fuentes")</span>
                        <span><i class="sq" style="background:#F87171"></i>@T("Flujo_Usos")</span>
                        <span id="flLeyendaSinConc" style="display:none;"><i class="sq" style="background:#D97706"></i>@T("Flujo_LeyendaSinConciliar")</span>
                    </span>
                    <button type="button" class="lt-tool-btn square on tes-btn-etq" data-chart="caja" title="@T("LineaTiempo_Etiquetas")" aria-label="@T("LineaTiempo_Etiquetas")"><i class="fas fa-tag"></i></button>
                </div>
                <div class="tes-chart-md" id="flCajaWrap"><canvas id="flChartCaja"></canvas></div>
                <div class="fu-sin-inicio" id="flCajaSinInicio" style="display:none;"></div>
            </div>
            <div class="pyg2-card fu-card">
                <div>
                    <div class="pyg2-card-title"><i class="fas fa-right-left"></i>@T("Flujo_FuentesUsosTitulo")</div>
                    <div class="pyg2-card-sub" id="flFuentesUsosSub">&mdash;</div>
                </div>
                <div id="flFuentesUsos"></div>
            </div>
        </div>

        @* 4. Puente *@
        <div class="pyg2-card" style="margin-bottom:16px">
            <div class="pyg2-card-head">
                <div>
                    <div class="pyg2-card-title">@T(P + "CascadaTitulo")</div>
                    <div class="pyg2-card-sub" id="flCascadaSub">&mdash;</div>
                </div>
                <span class="pyg2-legend">
                    <span><i class="sq" style="background:var(--tm-p,#6366F1)"></i>@T("Flujo_LeyendaTotal")</span>
                    <span><i class="sq" style="background:#F87171"></i>@T("Flujo_LeyendaResta")</span>
                    <span><i class="sq" style="background:#16A34A"></i>@T("Flujo_LeyendaSuma")</span>
                </span>
                <button type="button" class="lt-tool-btn square on tes-btn-etq" data-chart="cascada" title="@T("LineaTiempo_Etiquetas")" aria-label="@T("LineaTiempo_Etiquetas")"><i class="fas fa-tag"></i></button>
            </div>
            <div class="tes-chart-md"><canvas id="flChartCascada"></canvas></div>
        </div>

        @* 5. Tabla por mes *@
        <div class="pyg2-table-card">
            <div class="pyg2-card-head" style="align-items:center">
                <div>
                    <div class="pyg2-card-title">@T(P + "TablaTitulo")</div>
                    <div class="pyg2-card-sub" id="flInfoBadge">&mdash;</div>
                </div>
                <div class="pyg2-table-tools">
                    <div class="pyg2-seg soft" id="flSegTabla">
                        <button type="button" data-v="mensual" class="active">@T("Flujo_VistaMensual")</button>
                        <button type="button" data-v="acum">@T("Flujo_VistaAcumulada")</button>
                    </div>
                </div>
            </div>
            <div class="pyg2-table-wrap">
                <table class="pyg2-table tes-table" id="flTabla"><thead id="flTablaHead"></thead><tbody id="flTablaBody"></tbody></table>
            </div>
            <div class="pyg2-table-legend">
                <span><i class="dot" style="background:#16A34A"></i>@T("Flujo_Favorable")</span>
                <span><i class="dot" style="background:#DC2626"></i>@T("Flujo_Desfavorable")</span>
                <span><i class="fas fa-circle-exclamation"></i>@T("Flujo_LeyendaCritico")</span>
            </div>
        </div>
        <p class="lt-help" id="flNotaPpto" style="display:none;"></p>
        <p class="lt-help" id="flNotaProyectado" style="display:none;"></p>
        <p class="lt-help" id="flNotaEscenario" style="display:none;"></p>

        @* Insights gerenciales (IA): se ocultan si la empresa tiene la IA apagada *@
        @if (bufinscustomers.Helpers.IAModuloHelper.Visible())
        {
        <div class="pyg-insights-card">
            <div class="pyg-insights-head">
                <div>
                    <span class="pyg-insights-title"><i class="fas fa-wand-magic-sparkles"></i>@T("Flujo_InsightsTitulo")</span>
                    <div class="pyg-insights-meta" id="flInsightsMeta">@T("Flujo_InsightsSub")</div>
                </div>
                <button type="button" id="btnGenerarInsightsFl" class="pyg2-ins-btn"><i class="fas fa-wand-magic-sparkles"></i><span>@T("Flujo_Generar")</span></button>
            </div>
            <div id="flInsightsBody"></div>
            <div id="flInsightsLoading" style="display:none;text-align:center;padding:14px 0;">
                @Html.Partial("_LoaderDots", "dark")
                <p style="margin-top:8px;font-size:12.5px;color:#8B85A0;">@T("Flujo_Analizando")</p>
            </div>

            <div class="mt-3">
                <label for="flPregunta" class="mb-1" style="font-weight:700;"><i class="fas fa-comments mr-1"></i>@T("IAInforme_Titulo")</label>
                <div class="d-flex" style="gap:8px;flex-wrap:wrap;">
                    <input type="text" id="flPregunta" class="form-control" maxlength="@bufinscustomers.Helpers.IAModuloHelper.MaxCharsPregunta()" style="flex:1;min-width:240px;"
                           placeholder="@T("IAInforme_Placeholder")" />
                    <button type="button" id="btnFlPreguntar" class="pyg2-ins-btn"><i class="fas fa-paper-plane"></i><span>@T("IAInforme_Btn")</span></button>
                </div>
                <div id="flRespuesta" class="mt-2"></div>
            </div>
        </div>
        }
    </div>

</div>
</div>

<div id="overlayConsultandoFl" class="overlay-cargando" style="display:none;">
    <div class="overlay-cargando-card">
        @Html.Partial("_LoaderDots", "aqua")
        <h5 class="overlay-cargando-title">@T("Flujo_JS_Consultando")</h5>
    </div>
</div>

@Html.Partial("_ExportCorreoModal", new bufinscustomers.Models.ExportCorreoVM())

@section scripts {
<script src="~/Assets/js/select2/select2.min.js"></script>
<script src="~/Assets/js/chart.umd.min.js"></script>
<script src="~/Assets/js/jspdf.umd.min.js"></script>
<script src="~/Assets/js/bufins-pdf-marca.js"></script>
<script src="~/Assets/js/html2canvas.min.js"></script>
<script src="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/js/empresa-logo.js")"></script>
<script src="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/js/informe-tema.js")"></script>
