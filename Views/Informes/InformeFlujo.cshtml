        $('.tes-btn-etq').each(function () { $(this).toggleClass('on', !!_fl.etiquetas[$(this).data('chart')]); });

        pintarEstado(r);
        pintarKpis(r);
        pintarCharts(r);
        pintarConciliacion(r);
        pintarFuentesUsos(r);
        pintarDestacados(r);
        pintarTabla(r);
