            cajaSubFmt: '@Html.Raw(J("Flujo_CajaCascadaSubFmt"))',
            cajaSinInicioTitulo: '@Html.Raw(J("Flujo_CajaSinInicioTitulo"))',
            cajaSinInicioFmt: '@Html.Raw(J("Flujo_CajaSinInicioFmt"))',
            cajaSinFinalTitulo: '@Html.Raw(J("Flujo_CajaSinFinalTitulo"))',
