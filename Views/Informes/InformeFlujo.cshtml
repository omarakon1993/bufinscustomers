        InformeTema.preparar().then(function (ok) { if (ok) consultarReporteConTema(filtros); });
    }

    function consultarReporteConTema(filtros) {
        $('#overlayConsultandoFl').css('display', 'flex');
        $.post(_fl.urls.reporte, $.extend({ __RequestVerificationToken: _fl.token }, filtros), function (resp) {
            $('#overlayConsultandoFl').hide();
            if (!resp || !resp.success) { mostrarError((resp && resp.message) || _fl.t.errorServidor); return; }
            var reporte = resp.reporte;
            if (!reporte || reporte.SinDatos) { $('#flEstadoInicial, #flResultado').hide(); $('#flSinDatos').show(); return; }
            pintarReporte(reporte, filtros);
        }).fail(function (xhr) { $('#overlayConsultandoFl').hide(); mostrarError(_fl.t.errorServidor + ' (HTTP ' + xhr.status + ')'); });
    }

    function pintarReporte(r, filtros) {
        _fl.reporteActual = r;
