    // Imagen nítida de una gráfica: se re-renderiza temporalmente a 3x (y a la proporción exacta de su caja en el PDF) y se
    // exporta como JPEG sobre blanco (jsPDF incrusta los PNG sin comprimir). Al final se restaura el tamaño de pantalla.
    function capturarChartPdf(chart, anchoPx, altoPx) {
        if (!chart) return null;
        var dprOriginal = chart.options.devicePixelRatio;
        chart.options.devicePixelRatio = 3;
        if (anchoPx && altoPx) chart.resize(anchoPx, altoPx); else chart.resize();
        chart.update('none');
        var lienzo = document.createElement('canvas');
        lienzo.width = chart.canvas.width; lienzo.height = chart.canvas.height;
        var ctx = lienzo.getContext('2d');
        ctx.fillStyle = '#FFFFFF'; ctx.fillRect(0, 0, lienzo.width, lienzo.height);
        ctx.drawImage(chart.canvas, 0, 0);
        var img = { data: lienzo.toDataURL('image/jpeg', 0.9), w: chart.width, h: chart.height };
        chart.options.devicePixelRatio = dprOriginal;
        chart.resize();
        chart.update('none');
        return img;
    }

    var PDF_COL = {
        marca: [99, 102, 241], morado: [88, 58, 255], texto: [22, 18, 31], texto2: [91, 85, 112], muted: [139, 133, 160],
        linea: [228, 225, 240], lineaSuave: [238, 240, 246], suave: [244, 243, 251], suave2: [248, 247, 253], zebra: [252, 252, 254],
        totalBg: [238, 242, 255], totalTx: [59, 47, 191], bueno: [22, 163, 74], buenoBg: [236, 253, 243],
        malo: [220, 38, 38], maloBg: [254, 242, 242], ambar: [217, 119, 6], blanco: [255, 255, 255]
    };
    var PDF_DEGRADADO = [[99, 102, 241], [59, 130, 246], [6, 182, 212], [1, 225, 215]];

    // PDF gerencial (A4 horizontal, jsPDF puro): pág. 1 resumen (estado, KPIs, insights, lo más relevante); pág. 2 gráficos
    // (caja mensual + puente); pág. 3+ tabla por mes. Devuelve el documento (con __nombre) para descarga y para el correo.
    function construirPdf(r) {
        var T = _tes.t, P = T.pdf, C = PDF_COL;
        var pdf = new window.jspdf.jsPDF('l', 'mm', 'a4');
        var W = pdf.internal.pageSize.getWidth(), H = pdf.internal.pageSize.getHeight();
        var M = 12, ANCHO = W - M * 2, LIMITE_Y = H - 15;
        var empresa = $('#tesTituloEmpresa').text() || '', periodo = etiquetaPeriodo(r), y = 0;

        function rgb(fn, c) { pdf[fn](c[0], c[1], c[2]); }
        function fuente(estilo, tam, c) { pdf.setFont('helvetica', estilo); pdf.setFontSize(tam); rgb('setTextColor', c || C.texto); }
        function limpiar(t) { return String(t == null ? '' : t).replace(/\*\*|__/g, '').replace(/\s+/g, ' ').trim(); }
        function ancho(t) { return pdf.getTextWidth(String(t)); }
        function degradado(x, yy, w, h) {
            var pasos = 90, n = PDF_DEGRADADO.length - 1;
            for (var i = 0; i < pasos; i++) {
                var tt = i / (pasos - 1), seg = Math.min(n - 1, Math.floor(tt * n)), f = tt * n - seg, a = PDF_DEGRADADO[seg], b = PDF_DEGRADADO[seg + 1];
                pdf.setFillColor(Math.round(a[0] + (b[0] - a[0]) * f), Math.round(a[1] + (b[1] - a[1]) * f), Math.round(a[2] + (b[2] - a[2]) * f));
                pdf.rect(x + (w * i) / pasos, yy, w / pasos + 0.15, h, 'F');
            }
        }
        function pildora(texto, x, yy, fg, bg, negrita, tam, alinearDerecha) {
            fuente(negrita ? 'bold' : 'normal', tam || 7.5, fg);
            var w = ancho(texto) + 5, h = (tam || 7.5) * 0.62 + 1, x0 = alinearDerecha ? x - w : x;
            rgb('setFillColor', bg);
            pdf.roundedRect(x0, yy - h + 1.4, w, h, h / 2, h / 2, 'F');
            pdf.text(texto, x0 + 2.5, yy);
            return w;
        }
        function tituloSeccion(texto, yy, derecha) {
            var tt = String(texto).toUpperCase(), wDer = 0;
            if (derecha) { fuente('normal', 7.5, C.muted); wDer = ancho(derecha) + 4; pdf.text(derecha, W - M, yy, { align: 'right' }); }
            fuente('bold', 8.5, C.morado);
            pdf.text(tt, M, yy);
            rgb('setDrawColor', C.linea); pdf.setLineWidth(0.3);
            pdf.line(M + ancho(tt) + 3, yy - 1.1, W - M - wDer, yy - 1.1);
        }
        function tarjeta(x, yy, w, h) {
            rgb('setDrawColor', C.linea); rgb('setFillColor', C.blanco); pdf.setLineWidth(0.3);
            pdf.roundedRect(x, yy, w, h, 2.5, 2.5, 'FD');
        }
        function imagenAjustada(img, x, yy, wMax, hMax) {
            if (!img) return;
            var ratio = img.w / img.h, w = wMax, h = w / ratio;
            if (h > hMax) { h = hMax; w = h * ratio; }
            pdf.addImage(img.data, 'JPEG', x + (wMax - w) / 2, yy, w, h);
        }
        function encabezadoPagina(seccion) {
            degradado(0, 0, W, 2.4);
            fuente('bold', 10, C.texto); pdf.text(empresa, M, 11);
            fuente('normal', 8, C.muted); pdf.text(P.titulo + '  ' + CH_MIDDOT + '  ' + periodo, W - M, 11, { align: 'right' });
            if (seccion) { fuente('bold', 13, C.texto); pdf.text(seccion, M, 21); }
            y = seccion ? 29 : 18;
        }
        function nuevaPagina(seccion) { pdf.addPage(); encabezadoPagina(seccion); }

        // ===== Página 1: resumen ejecutivo =====
        degradado(0, 0, W, 34);
        fuente('bold', 10, C.blanco); var wMarca = window.BufinsPdfMarca ? BufinsPdfMarca(pdf, M, 10) : 0;
        if (!wMarca) { pdf.text(P.marca, M, 10); wMarca = ancho(P.marca); }
        fuente('normal', 8.5, C.blanco); pdf.text(CH_MIDDOT + '  ' + P.subtitulo, M + wMarca + 2.5, 10);
        fuente('bold', 19, C.blanco); pdf.text(empresa, M, 22);
        fuente('normal', 9.5, C.blanco); pdf.text(P.titulo, M, 29);
        fuente('normal', 8, C.blanco); pdf.text(P.generadoEl + ' ' + ($('#tesFechaGenerado').text() || ''), W - M, 10, { align: 'right' });
        fuente('bold', 8, C.blanco); pdf.text(P.confidencial.toUpperCase(), W - M, 29, { align: 'right' });

        y = 43;
        var chips = [{ t: $('#tesChipPeriodo').text(), fg: C.morado, bg: C.totalBg, b: true }, { t: $('#tesChipEscenario').text() },
            { t: $('#tesChipMedida').text() }, { t: $('#tesChipComparado').text() }, { t: T.unidadBadge[_tes.unidad] }];
        var xc = M;
        chips.forEach(function (c) {
            if (!c.t) return;
            fuente(c.b ? 'bold' : 'normal', 7.5, C.texto2);
            if (xc + ancho(c.t) + 5 > W - M) { xc = M; y += 7; }
            xc += pildora(c.t, xc, y, c.fg || C.texto2, c.bg || C.suave, !!c.b) + 3;
        });

        // Estado de la caja
        var est = datosEstado(r);
        if (est) {
            y += 8;
            var col = est.cls === 'mal' ? C.malo : (est.cls === 'aviso' ? C.ambar : C.bueno), bg = est.cls === 'mal' ? C.maloBg : (est.cls === 'aviso' ? [255, 251, 235] : C.buenoBg);
            fuente('normal', 8.5, C.texto2);
            var lineasE = pdf.splitTextToSize(limpiar(est.desc), ANCHO - 12), hE = 11 + lineasE.length * 4;
            rgb('setFillColor', bg); rgb('setDrawColor', col); pdf.setLineWidth(0.3);
            pdf.roundedRect(M, y, ANCHO, hE, 2.5, 2.5, 'FD');
            rgb('setFillColor', col); pdf.rect(M, y + 3, 1.4, hE - 6, 'F');
            fuente('bold', 10, C.texto); pdf.text(est.titulo, M + 6, y + 6.5);
            fuente('normal', 8.5, C.texto2); pdf.text(lineasE, M + 6, y + 11.2, { lineHeightFactor: 1.35 });
            y += hE;
        }

        // KPIs
        y += 10;
        tituloSeccion(P.indicadores, y);
        y += 4;
        var kpis = datosKpis(r), nK = kpis.length || 1, gapK = 4, wK = (ANCHO - gapK * (nK - 1)) / nK;
        var maxRefs = Math.max.apply(null, kpis.map(function (k) { return k.refs.length; }).concat([0]));
        var hK = 27 + maxRefs * 5.6;
        kpis.forEach(function (k, i) {
            var x = M + i * (wK + gapK);
            tarjeta(x, y, wK, hK);
            degradado(x + 3, y, wK - 6, 1);
            fuente('bold', 6.8, C.texto2);
            pdf.text(pdf.splitTextToSize(k.nombre.toUpperCase(), wK - 8)[0], x + 4, y + 8);
            fuente('bold', 14.5, k.sano ? C.bueno : C.malo);
            pdf.text(k.valorTxt, x + 4, y + 17);
            fuente('normal', 7, C.muted);
            pdf.text(k.nota || ' ', x + 4, y + 22);
            var yd = y + 27.5;
            k.refs.forEach(function (rf) {
                fuente('normal', 6.6, C.muted);
                pdf.text(pdf.splitTextToSize(rf.ref, wK - 8)[0], x + 4, yd);
                fuente('bold', 7.2, C.texto2);
                pdf.text(rf.val, x + 4, yd + 3.7);
                yd += 7.6;
            });
        });
        y += hK + 3 + maxRefs * 2.2 + 8;

        // Insights (IA)
        tituloSeccion(P.insightsTitulo, y, _tes.insightsTexto ? $('#tesInsightsMeta').text() : '');
        y += 4;
        var secciones = _tes.insightsTexto ? separarInsights(_tes.insightsTexto) : null;
        if (secciones) {
            var tiles = [
                { titulo: T.posicion, texto: secciones.posicion, c: C.morado, bg: C.totalBg },
                { titulo: T.financiacion, texto: secciones.financiacion, c: C.malo, bg: C.maloBg },
                { titulo: T.accion, texto: secciones.accion, c: C.bueno, bg: C.buenoBg }
            ];
            var gapT = 5, wT = (ANCHO - gapT * 2) / 3;
            fuente('normal', 8.8, C.texto2);
            var lineasT = tiles.map(function (x) { return pdf.splitTextToSize(limpiar(x.texto), wT - 9); });
            var hT = 14 + Math.max.apply(null, lineasT.map(function (l) { return l.length; })) * 4.2 + 3;
            if (y + hT > LIMITE_Y) nuevaPagina(P.resumen);
            tiles.forEach(function (x, i) {
                var xx = M + i * (wT + gapT);
                tarjeta(xx, y, wT, hT);
                rgb('setFillColor', x.c); pdf.rect(xx + 2.5, y, wT - 5, 1.1, 'F');
                fuente('bold', 7.5, x.c); pdf.text(x.titulo.toUpperCase(), xx + 4.5, y + 8.3);
                fuente('normal', 8.8, C.texto2); pdf.text(lineasT[i], xx + 4.5, y + 14.5, { lineHeightFactor: 1.35 });
            });
            y += hT;
        } else if (_tes.insightsTexto) {
            fuente('normal', 8.8, C.texto2);
            var lineas = pdf.splitTextToSize(limpiar(_tes.insightsTexto.replace(/^[\s#>*\-•]+/gm, '')), ANCHO - 10), hTx = lineas.length * 4.2 + 8;
            if (y + hTx > LIMITE_Y) nuevaPagina(P.resumen);
            tarjeta(M, y, ANCHO, hTx);
            pdf.text(lineas, M + 5, y + 7, { lineHeightFactor: 1.35 });
            y += hTx;
        } else {
            rgb('setFillColor', C.suave2); rgb('setDrawColor', C.linea); pdf.setLineDashPattern([1.2, 1], 0);
            pdf.roundedRect(M, y, ANCHO, 12, 2, 2, 'FD'); pdf.setLineDashPattern([], 0);
            fuente('italic', 8.5, C.texto2); pdf.text(pdf.splitTextToSize(P.sinInsights, ANCHO - 10), M + 5, y + 7.5);
            y += 12;
        }

        // Lo más relevante
        var top = datosDestacados(r);
        if (top.length) {
            var hRel = 24;
            if (y + 15 + hRel > LIMITE_Y) nuevaPagina(P.resumen); else y += 10;
            tituloSeccion(P.relevanteTitulo, y, $('#tesRelevanteSub').text());
            y += 4;
            var gapR = 5, wR = (ANCHO - gapR * 3) / 4;
            top.forEach(function (f, i) {
                var v = r.HayComparativo ? f.VariacionAbsoluta : f.Total;
                var fav = r.HayComparativo ? esFavorable(f.EsGastoOCosto, v) : !f.EsGastoOCosto, colr = fav ? C.bueno : C.malo;
                var x = M + i * (wR + gapR);
                tarjeta(x, y, wR, hRel);
                rgb('setFillColor', colr); pdf.rect(x, y + 4, 1.1, hRel - 8, 'F');
                fuente('bold', 8.5, C.texto); pdf.text(pdf.splitTextToSize(f.Descripcion, wR - 10)[0], x + 5, y + 7.5);
                fuente('bold', 13, colr); pdf.text(r.HayComparativo ? fmtNumVar(v) : fmtNum(v), x + 5, y + 15);
                fuente('bold', 7, colr);
                pdf.text(r.HayComparativo ? ((fav ? T.favorable : T.desfavorableCorto) + ' ' + CH_MIDDOT + ' ' + fmtPctVar(f.VariacionPorcentual)) : T.mayorPeso, x + 5, y + 20.5);
            });
            y += hRel;
        }

        // ===== Página 2: gráficos (caja mensual + puente) =====
        nuevaPagina(P.analisis);
        var hA = 80, MM_A_PX = 4;
        [{ chart: 'principal', titulo: $('#tesChartPrincipal').closest('.pyg2-card').find('.pyg2-card-title').first().text(), sub: $('#tesGraficoSub').text() },
         { chart: 'cascada', titulo: $('#tesChartCascada').closest('.pyg2-card').find('.pyg2-card-title').first().text(), sub: $('#tesCascadaSub').text() }].forEach(function (g, i) {
            tarjeta(M, y, ANCHO, hA);
            fuente('bold', 10, C.texto); pdf.text(g.titulo, M + 5, y + 8);
            fuente('normal', 7.5, C.muted); pdf.text(g.sub, M + 5, y + 12.5);
            var wImg = ANCHO - 10, hImg = hA - 18;
            imagenAjustada(capturarChartPdf(_tes.charts[g.chart], wImg * MM_A_PX, hImg * MM_A_PX), M + 5, y + 15, wImg, hImg);
            y += hA + 8;
        });

        // ===== Página 3+: tabla por mes =====
        nuevaPagina(P.tablaTitulo);
        fuente('normal', 7.5, C.muted); pdf.text(T.unidadBadge[_tes.unidad], W - M, 21, { align: 'right' });
        var cols = encabezadosTabla(r), nMes = r.MesesRango.length, nCols = cols.length;
        var wLbl = nCols > 16 ? 44 : 56, wCol = (ANCHO - wLbl) / nCols, tam = nCols > 16 ? 6.2 : (nCols > 12 ? 6.8 : 7.6), hF = 6.2, hG = 7.5;

        function cabeceraTabla() {
            rgb('setFillColor', C.marca); pdf.rect(M, y, ANCHO, hG, 'F');
            fuente('bold', 7.2, C.blanco); pdf.text(T.colLinea.toUpperCase(), M + 3, y + 5);
            cols.forEach(function (c, i) {
                var xr = M + wLbl + (i + 1) * wCol - 1.5;
                fuente('bold', tam - 0.6, C.blanco);
                pdf.text(pdf.splitTextToSize(c.toUpperCase(), wCol - 1.5)[0], xr, y + 5, { align: 'right' });
            });
            y += hG;
        }
        var filas = filasVisibles(r);
        cabeceraTabla();
        filas.forEach(function (f, idx) {
            if (y + hF > LIMITE_Y - 6) { nuevaPagina(P.tablaTitulo); cabeceraTabla(); }
            rgb('setFillColor', f.EsSubtotal ? C.suave2 : (idx % 2 ? C.zebra : C.blanco));
            pdf.rect(M, y, ANCHO, hF, 'F');
            if (f.EsSubtotal) { rgb('setDrawColor', C.linea); pdf.setLineWidth(0.3); pdf.line(M, y, M + ANCHO, y); }
            fuente(f.EsSubtotal ? 'bold' : 'normal', tam + 0.2, f.EsSubtotal ? C.texto : C.texto2);
            pdf.text(pdf.splitTextToSize(f.Descripcion, wLbl - 5)[0], M + (f.EsSubtotal ? 3 : 5), y + 4.2);

            var vals = valoresVista(f, f.Valores).slice();
            vals.push(_tes.vistaTabla === 'acum' && !f.EsSaldo ? vals[vals.length - 1] : f.Total);
            var celdas = vals.map(function (v) { return { t: fmtNumSolo(v), col: v < 0 ? C.malo : (f.EsSubtotal ? C.texto : C.texto2) }; });
            if (r.HayComparativo) {
                var cl = claseVariacion(f.EsGastoOCosto, f.VariacionAbsoluta), cc = cl === 'good' ? C.bueno : (cl === 'bad' ? C.malo : C.muted);
                var vp = f.VariacionPorcentual, cp = claseVariacion(f.EsGastoOCosto, vp);
                celdas.push({ t: fmtNumSolo(f.TotalComp), col: C.muted }, { t: fmtNumVar(f.VariacionAbsoluta), col: cc, b: true },
                    { t: fmtPctVar(vp), col: cp === 'good' ? C.bueno : (cp === 'bad' ? C.malo : C.muted), b: true });
            }
            if (r.HayEscenarioComparar) {
                var ce = claseVariacion(f.EsGastoOCosto, f.VariacionEscenarioPorcentual);
                celdas.push({ t: fmtPctVar(f.VariacionEscenarioPorcentual), col: ce === 'good' ? C.bueno : (ce === 'bad' ? C.malo : C.muted), b: true });
            }
            celdas.forEach(function (c, i) {
                fuente(c.b || f.EsSubtotal ? 'bold' : 'normal', tam, c.col);
                pdf.text(c.t, M + wLbl + (i + 1) * wCol - 1.5, y + 4.2, { align: 'right' });
            });
            rgb('setDrawColor', C.lineaSuave); pdf.setLineWidth(0.15);
            pdf.line(M, y + hF, M + ANCHO, y + hF);
            y += hF;
        });

        // Pie de página en todas las páginas
        var totalPags = pdf.internal.getNumberOfPages();
        for (var p = 1; p <= totalPags; p++) {
            pdf.setPage(p);
            rgb('setDrawColor', C.linea); pdf.setLineWidth(0.3); pdf.line(M, H - 10, W - M, H - 10);
            fuente('normal', 7, C.muted);
            pdf.text(P.footer + '  ' + CH_MIDDOT + '  ' + empresa + '  ' + CH_MIDDOT + '  ' + periodo, M, H - 6);
            pdf.text(P.confidencial, W / 2, H - 6, { align: 'center' });
            fuente('bold', 7, C.texto2);
            pdf.text(P.paginaFmt.replace('{0}', p).replace('{1}', totalPags), W - M, H - 6, { align: 'right' });
        }

        pdf.__nombre = 'TesoreriaPpto_' + empresa.replace(/[^a-z0-9]+/gi, '_') + '_' +
            r.AnioDesde + ('0' + r.MesDesde).slice(-2) + '-' + r.AnioHasta + ('0' + r.MesHasta).slice(-2) + '.pdf';
        return pdf;
    }

    $(document).ready(function () {
        _tes.escenarios = $('#tesEscenario option').map(function () { return { id: Number(this.value), nombre: $(this).text() }; }).get().filter(function (e) { return e.id > 0; });

        $('#tesEmpresa, #tesEscenario, #tesMedida, #tesNivelDetalle, #tesComparar, #tesEscenarioComparar')
            .select2({ width: '100%', language: s2lang, dropdownAutoWidth: false, minimumResultsForSearch: 10 });

        $('#tesEmpresa, #tesEscenario').on('change', cargarMeses);
        // "Detalle de la tabla" no requiere volver a consultar: solo filtra las filas ya cargadas.
        $('#tesNivelDetalle').on('change', function () { if (_tes.reporteActual) pintarTabla(_tes.reporteActual); });

        $('#tesAtajos button').on('click', function () { aplicarPresetRango($(this).data('preset')); });
        $('#tesKnobFrom').on('pointerdown', function (e) { e.stopPropagation(); iniciarArrastreSlider(e, 'from'); });
        $('#tesKnobTo').on('pointerdown', function (e) { e.stopPropagation(); iniciarArrastreSlider(e, 'to'); });
        $('#tesRangoTrack').on('pointerdown', function (e) { clicEnPista(e); });
        $('#tesKnobFrom, #tesKnobTo').on('keydown', function (e) { moverKnobConTeclado(e, this.id === 'tesKnobFrom' ? 'from' : 'to'); });

        // Menú de unidad: abre con el botón, se cierra al elegir o con clic afuera.
        $('#tesBtnUnidad').on('click', function (e) {
            e.stopPropagation();
            var abierto = $('#tesMenuUnidad').toggleClass('open').hasClass('open');
            $(this).attr('aria-expanded', abierto ? 'true' : 'false');
        });
        $('#tesMenuUnidad button').on('click', function (e) {
            e.stopPropagation();
            _tes.unidad = $(this).data('unidad');
            $('#tesMenuUnidad').removeClass('open');
            $('#tesBtnUnidad').attr('aria-expanded', 'false');
            guardarPrefs();
            repintar();
        });
        $(document).on('click', function () { $('#tesMenuUnidad').removeClass('open'); $('#tesBtnUnidad').attr('aria-expanded', 'false'); });

        $('#tesSegTabla button').on('click', function () {
            _tes.vistaTabla = $(this).data('v');
            $('#tesSegTabla button').removeClass('active'); $(this).addClass('active');
            guardarPrefs();
            if (_tes.reporteActual) pintarTabla(_tes.reporteActual);
        });

        // Etiquetas de valor: un botón independiente por gráfico
        $('#tesResultado').on('click', '.tes-btn-etq', function () {
            var k = $(this).data('chart');
            _tes.etiquetas[k] = !_tes.etiquetas[k];
            $(this).toggleClass('on', _tes.etiquetas[k]);
            if (_tes.charts[k]) _tes.charts[k].update('none');
        });

        $('#btnConsultarTes').on('click', consultarReporte);
        $('#btnLimpiarTes').on('click', function () {
            $('#tesMedida').val('ppto').trigger('change.select2');
            $('#tesComparar').val('medida').trigger('change.select2');
            $('#tesEscenarioComparar').val('').trigger('change.select2');
            $('#tesNivelDetalle').val('todas').trigger('change.select2');
            if (_tes.esAdmin) elEmpresa.val('').trigger('change.select2');
            cargarMeses();
        });

        $('#btnGenerarInsightsTes').on('click', generarInsights);
        $('#btnTesPreguntar').on('click', preguntarInforme);
        $('#tesPregunta').on('keydown', function (e) { if (e.which === 13) { e.preventDefault(); preguntarInforme(); } });

        // Botón Exportar estándar: Excel · PDF · Copiar como imagen · Enviar por correo
        var correo = ExportMenu.correo({
            url: _tes.urls.correo,
            token: function () { return _tes.token; },
            datos: datosExportacion,   // mismos filtros que el Excel: el servidor reconstruye el informe
            pdf: function () { var d = construirPdf(_tes.reporteActual); return d ? d.output('datauristring') : ''; },
            pills: function () { return [$('#tesTituloEmpresa').text()].concat($('#tesPanelResultado .pyg2-chip').map(function () { return $(this).text(); }).get()); },
            textos: EXP_T
        });
        ExportMenu.init('tesExp', {
            acciones: { excel: exportarExcel, pdf: generarPdf, imagen: copiarImagen, correo: function () { if (_tes.reporteActual) correo.abrir(); } },
            textos: EXP_T
        });

        cargarPrefs();
        pintarRango();
        cargarMeses();
    });
</script>
}
