    var elEmpresa = $('#tesEmpresa'), elEscenario = $('#tesEscenario');
    var CH_MDASH = String.fromCharCode(0x2014), CH_NDASH = String.fromCharCode(0x2013), CH_MIDDOT = String.fromCharCode(0xB7);

    function cargarPrefs() {
        try {
            var p = JSON.parse(localStorage.getItem('tes.prefs') || '{}');
            if (p.vistaTabla === 'mensual' || p.vistaTabla === 'acum') _tes.vistaTabla = p.vistaTabla;
            if (['pesos', 'miles', 'millones'].indexOf(p.unidad) >= 0) _tes.unidad = p.unidad;
        } catch (e) { }
    }
    function guardarPrefs() {
        try { localStorage.setItem('tes.prefs', JSON.stringify({ vistaTabla: _tes.vistaTabla, unidad: _tes.unidad })); } catch (e) { }
    }
    function escHtml(t) { return $('<span>').text(t == null ? '' : String(t)).html(); }

    var s2lang = {
        noResults: function () { return '@Html.Raw(J("Common_Select2NoResults"))'; },
        searching: function () { return '@Html.Raw(J("Common_Select2Searching"))'; }
    };

    function empresaSeleccionada() { var v = elEmpresa.val(); return v ? parseInt(v, 10) : null; }
    function escenarioSeleccionado() { var v = elEscenario.val(); return v ? parseInt(v, 10) : 1; }

    // ===== Unidad (Pesos/Miles/Millones) — mismo patrón que PYG/Línea de Tiempo =====
    function escalarValor(v) {
        if (_tes.unidad === 'miles') return v / 1000;
        if (_tes.unidad === 'millones') return v / 1000000;
        return v;
    }
    function sufijoUnidad() {
        if (_tes.unidad === 'miles') return ' ' + _tes.t.unidadSufijoMiles;
        if (_tes.unidad === 'millones') return ' ' + _tes.t.unidadSufijoMillones;
        return '';
    }
    // Los gráficos trabajan con valores ya escalados a la unidad elegida: esto los devuelve a pesos para formatear/etiquetar.
    function aPesos(v) { return _tes.unidad === 'miles' ? v * 1000 : (_tes.unidad === 'millones' ? v * 1000000 : v); }
    // Millones con 2 decimales (las líneas pequeñas de la caja no se pierden como "0,0"); pesos y miles sin decimales.
    function decimalesUnidad() { return _tes.unidad === 'millones' ? 2 : 0; }
    function fmtNumSolo(v) {
        var d = decimalesUnidad();
        try { return new Intl.NumberFormat(_tes.cultura, { minimumFractionDigits: d, maximumFractionDigits: d }).format(escalarValor(v)); }
        catch (e) { return String(escalarValor(v)); }
    }
    function fmtNum(v) { return fmtNumSolo(v) + sufijoUnidad(); }
    function fmtNumVar(v) {
        var d = decimalesUnidad(), n = escalarValor(v);
        try { return new Intl.NumberFormat(_tes.cultura, { minimumFractionDigits: d, maximumFractionDigits: d, signDisplay: 'exceptZero' }).format(n) + sufijoUnidad(); }
        catch (e) { return (n >= 0 ? '+' : '') + n + sufijoUnidad(); }
    }
    function fmtPctVar(v) {
        if (v === null || v === undefined) return CH_MDASH;
        try { return new Intl.NumberFormat(_tes.cultura, { minimumFractionDigits: 1, maximumFractionDigits: 1, signDisplay: 'exceptZero' }).format(v * 100) + '%'; }
        catch (e) { var n = Math.round(v * 1000) / 10; return (n >= 0 ? '+' : '') + n + '%'; }
    }
    function esCulturaEs() { return _tes.cultura.toLowerCase().indexOf('es') === 0; }

    function mostrarError(mensaje) {
        console.error('[InformeTesoreriaPpto]', mensaje);
        if (typeof Swal !== 'undefined') Swal.fire({ icon: 'error', title: '@Html.Raw(J("Common_Error"))', text: mensaje });
        else alert(mensaje);
    }

    function actualizarBotonConsultar() {
        var listo = (!_tes.esAdmin || !!empresaSeleccionada()) && !!elEscenario.val() && _tes.rango.length > 0;
        $('#btnConsultarTes').prop('disabled', !listo);
    }
    function ocultarResultados() { $('#tesResultado, #tesSinDatos').hide(); $('#tesEstadoInicial').show(); }

    // "Comparar con escenario": todos los escenarios MENOS el principal; los que no tienen datos quedan deshabilitados.
    function actualizarOpcionesEscenarioComparar() {
        var principal = String(elEscenario.val() || ''), conDatos = _tes.escenariosConDatos;
        var $sel = $('#tesEscenarioComparar'), actual = String($sel.val() || ''), hayDeshabilitados = false;
        $sel.find('option[value!=""]').remove();
        _tes.escenarios.forEach(function (e) {
            if (String(e.id) === principal) return;
            var tieneDatos = !conDatos || conDatos.indexOf(e.id) >= 0;
            if (!tieneDatos) hayDeshabilitados = true;
            var texto = tieneDatos ? e.nombre : (e.nombre + ' (' + _tes.t.escenarioSinDatosEtiqueta + ')');
            $sel.append($('<option>').val(e.id).text(texto).prop('disabled', !tieneDatos).attr('title', tieneDatos ? '' : _tes.t.escenarioSinDatosTooltip));
        });
        var opcionActual = $sel.find('option[value="' + actual + '"]');
        if (!actual || !opcionActual.length || opcionActual.prop('disabled')) $sel.val('');
        $sel.trigger('change.select2');
        $('#tesEscenarioSinDatosHint').toggle(hayDeshabilitados);
    }

    function cargarMeses() {
        _tes.rango = []; _tes.iDesde = 0; _tes.iHasta = 0; _tes.escenariosConDatos = null;
        $('#tesSinMeses').hide();
        ocultarResultados();
        actualizarOpcionesEscenarioComparar();
        pintarRango();
        actualizarBotonConsultar();

        var idEmpresa = empresaSeleccionada();
        if (_tes.esAdmin && !idEmpresa) return;

        $.post(_tes.urls.meses, { idEmpresa: idEmpresa, idEscenario: escenarioSeleccionado(), __RequestVerificationToken: _tes.token }, function (resp) {
            if (!resp || !resp.success) { mostrarError((resp && resp.message) || _tes.t.errorServidor); return; }
            _tes.rango = resp.meses || [];
            _tes.escenariosConDatos = (resp.escenariosConDatos || []).map(Number);
            actualizarOpcionesEscenarioComparar();
            $('#tesSinMeses').toggle(!_tes.rango.length);
            // Por defecto "Todo": el presupuesto cubre el año de ejecución completo, y la caja acumulada se lee mejor así.
            var inicial = RangoAtajos.porDefecto('todo', _tes.rango, _tes.hoy);
            if (inicial) { _tes.iDesde = inicial.d; _tes.iHasta = inicial.h; }
            pintarRango();
            actualizarBotonConsultar();
        }).fail(function (xhr) { mostrarError(_tes.t.errorServidor + ' (HTTP ' + xhr.status + ')'); });
    }

    // ===== Slider de rango continuo (mismo control que PYG/Línea de Tiempo) =====
    function pctIndice(i) { var n = _tes.rango.length; return n > 1 ? (i / (n - 1) * 100) : 0; }

    function pintarRango() {
        var meses = _tes.rango, n = meses.length, track = $('#tesRangoTrack');
        if (n === 0) {
            track.addClass('disabled');
            $('#tesRangoDesdeLbl, #tesRangoHastaLbl, #tesRangoBadge').text(CH_MDASH);
            $('#tesRangoHastaLbl').show(); $('#tesRangoDesdeLbl').next('i').show();
            $('#tesRangoYears').empty();
            $('#tesAtajos button').removeClass('active no-disponible').prop('disabled', true).attr('title', '');
            return;
        }
        track.removeClass('disabled');
        var pD = pctIndice(_tes.iDesde), pH = pctIndice(_tes.iHasta);
        $('#tesKnobFrom').css('left', pD + '%').attr({ 'aria-valuemin': 0, 'aria-valuemax': n - 1, 'aria-valuenow': _tes.iDesde, 'aria-valuetext': meses[_tes.iDesde].etiqueta });
        $('#tesKnobTo').css('left', pH + '%').attr({ 'aria-valuemin': 0, 'aria-valuemax': n - 1, 'aria-valuenow': _tes.iHasta, 'aria-valuetext': meses[_tes.iHasta].etiqueta });
        $('#tesRangoSel').css({ left: pD + '%', width: (pH - pD) + '%' });

        var unMes = _tes.iDesde === _tes.iHasta;
        $('#tesRangoDesdeLbl').text(meses[_tes.iDesde].etiqueta);
        $('#tesRangoHastaLbl').text(unMes ? '' : meses[_tes.iHasta].etiqueta).toggle(!unMes);
        $('#tesRangoDesdeLbl').next('i').toggle(!unMes);
        var total = _tes.iHasta - _tes.iDesde + 1;
        $('#tesRangoBadge').text(total + ' ' + (total === 1 ? _tes.t.badgeMes : _tes.t.badgeMeses));

        var anios = [];
        meses.forEach(function (m) { if (anios.indexOf(m.anio) === -1) anios.push(m.anio); });
        $('#tesRangoYears').html(anios.map(function (a) { return '<span>' + a + '</span>'; }).join(''));
        RangoAtajos.pintarBotones($('#tesAtajos button'), _tes.rango, _tes.hoy, _tes.iDesde, _tes.iHasta,
            _tes.mesesCache.map(function (m) { return m.abrev; }), { tooltipFmt: _tes.t.rangoTooltipFmt, sinDatosFmt: _tes.t.rangoSinDatosFmt });
    }

    function aplicarPresetRango(preset) {
        var p = RangoAtajos.indices(preset, _tes.rango, _tes.hoy);
        if (!p) return;   // atajo sin datos (.no-disponible)
        _tes.iDesde = p.d; _tes.iHasta = p.h;
        pintarRango();
    }
    function indiceDesdeClientX(clientX) {
        var rect = document.getElementById('tesRangoTrack').getBoundingClientRect();
        var frac = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
        return Math.round(frac * (_tes.rango.length - 1));
    }
    function moverExtremo(cual, idx) {
        idx = Math.min(_tes.rango.length - 1, Math.max(0, idx));
        if (cual === 'from') { _tes.iDesde = idx; if (_tes.iDesde > _tes.iHasta) _tes.iHasta = _tes.iDesde; }
        else { _tes.iHasta = idx; if (_tes.iHasta < _tes.iDesde) _tes.iDesde = _tes.iHasta; }
        pintarRango();
    }
    function iniciarArrastreSlider(e, cual) {
        if (_tes.rango.length < 2) return;
        e.preventDefault();
        var track = $('#tesRangoTrack').addClass('dragging');
        function onMove(ev) { moverExtremo(cual, indiceDesdeClientX(ev.clientX)); }
        function onUp() { track.removeClass('dragging'); window.removeEventListener('pointermove', onMove); window.removeEventListener('pointerup', onUp); }
        window.addEventListener('pointermove', onMove);
        window.addEventListener('pointerup', onUp);
    }
    function clicEnPista(e) {
        if ($(e.target).hasClass('knob') || _tes.rango.length < 2) return;
        var idx = indiceDesdeClientX(e.clientX);
        var cual = Math.abs(idx - _tes.iDesde) <= Math.abs(idx - _tes.iHasta) ? 'from' : 'to';
        moverExtremo(cual, idx);
        iniciarArrastreSlider(e, cual);
    }
    function moverKnobConTeclado(e, cual) {
        var n = _tes.rango.length;
        if (n < 2) return;
        var idx = cual === 'from' ? _tes.iDesde : _tes.iHasta;
        if (e.key === 'ArrowLeft') idx -= 1; else if (e.key === 'ArrowRight') idx += 1;
        else if (e.key === 'Home') idx = 0; else if (e.key === 'End') idx = n - 1; else return;
        e.preventDefault();
        moverExtremo(cual, idx);
    }

    // ===== Etiquetas de período (siempre a partir del reporte consultado, no del slider) =====
    function etiquetaRango(aD, mD, aH, mH) {
        var M = _tes.mesesCache;
        if (aD === aH && mD === mH) return M[mD - 1].nombre + ' ' + aH;
        if (aD === aH) return M[mD - 1].abrev + ' ' + CH_NDASH + ' ' + M[mH - 1].abrev + ' ' + aH;
        return M[mD - 1].abrev + ' ' + aD + ' ' + CH_NDASH + ' ' + M[mH - 1].abrev + ' ' + aH;
    }
    function etiquetaPeriodo(r) { return etiquetaRango(r.AnioDesde, r.MesDesde, r.AnioHasta, r.MesHasta); }
    function mesesDelReporte(r) { return r.MesesRango.length; }
    function etiquetaPeriodoChip(r) {
        var n = mesesDelReporte(r);
        return etiquetaPeriodo(r) + ' ' + CH_MIDDOT + ' ' + n + ' ' + (n === 1 ? _tes.t.badgeMes : _tes.t.badgeMeses);
    }
    function nombreMedida(m) { return _tes.t.medida[m] || m; }
    function nombreMedidaCorta(m) { return _tes.t.medidaCorta[m] || m; }
    function otraMedida(m) { return m === 'proy' ? 'ppto' : 'proy'; }
    function nombreEscenarioComp(r) {
        if (!r.HayEscenarioComparar) return '';
        var e = _tes.escenarios.filter(function (x) { return x.id === r.IdEscenarioComparar; })[0];
        return e ? e.nombre : ('#' + r.IdEscenarioComparar);
    }
    function abrevMes(mes, anio, conAnio) { var a = _tes.mesesCache[mes - 1].abrev; return conAnio ? (a + ' ' + String(anio).slice(-2)) : a; }

    function filtrosDelSlider() {
        var d = _tes.rango[_tes.iDesde], h = _tes.rango[_tes.iHasta];
        return {
            IdEmpresa: empresaSeleccionada() || '',
            IdEscenario: escenarioSeleccionado(),
            AnioDesde: d.anio, MesDesde: d.mes, AnioHasta: h.anio, MesHasta: h.mes,
            Medida: $('#tesMedida').val() || 'ppto',
            Comparar: $('#tesComparar').val() || 'medida',
            IdEscenarioComparar: $('#tesEscenarioComparar').val() || ''
        };
    }

    function consultarReporte() {
        if (!_tes.rango.length) return;
        var filtros = filtrosDelSlider();
        $('#overlayConsultandoTes').css('display', 'flex');
        $.post(_tes.urls.reporte, $.extend({ __RequestVerificationToken: _tes.token }, filtros), function (resp) {
            $('#overlayConsultandoTes').hide();
            if (!resp || !resp.success) { mostrarError((resp && resp.message) || _tes.t.errorServidor); return; }
            var reporte = resp.reporte;
            if (!reporte || reporte.SinDatos) { $('#tesEstadoInicial, #tesResultado').hide(); $('#tesSinDatos').show(); return; }
            pintarReporte(reporte, filtros);
        }).fail(function (xhr) { $('#overlayConsultandoTes').hide(); mostrarError(_tes.t.errorServidor + ' (HTTP ' + xhr.status + ')'); });
    }

    function pintarReporte(r, filtros) {
        _tes.reporteActual = r;
        _tes.filtrosConsultados = filtros;   // Excel / insights / correo usan exactamente estos filtros
        reiniciarInsights();

        var comparados = [];
        if (r.HayComparativo) comparados.push(nombreMedida(otraMedida(r.Medida)));
        if (r.HayEscenarioComparar) comparados.push(nombreEscenarioComp(r));

        $('#tesTituloEmpresa').text(elEmpresa.find(':selected').text() || '');
        $('#tesChipPeriodo').text(etiquetaPeriodoChip(r));
        $('#tesChipEscenario').text(elEscenario.find(':selected').text() || '');
        $('#tesChipMedida').text(nombreMedida(r.Medida));
        $('#tesChipComparado').text(comparados.length ? _tes.t.chipComparadoFmt.replace('{0}', comparados.join(', ')) : _tes.t.chipSinComparar);
        try { $('#tesFechaGenerado').text(new Date().toLocaleDateString(_tes.cultura, { day: 'numeric', month: 'long', year: 'numeric' })); }
        catch (e) { $('#tesFechaGenerado').text(''); }

        $('#tesLeyendaComp').toggle(!!r.HayComparativo);
        $('#tesLeyendaCompNombre').text(nombreMedida(otraMedida(r.Medida)) + ' (' + _tes.t.cajaNetaAcum.toLowerCase() + ')');
        $('#tesLeyendaEsc').toggle(!!r.HayEscenarioComparar);
        $('#tesLeyendaEscNombre').text(nombreEscenarioComp(r));

        var notaProy = (r.Medida === 'proy' || r.HayComparativo) && !r.HayProyeccion;
        $('#tesNotaProyeccion').text(_tes.t.notaSinProyeccion).toggle(notaProy);
        $('#tesNotaEscenario').text(_tes.t.escenarioSinDatosNota).toggle(!!r.IdEscenarioComparar && !r.HayEscenarioComparar);

        $('#tesEstadoInicial, #tesSinDatos').hide();
        $('#tesResultado').show();   // visible ANTES de crear los charts: Chart.js mide el contenedor
        repintar();
    }

    // Repinta lo que depende de la unidad / de la vista de la tabla, sin volver a consultar.
    function repintar() {
        var r = _tes.reporteActual;
        if (!r) return;
        $('#tesUnidadLbl').text(_tes.t.unidades[_tes.unidad]);
        $('#tesMenuUnidad button').each(function () {
            var on = $(this).data('unidad') === _tes.unidad;
            $(this).toggleClass('on', on).attr('aria-checked', on ? 'true' : 'false');
        });
        $('#tesInfoBadge').text(_tes.t.unidadBadge[_tes.unidad]);
        $('#tesSegTabla button').each(function () { $(this).toggleClass('active', $(this).data('v') === _tes.vistaTabla); });
        $('.tes-btn-etq').each(function () { $(this).toggleClass('on', !!_tes.etiquetas[$(this).data('chart')]); });

        pintarEstado(r);
        pintarKpis(r);
        pintarCharts(r);
        pintarDestacados(r);
        pintarHeat(r);
        pintarTabla(r);
    }

    // ===== Utilidades =====
    function variacionRelativa(real, base) {
        if (base === null || base === undefined || base === 0) return null;
        return (real - base) / Math.abs(base);
    }
    var TES_UMBRAL_CRITICO = 0.15;
    function esFavorable(esGastoOCosto, valor) { return esGastoOCosto ? valor <= 0 : valor >= 0; }
    function claseVariacion(esGastoOCosto, valor) {
        if (valor === null || valor === undefined || valor === 0) return 'neu';
        return esFavorable(esGastoOCosto, valor) ? 'good' : 'bad';
    }
    function chipVariacion(texto, valor, favorable, conCritico) {
        if (valor === null || valor === undefined || isNaN(valor)) return '<span class="pyg2-dchip">' + CH_MDASH + '</span>';
        var icono = (conCritico && Math.abs(valor) >= TES_UMBRAL_CRITICO)
            ? '<i class="fas fa-circle-exclamation"></i>' : '<i class="fas fa-caret-' + (valor >= 0 ? 'up' : 'down') + '"></i>';
        return '<span class="pyg2-dchip ' + (favorable ? 'up' : 'down') + '">' + icono + escHtml(texto) + '</span>';
    }
    function kpiDe(r, codigo) { return (r.Kpis || []).filter(function (k) { return k.Codigo === codigo; })[0]; }
    function nombreMes(mes) { return _tes.mesesCache[mes - 1].nombre; }

    // ===== Estado de la caja (semáforo simple) =====
    function datosEstado(r) {
        var deuda = kpiDe(r, 'DeudaNueva'), meses = kpiDe(r, 'MesesDeficit'), minimo = kpiDe(r, 'SaldoMinimo'), fin = kpiDe(r, 'CajaAcumFinal');
        if (!deuda || !meses || !minimo || !fin) return null;
        var t = _tes.t;
        var mesMin = nombreMes(minimo.Mes) + ' ' + minimo.Anio;
        if (deuda.Valor > 0) {
            return { cls: 'mal', icono: 'fa-triangle-exclamation', titulo: t.estadoMalTitulo,
                desc: t.estadoMalFmt.replace('{0}', fmtNum(deuda.Valor)).replace('{1}', meses.Valor).replace('{2}', meses.Total).replace('{3}', mesMin) };
        }
        if (minimo.Valor === 0) {   // la caja llega exactamente a cero: sin colchón
            return { cls: 'aviso', icono: 'fa-circle-exclamation', titulo: t.estadoAvisoTitulo, desc: t.estadoAvisoFmt.replace('{0}', fmtNum(minimo.Valor)).replace('{1}', mesMin) };
        }
        return { cls: 'ok', icono: 'fa-circle-check', titulo: t.estadoOkTitulo, desc: t.estadoOkFmt.replace('{0}', fmtNum(minimo.Valor)).replace('{1}', mesMin).replace('{2}', fmtNum(fin.Valor)) };
    }
    function pintarEstado(r) {
        var d = datosEstado(r);
        var $e = $('#tesEstado');
        if (!d) { $e.hide(); return; }
        $e.show().removeClass('ok mal aviso').addClass(d.cls);
        $e.find('.ic i').attr('class', 'fas ' + d.icono);
        $('#tesEstadoTitulo').text(d.titulo);
        $('#tesEstadoDesc').text(d.desc);
    }

    // ===== KPIs =====
    var KPI_ICONOS = { CajaNetaPeriodo: 'fa-money-bill-transfer', CajaAcumFinal: 'fa-vault', SaldoMinimo: 'fa-arrow-down-short-wide', MesesDeficit: 'fa-calendar-xmark', DeudaNueva: 'fa-hand-holding-dollar' };

    // Datos de las tarjetas (pantalla y PDF muestran exactamente lo mismo).
    function datosKpis(r) {
        var t = _tes.t, medComp = nombreMedidaCorta(otraMedida(r.Medida));
        return (r.Kpis || []).map(function (k) {
            var esMeses = k.Codigo === 'MesesDeficit';
            var valorTxt = esMeses ? t.deMesesFmt.replace('{0}', k.Valor).replace('{1}', k.Total) : fmtNum(k.Valor);
            var sano = esMeses || k.Codigo === 'DeudaNueva' ? k.Valor === 0 : k.Valor >= 0;
            var nota = (k.Codigo === 'SaldoMinimo' && k.Mes) ? (nombreMes(k.Mes) + ' ' + k.Anio) : '';
            var refs = [];
            if (r.HayComparativo) {
                var compTxt = esMeses ? t.deMesesFmt.replace('{0}', k.ValorComp).replace('{1}', k.Total) : fmtNum(k.ValorComp);
                var d = esMeses ? (k.Valor - k.ValorComp) : k.VariacionPorcentual;
                var malo = esMeses || k.Codigo === 'DeudaNueva' ? (k.Valor > k.ValorComp) : (k.Valor < k.ValorComp);
                refs.push({ ref: t.vsFmt.replace('{0}', medComp), val: compTxt, chip: esMeses ? (k.Valor - k.ValorComp === 0 ? null : fmtNumVarEntero(k.Valor - k.ValorComp)) : (d === null || d === undefined ? null : fmtPctVar(d)), malo: malo });
            }
            if (r.HayEscenarioComparar) {
                var escTxt = esMeses ? t.deMesesFmt.replace('{0}', k.ValorEsc).replace('{1}', k.Total) : fmtNum(k.ValorEsc);
                refs.push({ ref: t.vsFmt.replace('{0}', nombreEscenarioComp(r)), val: escTxt, chip: null, malo: false });
            }
            return { codigo: k.Codigo, icono: KPI_ICONOS[k.Codigo] || 'fa-chart-pie', nombre: t.kpi[k.Codigo] || k.Codigo, valorTxt: valorTxt, sano: sano, nota: nota, refs: refs };
        });
    }
    function fmtNumVarEntero(n) { return (n > 0 ? '+' : '') + n; }

    function pintarKpis(r) {
        var $s = $('#tesKpiStrip').empty();
        datosKpis(r).forEach(function (k) {
            var filas = k.refs.map(function (x) {
                var chip = x.chip ? '<span class="pyg2-dchip ' + (x.malo ? 'down' : 'up') + '">' + escHtml(x.chip) + '</span>' : '';
                return '<div class="row"><span class="ref">' + escHtml(x.ref) + '</span><span class="tes-kpi-nota">' + escHtml(x.val) + '</span>' + chip + '</div>';
            }).join('');
            $s.append(
                '<div class="pyg2-kpi ' + (k.sano ? 'tes-kpi-bueno' : 'tes-kpi-malo') + '">' +
                    '<div class="pyg2-kpi-head"><span class="ic"><i class="fas ' + k.icono + '"></i></span><span class="nm">' + escHtml(k.nombre) + '</span></div>' +
                    '<div class="pyg2-kpi-val"><span class="v">' + escHtml(k.valorTxt) + '</span><span class="p">' + escHtml(k.nota || ' ') + '</span></div>' +
                    '<div class="pyg2-kpi-deltas">' + filas + '</div>' +
                '</div>');
        });
    }

    // ===== Gráficos =====
    function destruirCharts() {
        Object.keys(_tes.charts).forEach(function (k) { if (_tes.charts[k]) _tes.charts[k].destroy(); });
        _tes.charts = {};
    }

    // Etiquetas de valor: Chart.js no las trae. Plugin liviano con anti-superposición (se ordenan por importancia: último,
    // máx./mín., primero, resto; las que chocan con una ya dibujada se omiten — el valor sigue en el tooltip y en la tabla).
    // El formateador va FUERA de las opciones de Chart.js (una función ahí se trataría como opción "scriptable").
    var ETQ_ALTO = 12, ETQ_SEP = 6, ETQ_PAD = 3;
    var tesEtiquetas = {
        id: 'tesEtiquetas',
        afterDatasetsDraw: function (chart) {
            var cfg = (chart.options.plugins && chart.options.plugins.tesEtiquetas) || {};
            if (!_tes.etiquetas[cfg.clave]) return;
            var ctx = chart.ctx, area = chart.chartArea, cand = [];
            ctx.save();
            ctx.font = '600 10.5px ' + (ctx.font.split(' ').pop() || 'sans-serif');
            chart.data.datasets.forEach(function (ds, i) {
                if (ds.sinEtiqueta) return;
                var meta = chart.getDatasetMeta(i);
                if (!meta || !chart.isDatasetVisible(i)) return;
                var vals = ds.data, n = meta.data.length, iMax = -1, iMin = -1, esBarra = meta.type === 'bar';
                vals.forEach(function (v, k) {
                    if (v === null || v === undefined) return;
                    if (iMax < 0 || v > vals[iMax]) iMax = k;
                    if (iMin < 0 || v < vals[iMin]) iMin = k;
                });
                meta.data.forEach(function (el, idx) {
                    var v = vals[idx];
                    if (v === null || v === undefined || isNaN(el.x) || isNaN(el.y)) return;
                    var txt = fmtNumSolo(aPesos(v));
                    cand.push({ x: el.x, y: el.y, txt: txt, w: ctx.measureText(txt).width, neg: v < 0, barra: esBarra,
                        color: ds.etqColor || '#334155',
                        prio: idx === n - 1 ? 0 : (idx === iMax || idx === iMin) ? 1 : idx === 0 ? 2 : 3, ord: cand.length });
                });
            });
            cand.sort(function (a, b) { return a.prio - b.prio || a.ord - b.ord; });
            var puestas = [];
            cand.forEach(function (c) {
                var m = c.w / 2 + ETQ_PAD, cx = Math.min(Math.max(c.x, area.left + m), area.right - m);
                var arriba = c.y - ETQ_SEP - ETQ_ALTO, abajo = c.y + ETQ_SEP;
                var ops = c.barra ? [c.neg ? abajo : arriba] : (c.neg ? [abajo, arriba] : [arriba, abajo]);
                for (var k = 0; k < ops.length; k++) {
                    var b = { x1: cx - m, x2: cx + m, y1: ops[k], y2: ops[k] + ETQ_ALTO, cx: cx, c: c };
                    if (b.y1 < 0 || b.y2 > chart.height) continue;
                    if (puestas.some(function (o) { return b.x1 < o.x2 && b.x2 > o.x1 && b.y1 < o.y2 && b.y2 > o.y1; })) continue;
                    puestas.push(b); return;
                }
            });
            ctx.textAlign = 'center'; ctx.textBaseline = 'top'; ctx.lineJoin = 'round'; ctx.lineWidth = 3;
            ctx.strokeStyle = 'rgba(255,255,255,.92)';
            puestas.forEach(function (b) {
                ctx.strokeText(b.c.txt, b.cx, b.y1 + 1);
                ctx.fillStyle = b.c.color; ctx.fillText(b.c.txt, b.cx, b.y1 + 1);
            });
            ctx.restore();
        }
    };

    // Fondo blanco (el PDF/imagen exporta el canvas como JPEG) y línea de cero resaltada.
    var tesFondo = {
        id: 'tesFondo',
        beforeDraw: function (chart) {
            var ctx = chart.ctx; ctx.save(); ctx.globalCompositeOperation = 'destination-over';
            ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, chart.width, chart.height); ctx.restore();
        }
    };

    function pintarCharts(r) {
        destruirCharts();
        pintarPrincipal(r);
        pintarCascada(r);
        $('#tesGraficoSub').text(_tes.t.graficoSubFmt.replace('{0}', nombreMedida(r.Medida)));
        $('#tesCascadaSub').text(_tes.t.cascadaSubFmt.replace('{0}', etiquetaPeriodo(r)));
    }

    // Caja neta mensual (barras verde/rojo) + caja neta acumulada (línea); la otra medida y el escenario, como líneas.
    function pintarPrincipal(r) {
        var meses = r.Meses || [], variosAnios = meses.length && meses[0].Anio !== meses[meses.length - 1].Anio;
        var etiquetas = meses.map(function (m) { return abrevMes(m.Mes, m.Anio, variosAnios); });
        var alfa = function (hex, enRango) { return enRango ? hex : hex + '55'; };
        var datasets = [
            { type: 'bar', label: _tes.t.cajaNeta, data: meses.map(function (m) { return escalarValor(m.CajaNeta); }), order: 3,
              backgroundColor: meses.map(function (m) { return alfa(m.CajaNeta >= 0 ? '#16A34A' : '#F87171', m.EnRango); }), borderRadius: 4, maxBarThickness: 36 },
            { type: 'line', label: _tes.t.cajaNetaAcum, data: meses.map(function (m) { return escalarValor(m.CajaNetaAcum); }), order: 1,
              borderColor: '#6366F1', backgroundColor: '#6366F1', borderWidth: 2.5, tension: .25, pointRadius: 3, pointHoverRadius: 5, etqColor: '#4338CA' }
        ];
        if (r.HayComparativo) datasets.push({ type: 'line', label: nombreMedida(otraMedida(r.Medida)) + ' (' + _tes.t.cajaNetaAcum.toLowerCase() + ')', sinEtiqueta: true, order: 2,
            data: meses.map(function (m) { return escalarValor(m.CajaNetaAcumComp); }), borderColor: '#D97706', backgroundColor: 'transparent',
            borderWidth: 2, borderDash: [6, 4], tension: .25, pointRadius: 0, pointHoverRadius: 4 });
        if (r.HayEscenarioComparar) datasets.push({ type: 'line', label: nombreEscenarioComp(r), sinEtiqueta: true, order: 2,
            data: meses.map(function (m) { return escalarValor(m.CajaNetaAcumEsc); }), borderColor: '#0EA5E9', backgroundColor: 'transparent',
            borderWidth: 2, tension: .25, pointRadius: 0, pointHoverRadius: 4 });

        _tes.charts.principal = new Chart(document.getElementById('tesChartPrincipal').getContext('2d'), {
            type: 'bar',
            data: { labels: etiquetas, datasets: datasets },
            plugins: [tesFondo, tesEtiquetas],
            options: {
                responsive: true, maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                layout: { padding: { top: 14 } },
                plugins: {
                    legend: { display: false },
                    tesEtiquetas: { clave: 'principal' },
                    tooltip: { callbacks: { label: function (c) { return c.dataset.label + ': ' + fmtNum(aPesos(c.parsed.y)); } } }
                },
                scales: {
                    x: { grid: { display: false }, ticks: { font: { size: 11 } } },
                    y: { ticks: { font: { size: 11 } }, grid: { color: function (c) { return c.tick && c.tick.value === 0 ? '#94A3B8' : '#EEF0F6'; } } }
                }
            }
        });
    }

    // Puente de caja: cada tramo ya viene del servidor como diferencia exacta entre subtotales del modelo, así que SIEMPRE
    // cuadra con la caja neta del rango.
    function pintarCascada(r) {
        var barras = r.Cascada || [];
        if (!barras.length) return;
        var etiquetas = barras.map(function (b) { return _tes.t.casc[b.Etiqueta] || b.Etiqueta; });
        var datos = barras.map(function (b) { return [escalarValor(b.Desde), escalarValor(b.Hasta)]; });
        var colores = barras.map(function (b) { return b.Tipo === 'total' ? '#6366F1' : (b.Tipo === 'positivo' ? '#16A34A' : '#F87171'); });

        var etiquetasPlugin = {
            id: 'tesCascadaEtiquetas',
            afterDatasetsDraw: function (chart) {
                if (!_tes.etiquetas.cascada) return;
                var ctx = chart.ctx, meta = chart.getDatasetMeta(0), escalaY = chart.scales.y;
                if (!meta || !meta.data.length) return;
                ctx.save();
                ctx.font = '800 12px Nunito, sans-serif';
                ctx.textAlign = 'center';
                meta.data.forEach(function (el, i) {
                    var b = barras[i], arriba = Math.min(el.y, el.base), abajoDe = Math.max(el.y, el.base);
                    var negativoTotal = b.Tipo === 'total' && b.Hasta < 0;
                    ctx.fillStyle = b.Tipo === 'total' ? '#16121F' : (b.Tipo === 'positivo' ? '#16A34A' : '#DC2626');
                    ctx.textBaseline = negativoTotal ? 'top' : 'bottom';
                    ctx.fillText(b.Tipo === 'total' ? fmtNum(b.Hasta) : fmtNumVar(b.Delta || 0), el.x, negativoTotal ? abajoDe + 6 : arriba - 6);
                });
                ctx.strokeStyle = '#C7C2E6'; ctx.lineWidth = 1; ctx.setLineDash([3, 3]);
                for (var i = 0; i < meta.data.length - 1; i++) {
                    var el = meta.data[i], sig = meta.data[i + 1], b = barras[i];
                    var nivel = b.Tipo === 'negativo' ? b.Desde : b.Hasta;
                    var y = Math.round(escalaY.getPixelForValue(escalarValor(nivel))) + 0.5;
                    ctx.beginPath(); ctx.moveTo(el.x + el.width / 2, y); ctx.lineTo(sig.x - sig.width / 2, y); ctx.stroke();
                }
                ctx.restore();
            }
        };
        var niveles = [0];
        barras.forEach(function (b) { niveles.push(escalarValor(b.Desde), escalarValor(b.Hasta)); });
        var maxN = Math.max.apply(null, niveles), minN = Math.min.apply(null, niveles), margen = (maxN - minN) * 0.12 || 1;

        _tes.charts.cascada = new Chart(document.getElementById('tesChartCascada').getContext('2d'), {
            type: 'bar',
            data: { labels: etiquetas, datasets: [{ label: _tes.t.cajaNeta, data: datos, backgroundColor: colores, borderRadius: 6, borderSkipped: false, barPercentage: 0.7, categoryPercentage: 0.8, maxBarThickness: 78 }] },
            plugins: [tesFondo, etiquetasPlugin],
            options: {
                responsive: true, maintainAspectRatio: false,
                layout: { padding: { top: 22, bottom: 14 } },
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: function (c) { var b = barras[c.dataIndex]; return b.Tipo === 'total' ? fmtNum(b.Hasta) : (etiquetas[c.dataIndex] + ': ' + fmtNumVar(b.Delta || 0)); } } }
                },
                scales: {
                    y: { display: true, suggestedMax: maxN + margen, suggestedMin: Math.min(0, minN - margen), ticks: { display: false }, border: { display: false },
                         grid: { color: function (c) { return c.tick && c.tick.value === 0 ? '#94A3B8' : '#F1F0F7'; } } },
                    x: { grid: { display: false }, ticks: { font: { family: "'Nunito', sans-serif", size: 11.5, weight: '700' }, color: '#8B85A0' } }
                }
            }
        });
    }

    // ===== Lo más relevante =====
    // Top 4 líneas (no subtotal ni saldo) por |variación en pesos| contra la otra medida; sin comparación, por peso del rango.
    function datosDestacados(r) {
        var cand = (r.Filas || []).filter(function (f) { return !f.EsSubtotal && !f.EsSaldo; });
        if (r.HayComparativo) {
            cand = cand.filter(function (f) { return f.VariacionAbsoluta !== 0; });
            cand.sort(function (a, b) { return Math.abs(b.VariacionAbsoluta) - Math.abs(a.VariacionAbsoluta); });
        } else {
            cand = cand.filter(function (f) { return f.Total !== 0; });
            cand.sort(function (a, b) { return Math.abs(b.Total) - Math.abs(a.Total); });
        }
        return cand.slice(0, 4);
    }
    function pintarDestacados(r) {
        var t = _tes.t, top = datosDestacados(r), $list = $('#tesHighlightsList').empty();
        $('#tesRelevanteSub').text(r.HayComparativo ? t.relevanteSubComp.replace('{0}', nombreMedida(otraMedida(r.Medida))) : t.relevanteSubPeso);
        if (!top.length) { $list.append($('<div class="pyg2-hl-empty">').text(t.sinDestacados)); return; }
        var valor = function (f) { return r.HayComparativo ? f.VariacionAbsoluta : f.Total; };
        var base = Math.abs(valor(top[0])) || 1;
        top.forEach(function (f) {
            var v = valor(f), fav = r.HayComparativo ? esFavorable(f.EsGastoOCosto, v) : !f.EsGastoOCosto;
            var ancho = Math.abs(v) / base * 100;
            var tag = r.HayComparativo ? ((fav ? t.favorable : t.desfavorableCorto) + ' ' + CH_MIDDOT + ' ' + fmtPctVar(f.VariacionPorcentual)) : t.mayorPeso;
            $list.append(
                '<div class="pyg2-hl ' + (fav ? 'up' : 'down') + '">' +
                    '<div class="pyg2-hl-top"><span class="nm">' + escHtml(f.Descripcion) + '</span><span class="val">' + escHtml(r.HayComparativo ? fmtNumVar(v) : fmtNum(v)) + '</span></div>' +
                    '<div class="pyg2-hl-bot"><div class="pyg2-hl-track"><i style="width:' + ancho.toFixed(1) + '%"></i></div><span class="tag">' + escHtml(tag) + '</span></div>' +
                '</div>');
        });
    }

    // ===== Mapa de caja mensual =====
    function colorHeat(v, max) {
        if (!v) return null;
        var a = Math.min(1, Math.abs(v) / (max || 1)), base = v > 0 ? [187, 247, 208] : [254, 202, 202], fin = v > 0 ? [74, 222, 128] : [248, 113, 113];
        var mix = function (i) { return Math.round(base[i] + (fin[i] - base[i]) * a * 0.75); };
        return 'rgb(' + mix(0) + ',' + mix(1) + ',' + mix(2) + ')';
    }
    function pintarHeat(r) {
        var meses = r.Meses || [], variosAnios = meses.length && meses[0].Anio !== meses[meses.length - 1].Anio;
        var maxNeta = Math.max.apply(null, meses.map(function (m) { return Math.abs(m.CajaNeta); }).concat([1]));
        var maxAcum = Math.max.apply(null, meses.map(function (m) { return Math.abs(m.CajaNetaAcum); }).concat([1]));
        var $h = $('#tesHeat').css('grid-template-columns', 'minmax(120px,auto) repeat(' + meses.length + ', minmax(64px, 1fr))').empty();
        $h.append('<div></div>');
        meses.forEach(function (m) { $h.append('<div class="h' + (m.EnRango ? '' : ' fuera') + '">' + escHtml(abrevMes(m.Mes, m.Anio, variosAnios)) + '</div>'); });
        [{ lbl: _tes.t.heatNeta, k: 'CajaNeta', max: maxNeta }, { lbl: _tes.t.heatAcum, k: 'CajaNetaAcum', max: maxAcum }].forEach(function (fila) {
            $h.append('<div class="rl">' + escHtml(fila.lbl) + '</div>');
            meses.forEach(function (m) {
                var v = m[fila.k], bg = colorHeat(v, fila.max);
                var estilo = bg ? ' style="background:' + bg + ';color:' + (v > 0 ? '#14532D' : '#7F1D1D') + '"' : '';
                $h.append('<div class="c' + (bg ? '' : ' cero') + (m.EnRango ? '' : ' fuera') + '"' + estilo + ' title="' + escHtml(fmtNum(v)) + '">' + escHtml(fmtNumSolo(v)) + '</div>');
            });
        });
        $('#tesHeatSub').text(_tes.t.heatSubFmt.replace('{0}', nombreMedida(r.Medida)).replace('{1}', _tes.t.unidades[_tes.unidad].toLowerCase()));
    }

    // ===== Tabla por mes (vista mensual o acumulada dentro del rango) =====
    function valoresVista(f, lista) {
        if (_tes.vistaTabla !== 'acum' || f.EsSaldo) return lista;
        var acc = 0; return lista.map(function (v) { acc += v; return acc; });
    }
    function filasVisibles(r) {
        var soloSub = $('#tesNivelDetalle').val() === 'subtotales';
        return (r.Filas || []).filter(function (f) { return !soloSub || f.EsSubtotal; });
    }
    function encabezadosTabla(r) {
        var t = _tes.t, variosAnios = r.AnioDesde !== r.AnioHasta;
        var meses = r.MesesRango.map(function (m) { return abrevMes(m.Mes, m.Anio, variosAnios); });
        var cols = meses.slice();
        cols.push(_tes.vistaTabla === 'acum' ? t.colSaldoFin : t.colTotal);
        if (r.HayComparativo) { cols.push(nombreMedidaCorta(otraMedida(r.Medida))); cols.push(t.colVarAbs); cols.push(t.colVarPct); }
        if (r.HayEscenarioComparar) cols.push(t.colVsEscenarioFmt.replace('{0}', nombreEscenarioComp(r)));
        return cols;
    }
    function pintarTabla(r) {
        var cols = encabezadosTabla(r), nMes = r.MesesRango.length;
        var head = '<tr><th class="col-cuenta">' + escHtml(_tes.t.colLinea) + '</th>' + cols.map(function (c, i) { return '<th' + (i === nMes ? ' class="tot"' : '') + '>' + escHtml(c) + '</th>'; }).join('') + '</tr>';
        $('#tesTablaHead').html(head);
        var body = filasVisibles(r).map(function (f) {
            var vals = valoresVista(f, f.Valores);
            var html = '<tr' + (f.EsSubtotal ? ' class="sub"' : '') + '><td class="lbl">' + escHtml(f.Descripcion) + '</td>';
            vals.forEach(function (v) { html += '<td class="mes' + (v < 0 ? ' neg' : '') + '">' + escHtml(fmtNumSolo(v)) + '</td>'; });
