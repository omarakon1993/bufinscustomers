@using System.Web
@using bufinscustomers.Models
@{
    ViewBag.Title = Resources.Strings.TesPpto_PageTitle;
    var empresas = ViewBag.Empresas as List<Empresas>;
    var esAdmin = (bool)(ViewBag.EsAdmin ?? false);
    var culturaJs = System.Globalization.CultureInfo.CurrentUICulture.Name;
    // T = texto para HTML (Razor lo codifica); J = texto para JS (escapado). Ambos leen de App_GlobalResources/Strings(.en-US).resx.
    Func<string, string> T = k => (System.Web.HttpContext.GetGlobalResourceObject("Strings", k) as string) ?? k;
    Func<string, string> J = k => HttpUtility.JavaScriptStringEncode(T(k));
}

<link href="~/Assets/css/bufins-components.css" rel="stylesheet" />
<link href="~/Assets/css/informe-linea-tiempo.css" rel="stylesheet" />
<link href="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/css/informe-pyg.css")" rel="stylesheet" />
<link href="~/Assets/css/informe-tesoreria.css" rel="stylesheet" />
<link href="~/Assets/css/export-menu.css" rel="stylesheet" />
<link href="~/Assets/css/select2/select2.min.css" rel="stylesheet" />

<div class="container-fluid px-4">
<div class="lt-app">

    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas fa-vault powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@T("TesPpto_PageTitle")</h1>
            @Html.Partial("_ModeloBufinsTag")
        </div>
    </div>

    @Html.AntiForgeryToken()

    <div class="filter-card">
        <div class="lt-section-title"><span>@T("Common_FiltrosConsulta")</span></div>
        <div class="lt-grid-quever tes-grid-4">
            <div class="lt-field">
                <label class="lt-field-label" for="tesEmpresa">@T("Common_LabelEmpresa")</label>
                <select id="tesEmpresa" class="lt-field-select">
                    @if (esAdmin) { <option value="">@T("Common_Seleccione")</option> }
                    @if (empresas != null)
                    {
                        foreach (var e in empresas)
                        {
                            <option value="@e.Id">@e.Nombre</option>
                        }
                    }
                </select>
            </div>
            <div class="lt-field">
                <label class="lt-field-label" for="tesEscenario">@T("Common_LabelEscenario")</label>
                <select id="tesEscenario" class="lt-field-select">
                    @if (ViewBag.Escenarios != null)
                    {
                        foreach (var esc in ViewBag.Escenarios)
                        {
                            <option value="@esc.Id">@esc.Nombre</option>
                        }
                    }
                </select>
            </div>
            <div class="lt-field">
                <label class="lt-field-label" for="tesMedida">@T("TesPpto_LabelMedida") <i class="fas fa-circle-info tes-info" tabindex="0" title="@T("TesPpto_MedidaHint")" aria-label="@T("TesPpto_MedidaHint")"></i></label>
                <select id="tesMedida" class="lt-field-select">
                    <option value="ppto">@T("TesPpto_Medida_ppto")</option>
                    <option value="proy">@T("TesPpto_Medida_proy")</option>
                </select>
            </div>
            <div class="lt-field">
                <label class="lt-field-label" for="tesNivelDetalle">@T("TesPpto_NivelDetalle")</label>
                <select id="tesNivelDetalle" class="lt-field-select">
                    <option value="todas">@T("TesPpto_NivelTodas")</option>
                    <option value="subtotales">@T("TesPpto_NivelSubtotales")</option>
                </select>
            </div>
        </div>

        <details class="rpt-adv">
            <summary><span>@T("TesPpto_SeccionComparaciones")</span><span class="line"></span></summary>
            <div class="rpt-adv-body">
                <div class="lt-grid-quever">
                    <div class="lt-field">
                        <label class="lt-field-label" for="tesComparar">@T("TesPpto_CompararLabel")</label>
                        <select id="tesComparar" class="lt-field-select">
                            <option value="medida">@T("TesPpto_Comp_medida")</option>
                            <option value="ninguno">@T("TesPpto_Comp_ninguno")</option>
                        </select>
                    </div>
                    <div class="lt-field">
                        <label class="lt-field-label" for="tesEscenarioComparar">@T("TesPpto_EscenarioComparar")</label>
                        @* Opciones armadas por JS (actualizarOpcionesEscenarioComparar): todos los escenarios menos el
                           principal; los que no tienen datos para la empresa quedan deshabilitados con tooltip. *@
                        <select id="tesEscenarioComparar" class="lt-field-select">
                            <option value="">@T("TesPpto_EscenarioCompararNinguno")</option>
                        </select>
                        <p class="lt-seg-hint" id="tesEscenarioSinDatosHint" style="display:none;"><i class="fas fa-circle-info mr-1"></i>@T("TesPpto_EscenarioSinDatosHint")</p>
                    </div>
                </div>
            </div>
        </details>

        @* Rango: mismo control que PYG/Balance/Línea de Tiempo (slider continuo + atajos compartidos de rango-atajos.js). *@
        <div class="lt-section-title mt"><span>@T("TesPpto_FilaCuando")</span></div>
        <div>
            <div class="rango-atajos" id="tesAtajos">
                <div class="rango-atajos-grupo">
                    <button type="button" data-preset="todo">@T("Rango_Todo")</button>
                </div>
                <div class="rango-atajos-grupo">
                    <button type="button" data-preset="ytd">@T("Rango_AnioEnCurso")</button>
                    <button type="button" data-preset="6m">@T("Rango_Ultimos6Meses")</button>
                    <button type="button" data-preset="3m">@T("Rango_UltimoTrimestre")</button>
                    <button type="button" data-preset="mesAnterior">@T("Rango_MesAnterior")</button>
                    <button type="button" data-preset="mesActual">@T("Rango_MesActual")</button>
                </div>
            </div>
            <div class="lt-range-card">
                <div class="lt-range-head">
                    <span class="lbl"><span id="tesRangoDesdeLbl">&mdash;</span><i class="fas fa-long-arrow-alt-right"></i><span id="tesRangoHastaLbl">&mdash;</span></span>
                    <span class="lt-range-badge" id="tesRangoBadge">&mdash;</span>
                </div>
                <div class="lt-range-track disabled" id="tesRangoTrack">
                    <div class="bg"></div>
                    <div class="sel" id="tesRangoSel"></div>
                    <div class="knob from" id="tesKnobFrom" tabindex="0" role="slider" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" aria-label="@T("LineaTiempo_LabelRango")"></div>
                    <div class="knob to" id="tesKnobTo" tabindex="0" role="slider" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" aria-label="@T("LineaTiempo_LabelRango")"></div>
                </div>
                <div class="lt-range-years" id="tesRangoYears"></div>
            </div>
            <p class="lt-help">@T("TesPpto_RangoHint")</p>
            <p class="lt-help" id="tesSinMeses" style="display:none;">@T("TesPpto_SinMesesDatos")</p>
        </div>

        <div class="btn-group-actions">
            <button type="button" id="btnConsultarTes" class="btn btn-modern-gradient" disabled>
                <i class="fas fa-arrow-right mr-1"></i>@T("LineaTiempo_BtnGenerar")
            </button>
            <button type="button" id="btnLimpiarTes" class="btn btn-modern-secondary">@T("Common_Limpiar")</button>
        </div>
    </div>

    <div id="tesEstadoInicial" class="lt-card lt-empty">
        <div class="lt-empty-icon"><i class="fas fa-vault"></i></div>
        <h4>@T("TesPpto_EstadoInicialTitulo")</h4>
        <p>@T("TesPpto_EstadoInicialDesc")</p>
    </div>

    <div id="tesSinDatos" class="lt-card lt-empty" style="display:none;">
        <div class="lt-empty-icon"><i class="fas fa-inbox"></i></div>
        <h4>@T("TesPpto_SinDatosTitulo")</h4>
        <p id="tesSinDatosDesc">@T("TesPpto_SinDatosDesc")</p>
    </div>

    <div id="tesResultado" style="display:none;">

        @* 1. Encabezado: marca + empresa + chips de contexto + unidad/exportaciones *@
        <div class="lt-card" id="tesPanelResultado">
            <div class="pyg2-letterhead">
                <span class="pyg2-brand"><img class="bm-logo" src="~/Assets/img/Bufins_Wordmark_Purple.png" alt="Bufins" height="14"><span class="bm-sub">@T("TesPpto_Subtitulo")</span></span>
                <span class="fecha"><span>@T("TesPpto_GeneradoEl")</span> <span id="tesFechaGenerado">&mdash;</span></span>
            </div>
            <div class="pyg2-head">
                <div class="pyg2-head-l">
                    <h2 id="tesTituloEmpresa">&mdash;</h2>
                    <div class="pyg2-chips">
                        <span class="pyg2-chip primary"><i class="fas fa-calendar"></i><span id="tesChipPeriodo">&mdash;</span></span>
                        <span class="pyg2-chip" id="tesChipEscenario">&mdash;</span>
                        <span class="pyg2-chip" id="tesChipMedida">&mdash;</span>
                        <span class="pyg2-chip" id="tesChipComparado">&mdash;</span>
                    </div>
                </div>
                <div class="pyg2-tools">
                    <button type="button" class="lt-tool-btn" id="tesBtnUnidad" aria-haspopup="menu" aria-expanded="false">
                        <span class="lbl-muted">@T("TesPpto_Unidad")</span><span id="tesUnidadLbl">@T("LineaTiempo_UnidadMillones")</span><i class="fas fa-chevron-down chev"></i>
                    </button>
                    <div class="lt-menu" id="tesMenuUnidad" role="menu">
                        <button type="button" data-unidad="pesos" role="menuitemradio">@T("LineaTiempo_UnidadPesos")<i class="fas fa-check"></i></button>
                        <button type="button" data-unidad="miles" role="menuitemradio">@T("LineaTiempo_UnidadMiles")<i class="fas fa-check"></i></button>
                        <button type="button" data-unidad="millones" role="menuitemradio">@T("LineaTiempo_UnidadMillones")<i class="fas fa-check"></i></button>
                    </div>
                    <span class="sep"></span>
                    @Html.Partial("_ExportMenu", new bufinscustomers.Models.ExportMenuVM
                    {
                        Id = "tesExp",
                        ExcelDesc = T("TesPpto_Exp_ExcelDesc")
                    })
                </div>
            </div>
        </div>
        <form id="frmExportarExcelTes" method="post" action="@Url.Action("ExportarExcel", "InformeTesoreriaPpto")">
            @Html.AntiForgeryToken()
            <div id="tesExpCampos"></div>@* los llena el botón Excel con los filtros del reporte consultado *@
        </form>

        @* 2. Estado de la caja + KPIs *@
        <div class="tes-estado" id="tesEstado">
            <span class="ic"><i class="fas fa-circle-check"></i></span>
            <div class="tx"><span class="t" id="tesEstadoTitulo">&mdash;</span><span class="s" id="tesEstadoDesc">&mdash;</span></div>
        </div>

        <div class="pyg2-section">
            <div class="pyg2-section-title">
                <span class="t">@T("TesPpto_IndicadoresClave")</span><span class="line"></span>
            </div>
            <div class="tes-kpis" id="tesKpiStrip"></div>
        </div>

        @* 3. Caja mensual (barras + acumulada) + Lo más relevante *@
        <div class="pyg2-analysis">
            <div class="pyg2-card">
                <div class="pyg2-card-head">
                    <div>
                        <div class="pyg2-card-title">@T("TesPpto_GraficoTitulo")</div>
                        <div class="pyg2-card-sub" id="tesGraficoSub">&mdash;</div>
                    </div>
                    <span class="pyg2-legend">
                        <span><i class="sq" style="background:#16A34A"></i>@T("TesPpto_LeyendaCajaPositiva")</span>
                        <span><i class="sq" style="background:#F87171"></i>@T("TesPpto_LeyendaCajaNegativa")</span>
                        <span><i class="sw" style="background:#6366F1"></i>@T("TesPpto_CajaNetaAcum")</span>
                        <span id="tesLeyendaComp"><i class="dash"></i><span id="tesLeyendaCompNombre"></span></span>
                        <span id="tesLeyendaEsc" style="display:none;"><i class="sw" style="background:#0EA5E9"></i><span id="tesLeyendaEscNombre"></span></span>
                    </span>
                    <button type="button" class="lt-tool-btn square on tes-btn-etq" data-chart="principal" title="@T("LineaTiempo_Etiquetas")" aria-label="@T("LineaTiempo_Etiquetas")"><i class="fas fa-tag"></i></button>
                </div>
                <div class="tes-chart-lg"><canvas id="tesChartPrincipal"></canvas></div>
            </div>
            <div class="pyg2-card" style="gap:12px">
                <div>
                    <div class="pyg2-card-title"><i class="fas fa-bolt"></i>@T("TesPpto_RelevanteTitulo")</div>
                    <div class="pyg2-card-sub" id="tesRelevanteSub">&mdash;</div>
                </div>
                <div class="pyg2-hl-list" id="tesHighlightsList"></div>
            </div>
        </div>

        @* 4. Puente de caja *@
        <div class="pyg2-card" style="margin-bottom:16px">
            <div class="pyg2-card-head">
                <div>
                    <div class="pyg2-card-title">@T("TesPpto_CascadaTitulo")</div>
                    <div class="pyg2-card-sub" id="tesCascadaSub">&mdash;</div>
                </div>
                <span class="pyg2-legend">
                    <span><i class="sq" style="background:#6366F1"></i>@T("TesPpto_LeyendaTotal")</span>
                    <span><i class="sq" style="background:#F87171"></i>@T("TesPpto_LeyendaResta")</span>
                    <span><i class="sq" style="background:#16A34A"></i>@T("TesPpto_LeyendaSuma")</span>
                </span>
                <button type="button" class="lt-tool-btn square on tes-btn-etq" data-chart="cascada" title="@T("LineaTiempo_Etiquetas")" aria-label="@T("LineaTiempo_Etiquetas")"><i class="fas fa-tag"></i></button>
            </div>
            <div class="tes-chart-md"><canvas id="tesChartCascada"></canvas></div>
        </div>

        @* 5. Mapa de caja mensual *@
        <div class="pyg2-card" style="margin-bottom:16px">
            <div class="pyg2-card-head">
                <div>
                    <div class="pyg2-card-title">@T("TesPpto_HeatTitulo")</div>
                    <div class="pyg2-card-sub" id="tesHeatSub">&mdash;</div>
                </div>
            </div>
            <div class="tes-heat" id="tesHeat"></div>
            <div class="tes-heat-leyenda">
                <span><i style="background:#BBF7D0"></i>@T("TesPpto_HeatSuperavit")</span>
                <span><i style="background:#FECACA"></i>@T("TesPpto_HeatDeficit")</span>
                <span><i style="background:#F4F3FB"></i>@T("TesPpto_HeatSinMovimiento")</span>
            </div>
        </div>

        @* 6. Tabla por mes *@
        <div class="pyg2-table-card">
            <div class="pyg2-card-head" style="align-items:center">
                <div>
                    <div class="pyg2-card-title">@T("TesPpto_TablaTitulo")</div>
                    <div class="pyg2-card-sub" id="tesInfoBadge">&mdash;</div>
                </div>
                <div class="pyg2-table-tools">
                    <div class="pyg2-seg soft" id="tesSegTabla">
                        <button type="button" data-v="mensual" class="active">@T("TesPpto_VistaMensual")</button>
                        <button type="button" data-v="acum">@T("TesPpto_VistaAcumulada")</button>
                    </div>
                </div>
            </div>
            <div class="pyg2-table-wrap">
                <table class="pyg2-table tes-table" id="tesTabla"><thead id="tesTablaHead"></thead><tbody id="tesTablaBody"></tbody></table>
            </div>
            <div class="pyg2-table-legend">
                <span><i class="dot" style="background:#16A34A"></i>@T("TesPpto_Favorable")</span>
                <span><i class="dot" style="background:#DC2626"></i>@T("TesPpto_Desfavorable")</span>
                <span><i class="fas fa-circle-exclamation"></i>@T("TesPpto_LeyendaCritico")</span>
            </div>
        </div>
        <p class="lt-help" id="tesNotaProyeccion" style="display:none;"></p>
        <p class="lt-help" id="tesNotaEscenario" style="display:none;"></p>

        @* Insights gerenciales (IA): se ocultan si la empresa tiene la IA apagada *@
        @if (bufinscustomers.Helpers.IAModuloHelper.Visible())
        {
        <div class="pyg-insights-card">
            <div class="pyg-insights-head">
                <div>
                    <span class="pyg-insights-title"><i class="fas fa-wand-magic-sparkles"></i>@T("TesPpto_InsightsTitulo")</span>
                    <div class="pyg-insights-meta" id="tesInsightsMeta">@T("TesPpto_InsightsSub")</div>
                </div>
                <button type="button" id="btnGenerarInsightsTes" class="pyg2-ins-btn"><i class="fas fa-wand-magic-sparkles"></i><span>@T("TesPpto_Generar")</span></button>
            </div>
            <div id="tesInsightsBody"></div>
            <div id="tesInsightsLoading" style="display:none;text-align:center;padding:14px 0;">
                @Html.Partial("_LoaderDots", "dark")
                <p style="margin-top:8px;font-size:12.5px;color:#8B85A0;">@T("TesPpto_Analizando")</p>
            </div>

            <div class="mt-3">
                <label for="tesPregunta" class="mb-1" style="font-weight:700;"><i class="fas fa-comments mr-1"></i>@T("IAInforme_Titulo")</label>
                <div class="d-flex" style="gap:8px;flex-wrap:wrap;">
                    <input type="text" id="tesPregunta" class="form-control" maxlength="@bufinscustomers.Helpers.IAModuloHelper.MaxCharsPregunta()" style="flex:1;min-width:240px;"
                           placeholder="@T("IAInforme_Placeholder")" />
                    <button type="button" id="btnTesPreguntar" class="pyg2-ins-btn"><i class="fas fa-paper-plane"></i><span>@T("IAInforme_Btn")</span></button>
                </div>
                <div id="tesRespuesta" class="mt-2"></div>
            </div>
        </div>
        }
    </div>

</div>
</div>

<div id="overlayConsultandoTes" class="overlay-cargando" style="display:none;">
    <div class="overlay-cargando-card">
        @Html.Partial("_LoaderDots", "aqua")
        <h5 class="overlay-cargando-title">@T("TesPpto_JS_Consultando")</h5>
    </div>
</div>

@Html.Partial("_ExportCorreoModal", new bufinscustomers.Models.ExportCorreoVM())

@section scripts {
<script src="~/Assets/js/select2/select2.min.js"></script>
<script src="~/Assets/js/chart.umd.min.js"></script>
<script src="~/Assets/js/jspdf.umd.min.js"></script>
<script src="~/Assets/js/bufins-pdf-marca.js"></script>
<script src="~/Assets/js/html2canvas.min.js"></script>
<script src="~/Assets/js/export-menu.js"></script>
<script src="~/Assets/js/bufins-markdown.js"></script>
<script src="~/Assets/js/rango-atajos.js"></script>

<script>
    // Textos del botón Exportar estándar (ExportMenu) — ver CLAUDE.md, "Botón Exportar desplegable".
    var EXP_T = {
        generando: '@Html.Raw(J("Common_Exp_Generando"))',
        errorGenerar: '@Html.Raw(J("Common_Exp_ErrorGenerar"))',
        listo: '@Html.Raw(J("Common_Exp_Listo"))',
        imagenCopiada: '@Html.Raw(J("Common_Exp_ImagenCopiada"))',
        imagenDescargada: '@Html.Raw(J("Common_Exp_ImagenDescargada"))',
        valDestino: '@Html.Raw(J("RevisarCargue_Correo_ValDestino"))',
        valMaximo: '@Html.Raw(J("RevisarCargue_Correo_ValMaximo"))',
        enviando: '@Html.Raw(J("RevisarCargue_Correo_Enviando"))',
        error: '@Html.Raw(J("Common_ExpCorreo_Error"))',
        exitoTitulo: '@Html.Raw(J("Modelo_Correo_ExitoTitulo"))',
        aceptar: '@Html.Raw(J("Common_Aceptar"))'
    };

    var _tes = {
        urls: {
            meses: '@Url.Action("ObtenerMeses", "InformeTesoreriaPpto")',
            reporte: '@Url.Action("ConsultarReporte", "InformeTesoreriaPpto")',
            insights: '@Url.Action("GenerarInsightsIA", "InformeTesoreriaPpto")',
            preguntar: '@Url.Action("PreguntarInforme", "InformeTesoreriaPpto")',
            correo: '@Url.Action("EnviarPorCorreo", "InformeTesoreriaPpto")'
        },
        token: $('input[name="__RequestVerificationToken"]').first().val(),
        cultura: '@Html.Raw(HttpUtility.JavaScriptStringEncode(culturaJs))',
        esAdmin: @Html.Raw(esAdmin.ToString().ToLowerInvariant()),
        mesesNombres: [
            '@Html.Raw(J("Common_Mes1"))', '@Html.Raw(J("Common_Mes2"))', '@Html.Raw(J("Common_Mes3"))', '@Html.Raw(J("Common_Mes4"))',
            '@Html.Raw(J("Common_Mes5"))', '@Html.Raw(J("Common_Mes6"))', '@Html.Raw(J("Common_Mes7"))', '@Html.Raw(J("Common_Mes8"))',
            '@Html.Raw(J("Common_Mes9"))', '@Html.Raw(J("Common_Mes10"))', '@Html.Raw(J("Common_Mes11"))', '@Html.Raw(J("Common_Mes12"))'
        ],
        t: {
            kpi: {
                CajaNetaPeriodo: '@Html.Raw(J("TesPpto_Kpi_CajaNetaPeriodo"))',
                CajaAcumFinal: '@Html.Raw(J("TesPpto_Kpi_CajaAcumFinal"))',
                SaldoMinimo: '@Html.Raw(J("TesPpto_Kpi_SaldoMinimo"))',
                MesesDeficit: '@Html.Raw(J("TesPpto_Kpi_MesesDeficit"))',
                DeudaNueva: '@Html.Raw(J("TesPpto_Kpi_DeudaNueva"))'
            },
            casc: {
                CajaBruta: '@Html.Raw(J("TesPpto_Casc_CajaBruta"))',
                GastosOperacionales: '@Html.Raw(J("TesPpto_Casc_GastosOperacionales"))',
                FinancierosOtros: '@Html.Raw(J("TesPpto_Casc_FinancierosOtros"))',
                Impuestos: '@Html.Raw(J("TesPpto_Casc_Impuestos"))',
                Inversiones: '@Html.Raw(J("TesPpto_Casc_Inversiones"))',
                CapitalTrabajo: '@Html.Raw(J("TesPpto_Casc_CapitalTrabajo"))',
                OtrosMovimientos: '@Html.Raw(J("TesPpto_Casc_OtrosMovimientos"))',
                CajaNeta: '@Html.Raw(J("TesPpto_Casc_CajaNeta"))'
            },
            medida: { ppto: '@Html.Raw(J("TesPpto_Medida_ppto"))', proy: '@Html.Raw(J("TesPpto_Medida_proy"))' },
            medidaCorta: { ppto: '@Html.Raw(J("TesPpto_MedidaCorta_ppto"))', proy: '@Html.Raw(J("TesPpto_MedidaCorta_proy"))' },
            cajaNeta: '@Html.Raw(J("TesPpto_CajaNeta"))',
            cajaNetaAcum: '@Html.Raw(J("TesPpto_CajaNetaAcum"))',
            colLinea: '@Html.Raw(J("TesPpto_ColLinea"))',
            colTotal: '@Html.Raw(J("TesPpto_ColTotal"))',
            colSaldoFin: '@Html.Raw(J("TesPpto_ColSaldoFin"))',
            colVarAbs: '@Html.Raw(J("TesPpto_ColVarAbs"))',
            colVarPct: '@Html.Raw(J("TesPpto_ColVarPct"))',
            colVsEscenarioFmt: '@Html.Raw(J("TesPpto_ColVsEscenarioFmt"))',
            estadoOkTitulo: '@Html.Raw(J("TesPpto_EstadoOkTitulo"))',
            estadoOkFmt: '@Html.Raw(J("TesPpto_EstadoOkFmt"))',
