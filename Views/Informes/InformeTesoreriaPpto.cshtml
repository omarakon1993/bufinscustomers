    // El prompt (RESUMEN_TESORERIA_PPTO en GestorPrompts, o el por defecto del controlador) pide 3 líneas con etiquetas fijas
    // "Posición de caja:", "Financiación:" y "Acción recomendada:" (o sus equivalentes en inglés). Se separan por esas palabras
    // clave al inicio de línea (tolerando viñetas, encabezados markdown y negritas). Si falta alguna, null → markdown completo.
    function separarInsights(texto) {
        var claves = { posicion: /^(posici[oó]n|cash position)/i, financiacion: /^(financiaci[oó]n|funding)/i, accion: /^(acci[oó]n|recommended action)/i };
        var etiqueta = /^(\*\*|__)?\s*(posici[oó]n|financiaci[oó]n|acci[oó]n|cash position|funding|recommended action)[^:]*:\s*(\*\*|__)?\s*/i;
        var partes = { posicion: [], financiacion: [], accion: [] }, actual = null;
        (texto || '').split(/\r?\n/).forEach(function (linea) {
            var conFormato = linea.replace(/^\s*(?:[-•>#]+|\*(?=\s)|\d+[.)])\s*/, '').trim();
            var plano = conFormato.replace(/\*\*|__/g, '').trim();
            if (!plano) return;
            var encontrada = null;
            Object.keys(claves).forEach(function (k) { if (!encontrada && claves[k].test(plano)) encontrada = k; });
            if (encontrada) {
                actual = encontrada;
                var resto = plano.indexOf(':') >= 0 ? conFormato.replace(etiqueta, '').trim() : '';
                if (resto) partes[actual].push(resto);
                return;
            }
            if (actual) partes[actual].push(conFormato);
        });
        if (!partes.posicion.length || !partes.financiacion.length || !partes.accion.length) return null;
        return { posicion: partes.posicion.join(' '), financiacion: partes.financiacion.join(' '), accion: partes.accion.join(' ') };
    }
    function textoConNegritas(t) {
        return escHtml(t).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/__(.+?)__/g, '<strong>$1</strong>').replace(/\*\*|__/g, '');
    }
    function pintarInsights(texto) {
        var t = _tes.t, secciones = separarInsights(texto);
        if (!secciones) {
            var md = (typeof window.bufinsMarkdown === 'function') ? window.bufinsMarkdown(texto) : escHtml(texto).replace(/\n/g, '<br>');
            $('#tesInsightsBody').html('<div class="pyg-insights-body">' + md + '</div>');
            return;
        }
        // Clases de color de las tarjetas (compartidas con PYG): eficiencia = info, alerta = rojo, logro = verde.
        var tiles = [
            { cls: 'eficiencia', icono: 'fa-vault', titulo: t.posicion, texto: secciones.posicion },
            { cls: 'alerta', icono: 'fa-hand-holding-dollar', titulo: t.financiacion, texto: secciones.financiacion },
            { cls: 'logro', icono: 'fa-bullseye', titulo: t.accion, texto: secciones.accion }
        ];
        $('#tesInsightsBody').html('<div class="pyg2-ins-grid">' + tiles.map(function (x) {
            return '<div class="pyg2-ins-tile ' + x.cls + '"><div class="h"><span class="ic"><i class="fas ' + x.icono + '"></i></span><span class="t">' + escHtml(x.titulo) + '</span></div><p>' + textoConNegritas(x.texto) + '</p></div>';
        }).join('') + '</div>');
    }
