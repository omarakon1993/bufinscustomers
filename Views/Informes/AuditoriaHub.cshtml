@{
    ViewBag.Title = Resources.Strings.AudHub_PageTitle;
    var esNormal = (bool)(ViewBag.EsUsuarioNormal ?? false);
}

<link href="~/Assets/css/bufins-components.css" rel="stylesheet" />
<link href="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/css/cargues-modulo.css")" rel="stylesheet" />



<div class="container-fluid px-4">

    <div class="powerbi-header">
        <div class="powerbi-header-content">
            <i class="fas fa-shield-alt powerbi-header-icon"></i>
            <h1 class="powerbi-header-title">@Resources.Strings.AudHub_HeaderTitle</h1>
        </div>
    </div>

    @* Mismas pestañas que «Historial de cargues» (Versiones | Registro): componente .cg-tab de cargues-modulo.css.
       Aquí el contenido se carga en la misma página, así que el marcador lo desliza el script (.cg-tabs-js). *@
    <nav class="cg-tabs cg-tabs-js" id="audhubTabs" aria-label="@Resources.Strings.AudHub_HeaderTitle">
        <span class="cg-tab-marca no-anim" aria-hidden="true"></span>
        <button type="button" class="cg-tab is-active" data-key="cambios"
                data-intro="@Resources.Strings.AudHub_IntroCambios"
                data-url="@Url.Action("Index", "Auditoria", new { embed = 1 })">
            <span class="cg-tab-ic"><i class="fas fa-edit"></i></span>
            <span class="cg-tab-tx"><span class="cg-tab-t">@Resources.Strings.AudHub_TabCambios</span><span class="cg-tab-s">@Resources.Strings.AudHub_SubCambios</span></span>
        </button>
        @if (!esNormal)
        {
            <button type="button" class="cg-tab" data-key="navegacion"
                    data-intro="@Resources.Strings.AudHub_IntroNavegacion"
                    data-url="@Url.Action("Index", "InformeNavegacion", new { embed = 1 })">
                <span class="cg-tab-ic"><i class="fas fa-route"></i></span>
                <span class="cg-tab-tx"><span class="cg-tab-t">@Resources.Strings.AudHub_TabNavegacion</span><span class="cg-tab-s">@Resources.Strings.AudHub_SubNavegacion</span></span>
            </button>
            if (bufinscustomers.Helpers.UsuarioSesionHelper.EsSuperAdmin())
            {
                var nombrePortal = bufinscustomers.Services.PortalPublicoConfig.Nombre();
                <button type="button" class="cg-tab" data-key="portal"
                        data-intro="@string.Format(Resources.Strings.AudHub_IntroPortal, nombrePortal)"
                        data-url="@Url.Action("Index", "AuditoriaPortal", new { embed = 1 })">
                    <span class="cg-tab-ic"><i class="fas fa-globe-americas"></i></span>
                    <span class="cg-tab-tx"><span class="cg-tab-t">@nombrePortal</span><span class="cg-tab-s">@Resources.Strings.AudHub_SubPortal</span></span>
                </button>
            }
            <button type="button" class="cg-tab" data-key="ia"
                    data-intro="@Resources.Strings.AudHub_IntroIA"
                    data-url="@Url.Action("Index", "AuditoriaConsultasIA", new { embed = 1 })">
                <span class="cg-tab-ic"><i class="fas fa-robot"></i></span>
                <span class="cg-tab-tx"><span class="cg-tab-t">@Resources.Strings.AudHub_TabIA</span><span class="cg-tab-s">@Resources.Strings.AudHub_SubIA</span></span>
            </button>
        }
    </nav>

    <p class="cg-intro"><i class="fas fa-info-circle"></i><span id="audhubIntro"></span></p>

    <div class="cg-panel-wrap">
        <div id="audhubPanel" class="cg-panel"></div>
        <div class="cg-spin" id="audhubSpin"><span class="s"></span></div>
    </div>

</div>

@section scripts {
<script src="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/js/cg-tabs-panel.js")"></script>
<script>
$(function () {
    CgTabs.init({
        nav: '#audhubTabs', panel: '#audhubPanel', spin: '#audhubSpin', intro: '#audhubIntro',
        storageKey: 'bufins_audhub_tab',
        error: '<div class="cg-panel-error">@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Audit_JS_Error))</div>'
    });
});
</script>
}
