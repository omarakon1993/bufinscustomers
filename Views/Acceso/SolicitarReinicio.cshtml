@{
    Layout = "~/Views/Acceso/_Layout2FA.cshtml";
    ViewBag.Heading = Resources.Strings.SolSeg_Titulo;
    ViewBag.PageTitle = Resources.Strings.SolSeg_Titulo;
    bool enviada = ViewBag.Enviada == true;
    bool existente = ViewBag.Existente == true;
    var panel = new bufinscustomers.Models.AccesoPanelVM
    {
        Eyebrow = Resources.Strings.Acc_Eyebrow_Soporte,
        PieUsuario = true,
        CorreoEnmascarado = ViewBag.CorreoEnmascarado as string,
        Pasos = new System.Collections.Generic.List<bufinscustomers.Models.AccesoPasoVM>
        {
            new bufinscustomers.Models.AccesoPasoVM(Resources.Strings.Acc_Paso_EnviarSolicitud, enviada ? "done" : "active"),
            new bufinscustomers.Models.AccesoPasoVM(Resources.Strings.Acc_Paso_ValidacionIdentidad, enviada ? "active" : "todo", enviada ? Resources.Strings.Acc_Sub_TeContactaremos : null),
            new bufinscustomers.Models.AccesoPasoVM(Resources.Strings.Acc_Paso_ReinicioMetodos, "todo")
        }
    };
}

@section Panel { @Html.Partial("_AccesoPanel", panel) }

@if (enviada)
{
    <div class="acc-state">
        <div class="acc-state-icon acc-state-icon--info"><i class="fas fa-paper-plane"></i></div>
        <h1>@(existente ? Resources.Strings.SolSeg_YaPendiente : Resources.Strings.SolSeg_Enviada)</h1>
        <p>@Resources.Strings.SolSeg_EnviadaMsg</p>
    </div>
    <a href="@Url.Action("Login","Acceso")" class="btn btn-primary">
        <i class="fas fa-arrow-left"></i>
        <span class="btn-text">@Resources.Strings.Login2FA_Volver</span>
    </a>
}
else
{
    <h1 class="acc-title">@Resources.Strings.SolSeg_Titulo</h1>
    <p class="acc-desc">@Resources.Strings.SolSeg_Intro</p>

    <form id="tfForm" action="@Url.Action("SolicitarReinicio","Acceso")" method="post">
        @Html.AntiForgeryToken()

        <div class="input-group">
            <div class="input-icon"><i class="fas fa-phone"></i></div>
            <div class="input-wrapper">
                <label for="telefono">@Resources.Strings.SolSeg_Telefono</label>
                <input type="text" name="telefono" id="telefono" class="input-field" maxlength="40" autocomplete="tel" placeholder="+57 300 000 0000" />
            </div>
        </div>

        <div class="input-group">
            <div class="input-icon"><i class="fas fa-comment-dots"></i></div>
            <div class="input-wrapper">
                <label for="mensaje">@Resources.Strings.SolSeg_Mensaje</label>
                <input type="text" name="mensaje" id="mensaje" class="input-field" maxlength="500" placeholder="@Resources.Strings.SolSeg_MensajePH" />
            </div>
        </div>

        <button type="submit" id="btnEnviar" class="btn btn-primary" style="margin-top:18px;">
            <span class="btn-text">@Resources.Strings.SolSeg_BtnEnviar</span>
            <i class="fas fa-paper-plane"></i>
        </button>
    </form>
}

@section FooterLeft {
    @if (!enviada)
    {
        <a class="acc-link" href="@Url.Action("VerificarDobleFactor","Acceso")"><i class="fas fa-arrow-left"></i>@Resources.Strings.SolSeg_VolverVerificar</a>
    }
}

@section scripts {
    <script>
        (function () {
            var f = document.getElementById('tfForm');
            if (f) f.addEventListener('submit', function () { document.getElementById('btnEnviar').classList.add('loading'); });
        })();
    </script>
}
