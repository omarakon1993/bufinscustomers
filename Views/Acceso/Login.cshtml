@{
    Layout = null;
    var _isEnglish = System.Threading.Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName == "en";
    var panel = new bufinscustomers.Models.AccesoPanelVM
    {
        Eyebrow = Resources.Strings.Acc_Eyebrow_Login,
        PieUsuario = false,
        Pasos = new System.Collections.Generic.List<bufinscustomers.Models.AccesoPasoVM>
        {
            new bufinscustomers.Models.AccesoPasoVM(Resources.Strings.Acc_Paso_Credenciales, "active"),
            new bufinscustomers.Models.AccesoPasoVM(Resources.Strings.Acc_Paso_Verificacion, "todo"),
            new bufinscustomers.Models.AccesoPasoVM(Resources.Strings.Acc_Paso_AccesoBufins, "todo")
        }
    };
}

<!DOCTYPE html>

<html lang="@(_isEnglish ? "en" : "es")">
<head>
    <title>BUFINS - Login</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico?v=2">
    <link rel="stylesheet" type="text/css" href="~/Assets/css/style.css">
    <link rel="stylesheet" type="text/css" href="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/css/acceso.css")">
    <link href="~/Assets/GoogleApis/Poppins.css" rel="stylesheet">
    <link rel="stylesheet" href="~/Assets/Bootstrap/fontawesome-free/css/all.min.css">
    <script src="~/Assets/js/sweetalert2.all.min.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body>
    <style type="text/css">
        input:-webkit-autofill {
            background-color: rgba(255, 255, 255, 0.1) !important;
            -webkit-box-shadow: 0 0 0px 1000px rgba(255, 255, 255, 0.1) inset !important;
            -webkit-text-fill-color: #333 !important;
        }
    </style>

    <div class="background-overlay"></div>

    <div class="container">
        <div class="acc-card">
            @Html.Partial("_AccesoPanel", panel)

            <div class="acc-main">
                @Html.Partial("_AccesoHeader")

                <div class="acc-body">
                    <h1 class="acc-title">@Resources.Strings.Acc_Login_Titulo</h1>
                    <p class="acc-desc">@Resources.Strings.Acc_Login_Desc</p>

                    <form id="loginForm" action="@Url.Action("Login", "Acceso")" method="post">
                        @Html.AntiForgeryToken()

                        <div class="input-group">
                            <div class="input-icon">
                                <i class="fas fa-user"></i>
                            </div>
                            <div class="input-wrapper">
                                <label for="Correo">@Resources.Strings.Login_EmailLabel</label>
                                <input type="text" name="Correo" class="input-field" id="Correo" placeholder="@Resources.Strings.Login_EmailPlaceholder" />
                            </div>
                        </div>

                        <div class="input-group">
                            <div class="input-icon">
                                <i class="fas fa-lock"></i>
                            </div>
                            <div class="input-wrapper">
                                <label for="Clave">@Resources.Strings.Login_PasswordLabel</label>
                                <input type="password" name="Clave" class="input-field" id="Clave" placeholder="@Resources.Strings.Login_PasswordPlaceholder">
                                <button type="button" class="pwd-toggle" onclick="Acceso.togglePwd('Clave', this)" tabindex="-1"><i class="fas fa-eye"></i></button>
                            </div>
                        </div>

                        <div class="acc-forgot">
                            <a href="@Url.Action("SolicitarReset","Acceso")"><i class="fas fa-key"></i>@Resources.Strings.Login_ForgotPassword</a>
                        </div>

                        <button type="submit" id="btnLogin" class="btn btn-primary">
                            <span>@Resources.Strings.Acc_BtnIniciarSesion</span>
                            <i class="fas fa-arrow-right"></i>
                        </button>
                    </form>
                </div>

                <div class="acc-footer">
                    <div class="acc-copy">ORION WEB - @DateTime.Now.Year</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        var _loginMsg = {
            errorEmail: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Login_ErrorEmail))',
            errorPassword: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Login_ErrorPassword))'
        };

        function toastLogin(icon, title, timer) {
            Swal.fire({
                toast: true,
                position: window.innerWidth <= 768 ? 'top' : 'top-end',
                icon: icon,
                title: title,
                showConfirmButton: false,
                timer: timer,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer);
                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                }
            });
        }

        function validarFormulario() {
            const correo = document.getElementById("Correo").value;
            const clave = document.getElementById("Clave").value;

            if (!correo) { toastLogin('info', _loginMsg.errorEmail, 3000); return; }
            if (!clave) { toastLogin('info', _loginMsg.errorPassword, 3000); return; }

            document.getElementById("btnLogin").classList.add('loading');
            document.getElementById("loginForm").submit();
        }

        // Botón y Enter pasan por la misma validación
        document.getElementById("loginForm").addEventListener('submit', function (e) {
            if (!document.getElementById("btnLogin").classList.contains('loading')) { e.preventDefault(); validarFormulario(); }
        });
    </script>

    @if (ViewData["Mensaje"] != null)
    {
        <script>
            toastLogin('warning', '@ViewData["Mensaje"]', 7000);
        </script>
    }

    <script type="text/javascript" src="~/Assets/js/main.js"></script>
    <script src="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/js/acceso.js")"></script>
</body>
</html>
