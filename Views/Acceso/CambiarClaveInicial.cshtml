@{
    Layout = "~/Views/Acceso/_Layout2FA.cshtml";
    ViewBag.ErrorEnLinea = true;
    ViewBag.PageTitle = Resources.Strings.CambioClaveInicial_PageTitle;
    var panel = new bufinscustomers.Models.AccesoPanelVM
    {
        Eyebrow = Resources.Strings.Acc_Eyebrow_PrimerIngreso,
        PieUsuario = true,
        CorreoEnmascarado = ViewBag.CorreoEnmascarado as string,
        UrlCambiarCuenta = Url.Action("CerrarSesion", "Acceso"),
        Pasos = new System.Collections.Generic.List<bufinscustomers.Models.AccesoPasoVM>
        {
            new bufinscustomers.Models.AccesoPasoVM(Resources.Strings.Acc_Paso_Credenciales, "done"),
            new bufinscustomers.Models.AccesoPasoVM(Resources.Strings.Acc_Paso_NuevaClave, "active"),
            new bufinscustomers.Models.AccesoPasoVM(Resources.Strings.Acc_Paso_AccesoBufins, "todo")
        }
    };
}

@section Panel { @Html.Partial("_AccesoPanel", panel) }

<h1 class="acc-title">@Resources.Strings.CambioClaveInicial_Heading</h1>
<p class="acc-desc">@Resources.Strings.CambioClaveInicial_Instrucciones</p>

<form id="cambioForm" action="@Url.Action("CambiarClaveInicial","Acceso")" method="post">
    @Html.AntiForgeryToken()
    @Html.Partial("_AccesoErrores")

    @Html.Partial("_AccesoClaveCampos")

    <button type="button" id="btnCambiar" class="btn btn-primary" style="margin-top:18px;" onclick="cambiarClave()">
        <span class="btn-text">@Resources.Strings.Acc_BtnCambiarClave</span>
        <i class="fas fa-check"></i>
    </button>
</form>

@section FooterLeft {
    <a class="acc-link" href="@Url.Action("CerrarSesion","Acceso")"><i class="fas fa-sign-out-alt"></i>@Resources.Strings.CambioClaveInicial_CerrarSesion</a>
}

@section scripts {
    <script>
        var _rMsg = {
            errorEmpty: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Reset_NewPwd_ErrorEmpty))',
            errorLen:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Reset_NewPwd_ErrorLen))',
            errorMatch: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Reset_NewPwd_ErrorMatch))'
        };

        function cambiarClave() {
            var nueva = document.getElementById('nuevaClave').value;
            var confirmar = document.getElementById('confirmarClave').value;
            var msg = null;
            if (!nueva) msg = _rMsg.errorEmpty;
            else if (nueva.length < 12) msg = _rMsg.errorLen;
            else if (nueva !== confirmar) msg = _rMsg.errorMatch;
            if (msg) { aviso('info', msg); return; }
            document.getElementById('btnCambiar').classList.add('loading');
            document.getElementById('cambioForm').submit();
        }
        document.getElementById('cambioForm').addEventListener('submit', function (e) {
            if (!document.getElementById('btnCambiar').classList.contains('loading')) { e.preventDefault(); cambiarClave(); }
        });
    </script>
}
