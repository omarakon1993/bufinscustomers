@{
    Layout = null;
    var _isEnglish = System.Threading.Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName == "en";
    string _tituloPagina = (ViewBag.PageTitle as string) ?? Resources.Strings.Login2FA_PageTitle;
}
<!DOCTYPE html>
<html lang="@(_isEnglish ? "en" : "es")">
<head>
    <title>@_tituloPagina &mdash; BUFINS</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico?v=2">
    <link rel="stylesheet" type="text/css" href="~/Assets/css/style.css">
    <link rel="stylesheet" type="text/css" href="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/css/acceso.css")">
    <link href="~/Assets/GoogleApis/Poppins.css" rel="stylesheet">
    <link rel="stylesheet" href="~/Assets/Bootstrap/fontawesome-free/css/all.min.css">
    <script src="~/Assets/js/sweetalert2.all.min.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body>
    <div class="background-overlay"></div>

    <div class="container">
        <div class="acc-card@(ViewBag.Ancha == true ? " acc-card--ancha" : "")">
            @RenderSection("Panel", required: false)

            <div class="acc-main">
                @Html.Partial("_AccesoHeader")

                <div class="acc-body">
                    @RenderBody()
                </div>

                <div class="acc-footer">
                    @RenderSection("FooterLeft", required: false)
                    <div class="acc-copy">ORION WEB - @DateTime.Now.Year</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function aviso(icon, msg) {
            Swal.fire({ toast:true, position: window.innerWidth <= 768 ? 'top' : 'top-end', icon: icon, title: msg, showConfirmButton:false, timer:5000, timerProgressBar:true });
        }
    </script>
    @if (ViewData["Error"] != null && ViewBag.ErrorEnLinea != true)
    {
        <script>aviso('warning', '@Html.Raw(HttpUtility.JavaScriptStringEncode(ViewData["Error"].ToString()))');</script>
    }
    <script type="text/javascript" src="~/Assets/js/main.js"></script>
    <script src="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/js/acceso.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
