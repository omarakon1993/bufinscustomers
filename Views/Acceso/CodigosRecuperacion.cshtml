@{
    Layout = "~/Views/Acceso/_Layout2FA.cshtml";
    ViewBag.Heading = Resources.Strings.Login2FA_CodigosHeading;
    var codigos = (System.Collections.Generic.List<string>)ViewBag.Codigos;
}

<form id="tfForm" action="@Url.Action("CodigosRecuperacionContinuar","Acceso")" method="post">
    @Html.AntiForgeryToken()

    <p class="tf-info">
        <i class="fas fa-key"></i>@Resources.Strings.Login2FA_CodigosInstrucciones
    </p>

    <div class="tf-codes" id="tfCodes">
        @foreach (var c in codigos)
        {
            <span>@c</span>
        }
    </div>

    <div class="tf-actions">
        <button type="button" class="tf-link" id="btnCopiar"><i class="fas fa-copy" style="margin-right:5px;"></i>@Resources.Strings.Login2FA_BtnCopiar</button>
        <button type="button" class="tf-link" id="btnDescargar"><i class="fas fa-download" style="margin-right:5px;"></i>@Resources.Strings.Login2FA_BtnDescargar</button>
    </div>

    <label class="tf-check">
        <input type="checkbox" id="chkGuardados" />
        <span>@Resources.Strings.Login2FA_CodigosConfirmar</span>
    </label>

    <button type="submit" id="btnContinuar" class="btn btn-primary" disabled>
        <span class="btn-text">@Resources.Strings.Login2FA_BtnContinuar</span>
        <i class="fas fa-arrow-right" style="margin-left:8px;"></i>
    </button>
</form>

@section scripts {
    <script>
        (function () {
            var chk = document.getElementById('chkGuardados'), btn = document.getElementById('btnContinuar');
            chk.addEventListener('change', function () { btn.disabled = !chk.checked; });
            function texto() {
                return Array.prototype.map.call(document.querySelectorAll('#tfCodes span'), function (s) { return s.textContent; }).join('\n');
            }
            document.getElementById('btnCopiar').addEventListener('click', function () {
                var t = texto();
                if (navigator.clipboard) navigator.clipboard.writeText(t).then(function () { aviso('success', '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Login2FA_Copiado))'); });
            });
            document.getElementById('btnDescargar').addEventListener('click', function () {
                var blob = new Blob(['BUFINS - ' + '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Login2FA_CodigosHeading))' + '\n\n' + texto() + '\n'], { type: 'text/plain' });
                var a = document.createElement('a');
                a.href = URL.createObjectURL(blob); a.download = 'Bufins_codigos_recuperacion.txt';
                document.body.appendChild(a); a.click(); document.body.removeChild(a);
            });
            document.getElementById('tfForm').addEventListener('submit', function () { btn.classList.add('loading'); });
        })();
    </script>
}
