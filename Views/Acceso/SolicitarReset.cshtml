@{
    Layout = "~/Views/Acceso/_Layout2FA.cshtml";
    ViewBag.PageTitle = Resources.Strings.Reset_PageTitle;
    bool _enviado = ViewData["Enviado"] != null && (bool)ViewData["Enviado"];
    var panel = new bufinscustomers.Models.AccesoPanelVM
    {
        Eyebrow = Resources.Strings.Acc_Eyebrow_Recuperar,
        PieUsuario = false,
        Pasos = new System.Collections.Generic.List<bufinscustomers.Models.AccesoPasoVM>
        {
            new bufinscustomers.Models.AccesoPasoVM(Resources.Strings.Acc_Paso_TuCorreo, _enviado ? "done" : "active"),
            new bufinscustomers.Models.AccesoPasoVM(Resources.Strings.Acc_Paso_EnlaceCorreo, _enviado ? "active" : "todo", _enviado ? Resources.Strings.Acc_Sub_RevisaBandeja : null),
            new bufinscustomers.Models.AccesoPasoVM(Resources.Strings.Acc_Paso_NuevaClave, "todo")
        }
    };
}

@section Panel { @Html.Partial("_AccesoPanel", panel) }

@if (_enviado)
{
    <div class="acc-state">
        <div class="acc-state-icon acc-state-icon--info"><i class="fas fa-envelope-open-text"></i></div>
        <h1>@Resources.Strings.Reset_Enviado_Titulo</h1>
        <p>@Resources.Strings.Reset_Enviado_Msg</p>
    </div>
    <a href="@Url.Action("Login","Acceso")" class="btn btn-primary">
        <i class="fas fa-arrow-left"></i>
        <span>@Resources.Strings.Reset_BtnVolver</span>
    </a>
}
else
{
    <h1 class="acc-title">@Resources.Strings.Acc_Reset_Titulo</h1>
    <p class="acc-desc">@Resources.Strings.Reset_Instrucciones</p>

    <form id="resetForm" action="@Url.Action("SolicitarReset","Acceso")" method="post">
        @Html.AntiForgeryToken()

        <div class="input-group">
            <div class="input-icon"><i class="fas fa-envelope"></i></div>
            <div class="input-wrapper">
                <label for="correo">@Resources.Strings.Reset_EmailLabel</label>
                <input type="email" name="correo" id="correo" class="input-field"
                       placeholder="@Resources.Strings.Reset_EmailPlaceholder"
                       value="@ViewData["CorreoIngresado"]"
                       autocomplete="email" />
            </div>
        </div>

        <button type="button" id="btnEnviar" class="btn btn-primary" style="margin-top:18px;" onclick="enviarReset()">
            <span class="btn-text">@Resources.Strings.Acc_EnviarEnlace</span>
            <i class="fas fa-paper-plane"></i>
        </button>
    </form>
}

@section FooterLeft {
    @if (!_enviado)
    {
        <a class="acc-link" href="@Url.Action("Login","Acceso")"><i class="fas fa-arrow-left"></i>@Resources.Strings.Reset_BtnVolver</a>
    }
}

@section scripts {
    @if (!_enviado)
    {
        <script>
            var _resetMsg = { errorEmail: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Reset_ErrorEmail))' };

            function enviarReset() {
                var correo = document.getElementById('correo').value.trim();
                var emailRx = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                if (!correo || !emailRx.test(correo)) { aviso('info', _resetMsg.errorEmail); return; }
                document.getElementById('btnEnviar').classList.add('loading');
                document.getElementById('resetForm').submit();
            }
            document.getElementById('resetForm').addEventListener('submit', function (e) {
                // Enter dentro del campo: pasa por la misma validación
                if (!document.getElementById('btnEnviar').classList.contains('loading')) { e.preventDefault(); enviarReset(); }
            });
        </script>
    }
}
