@{
    Layout = "~/Views/Acceso/_Layout2FA.cshtml";
    ViewBag.Heading = Resources.Strings.Login2FA_ConfigHeading;
    ViewBag.Ancha = true;
}

<form id="tfForm" action="@Url.Action("ConfigurarDobleFactor","Acceso")" method="post">
    @Html.AntiForgeryToken()

    <div class="tf-grid">
        <div>
            <div class="tf-qr" id="tfQr" data-uri="@ViewBag.UriOtp"></div>
            <p class="tf-info" style="margin-bottom:.3rem; font-size:.74rem; text-align:center;">@Resources.Strings.Login2FA_ConfigClaveManual</p>
            <div class="tf-secret" style="font-size:.78rem;">@ViewBag.SecretoBase32</div>
        </div>

        <div>
            <p class="tf-info"><i class="fas fa-lock"></i>@Resources.Strings.Login2FA_ConfigAviso</p>

            <ol class="tf-steps" style="margin-bottom:.8rem;">
                <li>@Resources.Strings.Login2FA_ConfigPaso1</li>
                <li>@Resources.Strings.Login2FA_ConfigPaso2</li>
                <li>@Resources.Strings.Login2FA_ConfigPaso3</li>
            </ol>

            <div class="input-group">
                <div class="input-icon"><i class="fas fa-shield-alt"></i></div>
                <div class="input-wrapper">
                    <label for="codigo">@Resources.Strings.Login2FA_CodigoLabel</label>
                    <input type="text" name="codigo" id="codigo" class="input-field tf-code" maxlength="7"
                           placeholder="000000" autocomplete="one-time-code" inputmode="numeric" spellcheck="false" autofocus />
                </div>
            </div>

            <button type="submit" id="btnVerificar" class="btn btn-primary">
                <span class="btn-text">@Resources.Strings.Login2FA_BtnActivar</span>
                <i class="fas fa-check" style="margin-left:8px;"></i>
            </button>

            <div style="text-align:center; margin-top:.7rem;">
                <a href="@Url.Action("Login","Acceso")" style="color:#583AFF; font-size:.8rem; text-decoration:none;">
                    <i class="fas fa-arrow-left" style="margin-right:4px;"></i>@Resources.Strings.Login2FA_Volver
                </a>
            </div>
        </div>
    </div>
</form>

@section scripts {
    <script src="~/Assets/js/qrcode-generator.js"></script>
    <script>
        (function () {
            var el = document.getElementById('tfQr');
            try {
                var qr = qrcode(0, 'M');
                qr.addData(el.getAttribute('data-uri'));
                qr.make();
                el.innerHTML = qr.createImgTag(5, 4);
            } catch (e) { /* si falla, queda la clave manual */ }
        })();
        document.getElementById('tfForm').addEventListener('submit', function (e) {
            var v = document.getElementById('codigo').value.replace(/\s/g, '');
            if (!/^\d{6}$/.test(v)) { e.preventDefault(); aviso('info', '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Login2FA_ErrorVacio))'); return; }
            document.getElementById('btnVerificar').classList.add('loading');
        });
    </script>
}
