@{
    Layout = "~/Views/Acceso/_Layout2FA.cshtml";
    ViewBag.Heading = Resources.Strings.Login2FA_ConfigHeading;
    ViewBag.PageTitle = Resources.Strings.Login2FA_PageTitle;
    ViewBag.Ancha = true;
    bool requiereClave = ViewBag.RequiereCambioClave == true;
    var pasos = new System.Collections.Generic.List<bufinscustomers.Models.AccesoPasoVM>
    {
        new bufinscustomers.Models.AccesoPasoVM(Resources.Strings.Acc_Paso_DobleFactor, "active"),
        new bufinscustomers.Models.AccesoPasoVM(Resources.Strings.Acc_Paso_Passkey, "todo", Resources.Strings.Acc_Sub_Opcional),
        new bufinscustomers.Models.AccesoPasoVM(requiereClave ? Resources.Strings.Acc_Paso_NuevaClave : Resources.Strings.Acc_Paso_AccesoBufins, "todo")
    };
    var panel = new bufinscustomers.Models.AccesoPanelVM
    {
        Eyebrow = requiereClave ? Resources.Strings.Acc_Eyebrow_PrimerIngreso : Resources.Strings.Acc_Eyebrow_ConfigVerif,
        PieUsuario = true,
        CorreoEnmascarado = ViewBag.CorreoEnmascarado as string,
        Pasos = pasos
    };
}

@section Panel { @Html.Partial("_AccesoPanel", panel) }

<h1 class="acc-title">@Resources.Strings.Login2FA_ConfigHeading</h1>
<p class="acc-desc">@Resources.Strings.Login2FA_ConfigAviso</p>

<form id="tfForm" action="@Url.Action("ConfigurarDobleFactor","Acceso")" method="post">
    @Html.AntiForgeryToken()

    <div class="acc-2fa-grid">
        <div>
            <div class="acc-qr" id="tfQr" data-uri="@ViewBag.UriOtp"></div>
            <p class="acc-qr-hint">@Resources.Strings.Login2FA_ConfigClaveManual</p>
            <div class="acc-secret">@ViewBag.SecretoBase32</div>
        </div>

        <div>
            <ol class="acc-steps">
                <li><span>1</span>@Resources.Strings.Login2FA_ConfigPaso1</li>
                <li><span>2</span>@Resources.Strings.Login2FA_ConfigPaso2</li>
                <li><span>3</span>@Resources.Strings.Login2FA_ConfigPaso3</li>
            </ol>

            @Html.Partial("_AccesoOtp")

            <button type="submit" id="btnVerificar" class="btn btn-primary acc-off">
                <span class="btn-text">@Resources.Strings.Login2FA_BtnActivar</span>
                <i class="fas fa-check"></i>
            </button>
        </div>
    </div>
</form>

@section FooterLeft {
    <a class="acc-link" href="@Url.Action("Login","Acceso")"><i class="fas fa-arrow-left"></i>@Resources.Strings.Login2FA_Volver</a>
}

@section scripts {
    <script src="~/Assets/js/qrcode-generator.js"></script>
    <script>
        (function () {
            var el = document.getElementById('tfQr');
            try {
                var qr = qrcode(0, 'M');
                qr.addData(el.getAttribute('data-uri'));
                qr.make();
                el.innerHTML = qr.createImgTag(5, 4);
            } catch (e) { /* si falla, queda la clave manual */ }
            var btn = document.getElementById('btnVerificar');
            Acceso.otp({ onCambio: function (v) { btn.classList.toggle('acc-off', v.length !== 6); } });
        })();
        document.getElementById('tfForm').addEventListener('submit', function (e) {
            var v = document.getElementById('codigo').value.replace(/\s/g, '');
            if (!/^\d{6}$/.test(v)) { e.preventDefault(); aviso('info', '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Login2FA_ErrorVacio))'); return; }
            document.getElementById('btnVerificar').classList.add('loading');
        });
    </script>
}
