@{
    Layout = "~/Views/Acceso/_Layout2FA.cshtml";
    ViewBag.ErrorEnLinea = true;
    ViewBag.PageTitle = Resources.Strings.Reset_NewPwd_PageTitle;
    bool _tokenInvalido = ViewData["TokenInvalido"] != null && (bool)ViewData["TokenInvalido"];
    bool _exito         = ViewData["Exito"]         != null && (bool)ViewData["Exito"];
    string _token       = ViewData["Token"] as string ?? "";
    var panel = new bufinscustomers.Models.AccesoPanelVM
    {
        Eyebrow = Resources.Strings.Acc_Eyebrow_Recuperar,
        PieUsuario = false,
        Pasos = new System.Collections.Generic.List<bufinscustomers.Models.AccesoPasoVM>
        {
            new bufinscustomers.Models.AccesoPasoVM(Resources.Strings.Acc_Paso_TuCorreo, "done"),
            _tokenInvalido
                ? new bufinscustomers.Models.AccesoPasoVM(Resources.Strings.Acc_Paso_EnlaceCorreo, "error", Resources.Strings.Acc_Sub_EnlaceVencido)
                : new bufinscustomers.Models.AccesoPasoVM(Resources.Strings.Acc_Paso_EnlaceCorreo, "done"),
            new bufinscustomers.Models.AccesoPasoVM(Resources.Strings.Acc_Paso_NuevaClave, _exito ? "done" : (_tokenInvalido ? "todo" : "active"))
        }
    };
}

@section Panel { @Html.Partial("_AccesoPanel", panel) }

@if (_exito)
{
    <div class="acc-state">
        <div class="acc-state-icon acc-state-icon--success"><i class="fas fa-check"></i></div>
        <h1>@Resources.Strings.Reset_NewPwd_Exito</h1>
    </div>
    <a href="@Url.Action("Login","Acceso")" class="btn btn-primary">
        <i class="fas fa-sign-in-alt"></i>
        <span>@Resources.Strings.Acc_BtnIniciarSesion</span>
    </a>
}
else if (_tokenInvalido)
{
    <div class="acc-state">
        <div class="acc-state-icon acc-state-icon--error"><i class="fas fa-times"></i></div>
        <h1>@Resources.Strings.Reset_NewPwd_TokenInvalido</h1>
        <p>@Resources.Strings.Reset_NewPwd_TokenExpirado</p>
    </div>
    <a href="@Url.Action("SolicitarReset","Acceso")" class="btn btn-primary">
        <i class="fas fa-redo"></i>
        <span>@Resources.Strings.Reset_NewPwd_BtnSolicitarNuevo</span>
    </a>
}
else
{
    <h1 class="acc-title">@Resources.Strings.Acc_NuevaClave_Titulo</h1>
    <p class="acc-desc">@Resources.Strings.Reset_NewPwd_Instrucciones</p>

    <form id="restablecerForm" action="@Url.Action("RestablecerClave","Acceso")" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="token" value="@_token" />
        @Html.Partial("_AccesoErrores")

        @Html.Partial("_AccesoClaveCampos")

        <button type="button" id="btnCambiar" class="btn btn-primary" style="margin-top:18px;" onclick="cambiarClave()">
            <span class="btn-text">@Resources.Strings.Acc_BtnCambiarClave</span>
            <i class="fas fa-check"></i>
        </button>
    </form>
}

@section FooterLeft {
    @if (!_exito && !_tokenInvalido)
    {
        <a class="acc-link" href="@Url.Action("Login","Acceso")"><i class="fas fa-arrow-left"></i>@Resources.Strings.Reset_BtnVolver</a>
    }
}

@section scripts {
    @if (!_exito && !_tokenInvalido)
    {
        <script>
            var _rMsg = {
                errorEmpty: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Reset_NewPwd_ErrorEmpty))',
                errorLen:   '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Reset_NewPwd_ErrorLen))',
                errorMatch: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Reset_NewPwd_ErrorMatch))'
            };

            function cambiarClave() {
                var nueva     = document.getElementById('nuevaClave').value;
                var confirmar = document.getElementById('confirmarClave').value;
                var msg = null;
                if (!nueva) msg = _rMsg.errorEmpty;
                else if (nueva.length < 12) msg = _rMsg.errorLen;
                else if (nueva !== confirmar) msg = _rMsg.errorMatch;
                if (msg) { aviso('info', msg); return; }
                document.getElementById('btnCambiar').classList.add('loading');
                document.getElementById('restablecerForm').submit();
            }
            document.getElementById('restablecerForm').addEventListener('submit', function (e) {
                if (!document.getElementById('btnCambiar').classList.contains('loading')) { e.preventDefault(); cambiarClave(); }
            });
        </script>
    }
}
