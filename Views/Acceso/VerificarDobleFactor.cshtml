@{
    Layout = "~/Views/Acceso/_Layout2FA.cshtml";
    ViewBag.Heading = Resources.Strings.Login2FA_VerificarHeading;
    ViewBag.PageTitle = Resources.Strings.Login2FA_PageTitle;
    var panel = new bufinscustomers.Models.AccesoPanelVM
    {
        Eyebrow = Resources.Strings.Acc_Eyebrow_Login,
        PieUsuario = true,
        CorreoEnmascarado = ViewBag.CorreoEnmascarado as string,
        Pasos = new System.Collections.Generic.List<bufinscustomers.Models.AccesoPasoVM>
        {
            new bufinscustomers.Models.AccesoPasoVM(Resources.Strings.Acc_Paso_Credenciales, "done"),
            new bufinscustomers.Models.AccesoPasoVM(Resources.Strings.Acc_Paso_Verificacion, "active"),
            new bufinscustomers.Models.AccesoPasoVM(Resources.Strings.Acc_Paso_AccesoBufins, "todo")
        }
    };
}

@section Panel { @Html.Partial("_AccesoPanel", panel) }

<h1 class="acc-title">@Resources.Strings.Login2FA_VerificarHeading</h1>
<p class="acc-desc">@Resources.Strings.Login2FA_VerificarInstrucciones</p>

<form id="tfForm" action="@Url.Action("VerificarDobleFactor","Acceso")" method="post">
    @Html.AntiForgeryToken()

    @Html.Partial("_AccesoOtp")

    <div class="acc-timer" id="accTimer" data-tpl="@Resources.Strings.Acc_TimerTexto">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" style="transform:rotate(-90deg)">
            <circle class="ring-bg" cx="12" cy="12" r="9"></circle>
            <circle class="ring-fg" cx="12" cy="12" r="9" stroke-linecap="round" stroke-dasharray="56.55" stroke-dashoffset="0"></circle>
        </svg>
        <span class="acc-timer-txt"></span>
    </div>

    <button type="submit" id="btnVerificar" class="btn btn-primary acc-off">
        <span class="btn-text">@Resources.Strings.Login2FA_BtnVerificar</span>
        <i class="fas fa-check"></i>
    </button>

    @if (ViewBag.PuedeCrearPasskey == true)
    {
        <label class="acc-check">
            <input type="checkbox" name="agregarPasskey" value="true" />
            <span><i class="fas fa-fingerprint"></i>@Resources.Strings.Acc_AgregarPasskeyAlEntrar
                <small>@Resources.Strings.Acc_AgregarPasskeyAlEntrarDesc</small></span>
        </label>
    }

    @if (ViewBag.TienePasskey == true)
    {
        <button type="button" id="btnPasskey" class="acc-btn-secondary" style="display:none;">
            <i class="fas fa-fingerprint"></i>@Resources.Strings.Login2FA_UsarPasskey
        </button>
    }
</form>

@section FooterLeft {
    <a class="acc-link" href="@Url.Action("SolicitarReinicio","Acceso")"><i class="fas fa-life-ring"></i>@Resources.Strings.Acc_SolicitarReinicio</a>
}

@section scripts {
    @if (ViewBag.TienePasskey == true)
    {
        <script src="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/js/webauthn-bufins.js")"></script>
        <script>
            (function () {
                if (!window.WebAuthnBufins || !WebAuthnBufins.soportado()) return;
                var btn = document.getElementById('btnPasskey');
                btn.style.display = '';
                btn.addEventListener('click', function () {
                    var token = document.querySelector('#tfForm [name=__RequestVerificationToken]').value;
                    btn.disabled = true;
                    WebAuthnBufins.iniciarSesion('@Url.Action("PasskeyOpciones","Acceso")', '@Url.Action("PasskeyVerificar","Acceso")', token)
                        .then(function (r) {
                            if (r.ok && r.redirect) { window.location.href = r.redirect; return; }
                            if (r.redirect) { window.location.href = r.redirect; return; }
                            btn.disabled = false;
                            if (r.cancelado) { aviso('info', '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Login2FA_PasskeyCancelada))'); return; }
                            aviso('warning', r.mensaje || '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Login2FA_ErrorPasskey))');
                        })
                        .catch(function () { btn.disabled = false; aviso('warning', '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Login2FA_ErrorPasskey))'); });
                });
            })();
        </script>
    }
    <script>
        (function () {
            var btn = document.getElementById('btnVerificar');
            Acceso.otp({ onCambio: function (v) { btn.classList.toggle('acc-off', v.length !== 6); } });
            Acceso.temporizador();
        })();
        document.getElementById('tfForm').addEventListener('submit', function (e) {
            var v = document.getElementById('codigo').value.trim();
            if (!v) { e.preventDefault(); aviso('info', '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Login2FA_ErrorVacio))'); return; }
            document.getElementById('btnVerificar').classList.add('loading');
        });
    </script>
}
