@{
    Layout = "~/Views/Acceso/_Layout2FA.cshtml";
    ViewBag.Heading = Resources.Strings.Login2FA_VerificarHeading;
}

<form id="tfForm" action="@Url.Action("VerificarDobleFactor","Acceso")" method="post">
    @Html.AntiForgeryToken()

    <p class="tf-info">
        <i class="fas fa-mobile-alt"></i>@Resources.Strings.Login2FA_VerificarInstrucciones
    </p>

    <div class="input-group">
        <div class="input-icon"><i class="fas fa-shield-alt"></i></div>
        <div class="input-wrapper">
            <label for="codigo">@Resources.Strings.Login2FA_CodigoLabel</label>
            <input type="text" name="codigo" id="codigo" class="input-field tf-code" maxlength="7"
                   placeholder="000000" autocomplete="one-time-code" inputmode="numeric" spellcheck="false" autofocus />
        </div>
    </div>

    <button type="submit" id="btnVerificar" class="btn btn-primary">
        <span class="btn-text">@Resources.Strings.Login2FA_BtnVerificar</span>
        <i class="fas fa-check" style="margin-left:8px;"></i>
    </button>

    @if (ViewBag.TienePasskey == true)
    {
        <div class="tf-or" id="tfPasskeyBloque" style="display:none;"><span>@Resources.Strings.Login2FA_O</span></div>
        <button type="button" id="btnPasskey" class="tf-link tf-passkey-btn" style="display:none;">
            <i class="fas fa-fingerprint" style="margin-right:7px;"></i>@Resources.Strings.Login2FA_UsarPasskey
        </button>
    }

    <p class="tf-info" style="margin-top:1rem; margin-bottom:.35rem; font-size:.78rem;">@Resources.Strings.Login2FA_HintRecuperacion</p>
    <div style="text-align:center;">
        <a href="@Url.Action("SolicitarReinicio","Acceso")" style="color:#583AFF; font-size:.8rem; font-weight:600; text-decoration:none;">
            <i class="fas fa-life-ring" style="margin-right:4px;"></i>@Resources.Strings.SolSeg_Link
        </a>
    </div>

    <div style="text-align:center; margin-top:1rem;">
        <a href="@Url.Action("Login","Acceso")" style="color:#583AFF; font-size:.8rem; text-decoration:none;">
            <i class="fas fa-arrow-left" style="margin-right:4px;"></i>@Resources.Strings.Login2FA_Volver
        </a>
    </div>
</form>

@section scripts {
    @if (ViewBag.TienePasskey == true)
    {
        <script src="@bufinscustomers.Helpers.AssetVersion.Url("~/Assets/js/webauthn-bufins.js")"></script>
        <script>
            (function () {
                if (!window.WebAuthnBufins || !WebAuthnBufins.soportado()) return;
                var btn = document.getElementById('btnPasskey');
                document.getElementById('tfPasskeyBloque').style.display = '';
                btn.style.display = '';
                btn.addEventListener('click', function () {
                    var token = document.querySelector('#tfForm [name=__RequestVerificationToken]').value;
                    btn.disabled = true;
                    WebAuthnBufins.iniciarSesion('@Url.Action("PasskeyOpciones","Acceso")', '@Url.Action("PasskeyVerificar","Acceso")', token)
                        .then(function (r) {
                            if (r.ok && r.redirect) { window.location.href = r.redirect; return; }
                            if (r.redirect) { window.location.href = r.redirect; return; }
                            btn.disabled = false;
                            if (r.cancelado) { aviso('info', '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Login2FA_PasskeyCancelada))'); return; }
                            aviso('warning', r.mensaje || '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Login2FA_ErrorPasskey))');
                        })
                        .catch(function () { btn.disabled = false; aviso('warning', '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Login2FA_ErrorPasskey))'); });
                });
            })();
        </script>
    }
    <script>
        document.getElementById('tfForm').addEventListener('submit', function (e) {
            var v = document.getElementById('codigo').value.trim();
            if (!v) { e.preventDefault(); aviso('info', '@Html.Raw(HttpUtility.JavaScriptStringEncode(Resources.Strings.Login2FA_ErrorVacio))'); return; }
            document.getElementById('btnVerificar').classList.add('loading');
        });
    </script>
}
