@{
    Layout = "~/Views/Error/_ErrorLayout.cshtml";
    ViewBag.Code = "500";
}
<h1 class="err-code">500</h1>
<h2 class="err-title">@Resources.Strings.Err_500_Title</h2>
<p class="err-desc">@Resources.Strings.Err_500_Desc</p>
<div class="err-actions">
    <a class="err-btn" href="@Url.Action("Index", "Home")">@Resources.Strings.Err_VolverInicio</a>
</div>
