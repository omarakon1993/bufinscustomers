<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>bufinscustomers</RootNamespace>
    <AssemblyName>bufinscustomers</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Mismo identificador de secretos de usuario que usaba el proyecto .NET Framework (ConfigurationBuilders.UserSecrets):
         los secretos locales (dotnet user-secrets) siguen siendo los mismos en desarrollo. -->
    <UserSecretsId>9ecd421a-36d1-4a37-be36-7f6fe86a7f2f</UserSecretsId>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <!-- Migracion en curso: los avisos de codigo heredado se reducen al final (fase 5) -->
    <NoWarn>$(NoWarn);CA1416;ASP0019;MVC1000;CS0618;CS0168;CS0219;CS1998;SYSLIB0021;SYSLIB0023</NoWarn>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Hosting compartido: GC de estacion de trabajo y no concurrente (el modo servidor reserva un monton por nucleo y multiplica la memoria) -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NUglify" Version="1.21.15" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="System.Runtime.Caching" Version="10.0.0" />
    <!-- Fijado: version transitiva de MailKit con vulnerabilidad conocida -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <!-- Textos del sitio: App_GlobalResources\Strings(.en-US).resx -> clase bufinscustomers.App_GlobalResources.Strings (alias Resources en las vistas) -->
  <ItemGroup>
    <EmbeddedResource Update="App_GlobalResources\Strings.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>bufinscustomers.App_GlobalResources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Contenido que viaja con la publicacion (los estaticos viven en /Assets, no en wwwroot) -->
  <ItemGroup>
    <Content Include="Assets\**\*" Exclude="Assets\**\*.json;Assets\**\*.config" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="favicon.ico" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="App_Data\Documentacion\**\*" Exclude="App_Data\Documentacion\**\*.json;App_Data\Documentacion\**\*.config" CopyToPublishDirectory="PreserveNewest" />
    <!-- NUNCA publicar credenciales: el SDK Web incluye por defecto todos los .json/.config -->
    <Content Remove="secrets.config;secrets.machineKey.config;secretsSettings.json;secretsSettings.*.json;*.example;*.config.example" />
    <None Remove="secrets.config;secrets.machineKey.config;secretsSettings.json" />
    <Content Remove="Logs\**;App_Data\logs\**" />
    <None Remove="Logs\**" />
  </ItemGroup>

  <!-- Copias antiguas del proyecto .NET Framework que no forman parte del sitio -->
  <ItemGroup>
    <Compile Remove="packages\**;bin\**;obj\**;Logs\**" />
    <Content Remove="packages\**" />
    <EmbeddedResource Remove="packages\**" />
    <None Remove="packages\**" />
  </ItemGroup>

</Project>
