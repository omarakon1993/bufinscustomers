{
  // Copie este archivo como «agente.json» y ajústelo. La clave NO va aquí: use «AgenteBufins.exe --guardar-clave».

  // Dirección base de la API de BUFINS (https).
  "url": "https://customers.bufins.com/api/v1",

  // Carpeta que se vigila. El agente crea dentro «procesados» y «errores».
  "carpeta": "C:\\BUFINS\\Entrada",

  // Año por defecto (un número, o "actual") y modo ("ejecucion" o "historico").
  // Un archivo llamado 2026_historico_cierre.xlsx indica su propio año y modo.
  "anio": "actual",
  "modo": "ejecucion",
  "idEscenario": 1,

  // false = cada envío lo confirma una persona en «Revisar cargue» (recomendado al empezar).
  // true  = pide confirmar solo; funciona únicamente si la integración tiene permiso y el cargue queda limpio.
  "confirmar": false,

  // true = tras un cargue confirmado, pide recalcular los modelos (informes). Requiere el mismo permiso de confirmar.
  "ejecutarModelos": false,

  // Cada cuántos segundos se revisa la carpeta, y cuántos segundos debe llevar un archivo sin modificarse antes de enviarlo.
  "intervaloSegundos": 60,
  "estableSegundos": 30
}
